import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;

import java.io.CharSequenceReader;
import java.io.IOException;
import java.io.StringReader;
import java.io.Writer;
import java.nio.charset.Charset;
import java.util.Set;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertTrue;
import static org.mockito.Mockito.when;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.verifyNoMoreInteractions;

@RunWith(MockitoJUnitRunner.class)
public class WordWrapTest {

    @Test
    public void fromReaderTest() throws IOException {
        Reader reader = new StringReader("Hello World");
        Builder builder = WordWrap.from(reader);
        assertEquals(reader, builder.getReader());
    }

    @Test
    public void fromClasspathUtf8Test() throws IOException {
        String resource = "Hello World";
        Builder builder = WordWrap.fromClasspathUtf8(resource);
        assertEquals(resource, builder.getResource());
        assertEquals(Charset.forName("UTF-8"), builder.getCharset());
    }

    @Test
    public void fromClasspathTest() throws IOException {
        String resource = "Hello World";
        Charset charset = Charset.forName("UTF-8");
        Builder builder = WordWrap.fromClasspath(resource, charset);
        assertEquals(resource, builder.getResource());
        assertEquals(charset, builder.getCharset());
    }

    @Test
    public void fromTextTest() {
        CharSequence text = "Hello World";
        Builder builder = WordWrap.from(text);
        assertEquals(text, builder.getText());
    }

    @Test
    public void fromInputStreamTest() throws IOException {
        InputStream in = new ByteArrayInputStream("Hello World".getBytes());
        Builder builder = WordWrap.fromUtf8(in);
        assertEquals(in, builder.getInputStream());
    }

    @Test
    public void fromInputStreamWithCharsetTest() throws IOException {
        InputStream in = new ByteArrayInputStream("Hello World".getBytes());
        Charset charset = Charset.forName("UTF-8");
        Builder builder = WordWrap.from(in, charset);
        assertEquals(in, builder.getInputStream());
        assertEquals(charset, builder.getCharset());
    }

    @Test
    public void fromFileTest() throws IOException {
        File file = new File("Hello World");
        Charset charset = Charset.forName("UTF-8");
        Builder builder = WordWrap.from(file, charset);
        assertEquals(file, builder.getFile());
        assertEquals(charset, builder.getCharset());
    }

