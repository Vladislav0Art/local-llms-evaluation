    private UrlBuilder urlBuilder;

    @Test
    public void build_UrlBuilderWithUrlTest() throws MalformedURLException {
        URL url = new URL("https://www.example.com");
        urlBuilder = new UrlBuilder(url);
        assertEquals(url, urlBuilder.build());
    }

    @Test
    public void build_UrlBuilderWithoutUrlTest() {
        assertThrows(IllegalArgumentException.class, () -> new UrlBuilder(null));
    }

    @Test
    public void appendKeyVal_KeyValWithKeyAndValueTest() {
        KeyVal keyVal = new KeyVal("key", "value");
        urlBuilder = new UrlBuilder(new URL("https://www.example.com"));
        urlBuilder.appendKeyVal(keyVal);
        // No assertion needed, appendKeyVal does not return anything
    }

    @Test
