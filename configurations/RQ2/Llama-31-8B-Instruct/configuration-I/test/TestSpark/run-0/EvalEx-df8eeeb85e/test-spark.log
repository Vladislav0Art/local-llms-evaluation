package com.ezylang.evalex.parser;

import com.ezylang.evalex.ExpressionConfiguration;
import com.ezylang.evalex.ParseException;
import com.ezylang.evalex.Token;
import com.ezylang.evalex.Tokenizer;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;

import java.util.ArrayList;
import java.util.List;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertThrows;
import static org.mockito.ArgumentMatchers.anyString;
import static org.mockito.Mockito.when;

@RunWith(MockitoJUnitRunner.class)
public class TokenizerTest {

    @Test
    public void parse_EmptyStringTest() throws ParseException {
        Tokenizer tokenizer = new Tokenizer("", new ExpressionConfiguration());
        List<Token> result = tokenizer.parse();
        assertEquals(0, result.size());
    }

    @Test
    public void parse_SingleTokenTest() throws ParseException {
        Tokenizer tokenizer = new Tokenizer("1", new ExpressionConfiguration());
        List<Token> result = tokenizer.parse();
        assertEquals(1, result.size());
    }

    @Test
    public void parse_MultipleTokensTest() throws ParseException {
        Tokenizer tokenizer = new Tokenizer("1 + 2 * 3", new ExpressionConfiguration());
        List<Token> result = tokenizer.parse();
        assertEquals(3, result.size());
    }

    @Test
    public void parseStringLiteralTest() throws ParseException {
        Tokenizer tokenizer = new Tokenizer("\"Hello, World!\"", new ExpressionConfiguration());
        Token result = tokenizer.parseStringLiteral();
        assertEquals("Hello, World!", result.getValue());
    }

    @Test
    public void parseStringLiteral_EmptyStringTest() throws ParseException {
        Tokenizer tokenizer = new Tokenizer("\"\"", new ExpressionConfiguration());
        Token result = tokenizer.parseStringLiteral();
        assertEquals("", result.getValue());
    }

    @Test
    public void parseStringLiteral_NullInputTest() throws ParseException {
        Tokenizer tokenizer = new Tokenizer(null, new ExpressionConfiguration());
        assertThrows(ParseException.class, () -> tokenizer.parseStringLiteral());
    }

    @Test
    public void parseStringLiteral_InvalidInputTest() throws ParseException {
        Tokenizer tokenizer = new Tokenizer("Invalid input", new ExpressionConfiguration());
        assertThrows(ParseException.class, () -> tokenizer.parseStringLiteral());
    }

