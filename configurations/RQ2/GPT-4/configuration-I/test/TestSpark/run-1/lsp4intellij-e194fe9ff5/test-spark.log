import org.junit.Test;
import org.junit.Assert;
import static org.mockito.Mockito.*;
import com.intellij.openapi.fileTypes.FileType;
import com.intellij.openapi.project.Project;
import com.intellij.openapi.vfs.VirtualFile;
import com.intellij.testFramework.fixtures.LightCodeInsightFixtureTestCase;

import java.util.HashSet;
import java.util.List;
import java.util.Set;
 
public class FileUtilsTest extends LightCodeInsightFixtureTestCase {

    @Test
    public void getAllOpenedEditorsTest() {
        Project project = getProject();
        List<Editor> result = FileUtils.getAllOpenedEditors(project);
        Assert.assertNotNull(result);
    }

    @Test
    public void getAllOpenedEditorsForUriTest() {
        Project project = getProject();
        List<Editor> result = FileUtils.getAllOpenedEditorsForUri(project, "file://mockUri");
        Assert.assertNotNull(result);
    }

    @Test
    public void getAllOpenedEditorsForVirtualFileTest() {
        VirtualFile mockFile = mock(VirtualFile.class);
        Project project = getProject();
        List<Editor> result = FileUtils.getAllOpenedEditorsForVirtualFile(project, mockFile);
        Assert.assertNotNull(result);
    }

    @Test
    public void reloadAllEditorsTest() {
        FileUtils.reloadAllEditors();
    }

    @Test
    public void reloadEditorsTest() {
        Project project = getProject();
        FileUtils.reloadEditors(project);
    }

    @Test
    public void editorFromPsiFileTest() {
        PsiFile psiFile = createLightFile("java", "mock");
        Editor editor = FileUtils.editorFromPsiFile(psiFile);
        Assert.assertNotNull(editor);
    }

    @Test
    public void editorFromUriTest() {
        Project project = getProject();
        Editor editor = FileUtils.editorFromUri("file://mockUri", project);
        Assert.assertNotNull(editor);
    }

    @Test
    public void editorFromVirtualFileTest() {
        VirtualFile mockFile = mock(VirtualFile.class);
        Project project = getProject();
        Editor editor = FileUtils.editorFromVirtualFile(mockFile, project);
        Assert.assertNotNull(editor);
    }

    @Test
    public void virtualFileFromURITest() {
        VirtualFile file = FileUtils.virtualFileFromURI("file://mockUri");
        Assert.assertNotNull(file);
    }

    @Test
    public void editorToLSPIdentifierTest() {
        Editor editor = getEditor();
        TextDocumentIdentifier identifier = FileUtils.editorToLSPIdentifier(editor);
        Assert.assertNotNull(identifier);
    }

    @Test
    public void editorToURIStringTest() {
        Editor editor = getEditor();
        String uri = FileUtils.editorToURIString(editor);
        Assert.assertNotNull(uri);
    }

    @Test
    public void virtualFileFromEditorTest() {
        Editor editor = getEditor();
        VirtualFile file = FileUtils.virtualFileFromEditor(editor);
        Assert.assertNotNull(file);
    }

    @Test
    public void VFSToURITest() {
        VirtualFile mockFile = mock(VirtualFile.class);
        String uri = FileUtils.VFSToURI(mockFile);
        Assert.assertNotNull(uri);
    }

    @Test
    public void isFileSupportedTest() {
        VirtualFile mockFile = mock(VirtualFile.class);
        boolean result = FileUtils.isFileSupported(mockFile);
        Assert.assertTrue(result);
    }

    @Test
    public void findProjectsForTest() {
        VirtualFile mockFile = mock(VirtualFile.class);
        Set<Project> projects = FileUtils.findProjectsFor(mockFile);
        Assert.assertNotNull(projects);
    }

    @Test
    public void isEditorSupportedTest() {
        Editor editor = getEditor();
        boolean isSupported = FileUtils.isEditorSupported(editor);
        Assert.assertTrue(isSupported);
    }
