public class TransactionTest {

    @Test
    public void getSourceAccountTest() {
        AccountConverter accountConverter = Mockito.mock(AccountConverter.class);
        Operation[] operations = {};
        Memo memo = Memo.text("memo text");
        TransactionPreconditions preconditions = TransactionPreconditions.NONE;
        Transaction transaction = new Transaction(accountConverter, "abc123", 100L, 1L, operations, memo, preconditions, null, Network.PUBLIC);

        assertEquals("abc123", transaction.getSourceAccount());
    }

    @Test(expected = IOException.class)
    public void getClaimableBalanceIdIndexOutOfBoundsTest() throws IOException {
        AccountConverter accountConverter = Mockito.mock(AccountConverter.class);
        Operation[] operations = {};
        Memo memo = Memo.none();
        TransactionPreconditions preconditions = TransactionPreconditions.NONE;
        Transaction transaction = new Transaction(accountConverter, "abc123", 100L, 1L, operations, memo, preconditions, null, Network.PUBLIC);

        transaction.getClaimableBalanceId(0); // should throws IOException
    }

    @Test
    public void equalsTrueTest() {
        AccountConverter accountConverter = Mockito.mock(AccountConverter.class);
        Operation[] operations = {};
        Memo memo = Memo.none();
        TransactionPreconditions preconditions = TransactionPreconditions.NONE;

        Transaction transaction1 = new Transaction(accountConverter, "abc123", 100L, 1L, operations, memo, preconditions, null, Network.PUBLIC);
        Transaction transaction2 = new Transaction(accountConverter, "abc123", 100L, 1L, operations, memo, preconditions, null, Network.PUBLIC);

        assertTrue(transaction1.equals(transaction2));
    }

    @Test
    public void equalsFalseTest() {
        AccountConverter accountConverter = Mockito.mock(AccountConverter.class);
        Operation[] operations = {};
        Memo memo = Memo.none();
        TransactionPreconditions preconditions = TransactionPreconditions.NONE;

        Transaction transaction1 = new Transaction(accountConverter, "abc123", 100L, 1L, operations, memo, preconditions, null, Network.PUBLIC);
        Transaction transaction2 = new Transaction(accountConverter, "xyz456", 200L, 2L, operations, memo, preconditions, null, Network.PUBLIC);

        assertFalse(transaction1.equals(transaction2));
    }

    @Test
    public void hashCodeNotEqualTest() {
        AccountConverter accountConverter = Mockito.mock(AccountConverter.class);
        Operation[] operations = {};
        Memo memo = Memo.none();
        TransactionPreconditions preconditions = TransactionPreconditions.NONE;

        Transaction transaction1 = new Transaction(accountConverter, "abc123", 100L, 1L, operations, memo, preconditions, null, Network.PUBLIC);
        Transaction transaction2 = new Transaction(accountConverter, "xyz456", 200L, 2L, operations, memo, preconditions, null, Network.PUBLIC);

        assertNotEquals(transaction1.hashCode(), transaction2.hashCode());
    }

    // Similar tests can be created for remaining methods
}
