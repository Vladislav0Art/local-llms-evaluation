public class OPFChecker30Test {

  @Test
  public void isAudioTypeTest() {
    assertTrue(OPFChecker30.isAudioType("audio/mpeg"));
    assertFalse(OPFChecker30.isAudioType("video/mpeg"));
  }

  @Test
  public void isBlessedAudioTypeTest() {
    assertTrue(OPFChecker30.isBlessedAudioType("audio/mpeg"));
    assertFalse(OPFChecker30.isBlessedAudioType("text/plain"));
  }

  @Test
  public void isVideoTypeTest() {
    assertTrue(OPFChecker30.isVideoType("video/mpeg"));
    assertFalse(OPFChecker30.isVideoType("image/jpeg"));
  }

  @Test
  public void isBlessedVideoTypeTest() {
    assertTrue(OPFChecker30.isBlessedVideoType("video/mpeg"));
    assertFalse(OPFChecker30.isBlessedVideoType("text/plain"));
  }

  @Test
  public void isCommonVideoTypeTest() {
    assertTrue(OPFChecker30.isCommonVideoType("video/mpeg"));
    assertFalse(OPFChecker30.isCommonVideoType("text/plain"));
  }

  @Test
  public void isFontTypeTest() {
    assertTrue(OPFChecker30.isFontType("application/font-woff"));
    assertFalse(OPFChecker30.isFontType("text/plain"));
  }

  @Test
  public void isBlessedFontTypeTest() {
    assertTrue(OPFChecker30.isBlessedFontType("application/font-woff"));
    assertFalse(OPFChecker30.isBlessedFontType("text/plain"));
  }

  @Test
  public void isBlessedScriptTypeTest() {
    assertTrue(OPFChecker30.isBlessedScriptType("text/javascript"));
    assertFalse(OPFChecker30.isBlessedScriptType("text/plain"));
  }

  @Test
  public void isCoreMediaTypeTest() {
    assertTrue(OPFChecker30.isCoreMediaType("text/plain"));
    assertFalse(OPFChecker30.isCoreMediaType("application/font-woff"));
  }

  @Test
  public void getPreferredMediaTypeTest() {
    String preferredMediaType = OPFChecker30.getPreferredMediaType("application/sql", "application/javascript");
    assertTrue(preferredMediaType.equals("application/javascript"));
  }

  @Test
  public void validatePackageDocumentTest() {
    try {
      Report report = new Report();
      ValidationContext context = new ValidationContext(ContextMode.OPF);
      context.pathToText = "./test.opf";
      context.report = report;
      OPFChecker30 opfChecker30 = new OPFChecker30(context);
      opfChecker30.validatePackageDocument();
      assertTrue(report.getFatalErrorCount() == 0);
    } catch (IOException e) {
      fail("Test threw an IOException: " + e.getMessage());
    }
  }
}
