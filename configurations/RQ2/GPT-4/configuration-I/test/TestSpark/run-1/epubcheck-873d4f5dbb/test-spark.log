import com.adobe.epubcheck.opf.OPFChecker30;
import com.adobe.epubcheck.opf.OPFHandler;
import com.adobe.epubcheck.opf.OPFItem;
import com.adobe.epubcheck.opf.ValidationContext;
import org.junit.Test;
import static org.junit.Assert.assertTrue;
import static org.junit.Assert.assertFalse;

public class OPFChecker30Test {

    @Test
    public void isAudioTypeValidTest() {
        assertTrue(OPFChecker30.isAudioType("audio/mp4"));
    }

    @Test
    public void isAudioTypeInvalidTest() {
        assertFalse(OPFChecker30.isAudioType("application/pdf"));
    }

    @Test
    public void isBlessedAudioTypeValidTest() {
        assertTrue(OPFChecker30.isBlessedAudioType("audio/mp4"));
    }

    @Test
    public void isBlessedAudioTypeInvalidTest() {
        assertFalse(OPFChecker30.isBlessedAudioType("application/pdf"));
    }

    @Test
    public void isBlessedScriptTypeValidTest() {
        assertTrue(OPFChecker30.isBlessedScriptType("text/javascript"));
    }

    @Test
    public void isBlessedScriptTypeInvalidTest() {
        assertFalse(OPFChecker30.isBlessedScriptType("audio/mp4"));
    }

    @Test
    public void isCoreMediaTypeValidTest() {
        assertTrue(OPFChecker30.isCoreMediaType("text/html"));
    }

    @Test
    public void isCoreMediaTypeInvalidTest() {
        assertFalse(OPFChecker30.isCoreMediaType("application/shell"));
    }

    @Test
    public void getPreferredMediaTypeValidTest() {
        String preferredMediaType = OPFChecker30.getPreferredMediaType("application/xml", "application/xhtml+xml");
        assertTrue(preferredMediaType.equals("application/xhtml+xml"));
    }

    @Test
    public void getPreferredMediaTypeInvalidTest() {
        String preferredMediaType = OPFChecker30.getPreferredMediaType("unknown", "unknown");
        assertTrue(preferredMediaType.equals("unknown"));
    }
}
