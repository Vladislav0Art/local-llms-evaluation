    public void getBuildNumberTest() {
        AppVersion appVersion = new AppVersion("AppName",
                "v001",
                "001",
                "buildJob1",
                "commit1");

        String buildNumber = appVersion.getBuildNumber();

        Assert.assertEquals("001", buildNumber);
    }

    @Test
    public void getCommitTest() {
        AppVersion appVersion = new AppVersion("AppName",
                "v001",
                "001",
                "buildJob1",
                "commit1");

        String commit = appVersion.getCommit();

        Assert.assertEquals("commit1", commit);
    }

    @Test
    public void getChangelistTest() {
        AppVersion appVersion = new AppVersion("AppName",
                "v001",
                "001",
                "buildJob1",
                "commit1");

        String changelist = appVersion.getChangelist();

        Assert.assertEquals("commit1", changelist);
    }

    @Test
    public void toStringTest() {
        AppVersion appVersion = new AppVersion("AppName",
                "v001",
