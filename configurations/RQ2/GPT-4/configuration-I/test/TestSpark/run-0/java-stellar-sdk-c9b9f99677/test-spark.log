import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.runners.MockitoJUnitRunner;
import org.stellar.sdk.responses.AccountNotFoundException;
import org.stellar.sdk.responses.SorobanRpcErrorResponse;

import java.io.IOException;
import java.util.Collections;

import static org.junit.Assert.*;
import static org.mockito.Mockito.*;

@RunWith(MockitoJUnitRunner.class)
public class SorobanServerTest {

    SorobanServer server = mock(SorobanServer.class);

    @Test
    public void getAccountValidTest() throws IOException, AccountNotFoundException, SorobanRpcErrorResponse {
        assertNotNull(server.getAccount("ValidAccountId"));
    }

    @Test(expected = IllegalArgumentException.class)
    public void getAccountInvalidTest() throws IOException, AccountNotFoundException, SorobanRpcErrorResponse {
        assertNotNull(server.getAccount("InvalidAccountId"));
    }

    @Test
    public void getHealthTest() throws IOException, SorobanRpcErrorResponse {
        assertNotNull(server.getHealth());
    }

    @Test
    public void getContractDataTest() throws IOException, SorobanRpcErrorResponse {
        assertNotNull(server.getContractData("contractId", mock(SCVal.class), mock(Durability.class)));
    }

    @Test
    public void getLedgerEntriesTest() throws IOException, SorobanRpcErrorResponse {
        assertNotNull(server.getLedgerEntries(Collections.singleton(mock(LedgerKey.class))));
    }

    @Test
    public void getTransactionValidTest() throws IOException, SorobanRpcErrorResponse {
        assertNotNull(server.getTransaction("validHash"));
    }

    @Test(expected = IllegalArgumentException.class)
    public void getTransactionInvalidTest() throws IOException, SorobanRpcErrorResponse {
        assertNotNull(server.getTransaction("invalidHash"));
    }

    @Test
    public void getEventsTest() throws IOException, SorobanRpcErrorResponse {
        assertNotNull(server.getEvents(mock(GetEventsRequest.class)));
    }

    @Test
    public void getNetworkTest() throws IOException, SorobanRpcErrorResponse {
        assertNotNull(server.getNetwork());
    }

    @Test
    public void getLatestLedgerTest() throws IOException, SorobanRpcErrorResponse {
        assertNotNull(server.getLatestLedger());
    }

    @Test
    public void simulateTransactionTest() throws IOException, SorobanRpcErrorResponse {
        assertNotNull(server.simulateTransaction(mock(Transaction.class)));
    }

    @Test
    public void prepareTransactionTest() throws IOException, SorobanRpcErrorResponse, PrepareTransactionException {
        assertNotNull(server.prepareTransaction(mock(Transaction.class)));
    }

    @Test
    public void sendTransactionTest() throws IOException, SorobanRpcErrorResponse {
        assertNotNull(server.sendTransaction(mock(Transaction.class)));
    }

    @Test
    public void closeTest() throws IOException {
        server.close();
        verify(server, times(1)).close();
    }
}
