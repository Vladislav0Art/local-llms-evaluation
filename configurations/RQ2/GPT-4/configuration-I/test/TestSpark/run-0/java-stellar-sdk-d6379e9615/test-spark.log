    public void getFeeTest() {
        Transaction transaction = new Transaction(ACCOUNT_CONVERTER, SOURCE_ACCOUNT, FEE, SEQUENCE_NUMBER, OPERATIONS, MEMO, PRECONDITIONS, SOROBAN_DATA, NETWORK);
        assertEquals(transaction.getFee(), FEE);
    }

    @Test
    public void getOperationsTest() {
        Transaction transaction = new Transaction(ACCOUNT_CONVERTER, SOURCE_ACCOUNT, FEE, SEQUENCE_NUMBER, OPERATIONS, MEMO, PRECONDITIONS, SOROBAN_DATA, NETWORK);
        assertArrayEquals(transaction.getOperations(), OPERATIONS);
    }

    @Test
    public void getTimeBoundsTest() {
        TimeBounds timeBounds = null;
        Transaction transaction = new Transaction(ACCOUNT_CONVERTER, SOURCE_ACCOUNT, FEE, SEQUENCE_NUMBER, OPERATIONS, MEMO, PRECONDITIONS, timeBounds, SOROBAN_DATA, NETWORK);
        assertEquals(transaction.getTimeBounds(), timeBounds);
    }

