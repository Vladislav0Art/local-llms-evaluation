    @Test
    public void getSourceAccountTest() {
        Transaction transaction = new Transaction(ACCOUNT_CONVERTER, SOURCE_ACCOUNT, FEE, SEQUENCE_NUMBER, OPERATIONS, MEMO, PRECONDITIONS, SOROBAN_DATA, NETWORK);
        assertEquals(transaction.getSourceAccount(), SOURCE_ACCOUNT);
    }

    @Test
    public void getSequenceNumberTest() {
        Transaction transaction = new Transaction(ACCOUNT_CONVERTER, SOURCE_ACCOUNT, FEE, SEQUENCE_NUMBER, OPERATIONS, MEMO, PRECONDITIONS, SOROBAN_DATA, NETWORK);
        assertEquals(transaction.getSequenceNumber(), SEQUENCE_NUMBER);
    }

