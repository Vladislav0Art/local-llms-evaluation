public class TransactionTest {

    @Test
    public void setEnvelopeTypeTest() {
        Transaction transaction = new Transaction();
        transaction.setEnvelopeType(EnvelopeType.ENVELOPE_TYPE_TX_V0);
        assertEquals(transaction.getEnvelopeType(), EnvelopeType.ENVELOPE_TYPE_TX_V0);
    }

    @Test
    public void signatureBaseTest() {
        Transaction transaction = new Transaction();
        byte[] signatureBase = transaction.signatureBase();
        assertNotNull(signatureBase);
    }

    @Test
    public void getSourceAccountTest() {
        Transaction transaction = new Transaction();
        String sourceAccount = transaction.getSourceAccount();
        assertNotNull(sourceAccount);
    }

    @Test
    public void getSequenceNumberTest() {
        Transaction transaction = new Transaction();
        long sequenceNumber = transaction.getSequenceNumber();
        assertNotNull(sequenceNumber);
    }

    @Test
    public void getMemoTest() {
        Transaction transaction = new Transaction();
        Memo memo = transaction.getMemo();
        assertNotNull(memo);
    }

    @Test
    public void getSorobanDataTest() {
        Transaction transaction = new Transaction();
        SorobanTransactionData sorobanData = transaction.getSorobanData();
        assertNotNull(sorobanData);
    }

    @Test
    public void getPreconditionsTest() {
        Transaction transaction = new Transaction();
        TransactionPreconditions preconditions = transaction.getPreconditions();
        assertNotNull(preconditions);
    }

    @Test
    public void getTimeBoundsTest() {
        Transaction transaction = new Transaction();
        TimeBounds timeBounds = transaction.getTimeBounds();
        assertNotNull(timeBounds);
    }

    @Test
    public void getFeeTest() {
        Transaction transaction = new Transaction();
        long fee = transaction.getFee();
        assertNotNull(fee);
    }

    @Test
    public void getOperationsTest() {
        Transaction transaction = new Transaction();
        Operation[] operations = transaction.getOperations();
        assertNotNull(operations);
    }

    @Test
    public void getClaimableBalanceIdTest() {
        Transaction transaction = new Transaction();
        String balanceId = transaction.getClaimableBalanceId(0);
        assertNotNull(balanceId);
    }

    @Test(expected=IndexOutOfBoundsException.class)
    public void getClaimableBalanceIdIndexOutOfBoundsTest() {
        Transaction transaction = new Transaction();
        transaction.getClaimableBalanceId(10);
    }

    @Test
    public void fromV0EnvelopeXdrTest() {
        TransactionV0Envelope transactionV0Envelope = Mockito.mock(TransactionV0Envelope.class);
        Network network = Mockito.mock(Network.class);
        AccountConverter accountConverter = Mockito.mock(AccountConverter.class);
        assertNotNull(Transaction.fromV0EnvelopeXdr(accountConverter, transactionV0Envelope, network));
    }

    @Test
    public void fromV1EnvelopeXdrTest() {
        TransactionV1Envelope transactionV1Envelope = Mockito.mock(TransactionV1Envelope.class);
        Network network = Mockito.mock(Network.class);
        AccountConverter accountConverter = Mockito.mock(AccountConverter.class);
        assertNotNull(Transaction.fromV1EnvelopeXdr(accountConverter, transactionV1Envelope, network));
    }

    @Test
    public void toEnvelopeXdr() {
        Transaction transaction = new Transaction();
        TransactionEnvelope transactionEnvelope = transaction.toEnvelopeXdr();
        assertNotNull(transactionEnvelope);
    }

    @Test
    public void hashCodeTest() {
        Transaction transaction1 = new Transaction();
        Transaction transaction2 = new Transaction();
        assertEquals(transaction1.hashCode(), transaction2.hashCode());
    }

    @Test
    public void equalsTest() {
        Transaction transaction1 = new Transaction();
        Transaction transaction2 = new Transaction();
        assertTrue(transaction1.equals(transaction2));
    }

    @Test
    public void isSorobanTransactionTest() {
        Transaction transaction = new Transaction();
        boolean isSorobanTransaction = transaction.isSorobanTransaction();
        assertNotNull(isSorobanTransaction);
    }
}
