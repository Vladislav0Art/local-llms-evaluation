        Transaction transaction2 = new Transaction(ACCOUNT_CONVERTER, SOURCE_ACCOUNT, FEE, SEQUENCE_NUMBER, OPERATIONS, MEMO, PRECONDITIONS, SOROBAN_DATA, NETWORK);
