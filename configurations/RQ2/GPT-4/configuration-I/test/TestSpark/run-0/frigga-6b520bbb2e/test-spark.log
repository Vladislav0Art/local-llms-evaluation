    @Test
    public void getBuildNumberTest() {
        AppVersion appVersion = AppVersion.parseName("validAmi");
        Assert.assertEquals("1", appVersion.getBuildNumber());
    }

    @Test
    public void getCommitTest() {
        AppVersion appVersion = AppVersion.parseName("validAmi");
