import com.fasterxml.jackson.databind.ObjectMapper;
import org.junit.Assert;
import org.junit.Test;
import org.mockito.Mockito;

public class JacksonJsonTransformerTest {

    @Test
    public void parseValidJsonTest() throws Exception {
        String json = "{\"name\":\"John\"}";
        Class<Person> clazz = Person.class;

        JacksonJsonTransformer jacksonJsonTransformer = new JacksonJsonTransformer();
        Person person = jacksonJsonTransformer.parse(json, clazz);
        
        Assert.assertEquals("John", person.getName());
    }

    @Test(expected = RuntimeException.class)
    public void parseInvalidJsonTest() {
        String json = "invalid json";
        Class<Person> clazz = Person.class;

        JacksonJsonTransformer jacksonJsonTransformer = new JacksonJsonTransformer();
        jacksonJsonTransformer.parse(json, clazz);
    }

    @Test
    public void convertNotNullObjectTest() {
        Person person = new Person();
        person.setName("John");

        JacksonJsonTransformer jacksonJsonTransformer = new JacksonJsonTransformer();
        String json = jacksonJsonTransformer.convert(person);

        Assert.assertEquals("{\"name\":\"John\"}", json);
    }

    @Test(expected = RuntimeException.class)
    public void convertNullObjectTest() {
        JacksonJsonTransformer jacksonJsonTransformer = new JacksonJsonTransformer();
        jacksonJsonTransformer.convert(null);
    }
}
```

