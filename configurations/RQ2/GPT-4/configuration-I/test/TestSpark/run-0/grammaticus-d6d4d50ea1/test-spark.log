        assertFalse(termMap.isSkinny());
    }

    @Test 
    public void makeSkinnyTest() {
        GrammaticalTermMapImpl<String> termMap = new GrammaticalTermMapImpl<String>();
        assertNotNull(termMap.makeSkinny());
    }

    @Test
    public void keySetTest() {
        GrammaticalTermMapImpl<String> termMap = new GrammaticalTermMapImpl<String>();
        termMap.put("key", "value");
        assertTrue(termMap.keySet().contains("key"));
    }

    @Test
    public void getTest() {
        GrammaticalTermMapImpl<String> termMap = new GrammaticalTermMapImpl<String>();
        termMap.put("key", "value");
        assertEquals("value", termMap.get("key"));
    }

    @Test
    public void containsKeyTest() {
        GrammaticalTermMapImpl<String> termMap = new GrammaticalTermMapImpl<String>();
        termMap.put("key", "value");
        assertTrue(termMap.containsKey("key"));
    }

    @Test
    public void entrySetTest() {
