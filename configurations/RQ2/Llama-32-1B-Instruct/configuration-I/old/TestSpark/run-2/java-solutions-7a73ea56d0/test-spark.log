import org.junit.Test;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;

public class OnlineStockSpanTest {

    @Test
    public void test_next_price_is_not_null() {
        int[] prices = {1, 2, 3, 4, 5};
        OnlineStockSpan stockSpan = new OnlineStockSpan();
        when(stockSpan.next(1)).thenReturn(1);
        when(stockSpan.next(2)).thenReturn(2);
        when(stockSpan.next(3)).thenReturn(3);

        int[] result = stockSpan.calculateSpans(prices);
        int expected = 4;
        for (int price : prices) {
            if (price == 5) {
                expected++;
            }
        }

        assertEquals(expected, result.length);
        for (int i = 0; i < result.length; i++) {
            assertEquals(1, result[i]);
        }
    }

    @Test
    public void test_calculate_spans_with_empty_price_array() {
        int[] prices = {};
        OnlineStockSpan stockSpan = new OnlineStockSpan();

        // Test case for no price array provided
        when(stockSpan.next(5)).thenReturn(1);

        int[] result = stockSpan.calculateSpans(prices);
        assertEquals(0, result.length);

        // Test case for empty price array provided
        when(stockSpan.next(-5)).thenReturn(2);
    }

    @Test
    public void test_calculate_spans_with_single_price() {
        int price = 1;
        OnlineStockSpan stockSpan = new OnlineStockSpan();
        when(stockSpan.next(price)).thenReturn(0);

        int[] result = stockSpan.calculateSpans(new int[]{price});
        assertEquals(1, result[0]);
    }

    @Test
    public void test_calculate_spans_with_multiple_prices() {
        int price1 = 1;
        int price2 = 2;
        OnlineStockSpan stockSpan = new OnlineStockSpan();
        when(stockSpan.next(price1)).thenReturn(0);
        when(stockSpan.next(price2)).thenReturn(1);

        int[] result = stockSpan.calculateSpans(new int[]{price1, price2});
        assertEquals(2, result.length);
        assertEquals(0, result[0]);
        assertEquals(1, result[1]);
    }

    @Test
    public void test_calculate_spans_with_prices_equal_to_0() {
        OnlineStockSpan stockSpan = new OnlineStockSpan();
        when(stockSpan.next(-5)).thenReturn(2);

        int[] prices = {-5};
        int[] result = stockSpan.calculateSpans(prices);
        assertEquals(1, result.length);
        assertEquals(0, result[0]);
    }

    @Test
    public void test_calculate_spans_with_prices_equal_to_1() {
        OnlineStockSpan stockSpan = new OnlineStockSpan();
        when(stockSpan.next(-5)).thenReturn(2);

