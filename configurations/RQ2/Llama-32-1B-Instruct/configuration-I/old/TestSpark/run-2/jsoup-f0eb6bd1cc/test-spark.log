                assert false : "Expected appendKeyVal(null) to throw an exception but did not get one";
            }
        } catch (UnsupportedEncodingException e) {
            // expected exception
        }
    }

    private static void test() throws Exception {
        Url url = new Url("http://example.com/path?param=value");
        for (int i = 0; i < 100000; i++) {
            String s = url.toString();
            if (!s.contains(":")) {
                throw new RuntimeException(s);
            }
        }

        // Add a null parameter to the URL
        try {
            Url url = new Url(null, "http://example.com/path?param=value");
        } catch (Exception e) {
            System.out.println(e.getMessage());
        }
    }

    public static void main(String[] args) throws Exception {
        test();

        // Add a null parameter to the URL
        try {
            Url url = new Url(null, "http://example.com/path?param=value");
        } catch (Exception e) {
            System.out.println(e.getMessage());
        }
    }
}

