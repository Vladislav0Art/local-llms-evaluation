public class Document {
    public String htmlContent;
    public StringBuilder accum;

    /**
     * Adds text to the document's HTML content.
     *
     * @param content The text to add.
     * @param index   The line index where the new text should be added.
     */
    public void addText(String content, int index) {
        // Check if this is the last line
        if (index == null || isLastLine(index)) {
            htmlContent += "<p>" + content + "</p>";
        } else {
            accum.append(htmlContent);
            accum.append("<p>" + content + "</p>");
        }
    }

    /**
     * Checks if a given index is the last line in this document's HTML content.
     *
     * @param index The line index to check.
     * @return True if the index is the last line, false otherwise.
     */
    private boolean isLastLine(int index) {
        return index == accum.length() - 1;
    }

    public static void main(String[] args) {
        Document document = new Document();

        // Add some test content
        document.addText("<p>Hello <b>world</b></p>", null, null);
        document.addText("This is the first line.", null, null);
        document.addText("And this is the second line.", null, null);

        System.out.println(document.toString());
    }
}
```

