    @Test
    public void test_next_SimpleCase() {
        int price = 1;
        when(price).thenReturn(0);
        onlineStockSpan.next(price);
        assertEquals(2, onlineStockSpan.next(price));
    }

    @Test
    public void test_next_SameDay() {
        int price = 5;
        when(price).thenReturn(4);
        onlineStockSpan.next(price);
        assertEquals(5, onlineStockSpan.next(price));
    }

