public class OnlineStockSpanTest {

    private OnlineStockSpan onlineStockSpan = new OnlineStockSpan();

    @Test
    public void test_next_SimpleCase() {
        int price = 1;
        when(price).thenReturn(0);
        int result = onlineStockSpan.next(price);
        assertEquals(1, result); // not max covering as it only adds one day of coverage
    }

    @Test
    public void test_next_SameDay() {
        int price = 5;
        when(price).thenReturn(1);
        int result = onlineStockSpan.next(price);
        assertEquals(2, result); // add two days of coverage for same day price
    }

    @Test
    public void test_next_DifferentDay() {
        int price = 3;
        when(price).thenReturn(4);
        int result = onlineStockSpan.next(price);
        assertEquals(5, result); // max covering for different day price is five days
    }

    @Test
    public void test_calculateSpans_SimpleCase() {
        int[] prices = {1, 3};
        when(Arrays.asList(prices)).thenReturn(prices);
        int[] result = onlineStockSpan.calculateSpans(prices);
        assertArrayEquals(new int[]{0, 2}, result); // max covering for simple case
    }

    @Test
    public void test_calculateSpans_SameDay() {
