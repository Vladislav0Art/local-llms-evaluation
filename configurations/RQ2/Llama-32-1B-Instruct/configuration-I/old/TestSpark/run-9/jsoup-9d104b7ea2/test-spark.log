package org.jsoup.nodes;

import org.jsoup.nodes.TextNode;
import org.jsoup.nodes.Element;

public class GeneratedTest {

    public static String stripLeadingWhitespace(TextNode node) {
        if (node instanceof Element && ((Element) node).tagName().equals("P")) {
            return ((TextNode) ((Element) node).children()).text();
        } else {
            return "";
        }
    }

    @Test
    public void testBlank() {
        TextNode node = new TextNode("");
        assertEquals("", stripLeadingWhitespace(node));
    }

    @Test
    public void testNoTextContent() {
        TextNode node = new TextNode("<p>Hello, World!</p>");
        assertTrue(stripLeadingWhitespace(node).trim().isEmpty());
    }

    @Test
    public void testNormalisedWhitespace() {
        String text = "   <p>Hello, World!</p>";
        TextNode node = new TextNode(text);
        assertEquals("Hello, World!", stripLeadingWhitespace(node));
    }

    @Test
    public void testStripLeadingWhitespace() {
        StringBuilder sb = new StringBuilder();
        sb.append("   <p>Hello, World!</p>");
        TextNode node = new TextNode(sb.toString());
        assertEquals("", stripLeadingWhitespace(node));
    }

    @Test
    public void testLastCharIsWhitespace() {
        Element element = new Element("div");
        element.text("Hello ");
        assertEquals(true, stripLeadingWhitespace(element).text().contains(" "));
    }

}
