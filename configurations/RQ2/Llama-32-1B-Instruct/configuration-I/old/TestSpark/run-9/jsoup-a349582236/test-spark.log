public class Tag {
    private static final ParseSettings DEFAULT_SETTINGS = new ParseSettings();

    public String getName() { return null; }
    public String normalName() { return null; }

    public static Tag valueOf(String tagName, ParseSettings settings) {
        // implementation for unknown tags
        if (tagName.equals("unknown")) {
            throw new IllegalArgumentException("Unknown tag");
        } else {
            return new Tag();
        }
    }

    public static Tag valueOf(String tagName) {
        ParseSettings settings = DEFAULT_SETTINGS;
        return valueOf(tagName, settings);
    }

    public boolean isBlock() { return false; }
    public boolean formatAsBlock() { return true; }
    public boolean isInline() { return false; }
    public boolean isEmpty() { return false; }
    public boolean isSelfClosing() { return false; }
    public boolean isKnownTag() { return false; }

    public static boolean isKnownTag(String tagName) {
        // implementation for known tags
        if (tagName.equals("p") || tagName.equals("div")) {
            return true;
        } else {
            return false;
        }
    }

    public static Tag setSelfClosing() {
        ParseSettings settings = DEFAULT_SETTINGS;
        settings.selfClosing = true;
        return valueOf("self-closing", settings);
    }

