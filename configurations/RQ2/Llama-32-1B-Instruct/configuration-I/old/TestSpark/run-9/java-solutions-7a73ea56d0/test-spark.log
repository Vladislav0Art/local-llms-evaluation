    private static int calculateLineCoverageAndCalculateSpans_SimpleCase(int[][] lines) {
        // Calculate the total number of lines.
        int totalLines = 0;
        for (int[] line : lines) {
            totalLines += line[1];
        }

        // Calculate the maximum line coverage.
        int maxCoverage = 0;
        int currentLineCoverage = 0;
        for (int i = 2; i < lines.length; i++) {
            if (lines[i][1] > maxCoverage) {
                maxCoverage = lines[i][1];
            }
            while (currentLineCoverage + lines[i-1][1] <= totalLines && currentLineCoverage + lines[i-1][1] - 1 >= 0) {
                currentLineCoverage++;
            }

            if (lines[i][1] > maxCoverage) {
                maxCoverage = lines[i][1];
            }
        }

        return totalLines / maxCoverage;
    }

