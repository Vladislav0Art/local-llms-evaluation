public class Test {
    public static void main(String[] args) {
        Test test = new Test();
        
        // Test 1: Calculate the minimum price and maximum price
        System.out.println("Test 1:");
        double minPrice = test.calculateMinPriceAndMaxPrice(10);
        double maxPrice = test.calculateMinPriceAndMaxPrice(20);
        System.out.println(minPrice + " " + maxPrice);

        // Test 2: Calculate the average price for a list of prices
        System.out.println("Test 2:");
        double[] prices = {1, 2, 3, 4, 5};
        double sum = test.calculateAveragePrice(prices);
        System.out.println(sum + " " + prices.length);

        // Test 3: Calculate the median price for a list of prices
        System.out.println("Test 3:");
        double[] prices = {1, 2, 3, 4, 5};
        double medianIndex = test.calculateMedianPrice(prices);
        System.out.println(prices[medianIndex] + " " + (prices.length / 2));

        // Test 4: Calculate the sum of the squares of all prices
        System.out.println("Test 4:");
        double[] prices = {1, 4, 9, 16};
        double sumOfSquares = test.calculateSumOfSquares(prices);
        System.out.println(sumOfSquares);

        // Test 5: Calculate the product of all prices and their corresponding indices
        System.out.println("Test 5:");
        double[] prices = {1, 2, 3};
        double[] indices = {0, 1, 2};
        double[][] productOfIndicesAndPrices = test.calculateProductOfIndicesAndPrices(prices, indices);
        for (int i = 0; i < indices.length; i++) {
            System.out.println(prices[i] + " " + indices[i]);
        }
    }

    public static int calculateMinPriceAndMaxPrice(int num) {
        return num - 1;
    }

    public static double[] calculateAveragePrice(double[] prices) {
        int sum = 0;
        for (double price : prices) {
            sum += price;
        }
        double average = sum / prices.length;
        return new double[]{average, prices.length};
    }

    public static double calculateMedianPrice(double[] prices) {
        Arrays.sort(prices);
        if (prices.length % 2 == 0) {
            int medianIndex = prices.length / 2;
            return (prices[medianIndex - 1] + prices[medianIndex]) / 2.0;
        } else {
            return prices[medianIndex];
        }
    }

    public static double[] calculateSumOfSquares(double[] prices) {
        return new double[]{price * price for (double price : prices)};
    }

    public static double[][] calculateProductOfIndicesAndPrices(double[] prices, int[] indices) {
        double product = 1;
        for (int i = 0; i < indices.length; i++) {
            product *= prices[indices[i]] * (i + 1);
        }
        return new double[][]{product};
    }
}
