        if (prices.length < 2) {
            throw new IllegalArgumentException("Array must have at least two elements");
        }
        double sum = 0;
        for (double price : prices) {
            sum += price;
        }
        return new double[prices.length] {sum / prices.length};
    }

    public static double calculateMedianPrice(double[] prices) {
        if (prices.length % 2 == 1) {
            throw new IllegalArgumentException("Array must have an odd number of elements to calculate the median");
        }
        Arrays.sort(prices);
        return prices[prices.length / 2];
    }

    public static double[] calculateSumOfSquares(double[] prices) {
        int size = prices.length;
        if (size < 2) {
            throw new IllegalArgumentException("Array must have at least two elements to calculate the sum of squares");
        }
        return new double[size] {price * price for (double price : prices)};
    }

    public static double[][] calculateProductOfIndicesAndPrices(double[] prices, int[] indices) {
        int size = prices.length;
        if (size < 2) {
            throw new IllegalArgumentException("Array must have at least two elements to calculate the product of indices and prices");
        }
        return new double[2] {{prices[i] * [price -> price * (indices[i] + 1)] for (int i = 0; i < size; i++)}};
    }
}
