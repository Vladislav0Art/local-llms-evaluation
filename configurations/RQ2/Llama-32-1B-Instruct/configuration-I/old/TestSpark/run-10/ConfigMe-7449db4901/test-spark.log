```java
public class SwitchStatementExample {
    public static String greet(int day) {
        switch (day) {
            case 1:
                return "Happy New Year!";
            case 2:
                return "Merry Valentine's Day!";
            default:
                return "Hello, World!";
        }
    }

    public static void main(String[] args) {
        System.out.println(greet(1)); // Output: Happy New Year!
        System.out.println(greet(3)); // Output: Hello, World!
    }
}
