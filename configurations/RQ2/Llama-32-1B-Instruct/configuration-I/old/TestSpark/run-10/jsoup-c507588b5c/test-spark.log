import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;

public class TextNodeTest {

    public static Document createTextNode(String text) {
        return new Document();
    }

    @Test
    public void TestBlank() {
        // Arrange
        String text = "";
        
        // Act
        TextNode textNode = new TextNode(text);
        
        // Assert
        assertTrue(TextNode.isBlank(textNode));
    }

    @Test
    public void TestSplitText() {
        // Arrange
        String text = "Hello World";
        int offset = 5;
        
        // Act
        TextNode textNode = new TextNode(text);
        Document doc = createTextNode(textNode.splitText(offset).text());
        String result = doc.text();
        
        // Assert
        assertEquals("World", result);
    }

    @Test
    public void TestCreateFromEncoded() {
        // Arrange
        String encodedText = "&lt;Hello&gt;";
        TextNode textNode = TextNode.createFromEncoded(encodedText);
        
        // Act
        String unencodedText = textNode.text();
        
        // Assert
        assertEquals("Hello", unencodedText);
    }

    @Test
    public void TestNormaliseWhitespace() {
        // Arrange
        String text = "   Hello World   ";
        
        // Act
        TextNode textNode = new TextNode(text);
        String result = textNode.normaliseWhitespace();
        
        // Assert
        assertEquals("Hello World", result);
    }

    @Test
    public void TestStripLeadingWhitespace() {
        // Arrange
        StringBuilder builder = new StringBuilder();
        
        // Act
        boolean result1 = TextNode.stripLeadingWhitespace(builder.toString());
        
        // Assert
        assertTrue(result1);
        
        String text = "   Hello World   ";
        result1 = TextNode.stripLeadingWhitespace(text);
        assertEquals(true, result1);
    }

    @Test
    public void TestLastCharIsWhitespace() {
        // Arrange
        StringBuilder sb = new StringBuilder();
        
        // Act
        boolean result1 = TextNode.lastCharIsWhitespace(sb);
        
        // Assert
        assertTrue(result1);
        
        String text = "abc";
        result1 = TextNode.lastCharIsWhitespace(text);
        assertEquals(true, result1);
    }
}
