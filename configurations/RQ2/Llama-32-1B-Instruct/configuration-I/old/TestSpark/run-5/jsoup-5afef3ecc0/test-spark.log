        byte[] pathBytes = new byte[encodedString.length];
        for (int i = 0; i < encodedString.length; i++) {
            pathBytes[i] = encodedString[i];
        }

        String encodedPath = System notation(pathBytes);
        System.out.println(encodedPath);

        String queryParameters = generateRandomString(10000).getBytes(StandardCharsets.UTF_8);
        String encodedQueryParams = System.net.StandardHttpProtocol.encode(queryParameters);

        String encodedUrl = System.url(urlBase + ":" + port + "/" + method + "?" + encodedQueryParams);
        System.out.println(encodedUrl);

    }

    public static byte[] generateRandomString(int length) {
        StringBuilder sb = new StringBuilder(length);
        for (int i = 0; i < length; i++) {
            char c = (char) ('a' + (new Random()).nextInt(26));
            sb.append(c);
        }
        return sb.toString().getBytes(StandardCharsets.UTF_8);
    }

    public static String SystemNotation(byte[] bytes) {
        StringBuilder sb = new StringBuilder();
        for (byte b : bytes) {
            sb.append((char) b);
        }
        return sb.toString();
    }

    public static String SystemUrl(String baseUrl, int port, String method, byte... pathBytes) {
        StringBuilder sb = new StringBuilder(baseUrl + ":" + port + "/" + method);

        if (pathBytes != null) {
            for (byte b : pathBytes) {
                sb.append(" ").append(System.lineSeparator());
            }
        }

        return sb.toString();
    }

}
