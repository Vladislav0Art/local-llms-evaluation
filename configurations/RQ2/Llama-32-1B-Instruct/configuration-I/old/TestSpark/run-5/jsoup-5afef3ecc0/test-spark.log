import java.nio.charset.StandardCharsets;
import java.util.Random;

public class Main {

    public static void main(String[] args) {
        generateRandomUrl("http://example.com");
    }

    public static void generateRandomUrl(String baseUrl) {
        Random random = new Random();
        StringBuilder sb = new StringBuilder(baseUrl);

        // Generate a random path
        String path = generateRandomString(1000);
        sb.append("/").append(path).append("");

        // Generate random query parameters
        int numParams = 10;
        byte[] queryBytes = new byte[numParams * 4];
        for (int i = 0; i < numParams; i++) {
            int valueLength = random.nextInt(3) + 1;
            if (valueLength == 1) {
                queryBytes[i] = (byte) ('v' + (random.nextInt(26)));
