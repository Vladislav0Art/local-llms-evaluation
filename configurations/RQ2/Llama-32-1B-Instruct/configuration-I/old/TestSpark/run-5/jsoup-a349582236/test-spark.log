public class TagImpl implements Cloneable {
    
    private String name;
    private String normalizedName;

    @Override
    protected String clone() {
        return name != null ? "TagImpl" + (normalizedName != null ? "_" + normalizedName : "") : "Tag";
    }

    public void setName(String name) { this.name = name; }
    public String getName() { return name; }
    public String normalName() { return name == null ? null : name.toLowerCase(); }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;

        TagImpl that = (TagImpl) o;

        if (!name.equals(that.name)) return false;
        return normalizedName.equals(that.normalizedName);
    }

    @Override
    public int hashCode() {
        int result = name.hashCode();
        result = 31 * result + normalizedName.hashCode();
        return result;
    }
}

public class Tag {

    private static final Tag valueOfP = new TagImpl("p");
    private static final Tag valueOfDiv = new TagImpl("div");

    public static Tag valueOf(String tagName, ParseSettings settings) {
        switch (tagName.toLowerCase()) {
            case "p":
                return valueOfP;
            case "d":
                return valueOfDiv;
            default:
                throw new UnsupportedOperationException(tagName);
        }
    }

    public static Tag valueOf(String tagName) {
        if (!valueOfP.name.equals(tagName)) {
            switch (tagName.toLowerCase()) {
                case "p":
                    return valueOfP;
                case "d":
                    return valueOfDiv;
                default:
                    throw new UnsupportedOperationException(tagName);
            }
        }
        return null;
    }

    public boolean isBlock() { 
        return true; // Not a block tag
    }

    public boolean formatAsBlock() {
        return false; // Not a block tag
    }

    public boolean isInline() { 
        return false; // Not an inline tag
    }

    public boolean isEmpty() { 
        return true; // Empty
    }

    public boolean isSelfClosing() {
        return false; // Not self-closing
    }

    public boolean isKnownTag() {
        return false; // Not a known HTML tag
    }

    public static boolean isKnownTag(String tagName) {
        switch (tagName.toLowerCase()) {
            case "p":
                return true;
            case "div":
                return true;
            default:
                throw new UnsupportedOperationException(tagName);
        }
    }

    public void setSelfClosing() {
        // Not a self-closing tag
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;

        Tag tag = (Tag) o;

        return normalizedName.equals(tag.normalizedName);
    }
}
