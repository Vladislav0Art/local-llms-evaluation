// Import necessary classes from the java.util package.
import java.util.HashMap;
import java.util.Map;

/**
 * A simple class representing a HTML tag.
 */
public class Tag {
    // Create a new tag object with a name parameter.
    private String name;

    /**
     * Constructor for creating a new Tag object.
     *
     * @param name The name of the HTML tag.
     */
    public Tag(String name) {
        this.name = name;  
    }

    /**
     * Get the current tag's name.
     *
     * @return The name of the HTML tag.
     */
    public String getName() {
        return name;
    }

    // Override the equals method to compare two tag objects based on their names.
    @Override
    public boolean equals(Object obj) {
        if (this == obj)
            return true;  
        if (obj == null || getClass() != obj.getClass())
            return false;

        Tag tag = (Tag) obj;

        // Compare the current tag's name with the other tag's name.
        return name.equals(tag.name);  
    }

    @Override
    public int hashCode() {
        // Return a hash code based on the current tag's name.
        return name.hashCode();  
    }

    /**
     * Create a new Tag object from a given string.
     *
     * @param name The name of the HTML tag to be created.
     * @return A new Tag object with the specified name.
     */
    public static Tag createTag(String name) {
        Map<String, Object> map = new HashMap<>();
        map.put("name", name);
        return (Tag) map.get("name");  
    }
}

/**
 * Main class for testing the Tag class.
 */
public class TestTag {
    /**
     * Main method to test the functionality of the Tag class.
     *
     * @param args Command-line arguments passed to the program.
     */
    public static void main(String[] args) {
        // Create two tag objects with different names.
        Tag tag1 = Tag.createTag("p");
        Tag tag2 = Tag.createTag("P");

        // Check if both tags are equal using the equals method.
        System.out.println(tag1.equals(tag2));  

        // Get and print the name of each tag.
        System.out.println(tag1.getName());  
        System.out.println(tag2.getName());
    }
}
```

