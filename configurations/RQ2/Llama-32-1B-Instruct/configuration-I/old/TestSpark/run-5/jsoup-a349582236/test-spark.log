import java.util.HashMap;
import java.util.Map;

public class Tag {
    // Create a new tag object with a name parameter.
    private String name;

    public Tag(String name) {
        this.name = name;  // Assign the name parameter to the private field.
    }

    // Get the current tag's name.
    public String getName() {
        return name;
    }

    // Override the equals method to compare two tag objects based on their names.
    @Override
    public boolean equals(Object obj) {
        if (this == obj)
            return true;  // If the object is the same as this, it's equal.
        if (obj == null || getClass() != obj.getClass())
            return false;

        Tag tag = (Tag) obj;

        // Compare the current tag's name with the other tag's name.
        return name.equals(tag.name);  
    }

    @Override
    public int hashCode() {
        // Return a hash code based on the current tag's name.
        return name.hashCode();  
    }

    // Create a new tag object from a given string.
    public static Tag createTag(String name) {
        Map<String, Object> map = new HashMap<>();
        map.put("name", name);
        return (Tag) map.get("name");  // Return the created tag object as an instance of the class.
    }
}

