import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.select.Elements;

public class Main {
    public static void main(String[] args) {
        // Create documents
        Document document1 = Jsoup.parse("HTML");
        Document document2 = Jsoup.parse("<html><body>Hello World!</body></html>");

        // Parse HTML strings into documents
        String htmlString1 = "<div>Hello, I'm a paragraph.</p>";
        String htmlString2 = "<h1>Hi, it's me! This is my heading.</h1>";

        // Check if the HTMLs are valid
        Document document3 = Jsoup.parse(htmlString1);
        System.out.println(document3.select("p").isEmpty());
        System.out.println(document3.select("h1").isEmpty());

        // Split strings into words and check for whitespace
        String text = "Hello, I'm a paragraph. This is a heading.";
        String[] words = text.split("\\s+");
        for (String word : words) {
            System.out.println(word);
        }

        // Join words back together with hyphens
        StringBuilder sentenceBuilder = new StringBuilder();
        for (String word : words) {
            if (!sentenceBuilder.isEmpty()) {
                sentenceBuilder.append("-");
            }
            sentenceBuilder.append(word);
        }
        String sentence1 = sentenceBuilder.toString();

        // Replace whitespace in the first string
        String text2 = "Hello, I'm a paragraph. This is a heading.";
        String[] words2 = text2.split("\\s+");
        for (int i = 0; i < words2.length - 1; i++) {
            System.out.println(words2[i]);
        }
        System.out.println(text2.replace(" ", ""));
    }
}
