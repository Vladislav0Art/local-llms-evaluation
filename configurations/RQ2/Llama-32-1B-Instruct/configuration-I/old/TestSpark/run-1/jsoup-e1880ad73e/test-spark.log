    public void testBuild() {
        URLBuilder urlBuilder = new UrlBuilder(new URL("https://example.com"));
        URL result = urlBuilder.build();
        assert result.getScheme() != null && !result.getProtocol().isEmpty() || result.getHost() == null;
    }

