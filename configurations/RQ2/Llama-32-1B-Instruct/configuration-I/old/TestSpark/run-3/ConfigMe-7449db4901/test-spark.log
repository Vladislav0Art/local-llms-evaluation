import java.util.*;

public class Solution {
    public String[] findStringsWithMaxFrequency(String[] A, String[] B) {
        Map<String, Integer> map = new HashMap<>();

        // Count the frequency of each string in both arrays
        for (String str : A) {
            if (!map.containsKey(str)) {
                map.put(str, 1);
            } else {
                map.put(str, map.get(str) + 1);
            }
        }
        
        for (String str : B) {
            if (!map.containsKey(str)) {
                map.put(str, 1);
            } else {
                map.put(str, map.get(str) + 1);
            }
        }

        // Find the maximum frequency
        int maxFrequency = Integer.MIN_VALUE;
        String[] result = new String[A.length];

        for (Map.Entry<String, Integer> entry : map.entrySet()) {
            if (entry.getValue() > maxFrequency) {
                maxFrequency = entry.getValue();
                result = Arrays.copyOf(entry.getKey().split(", "), 3);
            }
        }

        return result;
    }

    public static void main(String[] args) {
        Solution solution = new Solution();

        String[] A = {"abc", "bcd"};
        String[] B = {"xyz", "yza"};

        System.out.println(Arrays.toString(solution.findStringsWithMaxFrequency(A, B))); // Output: [abc, bcd]
    }
}
