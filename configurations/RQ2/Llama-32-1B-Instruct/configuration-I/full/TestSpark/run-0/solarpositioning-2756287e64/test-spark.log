import org.junit.jupiter.api.Test;
import static org.mockito.Mockito.*;

public class Grena3Test {

    @Test
    public void testCalculateSolarPosition_WithValidInput_SolarAngleIsCorrect() {
        // Arrange
        ZonedDateTime date = new ZonedDateTime(2024, 1, 1, 12, 0, 0);
        double latitude = -34.0;
        double longitude = -118.0;
        double deltaT = 10; // seconds

        // Act
        AzimuthZenithAngle result = Grena3.calculateSolarPosition(date, latitude, longitude, deltaT);

        // Assert
        assertNotNull(result.getAzimuth());
        assertEquals(120.0, result.getAzimuth(), 1e-2);
    }

    @Test
    public void testCalculateSolarPosition_WithLatitudeNegativeAndLongitudeZero_SolarAngleIsCorrect() {
        // Arrange
        ZonedDateTime date = new ZonedDateTime(2024, 1, 1, 12, 0, 0);
        double latitude = -40.0;
        double longitude = 0.0;
        double deltaT = 10; // seconds

        // Act
        AzimuthZenithAngle result = Grena3.calculateSolarPosition(date, latitude, longitude, deltaT);

        // Assert
        assertNotNull(result.getAzimuth());
        assertEquals(100.0, result.getAzimuth(), 1e-2);
    }

    @Test
    public void testCalculateSolarPosition_WithDeltaTZero_SolarAngleIsCorrect() {
        // Arrange
        ZonedDateTime date = new ZonedDateTime(2024, 1, 1, 12, 0, 0);
        double latitude = -34.0;
        double longitude = -118.0;

        // Act
        AzimuthZenithAngle result = Grena3.calculateSolarPosition(date, latitude, longitude, 0);

        // Assert
        assertNotNull(result.getAzimuth());
        assertEquals(120.0, result.getAzimuth(), 1e-2);
    }

    @Test
    public void testCalculateSolarPosition_WithPressureAndTemperatureZero_SolarAngleIsCorrect() {
        // Arrange
        ZonedDateTime date = new ZonedDateTime(2024, 1, 1, 12, 0, 0);
        double latitude = -34.0;
        double longitude = -118.0;

        // Act
        AzimuthZenithAngle result = Grena3.calculateSolarPosition(date, latitude, longitude, 0, 0, 20);

        // Assert
        assertNotNull(result.getAzimuth());
        assertEquals(120.0, result.getAzimuth(), 1e-2);
    }

    @Test
    public void testCalculateSolarPosition_WithInvalidPressureAndTemperature_SolarAngleIsCorrect() {
        // Arrange
        ZonedDateTime date = new ZonedDateTime(2024, 1, 1, 12, 0, 0);
        double latitude = -34.0;
        double longitude = -118.0;

        // Act and Assert
        AzimuthZenithAngle result = Grena3.calculateSolarPosition(date, latitude, longitude, 10, 25);

        // Assert
        assertNotNull(result.getAzimuth());
    }
}
