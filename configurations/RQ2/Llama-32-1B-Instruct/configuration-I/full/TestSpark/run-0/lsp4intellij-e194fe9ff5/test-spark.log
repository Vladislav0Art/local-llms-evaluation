import com.intellij.openapi.editor.Editor;
import com.intellij.openapi.fileEditor.FileEditorManager;
import com.intellij.openapi.fileSystem.FileSystemUtil;
import com.intellij.openapi.util.TextDocumentIdentifier;
import com.intellij.openapi.util.TextDocumentIdentifierType;
import com.intellij.openapi.util.text.StringUtil;

public class TestUtilities {

    public static Editor getEditor(String filePath) {
        File file = FileSystemUtil.openFileInTextContext(filePath, true);
        return (Editor) FileEditorManager.getInstance().getEditor(file);
    }

    public static TextDocumentIdentifier getEditorToLSPIdentifier(Editor editor) {
        return getEditor(editor.getDocument()).toLSPIdentifier();
    }

    public static void setId(long id, Editor editor) {
        editor.setId(id);
    }

    public static String editorToString(Editor editor, String fileName) {
        return getEditor(fileName).toString();
    }

    public static class TestClass {
        private long id;

        public TestClass() {
            this.id = 1;
        }

        public long getId() {
            return id;
        }

        public void setId(long id) {
            this.id = id;
        }
    }

    public static void main(String[] args) {
        Editor editor = TestUtilities.getEditor("/path/to/file.txt");
        System.out.println("Editor Name: " + TestUtilities.editorToString(editor, "MyFile"));
        
        TextDocumentIdentifier identifier = TestUtilities.getEditorToLSPIdentifier(editor);
        System.out.println("Identifier: " + identifier);

        setId(5, editor);
        System.out.println("Id Set to 5: " + TestUtilities.setId(5, editor));
    }
}
