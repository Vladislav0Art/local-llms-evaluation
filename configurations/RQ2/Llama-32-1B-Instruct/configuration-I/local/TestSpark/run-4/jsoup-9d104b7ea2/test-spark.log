import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.select.Elements;

public class TextNodeTest {

    public static void main(String[] args) {
        new TextNodeTest().testTextNodes();
    }

    public void testTextNodes() {
        // Arrange
        String text = "Hello World!";
        
        Document document = new Document();
        Elements elements = document.select("");
        
        // Split the text at specific offsets
        assertTrue(org.jsoup.nodes.TextNode.splitTextAtOffset(document, 10).isBlank());
        assertFalse(org.jsoup.nodes.TextNode.splitTextAtOffset(document, 20).isBlank());

        // Append to and remove from an element
        Element outerHtmlHead = document.createElement("head");
        document.appendChild(outerHtmlHead);
        outerHtmlHead.appendChild(document.createTextNode(text));
        
        assertTrue(org.jsoup.nodes.TextNode.outerHtmlHeadAppendText(outerHtmlHead, "Test"));
        assertEquals(text.length(), org.jsoup.nodes.TextNode.outerHtmlTail(outerHtmlHead).length());
    }

    public void testOuterHtmlHeadAppendText() {
        // Arrange
        String text = "Hello World!";
        
        Document document = new Document();
        Element outerHtmlHead = document.createElement("head");
        document.appendChild(outerHtmlHead);
        
        assertTrue(org.jsoup.nodes.TextNode.outerHtmlHeadAppendText(outerHtmlHead, text));
    }

    public void testOuterHtmlTailAppendText() {
        // Arrange
        String text = "Hello World!";
        
        Document document = new Document();
        Element outerHtmlHead = document.createElement("head");
        document.appendChild(outerHtmlHead);
        
        assertTrue(org.jsoup.nodes.TextNode.outerHtmlTailAppendText(outerHtmlHead, text));
    }

}
