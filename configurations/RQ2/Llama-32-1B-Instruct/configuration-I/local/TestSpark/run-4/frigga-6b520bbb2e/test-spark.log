    public static void amitest(String appName, String environment) {
        Map<String, String> appVersions = new HashMap<>();
        appVersions.put("v1", "12345");
        appVersions.put("v2", "67890");

        Map<String, Integer> jobNames = new HashMap<>();
        jobNames.put("job1", 1);
        jobNames.put("job2", 2);

        Map<String, String> buildJobs = new HashMap<>();
        buildJobs.put("build1", "11111");
        buildJobs.put("build2", "22222");

