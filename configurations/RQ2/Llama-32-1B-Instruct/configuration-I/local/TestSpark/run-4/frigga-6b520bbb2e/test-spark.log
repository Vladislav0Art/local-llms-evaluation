            System.out.println(commits.get("commit1"));
        } else if (environment.equals("prod")) {
            System.out.println(appVersions.get(appName) + "\n" + jobNames.get("job2") + "\n" + buildJobs.get("build2"));
            System.out.println(commits.get("commit1"));
        }
    }

    public static void main(String[] args) {
        amitest("v1", "dev");
        amitest("v2", "prod");
    }
}
