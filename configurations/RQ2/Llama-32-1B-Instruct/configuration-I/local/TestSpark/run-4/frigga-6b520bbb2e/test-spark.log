import java.util.HashMap;
import java.util.Map;

public class Main {
    public static void amitest(String appName, String environment) {
        // Create maps to store data
        Map<String, String> appVersions = new HashMap<>();
        appVersions.put("v1", "12345");
        appVersions.put("v2", "67890");

        Map<String, Integer> jobNames = new HashMap<>();
        jobNames.put("job1", 1);
        jobNames.put("job2", 2);

        Map<String, String> buildJobs = new HashMap<>();
        buildJobs.put("build1", "11111");
        buildJobs.put("build2", "22222");

        Map<String, String> commits = new HashMap<>();

        // Check if environment is valid
        if (!appVersions.containsKey(environment)) {
            System.out.println("Invalid environment. Environment must be 'dev' or 'prod'.");
            return;
        }

        // Retrieve data for the given environment
        String appVersion = appVersions.get(environment);
        int jobName = jobNames.get("job1");  // Assuming job names are unique
        String buildJob = buildJobs.get("build1");  // Assuming build jobs are unique
        String commit = commits.get("commit1");

        // Print the data for the given environment
        System.out.println(appVersion + "\n" + jobName + "\n" + buildJob);
        System.out.println(commit);
    }

    public static void main(String[] args) {
        amitest("v1", "dev");
        amitest("v2", "prod");
    }
}
```

