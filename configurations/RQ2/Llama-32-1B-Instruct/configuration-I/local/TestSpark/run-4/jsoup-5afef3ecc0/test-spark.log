import org.jsoup.helper.UrlBuilder;
import org.junit.jupiter.api.Test;
import java.net.URL;
import java.util.Arrays;

public class UrlBuilderTest {

    @Test
    public void build_url() {
        UrlBuilder urlBuilder = new UrlBuilder(new URL("http://example.com"));
        URL expectedUrl = "http://example.com";
        assertEquals(expectedUrl, urlBuilder.build());
    }

    @Test
    public void append_key_val() throws UnsupportedEncodingException {
        URLBuilder urlBuilder = new UrlBuilder(new URL("http://example.com"));
        URLKeyValMap kvMap = new URLKeyValMap();
        urlBuilder.appendKeyVal(kvMap);
        String expected = "http://example.com#key=val";
        assertEquals(expected, urlBuilder.build().toURLString());
    }

    @Test
    public void append_key_val_no_key() throws UnsupportedEncodingException {
        URLBuilder urlBuilder = new UrlBuilder(new URL("http://example.com"));
        URLKeyValMap kvMap = new URLKeyValMap();
        urlBuilder.appendKeyVal(kvMap);
        String expected = "http://example.com#val";
        assertEquals(expected, urlBuilder.build().toURLString());
    }

    @Test
    public void append_key_val_too_long() {
        URLBuilder urlBuilder = new UrlBuilder(new URL("http://example.com"));
        URLKeyValMap kvMap = new URLKeyValMap();
        String[] kv = {"key", "val"};
        urlBuilder.appendKeyVal(kv);
        String expected = "http://example.com#key=val";
        assertNotEquals(expected, urlBuilder.build().toURLString());
    }

    @Test
    public void append_key_val_unsupportedEncodingException() {
        URLBuilder urlBuilder = new UrlBuilder(new URL("http://example.com"));
        URLKeyValMap kvMap = new URLKeyValMap();
        try {
            urlBuilder.appendKeyVal(null);
            fail("Expected UnsupportedEncodingException");
        } catch (UnsupportedEncodingException e) {
            // expected
        }
    }

    @Test
    public void append_key_val_no_key_value() {
        URLBuilder urlBuilder = new UrlBuilder(new URL("http://example.com"));
        URLKeyValMap kvMap = new URLKeyValMap();
        urlBuilder.appendKeyVal(kvMap);
        String expected = "http://example.com";
        assertEquals(expected, urlBuilder.build().toURLString());
    }

    @Test
    public void append_key_val_emptyKey() {
        URLBuilder urlBuilder = new UrlBuilder(new URL("http://example.com"));
        URLKeyValMap kvMap = new URLKeyValMap();
        urlBuilder.appendKeyVal(kvMap);
        String expected = "http://example.com#";
        assertEquals(expected, urlBuilder.build().toURLString());
    }
}

class URL {
    private final String url;
    public URL(String url) {
        this.url = url;
    }
}

