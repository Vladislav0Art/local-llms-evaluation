import java.net.HttpURLConnection;
import java.net.URL;
import java.util.HashMap;
import java.util.Map;

public class TestUrlBuilder {
    private Map<String, String> urlMap = new HashMap<>();

    public void appendKeyVal(String key, String value) {
        urlMap.put(key, value);
    }

    public String get() {
        return urlMap.get("https://example.com");
    }

    public static void main(String[] args) throws Exception {
        TestUrlBuilder builder = new TestUrlBuilder();
        builder.appendKeyVal("key1", "value1");

        URL url = new URL("http://localhost:8080/test?key1=value1");
        HttpURLConnection connection = (HttpURLConnection) url.openConnection();
        connection.setRequestMethod("GET");
        int responseCode = connection.getResponseCode();

        if (responseCode == 200) {
            String response = new String(connection.getInputStream().readAllBytes());
            System.out.println(response);
            builder.appendKeyVal("key2", "value2");

            URL url2 = new URL("http://localhost:8080/test?key1=value1&key2=value2");
            connection = (HttpURLConnection) url2.openConnection();
            connection.setRequestMethod("GET");
            responseCode = connection.getResponseCode();

            if (responseCode == 200) {
                String response2 = new String(connection.getInputStream().readAllBytes());
                System.out.println(response2);
            }
        }

        System.out.println(builder.get());
    }
}
