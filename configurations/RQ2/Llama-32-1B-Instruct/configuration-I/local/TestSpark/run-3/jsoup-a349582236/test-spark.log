public class EncapsulationExample {
    private int privateVariable = 10;
    public int publicVariable = 20;

    public void publicMethod() {}

    public void method() {}
}

class InnerClass extends EncapsulationExample {
    private String privateString = "Hello, World!";
    
    public void publicMethod() {} // Accessible from outer class
}

public class Main {
    public static void main(String[] args) {
        EncapsulationExample testObj = new EncapsulationExample();

        System.out.println("Private Variable: " + testObj.privateVariable);
        System.out.println("Public Variable: " + testObj.publicVariable);

        testObj.publicMethod(); // Calls publicMethod from outer class

        InnerClass innerObj = new InnerClass();
        
        System.out.println("Inner String: " + innerObj.privateString);
    }
}
```

