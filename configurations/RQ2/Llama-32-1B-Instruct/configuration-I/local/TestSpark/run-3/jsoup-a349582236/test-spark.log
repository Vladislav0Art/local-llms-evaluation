public class TagValueTest {

    private Tag value;

    public void setUp() {
        MockitoAnnotations.initMocks(this);
    }

    @Test
    public void testvalueOf_ParsesBlockTag() {
        value = Tag.valueOf("P", ParseSettings.PARALLEL);
        Assert.assertTrue(value.isBlock());
        Assert.assertFalse(value.formatAsBlock());
        Assert.assertFalse(value.isInline());
        Assert.assertFalse(value.isEmpty());
        Assert.assertFalse(value.isSelfClosing());
        Assert.assertTrue(value.isKnownTag());
    }

    @Test
    public void testvalueOf_ParsesInlineTag() {
        value = Tag.valueOf("p", ParseSettings.PARALLEL);
        Assert.assertFalse(value.isBlock());
        Assert.assertTrue(value.formatAsBlock());
        Assert.assertTrue(value.isInline());
        Assert.assertFalse(value.isEmpty());
        Assert.assertFalse(value.isSelfClosing());
        Assert.assertTrue(value.isKnownTag());
    }

    @Test
    public void testvalueOf_UnknownTag() {
        value = Tag.valueOf("unknown", ParseSettings.PARALLEL);
        Assert.assertFalse(value.isBlock());
        Assert.assertFalse(value.formatAsBlock());
        Assert.assertFalse(value.isInline());
        Assert.assertFalse(value.isEmpty());
        Assert.assertFalse(value.isSelfClosing());
        Assert.assertFalse(value.isKnownTag());
    }

    @Test
    public void testValueOf_ParsesTagWithSettings() {
        value = Tag.valueOf("p", ParseSettings.PARALLEL);
        Assert.assertTrue(value.isBlock());
        Assert.assertFalse(value.formatAsBlock());
        Assert.assertFalse(value.isInline());
        Assert.assertFalse(value.isEmpty());
        Assert.assertFalse(value.isSelfClosing());
        Assert.assertTrue(value.isKnownTag());
    }

    @Test
    public void testValueOf_ParsesTagWithoutSettings() {
        value = Tag.valueOf("p");
        Assert.assertTrue(value.isBlock());
        Assert.assertFalse(value.formatAsBlock());
        Assert.assertFalse(value.isInline());
        Assert.assertFalse(value.isEmpty());
        Assert.assertFalse(value.isSelfClosing());
        Assert.assertTrue(value.isKnownTag());
    }

}
