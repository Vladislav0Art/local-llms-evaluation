import org.junit.jupiter.api.Test;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.CsvSource;

public class OnlineStockSpanTest {

    @ParameterizedTest
    @CsvSource({
            "1,1,2",
            "2,3,5"
    })
    void testNext_givenPrice_givenResult(int price, int expectedResult) {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int result = onlineStockSpan.next(price);
        assertEquals(expectedResult, result);
    }

    @ParameterizedTest
    @CsvSource({
            "1,2",
            "3,4"
    })
    void testCalculateSpans_givenPrices_result(int[] prices) {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int[] result = onlineStockSpan.calculateSpans(prices);
        assertArrayEquals(new int[]{1, 3}, result);
    }

    @Test
    void testNext_noPrice() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int result = onlineStockSpan.next(-1);
        assertEquals(0, result);
    }
}
