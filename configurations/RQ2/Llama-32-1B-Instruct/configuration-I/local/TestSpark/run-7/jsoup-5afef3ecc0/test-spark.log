import org.jsoup.helper.UrlBuilder;
import static org.junit.Assert.*;

public class UrlBuilderTest {

    public static class Connection {
        public String key;
        public String value;
    }

    @Test
    public void testBuild() {
        // Arrange
        String inputUrl = "http://example.com";
        UrlBuilder urlBuilder = new UrlBuilder(inputUrl);
        
        // Act
        URL url = urlBuilder.build();
        
        // Assert
        assertEquals(inputUrl, url.toString());
    }

    @Test
    public void testAppendKeyVal_SingleKeyValue() {
        Connection connection = new Connection();
        connection.key = "key";
        connection.value = "value";

        String inputUrl = "http://example.com";
        UrlBuilder urlBuilder = new UrlBuilder(inputUrl);
        URL parsedUrl = urlBuilder.build();
        
        String expectedUrl = "http://example.com/key/value";
        assertEquals(expectedUrl, parsedUrl.toString());
    }

    @Test
    public void testAppendKeyVal() {
        Connection connection1 = new Connection();
        connection1.key = "key1";
        connection1.value = "value1";

        Connection connection2 = new Connection();
        connection2.key = "key2";
        connection2.value = "value2";

        String inputUrl = "http://example.com";
        UrlBuilder urlBuilder = new UrlBuilder(inputUrl);
        URL parsedUrl1 = urlBuilder.build();
        
        URL parsedUrl2 = urlBuilder.appendKeyVal(connection1, connection2).build();
        
        String expectedUrl = "http://example.com/key1/key2/value1/value2";
        assertEquals(expectedUrl, parsedUrl1.toString());
    }

}
