import org.junit.Test;
import org.mockito.Mockito;

public class AppVersionTest {

    @Test
    public void testParseName_ThrowsExceptionWhenInvalidString() {
        // Arrange
        String amiName = null;
        Mockito.when(AppVersion.parseName(amiName)).thenReturn(AppVersion.class);

        try {
            AppVersion.parseName(amiName);
            fail("Expected exception to be thrown");
        } catch (Exception e) {
            // Expected
        }
    }

    @Test
    public void testParseName_SucceedsWhenValidString() {
        // Arrange
        String amiName = "1234567890abcdef";
        Mockito.when(AppVersion.parseName(amiName)).thenReturn(new AppVersion());

        AppVersion parseName = AppVersion.parseName(amiName);
        // Act
        System.out.println(parseName.toString());
    }

    @Test
    public void testGetPackageName() {
        // Arrange
        String amiName = "1234567890abcdef";
        Mockito.when(AppVersion.parseName(amiName)).thenReturn(new AppVersion());

        AppVersion parseName = new AppVersion();
        parseName.setPackageName("package");

        System.out.println(parseName.getPackageName());
    }

    @Test
    public void testGetVersion() {
        // Arrange
        String amiName = "1234567890abcdef";
        Mockito.when(AppVersion.parseName(amiName)).thenReturn(new AppVersion());

        AppVersion parseName = new AppVersion();
        parseName.setVersion("1.0");

