package org.jsoup.nodes;

public class GeneratedTest {

    @Test
    public void testBlankText() {
        // Arrange
        String text = "";

        // Act
        org.jsoup.nodes.TextNode textNode = new org.jsoup.nodes.TextNode(text);

        // Assert
        assertTrue(TextNode.isBlank(text));
    }

    @Test
    public void testSplitText_SplittingToTheRight() {
        // Arrange
        String text = "Hello World";

        // Act
        org.jsoup.nodes.TextNode textNode1 = new org.jsoup.nodes.TextNode(text);
        TextNode splitTextNode = textNode1.splitText(7);

        // Assert
        assertTrue(splitTextNode.text().length() == 7 && splitTextNode.text().contains("World"));
    }

    @Test
    public void testSplitText_SplittingToLeft() {
        // Arrange
        String text = "Hello World";

        // Act
        org.jsoup.nodes.TextNode textNode1 = new org.jsoup.nodes.TextNode(text);
        TextNode splitTextNode = textNode1.splitText(7);

        // Assert
        assertTrue(splitTextNode.text().contains("Hello") && splitTextNode.text().length() == 6);
    }

    @Test
    public void testClone_CloningToSameDocument() {
        // Arrange
        String text = "Hello World";

        // Act
        org.jsoup.nodes.TextNode textNode1 = new org.jsoup.nodes.TextNode(text);
        org.jsoup.nodes.TextNode textNode2 = textNode1.clone();

        // Assert
        assertEquals(textNode1, textNode2);
    }

    @Test
    public void testToString_SortedText() {
        // Arrange
        String text = "Hello World";

        // Act
        String result = TextNode.toString(text);

        // Assert
        assertTrue(result.equals("Worldello H"));
    }

}
