    @Test
    public void testSplitText_SplittingToTheRight() {
        // Arrange
        String text = "Hello World";

        // Act
        TextNode textNode1 = new TextNode(text).splitText(7);

        // Assert
        assertTrue(textNode1.text().contains("World"));
    }

    @Test
    public void testSplitText_SplittingToLeft() {
        // Arrange
        String text = "Hello World";

        // Act
        TextNode textNode1 = new TextNode(text).splitText(7);

        // Assert
        assertTrue(textNode1.text().contains("World"));
    }

    @Test
