import org.jsoup.nodes.TextNode;
import org.jsoup.nodes.TextNodeClone;

public class TextNodeTests {

    @Test
    public void testBlankText() {
        // Arrange
        String text = "";
        
        // Act
        TextNode textNode = new TextNode(text);
        
        // Assert
        assertTrue(TextNode.isBlank(text));
    }

    @Test
    public void testSplitText_SplittingToTheRight() {
        // Arrange
        String text = "Hello World";
        
        // Act
        TextNode textNode1 = new TextNode(text).splitText(7);
        
        // Assert
        assertTrue(textNode1.text().contains("World"));
    }

    @Test
    public void testSplitText_SplittingToLeft() {
        // Arrange
        String text = "Hello World";
        
        // Act
        TextNode textNode1 = new TextNode(text).splitText(7);
        
        // Assert
        assertTrue(textNode1.text().contains("World"));
    }

    @Test
    public void testClone_CloningToSameDocument() {
        // Arrange
        String text = "Hello World";
        
        // Act
        TextNode textNode1 = new TextNode(text).clone();
        
        // Assert
        assertEquals(text, textNode1.text());
    }

    @Test
    public void testToString_SortedText() {
        // Arrange
        String text = "Worldello H";
        
        // Act
        String result = TextNode.toString(text);
        
        // Assert
        assertTrue(result.equals("H Worldello"));
    }
}
