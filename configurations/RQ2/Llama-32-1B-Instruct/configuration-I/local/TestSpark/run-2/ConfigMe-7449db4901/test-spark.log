        list.add("value1");
        list.add("value2");

        when(getAllComments()).thenReturn(list);

        assertEquals(Arrays.asList("value1", "value2"), getAllComments());
    }

    private Map<String, List<String>> getAllComments() {
        return mock(Map.class);
    }
}
