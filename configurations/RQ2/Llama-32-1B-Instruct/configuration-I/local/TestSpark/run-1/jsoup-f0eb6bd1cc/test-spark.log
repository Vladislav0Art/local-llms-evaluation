import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.select.Elements;

public class GeneratedTest {
    public static String urlToString(StringBuilder sb, String prefix) throws UnsupportedEncodingException {
        // ... existing code ...
        return sb.toString();
    }

    public static String appendKeyVal(KeyVal kv, StringBuilder sb) throws IOException {
        UrlBuilder urlBuilder = new UrlBuilder(url);
        Document doc = Jsoup.parse(sb.toString());
        Elements elements = doc.select("input[type=hidden]");
        for (Element element : elements) {
            element.attr("value", kv.getKey() + "=" + kv.getValue());
        }
        sb.appendUrl(urlBuilder.toString());
        return sb.toString();
    }

    public static void testAppendKeyVal() throws UnsupportedEncodingException, IOException {
        // ... existing code ...
        String url = "https://example.com";
        KeyVal kv = new KeyVal("key", "value");
        String expectedOutput = "https://example.com?key=value&key2=value2";
        assertEquals(expectedOutput, appendKeyVal(kv, Document.newDocument(url)));
    }

    public static void testAppendKeyVal2() throws UnsupportedEncodingException, IOException {
        // ... existing code ...
        String url = "https://example.com";
        KeyVal kv = new KeyVal("key1", "value1");
        String expectedOutput = "https://example.com?key1=value1&key2=value2";
        assertEquals(expectedOutput, appendKeyVal(kv, Document.newDocument(url)));
    }
}

class KeyVal {
    private String key;
    private String value;

    public KeyVal(String key, String value) {
        this.key = key;
        this.value = value;
    }

    public String getKey() {
        return key;
    }

    public String getValue() {
        return value;
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;

        KeyVal that = (KeyVal) o;

        if (!key.equals(that.key)) return false;
        return Objects.equals(value, that.value);
    }

