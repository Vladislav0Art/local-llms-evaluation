import java.util.Arrays;

public class Main {
    public static int[] calculateSpans(int index) {
        if (index < 0 || index >= getLength()) {
            return new int[]{1};
        }

        int left = 0;
        while (left < index && left < getLength()) {
            left++;
        }

        int right = getLength() - 1;
        while (right >= 0) {
            right--;
        }

        if (index == getLength()) {
            return new int[]{getLength()};
        } else if (left + 1 == index && left < getLength() - 1) {
            return new int[]{2};
        } else if (right > index) {
            return Arrays.copyOfRange(calculateSpans(index + 1), 0, Math.min(left + 1, right));
        }

        return calculateSpans(left);
    }

    public static void testCalculateSpans() {
        for (int i = 1; i <= getLength(); i++) {
            int[] result = calculateSpans(i);
            if (!result.equals(Arrays.copyOfRange(calculateSpans(0), 0, Math.min(i + 1, getLength())))) {
                System.out.println("Test failed at " + i);
                return;
            }
        }

        System.out.println("All tests passed");
    }

