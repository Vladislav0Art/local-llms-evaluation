            int[] result = calculateSpans(i);
            if (!Arrays.equals(result, Arrays.copyOfRange(calculateSpans(0), 0, Math.min(i + 1, getLength())))) {
                System.out.println("Test failed at " + i);
                return;
            }
        }

        System.out.println("All tests passed");
    }

    public static int[] calculatePrices(int index) {
        if (index < 0 || index >= getLength()) {
            return new int[]{1};
        }

        int left = 0;
        while (left < index && left < getLength()) {
            left++;
        }

        int right = getLength() - 1;
        while (right >= 0) {
            right--;
        }

        if (index == getLength()) {
            return new int[]{getLength()};
        } else if (left + 1 == index && left < getLength() - 1) {
            return new int[]{2};
        } else if (right > index) {
            return Arrays.copyOfRange(calculatePrices(index + 1), 0, Math.min(left + 1, right));
        }

        return calculatePrices(left);
    }

    public static void testCalculatePrices() {
        for (int i = 1; i <= getLength(); i++) {
            int[] result = calculatePrices(i);
            if (!Arrays.equals(result, Arrays.copyOfRange(calculatePrices(0), 0, Math.min(i + 1, getLength())))) {
                System.out.println("Test failed at " + i);
                return;
            }
        }

        System.out.println("All tests passed");
    }

    public static int[] setPrices(int index) {
        if (index < 0 || index >= getLength()) {
            return new int[]{1};
        }

        int left = 0;
        while (left < index && left < getLength()) {
            left++;
        }

        int right = getLength() - 1;
        while (right >= 0) {
            right--;
        }

        if (index == getLength()) {
            return new int[]{getLength()};
        } else if (left + 1 == index && left < getLength() - 1) {
            return new int[]{2};
        } else if (right > index) {
            return Arrays.copyOfRange(setPrices(index + 1), 0, Math.min(left + 1, right));
        }

        return setPrices(left);
    }

    public static void testSetPrices() {
        // Set prices manually
        int[][] manualPrices = {{5}, {4, 3, 2}};
        for (int[] price : manualPrices) {
            int[] result = setPrices(price);
            if (!Arrays.equals(result, getLength()) || !Arrays.equals(result, price)) {
                System.out.println("Test failed manually at index " + Arrays.asList(Arrays.copyOfRange(result, 0, Math.min(price.length + 1)).toCharArray()).join(""));
                return;
            }
        }

        System.out.println("All tests passed");
    }

    public static int[][] setPrices(int n) {
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (Math.random() < 0.5) {
                    return new int[]{j, i};
                }
            }
        }

        throw new RuntimeException("Failed to find valid indices");
    }

    public static int getLength() {
        return Math.max(1, Math.min(Main.this.getClass().getDeclaredFields()[0].getModifiers(), -2));
    }
}
