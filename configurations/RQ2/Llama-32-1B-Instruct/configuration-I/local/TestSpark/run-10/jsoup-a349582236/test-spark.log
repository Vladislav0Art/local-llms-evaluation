public class TagImpl implements Tag {
    private final String name;
    private final boolean isEmpty;

    public TagImpl(String name, boolean isEmpty) {
        this.name = name;
        this.isEmpty = isEmpty;
    }

    @Override
    public String getName() {
        return name;
    }

    @Override
    public int hashCode() {
        return Objects.hash(name);
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;
        TagImpl tag = (TagImpl) o;
        return isEmpty == tag.isEmpty && Objects.equals(name, tag.name);
    }
}

public class TagUtils {
    public static boolean isKnownTag(String tagName) {
        // Implement logic to check if the given tag name is a known HTML tag
    }

    public static Tag valueOf(String tagName, ParseSettings settings) {
        switch (tagName) {
            case "a":
                return new TagImpl("a", false);
            case "abbr":
                return new TagImpl("abbr", true);
            // Add more cases as needed
            default:
                throw new UnsupportedOperationException("Unsupported tag: " + tagName);
        }
    }

    public static Tag valueOf(String tagName) {
        if (IsKnownTagUtil.isKnownTag(tagName)) {
            return valueOf(tagName, null); // Auto-created known tag
        } else {
            return new TagImpl(tagName, false);
        }
    }

    private static class IsKnownTagUtil {
        public static boolean isKnownTag(String tagName) {
            // Implement logic to check if the given tag name is a known HTML tag
        }
    }
}

