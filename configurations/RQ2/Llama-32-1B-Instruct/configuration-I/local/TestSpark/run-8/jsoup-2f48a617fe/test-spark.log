public class CommentTest {
    
    private Comment comment;

    /**
     * Test that comment creation is atomic.
     */
    @Test
    public void testCommentCreationAtomic() {
        String data = "Example text";
        comment = new Comment(data);
    }

    /**
     * Test that comment data can be set atomically.
     */
    @Test
    public void testCommentDataSetAtomic() {
        comment.setData("New data");
        assertEquals("New data", comment.getData());
    }

    /**
     * Test that comment toString is atomic.
     */
    @Test
    public void testCommentToStringAtomic() {
        String data = "Example text";
        comment = new Comment(data);
        String actual = comment.toString();
        assertEquals("<Comment>", actual);
    }

    /**
     * Test that comment clone is atomic.
     */
    @Test
    public void testCommentCloneAtomic() {
        String data = "Example text";
        comment = new Comment(data);
        Comment actual = (Comment) comment.clone();
        assertEquals(data, actual.getData());
    }

    /**
     * Test that comment checkXmlDeclaration can handle non-XML declarations.
     */
    @Test
    public void testCommentCheckXmlDeclaration() {
        String data = "Example text";
        comment = new Comment(data);
        assertTrue(comment.isXmlDeclaration());
    }

    /**
     * Test that comment asXmlDeclaration returns null for non-XML declarations.
     */
    @Test
    public void testCommentAsXmlDeclarationNonXml() {
        String data = "Example text";
        comment = new Comment(data);
        XmlDeclaration xmlDeclaration = (XmlDeclaration) comment.asXmlDeclaration();
        assertEquals(null, xmlDeclaration);
    }

    /**
     * Test that asXmlDeclaration can parse simple XML declarations.
     */
    @Test
    public void testCommentAsXmlDeclarationSimple() {
        String data = "<!ELEMENT example (#PCDATA)>\n<example>Example text</example>";
        comment = new Comment(data);
        XmlDeclaration xmlDeclaration = (XmlDeclaration) comment.asXmlDeclaration();
        assertNotNull(xmlDeclaration);
    }

    /**
     * Test that asXmlDeclaration can parse complex XML declarations.
     */
    @Test
    public void testCommentAsXmlDeclarationComplex() {
        String data = "<!ELEMENT example (#PCDATA)>\n<example>Example text\n  <grandchild>Grandchild</grandchild></example>";
        comment = new Comment(data);
        XmlDeclaration xmlDeclaration = (XmlDeclaration) comment.asXmlDeclaration();
        assertNotNull(xmlDeclaration);
    }
}
