import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;

public class UrlBuilder {

    private String inputUrl;

    public UrlBuilder(String inputUrl) {
        this.inputUrl = inputUrl;
    }

    public static void main(String[] args) {
        TestSpark testSpark = new TestSpark();
        
        String url = "https://example.com";
        testSpark.inputUrl = url;
        System.out.println(testSpark.url());

        testSpark.test1();
        testSpark.test2();
    }

    private void test1() {
        Document document = Jsoup.parse(inputUrl);
        String value = "key=value";
        UrlBuilder urlBuilder = new UrlBuilder(inputUrl);
        URL url = urlBuilder.build();
        assertEquals("https://example.com", url.toString());
        
        StringBuilder sb = new StringBuilder();
        try {
            sb.append(value).append("=");
            url = urlBuilder.appendKeyVal(new org.apache.http.HttpHost("example.com", 443, null)).toString();
            System.out.println(sb.toString());
            assertEquals("https://example.com?key=value", url.toString());
        } catch (UnsupportedEncodingException e) {}
    }

    private void test2() {
        try {
            new UrlBuilder(null).appendKeyVal(new org.apache.http.HttpHost("example.com", 443, null));
            System.out.println("test2 passed");
        } catch (UnsupportedEncodingException e) {}
    }
