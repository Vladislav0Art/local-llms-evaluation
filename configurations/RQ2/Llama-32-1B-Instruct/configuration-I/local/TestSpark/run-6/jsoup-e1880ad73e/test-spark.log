public class Main {
    public static String getPublicUrl(String url) {
        try {
            // Send an HTTP HEAD request to the URL and retrieve the server information.
            URI uri = new URI(url);
            return "http://" + uri.getHost() + "/";

        } catch (Exception e) {
            System.out.println(e.getMessage());
            return null;
        }
    }

    public static void main(String[] args) {
        Map<String, String> urlMap = new HashMap<>();
        urlMap.put("https://www.google.com", "https://www.google.co.uk");
        urlMap.put("http://www.example.com", "http://www.example.co.uk");

        System.out.println(getPublicUrl("https://www.google.com"));  
