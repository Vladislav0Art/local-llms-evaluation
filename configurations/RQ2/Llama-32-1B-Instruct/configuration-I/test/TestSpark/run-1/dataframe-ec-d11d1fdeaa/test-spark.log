```java
import java.util.*;

public class DataFrame {
    private List<String> columns;
    private Map<Integer, DfCell> data;

    public DataFrame() {
        this.columns = new ArrayList<>();
        this.data = new HashMap<>();
    }

    // Public methods
    public void addColumn(String column) {
        this.columns.add(column);
    }

    public void setData(List<Object[]> data) {
        this.data.clear();
        for (Object[] row : data) {
            int index = 0;
            for (String column : row) {
                if (!this.data.containsKey(index)) {
                    this.data.put(index, new DfCell());
                }
                ((DfCell) this.data.get(index)).setValue(column);
                index++;
            }
        }
    }

    public void printColumns() {
        System.out.println("Columns: " + this.columns);
    }

    public void printData() {
        for (Map.Entry<Integer, DfCell> entry : this.data.entrySet()) {
            System.out.print(entry.getKey() + ": ");
            for (Object value : entry.getValue().getValue()) {
                System.out.print(value + ", ");
            }
            System.out.println();
        }
    }

    // Private methods
    private void addData(Object[] row) {
        int index = 0;
        for (String column : this.columns) {
            if (!row[index].equals(column)) {
                throw new RuntimeException("Column mismatch: " + row[index] + ", " + column);
            }
            ((DfCell) row[index]).setValue(row[index]);
            index++;
        }
    }

    private void printDataBeforeIndex(int index) {
        for (int i = 0; i < index; i++) {
            System.out.print(this.columns.get(i) + ": ");
            for (Object value : this.data.get(i).getValue()) {
                System.out.print(value + ", ");
            }
            System.out.println();
        }
    }

    private void printDataAfterIndex(int index) {
        for (int i = index; i < data.size(); i++) {
            System.out.print(this.columns.get(i) + ": ");
            for (Object value : this.data.get(i).getValue()) {
                System.out.print(value + ", ");
            }
            System.out.println();
        }
    }

    private void checkIndex(int index) {
        if (!this.data.containsKey(index)) {
            throw new RuntimeException("Index out of bounds: " + index);
        }
    }

    // Other methods
    public DfCell get(int row, int column) {
        return this.data.get(row).getValue(column);
    }

    public void set(int row, int column, Object value) {
        ((DfCell) this.data.get(row)).setValue(value);
    }

    public String toString() {
        StringBuilder sb = new StringBuilder();
        for (String column : columns) {
            sb.append(column).append(": ");
        }
        for (Map.Entry<Integer, DfCell> entry : data.entrySet()) {
            sb.append(entry.getKey()).append(": ").append(this.get(entry.getKey(), entry.getValue().getValue()[0])).append(", ");
        }
        return sb.toString();
    }

    public void forEach(Procedure<DfCursor> action) {
        this.data.forEach((index, value) -> action.execute(index, value));
    }

    // Test classes
    public static class DfCell {
        private String value;

        public DfCell() {}

        public void setValue(String value) {
            this.value = value;
        }

        @Override
        public String toString() {
            return value;
        }
    }

    public static class DfCursor implements Procedure<DfCursor> {
        private int index;

        public DfCursor(int index) {
            this.index = index;
        }

        @Override
        public void execute(int row, Object[] data) {
            System.out.println("Row: " + row);
            for (Object value : data) {
                if (!row.contains(value)) {
                    throw new RuntimeException("Value not found: " + value);
                }
            }
        }
    }

    public static class ExampleClass implements Procedure<String[]> {
        @Override
        public void execute(String[] array) {
            System.out.println("Array: " + array[0] + ", " + array[1]);
        }
    }

    public static void main(String[] args) {
        DataFrame df = new DataFrame();
        df.addColumn("A");
        df.addColumn("B");

        df.setData(new Object[][]{
                {"1", "A"},
                {"2", "A"},
                {"3", "B"}
        });

        System.out.println(df.toString());
        df.forEach(this::printData);

        df.set(0, 0, "X");
        System.out.println(df.toString());
        df.forEach(this::printData);
    }
}
