package org.jsoup.nodes;

import org.junit.jupiter.api.Test;

import static org.mockito.Mockito.*;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;

public class GeneratedTest {

    @Test
    public void testnodeName() {
        String text = "Hello World";
        when(getNodeName(any())).thenReturn("TextNode");
        assertEquals("TextNode", getNodeName(text));
    }

    @Test
    public void testText() {
        String text = "Hello World";
        TextNode node = new TextNode(text);
        assertEquals(text, getNodeText(node));
        assertEquals("", getNodeWholeText(node));
        assertEquals(10, getNodeIsBlank(node).length());
        assertNotNull(getSplitText(0, node));
    }

    @Test
    public void testGetWholeText() {
        String text = "Hello World";
        TextNode node = new TextNode(text);
        assertEquals("Hello World", getNodeWholeText(node));
    }

    @Test
    public void testIsBlank() {
        String text = "Hello World";
        when(getIsBlank(any())).thenReturn(true);
        assertTrue(getIsBlank(text));
        assertFalse(getIsBlank(text));
    }

    @Test
    public void testSplitText() {
        String text = "Hello World";
        TextNode node = new TextNode(text);
        when(getSplitText(0, any())).thenReturn(new StringBuffer());
        assertEquals("HelloWorld", getSplitText(0, node).toString());
    }

    @Test
    public void testOuterHtmlHead() {
