public abstract class Editor {

    private String name;
    private String uri;
    private String projectFolderUri;
    private String path;

    public Editor(String name, String uri) {
        this.name = name;
        this.uri = uri;
    }

    public String getName() {
        return name;
    }

    public void setName(String name) {
        this.name = name;
    }

    public String getURI() {
        return uri;
    }

    public void setURI(String uri) {
        this.uri = uri;
    }

    public String.getProjectFolderUri() {
        return projectFolderUri;
    }

    public void setProjectFolderUri(String projectFolderUri) {
        this.projectFolderUri = projectFolderUri;
    }

    public String getPath() {
        return path;
    }

    public void setPath(String path) {
        this.path = path;
    }
}
