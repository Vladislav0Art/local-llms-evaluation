        ZonedDateTime date = mock(ZonedDateTime.class);
        double latitude = 0;
        double longitude = 0;
        when(date.toEpochSecond()).thenReturn(1643723400000L);

        AzimuthZenithAngle result = Grena3.calculateSolarPosition(date, latitude, longitude);
        assertEquals(0, result.getAzimuthZenithAngle());
    }

    @Test
    public void testCalculateSolarPositionWithDeltaT() {
        ZonedDateTime date = mock(ZonedDateTime.class);
        double latitude = 10;
        double longitude = 20;

        AzimuthZenithAngle result = Grena3.calculateSolarPosition(date, latitude, longitude);
        assertEquals(30.0, result.getAzimuthZenithAngle(), 1);

        when(date.toEpochSecond()).thenReturn(1643723400000L);
    }

