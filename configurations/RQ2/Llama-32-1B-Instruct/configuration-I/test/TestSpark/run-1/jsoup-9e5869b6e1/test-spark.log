        // Test the insert method
        Element element = new Element("<p>Hello World!</p>");
        underTest.insert(element);
        assertEquals(1, underTest - State.getStack().size());
        assertEquals("Hello World!", underTest - State.getStack().get(0).getValue());
    }

    @Test
