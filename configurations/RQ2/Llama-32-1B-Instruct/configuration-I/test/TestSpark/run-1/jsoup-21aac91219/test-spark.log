import org.junit.Test;
import org.jsoup.parser.HtmlTreeBuilder;
import org.mockito.Mockito;

public class HtmlTreeBuilderTest {

    private HtmlTreeBuilder builder = new HtmlTreeBuilder();

    @Test
    public void testDefaultSettings() {
        Parser parser = Mockito.mock(Parser.class);
        ParseSettings defaultSettings = Mockito.mock(ParseSettings.class);

        assertEquals(defaultSettings, builder.defaultSettings());

        builder.parse(input = "", baseUri = "https://example.com", parser = parser).assertNotNull(parser);
    }

    @Test
    public void testInitialiseParse() {
        String input = "<html><body>Hello World!</body></html>";
        String baseUri = "https://example.com";
        Parser parser = Mockito.mock(Parser.class);

        builder.initialiseParse(input, baseUri, parser).assertNotNull(parser);
    }

    @Test
    public void test-parseFragment() {
        String inputFragment = "<p>This is a paragraph.</p>";
        Element context = null;
        String baseUri = "https://example.com";
        Parser parser = Mockito.mock(Parser.class);

        builder.parseFragment(inputFragment, context, baseUri, parser).assertNotNull(context);
    }

    @Test
    public void test-process() {
        Element token = Mockito.mock(Element.class);
        boolean result = builder.process(token);
        assertEquals(true, result);
    }

    @Test
    public void test_process_with_token() {
        element = Mockito.mock(Element.class);
        String state = Mockito.mock(HtmlTreeBuilderState.class);

        builder.process(element, state).assertNotNull(state);
    }

    @Test
    public void test_transition() {
        Element token = Mockito.mock(Element.class);
        builder.transition(element = Mockito.mock(HtmlTreeBuilderState.class));

        Mockito.verify(builder).transition(token);
    }

    @Test
    public void test_state() {
        HtmlTreeBuilderState state = Mockito.mock(HtmlTreeBuilderState.class);

        builder.state(state);

        Mockito.verify(builder).state();
    }

    @Test
    public void test_markInsertionMode() {
        Element element = Mockito.mock(Element.class);
        builder.markInsertionMode();

        Mockito.verify(builder).markInsertionMode(element);
    }

    @Test
    public void test_originalState() {
        HtmlTreeBuilderState state = Mockito.mock(HtmlTreeBuilderState.class);

        builder.originalState(state);

        Mockito.verify(builder).originalState();
    }

    @Test
    public void test_framesetOk() {
        boolean framesetOk = true;
        Element element = Mockito.mock(Element.class);
        builder.framesetOk(framesetOk);

        Mockito.verify(builder).framesetOk(element);
    }
}
