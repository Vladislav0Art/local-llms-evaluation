    public void pushWithBookmark() {
        Node node = new TaggedNode("<p>This is a paragraph</p>");
        String baseUri = "https://example.com/baseuri";
        HtmlTreeBuilderState state = builder.newInstance().process(node, null, baseUri, new Parser()).pushWithBookmark();
        assertEquals("HTML", state.tagName());
    }

    @Test
    public void pushActiveFormattingElements() {
        Node node = new TaggedNode("<p>This is a paragraph</p>");
        String baseUri = "https://example.com/baseuri";
        HtmlTreeBuilderState state = builder.newInstance().process(node, null, baseUri, new Parser()).pushActiveFormattingElements();
        assertEquals("HTML", state.tagName());
    }

    @Test
    public void pushTemplateModeNotPossible() {
        Node node = new TaggedNode("<p>This is a paragraph</p>");
        String baseUri = "https://example.com/baseuri";
        HtmlTreeBuilderState state = builder.newInstance().process(node, null, baseUri, new Parser()).pushTemplateMode();
        assertThrows(AssertionError.class);
    }

    @Test
    public void popTemplateMode() {
        Node node = new TaggedNode("<p>This is a paragraph</p>");
        String baseUri = "https://example.com/baseuri";
        HtmlTreeBuilderState state = builder.newInstance().process(node, null, baseUri, new Parser()).popTemplateMode();
        assertEquals("HTML", state.tagName());
    }

    @Test
    public void templateModeSize() {
        Node node = new TaggedNode("<p>This is a paragraph</p>");
        String baseUri = "https://example.com/baseuri";
        HtmlTreeBuilderState state = builder.newInstance().process(node, null, baseUri, new Parser()).templateModeSize();
        assertEquals(1, state.templateModeSize());
    }

    @Test
    public void currentTemplateMode() {
        Node node = new TaggedNode("<p>This is a paragraph</p>");
        String baseUri = "https://example.com/baseuri";
        HtmlTreeBuilderState state = builder.newInstance().process(node, null, baseUri, new Parser()).currentTemplateMode();
        assertNotNull(state.currentTemplateMode());
    }

    @Test
    public void templateModeSizeNotPossible() {
        throw new AssertionError();
    }

