    public void sound() {
        System.out.println("The animal makes a sound");
    }

    public static void main(String[] args) {
        Dog dog = new Dog();
        dog.sound(); // Call the method on the instance

        Cat cat = new Cat();
        cat.sound(); // Call the method on the instance
    }
}

class Dog extends Animal {
    @Override
    public void sound() {
        System.out.println("The dog barks");
    }

    public static void main(String[] args) {
        Dog dog = new Dog();
        dog.sound(); // Call the method on the instance

        Cat cat = new Cat();
        cat.sound(); // Call the method on the instance
    }
}

class Cat extends Animal {
    @Override
    public void sound() {
        System.out.println("The cat meows");
    }
}
