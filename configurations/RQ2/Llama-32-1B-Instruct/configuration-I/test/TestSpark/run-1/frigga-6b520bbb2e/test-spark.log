        String color = null;
        if (color instanceof String) {
            System.out.println("The color is " + ((String) color).toLowerCase());
        }
    }
}

class Dog extends Animal {
    @Override
    public void sound() {
        System.out.println("The dog barks");
    }

    public static void main(String[] args) {
        Animal[] animals = {new Dog(), new Cat()};
    }
}

class Cat extends Animal {
    @Override
    public void sound() {
        System.out.println("The cat meows");
    }
}
```

**Inheritance**

```java
public class Parent {
    public void method1() {
        System.out.println("Parent's method 1");
    }

    public static void main(String[] args) {
        Child child = new Child();
        child.method1(); // Call the method on the instance

        Parent parent = new Parent();
        parent.method2(); // Call the method on the parent
    }
}

class Child extends Parent {
    @Override
    public void method2() {
        System.out.println("Child's method 2");
    }

    public static void main(String[] args) {
        Child child = new Child();
        child.method2(); // Call the method on the instance

        Parent parent = new Parent();
        parent.method1(); // Call the method on the parent
    }
}
```

**Encapsulation**

```java
public class BankAccount {
    private double balance;

    public void deposit(double amount) {
        this.balance += amount;
    }

    public void withdraw(double amount) {
        if (this.balance >= amount) {
            this.balance -= amount;
        } else {
            System.out.println("Insufficient funds");
        }
    }

    public static void main(String[] args) {
        BankAccount account = new BankAccount();
        account.deposit(100);
        System.out.println(account.balance); // Print the balance

        account.withdraw(50);
        System.out.println(account.balance); // Print the updated balance
    }
}
```

**Abstraction**

```java
public class CoffeeShop {
    private String name;

    public void setName(String name) {
        this.name = name;
    }

    public String getName() {
        return name;
    }

    public abstract void serve();

    public static void main(String[] args) {
        CoffeeShop shop = new CoffeeShop();
        shop.setName("Java Coffee Shop");
        shop.serve(); // Call the method to serve coffee
    }
}
```

**Composition**

```java
public class Car {
    private String brand;
    private int year;

    public Car(String brand, int year) {
        this.brand = brand;
        this.year = year;
    }

    public void displayInfo() {
        System.out.println("Brand: " + brand + ", Year: " + year);
    }
}

public class Motorcycle extends Car {
    public Motorcycle(String brand, int year, String color) {
        super(brand, year);
        this.color = color;
    }

    @Override
    public void displayInfo() {
        System.out.println("Brand: " + brand + ", Year: " + year + ", Color: " + color);
    }
}

public class Main {
    public static void main(String[] args) {
        Car car = new Car("Toyota", 2015);
        Motorcycle motorcycle = new Motorcycle("Honda", 2020, "Red");
        car.displayInfo();
        motorcycle.displayInfo(); // Call the method to display information on the motorcycle
    }
}
```
