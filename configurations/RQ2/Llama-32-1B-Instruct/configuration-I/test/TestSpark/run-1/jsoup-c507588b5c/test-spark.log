public class TextNodeTest {

    private TextNode node;

    @Before
    public void setup() {
        node = new TextNode("Hello World");
    }

    @Test
    public void testnodeName() {
        assertEquals("text", node.getNodeName());
    }

    @Test
    public void testText() {
        assertEquals("Hello World", node.getText());
    }

    @Test
    public void testTextNewlines() {
        String text = "This is a test\nwith multiple lines.";
        assertEquals("This is a test with multiple lines.", node.getText(text));
    }

    @Test
    public void testGetWholeText() {
        assertEquals("Hello World", node.getWholeText());
    }

    @Test
    public void testIsBlank() {
        assertTrue(node.isBlank());
    }

    @Test
    public void testSplitTextOffSet1() {
        String result = node.splitText(0);
        assertEquals("", result);
    }

    @Test
    public void testSplitTextOffset2() {
        String result = node.splitText(-3);
        assertEquals("Hello World", result);
    }

    @Test
    public void testOuterHtmlHead() throws IOException {
        String html = "<html><body>Hello World</body></html>";
        Appendable accum = new StringBuilder();
        Document.OutputSettings out = new Document.OutputSettings(HTML.UTF_8);
        node.outerHtmlHead(accum, 1, out);
        assertEquals(html, accum.toString());
    }

    @Test
    public void testOuterHtmlTail() throws IOException {
        String html = "<html><body>Hello World</body></html>";
        Appendable accum = new StringBuilder();
        Document.OutputSettings out = new Document.OutputSettings(HTML.UTF_8);
        node.outerHtmlTail(accum, 1, out);
        assertEquals(html, accum.toString());
    }

    @Test
    public void testToString() {
        assertEquals("text", node.toString());
    }

    @Test
    public void testClone() {
        TextNode clone = (TextNode) node.clone();
        assertNotNull(clone);
        assertEquals(node.getText(), clone.getText());
    }
}
