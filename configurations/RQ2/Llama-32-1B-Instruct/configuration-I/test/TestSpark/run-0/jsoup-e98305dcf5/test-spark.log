import org.jsoup.nodes.*;
import org.junit.jupiter.api.Test;

public class Element {

    @Test
    public void testTagHasChildren() {
        Node node = new Tag("div", null, null);
        assertElementHasChildNodes(node).size() == 1;
    }

    @Test
    public void testTagHasAttributes() {
        Node node = new Tag("span", null, null);
        assertElementHasAttributes(node).containsKey("id");
    }

    @Test
    public void testTagHasBaseUri() {
        Node node = new Tag("div", null, null);
        assertNodeHasAttribute(node, "baseuri", "https://example.com/");

        node = new Tag("div", null, null);
        assertElementHasAttributes(node).containsKey("baseuri");
    }

    @Test
    public void testTagHasData() {
        Node node = new Tag("span", null, null);
        assertEquals("", node.getData());

        node = new Tag("span", "Hello World", null);
        assertEquals("Hello World", node.getData());
    }
}
