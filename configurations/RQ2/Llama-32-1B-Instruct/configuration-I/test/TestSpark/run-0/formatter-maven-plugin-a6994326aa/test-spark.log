public class LineEnding {
    private boolean EMBEDDED;

    public LineEnding() {}

    public LineEnding(boolean e) {
        EMBEDDED = e;
    }

    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;
        LineEnding that = (LineEnding) o;
        return EMBEDDED == that.EMBEDDED && Math.abs(getLength() - that.getLength()) < 1e-9;
    }

    public int hashCode() {
        return Integer.valueOf(EMBEDDED).hashCode();
    }

    public static boolean isEmbedded(LineEnding e) {
        return e != null ? e.EMBEDDED : false;
    }

    public String toString() {
        if (EMBEDDED) {
            return "Embedding";
        } else {
            return "";
        }
    }

    private int Length() {
        if (!isEmbedded()) return 0;
        return EMBEDDED.length();
    }
}

