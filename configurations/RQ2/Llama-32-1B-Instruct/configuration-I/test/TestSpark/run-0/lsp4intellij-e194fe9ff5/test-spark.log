public class EditorToLSPIdentifierTest {

    @Test
    public void testEditorToLSPIdentifier() {
        Editor editor = FileUtilsImpl.editorFromPsiFile(new PsiFile());
        FileType fileType = FileUtilsImpl.fileTypeFromEditor(editor);
        TextDocumentIdentifier identifier = FileUtilsImpl.editorToLSPIdentifier(editor);
        assertEquals(fileType, identifier);
    }

    @Test
    public void testEditorToURIString() {
        Editor editor = FileUtilsImpl.editorFromUri("https://example.com/file", new Project());
        String identifier = FileUtilsImpl.editorToURIString(editor);
        assertEquals("https://example.com/file", identifier);
    }
}

@Test
public void testVirtualFileToLSPIdentifier() {
    Editor editor = FileUtilsImpl.editorFromPsiFile(new PsiFile());
    String identifier = FileUtilsImpl.vfstoURI(editor);
    assertEquals("https://example.com/file", identifier);
}
	}

@Test
public void testEditorToProjectFolderUri() {
    Editor editor = FileUtilsImpl.editorFromPsiFile(new PsiFile());
    String folderUri = FileUtilsImpl.editorToProjectFolderUri(editor);
    assertEquals("/path/to/project/folder", folderUri);
}

@Test
public void testEditorToProjectFolderPath() {
    Editor editor = FileUtilsImpl.editorFromPsiFile(new PsiFile());
    String folderUri = FileUtilsImpl.editorToProjectFolderPath(editor);
    assertEquals("/path/to/project/folder", folderUri);
}
	}

@Test
public void testPathToURI() {
    Editor editor = FileUtilsImpl.editorFromPsiFile(new PsiFile());
    String uri = FileUtilsImpl.pathToURI(null);
    assertEquals("https://example.com/file/path/to/project/folder", uri);
}
