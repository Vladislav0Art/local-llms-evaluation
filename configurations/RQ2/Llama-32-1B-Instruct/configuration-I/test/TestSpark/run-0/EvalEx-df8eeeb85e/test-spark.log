import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;

public class TokenizerTest {

    private Tokenizer tokenizer;
    private ExpressionConfiguration configuration;
    private String expressionString;
    private List<Token> expectedTokens;

    @BeforeEach
    public void setup() {
        expressionString = "1 + 2";
        configuration = new ExpressionConfiguration();
        tokenizer = new Tokenizer(expressionString, configuration);
        expectedTokens = tokenizeExpression("1", "(", ") + ", 2, ", ");
    }

    @Test
    public void testParseLiteral() throws ParseException {
        List<Token> tokens = tokenizer.parse().stream()
                .collect(Collectors.toList());
        assertEquals(expectedTokens, tokens);
    }

    @Test
    public void testTokenizeStringLiteral() throws ParseException {
        List<Token> tokens = tokenizer.parseStringLiteral();
        assertEquals(expectedTokens, tokens);
    }
}
