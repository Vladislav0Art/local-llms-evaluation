import org.jsoup.nodes.Comment;
import org.junit.jupiter.api.Test;
import static org.mockito.Mockito.mock;

public class CommentTest {

    @Test
    public void nodeNameShouldReturnCommentNode() {
        String data = "This is a comment.";
        Comment comment = new Comment(data);
        assertEquals(Comment.class, comment.nodeName().getClass());
    }

    @Test
    public void getDataShouldReturnCommentData() {
        String data = "This is a comment.";
        Comment comment = new Comment(data);
        assertEquals(data, comment.getData());
    }

    @Test
    public void setDataShouldSetCommentData() {
        String data = "This is a comment.";
        Comment comment = new Comment(data);
        comment.setData(data);
        assertEquals(data, comment.getData());
    }

    @Test
    public void outerHtmlHeadShouldAddCommentNodeToDocument() throws IOException {
        String html = "<html><body>This is a comment.</body></html>";
        Document document = mock(Document.class);
        Appendable accum = mock(Appendable.class);
        int depth = 0;
        Document.OutputSettings out = new Document.OutputSettings();

        Comment comment = new Comment("This is another comment.");
        comment.outerHtmlHead(accum, depth, out);

        verify(accum).append("<!--\n".concat(comment.nodeName().toString()).concat("\n-->"));
    }

    @Test
    public void outerHtmlTailShouldAddCommentNodeToDocument() throws IOException {
        String html = "<html><body>This is a comment.</body></html>";
        Document document = mock(Document.class);
        Appendable accum = mock(Appendable.class);
        int depth = 0;
        Document.OutputSettings out = new Document.OutputSettings();

        Comment comment = new Comment("This is another comment.");
        comment.outerHtmlTail(accum, depth, out);

        verify(accum).append("<!--\n".concat(comment.nodeName().toString()).concat("\n-->"));
    }

    @Test
    public void toStringShouldReturnCommentString() {
        String data = "This is a comment.";
        Comment comment = new Comment(data);
        assertEquals("This is a comment.", comment.toString());
    }

    @Test
    public void cloneShouldReturnCloneOfCommentNode() {
        String data = "This is a comment.";
        Comment comment = new Comment(data);

        // Mocking for simplicity, in real-world scenarios you would use Mockito to verify methods called on the mock object
        Object originalComment = comment.clone();
        assertEquals(Comment.class, clone(comment).nodeName().getClass());
    }

    @Test
    public void isXmlDeclarationShouldReturnFalse() {
        Comment comment = new Comment("This is a non-XML declaration.");
        assertFalse(comment.isXmlDeclaration());
    }

    @Test
    public void asXmlDeclarationShouldReturnNull() {
        // Mocking for simplicity, in real-world scenarios you would use Mockito to verify methods called on the mock object
        Object originalComment = null;
        Comment comment = new Comment(originalComment);
        assertEquals(null, comment.asXmlDeclaration());
    }
}
