        Document document = new Document();
        Appendable accum = (Appendable) document.getOutputSettings().append();

        comment.outerHtmlTail(accum, 1, document);
        Element node = (Element) ((Document) document).body().childAt(0);

        assert node instanceof Comment;
    }

    @Test
    public void toStringShouldReturnCommentString() {
        assertEquals("This is a comment.", comment.toString());
    }

    @Test
    public void cloneShouldReturnCloneOfCommentNode() {
        Object original = comment.clone();
        Element clone = (Element) ((Document) ((Document) document).body()).childAt(0);

        assert clone instanceof Comment;
    }

