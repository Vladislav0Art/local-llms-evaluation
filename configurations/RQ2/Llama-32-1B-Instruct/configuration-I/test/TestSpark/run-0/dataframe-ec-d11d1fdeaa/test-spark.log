import org.apache.spark.sql.Dataset;
import org.apache.spark.sql.Row;

public class Main {
    public static void main(String[] args) {
        Dataset<Row> df = DataFrameBuilder.createDataFrame()
                .withSchema("id", "name")
                .withColumn("age", Integer.parseInt("age"))
                .fromRow(0, 1)
                .fromRow(1, 2)
                .join(
                        joinWithComplements(
                                new DataFrameBuilder(),
                                List.of("age"),
                                List.of("name"))
                )
                .show();

        df = df.withColumn("age", ageExpression());
        df = join(df, "id", "age");
        df.show();
    }

    public static Dataset<Row> selectBy(String filterExpressionString) {
        return selectWithComplements(
                new DataFrameBuilder(),
                List.of(filterExpressionString)
        );
    }

    private static Dataset<Row> selectWithComplements(DataFrame df, String filterExpressionString) {
        Dataset<Row> result = df.filter(new Expression(filterExpressionString));
        return result;
    }

    public static Dataset<Row> join(DataFrame left, DataFrame right, String thisJoinColumnName, String otherJoinColumnName) {
        return joinWithComplements(
                new DataFrameBuilder(),
                List.of(thisJoinColumnName),
                List.of(otherJoinColumnName)
        );
    }

    private static Dataset<Row> joinWithComplements(DataFrame df, List<String> thisJoinColumnNames, List<String> otherJoinColumnNames) {
        Dataset<Row> result = df.join(df.select(*thisJoinColumnNames), null, 'inner', '*');
        for (Pair<String, String> pair : Pair.of(thisJoinColumnName, otherJoinColumnName)) {
            if (!result.columns().contains(pair.getValue())) {
                result = joinWithComplements(
                        new DataFrameBuilder(),
                        List.of(pair.getValue()),
                        List.of(pair.getValue())
                );
                result = result.join(df.select(*thisJoinColumnNames), null, 'inner', '*');
            }
        }
        return result;
    }

