public class TestReader {

    private static final String TEST1 = "Hello, World!";
    private static final String TEST2 = " Foo";

    public static boolean rangeEquals(int left, int right) {
        return left <= right && right <= test1.length();
    }

    public static boolean rangeContains(char[] chars, char c) {
        for (char ch : chars) {
            if (ch == c) {
                return true;
            }
        }
        return false;
    }

    public static int lengthOfTest1() {
        return TEST1.length();
    }

    public static int lengthOfTest2() {
        return TEST2.length();
    }

    public static boolean containsCharInTest1(char[] chars, char c) {
        for (char ch : chars) {
            if (ch == c) {
                return true;
            }
        }
        return false;
    }

    public static void main(String[] args) {
        System.out.println(rangeEquals(5, 10)); // Should print: True
        System.out.println(rangeContains(TEST1.toCharArray(), 'o')); // Should print: False

        int testLen = lengthOfTest2();
        System.out.println("Length of TEST2: " + testLen); // Should print: Length of TEST2: 5
        System.out.println(containsCharInTest1(TEST1.toCharArray(), 'a')); // Should print: True
    }
}
