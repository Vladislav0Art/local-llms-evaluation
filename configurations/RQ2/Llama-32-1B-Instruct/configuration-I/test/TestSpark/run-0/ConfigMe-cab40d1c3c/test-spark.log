        Map<String, Object> expected = new HashMap<>();
        expected.put("key", "value");
        when(this.propertyListBuilder.getRootEntries()).thenReturn(expected);
        assertEquals(expected, getRootEntries());
        verify(mockRootEntries).get("key");
    }

}
