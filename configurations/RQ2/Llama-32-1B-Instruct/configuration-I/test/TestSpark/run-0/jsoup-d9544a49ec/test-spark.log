import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.select.Elements;

public class ElementTest {

    public static void main(String[] args) {
        // Create a document
        Document doc = Jsoup.connect("http://example.com").get();

        // Test tag names
        System.out.println("\nTest tag names:");
        printTagNames(doc);

        // Test tag classes
        System.out.println("\nTest tag classes:");
        printTagClasses(doc);

        // Test attribute setting
        Element elem = new Element("div");
        elem.attributes().put("class", "test-class");

        // Add styles to the element
        addStyle(elem, "color", "red");
        addStyle(elem, "background-color", "#f2f2f2");

        System.out.println("\nTest setting class and style attributes:");
        printElement(elem);

        // Test event handling
        elem.addEventListener("click", e -> {
            System.out.println("\nTest click event listener:");
            System.out.println(e);
        });
    }

    private static void printTagNames(Document doc) {
        Elements tags = doc.getAllElements();
        for (Element tag : tags) {
            if (tag.tagName() != null && !tag.tagName().isEmpty()) {
                System.out.println(tag.tagName());
            }
        }
    }

    private static void printTagClasses(Document doc) {
        Elements tags = doc.getAllElements();
        for (Element tag : tags) {
            if (tag.tagName() != null && !tag.tagName().isEmpty()) {
                String className = tag.attributes().get("class");
                System.out.println(tag.tagName() + ": " + className);
            }
        }
    }

    private static void printElement(Element elem) {
        System.out.println(elem.toString());
    }

    private static void addStyle(Element element, String name, String value) {
        element.attr(name, value);
    }

    private static void addEventListener(Element element, String event, ActionListener listener) {
        element.addEventListener(event, listener);
    }
}

interface ActionListener {
    public void actionPerformed(ActionEvent e);
}
