**Problem Statement:**

Create a class hierarchy to represent database tables, columns, and rows. A table can be of type `Table`, column can be of type `Column`, and row can be of type `Row`. The classes should inherit from `Table` while the columns and rows should extend it.

**Python Code:**
```python
from typing import List

class Table:
    def __init__(self, table_name: str):
        self.table_name = table_name

    def equals(self, other: 'Table') -> bool:
        return self.table_name == other.table_name

    def hashCode(self) -> int:
        return hash(self.table_name)


class Column:
    def __init__(self, column_name: str, table: Table):
        self.column_name = column_name
        self.table = table


class Row:
    def __init__(self, row_id: int, data: dict):
        self.row_id = row_id
        self.data = data

    def equals(self, other: 'Row') -> bool:
        return self.row_id == other.row_id and self.data == other.data

    def hashCode(self) -> int:
        return hash((self.row_id, frozenset(self.data.items())))


class TableSet:
    def __init__(self, tables: List['Table']):
        self.tables = tables

    def size(self) -> int:
        return len(self.tables)

    def contains(self, obj: 'object') -> bool:
        for table in self.tables:
            if table.equals(obj):
                return True
        return False

    def get(self, obj: 'object') -> 'Table':
        for table in self.tables:
            if table.equals(obj):
                return table
        return None


class ColumnSet:
    def __init__(self, columns: List[Column]):
        self.columns = columns

    def size(self) -> int:
        return len(self.columns)

    def contains(self, obj: 'object') -> bool:
        for column in self.columns:
            if column.equals(obj):
                return True
        return False

    def get(self, obj: 'object') -> Column:
        for column in self.columns:
            if column.equals(obj):
                return column
        return None


class RowSet:
    def __init__(self, rows: List[Row]):
        self.rows = rows

    def size(self) -> int:
        return len(self.rows)

    def contains(self, obj: 'object') -> bool:
        for row in self.rows:
            if row.equals(obj):
                return True
        return False

    def get(self, obj: 'object') -> Row:
        for row in self.rows:
            if row.equals(obj):
                return row
        return None


# Example Usage:
if __name__ == "__main__":
    # Create tables
    table1 = Table("table1")
    table2 = Table("table2")

    # Create columns
    col1 = Column("column1", table1)
    col2 = Column("column2", table2)

    # Create rows
    row1 = Row(1, {"key": 1, "value": 1})
    row2 = Row(2, {"key": 2, "value": 2})

    # Create column set
    col_set = ColumnSet([col1, col2])

    # Create table set
    table_set = TableSet([table1, table2])

    # Create row set
    row_set = RowSet([row1, row2])
```

