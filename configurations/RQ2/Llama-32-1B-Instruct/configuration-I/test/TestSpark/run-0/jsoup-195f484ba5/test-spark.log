**Problem Statement:**

Create a class hierarchy to represent tags, attributes, and classes. A tag can be of type `Tag`, attribute can be of type `AttributeTag`, or class can be of type `ClassTag`. The classes should inherit from `Tag` while the attributes and tags should extend it.

**Python Code:**
```python
from typing import List

class Tag:
    def __init__(self, tag_name: str):
        self.tag_name = tag_name

    def equals(self, other: 'Tag') -> bool:
        return self.tag_name == other.tag_name

    def hashCode(self) -> int:
        return hash(self.tag_name)


class AttributeTag(Tag):
    def __init__(self, tag: Tag, key: str):
        super().__init__(tag.tag_name)
        self.key = key


class ClassTag(Tag):
    def __init__(self, tag: Tag, class_name: str):
        super().__init__(tag.tag_name)
        self.class_name = class_name


class TagSet:
    def __init__(self, tags: List['Tag']):
        self.tags = tags

    def size(self) -> int:
        return len(self.tags)

    def contains(self, obj: 'object') -> bool:
        for tag in self.tags:
            if tag.equals(obj):
                return True
        return False

    def get(self, obj: 'object') -> 'Tag':
        for tag in self.tags:
            if tag.equals(obj):
                return tag
        return None


class AttrSet:
    def __init__(self, attributes: List[AttributeTag]):
        self.attributes = attributes

    def size(self) -> int:
        return len(self.attributes)

    def contains(self, obj: 'object') -> bool:
        for attribute in self.attributes:
            if attribute.equals(obj):
                return True
        return False

    def get(self, obj: 'object') -> AttributeTag:
        for attribute in self.attributes:
            if attribute.equals(obj):
                return attribute
        return None


class TagArray:
    def __init__(self, tags: List['Tag']):
        self.tags = tags

    def size(self) -> int:
        return len(self.tags)

    def contains(self, obj: 'object') -> bool:
        for tag in self.tags:
            if tag.equals(obj):
                return True
        return False

    def get(self, obj: 'object') -> Tag:
        for tag in self.tags:
            if tag.equals(obj):
                return tag
        return None


# Example Usage:
if __name__ == "__main__":
    # Create tags
    tag1 = Tag("tag1")
    tag2 = AttributeTag(tag1, "key")
    tag3 = ClassTag(tag1, "className")

    # Create attribute set
    attr_set = AttrSet([tag2])

    # Create class array
    clazz_array = TagArray([tag3])

    # Set attributes of class array to tag2
    clazz_array.putAll(attr_set)
```

