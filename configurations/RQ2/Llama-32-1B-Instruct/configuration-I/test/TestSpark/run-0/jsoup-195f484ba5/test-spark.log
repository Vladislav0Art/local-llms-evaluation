public class Tag {
    private String tag;
    private String name;
    private String id;

    public Tag(String tag, String name) {
        this.tag = tag;
        this.name = name;
        this.id = "";
    }

    public Tag(String tag, String id) {
        this.tag = tag;
        this.id = id;
    }

    public void setName(String name) {
        this.name = name;
    }

    public void setId(String id) {
        this.id = id;
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;

        Tag tag = (Tag) o;

        if (!id.equals(tag.id)) return false;

        if (!name.equals(tag.name)) return false;

        return true;
    }

    @Override
    public int hashCode() {
        int result = id.hashCode();
        result = 31 * result + name.hashCode();
        return result;
    }
}

public class ClassTag extends Tag {
    private String className;

    public ClassTag(String tag, String className) {
        super(tag, className);
    }

    public void setClassName(String className) {
        this.className = className;
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;

        ClassTag classTag = (ClassTag) o;

        if (!id.equals(classTag.id)) return false;
        if (!name.equals(classTag.name))
            return false;

        return className != null ? className.equals(classTag.className)
                : true;
    }

    @Override
    public int hashCode() {
        int result = id.hashCode();
        result = 31 * result + name.hashCode();
        result = 31 * result + (className == null ? 0 : className.hashCode());
        return result;
    }
}

public class AttributeTag extends Tag {
    private String key;

    public AttributeTag(String tag, String key) {
        super(tag, "");
        this.key = key;
    }

    public void setKey(String key) {
        this.key = key;
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;

        AttributeTag attributeTag = (AttributeTag) o;

        if (!id.equals(attributeTag.id))
            return false;

        if (!name.equals(attributeTag.name))
            return false;
        if (!key.equals(attributeTag.key))
            return false;

        return true;
    }

    @Override
    public int hashCode() {
        int result = id.hashCode();
        result = 31 * result + name.hashCode();
        result = 31 * result + (key == null ? 0 : key.hashCode());
        return result;
    }
}

public class TagSet extends Set<Tag> {

    private Tag[] tags;

    public TagSet(Tag... tags) {
        this.tags = new Tag[tags.length];
        System.arraycopy(tags, 0, this.tags, 0, tags.length);
    }

    @Override
    public int size() {
        return this.tags.length;
    }

    @Override
    public boolean contains(Object o) {
        for (Tag tag : this.tags) {
            if (tag.equals(o)) return true;
        }
        return false;
    }

    @Override
    public Tag get(Object o) {
        for (Tag tag : this.tags) {
            if (tag.equals(o)) return tag;
        }
        return null;
    }
}

