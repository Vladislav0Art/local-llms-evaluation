                builder.append(String.format("data-%s=%s", internalKey(entry.getKey()), entry.getValue()));
            }
        }
        return builder.toString();
    }

    public static class AttributeImpl implements Cloneable {
        private Map<String, String> value;

        public AttributeImpl() {}

        @Override
        public Object clone() throws CloneNotSupportedException {
            // implementation
            return null;
        }

        public void setValue(String value) {
            this.value = new HashMap<>();
        }

        public String getValue() {
            return value.get("value");
        }
    }

    public static void main(String[] args) throws ParseException, IOException {
        AttributesImpl attributes = new AttributesImpl();
        AttributeImpl attribute1 = new AttributeImpl();
        AttributeImpl attribute2 = new AttributeImpl();

        attributes.addAttribute("_key", attribute1);
        attributes.addAttribute("_key2", attribute2);

        System.out.println(attributes.toString());
    }
}

