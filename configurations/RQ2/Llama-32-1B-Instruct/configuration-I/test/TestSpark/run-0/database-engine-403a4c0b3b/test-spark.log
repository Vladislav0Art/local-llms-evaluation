public class SQLTerm implements Comparable<SQLTerm> {
    private String strValue;

    public SQLTerm(String strValue) {
        this.strValue = strValue;
    }

    @Override
    public int compareTo(SQLTerm other) {
        return Integer.compare(this.strValue, other.strValue);
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj)
            return true;
        if (obj == null || getClass() != obj.getClass())
            return false;
        SQLTerm sqlTerm = (SQLTerm) obj;
        return this.strValue.equals(sqlTerm.strValue);
    }

    @Override
    public int hashCode() {
        return 31 * strValue.hashCode();
    }
}

