public static String generateI18n(String key, String value) {
    return "{" +
            "\"key\":\"" + key + "\",\"
            " \"value\":\"" + value + "\"}" + System.lineSeparator();
}

public static void printDictionary(Map<String, Object> dict) {
    for (Map.Entry<String, Object> entry : dict.entrySet()) {
        System.out.println(generateI18n(entry.getKey(), entry.getValue().toString()));
    }
}

class I18ndictionary extends AbstractMap.SimpleImmutableMap<String, String> {
    public static final Map<String, String> INSTANCE = new I18ndictionary();

    @Override
    public E get(Object key) {
        if (key instanceof String) return INSTANCE.get((String) key);
        throw new UnsupportedOperationException("Unsupported");
    }

