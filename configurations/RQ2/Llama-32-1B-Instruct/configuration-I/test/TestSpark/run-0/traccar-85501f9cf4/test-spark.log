public class TestService {
    public String getSatellitesCount(int satellites) {
        return "s" + satellites;
    }
}

public interface MockProtocol {
    public boolean decode(TestService testService, int length, byte[] buffer);
    public void setLength(int length);
}

public class MockGt06Protocol implements MockProtocol {
    @Override
    public boolean decode(TestService testService, int length, byte[] buffer) {
        return true;
    }

    @Override
    public void setLength(int length) {
        this.length = length;
    }
}

class TestService {
    private final String service;

    public TestService(String service) {
        this.service = service;
    }

    public String getSatellitesCount(int satellites) {
        return "s" + satellites;
    }
}

public class MainTest {
    @Test
    public void testMockProtocol() throws Exception {
        MockGt06Protocol mockProtocol = new MockGt06Protocol();
        MockService mockService = new MockService(mockProtocol);
        TestService service = new TestService("test_service");

        int result1 = mockProtocol.decode(service, 10, "s1");
        assertEquals(10, result1);

        int result2 = mockProtocol.decode(service, 5, "s2");
        assertEquals(3, result2);

        mockProtocol.setLength(20);
        int result3 = mockProtocol.decode(service, 30, "s3");
        assertEquals(true, result3);
    }

    public static class MockService {
        private final MockGt06Protocol protocol;

        public MockService(MockGt06Protocol protocol) {
            this.protocol = protocol;
        }

        public String getSatellitesCount(int satellites) {
            return protocol.decode(this, 10, "s" + satellites);
        }
    }
}
