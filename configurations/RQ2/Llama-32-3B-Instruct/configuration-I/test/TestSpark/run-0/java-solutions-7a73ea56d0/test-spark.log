        result[0] = heights[0];

        for (int i = 1; i < heights.length; i++) {
            if (heights[i - 1] >= heights[i]) {
                result[i] = result[i - 1];
            } else {
                result[i] = heights[i] + heights.length;
            }
        }

        return result;
    }
}

