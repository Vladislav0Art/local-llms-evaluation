import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.nodes.FormElement;
import org.jsoup.nodes.Connection;
import org.jsoup.nodes.DocumentType;
import org.jsoup.nodes.OutputSettings;
import org.jsoup.nodes.QirksMode;
import org.jsoup.parser.Parser;

import static org.junit.Assert.*;

import org.junit.Test;
import org.junit.experimental.categories.Category;
import org.mockito.Mockito;

import java.util.ArrayList;
import java.util.List;

@Category(org.junit.categories.JUnit4.class)
public class DocumentTest {

    @Test
    public void createShell_String_Test() {
        String baseUri = "https://example.com";
        Document document = Document.createShell(baseUri);
        assertNotNull(document);
    }

    @Test
    public void location_String_Test() {
        Document document = new Document("https://example.com");
        assertEquals("https://example.com", document.location());
    }

    @Test
    public void connection_Connection_Test() {
        Connection connection = Mockito.mock(Connection.class);
        Document document = new Document("https://example.com");
        document.connection(connection);
        assertEquals(connection, document.connection());
    }

    @Test
    public void documentType_String_Test() {
        Document document = new Document("https://example.com");
        Document documentType = document.documentType();
        assertNotNull(documentType);
    }

    @Test
    public void head_Element_Test() {
        Element element = Mockito.mock(Element.class);
        Document document = new Document("https://example.com");
        Element head = document.head(element);
        assertNotNull(head);
    }

    @Test
    public void body_Element_Test() {
        Element element = Mockito.mock(Element.class);
        Document document = new Document("https://example.com");
        Element body = document.body(element);
        assertNotNull(body);
    }

    @Test
    public void forms_List_Test() {
        List<FormElement> formElements = new ArrayList<>();
        Document document = new Document("https://example.com");
        List<FormElement> forms = document.forms(formElements);
        assertEquals(formElements, forms);
    }

    @Test
    public void expectForm_String_Test() {
        String cssQuery = "input[type='text']";
        FormElement formElement = Mockito.mock(FormElement.class);
        Document document = new Document("https://example.com");
        FormElement expectForm = document.expectForm(cssQuery)(formElement);
        assertEquals(formElement, expectForm);
    }

    @Test
    public void title_String_Test() {
        String title = "Example Title";
        Document document = new Document("https://example.com");
        document.title(title);
        assertEquals(title, document.title());
    }

    @Test
    public void createElement_String_Test() {
        String tagName = "div";
        Element element = Mockito.mock(Element.class);
        Document document = new Document("https://example.com");
        Element createElement = document.createElement(tagName)(element);
        assertNotNull(createElement);
    }

    @Test
    public void outerHtml_String_Test() {
        String html = "<html><body>Hello World!</body></html>";
        Document document = new Document("https://example.com");
        assertEquals(html, document.outerHtml());
    }

    @Test
    public void text_String_Test() {
        String text = "Hello World!";
        Document document = new Document("https://example.com");
        Element element = Mockito.mock(Element.class);
        Element textElement = document.text(text)(element);
        assertNotNull(textElement);
    }

    @Test
    public void nodeName_String_Test() {
        String name = "HTML";
        Document document = new Document("https://example.com");
        assertEquals(name, document.nodeName());
    }

    @Test
    public void charset_Charset_Test() {
        Charset charset = Mockito.mock(Charset.class);
        Document document = new Document("https://example.com");
        document.charset(charset);
        assertEquals(charset, document.charset());
    }

    @Test
    public void updateMetaCharsetElement_Boolean_Test() {
        boolean update = true;
        Document document = new Document("https://example.com");
        document.updateMetaCharsetElement(update);
        assertTrue(document.updateMetaCharsetElement());
    }

    @Test
    public void clone Document_Test() {
        Document document = new Document("https://example.com");
        Document clonedDocument = document.clone();
        assertNotNull(clonedDocument);
    }

    @Test
    public void shallowClone Document_Test() {
        Document document = new Document("https://example.com");
        Document shallowClonedDocument = document.shallowClone();
        assertNotNull(shallowClonedDocument);
    }

    @Test
    public void outputSettings_OutputSettings_Test() {
        OutputSettings outputSettings = Mockito.mock(OutputSettings.class);
        Document document = new Document("https://example.com");
        Document outputSettingsDocument = document.outputSettings(outputSettings);
        assertNotNull(outputSettingsDocument);
    }

    @Test
    public void quirksMode_QuirksMode_Test() {
        QuirksMode quirksMode = Mockito.mock(QuirksMode.class);
        Document document = new Document("https://example.com");
        Document quirksModeDocument = document.quirksMode(quirksMode);
        assertNotNull(quirksModeDocument);
    }

    @Test
    public void parser(Parser_Test()) {
        Parser parser = Mockito.mock(Parser.class);
        Document document = new Document("https://example.com");
        Document parserDocument = document.parser(parser);
        assertNotNull(parserDocument);
    }
}
