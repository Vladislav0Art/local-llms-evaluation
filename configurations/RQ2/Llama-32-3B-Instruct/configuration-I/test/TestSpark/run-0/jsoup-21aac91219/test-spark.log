import org.jsoup.parser.ParserSettings;
import org.jsoup.parser.Parser;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.nodes.Node;
import org.jsoup.nodes.TextNode;
import org.jsoup.nodes.Comment;
import org.jsoup.nodes.Attribute;
import org.jsoup.nodes.CharSequence;
import org.jsoup.nodes.Tag;
import org.jsoup.nodes.NodeContainer;
import org.jsoup.nodes.NodeVisitor;

public class HtmlTreeBuilderTest {

    public static void main(String[] args) {
        HtmlTreeBuilder htmlTreeBuilder = new HtmlTreeBuilder();
        Parser parser = htmlTreeBuilder.newParser();
        Document document = new Document();
        htmlTreeBuilder.initialiseParse(document, parser);
        System.out.println(parser.getAllowTags());
        System.out.println(parser.getAllowEntities());
        System.out.println(parser.getAllowComments());

        Element element = (Element) document.body().get(0);

        Node node = element childNode(0);
        if (node instanceof TextNode) {
            System.out.println(((TextNode) node).getData());
        }

        Tag tag = (Tag) element.tagName();
        System.out.println(tag.getValue());

        parser.setAllowTags(true);
        parser.setAllowEntities(false);
        parser.setAllowComments(true);

        htmlTreeBuilder.defaultSettings(parser);

        NodeContainer container = document.body().get(0);
        if (container instanceof NodeVisitor) {
            ((NodeVisitor) container).accept(node);
        }
    }

    public static class HtmlTreeBuilder {
        private Parser parser;

        public Parser newParser() {
            return new Parser();
        }

        public void initialiseParse(Document document, Parser parser) {
            this.parser = parser;
            this.parser.setAllowTags(false);
            this.parser.setAllowEntities(true);
            this.parser.setAllowComments(false);
        }

        public static class DefaultSettings implements org.jsoup.nodes.NodeVisitor {
            @Override
            public boolean accept(Node node, NodeContext context) {
                System.out.println(node.getNodeName());
                return false;
            }
        }

        public static void defaultSettings(Parser parser) {
            parser.setNodeVisitor(new HtmlTreeBuilder.DefaultSettings());
        }
    }

    public static class Parser {
        private boolean allowTags;
        private boolean allowEntities;
        private boolean allowComments;

        public void setAllowTags(boolean allowTags) {
            this.allowTags = allowTags;
        }

        public void setAllowEntities(boolean allowEntities) {
            this.allowEntities = allowEntities;
        }

        public void setAllowComments(boolean allowComments) {
            this.allowComments = allowComments;
        }

        public boolean getAllowTags() {
            return allowTags;
        }

        public boolean getAllowEntities() {
            return allowEntities;
        }

        public boolean getAllowComments() {
            return allowComments;
        }
    }

    public static class Token {}

    public interface Reader {}

    public interface Document {}

    public interface Element {}

    public interface NodeContainer {}

    public interface NodeVisitor {}
}

