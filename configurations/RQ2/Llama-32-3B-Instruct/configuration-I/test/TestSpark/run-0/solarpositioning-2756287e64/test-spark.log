import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertNotEquals;
import static org.mockito.Mockito.when;

@RunWith(MockitoJUnitRunner.class)
public class Grena3Test {

    @Mock
    private ZonedDateTime date;

    @Mock
    private double latitude;

    @Mock
    private double longitude;

    @Mock
    private double deltaT;

    public void setUp() {
        MockitoAnnotations.initMocks(this);
    }

    @Test
    public void calculateSolarPositionDate_LatitudeLongitudeDeltaTZenithAngleTest() {
        AzimuthZenithAngle result = Grena3.calculateSolarPosition(date, latitude, longitude, deltaT);
        when(date.toInstant()).thenReturn(1L);
        when(latitude).thenReturn(45.0);
        when(longitude).thenReturn(-10.0);
        when(deltaT).thenReturn(2.0);
        // Arrange and Act
        result = Grena3.calculateSolarPosition(date, latitude, longitude, deltaT);
        // Assert
        assertNotEquals(0, result.getAzimuth());
        assertEquals("zenith", result.getZenith());
    }

    @Test
    public void calculateSolarPositionDate_LatitudeLongitudeDeltaTPressureTemperatureZenithAngleTest() {
        AzimuthZenithAngle result = Grena3.calculateSolarPosition(date, latitude, longitude, deltaT, 1.0, 20.0);
        when(date.toInstant()).thenReturn(2L);
        when(latitude).thenReturn(30.0);
        when(longitude).thenReturn(5.0);
        when(deltaT).thenReturn(3.0);
        // Arrange and Act
        result = Grena3.calculateSolarPosition(date, latitude, longitude, deltaT, 1.0, 20.0);
        // Assert
        assertEquals("zenith", result.getAzimuth());
    }

    @Test
    public void calculateSolarPositionDate_LatitudeLongitudeDeltaTSameTimeTest() {
        AzimuthZenithAngle result = Grena3.calculateSolarPosition(date, latitude, longitude, deltaT);
        when(date.toInstant()).thenReturn(1L);
        when(latitude).thenReturn(45.0);
        when(longitude).thenReturn(-10.0);
        when(deltaT).thenReturn(2.0);
        // Arrange and Act
        result = Grena3.calculateSolarPosition(date, latitude, longitude, deltaT);
        // Assert
        assertEquals("zenith", result.getAzimuth());
    }

    @Test
    public void calculateSolarPositionDate_LatitudeLongitudeDeltaTPressureTemperatureSameTimeTest() {
        AzimuthZenithAngle result = Grena3.calculateSolarPosition(date, latitude, longitude, deltaT, 1.0, 20.0);
        when(date.toInstant()).thenReturn(2L);
        when(latitude).thenReturn(30.0);
        when(longitude).thenReturn(5.0);
        when(deltaT).thenReturn(3.0);
        // Arrange and Act
        result = Grena3.calculateSolarPosition(date, latitude, longitude, deltaT, 1.0, 20.0);
        // Assert
        assertEquals("zenith", result.getAzimuth());
    }

}
