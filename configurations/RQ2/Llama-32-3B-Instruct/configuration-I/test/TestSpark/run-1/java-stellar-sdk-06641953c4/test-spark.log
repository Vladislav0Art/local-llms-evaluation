public class KeyPairTest {

    private EdDSAPublicKey publicKey;

    @Mock
    private byte[] seed;
    @Mock
    private String accountId;
    @Mock
    private byte[] publicKeyBip39;

    public void setup() {
        MockitoAnnotations.initMocks(this);
        this.publicKey = new EdDSAPublicKey();
    }

    @Test
    public void testConstructorEdDsapublicKey() {
        KeyPair keyPair = new KeyPair(publicKey);
        assert keyPair != null;
    }

    @Test
    public void testCanSignValidPublicKey() {
        when(publicKey.toBytes()).thenReturn(seed);
        boolean canSign = KeyPair.canSign();
        assertTrue(canSign);
    }

    @Test
    public void testCanSignInvalidPublickey() {
        byte[] invalidPublicKey = new byte[]{1, 2, 3};
        boolean canSign = KeyPair.canSign(invalidPublicKey);
        assertFalse(canSign);
    }

    @Test
    public void testFromSecretSeedCharArray() {
        when(publicKey.toBytes()).thenReturn(seed);
        KeyPair keyPair = KeyPair.fromSecretSeed(seed);
        assertNotNull(keyPair);
    }

    @Test
    public void testRandom() {
        KeyPair keyPair = KeyPair.random();
        assertNotNull(keyPair);
    }

    @Test
    public void testGetAccountId() {
        when(publicKey.getAccountId()).thenReturn(accountId);
        String accountId = publicKey.getAccountId();
        assertEquals(accountId, accountId);
    }

    @Test
    public void testGetSecretSeed() {
        when(publicKey.toBytes()).thenReturn(seed);
        byte[] secretSeed = publicKey.toBytes();
        assertArrayEquals(seed, secretSeed);
    }

    @Test
    public void testGetPublicKey() {
        when(PublicKey.fromXdr(seed)).thenReturn(publicKey);
        PublicKey publicKeyFromXDR = PublicKey.fromXdr(seed);
        assertEquals(publicKey, publicKeyFromXDR);
    }

    @Test
    public void testGetSignatureHint() {
        when(publicKey.toBytes()).thenReturn(seed);
        SignatureHint signatureHint = publicKey.getSignatureHint();
        assertNotNull(signatureHint);
    }

    @Test
    public void testGetXdrPublicKey() {
        when(publicKey.toBytes()).thenReturn(seed);
        PublicKey xdrPublicKey = publicKey.getXDR();
        assertArrayEquals(seed, xdrPublicKey);
    }

    @Test
    public void testGetXdrSignerKey() {
        when(publicKey.toBytes()).thenReturn(seed);
        SignerKey signerKey = publicKey.getSignerKey();
        assertNotNull(signerKey);
    }

}
