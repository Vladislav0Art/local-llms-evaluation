        Printer printer = mock(Printer.class);
        when(printer.println(anyString())).thenReturn(null);
        PrettyPrintVisitor visitor = new PrettyPrintVisitor(printer);
        assertNotNull(visitor);
    }

    @Test
    public void exprToStringTest() {
        Expression expression = mock(Expression.class);
        when(expression.toString()).thenReturn("testExpression");
        String result = PrettyPrintVisitor.exprToString(expression);
        assertEquals("testExpression", result);
    }

    @Test
    public void visitAssignExprTest() {
        AssigningExpr expr = mock(AssigningExpr.class);
        when(expr.toString()).thenReturn("testAssignExpr");
        PrettyPrintVisitor visitor = new PrettyPrintVisitor();
        visitor.visitAssignExpr(expr);
        assertEquals("testAssignExpr", expr.toString());
    }

    @Test
    public void visitBinaryExprTest() {
        BinaryExpr expr = mock(BinaryExpr.class);
        when(expr.toString()).thenReturn("testBinaryExpr");
        PrettyPrintVisitor visitor = new PrettyPrintVisitor();
        visitor.visitBinaryExpr(expr);
        assertEquals("testBinaryExpr", expr.toString());
    }

    // ... other test methods ...

}
