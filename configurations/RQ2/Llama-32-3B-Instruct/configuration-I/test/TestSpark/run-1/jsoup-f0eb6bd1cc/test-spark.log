import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;

import java.io.UnsupportedEncodingException;
import java.net.URL;
import java.util.HashMap;
import java.util.Map;

import static org.junit.Assert.*;
import static org.mockito.Mockito.when;

@RunWith(org.junit.runners.JUnit4ClassRunner.class)
public class UrlBuilderTest {

    @Mock
    private Connection.KeyVal kvMock;

    @Mock
    private URL inputUrlMock;

    public UrlBuilder testSubject() {
        return new UrlBuilder(inputUrlMock);
    }

    @Test
    public void buildEmptyUrlTest() {
        when(inputUrlMock.toString()).thenReturn("");
        UrlBuilder urlBuilder = testSubject();
        URL result = urlBuilder.build();
        assertNull(result);
    }

    @Test
    public void buildValidUrlTest() {
        when(inputUrlMock.toString()).thenReturn("https://www.example.com");
        UrlBuilder urlBuilder = testSubject();
        URL result = urlBuilder.build();
        assertEquals("https://www.example.com", result.toString());
    }

    @Test(expected = UnsupportedEncodingException.class)
    public void appendKeyValInvalidEncodingTest() {
        UrlBuilder urlBuilder = testSubject();
        urlBuilder.appendKeyVal(new Connection.KeyVal("key", "invalid"));
    }

    @Test
    public void appendKeyValueTest() {
        when(inputUrlMock.toString()).thenReturn("https://www.example.com");
        String expectedResult = "https://www.example.com?key=value";
        UrlBuilder urlBuilder = testSubject();
        URL result = urlBuilder.build();
        assertEquals(expectedResult, result.toString());
    }

    @Test
    public void appendKeyValueWithMultipleValuesTest() {
        when(inputUrlMock.toString()).thenReturn("https://www.example.com");
        String expectedResult = "https://www.example.com?key=value1&key=value2";
        UrlBuilder urlBuilder = testSubject();
        URL result = urlBuilder.build();
        assertEquals(expectedResult, result.toString());
    }

    @Test
    public void appendKeyValWithDifferentKeyAndValueTest() {
        when(inputUrlMock.toString()).thenReturn("https://www.example.com");
        Connection.KeyVal kv1 = new Connection.KeyVal("key1", "value1");
        Connection.KeyVal kv2 = new Connection.KeyVal("key2", "value2");
        UrlBuilder urlBuilder = testSubject();
        URL result = urlBuilder.build();
        assertEquals("https://www.example.com?key=value1&key2=value2", result.toString());
    }
}
