        when(inputUrlMock.toString()).thenReturn("");
        UrlBuilder urlBuilder = testSubject();
        URL result = urlBuilder.build();
        assertNull(result);
    }

    @Test
    public void buildValidUrlTest() {
        when(inputUrlMock.toString()).thenReturn("https://www.example.com");
