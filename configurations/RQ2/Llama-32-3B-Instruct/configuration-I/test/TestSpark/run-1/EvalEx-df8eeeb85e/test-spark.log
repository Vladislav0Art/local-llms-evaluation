import org.junit.Test;
import static org.junit.Assert.*;
import java.util.List;
import java.util.ArrayList;

public class TokenizerTest {

    @Test
    public void parseMethodReturnsList() throws ParseException {
        new Tokenizer("expression", ExpressionConfiguration.getConfiguration());
        List<Token> result = new Tokenizer("expression").parse();
        assertNotNull(result);
    }

    @Test
    public void parseMethodThrowsParseExceptionWhenEmptyExpression() throws ParseException {
        new Tokenizer("", ExpressionConfiguration.getConfiguration());
        assertThrows(ParseException.class, () -> new Tokenizer("").parse());
    }

    @Test
    public void parseStringLiteralReturnsToken() throws ParseException {
        new Tokenizer("'string'", ExpressionConfiguration.getConfiguration());
        Token result = new Tokenizer("'string'").parseStringLiteral();
        assertNotNull(result);
        assertEquals("string", result.getValue());
    }

    @Test
    public void parseStringLiteralThrowsParseExceptionWhenInvalidStringLiteral() throws ParseException {
        new Tokenizer("\"string\" ", ExpressionConfiguration.getConfiguration());
        assertThrows(ParseException.class, () -> new Tokenizer("\"string\" ").parseStringLiteral());
    }

    @Test
    public void tokenizeMethodReturnsList() {
        List<Token> result = new Tokenizer("expression").tokenize();
        assertNotNull(result);
        assertFalse(result.isEmpty());
    }

    @Test
    public void tokenizeMethodThrowsParseExceptionWhenEmptyExpression() {
        new Tokenizer("", ExpressionConfiguration.getConfiguration());
        assertThrows(ParseException.class, () -> new Tokenizer("").tokenize());
    }
}

class MockTokenizer implements Tokenizer {
    private String expression;
    private List<Token> tokens;

    @Override
    public Tokenizer(String expressionString, ExpressionConfiguration configuration) {
        this.expression = expressionString;
        return this;
    }

    @Override
    public List<Token> parse() throws ParseException {
        if (tokens == null) {
            // implementation of parsing logic goes here
            tokens = new ArrayList<>();
            tokens.add(new Token(expression, TokenType.VARIABLE));
        }
        return tokens;
    }

    @Override
    public Token parseStringLiteral() throws ParseException {
        if (expression.equals("'string'")) {
            return new Token("string", TokenType.STRING_LITERAL);
        } else {
            throw new ParseException("Invalid string literal");
        }
    }

    @Override
    public List<Token> tokenize() {
        // implementation of tokenizing logic goes here
        return tokens;
    }
}
