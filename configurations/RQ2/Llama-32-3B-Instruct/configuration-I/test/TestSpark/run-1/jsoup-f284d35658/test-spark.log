    private HtmlTreeBuilder builder;

    @Before
    public void setup() {
        builder = new HtmlTreeBuilder();
    }

    @Test
    public void testInsertStartTag() {
        // GIVEN
        String tagName = "div";
        Element element = new Element(tagName);

        // WHEN
        Object result = builder.insertStartTag(element);

        // THEN
