import org.jsoup.helper.UrlBuilder;

public class HtmlUrlBuilderTest {

    @org.junit.Test
    public void testAppendUrl() {
        UrlBuilder url = new UrlBuilder();
        url.append("https://example.com");
        assertEquals(url.toString(), "https://example.com");
    }

    @org.junit.Test
    public void testAppendMultipleUrl() {
        UrlBuilder url = new UrlBuilder();
        url.append("https://example.com");
        url.append("/path/to/resource?query=param#fragment");
        assertEquals(url.toString(), "https://example.com/path/to/resource?query=param#fragment");
    }

    @org.junit.Test
    public void testAppendProtocol() {
        UrlBuilder url = new UrlBuilder();
        url.append("http:");
        url.append("https://example.com");
        assertEquals(url.toString(), "http://https://example.com");
    }

    @org.junit.Test
    public void testAppendPortNumber() {
        UrlBuilder url = new UrlBuilder();
        url.append("http:");
        url.append("example.com:8080");
        assertEquals(url.toString(), "http://example.com:8080");
    }

    @org.junit.Test
    public void testAppendAuthority() {
        UrlBuilder url = new UrlBuilder();
        url.append("http:");
        url.append("user:password@example.com:8080/path/to/resource?query=param#fragment");
        assertEquals(url.toString(), "http://user:password@example.com:8080/path/to/resource?query=param#fragment");
    }

    @org.junit.Test
    public void testAppendQuery() {
        UrlBuilder url = new UrlBuilder();
        url.append("https://example.com?query=param&anotherParam=value");
        assertEquals(url.toString(), "https://example.com?query=param&anotherParam=value");
    }

    @org.junit.Test
    public void testAppendFragment() {
        UrlBuilder url = new UrlBuilder();
        url.append("https://example.com#fragment");
        assertEquals(url.toString(), "https://example.com#fragment");
    }

}
