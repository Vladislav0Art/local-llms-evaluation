import org.jsoup.parser.Tag;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;

@RunWith(MockitoJUnitRunner.class)
public class TagTest {

    @Mock
    private ParseSettings parseSettings;

    @InjectMocks
    private Tag tag;

    @Test
    public void getName_EmptyName_ReturnsEmptyString() {
        String name = tag.getName();
        org.junit.Assert.assertEquals("", name);
    }

    @Test
    public void normalName_EmptyName_ReturnsLowercaseName() {
        String name = "abc";
        tag.setName(name);
        String result = tag.normalName();
        org.junit.Assert.assertEquals("abc", result.toLowerCase());
    }

    @Test
    public void valueOf_EmptyTagName_ReturnsGenericTag() {
        Tag result = Tag.valueOf("", parseSettings);
        org.junit.Assert.assertTrue(result instanceof Tag);
    }

    @Test
    public void valueOf_NonEmptyTagName_ReturnsKnownTagOrGenericTag() {
        String tagName = "p";
        Tag result = Tag.valueOf(tagName, parseSettings);
        org.junit.Assert.assertNotNull(result);
    }

    @Test
    public void isBlock_EmptyTag_RetrunsFalse() {
        tag.setSelfClosing(false);
        boolean result = tag.isBlock();
        org.junit.Assert.assertFalse(result);
    }

    @Test
    public void formatAsBlock_EmptyTag_ReturnsTrue() {
        tag.setSelfClosing(true);
        boolean result = tag.formatAsBlock();
        org.junit.Assert.assertTrue(result);
    }

    @Test
    public void isInline_EmptyTag_RetrunsFalse() {
        tag.setSelfClosing(false);
        boolean result = tag.isInline();
        org.junit.Assert.assertFalse(result);
    }

    @Test
    public void isEmpty_EmptyTag_ReturnsTrue() {
        tag.setName("");
        boolean result = tag.isEmpty();
        org.junit.Assert.assertTrue(result);
    }

    @Test
    public void isSelfClosing_EmptyTag_RetrunsFalse() {
        tag.setSelfClosing(false);
        boolean result = tag.isSelfClosing();
        org.junit.Assert.assertFalse(result);
    }

    @Test
    public void isKnownTag_KnownTagName_ReturnsTrue() {
        String tagName = "p";
        boolean result = Tag.isKnownTag(tagName);
        org.junit.Assert.assertTrue(result);
    }

    @Test
    public void preserveWhitespace_EmptyTag_RetrunsFalse() {
        tag.setSelfClosing(true);
        boolean result = tag.preserveWhitespace();
        org.junit.Assert.assertFalse(result);
    }

    @Test
    public void isFormListed_EmptyTag_RetrunsFalse() {
        tag.setName("input");
        boolean result = tag.isFormListed();
        org.junit.Assert.assertFalse(result);
    }

    @Test
    public void isFormSubmittable_EmptyTag_RetrunsTrue() {
        tag.setSelfClosing(true);
        boolean result = tag.isFormSubmittable();
        org.junit.Assert.assertTrue(result);
    }

    @Test
    public void setSelfClosing_SelfClosingTag_RetrunsModifiedTag() {
        Tag modifiedTag = tag.setSelfClosing();
        org.junit.Assert.assertNotNull(modifiedTag);
    }

    @Test
    public void equals_EmptyTag_ReturnsFalse() {
        String name = "input";
        Tag result = new Tag(name);
        boolean actual = tag.equals(result);
        org.junit.Assert.assertFalse(actual);
    }

    @Test
    public void hashCode_EmptyTag_RetrunsIntValue() {
        int result = tag.hashCode();
        org.junit.Assert.assertTrue(result != 0);
    }

    @Test
    public void toString_EmptyTag_ReturnsEmptyString() {
        String name = "input";
        Tag result = new Tag(name);
        String actual = result.toString();
        org.junit.Assert.assertEquals("", actual);
    }

    @Test
    public void clone_EmptyTag_RetrunsModifiedClone() {
        Tag modifiedTag = tag.clone();
        org.junit.Assert.assertNotNull(modifiedTag);
    }
}
