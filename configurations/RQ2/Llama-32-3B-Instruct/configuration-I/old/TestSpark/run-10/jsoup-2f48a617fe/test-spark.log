        Element element = document.getElementById("root");
        XmlDeclaration xmlDeclaration = (XmlDeclaration) element.childNodes().get(0);
        Comment comment = xmlDeclaration.asComment();
        assertTrue(comment.isXmlDeclaration());
    }

}
