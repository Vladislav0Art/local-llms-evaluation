import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertTrue;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

@RunWith(MockitoJUnitRunner.class)
public class TextNodeTest {

    @Mock
    private Appendable accum;

    public String testText() {
        return "Hello World!";
    }

    public String testBlankText() {
        return "";
    }

    public String testEncodedText() {
        return "&lt;Hello World&gt;";
    }

    public String testNormalisedWhitespace() {
        return "   ";
    }

    @Test
    public void text()[Scenario]Test() {
        TextNode node = new TextNode(testText());
        assertEquals(testText(), node.text());
    }

    @Test
    public void getWholeText()[Scenario]Test() {
        TextNode node = new TextNode(testText());
        assertEquals(testText().replace("\n", ""), node.getWholeText());
    }

    @Test
    public void text()[ScenarioBlankText]Test() {
        TextNode node = new TextNode(testBlankText());
        assertTrue(node.isBlank());
    }

    @Test
    public void text()[ScenarioEncodedText]Test() {
        when(TextNode.createFromEncoded(testEncodedText)).thenReturn(new TextNode(testEncodedText));
        TextNode node = TextNode.createFromEncoded(testEncodedText);
        assertEquals(testEncodedText, node.text());
    }

    @Test
    public void getWholeText()[ScenarioEncodedText]Test() {
        when(TextNode.createFromEncoded(testEncodedText)).thenReturn(new TextNode(testEncodedText));
        TextNode node = TextNode.createFromEncoded(testEncodedText);
        assertEquals( TextNode.normaliseWhitespace(testEncodedText), node.getWholeText());
    }

    @Test
    public void isBlank()[ScenarioEmptyText]Test() {
        assertTrue(new TextNode(testBlankText()).isBlank());
    }

    @Test
    public void splitText()[ScenarioSplittingAtMiddle]Test() {
        TextNode node = new TextNode("Hello World!");
        when(node.text()).thenReturn( "H" );
        TextNode newNode = node.splitText(6);
        assertEquals("World", newNode.text());
    }
}
