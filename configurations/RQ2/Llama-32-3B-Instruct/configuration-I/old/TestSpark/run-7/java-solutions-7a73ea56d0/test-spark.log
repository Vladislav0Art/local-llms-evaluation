import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.Mockito;
import org.mockito.junit.MockitoJUnitRunner;

import static org.junit.Assert.assertEquals;
import static org.mockito.ArgumentMatchers.anyInt;
import static org.mockito.Mockito.when;

@RunWith(MockitoJUnitRunner.class)
public class OnlineStockSpanTest {

    @Mock
    private int[] prices;

    @Test
    public void calculateSpans_EmptyArray_ReturnsEmptyArray() {
        when(prices.length).thenReturn(0);
        int[] result = new OnlineStockSpan().calculateSpans(prices);
        assertArrayEquals(new int[]{}, result);
    }

    @Test
    public void next_PricesIsLowestNextSpanIncreases() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        when(prices[0]).thenReturn(10);
        when(prices[1]).thenReturn(20);

        int[] expectedSpans = {1, 2};
        int[] result = onlineStockSpan.calculateSpans(new int[]{10, 20});
        assertArrayEquals(expectedSpans, result);
    }

    @Test
    public void next_PricesIsHigestNextSpanDecreases() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        when(prices[0]).thenReturn(1);
        when(prices[1]).thenReturn(10);

        int[] expectedSpans = {1, 9};
        int[] result = onlineStockSpan.calculateSpans(new int[]{1, 10});
        assertArrayEquals(expectedSpans, result);
    }

    @Test
    public void next_PricesIsSameAsNext_Overlap() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        when(prices[0]).thenReturn(1);
        when(prices[1]).thenReturn(1);

        int[] expectedSpans = {2, 2};
        int[] result = onlineStockSpan.calculateSpans(new int[]{1, 1});
        assertArrayEquals(expectedSpans, result);
    }

    @Test
    public void next_PricesIsZero_ThrowsIllegalArgumentException() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        when(prices[0]).thenReturn(0);

        Mockito.when(prices.length).thenReturn(1);
        assertThrows(IllegalArgumentException.class, () -> onlineStockSpan.next(10));
    }

    @Test
    public void next_PricesIsNull_ThrowsIllegalArgumentException() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        when(prices[0]).thenReturn(null);

        Mockito.when(prices.length).thenReturn(1);
        assertThrows(IllegalArgumentException.class, () -> onlineStockSpan.next(10));
    }
}
