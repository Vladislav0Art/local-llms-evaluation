        assertArrayEquals(new int[]{}, result);
    }

    @Test
    public void next_PricesIsLowestNextSpanIncreases() {
        int[] prices = {10, 20};
        int price = 30;
        int result = OnlineStockSpan.next(price);
        assertEquals(1, result);
    }

    @Test
    public void next_PricesIsHigestNextSpanDecreases() {
        int[] prices = {10, 20};
        int price = 5;
        int result = OnlineStockSpan.next(price);
        assertEquals(1, result);
    }

    @Test
    public void next_PricesIsSameAsNext_Overlap() {
        int[] prices = {10, 10};
        int price = 10;
        int result = OnlineStockSpan.next(price);
        assertEquals(2, result);
    }

    @Test
    public void next_PricesIsZero_ThrowsIllegalArgumentException() {
        int[] prices = {};
        assertThrows(IllegalArgumentException.class, () -> OnlineStockSpan.next(0));
    }

    @Test
    public void next_PricesIsNull_ThrowsIllegalArgumentException() {
        int[] prices = {};
        assertThrows(IllegalArgumentException.class, () -> OnlineStockSpan.next(null));
    }
}
