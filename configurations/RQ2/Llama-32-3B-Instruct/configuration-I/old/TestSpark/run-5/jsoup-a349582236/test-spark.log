```java
import org.junit.Test;
import static org.junit.Assert.*;
import java.util.HashMap;
import java.util.Map;

public class TagTest {

    @Test
    public void getName_EmptyTag_ReturnsEmptyString() {
        Tag tag = new Tag();
        String name = tag.getName();
        assertEquals("", name);
    }

    @Test
    public void normalName_LowercaseName_ReturnsNormalizedName() {
        Tag tag = new Tag("P");
        String name = tag.normalName();
        assertEquals("p", name);
    }

    @Test
    public void valueOf_UnknownTag_ReturnsGenericTag() {
        ParseSettings settings = new ParseSettings(true);
        Tag tag = Tag.valueOf("unknown", settings);
        assertNotNull(tag);
        assertFalse(Tag.isKnownTag("unknown"));
    }

    @Test
    public void valueOf_PredefinedTag_ReturnsPredefinedTag() {
        ParseSettings settings = new ParseSettings(false);
        Tag tag = Tag.valueOf("p", settings);
        assertNotNull(tag);
        assertTrue(Tag.isKnownTag("p"));
    }

    @Test
    public void isBlock_BlockTags_ReturnsTrue() {
        Tag tag = new Tag("P");
        assertTrue(tag.isBlock());
    }

    @Test
    public void isInline_InlineTags_ReturnsTrue() {
        Tag tag = new Tag("span");
        assertTrue(tag.isInline());
    }

    @Test
    public void isEmpty_EmptyTags_ReturnsTrue() {
        Tag tag = new Tag();
        assertTrue(tag.isEmpty());
    }

    @Test
    public void isSelfClosing_SelfClosingTags_ReturnsTrue() {
        Tag tag = new Tag("img");
        assertTrue(tag.isSelfClosing());
    }

    @Test
    public void preserveWhitespace_SelfClosingTags_ReturnsFalse() {
        Tag tag = new Tag("img");
        assertFalse(tag.preserveWhitespace());
    }

    @Test
    public void isFormListed_FormAssociatedTags_ReturnsTrue() {
        Tag tag = new Tag("input");
        assertTrue(tag.isFormListed());
    }

    @Test
    public void isFormSubmittable_FormAssociatedTags_ReturnsTrue() {
        Tag tag = new Tag("input");
        assertTrue(tag.isFormSubmittable());
    }

    @Test
    public void setSelfClosing_SelfClosingTags_ReturnsTagSetToSelfClosing() {
        Tag tag = new Tag();
        tag.setSelfClosing();
        assertTrue(tag.isSelfClosing());
    }
}

class ParseSettings {
    private boolean lowerCase;
    public ParseSettings(boolean lowerCase) {
        this.lowerCase = lowerCase;
    }
}
