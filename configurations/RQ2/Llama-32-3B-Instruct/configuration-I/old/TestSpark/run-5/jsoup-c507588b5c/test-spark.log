    }

    @org.junit.Test
    public void splitTextSplitsCorrectlyAtOffset() {
        TextNode textNode = new TextNode("test");
        TextNode splitTextNode = textNode.splitText(3);
        assertEquals("tes", splitTextNode.text());
    }

    @org.junit.Test
    public void cloneCreatesNewTextNodeWithSameText() {
        TextNode textNode = new TextNode("test");
        TextNode clonedTextNode = textNode.clone();
        assertEquals("test", clonedTextNode.text());
    }
}

