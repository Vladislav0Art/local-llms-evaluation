import static org.junit.Assert.assertFalse;
import static org.junit.Assert.assertTrue;
import static org.mockito.Mockito.when;

@RunWith(org.junit4.JUnit4ClassRunner.class)
public class TagTest {

    @Mock
    private ParseSettings parseSettings;

    @InjectMocks
    private Tag tag;

    public void setup() {
        MockitoAnnotations.initMocks(this);
    }

    @Test
    public void getName_EmptyReturnsNull() {
        setup();
        when(parseSettings.getNameSensitivity()).thenReturn(false);
        assertEquals(null, tag.getName());
    }

    @Test
    public void normalName_EmptyReturnsNull() {
        setup();
        when(parseSettings.getNameSensitivity()).thenReturn(true);
        assertEquals(null, tag.normalName());
    }

