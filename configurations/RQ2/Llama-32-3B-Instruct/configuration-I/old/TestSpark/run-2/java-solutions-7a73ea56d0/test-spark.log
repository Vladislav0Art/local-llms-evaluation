import org.junit.Test;
import org.junit.runner.RunWith;
import java.util.Arrays;

public class OnlineStockSpan {

    private int[] pricesArray;
    private int index;
    public int totalSpans = 0;

    public OnlineStockSpan() {
        this.pricesArray = new int[0];
        this.index = 0;
    }

    public int next(int price) {
        while (index < pricesArray.length && pricesArray[index] <= price) {
            index++;
        }
        int span = index == pricesArray.length ? 1 : index - pricesArray[index - 1];
        pricesArray = Arrays.copyOf(pricesArray, index + 1);
        totalSpans += span;
        pricesArray[pricesArray.length-1] = span;
        return span;
    }

    public int[] calculateSpans(int[] prices) {
        this.pricesArray = prices;
        return new int[]{totalSpans};
    }
}

public class OnlineStockSpanTest {

    private static int[] pricesArray;

    @org.junit.Before
    public void setUp() {
        pricesArray = new int[]{10, 20, 15};
    }

    @org.junit.Test
    public void nextPriceZeroTest() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        assertEquals(1, onlineStockSpan.next(0));
    }

    @org.junit.Test
    public void nextPriceNegativeTest() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        assertEquals(1, onlineStockSpan.next(-10));
    }

    @org.junit.Test
    public void nextPricePositiveTest() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        assertEquals(1, onlineStockSpan.next(15));
    }

    @org.junit.Test
    public void calculateSpansEmptyInputTest() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int[] result = onlineStockSpan.calculateSpans(new int[]{});
        assertArrayEquals(new int[]{0}, result);
    }

    @org.junit.Test
    public void calculateSpansSingleElementTest() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int[] result = onlineStockSpan.calculateSpans(new int[]{10});
        assertArrayEquals(new int[]{1}, result);
    }

    @org.junit.Test
    public void calculateSpansMultipleElementsTest() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        assertEquals(1, onlineStockSpan.next(10));
        assertEquals(2, onlineStockSpan.next(15));
        assertArrayEquals(new int[]{3}, onlineStockSpan.calculateSpans(new int[]{20}));
    }
