import org.junit.Test;
import static org.junit.Assert.*;
import java.util.*;
import java.lang.reflect.Field;

public class CommentsConfigurationTest {

    @Test
    public void constructorTest() {
        CommentsConfiguration comments = new CommentsConfiguration();
        assertNull(comments.getComments());
    }

    @Test
    public void constructorWithCommentMapTest() {
        Map<String, List<String>> commentMap = new HashMap<>();
        commentMap.put("path", Arrays.asList("line1", "line2"));
        CommentsConfiguration comments = new CommentsConfiguration(commentMap);
        assertNotNull(comments.getComments());
        assertEquals(1, comments.getComments().size());
    }

    @Test
    public void setCommentTest() {
        Map<String, List<String>> commentMap = new HashMap<>();
        commentMap.put("path", Arrays.asList("line1", "line2"));
        CommentsConfiguration comments = new CommentsConfiguration(commentMap);
        String path = "testPath";
        String[] commentLines = {"newLine"};
        comments.setComment(path, commentLines);
        assertEquals(1, comments.getComments().get(path).size());
    }

    @Test
    public void setCommentSingleNewLineTest() {
        Map<String, List<String>> commentMap = new HashMap<>();
        commentMap.put("path", Arrays.asList("line1", "line2"));
        CommentsConfiguration comments = new CommentsConfiguration(commentMap);
        String path = "testPath";
        String[] commentLines = {"\n"};
        comments.setComment(path, commentLines);
        assertEquals(0, comments.getComments().get(path).size());
    }

    @Test
    public void getAllCommentsTest() {
        Map<String, List<String>> commentMap = new HashMap<>();
        commentMap.put("path", Arrays.asList("line1", "line2"));
        CommentsConfiguration comments = new CommentsConfiguration(commentMap);
        assertTrue(comments.getAllComments().containsKey("testPath"));
    }

    @Test
    public void getAllCommentsEmptyMapTest() {
        Map<String, List<String>> commentMap = new HashMap<>();
        CommentsConfiguration comments = new CommentsConfiguration(commentMap);
        assertFalse(comments.getAllComments().containsKey("testPath"));
    }
}
