import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.junit.Test;
import static org.junit.Assert.*;

public class TextNodeTest {

    @Test
    public void textNodeCreation_SimpleText_Test() {
        String text = "Hello World";
        TextNode textNode = new TextNode(text);
        assertEquals(text, textNode.text());
    }

    @Test
    public void textNodeCreation_EmptyString_Test() {
        String text = "";
        TextNode textNode = new TextNode(text);
        assertTrue(textNode.isBlank());
    }

    @Test
    public void textNodeCreation_NullText_Test() throws IOException {
        try {
            new TextNode(null);
            assert false;
        } catch (NullPointerException e) {
            // Expected
        }
    }

    @Test
    public void nodeName_AtomanticTest() {
        String nodeName = "text";
        assertEquals(nodeName, ((TextNode) mockText()).nodeName());
    }

    @Test
    public void splitText_SplitAtOffset_SimpleString_Test() throws IOException {
        TextNode textNode = new TextNode("Hello World");
        TextNode node1 = (TextNode) mockText();
        TextNode node2 = (TextNode) mockText();
        int offset = 6;
        assertEquals(node1, ((TextNode) mockText()).splitText(offset));
    }

    @Test
    public void splitText_SplitAtOffset_EmptyString_Test() throws IOException {
        TextNode textNode = new TextNode("");
        TextNode node1 = (TextNode) mockText();
        int offset = 0;
        assertEquals(node1, ((TextNode) mockText()).splitText(offset));
    }

    @Test
    public void isBlank_NoWhitespaceNodes_SimpleString_Test() {
        String text = "Hello World";
        assertTrue(new TextNode(text).isBlank());
    }

    @Test
    public void isBlank_WhitespaceNodes_EmptyString_Test() {
        String text = "\n";
        assertTrue(new TextNode(text).isBlank());
    }

    @Test
    public void clone_ClonedTextNode_SimpleText_Test() throws IOException {
        String text = "Hello World";
        TextNode textNode1 = new TextNode(text);
        TextNode textNode2 = textNode1.clone();
        assertEquals(text, textNode2.text());
    }

    @Test
    public void toString_TokenisedString_Test() {
        String tokenisedText = "\\lt\\gt\\s+Hello\\s+World\\s+\\lt\\gt";
        assertEquals(tokenisedText, ((TextNode) mockText()).toString());
    }
}

