import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.Mockito;

import java.util.*;

@RunWith(MockitoJUnitRunner.class)
public class CommentsConfigurationTest {

    @Mock
    private Map<String, List<String>> commentsMap;

    @Mock
    private String newLine;

    @Test
    public void getCommentsReturnsEmptyMapIfNotProvided() {
        CommentsConfiguration configuration = new CommentsConfiguration();
        Map<String, List<String>> allComments = configuration.getAllComments();
        assertTrue(allComments.isEmpty());
    }

    @Test
    public void setCommentAddsNewEntryWhenPathDoesNotExist() {
        CommentsConfiguration configuration = new CommentsConfiguration();
        List<String> commentLines = Arrays.asList("comment1", "comment2");
        configuration.setComment("path", commentLines);
        Map<String, List<String>> allComments = configuration.getAllComments();
        assertTrue(allComments.containsKey("path"));
    }

    @Test
    public void setCommentAddsNewEntryToExistingPath() {
        CommentsConfiguration configuration = new CommentsConfiguration(commentsMap);
        List<String> commentLines = Arrays.asList("comment1", "comment2");
        configuration.setComment("path", commentLines);
        Map<String, List<String>> allComments = configuration.getAllComments();
        assertTrue(allComments.containsKey("path"));
    }

    @Test
    public void setCommentReplacesPreviousEntryWhenPathExists() {
        CommentsConfiguration configuration = new CommentsConfiguration(commentsMap);
        String previousCommentLine = "previous comment";
        List<String> commentLines = Arrays.asList(previousCommentLine, "new comment");
        configuration.setComment("path", commentLines);
        Map<String, List<String>> allComments = configuration.getAllComments();
        assertTrue(allComments.get("path").contains(previousCommentLine));
    }

    @Test
    public void setCommentAddsEmptyEntryForSingleNewLine() {
        CommentsConfiguration configuration = new CommentsConfiguration(commentsMap);
        String singleNewLine = "\n";
        List<String> commentLines = Arrays.asList(singleNewLine, "new comment");
        configuration.setComment("path", commentLines);
        Map<String, List<String>> allComments = configuration.getAllComments();
        assertTrue(allComments.containsKey("path"));
    }

    @Test
    public void getAllCommentsReturnsUnmodifiableMap() {
        CommentsConfiguration configuration = new CommentsConfiguration(commentsMap);
        Map<String, @UnmodifiableView List<String>> allComments = configuration.getAllComments();
        assertNotSame(allComments, configuration.getAllComments());
    }
}
