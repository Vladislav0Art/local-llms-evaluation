public class URLBuilder {
    private StringBuilder url = new StringBuilder();

    public void append(String key, String value) {
        if (key == null || value == null) return;
        if (!url.toString().isEmpty()) {
            url.append("&");
        }
        url.append(key).append("=").append(value);
    }

    public String build() {
        if (url.toString().isEmpty()) {
            return "http://example.com";
        }
        return "http://example.com?" + url.toString();
    }
}

public class URLBuilderTest {

    @org.junit.Test
    public void testAppend_withKeyVal() {
        URLBuilder urlBuilder = new URLBuilder();
        Connection.KeyVal kv1 = new Connection.KeyVal("key1", "value1");
        Connection.KeyVal kv2 = new Connection.KeyVal("key2", "value2");
        urlBuilder.append(kv1.getKey(), kv1.getValue());
        urlBuilder.append(kv2.getKey(), kv2.getValue());
        assertEquals("http://example.com?key1=value1&key2=value2", urlBuilder.build());
    }

    @org.junit.Test
    public void testAppend_withoutKeyVal() {
        URLBuilder urlBuilder = new URLBuilder();
        urlBuilder.append("key1", "value1");
        urlBuilder.append("key2", "value2");
        assertEquals("http://example.com?key1=value1&key2=value2", urlBuilder.build());
    }

    @org.junit.Test
    public void testAppend_emptyUrl() {
        URLBuilder urlBuilder = new URLBuilder();
        urlBuilder.append(kv1.getKey(), kv1.getValue());
        urlBuilder.append(kv2.getKey(), kv2.getValue());
        assertEquals("http://example.com?key1=value1&key2=value2", urlBuilder.build());
    }

    @org.junit.Test
    public void testAppend_nullKey() {
        URLBuilder urlBuilder = new URLBuilder();
        Connection.KeyVal kv1 = new Connection.KeyVal(null, "value");
        urlBuilder.append(kv1.getKey(), kv1.getValue());
        assertEquals("http://example.com&value", urlBuilder.build());
    }

    @org.junit.Test
 public void testAppend_nullValue() {
        URLBuilder urlBuilder = new URLBuilder();
        Connection.KeyVal kv1 = new Connection.KeyVal("key", null);
        urlBuilder.append(kv1.getKey(), kv1.getValue());
        assertEquals("http://example.com?key=", urlBuilder.build());
    }
}
```

