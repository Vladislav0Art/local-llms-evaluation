    public void testAppendQuery_withoutValue() throws URISyntaxException {
        URLBuilder urlBuilder = new URLBuilder();
        Connection.KeyVal kv1 = new Connection.KeyVal("key", null);
        urlBuilder.appendQuery(kv1.getKey(), kv1.getValue());
        assertEquals("http://example.com?key=", urlBuilder.build());
    }

    @org.junit.Test
    public void testAppendQuery_emptyUrl() throws URISyntaxException {
        URLBuilder urlBuilder = new URLBuilder();
        urlBuilder.appendQuery("key", "value");
        assertEquals("http://example.com?key=value", urlBuilder.build());
    }

