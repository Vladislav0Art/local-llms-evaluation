class UrlBuilder {
    private String url;

    public void setUrl(String url) {
        this.url = url;
    }

    public String getUrl() {
        return url;
    }

    public void appendParameter(String key, String value) {
        if (url == null) {
            url = "http://localhost:8080";
        }
        url += "?key=" + value;
