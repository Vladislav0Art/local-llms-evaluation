import org.junit.Before;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertThrows;
import static org.mockito.Mockito.when;

@RunWith(MockitoJUnitRunner.class)
public class OnlineStockSpanTest {

    private OnlineStockSpan onlineStockSpan;
    @Mock
    private int[] prices;

    public void setUp() {
        onlineStockSpan = new OnlineStockSpan();
    }

    // Test next method with valid price
    @Test
    public void nextPrice_ReturnsCorrectSpan() {
        when(prices[0]).thenReturn(100);
        int result = onlineStockSpan.next(100);
        assertEquals(1, result);
    }

    // Test next method with invalid price
    @Test
    public void nextPrice_ThrowsIllegalArgumentException() {
        assertThrows(IllegalArgumentException.class, () -> onlineStockSpan.next(-100));
    }

    // Test calculateSpans method with empty array
    @Test
    public void calculateSpans_EmptyArray_ReturnsEmptyArray() {
        int[] result = onlineStockSpan.calculateSpans(new int[0]);
        assertEquals(new int[0], result);
    }

    // Test calculateSpans method with single element array
    @Test
    public void calculateSpans_SingleElementArray_ReturnsCorrectSpan() {
        when(prices[0]).thenReturn(100);
        int[] result = onlineStockSpan.calculateSpans(new int[]{100});
        assertEquals(new int[]{1}, result);
    }

    // Test calculateSpans method with multiple element array
    @Test
    public void calculateSpans_MultipleElementArray_ReturnsCorrectSpans() {
        when(prices[0]).thenReturn(100);
        when(prices[1]).thenReturn(200);
        int[] result = onlineStockSpan.calculateSpans(new int[]{100, 200});
        assertEquals(new int[]{1, 2}, result);
    }

    // Test calculateSpans method with duplicate elements
    @Test
    public void calculateSpans_DuplicateElements_ReturnsCorrectSpans() {
        when(prices[0]).thenReturn(100);
        when(prices[1]).thenReturn(200);
        when(prices[2]).thenReturn(100);
        int[] result = onlineStockSpan.calculateSpans(new int[]{100, 200, 100});
        assertEquals(new int[]{1, 2, 1}, result);
    }
}
