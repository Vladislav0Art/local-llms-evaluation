public class OnlineStockSpan {

    private int[] prefixSum;

    public OnlineStockSpan() {
        prefixSum = new int[0];
    }

    public void add(int price) {
        int suffixSum = getSuffixSum();
        int delta = Math.max(0, suffixSum - price);
        prefixSum = Arrays.copyOf(prefixSum, prefixSum.length + 1);
        prefixSum[prefixSum.length - 1] = delta;
    }

    private int getSuffixSum() {
        return prefixSum[prefixSum.length - 1];
    }

    public int next(int price) {
        add(price);
        return prefixSum[prefixSum.length - 1];
    }
}

public class OnlineStockSpanTest {

    @Test
    public void testNextValidPrice() {
        OnlineStockSpan stockSpan = new OnlineStockSpan();
        stockSpan.next(100);
        stockSpan.next(200);
        assertEquals(2, stockSpan.next(300));
    }

    @Test
    public void testInvalidPrice() {
        OnlineStockSpan stockSpan = new OnlineStockSpan();
        assertThrows(IllegalArgumentException.class, () -> stockSpan.next(-100));
    }

    @Test
    public void testMultipleValidPrices() {
        OnlineStockSpan stockSpan = new OnlineStockSpan();
        stockSpan.next(100);
        stockSpan.next(200);
        assertEquals(3, stockSpan.next(300));
        assertEquals(4, stockSpan.next(400));
    }

    @Test
    public void testDuplicateElements() {
        OnlineStockSpan stockSpan = new OnlineStockSpan();
        stockSpan.next(100);
        stockSpan.next(200);
        stockSpan.next(100);
        assertEquals(1, stockSpan.next(300));
        assertEquals(2, stockSpan.next(400));
        assertEquals(3, stockSpan.next(500));
    }

    @Test
    public void testNegativeElements() {
        OnlineStockSpan stockSpan = new OnlineStockSpan();
        stockSpan.next(-100);
        stockSpan.next(200);
        stockSpan.next(300);
        assertEquals(1, stockSpan.next(-50));
        assertEquals(2, stockSpan.next(-40));
        assertEquals(3, stockSpan.next(-30));
    }
}
