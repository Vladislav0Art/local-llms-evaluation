        String result = builder.build();
        assert result == null;
    }

    @Test
    public void buildUrlWithBasicFormat() {
        String url = "http://example.com/path?query=value";
        UrlBuilder builder = new UrlBuilder(url);
        String expectedResult = "http://example.com/path?query=value";
        assertEquals(expectedResult, builder.build());
    }

    @Test
    public void appendKeyValueWithKeyAndValue() throws UnsupportedEncodingException {
        String url = "http://example.com/path";
        Connection.KeyVal kv = new Connection.KeyVal("key", "value");
        UrlBuilder builder = new UrlBuilder(url);
        when(builder.appendKeyVal(kv)).thenReturn(builder);
        String expectedResult = "http://example.com/path?key=value";
        assertEquals(expectedResult, builder.build());
    }

    @Test
    public void appendKeyValueWithInvalidFormat() throws UnsupportedEncodingException {
        String url = "http://example.com/path";
        Connection.KeyVal kv = new Connection.KeyVal(null, null);
        UrlBuilder builder = new UrlBuilder(url);
        try {
            builder.appendKeyVal(kv);
            assert false;
        } catch (UnsupportedEncodingException e) {
            // expected
        }
    }

    @Test
    public void appendKeyValueWithInvalidUrl() throws UnsupportedEncodingException {
        Connection.KeyVal kv = new Connection.KeyVal(null, null);
        UrlBuilder builder = new UrlBuilder(null);
        try {
            builder.appendKeyVal(kv);
            assert false;
        } catch (UnsupportedEncodingException e) {
            // expected
        }
    }

