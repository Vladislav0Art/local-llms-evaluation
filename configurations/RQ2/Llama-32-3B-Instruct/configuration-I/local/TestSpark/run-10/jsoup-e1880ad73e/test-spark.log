import org.junit.Test;
import static org.junit.Assert.*;
public class UrlBuilderTest {

    @Test
    public void testUrlBuilder() {
        // Given
        String url = "http://example.com";
        int portNumber = 8080;

        // When
        String urlWithPort = generateUrl(url, portNumber);
        
        // Then
        assertEquals("http://localhost:" + portNumber + "/path", urlWithPort);

    }

    @Test
    public void testCreateKeyVal() {
        // Given
        String key = "key";
        String value = "value";

        // When
        org.jsoup.helper.Connection.KeyVal kv = createKeyVal(key, value);
        
        // Then
        assertEquals(key, kv.getKey());
        assertEquals(value, kv.getValue());

    }

    @Test
    public void testCreateQueryParams() {
        // Given
        String key1 = "key1";
        String value1 = "value1";
        String key2 = "key2";
        String value2 = "value2";

        // When
        org.jsoup.helper.Connection.KeyVal kv1 = createKeyVal(key1, value1);
        org.jsoup.helper.Connection.KeyVal kv2 = createKeyVal(key2, value2);

        // Then
        assertEquals("key1=value1", kv1.toString());
        assertEquals("key2=value2", kv2.toString());

    }

    private String generateUrl(String url, int portNumber) {
        return url.replace("8080", String.valueOf(portNumber));
    }

    private org.jsoup.helper.Connection.KeyVal createKeyVal(String key, String value) {
        org.jsoup.helper.Connection.KeyVal kv = new org.jsoup.helper.Connection.KeyVal();
        kv.setKey(key);
        kv.setValue(value);
        return kv;
    }
}
