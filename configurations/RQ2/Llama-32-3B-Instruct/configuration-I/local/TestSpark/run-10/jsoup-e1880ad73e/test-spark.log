public class UrlBuilderTest {

    @Test
    public void testUrlBuilder() {
        // Given
        String url = "http://example.com";
        int portNumber = 8080;

        // When
        String urlWithPort = ConnectionHelper.generateUrl(url, portNumber);

        // Then
        assertEquals("http://localhost:" + portNumber + "/path", urlWithPort);
    }

    @Test
    public void testCreateKeyVal() {
        // Given
        String key = "key";
        String value = "value";

        // When
        Connection.KeyVal kv = ConnectionHelper.createKeyVal(key, value);

        // Then
        assertEquals(key, kv.getKey());
        assertEquals(value, kv.getValue());
    }

    @Test
    public void testCreateQueryParams() {
        // Given
        String key1 = "key1";
        String value1 = "value1";
        String key2 = "key2";
        String value2 = "value2";

        // When
        Connection.KeyVal kv1 = ConnectionHelper.createKeyVal(key1, value1);
        Connection.KeyVal kv2 = ConnectionHelper.createKeyVal(key2, value2);

        // Then
        assertEquals("key1=value1", kv1.toString());
        assertEquals("key2=value2", kv2.toString());
    }

}
