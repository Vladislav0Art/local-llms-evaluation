import org.jsoup.helper.UrlBuilder;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;

import java.net.URL;
import java.util.HashMap;
import java.util.Map;

@RunWith(MockitoJUnitRunner.class)
public class UrlBuilderTest {

    @Mock
    private Connection.KeyVal kv;

    @Mock
    private URL inputUrl;

    @Test
    public void build_[DefaultBuildScenario]Test() {
        UrlBuilder urlBuilder = new UrlBuilder(inputUrl);
        URL result = urlBuilder.build();
        assertNotNull(result);
    }

    @Test
    public void build_[UrlWithQuery_]Test() {
        UrlBuilder urlBuilder = new UrlBuilder(inputUrl);
        Map<String, String> queryMap = new HashMap<>();
        queryMap.put("key", "value");
        urlBuilder.appendKeyVal(queryMap);
        URL result = urlBuilder.build();
        assertEquals(inputUrl.getProtocol(), result.getProtocol());
        assertEquals(inputUrl.getHost(), result.getHost());
    }

    @Test
    public void build_[UrlWithQueryAndFragment_]Test() {
        UrlBuilder urlBuilder = new UrlBuilder(inputUrl);
        Map<String, String> queryMap = new HashMap<>();
        queryMap.put("key", "value");
        urlBuilder.appendKeyVal(queryMap);
        urlBuilder.appendKeyVal(new Connection.KeyVal(Connection.KeyVal.PAGE, "1"));
        URL result = urlBuilder.build();
        assertEquals(inputUrl.getProtocol(), result.getProtocol());
        assertEquals(inputUrl.getHost(), result.getHost());
    }

    @Test
    public void append_[AppendSingleKeyVal_]Test() {
        UrlBuilder urlBuilder = new UrlBuilder(inputUrl);
        Map<String, String> queryMap = new HashMap<>();
        queryMap.put("key", "value");
        urlBuilder.appendKeyVal(queryMap);
        assertNotNull(urlBuilder.build());
    }

    @Test
    public void append_[AppendMultipleKeyVals_]Test() {
        UrlBuilder urlBuilder = new UrlBuilder(inputUrl);
        Map<String, String> queryMap1 = new HashMap<>();
        queryMap1.put("key", "value");
        Map<String, String> queryMap2 = new HashMap<>();
        queryMap2.put("key2", "value2");
        urlBuilder.appendKeyVal(queryMap1);
        urlBuilder.appendKeyVal(queryMap2);
        assertNotNull(urlBuilder.build());
    }

    @Test
    public void append_[AppendUnsupportedEncoding_]Test() {
        UrlBuilder urlBuilder = new UrlBuilder(inputUrl);
        Map<String, String> queryMap = new HashMap<>();
        queryMap.put("key", "value");
        urlBuilder.appendKeyVal(queryMap);
        try {
            urlBuilder.appendKeyVal(new Connection.KeyVal(Connection.KeyVal.PAGE, "1"));
            assert false;
        } catch (UnsupportedEncodingException e) {
            // Expected
        }
    }

}
