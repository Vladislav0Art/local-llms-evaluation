        assertTrue(result > 0);
    }

    @Test
    public void getAppVersionPattern_ContainsAMIDepartment() {
        Pattern pattern = AppVersion.getAppVersionPattern();
        assertTrue(pattern.matcher("ami-12345678901").find());
    }

