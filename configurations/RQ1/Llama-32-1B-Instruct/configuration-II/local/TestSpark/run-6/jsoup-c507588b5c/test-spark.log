public class TextNodeTests {

    @Test
    public void testIsBlank_EmptyText() {
        // Arrange
        String text = "";
        
        // Act
        boolean result = TextNode.isBlank(text);
        
        // Assert
        assertTrue(result, "Expected isBlank() to return true for an empty string");
    }

    @Test
    public void testIsBlank_NullText() {
        // Arrange
        String text = null;
        
        // Act
        boolean result = TextNode.isBlank(text);
        
        // Assert
        assertFalse(result, "Expected isBlank() to return false for a null string");
    }

    @Test
    public void testIsBlank_EmptyStringWithSpaces() {
        // Arrange
        String text = "";
        char[] whitespace = { ' ', '\n', '\t' };
        
