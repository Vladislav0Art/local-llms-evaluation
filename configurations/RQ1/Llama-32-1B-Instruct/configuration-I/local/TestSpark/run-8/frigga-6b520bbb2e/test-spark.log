        AppVersion appVersion = parseName("subscriberha-1.0.0-586499");
        assertNotNull(appVersion.getPackageName());
        assertEquals("subscriberha", appVersion.getPackageName());
    }

    @Test
    public void testGetVersion() {
        AppVersion appVersion = parseName("subscriberha-1.0.0-586499");
        assertNotNull(appVersion.getVersion());
        assertEquals("1.0.0", appVersion.getVersion());
    }

    @Test
    public void testGetBuildJobName() {
        AppVersion appVersion = parseName("subscriberha-1.0.0-586499");
        assertNotNull(appVersion.getBuildJobName());
        assertEquals("subscriberha-h150", appVersion.getBuildJobName());
    }

    @Test
    public void testGetBuildNumber() {
        AppVersion appVersion = parseName("subscriberha-1.0.0-586499");
        assertNotNull(appVersion.getBuildNumber());
        assertEquals("586499", appVersion.getBuildNumber());
    }

    @Test
    public void testGetCommit() {
        AppVersion appVersion = parseName("subscriberha-1.0.0-586499");
        assertNotNull(appVersion.getCommit());
        assertEquals(" subscriberha-h150", appVersion.getCommit());
    }

    @Test
    public void testToString() {
        AppVersion appVersion = parseName("subscriberha-1.0.0-586499");
