public class TextNodeTest {
    private TextNode mockTextNode;

    @Before
    public void setUp() {
        mockTextNode = new TextNodeMock();
    }

    /**
     * Test if a text node is blank -- that is, empty or only whitespace (including newlines).
     * @return true if this document is empty or only whitespace, false if it contains any text content.
     */
    public void testIsBlank() {
        // Arrange
        String text = mockTextNode.text("   ");
        Document doc = mockTextNode;

        // Act
        boolean result = doc.isBlank();

        // Assert
        assert result;
    }

    /**
     * Test if a new TextNode can be created from HTML encoded data.
     */
    public void testCreateFromEncoded() {
        // Arrange
        String encodedText = "Hello, World!";
        Document document = mockTextNode;

        // Act
        TextNode newText = document.createFromEncoded(encodedText);

        // Assert
        assert newText != null;
    }

    /**
     * Test if the toString method returns a valid HTML string.
     */
    public void testToString() {
        // Arrange
        String text = mockTextNode.toString();

        // Act
        Document document = mockTextNode;

        // Assert
        assert !text.isEmpty();
    }
}

