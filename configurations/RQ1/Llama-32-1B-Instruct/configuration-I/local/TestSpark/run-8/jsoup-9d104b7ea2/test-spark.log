import java.util.*;

public class NodeTraversalTest {
    private Document document;

    @Before
    public void setUp() {
        document = mockDocument();
    }

    /**
     * Test if a text node list can be created from HTML encoded data.
     */
    public void testCreateFromEncoded() {
        // Arrange
        String encodedText = "Hello, World! Foo Bar";

        // Act
        List<TextNode> textNodes = document.createFromEncoded(encodedText);

        // Assert
        assert !textNodes.isEmpty();
        for (TextNode node : textNodes) {
            assert !node.isBlank();
        }
    }

    /**
     * Test that appending elements to a TextNodeList returns the correct order.
     */
    public void testAppend() {
        // Arrange
        Document document = mockDocument();

        // Act
        List<TextNode> textNodes = document.getTextNode("Hello, World!");
        List<TextNode> appendedTextNodes = new ArrayList<>(textNodes);
        appendedTextNodes.add(0, document.appendText(" Foo! Bar."));

        // Assert
        assert !appendedTextNodes.isEmpty();
        for (TextNode node : appendedTextNodes) {
            assert !node.isBlank();
        }
    }

    /**
     * Test that removing elements from a TextNodeList returns the correct order.
     */
    public void testRemove() {
        // Arrange
        Document document = mockDocument();

        // Act
        List<TextNode> textNodes = document.getTextNode("Hello, World!");
        textNodes.remove(0);
        List<TextNode> appendedTextNodes = new ArrayList<>(textNodes);

        // Assert
        assert !appendedTextNodes.isEmpty();
        for (TextNode node : appendedTextNodes) {
            assert !node.isBlank();
        }
    }

    private Document mockDocument() {
        Document doc = new Document("Test HTML");
        doc.appendText("Hello, World!");
        return doc;
    }

    private class Document extends DocumentOutputSettings {
        @Override
        public String toString() {
            StringBuilder builder = new StringBuilder();
            traverse(node -> builder.append(node).append(" "));
            return builder.toString();
        }
    }
}

class Node<T> {
    private T text;

    public T getText() {
        return text;
    }

    public void setText(T text) {
        this.text = text;
    }

    public List<T> getChildren() {
        return children(this);
    }

    @Override
    public String toString() {
        StringBuilder builder = new StringBuilder();
        traverse(node -> builder.append(node).append(" "));
        return builder.toString();
    }

    private List<Node<T>> children(Node<T> parent) {
        for (T child : text) {
            if (!child.isBlank()) {
                return append(child, parent);
            }
        }
        return Collections.emptyList();
    }

    @Override
    public void traverse(TraversalConsumer<T> consumer) {
        if (text != null && !consumer.accept(text)) {
            throw new RuntimeException("Elements must be of the same type");
        }
        for (T child : text) {
            consumer.accept(child);
        }
    }

    private class TraversalConsumer<T> implements Consumer<T> {
        @Override
        public void accept(T node) {
            System.out.println(node.getText());
        }
    }
}
