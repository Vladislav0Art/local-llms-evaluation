package com.netflix.frigga.ami;

import com.netflix.frigga.NameConstants;

import java.util.regex.Matcher;
import java.util.regex.Pattern;

import org.junit.jupiter.api.Test;

import static org.mockito.Mockito.*;

public class GeneratedTest {

    private AppVersion appVersion = new AppVersion();

    @Test
    public void testParseName() {
        // Arrange
        String amiName = "subscriberha-1.0.0-586499";
        Matcher matcher = APP_VERSION_PATTERN.matcher(amiName);

        // Act
        AppVersion parsedName = appVersion.parseName(amiName);

        // Assert
        assertEquals("subscriberha", parsedName.packageName);
        assertEquals("1.0.0", parsedName.version);
        assertNotNull(parsedName.buildJobName);
    }

    @Test
    public void testParseName_InvalidPattern() {
        // Arrange
        String amiName = "invalid-pattern";
        Matcher matcher = APP_VERSION_PATTERN.matcher(amiName);

        // Act
        AppVersion parsedName = appVersion.parseName(amiName);

        // Assert
        assertNull(parsedName);
    }

