import java.net.URI;
import java.util.ArrayList;

public class UrlGenerator {
    public static ArrayList<String> generateUrl(String basePath, String... query) throws Exception {
        if (query == null || query.length == 0) {
            return new ArrayList<>();
        }

        ArrayList<String> params = new ArrayList<>();

        for (String key : query) {
            URI uri = new URI(basePath, null, key, null);
            params.add(uri.getScheme() + "://" + uri.getHost());
            params.add(uri.getPath());
        }

        String[] fragments = new String[query.length - 2];
        for (int i = 1; i < query.length; i++) {
            URI uri = new URI(basePath, null, query[i], null);
            fragments[i - 2] = uri.getQuery();
            fragments[i - 2] += "#" + query[i + 1].replace("#", "");
        }

        return params.toArray(new String[0]);
    }

    public static void main(String[] args) throws Exception {
        ArrayList<String> urlParams1 = generateUrl("http://example.com", "param1", "value1");
        System.out.println(urlParams1);

        ArrayList<String> urlParams2 = generateUrl("/home?query=1&anotherParam=value3#frag1&anotherQuery=4", "foo", "bar");
