    static public Stock[] add(Stock[] stock, Stock s1, Stock s2) {
        Stock[] result = new Stock[stock.length + 1];
        result[0] = s1;
        for (int i = 1; i <= stock.length; i++) {
            result[i] = stock[i - 1];
        }
        System.arraycopy(s2, 0, result, stock.length + 1, stock.length);
        return result;
