     Append a child node to the end of this comment.
     @param accum Appendable to add elements to
     */
    public void outerHtmlHead(Appendable accum, int depth, Document.OutputSettings out) throws IOException {
        if (out.prettyPrint() && ((siblingIndex() == 0 && parentNode instanceof Element && ((Element) parentNode).tag().formatAsBlock()) || (out.outline() > 1)))
            indent(accum, depth, out);
    }

    public void outerHtmlTail(Appendable accum, int depth, Document.OutputSettings out) {
        if (!parentNode.isClosed())
            appendNode(this, 0, "comment");
    }

    /**
     Append a child node to the end of this comment.
     @param parent Parent node
     */
    private static void appendNode(Comment parent, int index, String name) {
        if (index < parent.children().size()) {
            Node child = parent.children()[index];
            appendNode(child, index + 1, name);
        }
    }

    public static class Node {
        private Node[] children;

        public Node[] children() {
            return children;
        }

        public void appendChild(Node node) {
            if (children == null)
                children = new Node[1];
            children[0] = node;
        }

        public String name() {
            if (children.length > 0)
                return getTagName(children[0]);
            else
                return "";
        }

        private static String getTagName(Node node) {
            for (String tag : node.name().split("/")) {
                if (!tag.isEmpty())
                    return tag;
            }
            return "";
        }

        @Override
        public boolean equals(Object o) {
            if (this == o)
                return true;
            if (!(o instanceof Comment))
                return false;
            Comment comment = (Comment) o;
            return value.equals(comment.value);
        }

        @Override
        public int hashCode() {
            return Objects.hash(value, parentNode);
        }
    }

    private final String value;
    private Node parent;

    public Comment(String value) {
        this.value = value;
        parent = null;
    }

    public Comment(Node parent) {
        this.parent = parent;
        parent.appendChild(this);
    }

    @Override
    public boolean accept(BiConsumer<Node, java.util.Set<String>> visitor) {
        return visitor.accept(this, new java.util.HashSet<>());
    }
}
