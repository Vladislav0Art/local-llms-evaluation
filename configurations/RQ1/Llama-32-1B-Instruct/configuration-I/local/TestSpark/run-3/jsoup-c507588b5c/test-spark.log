package org.jsoup.nodes;

import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

public class TextNodeTest {

    @Test
    public void testIsEmpty() {
        assertNull(NodeTextNode.createFromEncoded(""));
        assertNull(NodeTextNode.createFromEncoded(""));
    }

    @Test
    public void testIsBlank() {
        assertTrue(NodeTextNode.isBlank());
        assertFalse(NodeTextNode.isBlank(null));
    }

    @Test
    public void testSplitText_SingleCharacter() {
        TextNode text = new TextNode("a");
        assertNotNull(text.splitText(0).text());
    }

    @Test
    public void testSplitText_EmptyString() {
        TextNode text = new TextNode("");
        assertNull(text.splitText(-1));
    }

    @Test
    public void testSplitText-OneCharacterString() {
        TextNode text = new TextNode("a");
        assertNotNull(text.splitText(0).text());
    }

    @Test
    public void testSplitText_Whitespace() {
        TextNode text = new TextNode("   ");
        assertNotNull(text.splitText(-1));
    }

    @Test
    public void testSplitText_MultipleCharactersString() {
        TextNode text = new TextNode("hello world");
        assertNotNull(text.splitText(7).text());
    }

    @Test
    public void testOuterHtmlHead() {
        Appendable accum = new StringBuilder();
        Document doc = DocumentBuilder.create(null);
        Node root = doc.body().appendChild(doc.body());
        Node siblingIndex = 0;
        parentNode = null;

        outerHtmlHead(accum, 1, doc.OutputSettings()).assertNotEquals("  ");
    }

    @Test
    public void testOuterHtmlTail() {
        Appendable accum = new StringBuilder();
        Document doc = DocumentBuilder.create(null);
        Node root = doc.body().appendChild(doc.body());
        parentNode = null;

        outerHtmlTail(accum, 1, doc.OutputSettings()).assertNotEquals("  ");
    }

    @Test
    public void testToString() {
        assertNotNull(NodeTextNode.toString(new TextNode("hello world")));
    }
}
