package org.jsoup.parser;

public class GeneratedTest {

    private static final Map<String, Tag> tags = new HashMap<>();

    public static void register(Tag tag) {
        tags.put(tag.tagName, tag);
    }

    @Test
    public void testRegister() {
        // Test that the tag is registered correctly
        Tag tag = new Tag("span");
        register(tag);
        assert tags.containsKey(tag.tagName);

        tag = new Tag("img");
        register(tag);
        assert tags.containsKey(tag.tagName);
    }

    public static class Tag {

        private final String tagName;
        private boolean isBlock;
        private boolean formatAsBlock;
        private boolean preserveWhitespace;

        public Tag(String tagName) {
            this.tagName = tagName;
        }

        public void setBlock(boolean block) {
            isBlock = block;
        }

        public void setFormatAsBlock(boolean formatAsBlock) {
            formatAsBlock = formatAsBlock;
        }

        public void setPreserveWhitespace(boolean preserveWhitespace) {
            preserveWhitespace = preserveWhitespace;
        }
    }

    @Test
    public void testRegisterTag() {
        // Test that the tag name and its corresponding Tag object are registered correctly
        register(new Tag("span"));
        register(new Tag("img"));

        assert !tags.containsKey("span");
        assert !tags.containsKey("img");

        Tag tag = new Tag("span");
        assertTrue(tags.containsKey(tag.tagName));
    }

    @Test
    public void testFormatAsInlineTag() {
        // Test that the formatAsBlock flag is correctly set for inline tags
        register(new Tag("span"));
        register(new Tag("input"));

        assert !tags.get("span").formatAsBlock;
        assert !tags.get("input").formatAsBlock;

        Tag tag = new Tag("span");
        tag.formatAsBlock = true;
        assertTrue(tags.containsKey(tag.tagName));
    }

    @Test
    public void testPreserveWhitespaceTag() {
        // Test that the preserveWhitespace flag is correctly set for non-block tags
        register(new Tag("span"));
        register(new Tag("text"));

        assert !tags.get("span").preserveWhitespace;
        assert !tags.get("text").preserveWhitespace;

        Tag tag = new Tag("span");
        tag.preserveWhitespace = true;
        assertTrue(tags.containsKey(tag.tagName));
    }

    @Test
    public void testFormedListedTag() {
        // Test that the formList flag is correctly set for listed tags
        register(new Tag("button"));
        register(new Tag("select"));

        assert !tags.get("button").formList;
        assert !tags.get("select").formList;

        Tag tag = new Tag("button");
        tag.formList = true;
        assertTrue(tags.containsKey(tag.tagName));
    }

    @Test
    public void testFormSubmitTag() {
        // Test that the formSubmit flag is correctly set for submit tags
        register(new Tag("input"));
        register(new Tag("textarea"));

        assert !tags.get("input").formSubmit;
        assert !tags.get("textarea").formSubmit;

        Tag tag = new Tag("input");
        tag.formSubmit = true;
        assertTrue(tags.containsKey(tag.tagName));
    }

    @Test
    public void testEmptyTag() {
        // Test that the empty flag is correctly set for empty tags
        register(new Tag("meta"));
        register(new Tag("link"));

        assert !tags.get("meta").empty;
        assert !tags.get("link").empty;

        Tag tag = new Tag("meta");
        tag.empty = true;
        assertTrue(tags.containsKey(tag.tagName));
    }

    @Test
    public void testFormatAsInlineTags() {
        // Test that the formatAsBlock flag is correctly set for inline tags in formatAsInlineTag method
        register(new Tag("span"));
        register(new Tag("input"));

        assert !tags.get("span").formatAsBlock;
        assert !tags.get("input").formatAsBlock;

        Tag tag = new Tag("span");
        tag.formatAsBlock = true;
        assertTrue(tags.containsKey(tag.tagName));
    }

