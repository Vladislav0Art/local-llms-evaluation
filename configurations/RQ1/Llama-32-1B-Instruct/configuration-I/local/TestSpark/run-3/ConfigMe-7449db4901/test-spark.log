public class MyTest {
    public static String testString() {
        return "This is a string test";
    }

    public static int testInt(int value) {
        return value * 2;
    }

    public static double testDouble(double value) {
        return value + 5.0;
    }

    public static void printInts(int[] array, String prefix) {
        for (int i : array) {
            System.out.print(prefix + i + " ");
        }
        System.out.println();
    }

    public static int sumOfArray(int[] array) {
        int total = 0;
        for (int i : array) {
            total += i;
        }
        return total;
    }

    public static boolean isStringNull(String string) {
        return string == null || string.isEmpty();
    }

    public static void printTable(int[][] table, String[] headers) {
        System.out.println("  " + headers[0]);
        for (int i = 1; i < headers.length; i++) {
            System.out.print(headers[i] + " ");
        }
        System.out.println();

        for (int i = 0; i < table.length; i++) {
            for (int j = 0; j < table[i].length; j++) {
                if (i == j) {
                    System.out.printf("%5d", table[i][j]);
                } else {
                    System.out.print("%8s ", headers[j] + " ");
                }
            }

            System.out.println();
        }
    }
}
```
