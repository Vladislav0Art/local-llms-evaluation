import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.select.Elements;

public class DocumentGenerator {

    public static Document generateDocument(String htmlString) {
        return Jsoup.parse(htmlString);
    }

    public static String generateText(String text) {
        return text;
    }

    public static void main(String[] args) {
        String html = "<html><body>Hello <b>World!</b></body></html>";
        Document doc = generateDocument(html);

        Element root = doc.body();
        Elements paragraphs = root.getElementsByTag("p");
        for (Element paragraph : paragraphs) {
            System.out.println(paragraph.text());
        }
    }

    public static String createFromEncoded(String encodedText) {
        return encodedText;
    }
}
