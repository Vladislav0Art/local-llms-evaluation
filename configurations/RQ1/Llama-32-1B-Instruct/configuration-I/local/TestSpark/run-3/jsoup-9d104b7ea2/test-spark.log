```java
import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;

public class Main {
    public static void main(String[] args) {
        String html = "<html><body>Hello <b>World!</b></body></html>";

        // Create a new HTML document from scratch
        Document doc = Jsoup.parse(html);

        // Get the text content of all elements, including HTML tags
        String textContent = "";
        for (Element element : doc.getAllElements()) {
            if (element instanceof Element) {
                textContent += ((Element) element).text();
            } else {
                textContent += element.toString();
            }
        }

        // Print out the resulting plain text
        System.out.println("Text Content:");
        System.out.println(textContent);
    }
}
```
