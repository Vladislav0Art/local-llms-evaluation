public class UrlBuilderTest {
    
    private UrlBuilder underTest;

    @Before
    void setUp() {
        String inputUrl = "http://example.com/path?query=abc";
        URL u = new URL(inputUrl);
        this.underTest = new UrlBuilder(u);
    }

    TestUrlBuilder[MethodUnderTest]Test01_UrlNormalizesURL()Test{
        return () -> {
            URL u = underTest.build();
            String expectedUrl = "http://example.com/path%3Fquery=abc";
            assert u.getProtocol().equals("http");
            assert u.getHost().equals("example.com");
            assert u.getPort() == 80;
            assert u.getPath().equals(expectedUrl);
            return null;
        };
    }

    TestUrlBuilder[MethodUnderTest]Test01_UrlQuotesAndSymbols()Test{
        String inputUrl = "http://example.com/path?query='abc'!";
        URL u = new URL(inputUrl);
        underTest = new UrlBuilder(u);
        return () -> {
            URL normalizedUrl = underTest.build();
            assert normalizedUrl.getProtocol().equals("http");
            assert normalizedUrl.getHost().equals("example.com");
            assert normalizedUrl.getPort() == 80;
            assert normalizedUrl.getPath().equals("path?query=abc!");
            assert normalizedUrl.getQuery().contains("abc");
            return null;
        };
    }

    TestUrlBuilder[MethodUnderTest]Test01_UrlMultipleQuotas()Test{
        String inputUrl = "http://example.com/path?query=abc#fragment";
        URL u = new URL(inputUrl);
        underTest = new UrlBuilder(u);
        return () -> {
            URL normalizedUrl = underTest.build();
            assert normalizedUrl.getProtocol().equals("http");
            assert normalizedUrl.getHost().equals("example.com");
            assert normalizedUrl.getPort() == 80;
            assert normalizedUrl.getPath().equals("path?query=abc#fragment");
            assert !normalizedUrl.getQuery().isEmpty();
            return null;
        };
    }

    TestUrlBuilder[MethodUnderTest]Test01_UrlPathEscapes()Test{
        String inputUrl = "http://example.com/path;abc";
        URL u = new URL(inputUrl);
        underTest = new UrlBuilder(u);
        return () -> {
            URL normalizedUrl = underTest.build();
            assert normalizedUrl.getProtocol().equals("http");
            assert normalizedUrl.getHost().equals("example.com");
            assert normalizedUrl.getPort() == 80;
            assert normalizedUrl.getPath().equals("path%3Babc");
            assert !normalizedUrl.getQuery().isEmpty();
            return null;
        };
    }

    TestUrlBuilder[MethodUnderTest]Test02_UrlEncoding()Test{
        String inputUrl = "http://example.com/path?query=abc!";
        URL u = new URL(inputUrl);
        underTest = new UrlBuilder(u);
        return () -> {
            URL normalizedUrl = underTest.build();
            assert normalizedUrl.getProtocol().equals("http");
            assert normalizedUrl.getHost().equals("example.com");
            assert normalizedUrl.getPort() == 80;
            assert normalizedUrl.getPath().equals("path?query=abc!");
            String expectedEncodedPath = "path%3Fquery=abc";
            assert normalizedUrl.getPath().startsWith(expectedEncodedPath);
            return null;
        };
    }
}
