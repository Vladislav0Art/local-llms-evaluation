    public static void assertTrue(boolean condition) {
        if (!condition) {
            throw new AssertionError("Expected " + condition);
        }
    }

    public static int add(int a, int b) {
        return a + b;
    }

    public static String toString(Object obj) {
        return obj.toString();
    }

    // Test methods
    public static void main(String[] args) {
        TestUtils test = new TestUtils();

        // Null checks
        System.out.println("Testing null: " + isNull(null));
        assertTrue(test.isNull(""));  // empty string
        assertTrue(test.isNull(123));  // integer

        // Basic operations
        int sum = add(10, 5);
        assertEquals(15, sum);

        String str = toString(new Object());
        System.out.println(str);  // prints: "123"

        try {
            test.fail("expected a boolean to be true");
        } catch (AssertionError e) {
            System.out.println(e.getMessage());  // prints: "Expected NullPointerException" or similar
        }

        assertTrue(test.isNull(null));

        // Test method with multiple assertions
        assertTrue(str.length() > 0);
        assertEquals(10, add(5, 5));
    }
}
```

