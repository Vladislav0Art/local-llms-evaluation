public class OnlineStockSpan {
  public static int[] calculateSpans(int[] prices) {
    if (prices.length < 2) {
      return new int[0];
    }

    int[] result = new int[prices.length - 1];
    for (int i = 1; i < prices.length; i++) {
      int span = 1;
      while (i > 1 && prices[i] >= prices[i - 1]) {
        span += 1;
        i -= 1;
      }
      result[i - 2] = span;
    }

    return result;
  }
}

