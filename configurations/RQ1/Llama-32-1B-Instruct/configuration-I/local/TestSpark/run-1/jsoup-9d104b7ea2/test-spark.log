public class Main {

    public static void main(String[] args) {
        // Test 1: Create a new text node from HTML encoded data
        String encodedText = "<script>alert('Hello, World!')</script>";
        TextNode createdNode = TextNode.createFromEncoded(encodedText);
        System.out.println("Created Node Value: " + createdNode.value);

        // Test 2: Split the text into two nodes at a specific offset
        int offset = 6;  // index of 'W'
        TextNode createdNode1 = createdNode.splitText(offset);
        System.out.println("Split Node 1 Value: " + createdNode1.value);

        // Test 3: Create an empty node and test if it's blank
        String blankText = "<script>var x = &quot;&amp;&amp;quot;;</script>";
        TextNode blankNode = TextNode.createFromEncoded(blankText);
        System.out.println("Is Blank Node Value: " + blankNode.isBlank());

        // Test 4: Create a text node from HTML encoded data
        String originalText = "Hello, <b>World!</b>";
        TextNode createdNode2 = TextNode.createFromEncoded(originalText);
        System.out.println("Created Node Value: " + createdNode2.value);

        // Test 5: Get the text value of an existing node
        TextNode node = new TextNode("<script>alert('Hello, World!');</script>");
        String originalText = "This is a test.";
        String nodeValue = node.text(originalText);
        System.out.println("Node Value: " + nodeValue);

        // Test 6: Split a text node at an offset
        int splitOffset = 10;
        TextNode createdNode3 = node.splitText(splitOffset);
        System.out.println("Split Node Value: " + createdNode3.value);

        // Test 7: Create and add children to a text node
        String parentHtml = "<div><p>This is a paragraph.</p></div>";
        Appendable appendable = new StringBuilder(parentHtml).append("<br>");
        TextNode parentNode = new TextNode(appendable.toString());
        parentNode.siblingIndex += 1;
        parentNode.addChildren(0, new TextNode("This is a child."));
        TextNode siblingNode = parentNode.splitText(2);
        System.out.println("Parent Node Value: " + parentNode.value);
        System.out.println("Sibling Node Value: " + siblingNode.value);

        // Test 8: Remove the first node from a text node's children
        TextNode parentNode2 = new TextNode("<script>alert('Hello, World!');</script>");
        parentNode2.siblingIndex -= 1;
        parentNode2.addChildren(0, new TextNode("This is a child."));
        parentNode2.removeFirst();
        System.out.println("Parent Node Value: " + parentNode2.value);

        // Test 9: Create a text node from HTML encoded data with entities
        String originalHtml = "<script>var x = &quot;&amp;&amp;quot;;</script>";
        TextNode createdNode4 = TextNode.createFromEncoded(originalHtml);
        System.out.println("Created Node Value: " + createdNode4.value);

        // Test 10: Print all nodes in the document
        Document document = new Document();
        TextNode root = document.getDocumentElement();
        printNodes(root, "", document, true);
    }

    private static void printNodes(Appendable appendable, String indent, Document outputSettings, boolean prettyPrint) {
        if (indent.isEmpty()) {
            return;
        }
        appendable.append("\n");
        appendable.append(indent).append("  ");
        if (prettyPrint) {
            System.out.print(outputSettings.getIndent());
        }
        for (int i = 0; i < outputSettings.getDefaultIndent(); i++) {
            appendable.append("  ");
        }
        for (Node node : document.childNodes()) {
            printNodes(appendable, indent + "\n", outputSettings, prettyPrint);
        }
    }

    private static void printNodes(Appendable appendable) {
        appendable.append("\n");
        appendable.append("  ");
        if (prettyPrint) {
