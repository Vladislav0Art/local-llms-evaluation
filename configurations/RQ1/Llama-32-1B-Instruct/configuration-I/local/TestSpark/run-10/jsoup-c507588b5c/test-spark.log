    /**
     * Splits a string into substrings at specified offsets.
     *
     * @param str         the input string
     * @param offset      the initial offset (inclusive)
     * @return array of strings split by the given offset
     */
    public static String[] splitText(String str, int offset) {
        if (offset >= str.length()) {
            return new String[0];
        }
        StringBuilder sb = new StringBuilder(str);
        for (int i = 1; i < offset; i++) {
            if (sb.charAt(i) == sb.charAt(offset - 1)) {
                sb.deleteCharAt(offset - 1);
            } else {
                break;
            }
        }
        return new String[]{str.substring(0, offset), sb.toString()};
    }

