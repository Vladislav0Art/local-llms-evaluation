Here's a simple implementation:

```java
public class Main {
    public static void main(String[] args) {
        String str = "Hello, World!";
        int offset1 = 0;
        int offset2 = 7; // The actual splitting point
        System.out.println(splitText(str, offset1));
        System.out.println(splitText(str, offset2));
    }

    /**
     * Splits a string into substrings at specified offsets.
     *
     * @param str         the input string
     * @param offset      the initial offset (inclusive)
     * @return array of strings split by the given offset
     */
    public static String[] splitText(String str, int offset) {
        if (offset >= str.length()) {
            return new String[0];
        }

        // Calculate the actual splitting point for the second offset
        int actualOffset = offset < str.length() ? offset : str.length();

        // Split the string into two substrings
        String[] result = split(str, actualOffset);

        return result;
    }

    /**
     * Splits a string into two substrings at specified offsets.
     *
     * @param str         the input string
     * @param actualOffset the actual splitting point for the second offset
     * @return array of strings split by the given offset
     */
    public static String[] split(String str, int actualOffset) {
        if (actualOffset >= str.length()) {
            return new String[0];
        }

        // Initialize variables to store the substrings
        StringBuilder sb1 = new StringBuilder();
        StringBuilder sb2 = new StringBuilder();

        // Split the string into two substrings at each offset
        for (int i = 0; i < actualOffset; i++) {
            if (sb1.length() == 0 || str.charAt(i) != sb1.charAt(sb1.length() - 1)) {
                sb1.append(str.charAt(i));
            }
            if (str.charAt(actualOffset + i) != sb2.charAt(0)) {
                sb2.append(str.charAt(actualOffset + i));
            }
        }

        // Return the two substrings
        return new String[]{sb1.toString(), sb2.toString()};
    }

    public static class TextNode {
        private String text;

        public TextNode(String text) {
            this.text = text;
        }

        @Override
        public boolean equals(Object obj) {
            if (this == obj)
                return true;
            if (obj == null || getClass() != obj.getClass())
                return false;
            TextNode other = (TextNode) obj;
            return text.equals(other.text);
        }

        @Override
        public int hashCode() {
            return Objects.hash(text);
        }
    }
}
