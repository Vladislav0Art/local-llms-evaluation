import org.junit.Test;
import static org.mockito.Mockito.*;
import java.io.ByteArrayInputStream;

public class TextNodeTest {

    @Test
    public void testBlank() {
        Node parentNode = mock(Node);
        TextNode node = new TextNode("   \n  ");
        when parentNode.getWholeText()).thenReturn("");
        assertNodeIsBlank(node, parentNode);
    }

    @Test
    public void testSplit() {
        Node parentNode = mock(Node);
        String text = "Hello World";
        when parentNode.getWholeText()).thenReturn(text);
        TextNode node = new TextNode(splitText(5));
        when(node.text("Hello World")).thenReturn("World");
        when(node.splitText(5)).thenReturn(new TextNode("World"));
        when(parentNode.addChildren(1, node)).thenReturn(node);

        Node expected = new TextNode("\n  \nHello\n  World");
        Node actual = parentNode.addChild(1, node);
        Assert.assertTrue(actual instanceof TextNode);
        Assert.assertEquals(expected, (TextNode) actual);
    }

    @Test
    public void testFromEncoded() {
        String encodedText = "&lt;Hello&gt;";
        TextNode node = TextNode.createFromEncoded(encodedText);
        assertEquals("Hello", node.text());
    }

    @Test
    public void testToString() {
        Node parentNode = mock(Node);
        when(parentNode.getWholeText()).thenReturn("   \n  ");
        TextNode node = new TextNode("   \n  ");
        when(node.text("   \n  ")).thenReturn("   \n  ");
        when(parentNode.addChildren(1, node)).thenReturn(node);

        String expected = "   \n  ";
        assertEquals(expected, (TextNode) parentNode.addChild(1, node).toString());
    }

    @Test
    public void testTrimming() {
        Node parentNode = mock(Node);
        TextNode node = new TextNode("   \n  ");
        when(node.text("   \n  ")).thenReturn("World");
        when(node.splitText(5)).thenReturn(new TextNode("World"));
        when(parentNode.addChildren(1, node)).thenReturn(node);

        Node expected = new TextNode("\n\nHello\nWorld");
        Node actual = parentNode.addChild(1, node);
        Assert.assertTrue(actual instanceof TextNode);
        Assert.assertEquals(expected, (TextNode) actual);
    }

    @Test
    public void testCreateFromEncodedTrimming() {
        String encodedText = "&lt;Hello&gt;";
        TextNode node = TextNode.createFromEncoded(encodedText);
        assertEquals("Hello", node.text());
    }
}
