        TestUtils.test1();
        TestUtils.test2();
        // Add more tests here...
    }

    private static void test1() {
        System.out.println(generateUrl("http", 8080, "localhost"));
        try {
            generateUrl("https", 443, "example.com");
            throw new RuntimeException("Shouldn't be able to generate an error");
        } catch (Exception e) {
            System.out.println(e.getMessage());
        }
    }

    private static void test2() {
        String url = generateUrl("http", 8080, "localhost");
        try {
            URL expected = new URL("https://example.com");
            if (!url.equals(expected)) {
                throw new RuntimeException();
            }
        } catch (Exception e) {
            System.out.println(e.getMessage());
        }

        try {
            URL expected2 = generateUrl("http", 8081, "localhost");
