import java.util.HashMap;
import java.util.Map;

public class Tag {

    private final String tagName;
    private boolean isBlock;
    private boolean formatAsInline;
    private boolean preserveWhitespace;
    private boolean formListed;
    private boolean formSubmit;

    public Tag(String tagName) {
        this.tagName = tagName;
        this.isBlock = false;
        this.formatAsInline = false;
        this.preserveWhitespace = true;
        this.formListed = false;
        this.formSubmit = false;
    }

    public void setIsBlock(boolean isBlock) {
        this.isBlock = isBlock;
    }

    public void setFormatAsInline(boolean formatAsInline) {
        this.formatAsInline = formatAsInline;
    }

    public void setPreserveWhitespace(boolean preserveWhitespace) {
        this.preserveWhitespace = preserveWhitespace;
    }

    public void setFormListed(boolean formListed) {
        this.formListed = formListed;
    }

    public void setFormSubmit(boolean formSubmit) {
        this.formSubmit = formSubmit;
    }

    public String getTagName() {
        return tagName;
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;

        Tag tag = (Tag) o;

        if (!isBlock && !formatAsInline && !preserveWhitespace && !formListed && !formSubmit) {
            return tagName.equals(tag.tagName);
        }

        return false;
    }

    @Override
    public int hashCode() {
        int result = tagName.hashCode();
        result = 31 * result + (isBlock ? 1 : 0);
        result = 31 * result + (formatAsInline ? 2 : 0);
        result = 31 * result + (preserveWhitespace ? 4 : 0);
        result = 31 * result + (formListed ? 8 : 0);
        result = 31 * result + (formSubmit ? 16 : 0);
        return result;
    }

    @Override
    public String toString() {
        StringBuilder sb = new StringBuilder();
        switch (isBlock) {
            case true:
                sb.append("block ");
                break;
            default:
                sb.append("inline ");
                break;
        }
        sb.append(tagName).append("").append(formatAsInline ? " formatAsInline=" + formatAsInline : " formatAsInline=false");
        if (!preserveWhitespace && !formListed) {
            sb.append(" preserveWhitespace=");
            if (formSubmit) {
                sb.append(" true");
            } else {
                sb.append(" false");
            }
        }
        return sb.toString();
    }

    public static Tag getTag(String tagName) {
        Map<String, Tag> map = new HashMap<>();
        for (Map.Entry<String, Tag> entry : tagMap.entrySet()) {
            if (entry.getValue().getTagName().equals(tagName)) {
                return entry.getValue();
            }
        }
        return null;
    }

    private static class TagCache implements java.util.Map<String, Tag> {

        @Override
        public boolean containsKey(String key) {
            return tagMap.containsKey(key);
        }

        @Override
        public boolean containsValue(Tag value) {
            for (Tag t : tagMap.values()) {
                if (t == value) {
                    return true;
                }
            }
            return false;
        }

        private Map<String, Tag> tagMap = new HashMap<>();

        @Override
        public void put(String key, Tag value) {
            tagMap.put(key, value);
        }

        @Override
        public boolean remove(Object o) {
            if (o instanceof Map.Entry) {
                String key = ((Map.Entry)o).getKey();
                return tagMap.remove(key) != null;
            }
            throw new RuntimeException("not supported");
        }
    }
}
