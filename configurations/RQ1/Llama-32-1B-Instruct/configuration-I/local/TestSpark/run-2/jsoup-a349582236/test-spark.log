    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;

        Tag tag = (Tag) o;

        if (!isBlock && !formatAsInline && preserveWhitespace && formListed && formSubmit) {
            return tagName.equals(tag.tagName);
        }

        return false;
    }

