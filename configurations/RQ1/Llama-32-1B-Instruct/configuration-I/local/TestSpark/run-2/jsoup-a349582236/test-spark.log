    static class TagCache implements java.util.Map<String, Tag> {

        @Override
        public boolean containsKey(String key) {
            return values().stream()
                    .anyMatch(t -> t.tagName.equals(key));
        }

        @Override
        public boolean containsValue(Tag value) {
            for (Tag tag : values()) {
                if (tag == value) {
                    return true;
                }
            }
            return false;
        }

        @Override
        public Tag get(String key) {
            for (Tag t : values()) {
                if (t.tagName.equals(key)) {
                    return t;
                }
            }
            return null;
        }

        private List<Tag> values() {
            return Arrays.asList(this);
