        result = 31 * result + (formatAsInline ? 2 : 0);
        result = 31 * result + (preserveWhitespace ? 4 : 0);
        result = 31 * result + (formListed ? 8 : 0);
        result = 31 * result + (formSubmit ? 16 : 0);
        return result;
