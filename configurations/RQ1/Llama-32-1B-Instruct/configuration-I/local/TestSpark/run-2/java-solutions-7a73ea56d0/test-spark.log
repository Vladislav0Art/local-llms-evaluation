public class OnlineStockSpanTest {

    @Test
    public void test_next_PricingPriceLessThanCurrent() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        onlineStockSpan.list = new ArrayList<>();
        onlineStockSpan.next(1);
        onlineStockSpan.next(2);

        assertEquals(3, onlineStockSpan.next(4));
    }

    @Test
    public void test_next_PricingPriceEqualsCurrent() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        onlineStockSpan.list = new ArrayList<>();
        onlineStockSpan.next(1);
        onlineStockSpan.next(2);

        assertEquals(3, onlineStockSpan.next(4));
    }

    @Test
    public void test_next_PricingPriceGreaterThanCurrent() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        onlineStockSpan.list = new ArrayList<>();
        onlineStockSpan.next(1);
        onlineStockSpan.next(2);

        assertEquals(3, onlineStockSpan.next(3));
    }

    @Test
    public void test_calculateSpans_PricingArrayWithOneElement() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int[] prices = {100};
        int[] expectedSpans = {1};

        Object[] actualSpans = onlineStockSpan.calculateSpans(prices);
        assertArrayEquals(expectedSpans, actualSpans);
    }

    @Test
    public void test_calculateSpans_PricingArrayWithMultipleElements() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int[] prices = {10, 20, 30};
        int[] expectedSpans = {1, 1, 2};

        Object[] actualSpans = onlineStockSpan.calculateSpans(prices);
        assertArrayEquals(expectedSpans, actualSpans);
    }

    @Test
    public void test_calculateSpans_PricingArrayWithNegativeNumbers() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int[] prices = {-10, 20, -30};
        int[] expectedSpans = {1, 2, 3};

        Object[] actualSpans = onlineStockSpan.calculateSpans(prices);
        assertArrayEquals(expectedSpans, actualSpans);
    }

    @Test
    public void test_calculateSpans_PricingArrayWithFloatValues() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        double[] prices = {10.0, 20.0, 30.0};
        int[] expectedSpans = {1, 2, 3};

        Object[] actualSpans = onlineStockSpan.calculateSpans(prices);
        assertArrayEquals(expectedSpans, actualSpans);
    }
}
