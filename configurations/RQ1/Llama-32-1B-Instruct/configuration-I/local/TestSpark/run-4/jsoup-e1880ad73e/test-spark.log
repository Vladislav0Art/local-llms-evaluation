        System.out.println(buildUrl("http://example.com", params1));
        
        Map<String, Object> params2 = new HashMap<>();
        System.out.println(buildUrl("/path/to/resource", params2));
        
        Map<String, Object> params3 = new HashMap<>();
        params3.put("param1", "value1");
        System.out.println(buildUrl("http://example.com", params3));
