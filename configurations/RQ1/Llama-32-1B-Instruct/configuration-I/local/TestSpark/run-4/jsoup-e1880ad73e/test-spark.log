public class Main {
    public static String buildUrl(String basePath, Map<String, Object> params) {
        StringBuilder sb = new StringBuilder(basePath);
        
        if (params == null || params.isEmpty()) {
            return "";
        }
        
        for (Map.Entry<String, Object> entry : params.entrySet()) {
            sb.append("/").append(entry.getKey()).append("/")
                    .append(entry.getValue());
            
            if (sb.length() > basePath.length()) {
                sb.deleteCharAt(sb.length() - 1);
            }
        }
        
        return sb.toString();
    }

    public static void main(String[] args) {
        // Tests for url builder
        System.out.println(buildUrl("http://example.com", "path/to/resource"));  
        System.out.println(buildUrl("http://example.com", "/path/to/resource")); 
        System.out.println(buildUrl("/path/to/resource", "path/to/resource"));
        
