    public static void main(String[] args) throws Exception {
        Map<String, Object> paramsRef1 = new HashMap<>();
        paramsRef1.put("id", "param-001");
        paramsRef1.put("title", "Example Parameters 1");

        URI baseUri1 = new URI("http://example.com/path?query=param-value#anchor");
        URI absoluteUri1 = new URI("/absolute/path?query=param-value#anchor");

        System.out.println(getUrl(baseUri1, paramsRef1));
        System.out.println(getUrl(absoluteUri1, paramsRef1));

        Document doc1 = new Document("doc-001", "Example Document 1");
        String htmlString1 = getHtmlString(doc1);
        System.out.println(htmlString1);

        System.out.println(getUrl(new URI("/path?query=param-value"), doc1));
    }

    private static String getHtmlString(Document document) {
        return "<html><body>" + document.getTitle() + "</body></html>";
    }

    private static String getUrl(URI uri, Map<String, Object> params) throws Exception {
        StringBuilder html = new StringBuilder();
        for (Map.Entry<String, String> entry : params.entrySet()) {
            if ("id".equals(entry.getKey())) {
                html.append("<a href=\"").append(uri.getPath()).append("\"").append(">").append(entry.getValue()).append("</a>");
            } else {
                html.append("<div><a href=\"").append(uri.getPath()).append("\"").append(">").append(entry.getValue()).append("</a></div>");
            }
        }

        return "<html><body><h1>" + uri.getHost() + "</h1><p>" + html.toString() + "</p></body></html>";
    }
}

class Document {
    private String id;
    private String title;

    public Document(String id, String title) {
        this.id = id;
        this.title = title;
    }

    public String getId() {
        return id;
    }

    public String getTitle() {
        return title;
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;

        Document document = (Document) o;

        if (!id.equals(document.id)) return false;
        if (!title.equals(document.title)) return false;

        return true;
    }

    @Override
    public int hashCode() {
        return Objects.hash(id, title);
    }
}

