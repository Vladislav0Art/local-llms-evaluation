import java.util.Map;

public class DocumentTest {
    public static void main(String[] args) throws Exception {
        Map<String, Object> data = new HashMap<>();
        Map<String, String> documentRef1 = new HashMap<>();
        documentRef1.put("id", "doc-001");
        documentRef1.put("title", "Example Document 1");

        Map<String, String> fragmentRef2 = new HashMap<>();
        fragmentRef2.put("id", "frag-002");
        fragmentRef2.put("text", "This is a sample fragment.");

        Map<String, Object> paramsRef3 = new HashMap<>();
        paramsRef3.put("id", "param-001");
        paramsRef3.put("title", "Example Parameters 1");

        URI baseUri = new URI("http://example.com/path?query=param-value");
        URI absoluteUri = new URI("/absolute/path?query=param-value#anchor");

        System.out.println(getUrl(baseUri, documentRef1));
        System.out.println(getUrl(absoluteUri, fragmentRef2));
        System.out.println(getUrl(absoluteUri, paramsRef3));

        Document doc = new Document("doc-001", "Example Document 1");
        String htmlString = getHtmlString(doc);
        System.out.println(htmlString);

        System.out.println(getUrl(new URI("/path?query=param-value"), documentRef1));
        System.out.println(getUrl(absoluteUri, fragmentRef2));
        System.out.println(getUrl(absoluteUri, paramsRef3));

        System.out.println(getUrl(new URI("http://example.com/absolute/path?query=param-value#anchor"), doc));
    }

    private static String getHtmlString(Document document) {
        return "<html><body>" + document.getTitle() + "</body></html>";
    }

    private static String getUrl(URI uri, Map<String, Object> params) throws Exception {
        StringBuilder html = new StringBuilder();
        for (Map.Entry<String, String> entry : params.entrySet()) {
            if ("id".equals(entry.getKey())) {
                html.append("<a href=\"").append(uri.getPath()).append("\"").append(">").append(entry.getValue()).append("</a>");
            } else {
                html.append("<div><a href=\"").append(uri.getPath()).append("\"").append(">").append(entry.getValue()).append("</a></div>");
            }
        }

        return "<html><body><h1>" + uri.getHost() + "</h1><p>" + html.toString() + "</p></body></html>";
    }
}

class Document {
    private String id;
    private String title;

    public Document(String id, String title) {
        this.id = id;
        this.title = title;
    }

    public String getId() {
        return id;
    }

    public String getTitle() {
        return title;
    }
}
