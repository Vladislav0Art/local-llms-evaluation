**JavaScript Code**
```javascript
function parse(str) {
  const doc = new Document();
  const header = document.getElementById("header");
  header.textContent = str;
  return doc;
}

function toString(doc, node) {
  if (node instanceof TagElement && ((TagElement) node).name().equals("p")) {
    const paragraphs = Array.from(node.children("p"));
    for (const paragraph of paragraphs) {
      const text = paragraph.text();
      if (!text.trim().isEmpty()) {
        console.log(text);
      }
    }
  } else if (node instanceof TextElement && ((TextElement) node).text().trim() === str) {
    return 1;
  }

  return 0;
}
```

**Main Function**
```java
public static void main(String[] args) {
  String result = toString(parse("Hello, world!"), parse("<p>Hello, world!</p>"));
  System.out.println(result);
}
```

