package org.jsoup.nodes;

import java.io.IOException;
import java.text.Normalizer;
import java.util.HashSet;
import java.util.Set;

import org.junit.Test;
import org.jsoup.nodes.Node;
import org.jsoup.nodes.TextNode;
import org.mockito.Mock;
import org.mockito.Mockito;

public class TextNodeTest {

    @Mock
    private Node parentNode;

    @Mock
    private Document document;

    @Test
    public void testIsBlank() {
        TextNode node = Mockito.mock(TextNode.class);
        when(node.getText()).thenReturn("");
        whenparentNode.getChildren().thenReturn(new HashSet<>());
        assertTrue(TestUtils.isBlank(node));
    }

    @Test
    public void testTextSplit() {
        String text = "Hello, world!";
        TextNode node = Mockito.mock(TextNode.class);
        whenNode.setText(text).thenReturn(node);

        TextNode result1 = TestUtils.splitText(5, node);
        Node sibling1 = result1.getSibling();
        Node nextSibling2 = parentNode.getNextSibling();

        if (nextSibling2 != null) {
            assertEquals(sibling1, nextSibling2);
        }

        node.setText("");
        TextNode result2 = TestUtils.splitText(5, node);
        Node sibling3 = result2.getSibling();
        Node nextSibling4 = parentNode.getNextSibling();

        if (nextSibling4 != null && !sibling3.equals(nextSibling4)) {
            throw new AssertionError("Wrong sibling for second split");
        }
    }

    @Test
    public void testTextSplitEmptyString() {
        String text = "";
        TextNode node = Mockito.mock(TextNode.class);
        whenNode.setText(text).thenReturn(node);

        TextNode result1 = TestUtils.splitText(5, node);
        Node sibling1 = result1.getSibling();
        Node nextSibling2 = parentNode.getNextSibling();

        if (nextSibling2 != null) {
            assertEquals(sibling1, nextSibling2);
        }

        node.setText("");
        TextNode result2 = TestUtils.splitText(5, node);

        TextNode result3 = TestUtils.splitText(0, node);
        Node sibling4 = result3.getSibling();
        Node nextSibling5 = parentNode.getNextSibling();

        if (nextSibling5 != null) {
            assertEquals(sibling4, nextSibling5);
        }
    }

    @Test
    public void testTextSplitWhitespace() {
        TextNode node = Mockito.mock(TextNode.class);
        whenNode.setText("   Hello  world!  ");
        when(node.getText()).thenReturn("Hello  world!");
        whenparentNode.getChildren().thenReturn(new HashSet<>());

        TextNode result1 = TestUtils.splitText(2, node);

        Node sibling1 = result1.getSibling();
        Node nextSibling2 = parentNode.getNextSibling();

        if (nextSibling2 != null && !sibling1.equals(nextSibling2)) {
            throw new AssertionError("Wrong sibling for second split");
        }

        Node previousSibling3 = parentNode.getPreviousSibling();
        node.setText("");
        TextNode result4 = TestUtils.splitText(2, node);

        Node sibling5 = result4.getSibling();

        if (sibling5 != null && !previousSibling3.equals(sibling5)) {
            throw new AssertionError("Wrong sibling for second split");
        }
    }

    @Test
    public void testGetWholeText() {
        TextNode node = Mockito.mock(TextNode.class);
        whenNode.setText("Hello, world! ");
        when(node.getText()).thenReturn("Hello, world!");

        Node previousSibling = parentNode.getPreviousSibling();
        Node sibling1 = node.getSibling();

        assertEquals(sibling1, previousSibling);

        node.setText("");
        String result = TestUtils.getWholeText(node);
        assertEquals("Hello, world!", result);
    }

    @Test
    public void testToString() {
        TextNode node = Mockito.mock(TextNode.class);
        whenNode.setText("");
        when(node.getText()).thenReturn("");

        String result1 = node.toString();
        assertTrue(result1.isEmpty());

        node.setText("<p>Hello, world!</p>");
        String result2 = node.toString();
        assertEquals("<p>Hello, world!</p>", result2);
    }

    @Test
    public void testClone() {
        TextNode node = Mockito.mock(TextNode.class);
        whenNode.getText().toString().equals("");

        TextNode clone1 = (TextNode) TestUtils.clone(node).clone();
        Node previousSibling = parentNode.getPreviousSibling();
        Node sibling2 = clone1.getSibling();

        assertTrue(sibling1.equals(previousSibling));
    }
}
