```java
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.select.Elements;

public class GeneratedTest {

    private String str = "Hello, world!";

    public Document parse(String str) {
        return new Document();
    }

    public int toString(Document doc, Node node) {
        if (node instanceof TagElement && ((TagElement) node).name().equals("p")) {
            Elements paragraphs = ((TagElement) node).children("p");
            for (Element paragraph : paragraphs) {
                String text = paragraph.text().trim();
                if (!text.isEmpty()) {
                    System.out.println(text);
                }
            }
        } else if (node instanceof TextElement && ((TextElement) node).text().trim().equals(str)) {
            return 1;
        }

        return 0;
    }

    public static void main(String[] args) {
        GeneratedTest generatedTest = new GeneratedTest();

        // Test case 1
        String result = generatedTest.toString(generatedTest.parse("Hello, world!"), generatedTest.parse(generatedTest.document));
        System.out.println(result);

        // Test case 2
        result = generatedTest.toString(generatedTest.parse("This is another paragraph."), generatedTest.parse(generatedTest.document));

        // Test case 3
        result = generatedTest.toString(generatedTest.parse(10), generatedTest.parse(generatedTest.document));

        // Test case 4
        result = generatedTest.toString(generatedTest.parse("10"), generatedTest.parse(generatedTest.document));
    }
}
