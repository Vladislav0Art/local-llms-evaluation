```java
public class BinaryTreeGenerator {
    public static void generateTree(String root, String tree) {
        if (root == null || tree.isEmpty()) return;
        
        // Find the index of the first occurrence of '->' in the tree string
        int startIndex = tree.indexOf("->");
        
        // If no '->' is found, set the text to 'null'
        String newText = tree.substring(0, startIndex);
        if (newText.isEmpty()) {
            root.setText(null);
            return;
        }

        // Recursively generate the left and right subtrees
        new BinaryTreeGenerator().generateTree(root.left, tree.substring(startIndex + 2));
        new BinaryTreeGenerator().generateTree(root.right, tree.substring(startIndex + 2));

        // Insert '->' into the root node's text
        if (root.getText() == null) {
            root.setText(newText);
        } else {
            root.setText(newText + "->" + root.getText());
        }
    }

    public static void testBinaryTreeGeneration() {
        BinaryTreeGenerator.root = new BinaryTreeGenerator();
        String tree = "";
        
        generateTree(root, "");
        
        System.out.println("Root: " + root.getText());

        // Add more nodes to the tree
        root.addNode("a", null);
        root.addNode("b", null);
        root.addNode("c", null);

        System.out.println("\n\nTree after adding 'x' nodes:");
        generateTree(root, "");
        
        System.out.println("Root: " + root.getText());
    }

    private static class BinaryTreeGenerator {
        String text;
        Node left;
        Node right;

        public BinaryTreeGenerator() {
            this.text = "";
            this.left = null;
            this.right = null;
        }

        // Append a node to the binary tree
        void appendNode(String value, String node) {
            if (node.isEmpty()) return;

            text += "(" + value + ")";
            left = new Node(value);
            right = new Node(node);
        }

        public String getText() {
            return text;
        }
    }

    private static class OutputSettings {
        // TO DO: implement appendString
    }
}

