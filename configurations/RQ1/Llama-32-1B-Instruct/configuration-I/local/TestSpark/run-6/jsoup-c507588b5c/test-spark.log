```java
import java.util.*;

class Node {
    String text;
    Node left;
    Node right;

    public Node(String text) {
        this.text = text;
        this.left = null;
        this.right = null;
    }

    public void addNode(Node node, String value) {
        if (node == null || !node.getText().equals(value)) return;

        node.addNode(value, value);
    }
}

public class BinaryTreeCreator {
    public static void main(String[] args) {
        Node root = new Node("root");
        Node left = new Node("a");
        Node right = new Node("b");

        left.addNode(left, "x->a");
        left.addNode(right, "y->b");

        printTree(root);
    }

    private static void printTree(Node node) {
        if (node == null) return;

        System.out.println(node.getText());

        for (Node child : node.children) {
            printTree(child);
        }
    }

    public static List<String> getAllElements() {
        List<String> result = new ArrayList<>();
        printTree(root);

        return result;
    }
}

```

