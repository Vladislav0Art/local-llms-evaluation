import java.util.HashMap;
import java.util.Map;

public class AppVersion {
    private String packageName;
    private Map<String, String> versions = new HashMap<>();

    public void setPackageName(String packageName) {
        if (packageName != null && !packageName.isEmpty()) {
            this.packageName = packageName;
            for (String version : getVersions()) {
                versions.put(version, "changelist=" + version + "*");
            }
        } else {
            throw new IllegalArgumentException("Package name cannot be empty");
        }
    }

    public void addVersion(String version) {
        if (version != null && !version.isEmpty()) {
            versions.put(version, "buildJobName=jenkins job=" + version + ", buildNumber=jenkins commit=" + version);
        } else {
            throw new IllegalArgumentException("Version cannot be empty");
        }
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (!(o instanceof AppVersion)) return false;
        AppVersion appVersion = (AppVersion) o;
        for (Map.Entry<String, String> entry : appVersion.getVersions().entrySet()) {
            if (!packageName.equals(entry.getKey()) || !versions.get(entry.getKey()).equals(entry.getValue())) {
                return false;
            }
        }
        return true;
    }

    @Override
    public int hashCode() {
        return packageName.hashCode();
    }

    public Map<String, String> getVersions() {
        return versions;
    }
}

