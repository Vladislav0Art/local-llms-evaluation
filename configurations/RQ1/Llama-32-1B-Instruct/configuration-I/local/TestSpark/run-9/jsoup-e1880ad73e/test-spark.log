public class UrlBuilderTest {
    private static final String SCENARIO_URL_NORMALIZE_HOST = "[MethodUnderTest][Scenario]TestUrlBuilder.normalizeHost";
    private static final String SCENARIO_URL_PUNY_CODE_HOST = "[MethodUnderTest][Scenario]TestUrlBuilder.punnyCodeHostNormalizer";

    public void testNormalizeInput() {
        UrlBuilder urlBuilder = new UrlBuilder(new URL("https://example.com/path?query=value#anchor"));
        assertEquals("https://example.com/path", urlBuilder.build());
    }

    public void testPunyCodeHostNormalization() throws UnsupportedEncodingException {
        String punyCodeHost = "test.example.co.uk";
        Uri uri = new URI(
                punyCodeHost,
                punyCodeHost.getUserInfo(),
                IDN.toASCII(punyCodeHost),
                punyCodeHost.getPort(),
                punyCodeHost.getPath(),
                null, null
        );
        UrlBuilder urlBuilder = new UrlBuilder(uri);
        assertEquals("https://test.example.co.uk/path?query=value#anchor", urlBuilder.build());
    }

    public void testEscapeExistingEscapes() throws UnsupportedEncodingException {
        String encodedPath = "test.example.co.uk/path?query=value#anchor";
        Uri uri = new URI(
                "https",
                punyCodeHost,
                IDN.toASCII(decodePart(encodedPath)),
                80,
                encodePath(encodedPath),
                null, null
        );
        UrlBuilder urlBuilder = new UrlBuilder(uri);
        assertEquals("https://test.example.co.uk/path?query=value#anchor", urlBuilder.build());
    }

    public void testNormalizeInputWithQuery() throws UnsupportedEncodingException {
        String query = "key=value&another=param";
        Uri uri = new URI(
                "https",
                punyCodeHost,
                IDN.toASCII(decodePart(punyCodeHost)),
                80,
                encodePath("/path/to/query?another=param"),
                null, null
        );
        UrlBuilder urlBuilder = new UrlBuilder(uri);
        assertEquals("https://test.example.co.uk/path/query=value#anchor", urlBuilder.build());
    }

    public void testAppendKeyVal() {
        String key = "key";
        String value = "value";
        UrlBuilder urlBuilder = new UrlBuilder(new URL("https://example.com/path?query=value#anchor"));
        urlBuilder.appendKeyVal(Connection.KeyVal.of(key, value));
        assertEquals("https://example.com/path?key=value&anchor", urlBuilder.build());
    }

    public void testEscapeExistingEscapesWithQuery() throws UnsupportedEncodingException {
        String query = "key=value";
        Uri uri = new URI(
                "https",
                punyCodeHost,
                IDN.toASCII(decodePart(punyCodeHost)),
                80,
                encodePath("/path/to/query?another=param"),
                null, null
        );
        UrlBuilder urlBuilder = new UrlBuilder(uri);
        urlBuilder.appendKeyVal(Connection.KeyVal.of("key", query));
        assertEquals("https://test.example.co.uk/path?key=value&anchor#anchor", urlBuilder.build());
    }

    public void testEscapeExistingEscapesWithFragment() throws UnsupportedEncodingException {
        String fragment = "#anchor";
        Uri uri = new URI(
                "https",
                punyCodeHost,
                IDN.toASCII(decodePart(punyCodeHost)),
                80,
                encodePath("/path/to/fragment"),
                null, null
        );
        UrlBuilder urlBuilder = new UrlBuilder(uri);
        urlBuilder.appendKeyVal(Connection.KeyVal.of("key", fragment));
        assertEquals("https://test.example.co.uk/path?key=value#anchor", urlBuilder.build());
    }
}
