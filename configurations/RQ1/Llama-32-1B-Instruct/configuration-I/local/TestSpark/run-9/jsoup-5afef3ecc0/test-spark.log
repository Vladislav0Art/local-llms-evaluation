public class UrlBuilderTest {

    private static final String INPUT_URL = "https://example.com/path?query=param&ref=ref";
    private static final String EXPECTED_URL = "https://example.com/path/param/ref";

    public void testAppendKeyValMethod() {
        Mockito.mock(UrlHelper.class);
        UrlBuilder urlBuilder = new UrlBuilder(Mockito.mock(URL.class));
        urlBuilder.appendKeyVal(new Connection.KeyVal("key", "value"));
        String actualUrl = urlBuilder.build();
        Mockito.verify(urlBuilder).appendKeyVal(Mockito.any(Connection.KeyVal.class));
    }

    public void testBuildMethod() {
        Mockito.mock(UrlHelper.class);
        UrlBuilder urlBuilder = new UrlBuilder(INPUT_URL);
        URL expectedURL = new URL("https://example.com/path?query=param&ref=ref");
        try {
            urlBuilder.build();
            Assert.fail("Expected exception not thrown");
        } catch (MalformedURLException e) {
            Assert.assertTrue(e.getMessage().contains("remote end will be able to handle it"));
        }
    }

    public void testNormalizationQueryMethod() {
        Mockito.mock(UrlHelper.class);
        UrlBuilder urlBuilder = new UrlBuilder(INPUT_URL);
        String q = "key=value&ref=ref";
        urlBuilder.appendKeyVal(new Connection.KeyVal("key", "value"));
        String expectedQuery = "key=value&ref=ref";
        Assert.assertEquals(expectedQuery, urlBuilder.normalizeQuery(q));
    }

    public void testNormalizationRefMethod() {
        Mockito.mock(UrlHelper.class);
        UrlBuilder urlBuilder = new UrlBuilder(INPUT_URL);
        String r = "ref=ref";
        urlBuilder.appendKeyVal(new Connection.KeyVal("key", "value"));
        String expectedRef = "ref%20ref";
        Assert.assertEquals(expectedRef, urlBuilder.normalizeRef(r));
    }

}
