Here is an example of a basic parser that can parse HTML comments:

```javascript
class CommentParser {
    constructor(html) {
        this.html = html;
        this.index = 0;
    }

    /**
     * Check if the current position is within the start of a comment.
     *
     * @param index The current position in the string.
     * @return True if the current position is within the start of a comment, false otherwise
     */
    isCommentStart(index) {
        return this.html.substring(this.index, index).match(/<!--[\s\S]*?-->/);
    }

    /**
     * Get the contents of the comment at the given position.
     *
     * @param index The current position in the string.
     * @return The contents of the comment
     */
    getCommentContent(index) {
        while (this.isCommentStart(index)) {
            index = this.html.indexOf("<!--", index);
            if (index === -1) break;
            index += 6; // skip the "<!--"
            let content = this.html.substring(index, this.index).trim();
            return content;
        }
    }

    /**
     * Parse the HTML string and extract comments.
     *
     * @return An array of Comment objects
     */
    parse() {
        let comments = [];
        while (this.isCommentStart(this.index)) {
            let content = this.getCommentContent(this.index);
            if (!content.startsWith("<!--")) break;
            comments.push(new Comment(content, new Element("#comment")));
            this.index += content.length + 6; // skip the "<!--"
        }
        return comments;
    }

    /**
     * Append an HTML comment to the string.
     *
     * @param index The current position in the string
     * @param content The contents of the comment
     */
    appendComment(index, content) {
        while (this.isCommentStart(index)) {
            this.html = this html.substring(0, index) + "<!--" + content + "-->" + this.html.substring(index);
            index += 11; // skip the "<!--"
        }
    }

    /**
     * Append an HTML comment to the string as a file.
     *
     * @param filename The name of the file
     */
    appendCommentAsFile(filename) {
        let html = "";
        while (this.isCommentStart(this.index)) {
            let content = this.getCommentContent(this.index);
            if (!content.startsWith("<!--")) break;
            html += content + "\n";
            this.index += content.length + 6; // skip the "<!--"
        }
        try {
            fs.writeFileSync(filename, html);
        } catch (e) {
            console.error(e);
        }
    }

    /**
     * Get the HTML string.
     *
     * @return The HTML string
     */
    getHtml() {
        return this.html;
    }
}

function main() {
    let html = "<!-- This is a comment -->";
    let parser = new CommentParser(html);
    let comments = parser.parse();
    for (let comment of comments) {
        console.log(comment.getData());
        if (comment.getTag()) {
            console.log(comment.getTag().tagName());
        }
    }
}

main();
