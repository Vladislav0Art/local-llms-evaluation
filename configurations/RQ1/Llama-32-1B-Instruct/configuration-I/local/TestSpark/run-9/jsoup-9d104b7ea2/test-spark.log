        // Arrange
        String encodedText = "&lt;Hello&gt;";
        Document document = new Document();
        Appendable accumulator = new StringBuilder();

        // Act
        TextNode currentNode = new TextNode(document, accumulator);
        currentNode.text(fromEncoded(encodedText));

        // Assert
