        "   "
    })
    public void isBlank(boolean expected, String actual) {
        assertEquals(expected, TextNode.isBlank(actual));
    }

    @ParameterizedTest
    @CsvSource({
            "\"\"",
            "<p> Hello <span> world </span></p>",
            "\n\n"
    })
    public void text(String input, String expected) {
        TextNode text = new TextNode(input);
        assertEquals(expected, text.text());
    }

