        System.out.println("URL: " + url);
        System.out.println("Status Code: " + result1.statusCode);
        System.out.println("Headers:\n" +
                result1.headers.toString(StandardCharsets.UTF_8));

        // Append key-value pairs to URLs using the appendKeyVal() method of the HttpPost object
        String httpPostUrl = new URI(url).query();
        HttpPost httpPost = new HttpPost(httpPostUrl);
        httpPost.setEntity(new StringBody(result1.value));
        HttpResponse response = httpClient.execute(httpPost);

        System.out.println("Status Code: " + response.getStatusLine().getStatusCode());
    }

    public static class KeyValueAppenderFunction {
        @Override
        public FuncResult appendKeyVal(String url) throws URISyntaxException, Exception {
            String[] kv = {("key", "value"), ("another_key", "another_value")};
            HttpEntity entity = new StringBody(kv, null, true);
            return new KeyValueAppenderFunction.ValueResult(true, entity.toString(StandardCharsets.UTF_8));
        }
    }

    public static class ValueResult {
        public boolean success;
        public byte[] value;

        public ValueResult(boolean success, byte[] value) {
