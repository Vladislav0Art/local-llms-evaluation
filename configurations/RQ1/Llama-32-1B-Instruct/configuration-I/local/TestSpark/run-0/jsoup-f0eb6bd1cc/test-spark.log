import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;

public class GeneratedTest {

    public static void main(String[] args) {
        String url = "https://example.com/path?query=value#anchor";
        Document doc = Jsoup.parse(url);
        System.out.println(doc.select("a").first().attr("href"));
    }

    public static String getAnchorUrl(String url, int anchorIndex) {
        String encodedPath = encodePath(url.split("/")[2]);
        return encodedPath + "#" + anchorIndex;
    }

    private static String encodePath(String path) {
        StringBuilder sb = new StringBuilder();
        for (char c : path.toCharArray()) {
            if (Character.isLetterOrDigit(c)) {
                sb.append("a").append(c);
            } else if (c == '/') {
                sb.append('/');
            }
        }
        return sb.toString();
    }

}
