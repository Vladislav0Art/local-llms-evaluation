import java.util.Map;

public class Test {
    private String url;
    private Map<String, String> data;

    public Test(String url, Map<String, String> data) {
        this.url = url;
        this.data = data;
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj)
            return true;
        if (obj == null || getClass() != obj.getClass())
            return false;

        Test test = (Test) obj;

        if (!url.equals(test.url))
            return false;

        return data.equals(test.data);
    }

    @Override
    public int hashCode() {
        int result = url.hashCode();
        result = 31 * result + data.hashCode();
        return result;
    }

    @Override
    public String toString() {
        return "Test{" +
                "url='" + url + '\'' +
                ", data=" + data +
                '}';
    }
}

