        HashTable hashTable = new HashTable();
        Map<String, String> obj1 = new HashMap<>();
        obj1.put("key1", "value1");
        obj1.put("key2", "value2");

        Map<String, String> obj2 = new HashMap<>();
        obj2.put("key2", "newValue2");
        obj2.put("key3", "value3");

        hashTable.addElement("key1", "value1");
        hashTable.addElement("key2", "newValue2");

        CompareObjects compareObjects = new CompareObjects();
        System.out.println(compareObjects.compareObjects(obj1, obj2));
    }
}
```

