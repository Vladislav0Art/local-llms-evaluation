                String headContent = textNode.getText();
                if (!headContent.isEmpty()) {
                    System.out.println(headContent);
                }
            } else {
                testIsBlank();
            }
        }

    }

    private static class TestNode extends TextNode {

        public TestNode(String content) {
            super(content);
        }

        @Override
        protected String getText() {
            return content;
        }
    }
