import org.junit.Test;
import static org.junit.Assert.*;
import java.util.HashMap;
import java.util.Map;
import java.util.Arrays;

public class CommentsConfigurationTest {

    @Test
    public void newCommentsConfiguration[]Test() {
        CommentsConfiguration config = new CommentsConfiguration();
        assertNotNull(config.comments);
    }

    @Test
    public void newCommentsConfigurationWithMap[]Test() {
        Map<String, List<String>> comments = new HashMap<>();
        comments.put("test", Arrays.asList("line1", "line2"));
        CommentsConfiguration config = new CommentsConfiguration(comments);
        assertEquals(comments, config.comments);
    }

    @Test
    public void setCommentLinesNoPath[]Test() {
        CommentsConfiguration config = new CommentsConfiguration();
        assertThrows(IndexOutOfBoundsException.class, () -> config.setComment(null, "line1", "line2"));
    }

    @Test
    public void setCommentLinesWithNewLine[]Test() {
        CommentsConfiguration config = new CommentsConfiguration();
        config.setComment("test", "\n");
        assertEquals(Collections.singletonList(""), config.comments.get("test"));
    }

    @Test
    public void setCommentLinesWithNoNewLine[]Test() {
        CommentsConfiguration config = new CommentsConfiguration();
        config.setComment("test", "line1", "line2");
        assertEquals(Arrays.asList("line1", "line2"), config.comments.get("test"));
    }

    @Test
    public void setCommentLinesWithMultiplePath[]Test() {
        CommentsConfiguration config = new CommentsConfiguration();
        config.setComment("test1", "line11", "line12");
        config.setComment("test2", "line21", "line22");
        assertEquals(Arrays.asList("line11", "line12"), config.comments.get("test1"));
        assertEquals(Arrays.asList("line21", "line22"), config.comments.get("test2"));
    }

    @Test
    public void getAllComments[]Test() {
        CommentsConfiguration config = new CommentsConfiguration();
        Map<String, List<String>> expectedComments = new HashMap<>();
        expectedComments.put("test1", Arrays.asList("line11", "line12"));
        config.setComment("test1", "line11", "line12");
        assertEquals(expectedComments, config.getAllComments());
    }

    @Test
    public void getAllCommentsUnmodifiable[]Test() {
        CommentsConfiguration config = new CommentsConfiguration();
        Map<String, List<String>> expectedComments = new HashMap<>();
        expectedComments.put("test1", Arrays.asList("line11", "line12"));
        config.setComment("test1", "line11", "line12");
        assertEquals(expectedComments, config.getAllComments());
    }

}
