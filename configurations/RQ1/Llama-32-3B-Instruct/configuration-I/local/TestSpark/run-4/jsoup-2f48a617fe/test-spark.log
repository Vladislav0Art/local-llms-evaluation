import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.junit.Test;
import static org.junit.Assert.*;
import java.io.IOException;

public class CommentTest {

    @Test
    public void constructorTest() {
        Comment comment = new Comment("Hello World");
        assertEquals("Hello World", comment.getData());
    }

    @Test
    public void nodeNameTest() {
        Comment comment = new Comment("Hello World");
        assertEquals("#comment", comment.nodeName());
    }

    @Test
    public void setDataTest() {
        Comment comment = new Comment("Hello World");
        comment.setData("New Data");
        assertEquals("New Data", comment.getData());
    }

    @Test
    public void outerHtmlHeadTest() throws IOException {
        Appendable accum = new StringBuilder();
        Document.OutputSettings out = new Document.OutputSettings(true, false);
        Comment comment = new Comment("Hello World");
        comment.outerHtmlHead(accum, 0, out);
        accum.toString().equals("<!--Hello World-->");
    }

    @Test
    public void outerHtmlTailTest() {
        Appendable accum = new StringBuilder();
        Document.OutputSettings out = new Document.OutputSettings(true, false);
        Comment comment = new Comment("Hello World");
        comment.outerHtmlTail(accum, 0, out);
        // No output.
    }

    @Test
    public void toStringTest() throws IOException {
        Appendable accum = new StringBuilder();
        Document.OutputSettings out = new Document.OutputSettings(true, false);
        Comment comment = new Comment("Hello World");
        comment.outerHtml(accum, 0, out);
        accum.toString().equals("<!--Hello World-->");
    }

    @Test
    public void cloneTest() {
        Comment originalComment = new Comment("Hello World");
        Comment clonedComment = originalComment.clone();
        assertNotNull(clonedComment);
        assertEquals(originalComment, clonedComment);
    }

    @Test
    public void isXmlDeclarationTest() {
        Comment comment = new Comment("!XML Declaration");
        assertTrue(comment.isXmlDeclaration());
    }

    @Test
    public void isXmlDeclarationFalseTest() {
        Comment comment = new Comment("Not XML");
        assertFalse(comment.isXmlDeclaration());
    }

    @Test
    public void asXmlDeclarationTest() throws IOException {
        Appendable accum = new StringBuilder();
        Document.OutputSettings out = new Document.OutputSettings(true, false);
        Comment comment = new Comment("!XML Declaration");
        XmlDeclaration decl = comment.asXmlDeclaration();
        assertNotNull(decl);
        // No output.
    }

    @Test
    public void asXmlDeclarationFalseTest() throws IOException {
        Appendable accum = new StringBuilder();
        Document.OutputSettings out = new Document.OutputSettings(true, false);
        Comment comment = new Comment("Not XML");
        XmlDeclaration decl = comment.asXmlDeclaration();
        assertNull(decl);
        // No output.
    }

}
