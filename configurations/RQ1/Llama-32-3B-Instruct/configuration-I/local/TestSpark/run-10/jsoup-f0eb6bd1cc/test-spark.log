package org.jsoup.parser;

import org.jsoup.nodes.Document;
import org.junit.Test;
import static org.junit.Assert.*;

public class UrlBuilderTest {

    @Test
    public void testUrlBuilder() {
        // Create a new URL
        String url = "http://example.com/path?key=value";

        // Parse the URL into its components
        UrlBuilder builder = new UrlBuilder(new java.net.URL(url));

        // Check that the query string is correct
        assertEquals(1, builder.q.length());
        assertTrue(builder.q.toString().contains("?key=value"));

        // Create a new URL with multiple key-value pairs
        String url2 = "http://example.com/path?key1=value1&key2=value2";

        // Parse the URL into its components
        UrlBuilder builder2 = new UrlBuilder(new java.net.URL(url2));

        // Check that the query string is correct
        assertEquals(2, builder2.q.length());
        assertTrue(builder2.q.toString().contains("?key1=value1&key2=value2"));
    }
}

class UrlBuilder {
    public StringBuilder q;

    public UrlBuilder(java.net.URL url) {
        this.q = new StringBuilder();
    }

    public void addQueryString(String query) {
        if (q.length() > 0) {
            q.append("&");
        }
        q.append(query);
    }
}
