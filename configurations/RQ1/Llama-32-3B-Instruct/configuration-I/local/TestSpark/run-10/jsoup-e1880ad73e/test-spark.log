public class UrlBuilder {
    private String url;
    private String path;
    private String query;
    private int port;

    public UrlBuilder(String url) {
        this.url = url;
    }

    public UrlBuilder withPath(String path) {
        this.path = path;
        return this;
    }

    public UrlBuilder withQueryParam(String key, String value) {
        if (query == null) {
            query = key + "=" + value;
        } else {
            if (!query.contains(";")) {
                query += ";";
            }
            query += key + "=" + value;
        }
        return this;
    }

    public UrlBuilder withPort(int port) {
        this.port = port;
        return this;
    }

    public String build() {
        StringBuilder sb = new StringBuilder(url);
        if (path != null && !path.isEmpty()) {
            sb.append("/").append(path);
        }
        if (query != null && !query.isEmpty()) {
            sb.append("?").append(query);
        }
        if (port > 0) {
            sb.append(":").append(port);
        }
        return sb.toString();
    }

    public String getQuery() {
        return query;
    }

    public static class UrlBuilderTest {
        @Test
        public void testBuild() {
            UrlBuilder builder = new UrlBuilder("https://example.com");
            String expectedUrl = "https://example.com";
            assertEquals(expectedUrl, builder.build());
        }

        @Test
        public void testBuildWithQueryParams() {
            UrlBuilder builder = new UrlBuilder("https://example.com", null);
            builder.withQueryParam("query", "value");
            String expectedUrl = "https://example.com?query=value";
            assertEquals(expectedUrl, builder.build());
        }

        @Test
        public void testBuildWithPortNumber() {
            UrlBuilder builder = new UrlBuilder("https://example.com", 8080);
            String expectedUrl = "https://example.com:8080";
            assertEquals(expectedUrl, builder.build());
        }

        @Test
        public void testMalformedURLException() {
            assertThrows(MalformedURLException.class, () -> new UrlBuilder(null));
        }
    }
}
