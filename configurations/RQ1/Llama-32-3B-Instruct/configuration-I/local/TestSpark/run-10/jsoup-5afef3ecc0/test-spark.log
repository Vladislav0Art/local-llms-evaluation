public class Connection {
    public static class KeyVal {
        public String key;
        public String value;
    }

    public static class Connection {
    }

    public static class Connection.KeyVal {
    }
}

public class UrlBuilderTest {

    @org.junit.Test
    public void build_URL_with_valid_input() {
        Connection connection = new Connection();
        connection.newConnection().newKeyVal().key = "http";
        connection.newConnection().newKeyVal().value = "";
        connection.newConnection().host = "example.com";
        connection.newConnection().path = "/path/to/resource";
        UrlBuilder urlBuilder = new UrlBuilder(connection);
        String url = urlBuilder.build();
        org.junit.Assert.assertTrue(url.contains("http://example.com"));
    }

    public void appendKeyVal_query_string() {
        Connection.KeyVal kv = new Connection.KeyVal();
        kv.key = "key";
        kv.value = "value";
        UrlBuilder urlBuilder = new UrlBuilder(new URL("http://example.com"));
        urlBuilder.appendKeyVal(kv);
    }

    public void appendKeyVal_ref_string() {
        String ref = "abc";
        UrlBuilder urlBuilder = new UrlBuilder(new URL("http://example.com"));
        urlBuilder.appendKeyVal(ref);
    }

    public void decodePart_encoding() {
        String encoded = "https%3A%2F%2Fexample.com";
        UrlBuilder urlBuilder = new UrlBuilder(new URL("http://example.com"));
        String decodedUrl = urlBuilder.decode(encoded);
        org.junit.Assert.assertTrue(decodedUrl.contains("https://example.com"));
