        onlineStockSpan.list.add(10);
        onlineStockSpan.next(10);
        onlineStockSpan.next(5);
        assertThat(onlineStockSpan.next(10), is(2));
    }

    @Test
    public void calculateSpansCorrectlyForSingleElement() {
        int[] prices = {10};
