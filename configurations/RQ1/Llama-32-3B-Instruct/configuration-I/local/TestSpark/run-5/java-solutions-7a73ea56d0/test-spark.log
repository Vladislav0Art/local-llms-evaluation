        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        onlineStockSpan.list.add(10);
        onlineStockSpan.next(20);
        onlineStockSpan.next(5);
        assertThat(onlineStockSpan.next(15), is(2));
    }

