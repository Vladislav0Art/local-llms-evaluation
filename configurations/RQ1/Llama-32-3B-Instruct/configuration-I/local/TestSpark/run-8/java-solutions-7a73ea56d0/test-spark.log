public class OnlineStockSpanTest {
    private OnlineStockSpan onlineStockSpan = new OnlineStockSpan();

    @Test
    public void testNext() {
        int[] prices = {1,2,3,4,5};
        assertEquals(1, onlineStockSpan.next(1));
        assertEquals(2, onlineStockSpan.next(2));
        assertEquals(2, onlineStockSpan.next(3));
        assertEquals(3, onlineStockSpan.next(4));
        assertEquals(4, onlineStockSpan.next(5));
    }

    @Test
    public void testCalculateSpans() {
        int[] prices = {1,2,3,4,5};
        int[] result = onlineStockSpan.calculateSpans(prices);
        assertArrayEquals(new int[]{0, 1, 2, 3, 4}, result);
    }

    @Test
    public void testNextNull() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        assertThrows(NullPointerException.class, () -> onlineStockSpan.next(null));
    }
}

public class OnlineStockSpan {

    private Stack<Integer> indexStack = new Stack<>();
    private List<Integer> list = new ArrayList<>();

    public int next(int price) {
        if (price == null) {
            throw new NullPointerException("Price cannot be null");
        }
        while (!indexStack.isEmpty() && list.get(indexStack.peek()) <= price) {
            indexStack.pop();
        }
        if (indexStack.isEmpty()) {
            list.add(price);
            indexStack.push(list.size() - 1);
        } else {
            list.add(price - list.get(indexStack.peek()));
            indexStack.push(list.size() - 1);
        }
        return indexStack.size();
    }

    public int[] calculateSpans(int[] prices) {
        for (int price : prices) {
            this.next(price);
        }
        List<Integer> result = new ArrayList<>();
        for (int i = 0; i  list.size(); i++) {
            result.add(list.get(i));
        }
        return result.stream().mapToInt(Integer::intValue).toArray();
    }

    public static void main(String[] args) {
        OnlineStockSpanTest test = new OnlineStockSpanTest();
        JUnitCore.main(test.class);
    }
}
