    @Test
    public void next_PriceGreaterOrEqualToPreviousPrices_ReturnsCorrectCount() {
        Stack<Integer> indexStack = new Stack<>();
        List<Integer> list = new ArrayList<>();

        indexStack.push(0);
        list.add(50);

        when(indexStack.isEmpty()).thenReturn(true);
        when(indexStack.pop()).thenReturn(0);

        onlineStockSpan.list = list;
        onlineStockSpan.indexStack = indexStack;

        int result = onlineStockSpan.next(100);
        assertEquals(1, result);
    }

    @Test
    public void next_PriceLessThanPreviousPrices_ReturnsCorrectCount() {
        Stack<Integer> indexStack = new Stack<>();
        List<Integer> list = new ArrayList<>();

        indexStack.push(0);
        indexStack.push(50);

        when(indexStack.isEmpty()).thenReturn(false);
        when(indexStack.pop()).thenReturn(1);

        onlineStockSpan.list = list;
        onlineStockSpan.indexStack = indexStack;

        int result = onlineStockSpan.next(40);
        assertEquals(2, result);
    }

    @Test
    public void next_PriceLessThan0_Returns1() {
        Stack<Integer> indexStack = new Stack<>();
        List<Integer> list = new ArrayList<>();

        when(indexStack.isEmpty()).thenReturn(true);
        when(indexStack.pop()).thenReturn(0);

        onlineStockSpan.list = list;
        onlineStockSpan.indexStack = indexStack;

        int result = onlineStockSpan.next(-10);
        assertEquals(1, result);
    }

    @Test
    public void calculateSpans_NoPrices_ReturnsEmptyArray() {
        int[] result = onlineStockSpan.calculateSpans(new int[0]);
        assertArrayEquals(new int[]{}, result);
    }

    @Test
    public void calculateSpans_SinglePrice_ReturnsCorrectSpans() {
        int[] prices = {10};
        int[] result = onlineStockSpan.calculateSpans(prices);

        assertArrayEquals(new int[]{1}, result);
    }

    @Test
    public void calculateSpans_MultiplePrices_ReturnsCorrectSpans() {
        int[] prices = {50, 60, 70, 80, 90};
        int[] result = onlineStockSpan.calculateSpans(prices);

        assertArrayEquals(new int[]{1, 2, 3, 4, 5}, result);
    }

    @Test
    public void calculateSpans_PricesAlreadyProcessed_ReturnsCorrectSpans() {
        Stack<Integer> indexStack = new Stack<>();
        List<Integer> list = new ArrayList<>();

        indexStack.push(0);
        indexStack.push(50);

        when(indexStack.isEmpty()).thenReturn(false);
        when(indexStack.pop()).thenReturn(1);

        onlineStockSpan.list = list;
        onlineStockSpan.indexStack = indexStack;

        int[] result = onlineStockSpan.calculateSpans(new int[]{50, 60});

        assertArrayEquals(new int[]{1, 2}, result);
    }

