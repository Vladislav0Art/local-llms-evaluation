import org.jsoup.Connection;
import org.jsoup.helper.UrlBuilder;
import org.junit.Test;
import static org.junit.Assert.*;
import java.net.MalformedURLException;
import java.net.URL;
import java.io.UnsupportedEncodingException;

public class UrlBuilderTest {

    @Test
    public void [UrlBuilder_getters_and_setters]Test() {
        UrlBuilder builder = new UrlBuilder(new URL("http://example.com/path?query=Hello World"));
        assertNotNull(builder.getU());
        assertNull(builder.getQ());
    }

    @Test
    public void [UrlBuilder_init_with_valid_url]Test() {
        UrlBuilder builder = new UrlBuilder(new URL("http://example.com/path?query=Hello World"));
        assertEquals(0, builder.getQ().length(), 1);
    }

    @Test
    public void [UrlBuilder_init_with_invalid_url]Test() throws MalformedURLException {
        UrlBuilder builder = new UrlBuilder(new URL("invalid url"));
        assertNotNull(builder.getU());
        assertNull(builder.getQ());
    }

    @Test
    public void [UrlBuilder_build]Test() throws MalformedURLException, URISyntaxException, UnsupportedEncodingException {
        UrlBuilder builder = new UrlBuilder(new URL("http://example.com/path?query=Hello World"));
        String expected = "http%3A%2F%2Fexample.com%2Fpath%3Fquery%3DHello+World";
        assertEquals(expected, builder.getU().toString());
    }

    @Test
    public void [UrlBuilder_build_with_puny_coding]Test() throws MalformedURLException, URISyntaxException, UnsupportedEncodingException {
        UrlBuilder builder = new UrlBuilder(new URL("http://example.com/path?query=Hello World"));
        String expected = "http%3A%2F%2Fexample.com%2Fpath%3Fquery%3DHello+World";
        assertEquals(expected, builder.getU().toString());
    }

    @Test
    public void [UrlBuilder_build_with_escaped_chars]Test() throws MalformedURLException, URISyntaxException, UnsupportedEncodingException {
        UrlBuilder builder = new UrlBuilder(new URL("http://example.com/path?query=Hello World"));
        String expected = "http%3A%2F%2Fexample.com%2Fpath%3Fquery%3DHello+World";
        assertEquals(expected, builder.getU().toString());
    }

    @Test
    public void [UrlBuilder_build_with_escaped_query]Test() throws MalformedURLException, URISyntaxException, UnsupportedEncodingException {
        UrlBuilder builder = new UrlBuilder(new URL("http://example.com/path?query=Hello World"));
        String expected = "http%3A%2F%2Fexample.com%2Fpath%3Fquery%3DHello+World";
        assertEquals(expected, builder.getU().toString());
    }

    @Test
    public void [UrlBuilder_build_with_escaped_fragment]Test() throws MalformedURLException, URISyntaxException, UnsupportedEncodingException {
        UrlBuilder builder = new UrlBuilder(new URL("http://example.com/path#fragment"));
        String expected = "http%3A%2F%2Fexample.com%2Fpath%23fragment";
        assertEquals(expected, builder.getU().toString());
    }

    @Test
    public void [UrlBuilder_appendKeyVal]Test() throws UnsupportedEncodingException {
        UrlBuilder builder = new UrlBuilder(new URL("http://example.com/path"));
        Connection.KeyVal keyVal = Connection.KeyVal.newKeyVal("key", "value");
        builder.appendKeyVal(keyVal);
        assertEquals("key=value", builder.getQ().toString());
    }

    @Test
    public void [UrlBuilder_appendKeyVal_with_multiple_queries]Test() throws UnsupportedEncodingException {
        UrlBuilder builder = new UrlBuilder(new URL("http://example.com/path"));
        Connection.KeyVal keyVal1 = Connection.KeyVal.newKeyVal("key1", "value1");
        Connection.KeyVal keyVal2 = Connection.KeyVal.newKeyVal("key2", "value2");
        builder.appendKeyVal(keyVal1);
        builder.appendKeyVal(keyVal2);
        assertEquals("key1=value1&key2=value2", builder.getQ().toString());
    }

    @Test
    public void [UrlBuilder_decodePart]Test() throws UnsupportedEncodingException {
        String input = "http://example.com/path?query=Hello World";
        assertEquals(input, UrlBuilder.decodePart(input));
    }

    @Test
    public void [UrlBuilder_decodePart_with_invalid_encoding]Test() throws UnsupportedEncodingException {
        String input = "http://example.com/path?query=%3F%3F";
        assertEquals("??", UrlBuilder.decodePart(input));
    }
}
