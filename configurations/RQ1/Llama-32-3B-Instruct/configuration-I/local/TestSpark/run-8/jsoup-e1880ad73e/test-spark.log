    private static URLQueryParameters query;

    public static void main(String[] args) throws Exception {
        // Initialize the map
        query = new URLQueryParameters();

        // Test adding key-value pairs
        List<String> value1 = Arrays.asList("value1");
        query.put("key1", value1);
        query.put("key2", value1);

        // Test accessing a specific key-value pair
        System.out.println(query.get("key1"));  // Output: value1

        // Test checking if the map is empty
        System.out.println(query.isEmpty());  // Output: false

        // Test removing a key-value pair
        query.remove("key1");
        System.out.println(query.containsKey("key1"));  // Output: false
    }
}

