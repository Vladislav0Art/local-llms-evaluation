import static org.junit.Assert.assertNull;
import static org.junit.Assert.assertTrue;

public class JsoupTests {

    public void testComment() {
        String html = "<!-- comment -->";
        Document doc = Jsoup.parse(html);
        Comment comment = doc.select("comment").first();
        assertEquals("comment", comment.nodeName());
        assertTrue(comment.isXmlDeclaration());
        assertNull(comment.asXmlDeclaration());

        // Test cloneComment
        Comment cloneComment = comment.clone();
        assertEquals("#comment", cloneComment.nodeName());
    }

    public void testXmlDeclaration() {
        String html = "<!xml version=\"1.0\" encoding=\"UTF-8\"?>";
        Document doc = Jsoup.parse(html);
        Element xmlDeclaration = doc.select("xml").first();
        assertNotNull(xmlDeclaration);
        assertTrue(xmlDeclaration.isXmlDeclaration());
        assertNull(xmlDeclaration.asXmlDeclaration());

        // Test cloneComment
        Comment comment = new Comment("comment");
        Element clonedXmlDeclaration = comment.clone().asXmlDeclaration();
        assertNotNull(clonedXmlDeclaration);

        // Test isXmlDeclaration
        Comment xmlComment = new Comment("<xml>test</xml>");
        assertFalse(xmlComment.isXmlDeclaration());
    }

    public void testHtmlHead() {
        String html = "<head><title>Page Title</title></head>";
        Document doc = Jsoup.parse(html);
        Element head = doc.select("head").first();
        assertNotNull(head);
        assertTrue(head.isXmlDeclaration());

        // Test cloneComment
        Comment comment = new Comment("comment");
        Element clonedHead = comment.clone().asHtmlDeclaration();
        assertNotNull(clonedHead);

        // Test isXmlDeclaration
        Comment xmlComment = new Comment("<xml>test</xml>");
        assertFalse(xmlComment.isXmlDeclaration());
    }

    public void testXml() {
        String html = "<root><child><text>Hello, World!</text></child></root>";
        Document doc = Jsoup.parse(html);
        Elements elements = doc.getAllElements();
        assertEquals(1, elements.size());

        // Test cloneComment
        Comment comment = new Comment("comment");
        Element clonedRoot = comment.clone().asHtmlDeclaration();
        assertNotNull(clonedRoot);

        // Test isXmlDeclaration
        Comment xmlComment = new Comment("<xml>test</xml>");
        assertFalse(xmlComment.isXmlDeclaration());
    }
}
