package org.jsoup.helper;

import org.jsoup.Connection;
import org.junit.Test;
import static org.junit.Assert.*;
import java.io.UnsupportedEncodingException;
import java.net.IDN;
import java.net.MalformedURLException;
import java.net.URI;
import java.net.URISyntaxException;
import java.net.URL;
import java.net.URLDecoder;
import java.net.URLEncoder;
import java.util.concurrent.Callable;
import org.mockito.Mockito;

public class UrlBuilderTest {

    @Test
    public void buildUrlFromValidUrlTest() {
        URL inputUrl = new URL("http://test.com/path");
        UrlBuilder builder = new UrlBuilder(inputUrl);
        URL expectedUrl = new URL("http://test.com/path");
        assertEquals(expectedUrl, builder.build());
    }

    @Test
    public void buildUrlWithQueryFromValidUrlTest() {
        URL inputUrl = new URL("http://test.com/path?a=1&b=2");
        UrlBuilder builder = new UrlBuilder(inputUrl);
        URL expectedUrl = new URL("http://test.com/path?a=1%26b=2");
        assertEquals(expectedUrl, builder.build());
    }

    @Test
    public void buildUrlWithFragmentFromValidUrlTest() {
        URL inputUrl = new URL("http://test.com/path#fragment");
        UrlBuilder builder = new UrlBuilder(inputUrl);
        URL expectedUrl = new URL("http://test.com/path#fragment");
        assertEquals(expectedUrl, builder.build());
    }

    @Test
    public void buildUrlWithNonAsciiPathComponentTest() {
        URL inputUrl = new URL("http://test.com/à");
        UrlBuilder builder = new UrlBuilder(inputUrl);
        String expectedUrl = "http%2f//test.com/%C3%A0";
        assertEquals(new URL(expectedUrl), builder.build());
    }

    @Test
    public void buildUrlWithNonAsciiQueryValueTest() {
        URL inputUrl = new URL("http://test.com/path?a=à");
        UrlBuilder builder = new UrlBuilder(inputUrl);
        String expectedUrl = "http%2f//test.com/path%3Fa%C3%A0";
        assertEquals(new URL(expectedUrl), builder.build());
    }

    @Test
    public void appendKeyValToQueryWithNonAsciiValueTest() {
        Connection.KeyVal kv = new Connection.KeyVal("a", "à");
        UrlBuilder builder = Mockito.mock(UrlBuilder.class);
        builder.appendKeyVal(kv);
        assertNotNull(builder.q);
        assertTrue(builder.q.toString().contains("%C3%A0"));
    }

    @Test
    public void appendKeyValToQueryWithNonAsciiSpaceValueTest() {
        Connection.KeyVal kv = new Connection.KeyVal("a", " ");
        UrlBuilder builder = Mockito.mock(UrlBuilder.class);
        builder.appendKeyVal(kv);
        assertNotNull(builder.q);
        assertTrue(builder.q.toString().contains("%20"));
    }

    @Test
    public void decodePartWithNonAsciiEncodingTest() throws UnsupportedEncodingException {
        String encoded = "à";
        assertEquals("à", UrlBuilder.decodePart(encoded));
    }

    @Test
    public void appendToAsciiWithSpaceAsPlusTest() {
        StringBuilder sb = new StringBuilder();
        UrlBuilder.appendToAscii(" ", true, sb);
        assertTrue(sb.toString().equals("%20"));
    }
}
