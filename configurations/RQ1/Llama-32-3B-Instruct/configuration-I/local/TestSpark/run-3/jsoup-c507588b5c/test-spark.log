import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.junit.Test;
import org.mockito.Mockito;

public class TextNodeTest {

    @Test
    public void createTextNode_EmptyText() {
        TextNode node = new TextNode("");
        assert node.text().isEmpty();
    }

    @Test
    public void createTextNode_TrailingWhitespace() {
        TextNode node = new TextNode("   ");
        assertEquals("   ", node.text());
    }

    @Test
    public void createTextNode_LedgingWhitespace() {
        TextNode node = new TextNode("   \n");
        assertEquals("\n", node.text());
    }

    @Test
    public void textEmpty() {
        TextNode node = new TextNode("");
        assertTrue(node.isBlank());
    }

    @Test
    public void textNotBlank() {
        TextNode node = new TextNode("Hello");
        assertFalse(node.isBlank());
    }

    @Test
    public void createTextNode splitTextOffsetInMiddle() {
        String text = "Hello World";
        TextNode node = new TextNode(text);
        TextNode tail = node.splitText(6);
        assertEquals("World", tail.text());
        assertEquals("Hello ", node.text());
    }

    @Test
    public void createTextNode splitTextOffsetAtStart() {
        String text = "Hello World";
        TextNode node = new TextNode(text);
        TextNode tail = node.splitText(0);
        assertEquals("", tail.text());
        assertEquals("Hello", node.text());
    }

    @Test
    public void createTextNode splitTextOffsetAtEnd() {
        String text = "Hello World";
        TextNode node = new TextNode(text);
        TextNode head = node.splitText(text.length());
        assertEquals("", head.text());
        assertEquals("World ", node.text());
    }

    @Test
    public void getWholeText_Empty() {
        TextNode node = new TextNode("");
        assertEquals("", node.getWholeText());
    }

    @Test
    public void getWholeText_NonEmpty() {
        String text = "Hello World";
        TextNode node = new TextNode(text);
        assertEquals("Hello World", node.getWholeText());
    }
}

public class DocumentTest {

    private static final String HTML = "<p>Hello World</p>";

    @Test
    public void outerHtmlTest() throws IOException {
        TextNode node = new TextNode(HTML);
        Appendable accum = new StringBuilder();
        Document outputSettings = new Document.OutputSettings(true, false);
        node.outerHtmlHead(accum, 0, outputSettings);
        assertEquals("<p>Hello World</p>", accum.toString());
    }
}

public class LeafNodeTest {

    private static final String HTML = "<p>Hello World</p>";

    @Test
    public void clone() {
        TextNode node = new TextNode(HTML);
        TextNode cloned = (TextNode) node.clone();
        assertNotNull(cloned);
        assertEquals(node, cloned);
    }
}

public class AppendableTest {

    private static final String HTML = "<p>Hello World</p>";

    @Test
    public void escape() throws IOException {
        TextNode node = new TextNode(HTML);
        Appendable accum = new StringBuilder();
        Document outputSettings = new Document.OutputSettings(true, false);
        node.outerHtmlHead(accum, 0, outputSettings);
        assertEquals("<p>Hello World</p>", accum.toString());
    }
}

public class StringUtilTest {

    @Test
    public void normaliseWhitespace() {
        String text = "   ";
        assertEquals(" ", StringUtil.normaliseWhitespace(text));
    }

    @Test
    public void stripLeadingWhitespace() {
        String text = "   ";
        assertEquals("", StringUtil.stripLeadingWhitespace(text));
    }
}

public class EntitiesTest {

    private static final String HTML = "&lt;p&gt;Hello World&lt;/p&gt;";

    @Test
    public void unescape() {
        TextNode node = new TextNode(HTML);
        StringBuilder sb = new StringBuilder();
        assertEquals("Hello World", Entities.unescape(node.text()), 0, sb);
    }
}

public class lastCharIsWhitespaceTest {

    private static final String HTML = "&lt;p&gt;Hello World&lt;/p&gt;";

    @Test
    public void test() {
        StringBuilder sb = new StringBuilder(HTML);
        assertTrue(lastCharIsWhitespace(sb));
    }
}
