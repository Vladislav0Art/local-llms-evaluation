            Connection.KeyVal kv = new Connection.KeyVal("key", query);
            StringBuilder sb = new StringBuilder();
            builder.appendKeyVal(kv, sb);
            assertEquals("?key=" + query, sb.toString());
        }
    }

    public static class KeyVal {
        private String key;
        private String value;

        public KeyVal(String key, String value) {
            this.key = key;
            this.value = value;
        }

        @org.junit.Test
        public void testEncode() {
            assertEquals("key=value", this.toString());
        }
    }
}
