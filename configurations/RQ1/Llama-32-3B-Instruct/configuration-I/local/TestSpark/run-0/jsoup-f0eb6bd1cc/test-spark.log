public class Main {

    @org.junit.Test
    public void testUrlBuilder() {
        UrlBuilder builder = new UrlBuilder(new URL("http://example.com/path"));
        assertEquals("?key=value", builder.q.toString());
        assert(builder.decodePart("\u00ae").equals("\u00ae"));
        builder.appendToAscii("hello world", false, sb -> sb.append("+"));
        assertEquals("hello+world", sb.toString());
    }

    public static class Connection {
        @org.junit.Test
        public void testKeyVal() {
            Connection.KeyVal kv = new Connection.KeyVal("key", "value");
            // No assertion needed since it's a constructor test
        }
    }

