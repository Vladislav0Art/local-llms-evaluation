import java.net.URL;
import java.util.Arrays;

public class Main {

    public static void main(String[] args) {
        URL url = new URL("http://example.com/path?key=value");
        System.out.println(Arrays.toString(url.getQuery().split("&")));
    }
}

class Connection {
    public String key;
    public String value;

    public Connection(String key, String value) {
        this.key = key;
        this.value = value;
    }

    @Override
    public String toString() {
        return "key=" + key + "&value=" + value;
    }
}

class UrlBuilder {
    private String path;
    private List<String> query;

    public UrlBuilder(String path) {
        this.path = path;
    }

    public void addParameter(String key, String value) {
        if (query == null) {
            query = new ArrayList<>();
        }
        query.add(key + "=" + value);
    }

    @Override
    public String toString() {
        StringBuilder builder = new StringBuilder(path);
        for (String parameter : query) {
            builder.append("?").append(parameter);
        }
        return builder.toString();
    }
}

class KeyVal {
    private String key;
    private String value;

