public class UrlBuilderTest {

    @Test
    public void createUrlBuilderWithValidUrl() throws URISyntaxException, MalformedURLException {
        URL url = new URL("https://example.com/path?a=1&b=2#fragment");
        UrlBuilder builder = new UrlBuilder(url);
        assertEquals(builder.getU(), "https://example.com/path?a=1&b=2#fragment");
    }

    @Test
    public void createUrlBuilderWithValidQuery() throws URISyntaxException, MalformedURLException {
        URL url = new URL("https://example.com/path?a=1&b=2#fragment");
        UrlBuilder builder = new UrlBuilder(url);
        assertEquals(builder.getQ(), "a=1&b=2");
    }

    @Test
    public void createUrlBuilderWithValidFragment() throws URISyntaxException, MalformedURLException {
        URL url = new URL("https://example.com/path?a=1&b=2#fragment");
        UrlBuilder builder = new UrlBuilder(url);
        assertEquals(builder.getFragment(), "fragment");
    }

    @Test
    public void appendToAsciiWorksCorrectly() throws UnsupportedEncodingException {
        UrlBuilder builder = new UrlBuilder(new URL("https://example.com/path"));
        StringBuilder sb = new StringBuilder();
        builder.appendToAscii("Hello World", true, sb);
        assertEquals(sb.toString(), "Hello%20World");
    }

    @Test
    public void setQWorksCorrectly() throws UnsupportedEncodingException {
        URL url = new URL("https://example.com/path");
        UrlBuilder builder = new UrlBuilder(url);
        builder.setQ("New Value");
        assertEquals(builder.getQ(), "a=1&b=2&q=New%20Value");
    }

    @Test
    public void getQWorksCorrectly() throws UnsupportedEncodingException {
        URL url = new URL("https://example.com/path");
        UrlBuilder builder = new UrlBuilder(url);
        builder.setQ("New Value");
        assertEquals(builder.getQ(), "a=1&b=2&q=New%20Value");
    }

    @Test
    public void testKeyVal() {
        KeyVal keyVal = new KeyVal(123);
        assertEquals(keyVal.toString(), "123");
    }
}
