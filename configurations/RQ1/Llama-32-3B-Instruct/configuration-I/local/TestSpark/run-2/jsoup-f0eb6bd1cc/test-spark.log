public class UrlBuilder {
    private URL url;

    public UrlBuilder(URL url) {
        this.url = url;
    }

    public String getU() {
        return url.toString();
    }

    public String getQuery() throws URISyntaxException, MalformedURLException {
        URI uri = new URI(url.getProtocol(), url.getHost(), url.getPath(), null);
        if (uri.getQuery() != null && !uri.getQuery().isEmpty()) {
            return uri.getQuery();
        } else {
            return "";
        }
    }

    public String getFragment() throws URISyntaxException, MalformedURLException {
        URI uri = new URI(url.getProtocol(), url.getHost(), url.getPath(), url.getFragment());
        if (uri.getFragment() != null) {
            return uri.getFragment();
        } else {
            return "";
        }
    }

    public void appendToAscii(String s, boolean escapeChar, StringBuilder sb) throws UnsupportedEncodingException {
        if (escapeChar) {
            String encoded = URLEncoder.encode(s, StandardCharsets.UTF_8.toString());
            sb.append(encoded);
        } else {
            sb.append(s);
        }
    }

    public void setQ(String q) throws UnsupportedEncodingException {
        StringBuilder query = new StringBuilder(url.getQuery());
        query.append("&q=").append(q);
        url.setQuery(query.toString());
    }

    public String getQ() throws UnsupportedEncodingException {
        return URLEncoder.encode(url.getQuery(), StandardCharsets.UTF_8.toString());
    }
}

