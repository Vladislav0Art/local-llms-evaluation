import java.util.*;

public class CommentsConfiguration {
    private Map<String, List<String>> commentMap;

    public void setComment(String key, List<String> value) {
        if (commentMap == null) {
            commentMap = new HashMap<>();
        }
        commentMap.put(key, value);
    }

    public List<String> getComments() {
        return commentMap != null ? commentMap.values().iterator().next() : Collections.emptyList();
    }

    public Map<String, @UnmodifiableView List<String>> getAllComments() {
        if (commentMap == null) {
            return Collections.emptyMap();
        }
        return Collections.unmodifiableMap(new HashMap<>(commentMap));
    }

    public static void main(String[] args) {
        CommentsConfiguration comments = new CommentsConfiguration();

        // Test 1
        comments.setComment("key1", Arrays.asList("line1", "line2"));
        assertEquals(Arrays.asList("line1"), comments.getComments());
        assertEquals(Collections.singletonList("newLine"), comments.getComments().get("key1"));
        Map<String, @UnmodifiableView List<String>> result = comments.getAllComments();
        assertEquals(1, result.size());
        assertEquals(Arrays.asList("line1"), result.values().iterator().next());

        // Test 2
        comments.setComment("key3", Arrays.asList("newLine"));
        Map<String, @UnmodifiableView List<String>> result2 = comments.getAllComments();
        assertEquals(2, result2.size());
    }
