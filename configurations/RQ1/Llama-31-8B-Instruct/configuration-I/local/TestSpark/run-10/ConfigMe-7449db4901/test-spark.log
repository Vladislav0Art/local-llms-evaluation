    @Test
    public void constructorWithMapTest() {
        Map<String, List<String>> comments = new HashMap<>();
        comments.put("path", Arrays.asList("line1", "line2"));
        commentsConfiguration = new CommentsConfiguration(comments);
        assertEquals(comments, commentsConfiguration.comments);
    }

    @Test
    public void constructorWithoutMapTest() {
        commentsConfiguration = new CommentsConfiguration();
        assertEquals(Collections.emptyMap(), commentsConfiguration.comments);
    }

    @Test
    public void setCommentTest() {
        commentsConfiguration = new CommentsConfiguration();
        commentsConfiguration.setComment("path", "line1", "line2");
        assertEquals(Arrays.asList("line1", "line2"), commentsConfiguration.comments.get("path"));
    }

    @Test
    public void setCommentWithEmptyLineTest() {
        commentsConfiguration = new CommentsConfiguration();
        commentsConfiguration.setComment("path", "\n");
        assertEquals(Collections.emptyList(), commentsConfiguration.comments.get("path"));
    }

    @Test
    public void setCommentWithExistingPathTest() {
        commentsConfiguration = new CommentsConfiguration();
        commentsConfiguration.setComment("path", "line1");
        commentsConfiguration.setComment("path", "line2");
        assertEquals(Arrays.asList("line1", "line2"), commentsConfiguration.comments.get("path"));
    }

    @Test
    public void setCommentWithNullPathTest() {
        assertThrows(NullPointerException.class, () -> commentsConfiguration.setComment(null, "line1"));
    }

