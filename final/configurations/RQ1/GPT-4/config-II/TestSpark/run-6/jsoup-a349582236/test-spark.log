import org.jsoup.parser.ParseSettings;
import org.jsoup.parser.Tag;
import org.junit.Test;

import static org.junit.Assert.*;

public class TagTest {
    
    @Test
    public void getNameTest() {
        Tag tag = Tag.valueOf("p");
        assertEquals("p", tag.getName());
    }

    @Test
    public void normalNameTest() {
        Tag tag = Tag.valueOf("P");
        assertEquals("p", tag.normalName());
    }

    @Test
    public void valueOfWithSettingsTest() {
        Tag tag = Tag.valueOf("P", ParseSettings.lowerCase);
        assertEquals("p", tag.getName());
    }

    @Test(expected = IllegalArgumentException.class)
    public void valueOfWithNullTagNameTest() {
        Tag.valueOf(null, ParseSettings.lowerCase);
    }

    @Test(expected = IllegalArgumentException.class)
    public void valueOfWithEmptyTagNameTest() {
        Tag.valueOf("", ParseSettings.lowerCase);
    }

    @Test
    public void valueOfTest() {
        Tag tag = Tag.valueOf("p");
        assertEquals("p", tag.getName());
    }

    @Test
    public void isBlockBlockTagTest() {
        Tag tag = Tag.valueOf("p");
        assertTrue(tag.isBlock());
    }

    @Test
    public void isBlockInlineTagTest() {
        Tag tag = Tag.valueOf("a");
        assertFalse(tag.isBlock());
    }

    @Test
    public void formatAsBlockBlockTagTest() {
        Tag tag = Tag.valueOf("p");
        assertTrue(tag.formatAsBlock());
    }

    @Test
    public void formatAsBlockInlineTagTest() {
        Tag tag = Tag.valueOf("a");
        assertFalse(tag.formatAsBlock());
    }

    @Test
    public void isInlineBlockTagTest() {
        Tag tag = Tag.valueOf("p");
        assertFalse(tag.isInline());
    }

    @Test
    public void isInlineInlineTagTest() {
        Tag tag = Tag.valueOf("a");
        assertTrue(tag.isInline());
    }

    @Test
    public void isEmptyNotEmptyTagTest() {
        Tag tag = Tag.valueOf("p");
        assertFalse(tag.isEmpty());
    }

    @Test
    public void isEmptyEmptyTagTest() {
        Tag tag = Tag.valueOf("img");
        assertTrue(tag.isEmpty());
    }

    @Test
    public void isSelfClosingNotSelfClosingTagTest() {
        Tag tag = Tag.valueOf("p");
        assertFalse(tag.isSelfClosing());
    }

    @Test
    public void isSelfClosingSelfClosingTagTest() {
        Tag tag = Tag.valueOf("img");
        assertTrue(tag.isSelfClosing());
    }
    
    @Test
    public void isKnownTagKnownTagTest() {
        assertTrue(Tag.isKnownTag("p"));
    }

    @Test
    public void isKnownTagUnknownTagTest() {
        assertFalse(Tag.isKnownTag("mytag"));
    }

    @Test
    public void preserveWhitespacePreserveTagTest() {
        Tag tag = Tag.valueOf("pre");
        assertTrue(tag.preserveWhitespace());
    }

    @Test
    public void preserveWhitespaceNonPreserveTagTest() {
        Tag tag = Tag.valueOf("p");
        assertFalse(tag.preserveWhitespace());
    }

    @Test
    public void isFormListedFormListedTagTest() {
        Tag tag = Tag.valueOf("input");
        assertTrue(tag.isFormListed());
    }

    @Test
    public void isFormListedNonFormListedTagTest() {
        Tag tag = Tag.valueOf("p");
        assertFalse(tag.isFormListed());
    }

    @Test
    public void isFormSubmittableFormSubmittableTagTest() {
        Tag tag = Tag.valueOf("input");
        assertTrue(tag.isFormSubmittable());
    }

    @Test
    public void isFormSubmittableNonFormSubmittableTagTest() {
        Tag tag = Tag.valueOf("p");
        assertFalse(tag.isFormSubmittable());
    }

    @Test
    public void tagsEqualityTest() {
        Tag tag1 = Tag.valueOf("p");
        Tag tag2 = Tag.valueOf("p");
        assertEquals(tag1, tag2);
        assertEquals(tag1.hashCode(), tag2.hashCode());
    }

    @Test
    public void tagsInequalityTest() {
        Tag tag1 = Tag.valueOf("p");
        Tag tag2 = Tag.valueOf("div");
        assertNotEquals(tag1, tag2);
        assertNotEquals(tag1.hashCode(), tag2.hashCode());
    }
}
