import org.jsoup.nodes.Document;
import org.jsoup.parser.*;
import org.junit.Test;

import java.io.StringReader;
import java.util.List;

import static org.junit.Assert.*;

public class XmlTreeBuilderTest {

    @Test
    public void initialParseTest() {
        XmlTreeBuilder builder = new XmlTreeBuilder();
        builder.initialParse(new StringReader("<p>hello</p>"), "http://www.test.com", new Parser(builder));
        assertTrue(builder.stack.size() > 0);
    }

    @Test
    public void parseTest() {
        XmlTreeBuilder builder = new XmlTreeBuilder();
        Document doc = builder.parse(new StringReader("<p>hello</p>"), "http://www.test.com");
        assertEquals("http://www.test.com", doc.baseUri());
    }

    @Test
    public void newInstanceTest() {
        XmlTreeBuilder builder = new XmlTreeBuilder();
        assertTrue(builder.newInstance() instanceof XmlTreeBuilder);
    }

    @Test(expected = IllegalStateException.class)
    public void processInvalidTokenTest() {
        Token token = new Token();
        XmlTreeBuilder builder = new XmlTreeBuilder();
        builder.process(token);
    }

    @Test
