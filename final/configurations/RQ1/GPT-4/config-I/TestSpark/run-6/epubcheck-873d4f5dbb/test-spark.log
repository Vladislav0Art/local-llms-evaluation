  public OPFChecker30(ValidationContext context)
  {
    super(context);
  }

  @Override
  public void initHandler()
  {
    opfHandler = new OPFHandler30(context);
  }

  @Override
  protected boolean checkPackage()
  {
    super.checkPackage();
    checkCollectionsContent();
    checkPagination();
    checkSemantics();
    checkNav();
    checkSpecifics();
    return false;
