    public void insertNodeTest() {
        XmlTreeBuilder builder = new XmlTreeBuilder();
        Element element = new Element(Tag.valueOf("test"), "");
        builder.insertNode(element);
        Assert.assertEquals(element, builder.getStack().get(0).childNode(0));
    }

    @Test
    public void insertStartTagTest() {
        XmlTreeBuilder builder = new XmlTreeBuilder();
        Token.StartTag startTag = new Token.StartTag();
        startTag.name("tag");
        Element element = builder.insert(startTag);
        Assert.assertNotNull(element);
    }

    @Test
    public void insertCommentTest() {
        XmlTreeBuilder builder = new XmlTreeBuilder();
        Token.Comment comment = new Token.Comment();
        comment.data("<?xml version=\"1.0\" encoding=\"UTF-8\"?>");
        builder.insert(comment);
        Assert.assertEquals(XmlDeclaration.class, builder.getStack().get(0).childNode(0).getClass());
    }

    @Test
    public void insertBogusCommentTest() {
        XmlTreeBuilder builder = new XmlTreeBuilder();
        Token.Comment comment = new Token.Comment();
        comment.data("<!--bogusComment-->");
        comment.bogus(true);
        builder.insert(comment);
        Assert.assertEquals(Comment.class, builder.getStack().get(0).childNode(0).getClass());
    }

    @Test
