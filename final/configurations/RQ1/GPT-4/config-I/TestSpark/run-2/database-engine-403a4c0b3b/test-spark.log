        Hashtable<String, Object> columnValues = new Hashtable<>();
        app.updateTable("table1", "key1", columnValues);
        verify(app, times(1)).takeAction(Action.UPDATE, "table1", columnValues);
    }

    @Test
    public void deleteFromTableTest() throws DBAppException {
        DBApp app = spy(DBApp.class);
        doNothing().when(app).takeAction(any(), anyString(), any());
        Hashtable<String, Object> columnValues = new Hashtable<>();
        app.deleteFromTable("table1", columnValues);
        verify(app, times(1)).takeAction(Action.DELETE, "table1", columnValues);
    }

    @Test
    public void getReaderTest() {
        DBApp app = new DBApp();
        assertEquals(app.getReader().getClass(), CsvReader.class);
    }

    @Test
    public void getWriterTest() {
        DBApp app = new DBApp();
        assertSame(app.getWriter().getClass(), CsvWriter.class);
    }
}
