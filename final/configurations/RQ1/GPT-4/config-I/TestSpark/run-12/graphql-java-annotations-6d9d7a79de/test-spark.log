, 	@Test
	public void buildDirectiveSuccessTest() {
		GraphQLDirective directive = GraphQLDirective.newDirective().name("name").argument(
		GraphQLArgument.newArgument().name("arg1").type(scalarType).build()).build();
		DirectivesBuilder builder = new DirectivesBuilder(MyClass2.class, container);
		
		Map<String, GraphQLDirective> registry = new HashMap<>();
		registry.put("name", directive);
		when(container.getDirectiveRegistry()).thenReturn(registry);
		
		GraphQLDirective[] directives = builder.build();
		
		assertEquals(1, directives.length);
		assertEquals("name", directives[0].getName());
	}
, 	@Test
