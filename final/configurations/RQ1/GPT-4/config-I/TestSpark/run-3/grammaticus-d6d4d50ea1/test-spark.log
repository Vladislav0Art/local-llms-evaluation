        assertFalse(map.isSkinny());
    }

    @Test
    public void makeSkinnyTest() {
        GrammaticalTermMapImpl<GrammaticalTerm> map = new GrammaticalTermMapImpl<>();
        map = map.makeSkinny();
        assertTrue(map.isSkinny());
    }

    @Test
    public void putNotSkinnyMapTest() {
