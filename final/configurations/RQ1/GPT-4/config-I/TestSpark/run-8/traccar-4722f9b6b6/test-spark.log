import org.junit.Test;
import org.traccar.Protocol;
import org.traccar.ProtocolDecoder;
import org.traccar.SessionKeys;
import org.traccar.database.IdentityManager;
import org.traccar.helper.UnitsConverter;
import org.traccar.model.Position;

import java.nio.charset.StandardCharsets;

import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;

public class WatchProtocolDecoderTest {

   private ProtocolDecoder decoder;
   
   private ProtocolDecoder createDecoder() {
       Protocol protocol = new Protocol("watch") {
           @Override
           public String getUniqueIdPrefix() {
               return "watch";
           }
       };
       
       WatchProtocolDecoder decoder = new WatchProtocolDecoder(protocol);

       IdentityManager identityManager = mock(IdentityManager.class);
       when(identityManager.getByUniqueId("123456789012345")).thenReturn(null);
       when(identityManager.getByUniqueId("watch123456789012345")).thenReturn(null);

       Channel channel = mock(Channel.class);
       when(channel.attr(SessionKeys.IDENTITY_MANAGER)).thenReturn(new Attribute<>(identityManager));

       return decoder;
   }
   
   @Test
   public void decodePositionValidTest() {
       decoder = createDecoder();
       decoder.decodePosition(null, "010218,121800,A,3937.3032,N,02344.9124,E,0.00,0.0,0.0,7,255,3,523,x20,");
   }

   @Test
   public void decodePositionInvalidTest() {
       decoder = createDecoder();
       assertNull(decoder.decodePosition(null, "INVALID,DATA"));
   }

   @Test
   public void decodeAlarmNoAlarmBitTest() {
       decoder = createDecoder();
       assertNull(decoder.decodeAlarm(0));
   }

   @Test
   public void decodeAlarmLowBatteryBitTest() {
       decoder = createDecoder();
       assertEquals(Position.ALARM_LOW_BATTERY, decoder.decodeAlarm(1));
   }

   @Test
   public void decodeAlarmGeofenceExitBitTest() {
       decoder = createDecoder();
       assertEquals(Position.ALARM_GEOFENCE_EXIT, decoder.decodeAlarm(2));
   }

   @Test
   public void decodeAlarmPowerCutBitTest() {
       decoder = createDecoder();
       assertEquals(Position.ALARM_POWER_CUT, decoder.decodeAlarm(16384));
   }

   @Test
   public void decodeAlarmSOSBitTest() {
       decoder = createDecoder();
       assertEquals(Position.ALARM_SOS, decoder.decodeAlarm(65536));
   }

   @Test
   public void decodeAlarmGeofenceExitBit2Test() {
       decoder = createDecoder();
       assertEquals(Position.ALARM_GEOFENCE_EXIT, decoder.decodeAlarm(262144));
   }

   @Test
   public void decodeAlarmFallDownBitTest() {
       decoder = createDecoder();
       assertEquals(Position.ALARM_FALL_DOWN, decoder.decodeAlarm(2097152));
   }

   @Test
   public void decodeMessageLKLocationUpdateTest() {
       decoder = createDecoder();
       String message = "[3G*123456789012345*002A*LK,120,20,90,1,,,,,,,,FFFF$]";
       Position decodedPosition = (Position) decoder.decode(null, null, message.getBytes(StandardCharsets.US_ASCII));
       assertNotNull(decodedPosition);
       assertEquals(90, decodedPosition.getInt(Position.KEY_BATTERY_LEVEL));
       assertEquals(120, decodedPosition.getInt(Position.KEY_STEPS));
   }

   @Test
   public void decodeMessageLKEarthquakeAlarmTest() {
       decoder = createDecoder();
       String message = "[3G*4901533724*0000*AL,2]";
       Position decodedPosition = (Position) decoder.decode(null, null, message.getBytes(StandardCharsets.US_ASCII));
       assertNotNull(decodedPosition);
       assertEquals(Position.ALARM_EARTHQUAKE, decodedPosition.getString(Position.KEY_ALARM));
   }
}
