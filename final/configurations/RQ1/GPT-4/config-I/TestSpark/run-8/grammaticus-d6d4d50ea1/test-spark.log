        assertTrue(termMap.isEmpty());
    }

    @Test
    public void GrammaticalTermMapImplConstructorWithMapTest() {
        Map<String, GrammaticalTerm> map = new HashMap<>();
        map.put("test", new GrammaticalTermMock("test"));
        GrammaticalTermMapImpl<GrammaticalTerm> termMap = new GrammaticalTermMapImpl<>(map, false);
        assertEquals(1, termMap.values().size());
    }

    @Test
    public void equalsDifferentTypesTest() {
        GrammaticalTermMapImpl<GrammaticalTerm> termMap = new GrammaticalTermMapImpl<>();
        assertNotEquals(termMap, new Object());
    }

    @Test
    public void hashCodeTest() {
        GrammaticalTermMapImpl<GrammaticalTerm> termMap = new GrammaticalTermMapImpl<>();
        int expected = new HashMap<String, GrammaticalTerm>().hashCode();
        assertEquals(expected, termMap.hashCode());
    }

