import org.jsoup.nodes.*;
import org.jsoup.parser.Token.*;

import org.junit.Test;

import java.io.StringReader;

import static org.junit.Assert.*;

public class XmlTreeBuilderTest {
    @Test
    public void InitialiseParseTest() {
        XmlTreeBuilder testObject = new XmlTreeBuilder();
        testObject.initialiseParse(new StringReader("<fruit>Apple</fruit>"), "BaseUri", new Parser(testObject));
        assertNotNull(testObject.getStack());
        Document.OutputSettings outputSettings = testObject.getStack().get(0).outputSettings();
        assertEquals(Document.OutputSettings.Syntax.xml, outputSettings.syntax());
        assertEquals(Entities.EscapeMode.xhtml, outputSettings.escapeMode());
        assertFalse(outputSettings.prettyPrint());
    }

    @Test
    public void NewInstanceTest() {
        XmlTreeBuilder testObject = new XmlTreeBuilder();
        assertNotNull(testObject.newInstance());
    }

    @Test
    public void ProcessStartTagTest() {
        XmlTreeBuilder testObject = new XmlTreeBuilder();
        StartTag startTag = new StartTag("test");
        Token testToken = new Token(startTag);
        assertTrue(testObject.process(testToken));
    }

    @Test
