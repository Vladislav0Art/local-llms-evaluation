    public void getXdrPublicKeyTest() {
        KeyPair keyPair = KeyPair.random();
        PublicKey publicKey = keyPair.getXdrPublicKey();
        Assert.assertEquals(publicKey.getEd25519().getUint256(), keyPair.getPublicKey());
    }

    @Test
    public void fromXdrPublicKeyTest() {
        KeyPair keyPair = KeyPair.random();
        PublicKey xdrPubKey = keyPair.getXdrPublicKey();
        KeyPair newKeyPair = KeyPair.fromXdrPublicKey(xdrPubKey);
        Assert.assertEquals(newKeyPair.getPublicKey(), keyPair.getPublicKey());
    }

}
