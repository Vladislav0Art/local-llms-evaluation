    public void fromAccountIdTest() {
        KeyPair keyPair = KeyPair.fromAccountId("GBHCUCIKKL4SYXZC2Q4ZPQAOL5TBFJYVSC6BGVHVWVJMLEOEAWE7J7PX");
        Assert.assertNotNull(keyPair);
    }

    @Test
    public void getAccountIdTest() {
        KeyPair keyPair = KeyPair.random();
        Assert.assertTrue(StrKey.isValidStellarAccountId(keyPair.getAccountId()));
    }

    @Test
    public void getSecretSeedTest() {
        String seed = "SC35MLOO5MTOGSYVEQVJOSXX4CBS55ZNHP5D5QBIUZSG2DSJYZFNFN7E";
        KeyPair keyPair = KeyPair.fromSecretSeed(seed);
        Assert.assertNotEquals(0, keyPair.getSecretSeed().length);
    }

    @Test
