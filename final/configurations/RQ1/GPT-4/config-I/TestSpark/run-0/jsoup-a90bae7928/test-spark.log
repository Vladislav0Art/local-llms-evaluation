import org.junit.Test;

import java.io.StringReader;
import java.util.List;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertFalse;
import static org.junit.Assert.assertTrue;

public class XmlTreeBuilderTest {

    @Test
    public void parseTest() {
        XmlTreeBuilder xmlTreeBuilder = new XmlTreeBuilder();
        String input = "<doc><element /></doc>";
        String baseUri = "http://example.com";

        Document document = xmlTreeBuilder.parse(new StringReader(input), baseUri);

        assertNotNull(document);
        assertEquals(1, document.childNodeSize());
        assertEquals("doc", document.childNode(0).nodeName());
    }

    @Test
    public void processTest() {
        XmlTreeBuilder xmlTreeBuilder = new XmlTreeBuilder();
        Token tokenStartTag = new Token.StartTag();
        tokenStartTag.tagName("p");

        assertTrue(xmlTreeBuilder.process(tokenStartTag));
    }

    @Test
    public void popStackToCloseTest() {
        XmlTreeBuilder xmlTreeBuilder = new XmlTreeBuilder();
        Token tokenStartTag = new Token.StartTag();
        tokenStartTag.tagName("p");
        xmlTreeBuilder.process(tokenStartTag);

        Token tokenEndTag = new Token.EndTag();
        tokenEndTag.tagName("p");

        assertFalse(xmlTreeBuilder.process(tokenEndTag));
    }

    @Test
    public void parseFragmentTest() {
        XmlTreeBuilder xmlTreeBuilder = new XmlTreeBuilder();
        String inputFragment = "<p>Fragment</p>";
        String baseUri = "http://example.com";
        Parser parser = Parser.xmlParser();

        List fragmentNodes = xmlTreeBuilder.parseFragment(inputFragment, baseUri, parser);
        assertFalse(fragmentNodes.isEmpty());
        assertEquals("p", fragmentNodes.get(0).nodeName()); 
    }
}
