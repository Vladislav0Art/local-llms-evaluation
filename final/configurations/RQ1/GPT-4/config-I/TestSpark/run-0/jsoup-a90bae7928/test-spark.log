        xmlTreeBuilder.getStack().add(el);

        Token.EndTag endTag = new Token.EndTag();
        endTag.tagName = "element";
        xmlTreeBuilder.popStackToClose(endTag);

        assertEquals(0, xmlTreeBuilder.getStack().size());
    }
}
