import org.davidmoten.text.utils.WordWrap;
import org.davidmoten.text.utils.WordWrap.Builder;
import org.junit.Test;

import java.io.File;
import java.io.StringReader;
import java.nio.charset.Charset;
import java.nio.charset.StandardCharsets;
import java.util.HashSet;
import java.util.Set;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertNotNull;

public class WordWrapTest {
    
    @Test
    public void fromReaderTest() {
        Builder builder = WordWrap.from(new StringReader("test"));
        assertNotNull(builder);
    }

    @Test
    public void fromClasspathUtf8Test() {
        Builder builder = WordWrap.fromClasspathUtf8("resource");
        assertNotNull(builder);
    }

    @Test
    public void fromClasspathTest() {
        Builder builder = WordWrap.fromClasspath("resource", StandardCharsets.UTF_16);
        assertNotNull(builder);
    }

    @Test
    public void fromCharSequenceTest() {
        Builder builder = WordWrap.from("test");
        assertNotNull(builder);
    }

    @Test
    public void fromUtf8Test() {
        Builder builder = WordWrap.fromUtf8(System.in);
        assertNotNull(builder);
    }

    @Test
    public void fromInputStreamCharsetTest() {
        Builder builder = WordWrap.from(System.in, StandardCharsets.UTF_16);
        assertNotNull(builder);
    }

    @Test
    public void fromFileCharsetTest() {
        Builder builder = WordWrap.from(new File("test.txt"), StandardCharsets.UTF_16);
        assertNotNull(builder);
    }

    @Test
    public void maxWidthTest() {
        Builder builder = WordWrap.from("test");
        builder.maxWidth(50);
        assertEquals(builder.maxWidth,50);
    }

    @Test
    public void stringWidthTest() {
        Function<? super CharSequence, ? extends Number> stringWidth = (s -> s.length());
        Builder builder = WordWrap.from("test");
        builder.stringWidth(stringWidth);
        assertEquals(builder.stringWidth, stringWidth);
    }

    @Test
    public void newLineTest() {
        Builder builder = WordWrap.from("test");
        builder.newLine("test");
        assertEquals(builder.newLine, "test");
    }

    @Test
    public void extraWordCharsTest() {
        Set<Character> extraWordChars = new HashSet<>();
        extraWordChars.add('t');
        Builder builder = WordWrap.from("test");
        builder.extraWordChars(extraWordChars);
        assertEquals(builder.extraWordChars, extraWordChars);
    }

    @Test
    public void extraWordCharsStringTest() {
        Builder builder = WordWrap.from("test");
        builder.extraWordChars("test");
        assertEquals(builder.extraWordChars, new HashSet(Arrays.asList('t','e','s','t')));
    }

    @Test
    public void includeExtraWordCharsTest() {
        Builder builder = WordWrap.from("test");
        builder.includeExtraWordChars("word");
        assertEquals(builder.extraWordChars, new HashSet(Arrays.asList('\"','t','\'','\u2018','\u2019','\u201C','t','\u201D','?','e',',','/',':', '_','w','o','r','d')));
    }

    @Test
    public void excludeExtraWordCharsTest() {
        Builder builder = WordWrap.from("test");
        builder.excludeExtraWordChars("chars");
        assertEquals(builder.extraWordChars, new HashSet(Arrays.asList('\"','t','\'','\u2018','\u2019','\u201C','\u201D','?',',','/',':', '_')));
    }

    @Test
    public void insertHyphensTest() {
        Builder builder = WordWrap.from("test");
        builder.insertHyphens(true);
        assertEquals(builder.insertHyphens, true);
    }
   
    @Test
    public void breakWordsTest() {
        Builder builder = WordWrap.from("test");
        builder.breakWords(true);
        assertEquals(builder.breakWords, true);
    }
   
    @Test
    public void wrapTest() {
        Builder builder = WordWrap.from("test");
        String result = builder.wrap();
        assertEquals(result, "test");
    }
}
