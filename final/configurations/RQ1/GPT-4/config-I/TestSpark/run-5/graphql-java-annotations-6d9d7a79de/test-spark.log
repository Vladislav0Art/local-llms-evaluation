import org.junit.Test;
import org.mockito.Mockito;

import java.lang.annotation.Annotation;
import java.lang.reflect.Field;
import java.util.Arrays;

import graphql.annotations.processor.ProcessingElementsContainer;
import graphql.annotations.processor.exceptions.GraphQLAnnotationsException;
import graphql.annotations.processor.retrievers.fieldBuilders.DirectivesBuilder;
import graphql.schema.GraphQLArgument;
import graphql.schema.GraphQLDirective;
import graphql.schema.GraphQLScalarType;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertArrayEquals;

public class DirectivesBuilderTest {

    @Test(expected = GraphQLAnnotationsException.class)
    public void buildNoDirectiveInRegistryTest() {
        ProcessingElementsContainer container = Mockito.mock(ProcessingElementsContainer.class);
        Field object = Mockito.mock(Field.class);
        DirectivesBuilder builder = new DirectivesBuilder(object, container);

        builder.build();
    }

    @Test
    public void buildOneDirectiveTest() throws Exception {
        ProcessingElementsContainer container = Mockito.mock(ProcessingElementsContainer.class);
        Field object = Mockito.mock(Field.class);
        DirectivesBuilder builder = new DirectivesBuilder(object, container);

        GraphQLDirective.GraphQLDirectiveBuilder directiveBuilder = GraphQLDirective.newDirective();
        GraphQLDirective directive = directiveBuilder.name("someDirective").build();
        GraphQLArgument argument = GraphQLArgument.newArgument().name("arg").type(GraphQLScalarType.newScalar().name("scalar").build()).build();

        Mockito.when(container.getDirectiveRegistry()).thenReturn(Mockito.mock(DirectiveRegistry.class));
        Mockito.when(container.getDirectiveRegistry().get("someDirective")).thenReturn(directive);
        directive = directive.transform(b -> b.argument(argument));

        GraphQLDirective[] result = builder.build();

        assertEquals(1, result.length);
        assertArrayEquals(new GraphQLDirective[]{directive}, result);
    }

    @Test(expected = GraphQLAnnotationsException.class)
    public void buildTooMuchArgumentsErrorTest() throws Exception {
        ProcessingElementsContainer container = Mockito.mock(ProcessingElementsContainer.class);
        Field object = Mockito.mock(Field.class);
        DirectivesBuilder builder = new DirectivesBuilder(object, container);

        GraphQLDirective directive = GraphQLDirective.newDirective().name("someDirective").build();

        Mockito.when(container.getDirectiveRegistry()).thenReturn(Mockito.mock(DirectiveRegistry.class));
        Mockito.when(container.getDirectiveRegistry().get("someDirective")).thenReturn(directive);

        Annotation directiveArgument = new DirectiveArgument() {
            @Override
            public Class<? extends Annotation> annotationType() {
                return DirectiveArgument.class;
            }

            @Override
            public String name() {
                return "someDirective";
            }

            @Override
            public String[] argumentsValues() {
                return new String[]{"arg1", "arg2"};
            }
        };

        builder.build();
    }

    public interface DirectiveArgument extends Annotation {
        String name();

        String[] argumentsValues();
    }
