import io.github.vmzakharov.ecdataframe.dsl.AnonymousScript;
import io.github.vmzakharov.ecdataframe.dsl.BinaryOp;
import io.github.vmzakharov.ecdataframe.dsl.Expression;
import io.github.vmzakharov.ecdataframe.dsl.value.Value;
import io.github.vmzakharov.ecdataframe.dsl.visitor.PrettyPrintVisitor;
import io.github.vmzakharov.ecdataframe.util.CollectingPrinter;
import org.junit.Assert;
import org.junit.Test;
import org.mockito.Mockito;

import java.util.List;

public class PrettyPrintVisitorTest {

    @Test
    public void exprToStringTest() {
        Expression e = Mockito.mock(Expression.class);
        Mockito.doAnswer(invocationOnMock -> {
            PrettyPrintVisitor prettyPrintVisitor = (PrettyPrintVisitor) invocationOnMock.getArguments()[0];
            prettyPrintVisitor.visitVarExpr(() -> "mockVar");
            return null;
        }).when(e).accept(Mockito.any(PrettyPrintVisitor.class));

        Assert.assertEquals("mockVar", PrettyPrintVisitor.exprToString(e));
    }

    @Test
    public void visitVarExprTest() {
        CollectingPrinter printer = new CollectingPrinter();
        new PrettyPrintVisitor(printer).visitVarExpr(() -> "testVar");
        Assert.assertEquals("testVar", printer.toString());
    }

    @Test
    public void visitBinaryExprTest() {
        CollectingPrinter printer = new CollectingPrinter();
        AnonymousScript operand1 = new AnonymousScript(null, List.of(() -> "operand1"));
        AnonymousScript operand2 = new AnonymousScript(null, List.of(() -> "operand2"));
        new PrettyPrintVisitor(printer).visitBinaryExpr(new BinaryOp(null, operand1, "+", operand2));
        Assert.assertEquals("(operand1 + operand2)", printer.toString());
    }

    @Test
    public void visitAssignExprTest() {
        CollectingPrinter printer = new CollectingPrinter();
        Value value = () -> "testVal";
        new PrettyPrintVisitor(printer).visitAssignExpr(new AssignExpr(null, "testVar", false, value));
        Assert.assertEquals("testVar = testVal", printer.toString());
    }

}
