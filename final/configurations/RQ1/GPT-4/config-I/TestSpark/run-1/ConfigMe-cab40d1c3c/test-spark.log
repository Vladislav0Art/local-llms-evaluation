import ch.jalu.configme.exception.ConfigMeException;
import ch.jalu.configme.properties.Property;
import ch.jalu.configme.properties.Types;
import org.junit.Test;
import java.lang.reflect.Field;
import java.util.List;
import java.util.Map;
import static org.junit.Assert.*;

public class PropertyListBuilderTest {

    @Test
    public void addPropertySinglePathTest() {
        PropertyListBuilder builder = new PropertyListBuilder();
        Property<?> property = new Property<>("test", Types.STRING);
        builder.add(property);
        assertNotNull(getPropertyRootEntries(builder).get("test"));
    }

    @Test
    public void addPropertyNestedPathTest() {
        PropertyListBuilder builder = new PropertyListBuilder();
        Property<?> property = new Property<>("test.path", Types.STRING);
        builder.add(property);
        assertNotNull(((Map<String, Object>) getPropertyRootEntries(builder).get("test")).get("path"));
    }
    
    @Test(expected = ConfigMeException.class)
    public void addPropertyWithExistingPathTest() {
        PropertyListBuilder builder = new PropertyListBuilder();
        Property<?> property1 = new Property<>("test", Types.STRING);
        Property<?> property2 = new Property<>("test", Types.STRING);
        builder.add(property1);
        builder.add(property2);
    }

    @Test
    public void createPropertyListTest() {
        PropertyListBuilder builder = new PropertyListBuilder();
        Property<?> property = new Property<>("test.path", Types.STRING);
        builder.add(property);
        List<Property<?>> properties = builder.create();
        assertTrue(properties.contains(property));
    }

    @Test
    public void getRootEntriesTest() {
        PropertyListBuilder builder = new PropertyListBuilder();
        Property<?> property = new Property<>("test", Types.STRING);
        builder.add(property);
        assertEquals(property, ((Map<String, Object>) getPropertyRootEntries(builder)).get("test"));
    }

    private Map<String, Object> getPropertyRootEntries(PropertyListBuilder builder) {
        try {
            Field field = PropertyListBuilder.class.getDeclaredField("rootEntries");
            field.setAccessible(true);
            return (Map<String, Object>) field.get(builder);
        } catch (NoSuchFieldException | IllegalAccessException ex) {
            throw new RuntimeException("Failed to get rootEntries via reflection", ex);
        }
    }
}
