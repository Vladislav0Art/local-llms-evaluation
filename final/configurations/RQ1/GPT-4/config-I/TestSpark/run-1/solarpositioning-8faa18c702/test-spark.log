        assertEquals(2825.27151, result, 0.0001);
    }

    @Test
    public void estimateYearFrom500To1600Test() {
        double result = DeltaT.estimate(LocalDate.of(1500, 10, 2));
        assertEquals(8582.78238, result, 0.0001);
    }

