        double result = DeltaT.estimate(LocalDate.of(1650, 3, 18));
        assertEquals(86.344056, result, 0.0001);
    }

    @Test
    public void estimateYearFrom1700To1800Test() {
        double result = DeltaT.estimate(LocalDate.of(1750, 4, 16));
        assertEquals(25.93642, result, 0.0001);
    }

    @Test
    public void estimateYearFrom1800To1860Test() {
        double result = DeltaT.estimate(LocalDate.of(1850, 6, 12));
        assertEquals(14.324267, result, 0.0001);
    }

    @Test
    public void estimateYearFrom1860To1900Test() {
        double result = DeltaT.estimate(LocalDate.of(1880, 2, 3));
        assertEquals(8.681876, result, 0.0001);
    }

    @Test
    public void estimateYearFrom1900To1920Test() {
        double result = DeltaT.estimate(LocalDate.of(1910, 9, 22));
        assertEquals(14.092025, result, 0.0001);
    }

    @Test
    public void estimateYearFrom1920To1941Test() {
        double result = DeltaT.estimate(LocalDate.of(1930, 12, 19));
        assertEquals(23.465905, result, 0.0001);
    }

    @Test
    public void estimateYearFrom1941To1961Test() {
