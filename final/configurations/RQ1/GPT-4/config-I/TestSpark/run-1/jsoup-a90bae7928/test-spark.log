    public void processUnexpectedTokenTest() {
        XmlTreeBuilder xmlTreeBuilder = new XmlTreeBuilder();
        Token token = new Token(Tag.valueOf("Test"), String.valueOf("Test"));
        xmlTreeBuilder.process(token);
    }

