import net.i2p.crypto.eddsa.EdDSAPrivateKey;
import net.i2p.crypto.eddsa.EdDSAPublicKey;
import net.i2p.crypto.eddsa.spec.EdDSAPrivateKeySpec;
import net.i2p.crypto.eddsa.EdDSANamedCurveSpec;
import org.junit.Test;
import org.stellar.sdk.KeyPair;
import org.stellar.sdk.StrKey;
import org.stellar.sdk.xdr.PublicKey;

import java.security.spec.InvalidKeySpecException;

import static org.junit.Assert.*;

public class KeyPairTest {

    private static final EdDSANamedCurveSpec ed25519 = EdDSANamedCurveTable.getByName(EdDSANamedCurveTable.ED_25519);
    private static final EdDSAPublicKey mPublicKey = new EdDSAPublicKey(new EdDSAPrivateKeySpec(new byte[32], ed25519));
    private static final EdDSAPrivateKey mPrivateKey = new EdDSAPrivateKey(new EdDSAPrivateKeySpec(new byte[32], ed25519));

    @Test
    public void KeyPairPublicKeyConstructorTest() {
        KeyPair keyPair = new KeyPair(mPublicKey);
        assertNotNull(keyPair);
        assertNotNull(keyPair.getAccountId());
        assertFalse(keyPair.canSign());
    }

    @Test
    public void KeyPairPublicKeyPrivateKeyConstructorTest() {
        KeyPair keyPair = new KeyPair(mPublicKey, mPrivateKey);
        assertNotNull(keyPair);
        assertTrue(keyPair.canSign());
    }

    @Test(expected = NullPointerException.class)
    public void KeyPairNullPublicKeyConstructorTest() {
        new KeyPair(null);
    }

    @Test
    public void fromSecretSeedCharArrayTest() {
        char[] chars = "SA6XHAH4GNLRWWWF6BTJI4SIRDTTQNV3LYL3FDZWTMX3YHBSBK3GN2ZT".toCharArray();
        KeyPair keyPair = KeyPair.fromSecretSeed(chars);
        assertNotNull(keyPair);
        assertTrue(keyPair.canSign());
    }

    @Test
    public void fromSecretSeedStringTest() {
        String seed = "SBGCD73UCY3UBKM476JJCAW7X5FXMZSJW7UNZ4VIPI7ROOEQOSJJYZRQ";
        KeyPair keyPair = KeyPair.fromSecretSeed(seed);
        assertNotNull(keyPair);
        assertTrue(keyPair.canSign());
    }

    @Test
    public void fromSecretSeedBytesTest() {
        byte[] bytes = new byte[32];
        KeyPair keyPair = KeyPair.fromSecretSeed(bytes);
        assertNotNull(keyPair);
        assertTrue(keyPair.canSign());
    }

    @Test
    public void fromAccountIdTest() {
        String accountId = "GB3C6RRLEP46VTD66ZE5DVHWWDPCDJYRDID3XGC64QL7UYVTDZSH2NPK";
        KeyPair keyPair = KeyPair.fromAccountId(accountId);
        assertNotNull(keyPair);
        assertFalse(keyPair.canSign());
    }

    @Test(expected = IllegalArgumentException.class)
    public void fromPublicKeyInvalidArgumentTest() {
        byte[] bytes = new byte[31];
        KeyPair keyPair = KeyPair.fromPublicKey(bytes);
    }

    @Test
    public void randomTest() {
        KeyPair keyPair = KeyPair.random();
        assertNotNull(keyPair);
        assertTrue(keyPair.canSign());
    }

    @Test(expected = RuntimeException.class)
    public void signWithoutPrivateKeyTest() {
        KeyPair keyPair = new KeyPair(mPublicKey);
        keyPair.sign("Test".getBytes());
    }

    @Test(expected = RuntimeException.class)
    public void verifyWithoutDataTest() {
        KeyPair keyPair = new KeyPair(mPublicKey, mPrivateKey);
        byte[] signature = keyPair.sign("Test".getBytes());
        keyPair.verify(null, signature);
    }
}
