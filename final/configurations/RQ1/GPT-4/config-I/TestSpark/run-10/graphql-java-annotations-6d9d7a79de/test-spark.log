import graphql.annotations.annotationTypes.directives.activation.Directive;
import graphql.annotations.processor.ProcessingElementsContainer;
import graphql.annotations.processor.exceptions.GraphQLAnnotationsException;
import graphql.annotations.processor.retrievers.fieldBuilders.DirectivesBuilder;
import graphql.annotations.processor.util.DirectiveInfo;
import graphql.schema.*;
import org.junit.Test;
import java.lang.reflect.Field;
import java.util.*;

import static org.mockito.Mockito.*;

public class DirectivesBuilderTest {

    // Mock a field with a directive that doesn't exist in the registry.
    @Test(expected = GraphQLAnnotationsException.class)
    public void buildWhenDirectiveNotInRegistryTest() {
        Field field = mock(Field.class);
        DirectiveInfo directiveInfoMock = mock(DirectiveInfo.class);
        when(directiveInfoMock.getName()).thenReturn("nonexistent");
        when(DirectiveJavaAnnotationUtil.getDirectiveAnnotations(field)).thenReturn(Collections.singletonList(directiveInfoMock));

        ProcessingElementsContainer container = mock(ProcessingElementsContainer.class);
        when(container.getDirectiveRegistry()).thenReturn(new HashMap<>());

        DirectivesBuilder builder = new DirectivesBuilder(field, container);
        builder.build();
    }

    // Mock a field with a directive that has more arguments than expected
    @Test(expected = GraphQLAnnotationsException.class)
    public void buildWhenTooMuchArgumentsTest() {
        Field field = mock(Field.class);
        ProcessingElementsContainer container = mock(ProcessingElementsContainer.class);

        GraphQLDirective directive = mock(GraphQLDirective.class);
        when(directive.getArguments()).thenReturn(new ArrayList<>());  // no arguments

        Map<String, DirectiveDefinition> directiveRegistry = new HashMap<>();
        DirectiveDefinition directiveDefinitionMock = mock(DirectiveDefinition.class);
        when(directiveDefinitionMock.getDirective()).thenReturn(directive);
        directiveRegistry.put("mock", directiveDefinitionMock);

        DirectiveInfo directiveInfoMock = mock(DirectiveInfo.class);
        when(directiveInfoMock.getName()).thenReturn("mock");
        when(directiveInfoMock.getArgumentValues()).thenReturn(new String[]{"extra argument"});
        
        when(DirectiveJavaAnnotationUtil.getDirectiveAnnotations(field)).thenReturn(Collections.singletonList(directiveInfoMock));
        
        when(container.getDirectiveRegistry()).thenReturn(directiveRegistry);

        DirectivesBuilder builder = new DirectivesBuilder(field, container);
        builder.build();
    }
}
