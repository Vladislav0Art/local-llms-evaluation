import io.github.vmzakharov.ecdataframe.util.Printer;
import io.github.vmzakharov.ecdataframe.util.CollectingPrinter;

import static org.junit.Assert.assertEquals;

public class PrettyPrintVisitorTest {

    // Test visitAssignExpr method
    @Test
    public void visitAssignExprTest() {
        CollectingPrinter mockPrinter = Mockito.mock(CollectingPrinter.class);
        PrettyPrintVisitor prettyPrintVisitor = new PrettyPrintVisitor(mockPrinter);
        Expression expr = Mockito.mock(Expression.class);
        AssingExpr assingExpr = new AssingExpr("testVar", expr);
        prettyPrintVisitor.visitAssignExpr(assingExpr);
        Mockito.verify(mockPrinter, Mockito.times(3)).print(Mockito.anyString());
    }

    // Test visitBinaryExpr method
    @Test
    public void visitBinaryExprTest() {
        CollectingPrinter mockPrinter = Mockito.mock(CollectingPrinter.class);
        PrettyPrintVisitor prettyPrintVisitor = new PrettyPrintVisitor(mockPrinter);
        Expression operand1 = new ValueExpr(new StringValue("operand1"));
        Expression operand2 = new ValueExpr(new StringValue("operand2"));
        BinaryExpr binaryExpr = new BinaryExpr(operand1, BinaryOp.ADD, operand2);
        prettyPrintVisitor.visitBinaryExpr(binaryExpr);
        Mockito.verify(mockPrinter, Mockito.times(7)).print(Mockito.anyString());
    }

    // Test visitUnaryExpr method
    @Test
    public void visitUnaryExprPrefixTest() {
        CollectingPrinter mockPrinter = Mockito.mock(CollectingPrinter.class);
        PrettyPrintVisitor prettyPrintVisitor = new PrettyPrintVisitor(mockPrinter);
        Expression operand = new ValueExpr(new StringValue("operand"));
        UnaryExpr unaryExpr = new UnaryExpr(UnaryOp.INCREMENT, operand);
        prettyPrintVisitor.visitUnaryExpr(unaryExpr);
        Mockito.verify(mockPrinter, Mockito.times(5)).print(Mockito.anyString());
    }

    // Test visitUnaryExpr method
    @Test
    public void visitUnaryExprPostfixTest() {
        CollectingPrinter mockPrinter = Mockito.mock(CollectingPrinter.class);
        PrettyPrintVisitor prettyPrintVisitor = new PrettyPrintVisitor(mockPrinter);
        Expression operand = new ValueExpr(new StringValue("operand"));
        UnaryExpr unaryExpr = new UnaryExpr(UnaryOp.DECREMENT, operand, false);
        prettyPrintVisitor.visitUnaryExpr(unaryExpr);
        Mockito.verify(mockPrinter, Mockito.times(5)).print(Mockito.anyString());
    }

    // Test exprToString method
    @Test
    public void exprToStringTest() {
        Expression expr = new ValueExpr(new StringValue("expr"));
        String result = PrettyPrintVisitor.exprToString(expr);
        assertEquals("'expr'", result);
    }

    // other tests for remaining methods need to be added here
}
