import io.github.vmzakharov.ecdataframe.dsl.UnaryExpr;
import io.github.vmzakharov.ecdataframe.dsl.VarExpr;
import io.github.vmzakharov.ecdataframe.dsl.value.Value;
import io.github.vmzakharov.ecdataframe.dsl.visitor.PrettyPrintVisitor;
import org.junit.Test;

import static org.junit.Assert.assertEquals;

public class PrettyPrintVisitorTest {

    private static final Expression VAR_EXPR = new VarExpr(false, "variable");

    @Test
    public void visitAssignExprTest() {
        AssingExpr assignExpr = new AssingExpr(VAR_EXPR, VAR_EXPR);
        String expected = "variable = variable";
        String actual = PrettyPrintVisitor.exprToString(assignExpr);
        assertEquals(expected, actual);
    }

