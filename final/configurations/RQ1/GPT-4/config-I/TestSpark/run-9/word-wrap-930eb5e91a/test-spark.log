public class WordWrapTest {

    @Test
    public void fromClasspathUtf8Test() {
        WordWrap.Builder builder = WordWrap.fromClasspathUtf8("/myResource");
        assertEquals(java.nio.HeapCharBuffer.class, builder.getClass());
    }

    @Test(expected = NullPointerException.class)
    public void fromClasspathCharsetNullTest() {
        WordWrap.fromClasspath("/myResource", null);
    }
  
    @Test
    public void fromFileCharsetTest() {
        WordWrap.Builder builder = WordWrap.from(new File("/textFile.txt"), StandardCharsets.UTF_8);
        assertEquals(java.io.BufferedReader.class, builder.getClass());
    }

    @Test(expected = IORuntimeException.class)
    public void fromFileNotFoundTest() {
        WordWrap.from(new File("/noSuchFile.txt"), StandardCharsets.UTF_8);
    }
  
    @Test
    public void maxWidthNegativeTest() {
        WordWrap.Builder builder = WordWrap.from(new StringReader(""));
        try {
            builder.maxWidth(-5);
        } catch (IllegalArgumentException e) {
            assertEquals("argument cannot be less than or equal to zero", e.getMessage());
        }
    }
    
    @Test
    public void wrapTest() {
        WordWrap.Builder builder = WordWrap.from(new StringReader("hello world"));
        builder.wrap(new StringWriter());
    }  

    @Test(expect = IOException.class)
    public void wrapIOExceptionTest() throws IOException {
        StringWriter writer = Mockito.spy(new StringWriter());
        Mockito.doThrow(new IOException()).when(writer).write(Mockito.anyString);
        WordWrap.Builder builder = WordWrap.from(new StringReader("hello world"));
        builder.wrap(writer);
        Mockito.verify(writer, Mockito.times(1)).write("hello world");
    }
  
    @Test
    public void wrapFileTest() {
        File file = new File("output.txt");
        WordWrap.Builder builder = WordWrap.from(new StringReader("hello world"));
        builder.wrap(file, StandardCharsets.UTF_8);
        assertTrue(file.exists());
    }
  
    @Test(expected = IORuntimeException.class)
    public void wrapFileErrorTest() {
        WordWrap.Builder builder = WordWrap.from(new StringReader("hello world"));
        builder.wrap(new File("/noAccessDirectory/output.txt"), StandardCharsets.UTF_8);
    }
    
    @Test
    public void wrapListTest() {
        WordWrap.Builder builder = WordWrap.from(new StringReader("hello world"));
        assertTrue(builder.wrapToList() instanceof java.util.ArrayList);
    }
    
    @Test
    public void wrapToListLineCountTest() {
        WordWrap.Builder builder = WordWrap.from(new StringReader("hello\nworld"));
        assertEquals(2, builder.wrapToList().size());
    }
    
    @Test
    public void wordWrapTest() throws IOException {
        final AtomicInteger lines = new AtomicInteger(0);
        LineConsumer consumer = new LineConsumer() {
            @Override
            public void write(char[] chars, int offset, int length) throws IOException { }
            @Override
            public void writeNewLine() throws IOException {
                lines.incrementAndGet();
            }
        };
        WordWrap.wordWrap(new StringReader("hello world"), consumer,
                5, s -> s.length(), Collections.emptySet(), true, true);
        assertEquals(2, lines.get());
    }
}
