import io.github.vmzakharov.ecdataframe.dsl.value.Value;
import io.github.vmzakharov.ecdataframe.dsl.visitor.PrettyPrintVisitor;
import org.junit.Assert;
import org.junit.Test;
import org.mockito.Mockito;

public class PrettyPrintVisitorTest {

    @Test
    public void printTest() {
        Printer printerMock = Mockito.mock(Printer.class);
        PrettyPrintVisitor prettyPrintVisitor = new PrettyPrintVisitor(printerMock);

        prettyPrintVisitor.print("Hello World");

        Mockito.verify(printerMock, Mockito.times(1)).print("Hello World");
    }

    @Test
    public void newLineTest() {
        Printer printerMock = Mockito.mock(Printer.class);
        PrettyPrintVisitor prettyPrintVisitor = new PrettyPrintVisitor(printerMock);

        prettyPrintVisitor.newLine();

        Mockito.verify(printerMock, Mockito.times(1)).newLine();
    }

    @Test
    public void exprToStringTest() {
        Value valueMock = Mockito.mock(Value.class);
        Mockito.when(valueMock.asStringLiteral()).thenReturn("Hello World");

        String result = PrettyPrintVisitor.exprToString(valueMock);

        Assert.assertEquals("Hello World", result);
    }

    @Test
    public void escapeVarNameIfNeededEscapeTest() {
        Printer printerMock = Mockito.mock(Printer.class);
        PrettyPrintVisitor prettyPrintVisitor = new PrettyPrintVisitor(printerMock);

        String result = prettyPrintVisitor.escapeVarNameIfNeeded("varName", true);

        Assert.assertEquals("${varName}", result);
    }

    @Test
    public void escapeVarNameIfNeededDoNotEscapeTest() {
        Printer printerMock = Mockito.mock(Printer.class);
        PrettyPrintVisitor prettyPrintVisitor = new PrettyPrintVisitor(printerMock);

        String result = prettyPrintVisitor.escapeVarNameIfNeeded("varName", false);

        Assert.assertEquals("varName", result);
    }

    @Test
    public void tabTest() {
        Printer printerMock = Mockito.mock(Printer.class);
        PrettyPrintVisitor prettyPrintVisitor = new PrettyPrintVisitor(printerMock);

        // increase tab offset
        prettyPrintVisitor.tab();

        // try to print to check offset
        prettyPrintVisitor.print("Test");

        // it should print with 2 space offset
        Mockito.verify(printerMock).print("  Test");
    }

    @Test
    public void tabBackTest() {
        Printer printerMock = Mockito.mock(Printer.class);
        PrettyPrintVisitor prettyPrintVisitor = new PrettyPrintVisitor(printerMock);

        // increase tab offset twice
        prettyPrintVisitor.tab();
        prettyPrintVisitor.tab();
        
        // decrease tab offset
        prettyPrintVisitor.tabBack();

        // try to print to check offset
        prettyPrintVisitor.print("Test");

        // it should print with 2 space offset
        Mockito.verify(printerMock).print("  Test");
    }
}
