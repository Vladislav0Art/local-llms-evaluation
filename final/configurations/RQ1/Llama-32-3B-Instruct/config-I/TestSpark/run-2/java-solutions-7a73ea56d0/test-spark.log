public class OnlineStockSpanTest {

    private final OnlineStockSpan onlineStockSpan;

    @Before
    public void setUp() {
        onlineStockSpan = new OnlineStockSpan();
    }

    public static void main(String[] args) {
        org.junit.runner.JUnitCore.main("OnlineStockSpanTest");
    }

    public void testNextIsGreaterWhenPriceIncreases() {
        assertEquals(2, onlineStockSpan.next(10));
    }

    public void testNextIsLessWhenPriceDecreases() {
        onlineStockSpan.next(5);
        onlineStockSpan.next(3);
        assertEquals(1, onlineStockSpan.next(4));
    }

    public void testNextReturnsCorrectCountForSingleElementArray() {
        int[] prices = {10};
        int[] result = onlineStockSpan.calculateSpans(prices);
        assertEquals(new int[]{1}, result);
    }

    public void testCalculateSpansWorksWithMultipleElementsArray() {
        int[] prices = {10, 5, 8, 3};
        int[] result = onlineStockSpan.calculateSpans(prices);
        assertArrayEquals(new int[]{2, 1, 1, 4}, result);
    }

    public void testCalculateSpansReturnsCorrectValuesForPriceIncreasingSequence() {
        int[] prices = {10, 20, 30};
        int[] result = onlineStockSpan.calculateSpans(prices);
        assertArrayEquals(new int[]{2, 3, 4}, result);
    }

    public void testNextThrowsExceptionWhenNextIsCalledWithNullPrice() {
        assertThrows(NullPointerException.class, () -> onlineStockSpan.next(null));
    }
}
