import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.select.Elements;

public class DocumentTest {

    @org.junit.Test
    public void testDocumentParse() {
        Document doc = Jsoup.parse("<html><body>Hello World</body></html>");
        assertEquals("#text", doc.body().nodeName());
        assertEquals("Hello World", doc.body().text());
        assertTrue(doc.body().isBlank());
    }

    @org.junit.Test
    public void testSpanText() {
        String html = "<html><body>Hello <span>World</span></body></html>";
        Document doc = Jsoup.parse(html);
        Element span = doc.select("span").first();
        assertEquals("#text", span.nodeName());
        assertEquals("World", span.text());
        assertTrue(span.isBlank());
    }

    @org.junit.Test
    public void testSpanTextSplit() {
        String html = "<html><body>Hello <span>World</span></body></html>";
