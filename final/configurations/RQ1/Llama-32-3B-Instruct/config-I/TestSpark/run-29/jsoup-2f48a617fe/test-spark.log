import org.junit.Test;
import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertSame;
import static org.junit.Assert.assertFalse;

public class CommentTest {

, testCases=[	@Test
	public void constructor_hasValidData() {
		Comment comment = new Comment("Hello World!");
		assertEquals("Hello World!", comment.getData());
	}
, 	@Test
	public void constructor_hasEmptyData() {
		Comment comment = new Comment("");
		assertEquals("", comment.getData());
	}
, 	@Test(expected = RuntimeException.class)
	public void clone_returnsSameInstance_WhenClonedSameValue() {
		Comment comment = new Comment("Hello World!");
		Comment clonedComment = comment.clone();
		assertSame(comment, clonedComment);
	}
, 	@Test
	public void clone_returnsDifferentInstance_ifModified() {
		Comment originalComment = new Comment("Hello World!");
		Comment modifiedComment = new Comment(originalComment.getData() + " Modified");
		Comment clonedComment = modifiedComment.clone();
		assertFalse(originalComment.equals(clonedComment));
	}
])
