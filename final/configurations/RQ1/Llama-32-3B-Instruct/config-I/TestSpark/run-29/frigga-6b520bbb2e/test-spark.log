        String amiName = "subscriberha-1.0.0-586499";
        AppVersion result = AppVersion.parseName(amiName);
        assertEquals("subscriberha", result.getPackageName());
    }

    @Test
    public void getVersion ReturnsVersion() {
        String amiName = "subscriberha-1.0.0-586499";
        AppVersion result = AppVersion.parseName(amiName);
        assertEquals("1.0.0-586499", result.getVersion());
    }

    @Test
    public void getBuildJobName ReturnsBuildJobName() {
        String amiName = "subscriberha-1.0.0-586499.h150";
        AppVersion result = AppVersion.parseName(amiName);
        assertEquals("h150", result.getBuildJobName());
    }

    @Test
    public void getBuildNumber ReturnsBuildNumber() {
        String amiName = "subscriberha-1.0.0-586499.h150";
