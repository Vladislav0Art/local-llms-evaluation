package org.jsoup.nodes;

import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.Mockito;
import org.mockito.junit.MockitoJUnitRunner;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertFalse;
import static org.junit.Assert.assertNotNull;
import static org.junit.Assert.assertTrue;
import static org.mockito.Mockito.when;

@RunWith(MockitoJUnitRunner.class)
public class TextNodeTest {

    @Mock
    private LeafNode parentNode;

    @Mock
    private String text;

    public TextNodeTest() {
        when(parentNode.addNode(Mockito.any(TextNode.class), Mockito.anyInt())).thenReturn(this);
    }

    public static final int SPLIT_OFFSET = 10;
    public static final int SPLIT_OFFSET_MAX = 20;
    public static final String TEXT_NODE_VALUE = "Hello, World!";
    public static final String SPAN_NODE_VALUE = "<span>Hello</span>";

    @Test
    public void newTextNode_ReturnsNewTextNode() {
        TextNode textNode = new TextNode(TEXT_NODE_VALUE);
        assertNotNull(textNode);
    }

    @Test
    public void nodeName_ReturnsCorrectNodeName() {
        TextNode textNode = new TextNode(TEXT_NODE_VALUE);
        assertEquals("#text", textNode.nodeName());
    }

    @Test
    public void text_ReturnsUnencodedText() {
        TextNode textNode = new TextNode(TEXT_NODE_VALUE);
        assertEquals(TEXT_NODE_VALUE, textNode.text());
    }

    @Test
    public void text_SetsCorrectTextValue() {
        TextNode textNode = new TextNode();
        textNode.text(TEXT_NODE_VALUE);
        assertEquals(TEXT_NODE_VALUE, textNode.coreValue());
    }

    @Test
    public void getWholeText_ReturnsUnencodedText() {
        TextNode textNode = new TextNode(TEXT_NODE_VALUE);
        assertEquals(TEXT_NODE_VALUE, textNode.getWholeText());
    }

    @Test
    public void isBlank_ReturnsCorrectBlankState() {
        TextNode textNode = new TextNode("");
        assertTrue(textNode.isBlank());

        TextNode textNode2 = new TextNode("   ");
        assertTrue(textNode2.isBlank());

        TextNode textNode3 = new TextNode(TEXT_NODE_VALUE);
        assertFalse(textNode3.isBlank());
    }

    @Test
    public void splitText_SplitsCorrectly() {
        TextNode textNode = new TextNode(TEXT_NODE_VALUE);
        TextNode tailNode = textNode.splitText(SPLIT_OFFSET);
        assertNotNull(tailNode);

        assertEquals(SPLIT_OFFSET, tailNode.getWholeText().length());
    }

    @Test
    public void splitText_SplitOffsetMax_ReturnsCorrectResult() {
        TextNode textNode = new TextNode(TEXT_NODE_VALUE);
        TextNode tailNode = textNode.splitText(SPLIT_OFFSET_MAX);
        assertNotNull(tailNode);

        assertEquals(SPLIT_OFFSET_MAX, tailNode.getWholeText().length());
    }

    @Test
    public void outerHtmlHead_SetsCorrectIndentation() {
        Document.OutputSettings out = new Document.OutputSettings();
        TextNode textNode = new TextNode(TEXT_NODE_VALUE);
        Appendable accum = Mockito.mock(Appendable.class);

        textNode.outerHtmlHead(accum, 1, out);

        when(accum.append(Mockito.anyString())).thenReturn(this);
    }

    @Test
    public void outerHtmlTail_SetsCorrectIndentation() {
        Document.OutputSettings out = new Document.OutputSettings();
        TextNode textNode = new TextNode(TEXT_NODE_VALUE);
        Appendable accum = Mockito.mock(Appendable.class);

        textNode.outerHtmlTail(accum, 1, out);

        when(accum.append(Mockito.anyString())).thenReturn(this);
    }

    @Test
    public void toString_ReturnsCorrectStringRepresentation() {
        TextNode textNode = new TextNode(TEXT_NODE_VALUE);
        String stringRepresentation = textNode.toString();
        assertNotNull(stringRepresentation);
    }

    @Test
    public void clone_ReturnsCorrectClonedTextNode() {
        TextNode textNode = new TextNode(TEXT_NODE_VALUE);
        TextNode clonedTextNode = textNode.clone();

        assertNotNull(clonedTextNode);

        assertEquals(textNode.coreValue(), clonedTextNode.coreValue());
    }
}
