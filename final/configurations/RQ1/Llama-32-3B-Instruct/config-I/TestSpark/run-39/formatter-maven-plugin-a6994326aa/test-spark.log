public class CssFormatterTest {

    @Test
    public void init_EmptyOptions_ThrowsIOException() {
        CssFormatter formatter = new CssFormatter();
        assertThrows(IOException.class, () -> formatter.init(Map.of(), null));
    }

    @Test
    public void init_ValidIndent_MatchesExpectedValue() {
        CssFormatter formatter = new CssFormatter();
        var options = Map.of("indent", "4");
        formatter.init(options, null);
        assertEquals(4, ((CssFormatter)formatter.formatter).getProperties().get("indent"));
    }

    @Test
    public void doFormat_EmptyCss_ThrowsIOException() {
        CssFormatter formatter = new CssFormatter();
        assertThrows(IOException.class, () -> formatter.doFormat("", LineEnding.LF));
    }

    @Test
    public void doFormat_ValidCss_ReturnsFormattedCode() throws IOException {
        CssFormatter formatter = new CssFormatter();
        var options = Map.of("indent", "4");
        var result = formatter.doFormat(options);
        assertNotNull(result);
    }

    @Test
    public void doFormat_InvalidCss_ThrowsIOException() {
        CssFormatter formatter = new CssFormatter();
        assertThrows(IOException.class, () -> formatter.doFormat("{ invalid css }", LineEnding.LF));
    }
}

class CssFormatterBuilder {

    private int indent;

    public void setIndent(int indent) {
        this.indent = indent;
    }

    public CssFormatter build(Map<String, String> options) throws IOException {
        if (indent > 0) {
            throw new IOException("Invalid indent");
        }
        return new CssFormatter();
    }
}

class LineEnding {
    public static final int LF = 10;
}
