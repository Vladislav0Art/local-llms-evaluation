import java.net.URL;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class Connection {
    public static class KeyVal {
        private String key;
        private String value;

        public KeyVal(String key, String value) {
            this.key = key;
            this.value = value;
        }

        @Override
        public String toString() {
            return "KeyVal{" +
                    "key='" + key + '\'' +
                    ", value='" + value + '\'' +
                    '}';
        }
    }

    public static class UrlBuilder {
        private URL url;

        public UrlBuilder(URL url) {
            this.url = url;
        }

        public String getQ() {
            return url.getQuery();
        }

        @Override
        public String toString() {
            return "UrlBuilder{" +
                    "url=" + url +
                    '}';
        }
    }

    public static class DecodedPart {
        private String value;

        public DecodedPart(String value) {
            this.value = value;
        }

        @Override
        public String toString() {
            return "DecodedPart{" +
                    "value='" + value + '\'' +
                    '}';
        }
    }

    public static void assertEquals(int actual, int expected) {
        if (actual != expected) {
            throw new AssertionError(actual + " is not equal to " + expected);
        }
    }

    @SuppressWarnings("unused")
    public static void main(String[] args) throws Exception {
        String url = "https://example.com?key1=value1&key2=value2";
        URL parsedUrl = new URL(url);

        Connection.KeyVal kv1 = new Connection.KeyVal("key", "value");
        Connection.KeyVal kv2 = new Connection.KeyVal("key2", "value2");

        UrlBuilder builder = new UrlBuilder(parsedUrl);
        System.out.println(builder.getQ());

        String[] params = builder.getQ().split("&");
        for (String param : params) {
            if (!param.isEmpty()) {
                String[] keyValue = param.split("=");

                // URL decoding
                StringBuilder decodedKey = new StringBuilder();
                StringBuilder decodedValue = new StringBuilder();

                for (char c : keyValue[0].toCharArray()) {
                    switch (c) {
                        case '%':
                            Matcher matcher = Pattern.compile("\\d{2}").matcher(keyValue[0]);
                            if (matcher.find()) {
                                int codePoint = Integer.parseInt(matcher.group(), 16);
                                decodedKey.append((char) codePoint);
                            } else {
                                decodedKey.append('%');
                            }
                            break;
                        default:
                            decodedKey.append(c);
                    }
                }

                for (char c : keyValue[1].toCharArray()) {
                    switch (c) {
                        case '%':
                            Matcher matcher = Pattern.compile("\\d{2}").matcher(keyValue[1]);
                            if (matcher.find()) {
                                int codePoint = Integer.parseInt(matcher.group(), 16);
                                decodedValue.append((char) codePoint);
                            } else {
                                decodedValue.append('%');
                            }
                            break;
                        default:
                            decodedValue.append(c);
                    }
                }

                System.out.println("Key: " + decodedKey.toString() +
                        ", Value: " + decodedValue.toString());
            }
        }
    }
}
```

