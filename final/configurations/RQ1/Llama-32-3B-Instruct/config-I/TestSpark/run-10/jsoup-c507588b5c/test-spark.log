public class TextNodeTests {

    @Test
    public void testTextNodeWithSingleCharacter() {
        String input = "a";
        String expectedOutput = "{'text': 'a', 'length': 1}";
        assertEquals(expectedOutput, new TextNode(input).toString());
    }

    @Test
    public void testTextNodeWithMultipleCharacters() {
        String input = "hello";
        String expectedOutput = "{\"text\": \"hello\", \"length\": 5}";
        assertEquals(expectedOutput, new TextNode(input).toString());
    }

    @Test
    public void testTextNodeSplitAtZeroOffset() {
        String input = "abcdefg";
        StringBuilder expectedOutput = new StringBuilder("a");
        for (char c : input.toCharArray()) {
            if (!c.equals('\0')) {
                expectedOutput.append(' ');
                expectedOutput.append(c);
            }
        }
        assertEquals(expectedOutput.toString(), new TextNode(input).splitText(0));
    }

    @Test
    public void testTextNodeSplitAtNonZeroOffset() {
        String input = "abcdefg";
        StringBuilder expectedOutput = new StringBuilder("ab");
        for (int i = 2; i < input.length(); i++) {
            if (i == 1) {
                expectedOutput.append(' ');
            }
            expectedOutput.append(input.charAt(i));
        }
        assertEquals(expectedOutput.toString(), new TextNode(input).splitText(1));
    }

    @Test
    public void testTextNodeCannotSplitAtNegativeOffset() {
        String input = "abcdefg";
        StringBuilder expectedOutput = new StringBuilder("abcdefg");
        for (int i = 0; i < input.length(); i++) {
            if (i == 0) {
                expectedOutput.append(' ');
            }
            expectedOutput.append(input.charAt(i));
        }
        assertEquals(expectedOutput.toString(), new TextNode(input).splitText(-1));
    }

    @Test
    public void testTextNodeCannotSplitAtOffsetGreaterThenTextLength() {
        String input = "abcdefg";
        StringBuilder expectedOutput = new StringBuilder("abcdefg");
        for (int i = 0; i < input.length(); i++) {
            if (i == 6) {
                expectedOutput.append(' ');
            }
            expectedOutput.append(input.charAt(i));
        }
        assertEquals(expectedOutput.toString(), new TextNode(input).splitText(7));
    }

    public static class TextNode {
        private String text;

        public TextNode(String text) {
            this.text = text;
        }

        public String toString() {
            return "{\"text\": \"" + text + "\", \"length\": " + text.length() + "}";
        }

        public StringBuilder splitText(int offset) {
            if (offset < 0 || offset >= text.length()) {
                throw new IllegalArgumentException("Offset is out of range");
            }
            StringBuilder result = new StringBuilder();
            for (int i = 0; i <= offset; i++) {
                result.append(text.charAt(i));
            }
            return result;
        }
    }
}
