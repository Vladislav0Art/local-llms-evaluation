    @Test
    public void [TextNodeConstructorTest]

    TestConstructorWithBlankTextNode() {
        textNode = new TextNode("");
        assertNotNull(textNode);
        assertEquals("#text", textNode.nodeName());
        assertEquals("", textNode.text());
    }

    @Test
    public void [TextNodeTextTest]

    TestGetWholeTextWithExistingContent() {
        textNode = new TextNode("Hello World");
        String wholeText = textNode.getWholeText();
        assertNotNull(wholeText);
        assertEquals("Hello World", wholeText);
    }

    @Test
    public void [TextNodeTextTest]

    TestGetWholeTextWithBlankContent() {
        textNode = new TextNode("");
        String wholeText = textNode.getWholeText();
        assertNotNull(wholeText);
        assertTrue(wholeText.isEmpty());
    }

    @Test
    public void [TextNodeTextTest]

    TestGetWholeTextWithWhitespaceContent() {
        textNode = new TextNode("   ");
        String wholeText = textNode.getWholeText();
        assertNotNull(wholeText);
        assertEquals("   ", wholeText);
    }

    @Test
    public void [TextNodeIsBlankTest]

    TestIsBlankForEmptyContent() {
        textNode = new TextNode("");
        assertTrue(textNode.isBlank());
    }

    @Test
    public void [TextNodeIsBlankTest]

    TestIsBlankForWhitespaceContent() {
        textNode = new TextNode("   ");
        assertTrue(textNode.isBlank());
    }

    @Test
    public void [TextNodeIsBlankTest]

    TestNotIsBlankForExistingContent() {
        textNode = new TextNode("Hello World");
        assertFalse(textNode.isBlank());
    }

    @Test
    public void [TextNodeSplitTextTest]

    TestSplitAtZeroOffset() {
        textNode = new TextNode("Hello World");
        TextNode splitNode = textNode.splitText(0);
        assertNotNull(splitNode);
        assertEquals(1, splitNode.text().length());
        assertTrue(textNode.getWholeText().equals("Hello "));
    }

    @Test
    public void [TextNodeSplitTextTest]

    TestSplitAtNonZeroOffset() {
        textNode = new TextNode("Hello World");
        TextNode splitNode = textNode.splitText(7);
        assertNotNull(splitNode);
        assertEquals(4, splitNode.text().length());
        assertTrue(textNode.getWholeText().equals("World "));
    }

    @Test
    public void [TextNodeSplitTextTest]

    TestCannotSplitAtNegativeOffset() {
        textNode = new TextNode("Hello World");
        assertThrows(IllegalArgumentException.class, () -> textNode.splitText(-1));
    }

    @Test
    public void [TextNodeSplitTextTest]

    TestCannotSplitAtOffsetGreaterThenTextLength() {
        textNode = new TextNode("Hello World");
        assertThrows(IllegalArgumentException.class, () -> textNode.splitText(13));
    }

