package org.jsoup.nodes;

import org.jsoup.nodes.Comment;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.parser.ParseSettings;
import org.jsoup.parser.Parser;
import org.junit.Test;

import static org.junit.Assert.*;

import java.io.ByteArrayOutputStream;
import java.io.IOException;

public class GeneratedTest {

    @Test
    public void createCommentFromEmptyStringCreatesBlankComment() {
        Comment comment = new Comment("");
        assertEquals("#comment", comment.nodeName());
        assertNull(comment.getData());
    }

    @Test
    public void createCommentWithTextSetsDataProperly() {
        Comment comment = new Comment("Some text");
        assertEquals("Some text", comment.getData());
    }

    @Test
    public void outerHtmlHeadAddsProperCommentTagWhenPrettyPrintedAndBlockFormattingEnabled() throws IOException {
        ByteArrayOutputStream outContent = new ByteArrayOutputStream();
        Appendable accum = new StringBuilder();
        Document.OutputSettings outputSettings = new Document.OutputSettings(true, true);
        Comment comment = new Comment("Some text");
        comment.outerHtmlHead(accum, 0, outputSettings);
        assertEquals("<!--Some text-->", outContent.toString());
    }

    @Test
    public void outerHtmlHeadDoesNotAddCommentTagWhenPrettyPrintedButNoBlockFormatting() throws IOException {
        ByteArrayOutputStream outContent = new ByteArrayOutputStream();
        Appendable accum = new StringBuilder();
        Document.OutputSettings outputSettings = new Document.OutputSettings(true, false);
        Comment comment = new Comment("Some text");
        comment.outerHtmlHead(accum, 0, outputSettings);
        assertEquals("", outContent.toString());
    }

    @Test
    public void outerHtmlTailDoesNotAddAnything() {
        Appendable accum = new StringBuilder();
        Document.OutputSettings outputSettings = new Document.OutputSettings(false, false);
        Comment comment = new Comment("Some text");
        comment.outerHtmlTail(accum, 0, outputSettings);
        assertEquals("", accum.toString());
    }

    @Test
    public void cloneCommentCreatesNewCopy() {
        Comment original = new Comment("Some text");
        Comment copy = original.clone();
        assertNotSame(original, copy);
        assertEquals("#comment", copy.nodeName());
        assertEquals("Some text", copy.getData());
    }

    @Test
    public void isXmlDeclarationReturnsFalseForRandomData() {
        String data = "randomtext";
        assertFalse(comment.isXmlDeclaration(data));
    }

    @Test
    public void isXmlDeclarationReturnsTrueWhenStartsWithExclamationMark() {
        String data = "!xml declaration";
        assertTrue(comment.isXmlDeclaration(data));
    }

    @Test
    public void asXmlDeclarationReturnsNullForCommentWithoutDeclarationData() {
        Comment comment = new Comment("Some text");
        assertNull(comment.asXmlDeclaration());
    }

    @Test
    public void asXmlDeclarationParsesDeclarationDataCorrectly() throws IOException {
        Document doc = new Document();
        Parser parser = new Parser(doc, ParseSettings.DEFAULT);
        parser.parseString("<!-- XML declaration -->", null);
        Comment comment = new Comment("");
        XmlDeclaration decl = comment.asXmlDeclaration();
        assertNotNull(decl);
    }

    @Test
    public void asXmlDeclarationTreatsBogusCommentsAsCommentIfFollowedByAnother() throws IOException {
        Document doc = new Document();
        Parser parser = new Parser(doc, ParseSettings.DEFAULT);
        parser.parseString("<!-- Bogus XML declaration -->\n<?xml version=\"1.0\"?><some xml>", null);
        Comment comment = new Comment("");
        XmlDeclaration decl = comment.asXmlDeclaration();
        assertNull(decl);
    }

}
