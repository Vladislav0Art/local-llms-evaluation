public class OnlineStockSpan {
    private int[] nums;
    private int pointer;

    public OnlineStockSpan(int[] nums) {
        this.nums = nums;
        this.pointer = 0;
    }

    public int next(int n) {
        if (n < nums.length) {
            return nums[n];
        } else {
            throw new RuntimeException();
        }
    }

    public int[] calculateSpans() {
        int[] result = new int[nums.length];
        result[pointer] = 1;
        pointer++;
        for (int i = 0; i < nums.length - 1; i++) {
            if (nums[i] <= nums[i + 1]) {
                result[i] += result[i + 1];
            } else {
                result[i] = result[i + 1];
            }
            pointer++;
        }
        return result;
    }

    public static void main(String[] args) {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan(new int[]{10, 4, 3, 2, 5});
        System.out.println(java.util.Arrays.toString(onlineStockSpan.next(0)));
        System.out.println(java.util.Arrays.toString(onlineStockSpan.next(1)));
        System.out.println(java.util.Arrays.toString(onlineStockSpan.calculateSpans()));
    }
}

