public class OnlineStockSpan {
    private int[] nums;
    public static final int NULL_VALUE = -1;

    public OnlineStockSpan(int[] nums) {
        this.nums = nums;
    }

    public int next(int n) throws Exception {
        if (n >= 0 && n < nums.length) {
            return nums[n];
        } else {
            throw new Exception("Index out of bounds");
        }
    }

    public int calculateSpans() {
        int[] result = new int[nums.length];
        Arrays.fill(result, NULL_VALUE);
        result[0] = 1;
        for (int i = 1; i < nums.length; i++) {
            if (nums[i - 1] <= nums[i]) {
                result[i] = result[i - 1] + 1;
            } else {
                result[i] = 1;
            }
        }
        return result;
    }

    public static void main(String[] args) throws Exception {
        int[] test1 = {10, 4, 3, 2, 5};
        System.out.println(Arrays.toString(new OnlineStockSpan(test1).next(0)));
        System.out.println(Arrays.toString(new OnlineStockSpan(test1).next(1)));
        System.out.println(java.util.Arrays.toString(new OnlineStockSpan(test1).calculateSpans()));
    }
}

