public class TextNodeTest {

    @Test
    public void newNode createsNewTextNode() {
        String text = "Hello World";
        TextNode node = new TextNode(text);
        assertEquals(text, node.text());
    }

    @Test
    public void textReturnsUnencodedText() {
        String encodedText = "&lt;Hello&gt;";
        TextNode node = TextNode.createFromEncoded(encodedText);
        assertEquals(encodedText, node.text());
    }

    @Test
    public void textNormalisesWhitespace() {
        String text = "   Hello   World";
        TextNode node = new TextNode(text);
        assertEquals("Hello World", node.text());
    }

    @Test
    public void isBlankReturnsTrueWhenEmpty() {
        TextNode node = new TextNode("");
        assertTrue(node.isBlank());
    }

    @Test
    public void splitTextSplitsTextNodeAtOffset() {
        String text = "Hello World";
        TextNode node = new TextNode(text);
        TextNode tailNode = node.splitText(5);
        assertEquals("World", tailNode.text());
    }

    @Test
    public void outerHtmlHeadIncludesTextWhenNotBlank() {
        Document document = new Document();
        Appendable accum = new StringBuilder();
        int depth = 0;
        Document.OutputSettings out = new Document.OutputSettings(false, true);
        TextNode node = new TextNode("   ");
        node.outerHtmlHead(accum, depth, out);
        assertEquals("<span>   </span>", accum.toString());
    }

    @Test
    public void outerHtmlHeadDoesNotIncludeTextWhenBlank() {
        Document document = new Document();
        Appendable accum = new StringBuilder();
        int depth = 0;
        Document.OutputSettings out = new Document.OutputSettings(false, true);
        TextNode node = new TextNode("");
        node.outerHtmlHead(accum, depth, out);
        assertEquals("", accum.toString());
    }

    @Test
    public void toStringReturnsOuterHTML() {
        String text = "Hello World";
        TextNode node = new TextNode(text);
        assertEquals("<span> Hello World </span>", node.toString());
    }
}
