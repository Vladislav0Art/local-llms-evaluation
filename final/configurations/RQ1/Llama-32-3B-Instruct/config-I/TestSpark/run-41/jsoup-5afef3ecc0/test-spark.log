public class UrlBuilder {

    private String[] params;
    private String[] fragments;

    public UrlBuilder() {}

    public void addParam(String key, String value) {
        if (params == null) params = new String[0];
        int index = 0;
        while (index < params.length && params[index].contains("=")) index++;
        String[] newParams = new String[params.length + 1];
        System.arraycopy(params, 0, newParams, 0, index);
        newParams[index] = key + "=" + value;
        System.arraycopy(params, index, newParams, index + 1, params.length - index);
        params = newParams;
    }

    public void addFragment(String fragment) {
        if (fragments == null) fragments = new String[0];
        int index = 0;
        while (index < fragments.length && fragments[index].contains("#")) index++;
        String[] newFragments = new String[fragments.length + 1];
        System.arraycopy(fragments, 0, newFragments, 0, index);
        newFragments[index] = fragment;
        System.arraycopy(fragments, index, newFragments, index + 1, fragments.length - index);
        fragments = newFragments;
    }

    public String build() {
        StringBuilder sb = new StringBuilder();
        if (params != null) {
            for (int i = 0; i < params.length; i++) {
                if (i > 0) sb.append("&");
                sb.append(params[i]);
            }
        }
        if (fragments != null) {
            if (sb.length() == 0 || !sb.toString().endsWith("#")) {
                sb.append("#");
            }
            sb.append(fragments[0]);
        }
        return sb.toString();
    }

    public String normalizeQuery(String q) {
        String[] params = q.split("&");
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < params.length; i++) {
            if (i > 0) sb.append("&");
            int equalsIndex = params[i].indexOf("=");
            if (equalsIndex != -1) {
                String key = params[i].substring(0, equalsIndex);
                String value = params[i].substring(equalsIndex + 1);
                addParam(key, value);
            }
        }
        return build();
    }

    public String normalizeRef(String r) {
        // Custom implementation
        return r.toLowerCase();
    }
}
