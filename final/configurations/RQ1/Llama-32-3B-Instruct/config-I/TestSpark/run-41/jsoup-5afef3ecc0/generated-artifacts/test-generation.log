    public static class KeyVal {
        public String key;
        public String value;

        public KeyVal(String key, String value) {
            this.key = key;
            this.value = value;
        }
    }

    public static KeyVal[] newKeyVal(String... values) {
        KeyVal[] result = new KeyVal[values.length];
        for (int i = 0; i < values.length; i++) {
            result[i] = new KeyVal("key" + i, values[i]);
        }
        return result;
    }

    public String normalizeQuery(String q) {
        // Custom implementation
        return q.toLowerCase();
    }

    public static void main(String[] args) throws java.net.URISyntaxException {
        UrlBuilder urlBuilder = new UrlBuilder("http://example.com");
        urlBuilder.addParam("param1", "value1");
        urlBuilder.addParam("param2", "value2");
        String normalizedUrl = urlBuilder.normalizeQuery(urlBuilder.build());
        System.out.println(normalizedUrl);
    }
