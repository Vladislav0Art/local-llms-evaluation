import java.util.Stack;

public class StackUtil {
    public static Stack<Integer> getStack() {
        return new Stack<>();
    }

    public static void push(Stack<Integer> stack, int value) {
        stack.push(value);
    }

    public static int pop(Stack<Integer> stack) {
        if (stack.isEmpty()) {
            throw new RuntimeException("Stack is empty");
        }
        return stack.pop();
    }

    public static boolean isEmpty(Stack<Integer> stack) {
        return stack.isEmpty();
    }

    public class Result {
        public int[] result;
        public Stack<Integer> indexStack;

        public Result(int[] result, Stack<Integer> indexStack) {
            this.result = result;
            this.indexStack = indexStack;
        }
    }

    @Test
    public void testCalculateSpans() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int[] prices = {100, 80, 60, 70, 60, 90, 100};
        Stack<Integer> indexStack = onlineStockSpan.getStack();
        onlineStockSpan.calculateSpans(prices);
        assertEquals(new int[]{1, 1, 2, 3, 5, 6, 7}, onlineStockSpan.result);
    }

    @Test
    public void testNext() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int[] prices = {100, 80, 60, 70, 60, 90, 100};
        onlineStockSpan.calculateSpans(prices);
        onlineStockSpan.next(100);
        assertEquals(1, onlineStockSpan.result[0]);
    }

    @Test
    public void testNext2() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int[] prices = {100, 80, 60, 70, 60, 90, 100};
        onlineStockSpan.calculateSpans(prices);
        onlineStockSpan.next(80);
        assertEquals(2, onlineStockSpan.result[0]);
    }

    @Test
    public void testNext3() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int[] prices = {100, 80, 60, 70, 60, 90, 100};
        onlineStockSpan.calculateSpans(prices);
        onlineStockSpan.next(60);
        assertEquals(3, onlineStockSpan.result[0]);
    }
}

public class OnlineStockSpan {

    public int[] result;
    public Stack<Integer> indexStack;

    public OnlineStockSpan() {
        this.result = new int[0];
        this.indexStack = StackUtil.getStack();
    }

    public int[] calculateSpans(int[] prices) {
        for (int i = 0; i < prices.length; i++) {
            while (!indexStack.isEmpty() && prices[indexStack.peek()] <= prices[i]) {
                indexStack.pop();
            }
            if (indexStack.isEmpty()) {
                result = java.util.Arrays.copyOf(result, i + 1);
                result[i] = 1;
            } else {
                result[i] = i - indexStack.peek();
            }
            StackUtil.push(indexStack, i);
        }
        return result;
    }

    public int next(int price) {
        for (int i = 0; i < result.length; i++) {
            if (result[i] >= price) {
                result[0] = 1 + i - indexStack.pop();
                break;
            }
        }
        return result[0];
    }

}
