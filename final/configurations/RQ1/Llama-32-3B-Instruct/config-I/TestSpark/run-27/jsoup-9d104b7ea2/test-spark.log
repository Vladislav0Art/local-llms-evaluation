        for (char c : input.toCharArray()) {
            if (Character.isLetterOrDigit(c)) {
                cleanedInput.append(c);
            }
        }
        return cleanedInput.toString();
    }

    private static String[] tokenize(String input) {
        String[] words = input.split("\\s+");
        return words;
    }

    public static void main(String[] args) {
        String originalText = "I love this product! It's amazing.";
        List<String> preprocessedTokens = preprocessText(originalText);
        System.out.println("Preprocessed Tokens:");
        for (String token : preprocessedTokens) {
            System.out.println(token);
        }

        // Perform sentiment analysis
        int positiveSentiment = analyzeSentiment(preprocessedTokens);
        if (positiveSentiment > 0) {
            System.out.println("Positive sentiment detected!");
        } else if (positiveSentiment < 0) {
            System.out.println("Negative sentiment detected!");
        } else {
            System.out.println("Neutral sentiment detected!");
        }
    }

    private static int analyzeSentiment(String[] tokens) {
        int positiveCount = 0;
        int negativeCount = 0;
        for (String token : tokens) {
            if (token.contains("love") || token.contains("amazing")) {
                positiveCount++;
            } else if (token.contains("hate") || token.contains("bad")) {
                negativeCount++;
            }
        }
        return positiveCount - negativeCount;
    }

    private static class SentimentIntensityAnalyzer {

        public double[] polarityScores(String sentence) {
            // Implement a sentiment analysis algorithm here
            // For simplicity, this example uses a basic rule-based approach
            if (sentence.contains("love") || sentence.contains("amazing")) {
                return new double[] { 0.5, 0.3, 0.2 };
            } else if (sentence.contains("hate") || sentence.contains("bad")) {
                return new double[] { -0.5, -0.3, -0.2 };
            } else {
                return new double[] { 0, 0, 0 };
            }
        }

        public int compoundScore(String sentence) {
            // Implement a sentiment analysis algorithm here
            // For simplicity, this example uses the polarity scores calculated above
            return (int) polarityScores(sentence)[0] + (int) polarityScores(sentence)[1];
        }
    }

    private static class PorterStemmer {

        public String stem(String word) {
            // Implement a stemming algorithm here
            // For simplicity, this example leaves words unchanged
            return word;
        }
    }
}
