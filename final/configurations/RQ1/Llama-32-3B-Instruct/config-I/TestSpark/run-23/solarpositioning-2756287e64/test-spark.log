package net.e175.klaus.solarpositioning;

public class GeneratedTest {

    @Test
    public void calculateSolarPosition_DateAndLatitudeOnly_ReturnsNull() {
        assertThrows(NullPointerException.class, () -> Grena3.calculateSolarPosition(null, 0.0, 0.0, Double.MIN_VALUE));
    }

    @Test
    public void calculateSolarPosition_InvalidDate_ReturnsNull() {
        ZonedDateTime date = ZonedDateTime.of(10000, 1, 1, 0, 0, 0);
        assertThrows(NullPointerException.class, () -> Grena3.calculateSolarPosition(date, 0.0, 0.0, Double.MIN_VALUE));
    }

    @Test
    public void calculateSolarPosition_InvalidLatitude_ReturnsNull() {
        ZonedDateTime date = ZonedDateTime.ofNow();
        double latitude = Double.MAX_VALUE;
        assertThrows(NullPointerException.class, () -> Grena3.calculateSolarPosition(date, latitude, 0.0, Double.MIN_VALUE));
    }

    @Test
    public void calculateSolarPosition_InvalidLongitude_ReturnsNull() {
        ZonedDateTime date = ZonedDateTime.ofNow();
        double longitude = Double.MAX_VALUE;
        assertThrows(NullPointerException.class, () -> Grena3.calculateSolarPosition(date, 0.0, longitude, Double.MIN_VALUE));
    }

    @Test
    public void calculateSolarPosition_ValidParameters_ReturnsAzimuthAndAltitude() {
        ZonedDateTime date = ZonedDateTime.ofNow();
        double latitude = 37.7749;
        double longitude = -122.4194;
        assertNotEquals(null, Grena3.calculateSolarPosition(date, latitude, longitude, Double.MIN_VALUE, Double.MIN_VALUE));
    }

    @Test
    public void calculateT_ValidDate_ReturnsDouble() {
        ZonedDateTime date = ZonedDateTime.ofNow();
        assertEquals(0.0, Grena3.calcT(date), 1e-6);
    }

    @Test
    public void calcT_ValidDateAndTime_ReturnsDouble() {
        ZonedDateTime date = ZonedDateTime.of(2022, 12, 25, 12, 30, 0);
        assertEquals(1.1574e-5 * Double.MIN_VALUE, Grena3.calcT(date), 1e-6);
    }

}
