package org.jsoup.nodes;

import org.junit.Test;
import org.mockito.Mock;
import org.mockito.Mockito;

import static org.junit.Assert.*;
import static org.hamcrest.MatcherAssert.assertThat;
import static org.hamcrest.Matchers.is;

public class GeneratedTest {

    @Mock
    private LeafNode parentNode;

    @Mock
    private Appendable accum;

    public String getNodeName(Comment comment) {
        return comment.nodeName();
    }

    public String getData(Comment comment) {
        return comment.getData();
    }

    public Comment setData(Comment comment, String data) {
        return comment.setData(data);
    }

    public void outerHtmlHead(Comment comment, Appendable accum) throws Exception {
        comment.outerHtmlHead(accum, 0, null);
        assertEquals("<!--" + getData(comment) + "-->", accum.toString());
    }

    public void outerHtmlTail(Comment comment, Appendable accum) {
        comment.outerHtmlTail(accum, 0, null);
        assertNull(accum.toString());
    }

    public String toString(Comment comment) throws Exception {
        return comment.toString();
    }

    public Comment clone(Comment comment) {
        return comment.clone();
    }

    public boolean isXmlDeclaration(Comment comment, String data) {
        return data.startsWith("!") && data.contains("?xml");
    }

    @Test
    public void testDataSetsNodeName() {
        Comment comment = new Comment("data");
        String expected = "data";
        String actual = getNodeName(comment);
        assertThat(actual, is(expected));
    }

    @Test
    public void testDataSetsData() {
        Comment comment = new Comment("data");
        String expected = "data";
        String actual = getData(comment);
        assertThat(actual, is(expected));
    }

    @Test
    public void testDataSetsDataWhenSettingNewValue() {
        Comment comment = new Comment("data");
        String newExpected = "new data";
        Comment actual = setData(comment, newExpected);
        String actualExpected = getData(actual);
        assertThat(actualExpected, is(newExpected));
    }

    @Test
    public void testOuterHtmlHeadAppendsDataToAccum() throws Exception {
        Comment comment = new Comment("data");
        outerHtmlHead(comment, accum);
        assertEquals("<!--" + "data" + "-->", accum.toString());
    }

    @Test
    public void testOuterHtmlTailDoesNotAppendAnythingToAccum() {
        Comment comment = new Comment("");
        outerHtmlTail(comment, accum);
        assertNull(accum.toString());
    }

    @Test
    public void testToStringReturnsOuterHtml() throws Exception {
        Comment comment = new Comment("data");
        String expected = "/* <!-- data --> */";
        String actual = toString(comment);
        assertEquals(expected, actual);
    }

    @Test
    public void testCloneReturnsNewComment() {
        Comment comment = new Comment("data");
        Comment cloned = clone(comment);
        assertNotNull(cloned);
        assertEquals(comment, cloned);
    }

    @Test
    public void testIsXmlDeclarationReturnsTrueIfDataStartsWithSlashAndQuestionMark() {
        String data = "!?xml";
        Comment comment = new Comment(data);
        assertTrue(isXmlDeclaration(comment, data));
    }

    @Test
    public void testIsXmlDeclarationReturnsFalseIfDataDoesNotStartWithSlashOrQuestionMark() {
        String data = "This is a comment";
        Comment comment = new Comment(data);
        assertFalse(isXmlDeclaration(comment, data));
    }

