        AppVersion parsedAppVersion = AppVersion.parseName(amiName);
        assertNull(parsedAppVersion);
    }

    @Test
    public void parseName_AppendsCommitIdToBuildNumberWhenAvailable() {
        String amiName = "subscriberha-1.0.0-h586499/WE-WAPP-subscriberha/150";
        AppVersion parsedAppVersion = AppVersion.parseName(amiName);
        assertEquals("h586499", parsedAppVersion.buildNumber);
    }

    @Test
    public void parseName_AppendsCommitIdToBuildNumberWhenNotAvailable() {
        String amiName = "subscriberha-1.0.0-h586499";
        AppVersion parsedAppVersion = AppVersion.parseName(amiName);
        assertNull(parsedAppVersion.buildNumber);
    }

    @Test
    public void parseName_MatchesBuildJobNamePattern() {
        String amiName = "subscriberha-1.0.0-586499";
        AppVersion parsedAppVersion = AppVersion.parseName(amiName);
        assertNotNull(parsedAppVersion.buildJobName);
    }

    @Test
    public void getPackageName_ReturnsParsedPackage_WhenAvailable() {
        String amiName = "subscriberha-1.0.0-586499";
        AppVersion parsedAppVersion = AppVersion.parseName(amiName);
        assertEquals("subscriberha", parsedAppVersion.getPackageName());
    }

    @Test
    public void getPackageName_ReturnsNull_WhenNotAvailable() {
        String amiName = "invalid-app-pattern";
        AppVersion parsedAppVersion = AppVersion.parseName(amiName);
        assertNull(parsedAppVersion.getPackageName());
    }

