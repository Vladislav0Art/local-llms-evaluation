    public void whenAsXmlDeclarationThenNullIsReturnedIfNoXmlDeclarationData() {
        Comment comment = new Comment("data");
        assertNotNull(comment.asXmlDeclaration());
    }

    @Test
    public void whenIsXmlDeclarationThenCorrectConditionIsMet() {
        Comment comment = new Comment("data");
        assertTrue(comment.isXmlDeclaration());
    }

    @Test
    public void whenIsXmlDeclarationThenCorrectFragmentIsGenerated() {
        Comment comment = new Comment("data");
        String fragment = "<data>";
        assertEquals(fragment, comment.asXmlDeclaration().fragment());
    }

