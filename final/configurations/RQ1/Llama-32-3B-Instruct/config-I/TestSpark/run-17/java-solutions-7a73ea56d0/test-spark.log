public class LeetCodeSolution {

    public int[] next(int[] prices) {
        int n = prices.length;
        int[] result = new int[n];
        result[0] = 1;
        Stack<Integer> stack = new Stack<>();

        for (int i = 1; i < n; i++) {
            while (!stack.isEmpty() && prices[i] > prices[stack.peek()]) {
                stack.pop();
            }
            if (stack.isEmpty()) {
                result[i] = i + 1;
            } else {
                result[i] = i - stack.peek();
            }
            stack.push(i);
        }

        return result;
    }

    public boolean isPerfectSquare(int num) {
        double sqrt = Math.sqrt(num);
        return sqrt == (int) sqrt;
    }

    public int numDaysToOpen(int initialScore, int targetScore, int minAddScore) {
        int days = 0;
        while (initialScore < targetScore && initialScore + minAddScore >= targetScore - days * minAddScore) {
            initialScore += minAddScore;
            days++;
        }
        return days;
    }

    public boolean canBePrime(int num) {
        if (num == 1) {
            return false;
        } else if (num == 2) {
            return true;
        }
        for (int i = 2; i <= Math.sqrt(num); i++) {
            if (num % i == 0) {
                return false;
            }
        }
        return true;
    }

    public boolean isPalindrome(String s) {
        int left = 0, right = s.length() - 1;
        while (left < right) {
            if (s.charAt(left++) != s.charAt(right--)) {
                return false;
            }
        }
        return true;
    }

    public boolean validLetter(String input, String alphabet) {
        char ch = input.charAt(0);
        for (char c : alphabet.toCharArray()) {
            if (c == ch) {
                return true;
            }
        }
        return false;
    }

    public int minCoins(int[] coins, int amount) {
        int dp[] = new int[amount + 1];
        Arrays.fill(dp, Integer.MAX_VALUE);
        dp[0] = 0;

        for (int i = 1; i <= amount; i++) {
            if (dp[i - 1] != Integer.MAX_VALUE) {
                for (int coin : coins) {
                    if (i >= coin && dp[i - coin] + 1 < dp[i]) {
                        dp[i] = dp[i - coin] + 1;
                    }
                }
            }
        }

        return dp[amount] == Integer.MAX_VALUE ? -1 : dp[amount];
    }

    public int minCoinsForAll(int[] coins, int amount) {
        int dp[] = new int[amount + 1];
        Arrays.fill(dp, Integer.MAX_VALUE);
        dp[0] = 0;

        for (int i = 1; i <= amount; i++) {
            if (dp[i - 1] != Integer.MAX_VALUE) {
                for (int coin : coins) {
                    if (i >= coin && dp[i - coin] + 1 < dp[i]) {
                        dp[i] = dp[i - coin] + 1;
                    }
                }
            }
        }

        return dp[amount] == Integer.MAX_VALUE ? -1 : dp[amount];
    }

    public int minCoinsForAllTwo(int[] coins, int amount) {
        int dp[] = new int[amount + 1];
        Arrays.fill(dp, Integer.MAX_VALUE);
        dp[0] = 0;

        for (int i = 1; i <= amount; i++) {
            if (dp[i - 1] != Integer.MAX_VALUE) {
                for (int coin : coins) {
                    if (i >= coin && dp[i - coin] + 1 < dp[i]) {
                        dp[i] = dp[i - coin] + 1;
                    }
                }
            }
        }

        return dp[amount] == Integer.MAX_VALUE ? -1 : dp[amount];
    }

}

