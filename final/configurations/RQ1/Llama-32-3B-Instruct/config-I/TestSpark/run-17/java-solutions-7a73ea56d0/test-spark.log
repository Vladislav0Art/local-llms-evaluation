public class OnlineStockSpan {

    public int[] next(int[] prices) {
        int n = prices.length;
        int[] result = new int[n];
        Stack<Integer> stack = new Stack<>();

        for (int i = 0; i < n; i++) {
            if (stack.isEmpty() || prices[stack.peek()] <= prices[i]) {
                result[i] = i + 1;
                stack.push(i);
            } else {
                int val = stack.pop();
                int count = result[val];
                result[val] = count + (i - val);
                stack.push(val);
            }
        }

        return result;
    }
}

