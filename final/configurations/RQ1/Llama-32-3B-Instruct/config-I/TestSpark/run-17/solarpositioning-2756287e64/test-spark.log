    }

    @Test
    public void calcT_NoLeapYear_ReturnsCorrectValues() {
        // Given
        ZonedDateTime date = ZonedDateTime.now();
        int year = 2022;
        int month = 7;
        int dayOfMonth = 15;

        // When
        Grena3 calculateT = new Grena3();
        double expected = (int) (365.25 * (year - 2000)) + (int) (30.6001 * (month + 1))
