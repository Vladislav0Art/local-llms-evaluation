import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;

public class XmlTreeBuilder {

    private static final Entities.EscapeMode DEFAULT_ESCAPE_MODE = Entities.EscapeMode.xhtml;

    /**
     * Parses the input string into an XML tree.
     *
     * @param input  the input string to parse
     * @param baseUri the base URI for the parsed XML tree
     * @return the parsed XML tree as a Document object
     */
    public static Document parse(String input, String baseUri) {
        // Implementation of xml parsing using Jsoup
        Document doc = Jsoup.parse(input).getOuterHtml();
        Element rootElement = doc.element("root");
        if (rootElement == null) {
            throw new RuntimeException("Failed to find root element in input string");
        }
        return doc;
    }

    /**
     * Returns the default escape mode used for escaping special characters in the input string.
     *
     * @return the default escape mode
     */
    public static Entities.EscapeMode getEscapeMode() {
        return DEFAULT_ESCAPE_MODE;
    }

    /**
     * Escapes special characters in the input string according to the specified escape mode.
     *
     * @param input      the input string to escape
     * @param escapeMode the escape mode to use for escaping
     * @return the escaped input string
     */
    public static String escape(String input, Entities.EscapeMode escapeMode) {
        // Implementation of escaping using Jsoup's Entities library
        return Jsoup.escape(input);
    }

    /**
     * Pretty prints the XML tree as a formatted string.
     *
     * @param doc the XML tree to pretty print
     * @return the pretty printed XML tree as a formatted string
     */
    public static String prettyPrint(Document doc) {
        // Implementation of pretty printing using Jsoup's pretty printer
        return doc.outputSettings().prettyPrint();
    }

    /**
     * Pretty prints the input string as an XML tree.
     *
     * @param input the input string to pretty print
     * @return the pretty printed XML tree as a formatted string
     */
    public static String prettyPrint(String input) {
        Document doc = parse(input, null);
        return prettyPrint(doc);
    }

    /**
     * Sets the escape mode for escaping special characters in the input string.
     *
     * @param escapeMode the new escape mode to use for escaping
     */
    public static void setEscapeMode(Entities.EscapeMode escapeMode) {
        DEFAULT_ESCAPE_MODE = escapeMode;
    }
}
```

**Example Usage**

```java
public class Main {

    public static void main(String[] args) {
        String input = "<root><item>Item 1</item></root>";
        Document doc = XmlTreeBuilder.parse(input, "baseUri");
        System.out.println(doc);

        Entities.EscapeMode escapeMode = XmlTreeBuilder.getEscapeMode();
        String escapedInput = XmlTreeBuilder.escape(input, escapeMode);
        System.out.println(escapedInput);

        String prettyPrintedDoc = XmlTreeBuilder.prettyPrint(doc);
        System.out.println(prettyPrintedDoc);

        XmlTreeBuilder.setEscapeMode(Entities.EscapeMode.Xml);
        String prettyPrintedXml = XmlTreeBuilder.prettyPrint(input);
        System.out.println(prettyPrintedXml);
    }
}
```

