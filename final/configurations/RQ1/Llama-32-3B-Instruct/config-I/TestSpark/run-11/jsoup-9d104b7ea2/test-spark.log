import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.nodes.Node;
import org.jsoup.nodes.TextNode;
import org.jsoup.select.Elements;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertFalse;
import static org.junit.Assert.assertNotNull;
import static org.junit.Assert.assertNull;
import static org.junit.Assert.assertTrue;
import static org.junit.Assert.assertEquals;
import static org.mockito.Mockito.when;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.verify;

@RunWith(MockitoJUnitRunner.class)
public class TextNodeTest {

    @Mock
    private Document document;

    @Mock
    private Node node;

    @Mock
    private TextNode textNode;

    public void testText() {
        when(textNode.getWholeText()).thenReturn("test");
        assertEquals("test", textNode.text());
    }

    public void testIsBlank() {
        when(textNode.getWholeText()).thenReturn("");
        assertTrue(textNode.isBlank());

        when(textNode.getWholeText()).thenReturn(" ");
        assertTrue(textNode.isBlank());

        when(textNode.getWholeText()).thenReturn("\t");
        assertTrue(textNode.isBlank());

        when(textNode.getWholeText()).thenReturn("\n");
        assertTrue(textNode.isBlank());

        when(textNode.getWholeText()).thenReturn("\r\n");
        assertTrue(textNode.isBlank());

        when(textNode.getWholeText()).thenReturn("test");
        assertFalse(textNode.isBlank());
    }

    public void testSplitText() {
        TextNode textNode = new TextNode("text");
        int offset = 5;
        TextNode result = textNode.splitText(offset);
        assertEquals(0, result.text().length());

        TextNode tailNode = new TextNode("nextTest");
        result.parentNode().addChildren(result.siblingIndex() + 1, tailNode);

        verify(document).addChild(tailNode);
    }

    public void testSplitTextOffsetIsInvalid() {
        when(textNode.coreValue()).thenReturn("");
        assertEquals("", textNode.splitText(-5));
    }

    public void testSplitTextOffsetIsGreaterThenTextLength() {
        TextNode textNode = new TextNode("text");
        int offset = 10;
        try {
            textNode.splitText(offset);
            assert false : "Expected IOException";
        } catch (IllegalArgumentException e) {
            // Expected
        }
    }

    public void testOuterHtmlHead() throws Exception {
        when(textNode.parentNode()).thenReturn(document);
        Appendable accum = mock(Appendable.class);
        int depth = 0;
        Document.OutputSettings out = mock(Document.OutputSettings.class);

        textNode.outerHtmlHead(accum, depth, out);
        verify(accum).append(textNode.coreValue());
    }

    public void testOuterHtmlTail() throws Exception {
        when(textNode.parentNode()).thenReturn(document);
        Appendable accum = mock(Appendable.class);
        int depth = 0;
        Document.OutputSettings out = mock(Document.OutputSettings.class);

        textNode.outerHtmlTail(accum, depth, out);
        verify(accum).append("");
    }

    public void testClone() {
        TextNode originalText = new TextNode("text");
        TextNode clone = originalText.clone();
        assertNotNull(clone);
        assertEquals(originalText.value(), clone.text());
    }

    public void testcreateFromEncoded() {
        when(document.toString()).thenReturn("<encodedText>");
        TextNode textNode = TextNode.createFromEncoded("");
        assertNotNull(textNode);

        assertEquals("encodedText", textNode.coreValue());
    }
}
```
