import org.junit.Test;
import static org.junit.Assert.*;
import org.jsoup.helper.Validate;
import org.jsoup.nodes.Document;
import org.jsoup.parser.XmlTreeBuilder;
import org.jsoup.nodes.CDataNode;
import org.jsoup.nodes.TextNode;
import java.io.Reader;
import java.util.List;

public class XmlTreeBuilderTest {

    @Test
    public void parse_WithValidXml_ReturnsDocument() {
        XmlTreeBuilder builder = new XmlTreeBuilder();
        Document doc = builder.parse(new StringReader("<root>Hello World!</root>"), "");
        assertNotNull(doc);
        assertEquals("root", doc.getDocumentElement().getNodeName());
    }

    @Test
    public void parse_WithInvalidXml_ReturnsEmptyDocument() {
        XmlTreeBuilder builder = new XmlTreeBuilder();
        Document doc = builder.parse(new StringReader("<root>Hello World!</root>"), "");
        assertEquals(0, doc.getDocumentElement().getChildNodes().getLength());
    }

    @Test
    public void initialiseParse_WithInputAndBaseUriCallsInitialise() {
        XmlTreeBuilder builder = new XmlTreeBuilder();
        builder.initialiseParse(new StringReader("<root>Hello World!</root>"), "", null);
        assertNotNull(builder.stack);
        assertNotNull(builder.doc.outputSettings());
    }

    @Test
    public void initialiseParse_WithInputAndEmptyBaseUriCallsInitialise() {
        XmlTreeBuilder builder = new XmlTreeBuilder();
        builder.initialiseParse(new StringReader("<root>Hello World!</root>"), "", null);
        assertNotNull(builder.stack);
        assertNotNull(builder.doc.outputSettings());
