import static org.junit.Assert.assertNull;
import static org.junit.Assert.assertTrue;
import static org.junit.Assert.assertFalse;
import static org.mockito.Mockito.when;

@RunWith(MockitoJUnitRunner.class)
public class GeneratedTest {

    @Mock
    private Connection connection;

    @InjectMocks
    private UrlBuilder urlBuilder;

    @Test
    public void buildUrl_PunyCodingHostTest() {
        when(connection.getHost()).thenReturn("example.com");
        URL inputUrl = new URL("http://example.com/path?query=value#fragment");
        String expectedUri = "http://x0.0.x1.org/path?query=value#fragment";
        urlBuilder.u = inputUrl;
        String normalizedUrl = urlBuilder.build().toString();
        assertEquals(expectedUri, normalizedUrl);
    }

    @Test
    public void buildUrl_EncodeQueryTest() {
        when(connection.getHost()).thenReturn("example.com");
        URL inputUrl = new URL("http://example.com/path?query=value&other=query#fragment");
        String expectedUri = "http://x0.0.x1.org/path?query=value+other.query#fragment";
        urlBuilder.u = inputUrl;
        String normalizedUrl = urlBuilder.build().toString();
        assertEquals(expectedUri, normalizedUrl);
    }

    @Test
    public void buildUrl_EncodePathTest() {
        when(connection.getHost()).thenReturn("example.com");
        URL inputUrl = new URL("http://example.com/äöü/test?query=value#fragment");
        String expectedUri = "http://x0.0.x1.org/%C3%A4%C3%B6%C3%BC/test?query=value#fragment";
        urlBuilder.u = inputUrl;
        String normalizedUrl = urlBuilder.build().toString();
        assertEquals(expectedUri, normalizedUrl);
    }

    @Test
    public void buildUrl_NonAsciiQueryTest() {
        when(connection.getHost()).thenReturn("example.com");
        URL inputUrl = new URL("http://example.com/path?query=äöü+test=value#fragment");
        String expectedUri = "http://x0.0.x1.org/path?query=%C3%A4%C3%B6%C3%BC%20test=value#fragment";
        urlBuilder.u = inputUrl;
        String normalizedUrl = urlBuilder.build().toString();
        assertEquals(expectedUri, normalizedUrl);
    }

    @Test
    public void buildUrl_SameQueryFragmentTest() {
        when(connection.getHost()).thenReturn("example.com");
        URL inputUrl = new URL("http://example.com/path?query=value&ref=fragment#fragment");
        String expectedUri = "http://x0.0.x1.org/path?query=value%3D%23fragment";
        urlBuilder.u = inputUrl;
        String normalizedUrl = urlBuilder.build().toString();
        assertEquals(expectedUri, normalizedUrl);
    }

    @Test
    public void buildUrl_InvalidProtocolTest() {
        when(connection.getHost()).thenReturn("example.com");
        URL inputUrl = new URL("http+://example.com/path?query=value#fragment");
        assertNull(urlBuilder.build());
    }

}
