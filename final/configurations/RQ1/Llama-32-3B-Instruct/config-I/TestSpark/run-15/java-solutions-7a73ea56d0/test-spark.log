		List<Integer> list = new ArrayList<>();
		Stack<Integer> stack = new Stack<>();
		
		int next(int price) {
		if (list.isEmpty() || !list.get(list.size() - 1).equals(price)) {
		list.add(price);
		}
		
		while (!stack.isEmpty() && stack.peek().equals(price)) {
		list.remove(stack.pop());
		}
		
		stack.push(price);
		
		return list.size();
		}
	}
])
