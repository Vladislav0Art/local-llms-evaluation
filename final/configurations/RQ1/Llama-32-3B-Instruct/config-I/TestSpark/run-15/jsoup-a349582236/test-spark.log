I apologize for the empty response earlier. Here's a Java solution for your problem:

```java
import java.util.HashMap;
import java.util.Map;

public class Main {
    public static void main(String[] args) {
        // Initialize an empty map to store tags
        Map<String, Tag> tags = new HashMap<>();

        // Create and register some common HTML tags
        createAndRegisterTags(tags);

        // Print the registered tags
        System.out.println("Registered Tags:");
        for (Tag tag : tags.values()) {
            System.out.println(tag.getTagName());
        }

        // Add a new tag to the map
        Tag newTag = new Tag("script");
        tags.put(newTag.getTagName(), newTag);

        // Print the updated registered tags
        System.out.println("\nUpdated Registered Tags:");
        for (Tag tag : tags.values()) {
            System.out.println(tag.getTagName());
        }
    }

    public static void createAndRegisterTags(Map<String, Tag> tags) {
        // Create a block-level heading tag
        Tag h1 = new Tag("h1");
        h1.setBlock(true);
        h1.setFormatAsInline(false);

        // Create an inline-level link tag
        Tag a = new Tag("a");
        a.setBlock(false);
        a.setFormatAsInline(true);
        a.setPreserveWhitespace(true);
        tags.put(a.getTagName(), a);

        // Create a block-level paragraph tag
        Tag p = new Tag("p");
        p.setBlock(true);
        p.setFormatAsInline(false);
        tags.put(p.getTagName(), p);

        // Create an inline-level strong tag
        Tag strong = new Tag("strong");
        strong.setBlock(false);
        strong.setFormatAsInline(true);
        tags.put(strong.getTagName(), strong);
    }

    public static class Tag {
        private String tagName;
        private boolean block;
        private boolean formatAsInline;

        public Tag(String tagName) {
            this.tagName = tagName;
        }

        public void setBlock(boolean block) {
            this.block = block;
        }

        public void setFormatAsInline(boolean formatAsInline) {
            this.formatAsInline = formatAsInline;
        }

        public String getTagName() {
            return tagName;
        }
    }
}
```

