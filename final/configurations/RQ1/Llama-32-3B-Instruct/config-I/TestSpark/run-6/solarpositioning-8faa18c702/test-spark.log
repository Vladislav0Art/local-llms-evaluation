    public void testCalculateDeltaT() {
        DeltaT deltaT = new DeltaT();

        DateRange dateRange1 = new DateRange(0, 365); // Jan 1, 2022 to Dec 31, 2022
        double result1 = deltaT.calculateDeltaT(dateRange1.getStartDate(), dateRange1.getEndDate());
        org.junit.Assert.assertEquals(365.0, result1);

        DateRange dateRange2 = new DateRange(-730, 365); // Nov 1, 2021 to Dec 31, 2022
        double result2 = deltaT.calculateDeltaT(dateRange2.getStartDate(), dateRange2.getEndDate());
        org.junit.Assert.assertEquals(1095.0, result2);

        DateRange dateRange3 = new DateRange(-1461, -730); // Nov 1, 2020 to Oct 31, 2021
        double result3 = deltaT.calculateDeltaT(dateRange3.getStartDate(), dateRange3.getEndDate());
        org.junit.Assert.assertEquals(731.0, result3);
    }

    @org.junit.Test
    public void testCalculateDeltaTEdgeCase() {
        DeltaT deltaT = new DeltaT();

        DateRange dateRange = new DateRange(2022, 1); // Jan 1, 2023 to Dec 31, 2022
        double result = deltaT.calculateDeltaT(dateRange.getStartDate(), dateRange.getEndDate());
        org.junit.Assert.assertTrue(deltaT.assertTrue(result >= -15 && result <= 365));
    }

    @org.junit.Test
    public void testCalculateDeltaTZeroYear() {
        DeltaT deltaT = new DeltaT();

        DateRange dateRange = new DateRange(0, 1);
        double result = deltaT.calculateDeltaT(dateRange.getStartDate(), dateRange.getEndDate());
        org.junit.Assert.assertEquals(-20.0, result);
    }
}

