        commentsMap.put("key", Arrays.asList("value"));
        CommentsConfiguration commentsConfig = new CommentsConfiguration(commentsMap);
        assertNotNull(commentsConfig.comments);
        assertEquals(0, commentsConfig.comments.size());
    }

