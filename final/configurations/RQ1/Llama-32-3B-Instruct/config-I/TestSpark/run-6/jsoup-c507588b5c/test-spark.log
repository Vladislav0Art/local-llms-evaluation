        TextNode result = textNode.splitText(textNode.text().length());
        assertEquals(textNode, result);
    }

    @Test
    public void isBlank_TextIsBlank_ThenReturnTrue() {
        TextNode textNode = new TextNode("");
        assertTrue(textNode.isBlank());
