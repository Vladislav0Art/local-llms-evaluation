import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.nodes.Node;
import org.jsoup.nodes.TextNode;

public class GeneratedTest {

    public static void main(String[] args) {
        Node parentNode = new Element("div");
        Document document = new Document();
        
        TextNode textNode1 = new TextNode("123");
        parentNode.appendChild(textNode1);
        
        TextNode textNode2 = new TextNode("");
        parentNode.appendChild(textNode2);
        
        System.out.println(parentNode.outerHtml());
    }
}

public class Element extends Node {
    public void appendChild(Node child) {
        if (child instanceof TextNode) {
            TextNode textNode = (TextNode) child;
            textNode.append(this);
        } else if (child instanceof Element) {
            appendChild((Element) child);
        } else {
            throw new UnsupportedOperationException("Unsupported node type: " + child.getClass());
        }
    }

    @Override
    public String outerHtml() {
        StringBuilder builder = new StringBuilder();
        if (isEmpty()) {
            return "";
        }
        builder.append("<").append(this.name()).append(">");

        for (Node node : children()) {
            builder.append(node.outerHtml());
        }

        builder.append("</").append(this.name()).append(">");
        return builder.toString();
    }

    public String name() {
        // implementation
    }
}

public class TextNode extends Element {
    private StringBuilder text = new StringBuilder();

    public void append(Element parent) {
        text.append(parent.name());
    }

    @Override
    public String outerHtml() {
        if (isEmpty()) {
            return "";
        }
        return "<t>" + text.toString() + "</t>";
    }
}

public class Document {
    private Element root;

    public Document() {}

