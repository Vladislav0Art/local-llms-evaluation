import org.junit.Test;
import static org.junit.Assert.*;
import java.net.MalformedURLException;
import java.net.URI;
import java.net.URISyntaxException;
import java.net.URL;
import java.net.IDN;
import java.io.UnsupportedEncodingException;

public class UrlBuilderTest {

    @Test
    public void newUrlBuilderWithValidUrl_BUILDSURL() throws MalformedURLException, URISyntaxException {
        URL url = new URL("http://example.com/path?query#anchor");
        UrlBuilder builder = new UrlBuilder(url);
        assertSame(builder.u, new URL(builder.build()));
    }

    @Test
    public void newUrlBuilderWithInvalidProtocol_BUILDSURL() throws MalformedURLException, URISyntaxException {
        String invalidProtocol = "http+/example.com/path";
        URL url = new URL(invalidProtocol);
        UrlBuilder builder = new UrlBuilder(url);
        assertSame(builder.u, new URL(builder.build()));
    }

    @Test
    public void appendKeyVal_BUILDSURL() throws MalformedURLException, URISyntaxException {
        String query = "key=value&another+key=anothervalu";
        URL url = new URL("http://example.com/path");
        UrlBuilder builder = new UrlBuilder(url);
        builder.appendKeyVal(new Connection.KeyVal("key", "value"));
        assertEquals("?key=value&another%2Bkey=anothervalu", (builder.q != null ? builder.q.toString() : ""));
    }

    @Test
    public void decodePart_BUILDSURL() throws MalformedURLException, URISyntaxException {
        String encoded = "http%3A%2F%2Fexample.com%2F";
        URL url = new URL(encoded);
        UrlBuilder builder = new UrlBuilder(url);
        assertSame(builder.u, new URL(builder.build()));
    }

    @Test
    public void appendToAscii_BUILDSURL() throws MalformedURLException, URISyntaxException {
        String encoded = "http://example.com/path?query=with%20spaces&another+key=anothervalu";
        URL url = new URL(encoded);
        UrlBuilder builder = new UrlBuilder(url);
        assertEquals("http://example.com/path%3Fquery%3Dwith+spaces%26another%2Bkey%3Danothervalu", (builder.q != null ? builder.q.toString() : ""));
    }

    @Test
    public void appendToAsciiWithNonASCII_BUILDSURL() throws MalformedURLException, URISyntaxException {
        String encoded = "http://example.com/path?query=withéspaces&another+key=anothervalu";
        URL url = new URL(encoded);
        UrlBuilder builder = new UrlBuilder(url);
        assertEquals("http://example.com/path%3Fquery%3Dwith%C3%A9spaces%26another%2Bkey%3Danothervalu", (builder.q != null ? builder.q.toString() : ""));
    }

}

