import org.junit.Test;
import static org.junit.Assert.assertEquals;

public class DeltaTTest {

    @Test
    public void estimateDeltaTEarlyYearsBefore2000() {
        LocalDate forDate = LocalDate.of(1800, 1, 1);
        assertEquals(-21.8, DeltaT.estimate(forDate), 0.01);
    }

    @Test
    public void estimateDeltaTBetween1900And1950() {
        LocalDate forDate = LocalDate.of(1933, 6, 20);
        assertEquals(23.7, DeltaT.estimate(forDate), 0.1);
    }

    @Test
    public void estimateDeltaTEarlyMillennium() {
        LocalDate forDate = LocalDate.of(2005, 12, 31);
        assertEquals(-4.3, DeltaT.estimate(forDate), 0.01);
    }

    @Test
    public void estimateDeltaTFiveMillenniumBefore1820() {
        LocalDate forDate = LocalDate.of(1750, 1, 1);
        assertEquals(11.2, DeltaT.estimate(forDate), 0.1);
    }

    @Test
    public void estimateDeltaTBeyondFiveMillennium() {
        LocalDate forDate = LocalDate.of(2200, 12, 31);
        assertEquals(-24.8, DeltaT.estimate(forDate), 0.01);
    }

}

public class DeltaTCenturiesAfter2005 extends DeltaT {

    @Override
    public double estimate(LocalDate forDate) {
        return super.estimate(forDate);
    }
}
