    @Test
    public void urlBuilderNormalizationWithNonAsciiPathTest() {
        URL u = new URL("http://example.com/äöü/path?a=1&b=2#fragment");
        UrlBuilder builder = new UrlBuilder(u);
        builder.build();
        URI uri = u.getURI();
        assertEquals("http", uri.getScheme());
        assert uri.getHost().equals(IDN.toASCII(DataUtil.decodePart(uri.getHost())));
    }

    @Test
    public void urlBuilderNormalizationWithQueryAndFragmentTest() {
        URL u = new URL("http://example.com/path?a=1&b=2#fragment");
        UrlBuilder builder = new UrlBuilder(u);
        builder.build();
        String query = u.getQuery();
        assertEquals("?a=1&b=2", query);
        String fragment = u.getRef();
        assertEquals("#fragment", fragment);
    }

    @Test
    public void urlBuilderNormalizationWithNonAsciiQueryAndFragmentTest() {
        URL u = new URL("http://example.com/äöü/path?a=1&b=2#fragment");
        UrlBuilder builder = new UrlBuilder(u);
        builder.build();
        String query = u.getQuery();
        assertEquals("?a=1%26b=2", query); // UTF-8 normalization
    }

