        String formattedCssCode1 = cssFormatter.formatCode(cssCode1);
        String formattedCssCode2 = cssFormatter.formatCode(cssCode2);
        assert formattedCssCode1.equals("/* " + cssCode1 + " */");
        assert formattedCssCode2.equals("/* " + cssCode2 + " */");
    }
}
