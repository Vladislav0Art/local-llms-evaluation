import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.nodes.TextNode;
import org.junit.jupiter.api.Test;

public class TestJsoup {
    @Test
    public void testJsoupSplitText() throws Exception {
        Document document = Jsoup.parse("<div>Hello <span>World</span></div>");
        TextNode textNode = new TextNode(document, "Hello", 0);
        assertEquals("Hello World", textNode.value());

        String clonedTextNodeValue = textNode.splitText(10).value();
        assertEquals("Hello", clonedTextNodeValue);

        assertTrue(textNode.isBlank());
    }

    @Test
    public void testJsoupSplitTextNegative() throws Exception {
        Document document = Jsoup.parse("<div>Hello <span>World</span></div>");
        TextNode textNode = new TextNode(document, "Hello", 10);
        assertThrows(IllegalArgumentException.class, () -> textNode.splitText(-5));
    }

    @Test
    public void testJsoupSplitTextOffsetEqualToLength() throws Exception {
        Document document = Jsoup.parse("<div>Hello <span>World</span></div>");
        TextNode textNode = new TextNode(document, "Hello", 10);
        assertEquals("Hello", textNode.splitText(10).value());
    }

    @Test
    public void testJsoupOuterHtml() throws Exception {
        Document document = Jsoup.parse("<div>Hello <span>World</span></div>");
        TextNode textNode = new TextNode(document, "Hello", 0);
        assertEquals("<p>Hello</p>", textNode.outerHtml());
    }

    @Test
    public void testTextNodeValue() throws Exception {
        Document document = Jsoup.parse("<div>Hello <span>World</span></div>");
        TextNode textNode = new TextNode(document, "Hello", 0);
        assertEquals("Hello", textNode.value());

        TextNode clonedTextNode = new TextNode(document, "Hello", 10);
        assertEquals("Hello", clonedTextNode.value());
    }

    @Test
    public void testTextNodeBlank() throws Exception {
        Document document = Jsoup.parse("<div></div>");
        TextNode textNode = new TextNode(document, "", 0);
        assertTrue(textNode.isBlank());

        TextNode emptyTextNode = new TextNode(document, "", 10);
        assertTrue(emptyTextNode.isBlank());
    }
}

class TextNode {
    private Document document;
    private String value;
    private int offset;

    public TextNode(Document document, String value, int offset) {
        this.document = document;
        this.value = value;
        this.offset = offset;
    }

    public String outerHtml() {
        return document.selectFirst("div").html();
    }

    public TextNode splitText(int offset) {
        // implement split text logic here
        return null;
    }

    public String value() {
        return value;
    }

    public boolean isBlank() {
        return value.isEmpty();
    }
}
