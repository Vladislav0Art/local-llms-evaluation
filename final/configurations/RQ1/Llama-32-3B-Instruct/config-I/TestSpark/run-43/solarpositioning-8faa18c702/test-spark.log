    public void estimate_DeltaTCrossesZeroLine() {
        LocalDate forDate = LocalDate.of(2020, 1, 1);
        double result = net.e175.klaus.solarpositioning.DeltaT.estimate(forDate);
        assertEquals(0.0, result, ChronoUnit.SECONDS);
    }

    @Test
    public void estimate_NearZeroYear() {
        LocalDate forDate = LocalDate.of(-9999, 1, 1);
        double result = net.e175.klaus.solarpositioning.DeltaT.estimate(forDate);
        assertEquals(20.0, result, ChronoUnit.SECONDS);
    }

    @Test
    public void estimate_AroundZeroYear() {
        LocalDate forDate = LocalDate.of(0, 1, 1);
        double result = net.e175.klaus.solarpositioning.DeltaT.estimate(forDate);
        assertEquals(10583.6, result, ChronoUnit.SECONDS);
    }

    @Test
    public void estimate_PastZeroYear() {
        LocalDate forDate = LocalDate.of(-500, 1, 1);
        double result = net.e175.klaus.solarpositioning.DeltaT.estimate(forDate);
        assertEquals(0.0, result, ChronoUnit.SECONDS);
    }

    @Test
    public void estimate_InFutureYears() {
        LocalDate forDate = LocalDate.of(2025, 1, 1);
        double result = net.e175.klaus.solarpositioning.DeltaT.estimate(forDate);
        assertEquals(-20.0, result, ChronoUnit.SECONDS);
    }

    @Test
    public void estimate_MonthsFromBeginningOfYear() {
        LocalDate forDate = LocalDate.of(2024, 12, 31);
        double result = net.e175.klaus.solarpositioning.DeltaT.estimate(forDate);
        assertEquals(-20.0, result, ChronoUnit.SECONDS);
    }

    @Test
