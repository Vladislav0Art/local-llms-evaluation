        LocalDate forDate = LocalDate.of(2024, 12, 31);
        double result = net.e175.klaus.solarpositioning.DeltaT.estimate(forDate.minusYears(1));
        assertEquals(-20.0, result, ChronoUnit.SECONDS);
    }

}

