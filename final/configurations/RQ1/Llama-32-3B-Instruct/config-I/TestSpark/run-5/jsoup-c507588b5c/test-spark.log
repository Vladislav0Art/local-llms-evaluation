    public void isBlank_ReturnsTrueForEmptyTextNode() {
        TextNode textNode = new TextNode();
        org.junit.Assert.assertTrue(textNode.isBlank());
    }

    @org.junit.Test
    public void isBlank_ReturnsFalseForNonEmptyTextNode() {
        TextNode textNode = new TextNode();
        textNode.setText("Hello, World!");
        org.junit.Assert.assertFalse(textNode.isBlank());
    }

    @org.junit.Test
    public void splitText_SplittingAtOffset_ReturnsNewTextNode() {
        String text = "Hello, World!";
        TextNode textNode = new TextNode();
        textNode.setText(text);
        TextNode result = textNode.splitText(6);
        org.junit.Assert.assertEquals("World!", result.getWholeText());
    }
}

