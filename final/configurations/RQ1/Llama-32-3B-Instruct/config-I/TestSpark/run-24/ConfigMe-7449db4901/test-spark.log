package ch.jalu.configme.configurationdata;

import org.junit.Test;
import static org.junit.Assert.*;
import java.util.Arrays;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import org.mockito.Mockito;

public class CommentsConfigurationTest {

    @Test
    public void constructor_test() {
        CommentsConfiguration comments = new CommentsConfiguration();
        assertNotNull(comments.getComments());
    }

    @Test
    public void setComment_singleLine_test() {
        CommentsConfiguration comments = new CommentsConfiguration();
        comments.setComment("path", "\n");
        assertEquals(1, comments.getComments().size());
    }

    @Test
    public void setComment_multipleLines_test() {
        CommentsConfiguration comments = new CommentsConfiguration();
        String[] lines = {"line1", "line2"};
        comments.setComment("path", lines);
        assertEquals(Arrays.asList(lines), comments.getComments().get("path"));
    }

    @Test
    public void setComment_repeatedPath_test() {
        CommentsConfiguration comments = new CommentsConfiguration();
        String[] lines = {"line1", "line2"};
        comments.setComment("path", lines);
        comments.setComment("path", Arrays.asList(lines));
        assertEquals(Arrays.asList(lines), comments.getComments().get("path"));
    }

    @Test
    public void getAllComments_test() {
        CommentsConfiguration comments = new CommentsConfiguration();
        Map<String, List<String>> expected = new HashMap<>();
        expected.put("path", Arrays.asList("line1", "line2"));
        assertEquals(expected, comments.getAllComments());
    }

    @Test
    public void setComment_invalidPath_test() {
        CommentsConfiguration comments = new CommentsConfiguration();
        try {
            comments.setComment("", "line");
            assert false;
        } catch (Exception e) {}
    }

    @Test
    public void getAllComments_emptyMap_test() {
        CommentsConfiguration comments = new CommentsConfiguration();
        Map<String, List<String>> expected = Collections.emptyMap();
        assertEquals(expected, comments.getAllComments());
    }
}
