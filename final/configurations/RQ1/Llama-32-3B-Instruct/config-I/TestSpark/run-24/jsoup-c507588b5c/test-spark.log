    public void splitText_givenOffset_returnsCorrectTextNode() {
        String text = "Hello World";
        TextNode textNode = new TextNode(text);
        TextNode expectedHead = new TextNode("Hello");
        TextNode expectedTail = new TextNode(StringUtil.normaliseWhitespace("World"));
        int offset = 6;
        TextNode result = textNode.splitText(offset);
        assertEquals(expectedHead.nodeName(), result.nodeName());
        assertEquals(expectedTail.text(), result.text());
    }

