import org.junit.Test;
import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertTrue;

public class Grena3Test {

    @Test
    public void calculateSolarPosition_CalculateSolarPositionForDefaultParameters_ReturnsExpectedResult() {
        ZonedDateTime date = ZonedDateTime.now();
        double latitude = 50.0;
        double longitude = -10.0;
        double deltaT = 3600.0;
        AzimuthZenithAngle result = Grena3.calculateSolarPosition(date, latitude, longitude, deltaT);
        assertTrue(result.getAzimuth() > 0);
    }

    @Test
    public void calculateSolarPosition_CalculateSolarPositionForZeroLatitude_ReturnsExpectedResult() {
        ZonedDateTime date = ZonedDateTime.now();
        double latitude = 0.0;
        double longitude = -10.0;
        double deltaT = 3600.0;
        AzimuthZenithAngle result = Grena3.calculateSolarPosition(date, latitude, longitude, deltaT);
        assertEquals(180, (int) result.getAzimuth());
    }

    @Test
    public void calculateSolarPosition_CalculateSolarPositionForNegativeLongitude_ReturnsExpectedResult() {
        ZonedDateTime date = ZonedDateTime.now();
        double latitude = 50.0;
        double longitude = -10.0;
        double deltaT = 3600.0;
        AzimuthZenithAngle result = Grena3.calculateSolarPosition(date, latitude, longitude, deltaT);
        assertEquals(90, (int) result.getAzimuth());
    }

    @Test
    public void calculateSolarPosition_CalculateSolarPositionForDifferentPressureAndTemperature_ReturnsExpectedResult() {
        ZonedDateTime date = ZonedDateTime.now();
        double pressure = 1000.0;
        double temperature = 273.0;
        AzimuthZenithAngle result = Grena3.calculateSolarPosition(date, 50.0, -10.0, 3600.0, pressure, temperature);
        assertTrue(result.getAzimuth() > 0 && result.getAzimuth() < 360);
    }

}

class AzimuthZenithAngle {
    public double getAzimuth();
    public double getElevation();

}
