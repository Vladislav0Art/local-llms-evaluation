        if (matcher.matches()) {
            int packageIndex = 0, versionIndex = 1, buildIndex = 2, commitIndex = 3;
            packageName = name.substring(packageIndex);
            String[] parts = name.substring(versionIndex + 1).split("-");
            if (parts.length > 0) {
                version = parts[0];
