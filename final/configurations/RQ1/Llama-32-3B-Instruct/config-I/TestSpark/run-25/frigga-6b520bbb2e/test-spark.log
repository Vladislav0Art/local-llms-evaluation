import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.powermock.api.mockito.PowerMockito;
import org.powermock.core.classloader.annotations.PrepareForTest;
import org.powermock.modules.junit4.PowerMockRunner;

import static org.hamcrest.CoreMatchers.is;
import static org.junit.Assert.assertThat;
import static org.mockito.Mockito.when;

@RunWith(PowerMockRunner.class)
@PrepareForTest(AppVersion.class)
public class AppVersion {

    @Mock
    private Pattern pattern;

    public AppVersion() {}

    @Test
    public void parseName_SimpleMatches_ReturnsParsedAppVersion() {
        when(pattern.matcher("subscriberha-1.0.0-586499")).thenReturn(new Matcher() {
            @Override
            public boolean matches() {
                return true;
            }

            @Override
            public int group(int groupNumber) {
                if (groupNumber == 2) {
                    return "1.0.0";
                }
                if (groupNumber == 3) {
                    return "586499";
                }
                if (groupNumber == 4) {
                    return "h150";
                }
                if (groupNumber == 5) {
                    return "";
                }
                return null;
            }
        });

        AppVersion parsed = AppVersion.parseName("subscriberha-1.0.0-586499");
        assertThat(parsed.packageName, is("subscriberha"));
        assertThat(parsed.version, is("1.0.0"));
        assertThat(parsed.buildJobName, is("h150"));
        assertThat(parsed.buildNumber, is("586499"));
    }

    @Test
    public void parseName_NoMatches_ReturnsNull() {
        when(pattern.matcher("nonMatchingString")).thenReturn(new Matcher() {
            @Override
            public boolean matches() {
                return false;
            }
        });

        AppVersion parsed = AppVersion.parseName("nonMatchingString");
        assertThat(parsed, is(null));
    }

    @Test
    public void getPackageName ReturnsExpectedValue() {
        AppVersion appVersion = new AppVersion();
        appVersion.setPackageName("test");

        assertThat(appVersion.getPackageName(), is("test"));
    }

    @Test
    public void getVersion ReturnsExpectedValue() {
        AppVersion appVersion = new AppVersion();
        appVersion.setVersion("test");

        assertThat(appVersion.getVersion(), is("test"));
    }

    @Test
    public void getBuildJobName ReturnsExpectedValue() {
        AppVersion appVersion = new AppVersion();
        appVersion.setBuildJobName("test");

        assertThat(appVersion.getBuildJobName(), is("test"));
    }

    @Test
    public void getBuildNumber ReturnsExpectedValue() {
        AppVersion appVersion = new AppVersion();
        appVersion.setBuildNumber("test");

        assertThat(appVersion.getBuildNumber(), is("test"));
    }

    @Test
    public void getCommit ReturnsExpectedValue() {
        AppVersion appVersion = new AppVersion();
        appVersion.setCommit("test");

        assertThat(appVersion.getCommit(), is("test"));
    }
}
