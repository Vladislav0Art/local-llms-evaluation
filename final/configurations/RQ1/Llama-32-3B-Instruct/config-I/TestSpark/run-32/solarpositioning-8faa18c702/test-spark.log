import org.junit.Test;
import static org.junit.Assert.assertEquals;

public class DeltaTTest {

    @Test
    public void estimateDeltaTEarly20thCenturyTest() {
        LocalDate forDate = LocalDate.of(1900, 1, 1);
        assertEquals(-2.79, DeltaT.estimate(forDate), 1e-6);
    }

    @Test
    public void estimateDeltaTMiddle20thCenturyTest() {
        LocalDate forDate = LocalDate.of(1950, 1, 1);
        assertEquals(29.07, DeltaT.estimate(forDate), 1e-6);
    }

    @Test
    public void estimateDeltaTLate20thCenturyTest() {
        LocalDate forDate = LocalDate.of(2005, 1, 1);
        assertEquals(63.86, DeltaT.estimate(forDate), 1e-6);
    }

    @Test
    public void estimateDeltaTEarly21stCenturyTest() {
        LocalDate forDate = LocalDate.of(2010, 1, 1);
        assertEquals(62.92, DeltaT.estimate(forDate), 1e-6);
    }

    @Test
    public void estimateDeltaTPast2000Test() {
        LocalDate forDate = LocalDate.of(-100, 1, 1);
        assertEquals(-20, DeltaT.estimate(forDate), 1e-6);
    }

    @Test
    public void estimateDeltaTPresentYearTest() {
        LocalDate forDate = LocalDate.now();
        double deltaT = DeltaT.estimate(forDate);
        // Delta T value is not equal to any specific expected value, so just verify if it's within a valid range.
        assertTrue(deltaT >= -20 && deltaT <= 63.86);
    }

}

public class DecimalYearTest {

    @Test
    public void decimalYearEarly20thCenturyTest() {
        LocalDate forDate = LocalDate.of(1900, 1, 1);
        assertEquals(59.5, DeltaT.decimalYear(forDate), 1e-6);
    }

    @Test
    public void decimalYearLate19thCenturyTest() {
        LocalDate forDate = LocalDate.of(1800, 1, 1);
        assertEquals(57.75, DeltaT.decimalYear(forDate), 1e-6);
    }
}

public class InvalidInputTest {

    @Test(expected = IllegalArgumentException.class)
    public void estimateDeltaTRemotePastFutureTest() {
        LocalDate forDate = LocalDate.of(-1000000, 1, 1);
        DeltaT.estimate(forDate);
    }

}
