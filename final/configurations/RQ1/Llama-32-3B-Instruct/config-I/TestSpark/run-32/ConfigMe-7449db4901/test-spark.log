```java
import org.junit.Test;
import static org.junit.Assert.*;

public class CommentsConfigurationTest {

    @Test
    public void testSetSingleComment() {
        // Create CommentsConfiguration
        CommentsConfiguration configuration = new CommentsConfiguration();

        // Set single comment
        configuration.setSingleComment("path1", "comment1");

        // Verify single comment is set correctly
        List<String> expectedComments = Arrays.asList("comment1");
        assertEquals(expectedComments, configuration.getComments("path1"));
    }

    @Test
    public void testSetMultipleComments() {
        // Create CommentsConfiguration
        CommentsConfiguration configuration = new CommentsConfiguration();

        // Set multiple comments
        Map<String, String> commentsMap = new HashMap<>();
        commentsMap.put("newPath", "comment1");
        commentsMap.put("anotherPath", "comment2");
        configuration.comments.putAll(commentsMap);

        // Verify multiple comments are set correctly
        assertEquals(Arrays.asList("comment1", "comment2"), configuration.getComments("newPath"));
    }

    @Test
    public void testGetNonExistentComment() {
        // Create CommentsConfiguration
        CommentsConfiguration configuration = new CommentsConfiguration();

        // Test non-existent path
        assertEquals(null, configuration.getComments("nonExistentPath"));
    }
}

public class CommentsConfiguration {

    private Map<String, String> comments;

    public void setSingleComment(String path, String comment) {
        if (!comments.containsKey(path)) {
            comments.put(path, comment);
        } else {
            throw new RuntimeException("Path already exists");
        }
    }

    public List<String> getComments(String path) {
        return new ArrayList<>(comments.getOrDefault(path, Collections.emptyList()));
    }
}
```

