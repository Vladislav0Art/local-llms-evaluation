import org.junit.Test;
import static org.junit.Assert.assertEquals;
import java.time.ZoneOffset;
import java.time.ZonedDateTime;

public class Grena3Test {

    @Test
    public void calculateSolarPosition_WithinLimits_Dates() {
        ZonedDateTime date = ZonedDateTime.of(2022, 6, 1, 12, 0, 0, 0, ZoneOffset.UTC);
        assertEquals(AzimuthZenithAngle.values()[0], Grena3.calculateSolarPosition(date, 0.0, 0.0, 0.0).value());
    }

    @Test
    public void calculateSolarPosition_BelowLimits_Dates() {
        ZonedDateTime date = ZonedDateTime.of(2022, 5, 31, 12, 0, 0, 0, ZoneOffset.UTC);
        assertEquals(AzimuthZenithAngle.values()[1], Grena3.calculateSolarPosition(date, 0.0, 0.0, 0.0).value());
    }

    @Test
    public void calculateSolarPosition_Limits_Pressure() {
        ZonedDateTime date = ZonedDateTime.of(2022, 6, 1, 12, 0, 0, 0, ZoneOffset.UTC);
        assertEquals(AzimuthZenithAngle.values()[0], Grena3.calculateSolarPosition(date, 3000.0, 273).value());
    }

    @Test
    public void calculateSolarPosition_Limits_Temperature() {
        ZonedDateTime date = ZonedDateTime.of(2022, 6, 1, 12, 0, 0, 0, ZoneOffset.UTC);
        assertEquals(AzimuthZenithAngle.values()[0], Grena3.calculateSolarPosition(date, 0.0, -273).value());
    }

    @Test
    public void calculateSolarPosition_Limits_TemperatureAndPressure() {
        ZonedDateTime date = ZonedDateTime.of(2022, 6, 1, 12, 0, 0, 0, ZoneOffset.UTC);
        assertEquals(AzimuthZenithAngle.values()[0], Grena3.calculateSolarPosition(date, 3000.0, -273).value());
    }
}

class AzimuthZenithAngle {
    public static final int value1 = 0;
    public static final int value2 = 180;
}
