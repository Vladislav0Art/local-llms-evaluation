    public void test_stripLeadingWhitespace_LeavesOriginalCharacters() {
        StringBuilder sb = new StringBuilder("Hello World!");
        assertTrue(sb.toString().equals(sb));
    }

    public boolean lastCharIsWhitespace(StringBuilder sb) {
        if (sb.length() < 1) {
            return false;
        }
        char lastChar = sb.charAt(sb.length()-1);
        return Character.isWhitespace(lastChar);
    }
