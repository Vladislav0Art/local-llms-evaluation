public class TextNodeTest {

    @Test
    public void givenExistingTextNodeWhenCreatingNewTextNode_returnsTrue() {
        String existingText = "Existing Text";
        TextNode existingTextNode = new TextNode(existingText);
        boolean result = new TextNode(existingTextNode.text()).isBlank();
        assertTrue(result);
    }

    @Test
    public void givenNonBlankTextNodeWhenGettingWholeText_returnsCorrectString() {
        String expectedText = "Hello World!";
        String nonBlankTextNode = new TextNode(expectedText);
        assertEquals(expectedText, nonBlankTextNode.getWholeText());
    }

    @Test
    public void givenBlankTextNodeWhenGettingWholeText_returnsEmptyString() {
        String blankTextNode = new TextNode("");
        assertEquals("", blankTextNode.getWholeText());
    }

    @Test
    public void givenExistingTextNodeWhenCreatingNewTextNodeFromEncodedReturnsCorrectString() {
        String encodedText = "&lt;Example&gt;";
        String expectedText = "Example";
        TextNode resultTextNode = TextNode.createFromEncoded(encodedText);
        assertEquals(expectedText, resultTextNode.text());
    }

    @Test
    public void givenExistingTextNodeWhenSplittingAtOffset_returnsCorrectNodes() throws IOException {
        String originalText = "Original Text";
        int offset = 5;
        String textToKeep = "First";
        String expectedTailText = "Second";

        TextNode originalTextNode = new TextNode(originalText);
        TextNode tailTextNode = originalTextNode.splitText(offset);

        assertEquals(textToKeep, originalTextNode.text());
        assertEquals(expectedTailText, tailTextNode.getWholeText());
    }

    @Test
    public void givenBlankTextNodeWhenTrimmingLeadingAndTrailingWhitespaceDoesNotAlterString() {
        String expectedText = "   ";
        TextNode blankTextNode = new TextNode(expectedText);
        boolean result = lastCharIsWhitespace(blankTextNode.text());
        assertTrue(result);
    }
}

