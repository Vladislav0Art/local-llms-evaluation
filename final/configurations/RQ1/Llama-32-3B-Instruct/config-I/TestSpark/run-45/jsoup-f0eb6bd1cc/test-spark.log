public class Connection {
    public static class KeyVal {
        private String key;
        private String val;

        public KeyVal(String key, String val) {
            this.key = key;
            this.val = val;
        }

        @Override
        public String toString() {
            return String.format("%s=%s", key, val);
        }
    }

    public static class UrlBuilder {
        private StringBuilder q;
        private URL url;

        public UrlBuilder(URL url) {
            this.url = url;
            this.q = new StringBuilder();
        }

        public void appendKeyVal(KeyVal kv) {
            if (q.length() > 0) {
                q.append("&");
            }
            q.append(kv.key).append("=").append(UrlBuilder.decodePart(kv.val));
        }

        public static String decodePart(String part) throws UnsupportedEncodingException {
            return java.net.URLEncoder.encode(part);
        }

        public URL build() throws URISyntaxException, UnsupportedEncodingException {
            if (q.length() > 0 && !q.toString().startsWith("?")) {
                q.insert(0, "?");
            }
            return new URL(url.getProtocol(), url.getHost(), url.getPort(), q.toString(), null);
        }
    }

}

