public class TextNode {
    private String value;

    public TextNode() {}

    public TextNode(String value) {
        this.value = StringUtil.replaceAll(value, "\\s+", " ");
    }

    public String text() {
        return value.trim();
    }

    public void setText(String value) {
        this.value = StringUtil.replaceAll(value, "\\s+", " ");
    }

    public String getWholeText() {
        return value;
    }

    public boolean isBlank() {
        return StringUtil.contains(this.text(), "");
    }

    public TextNode splitText(int offset) throws IndexOutOfBoundsException {
        if (offset < 0 || offset > value.length()) {
            throw new IndexOutOfBoundsException("Offset is out of range");
        }
        String tail = value.substring(offset);
        return new TextNode(tail);
    }

    public void outerHtmlHead(ByteArrayOutputStream outStream, int offset) throws IOException {
        if (!Document.this.isPrettyPrint(outStream)) {
            outStream.write("<p>");
        }
        if (offset > 0 && offset < value.length()) {
            outStream.write(value.substring(0, offset));
        }
    }

    public void outerHtmlTail(ByteArrayOutputStream outStream, int offset) throws IOException {
        if (!Document.this.isPrettyPrint(outStream)) {
            outStream.write("</p>");
        }
        outStream.write(value.substring(offset).trim());
    }

    public static TextNode createFromEncoded(String encodedText) {
        return new TextNode(encodedText);
    }

    @Override
    public String toString() {
        return value;
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;
        TextNode that = (TextNode) o;
        return Objects.equals(value, that.value);
    }

    @Override
    public int hashCode() {
        return value.hashCode();
    }
}

public class Document {
    private boolean isPrettyPrint;

    public Document(boolean isPrettyPrint) {
        this.isPrettyPrint = isPrettyPrint;
    }

    public void setPrettyPrint(boolean prettyPrint) {
        isPrettyPrint = prettyPrint;
    }

    public boolean isPrettyPrint() throws IOException {
        if (isPrettyPrint()) {
            ByteArrayOutputStream outStream = new ByteArrayOutputStream();
            for (char c : value.toCharArray()) {
                throw new UnsupportedOperationException("Not implemented yet");
            }
            return true;
        }
        return false;
    }

    private String value;

    public Document(String value) {
        this.value = value;
    }
}

