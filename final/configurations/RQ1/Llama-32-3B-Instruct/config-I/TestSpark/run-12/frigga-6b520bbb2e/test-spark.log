public class AppVersionTest {

    @Test
    public void parseNameNullReturnsNull() {
        Assert.assertNull(AppVersion.parseName(null));
    }

    @Test
    public void parseNameEmptyStringReturnsNull() {
        Assert.assertNull(AppVersion.parseName(""));
    }

    @Test
    public void parseNameInvalidPatternReturnsNull() {
        Assert.assertNull(AppVersion.parseName("invalid-pattern"));
    }

    @Test
    public void parseNameValidPatternReturnsNonNull() {
        AppVersion parsed = AppVersion.parseName("subscriberha-1.0.0-586499");
        Assert.assertNotNull(parsed);
        Assert.assertEquals("subscriberha", parsed.packageName);
        Assert.assertEquals("1.0.0-586499", parsed.version);
    }

    @Test
    public void parseNameWithBuildJobNameReturnsNonNull() {
        AppVersion parsed = AppVersion.parseName("subscriberha-1.0.0-586499.h150");
        Assert.assertNotNull(parsed);
        Assert.assertEquals("h150", parsed.buildJobName);
    }

    @Test
    public void parseNameWithCommitIdReturnsNonNull() {
        AppVersion parsed = AppVersion.parseName("subscriberha-1.0.0-586499.h150/WE-WAPP-subscriberha/150");
        Assert.assertNotNull(parsed);
        Assert.assertEquals("150", parsed.commit);
    }

    @Test
    public void compareToEqualsNull() {
        AppVersion a = new AppVersion();
        AppVersion b = new AppVersion();
        Assert.assertTrue(a.compareTo(b) == 0);
    }

    @Test
    public void compareToNotEqualReturnsNegativeValue() {
        AppVersion a = new AppVersion();
        AppVersion b = new AppVersion("other");
        Assert.assertTrue(a.compareTo(b) < 0);
    }

    @Test
    public void getPackageNameReturnsNull() {
        AppVersion appVersion = new AppVersion();
        Assert.assertNull(appVersion.getPackageName());
    }

    @Test
    public void getPackageNameNonNullReturnsValue() {
        AppVersion appVersion = new AppVersion("other");
        Assert.assertEquals("other", appVersion.getPackageName());
    }

    @Test
    public void getVersionReturnsNull() {
        AppVersion appVersion = new AppVersion();
        Assert.assertNull(appVersion.getVersion());
    }

    @Test
    public void getVersionNonNullReturnsValue() {
        AppVersion appVersion = new AppVersion("other");
        Assert.assertEquals("other", appVersion.getVersion());
    }

    @Test
    public void getBuildJobNameReturnsNull() {
        AppVersion appVersion = new AppVersion();
        Assert.assertNull(appVersion.getBuildJobName());
    }

    @Test
    public void getBuildJobNameNonNullReturnsValue() {
        AppVersion appVersion = new AppVersion("other");
        Assert.assertEquals("other", appVersion.getBuildJobName());
    }

    @Test
    public void getBuildNumberReturnsNull() {
        AppVersion appVersion = new AppVersion();
        Assert.assertNull(appVersion.getBuildNumber());
    }

    @Test
    public void getBuildNumberNonNullReturnsValue() {
        AppVersion appVersion = new AppVersion("other");
        Assert.assertEquals("other", appVersion.getBuildNumber());
    }

    @Test
    public void getCommitReturnsNull() {
        AppVersion appVersion = new AppVersion();
        Assert.assertNull(appVersion.getCommit());
    }

    @Test
    public void getChangelistReturnsDeprecatedValue() {
        AppVersion appVersion = new AppVersion("other");
        Assert.assertEquals("other", appVersion.getChangelist());
    }
