public class TextNodeTest {

    @Test
    public void createTextNode_GivenValidText_ShouldReturnNewTextNode() {
        // Given
        String text = "Hello World";

        // When
        TextNode textNode = new TextNode(text);

        // Then
        assertNotNull(textNode);
        assertEquals(text, textNode.text());
    }

    @Test
    public void nodeName_GivenValidTextNode_ShouldReturnNodeId() {
        // Given
        TextNode textNode = new TextNode("Hello World");

        // When
        String nodeId = textNode.nodeName();

        // Then
        assertEquals("#text", nodeId);
    }

    @Test
    public void splitText_GivenOffsetAndValidTextNode_ShouldSplitTextNodeCorrectly() throws IOException {
        // Given
        String text = "Hello World";
        TextNode textNode = new TextNode(text);

        // When
        TextNode resultTextNode = textNode.splitText(7);

        // Then
        assertEquals("Hello ", resultTextNode.text());
        assertEquals("World", textNode.splitText(0).text());
    }

    @Test
    public void isBlank_GivenValidTextNode_ShouldReturnFalse() {
        // Given
        TextNode textNode = new TextNode("Hello World");

        // When
        boolean result = textNode.isBlank();

        // Then
        assertFalse(result);
    }

    @Test
    public void isBlank_GivenOnlyWhitespaceAndValidTextNode_ShouldReturnTrue() {
        // Given
        TextNode textNode = new TextNode("");

        // When
        boolean result = textNode.isBlank();

        // Then
        assertTrue(result);
    }
}
