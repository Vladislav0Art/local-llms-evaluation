import org.junit.Test;
import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertTrue;
import static org.junit.Assert.assertFalse;

public class Grena3Test {

    @Test
    public void calculateSolarPosition_WithDefaultValues_ReturnsExpectedValue() {
        // Arrange
        ZonedDateTime date = ZonedDateTime.now();
        double latitude = 48.8567;
        double longitude = 2.3508;
        double deltaT = 0.00000;

        // Act
        AzimuthZenithAngle result = Grena3.calculateSolarPosition(date, latitude, longitude, deltaT);

        // Assert
        assertTrue(result.getAzimuth() > 0);
        assertTrue(result.getZenith() > 0);
    }

    @Test
    public void calculateSolarPosition_WithInvalidPressure_ReturnsExpectedValue() {
        // Arrange
        ZonedDateTime date = ZonedDateTime.now();
        double latitude = 48.8567;
        double longitude = 2.3508;
        double deltaT = 0.00000;
        double pressure = 50000;

        // Act
        AzimuthZenithAngle result = Grena3.calculateSolarPosition(date, latitude, longitude, deltaT, pressure);

        // Assert
        assertTrue(result.getAzimuth() > 0);
        assertTrue(result.getZenith() > 0);
    }

    @Test
    public void calculateSolarPosition_WithInvalidTemperature_ReturnsExpectedValue() {
        // Arrange
        ZonedDateTime date = ZonedDateTime.now();
        double latitude = 48.8567;
        double longitude = 2.3508;
        double deltaT = 0.00000;
        double temperature = -270;

        // Act
        AzimuthZenithAngle result = Grena3.calculateSolarPosition(date, latitude, longitude, deltaT, temperature);

        // Assert
        assertTrue(result.getAzimuth() > 0);
        assertTrue(result.getZenith() > 0);
    }

    @Test
    public void calculateSolarPosition_WithDifferentValues_ReturnsExpectedValue() {
        // Arrange
        ZonedDateTime date = ZonedDateTime.now();
        double latitude = 48.8567;
        double longitude = 2.3508;
        double deltaT = 0.00002;

        // Act
        AzimuthZenithAngle result = Grena3.calculateSolarPosition(date, latitude, longitude, deltaT);

        // Assert
        assertTrue(result.getAzimuth() > 0);
        assertTrue(result.getZenith() > 0);
    }

    @Test
    public void calcT_WithDefaultValues_ReturnsExpectedValue() {
        // Arrange
        ZonedDateTime date = ZonedDateTime.now();

        // Act
        double result = Grena3.calcT(date);

        // Assert
        assertTrue(result >= -10000 && result <= 5000);
    }

}
