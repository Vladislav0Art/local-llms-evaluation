public class GeneratedTest {

    @org.junit.Test
    public void testDefaultSettings() {
        XmlTreeBuilder builder = new XmlTreeBuilder();
        ParseSettings settings = builder.defaultSettings();

        assert settings.equals(ParseSettings.preserveCase);
    }

    @org.junit.Test
    public void testParseReader() {
        String input = "<html><body>Hello World!</body></html>";
        Reader reader = new Reader(input);

        Parser<XmlTreeBuilder> parser = new Parser<>(new XmlTreeBuilder());
        parser.builder.initialiseParse(reader, "http://example.com", parser);

        Document actualDoc = parser.builder.parse(reader.toString(), "http://example.com").getDocument();

        assert actualDoc.getDocument().equals(builder.parse(input, "http://example.com"));
    }

    @org.junit.Test
    public void testTokenType() {
        Token token = new Token();
        assert token.Type.StartTag == 1;
    }
}
