    public void splitText_GivenOffset_GivenText_ReturnsTextNode() throws IOException {
        String text = "Hello World";
        Node textNode = new Node(text);
        int offset = 5;
        Node result = textNode.splitText(offset);
        assertNotNull(result);
    }

