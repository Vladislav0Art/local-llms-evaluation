        assertNotNull(result);
        assertEquals("hello", result);
    }

    @Test
    public void textShouldNormalizeWhitespace() {
        TextNode node = new TextNode("   hello  ");
        String result = node.text();
        assertNotNull(result);
        assertEquals(StringUtil.normaliseWhitespace("   hello  "), result);
    }

    @Test
    public void textShouldReturnEmptyStringWhenBlank() {
        TextNode node = new TextNode("");
        String result = node.text();
        assertNotNull(result);
        assertTrue(result.isEmpty());
    }

    @Test
    public void splitTextGivenOffsetGreaterThanZero_ReturnsTextNodeWithCorrectText() throws IOException {
        TextNode node = new TextNode("hello world");
        int offset = 6;
        TextNode result = node.splitText(offset);
        assertNotNull(result);
        assertEquals("world", result.value());
    }

    @Test
    public void splitTextGivenOffsetGreaterOrEqualTextNodeLength_ReturnsTextNodeWithCorrectText() throws IOException {
        TextNode node = new TextNode("hello world");
        int offset = 11;
        TextNode result = node.splitText(offset);
        assertNotNull(result);
        assertEquals("", result.value());
    }

    @Test
    public void isBlankShouldReturnTrueWhenTextNodeIsBlank() {
        TextNode node = new TextNode("");
        assertTrue(node.isBlank());
    }

    @Test
    public void isBlankShouldReturnFalseWhenTextNodeContainsText() {
        TextNode node = new TextNode("hello");
        assertFalse(node.isBlank());
    }
}
