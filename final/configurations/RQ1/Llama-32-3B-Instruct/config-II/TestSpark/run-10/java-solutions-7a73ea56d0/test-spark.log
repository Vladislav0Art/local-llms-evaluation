package leetcode.medium;

import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.Mockito;
import org.mockito.junit.MockitoJUnitRunner;

import java.util.ArrayList;
import java.util.List;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertThrows;
import static org.mockito.ArgumentMatchers.anyInt;
import static org.mockito ArgumentMatchers.anyLong;

@RunWith(MockitoJUnitRunner.class)
public class OnlineStockSpanTest {

    @Mock
    private List<Integer> list;

    public OnlineStockSpan testObject;

    public OnlineStockSpan() {
        this.list = new ArrayList<>();
        this.testObject = new OnlineStockSpan();
    }

    [MethodUnderTest0Test]
    public void next_price_isGreater_or_Equal_to_all_previous_prices_should_Return_1() {
        int price = 10;
        Mockito.when(list.size()).thenReturn(3);
        Mockito.when(list.get(2)).thenReturn(price);

        testObject.next(price);

        assertEquals(1, testObject.list.get(testObject.list.size()-1));
    }

    [MethodUnderTest0Test]
    public void next_price_isLess_than_all_previous_prices_should_Return_0() {
        int price = 5;
        Mockito.when(list.size()).thenReturn(3);
        Mockito.when(list.get(2)).thenReturn(price);

        testObject.next(price);

        assertEquals(0, testObject.list.get(testObject.list.size()-1));
    }

    [MethodUnderTest1Test]
    public void calculateSpans_empty_pricesArray_should_Return_Empty_Array() {
        int[] prices = {};
        int[] expected = {};

        int[] actual = testObject.calculateSpans(prices);

        assertArrayEquals(expected, actual);
    }

    [MethodUnderTest1Test]
    public void calculateSpans_singlePriceArray_should_Return_PriceAsSpan() {
        int[] prices = {10};
        int[] expected = {1};

        int[] actual = testObject.calculateSpans(prices);

        assertArrayEquals(expected, actual);
    }

    [MethodUnderTest1Test]
    public void calculateSpans_multiplePricesArray_should_Return_CorrectSpans() {
        int[] prices = {3, 2, 6, 5, 4, 8};

        int[] expected = {2, 1, 2, 0, 2, 2};
        int[] actual = testObject.calculateSpans(prices);

        assertArrayEquals(expected, actual);
    }

    [MethodUnderTest1Test]
    public void calculateSpans_multiplePricesArray_withStack_empty_should_Return_ArrayWithCorrectLength() {
        int[] prices = {3, 2, 6, 5, 4, 8};

        int[] expected = new int[prices.length];
        for (int i = 0; i < prices.length; i++) {
            expected[i] = i+1;
        }
        int[] actual = testObject.calculateSpans(prices);

        assertArrayEquals(expected, actual);
    }

}
