    public void testEmptyStringTextNode() {
        TextNode textNode = new TextNode("");
        assertEquals("", textNode.text(""));
    }

    @Test
    public void testIsBlankTrueIfEmpty() {
        TextNode textNode = new TextNode(" ");
        assertTrue(textNode.isBlank());
    }

    @Test
    public void testIsBlankFalseIfNotEmpty() {
        TextNode textNode = new TextNode("Hello");
        assertFalse(textNode.isBlank());
    }

    @Test
    public void testSplitTextTrueIfOffsetValid() {
        TextNode textNode = new TextNode("   Hello ");
        TextNode result = textNode.splitText(5);
        assertEquals("Hello ", result.text());
    }

    @Test
    public void testSplitTextFalseIfOffsetInvalid() {
        TextNode textNode = new TextNode("   Hello world");
        TextNode result = textNode.splitText(-1); // -1 is 0-based index
        assertNull(result);
    }

    @Test
    public void testOuterHtmlHeadBlankTextNode() {
        TextNode textNode = new TextNode("");
