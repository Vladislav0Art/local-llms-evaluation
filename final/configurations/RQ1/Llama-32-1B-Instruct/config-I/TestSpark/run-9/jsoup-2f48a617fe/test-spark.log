    private String outerHtmlHead() {
        Document document = parse("<!-- This is a new XML declaration -->");
        Element elem = document.createElement("html");
        elem.appendChild(document.createElement("head"));
        elem.appendChild(document.createElement("body"));
        return elem.outerHTML;
    }

    @Override
    public String toString() {
        return outerHtmlHead() + "\n" + this.data;
    }
}

