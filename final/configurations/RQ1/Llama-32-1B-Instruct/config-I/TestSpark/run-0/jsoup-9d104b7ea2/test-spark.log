public class NodeUtils {

    /**
     * Test if the given text node is blank.
     *
     * @param node The text node to check.
     * @return true if the node is empty or only whitespace, false otherwise.
     */
    public static boolean isBlank(Node node) {
        String textContent = node.getTextContent();
        return textContent == null || textContent.trim().isEmpty();
    }

    /**
     * Test if a document has any blank nodes.
     *
     * @param document The document to check.
     * @return true if the document has at least one blank node, false otherwise.
     */
    public static boolean hasBlankNodes(Document document) {
        NodeList children = document.getChildNodes();
        for (int i = 0; i < children.getLength(); i++) {
            Node child = (Node) children.item(i);
            if (isBlank(child)) return true;
            if (child instanceof TextNode) hasBlankNodes((TextNode) child.document);
        }
        return false;
    }

