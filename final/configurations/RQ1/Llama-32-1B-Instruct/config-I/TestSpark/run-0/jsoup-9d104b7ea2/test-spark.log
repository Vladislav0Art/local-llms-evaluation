public class TextNodeUtils {

    /**
     * Test if this text node is blank -- that is, empty or only whitespace (including newlines).
     *
     * @param document Document
     * @return true if this document is empty or only whitespace, false if it contains any text content.
     */
    public static boolean isBlank(Document document) {
        return document != null && !document.getText().isEmpty();
    }

    /**
     * Test if the given node is a blank node -- that is, an element with no children and no parent.
     *
     * @param document Document
     * @return true if the given node is a blank node, false otherwise.
     */
    public static boolean isBlank(Node document) {
        return document == null || document.getChildren().isEmpty() && !document.getParent() instanceof Node;
    }

    /**
     * Test if this text node has more than one sibling.
     *
     * @param document Document
     * @return true if the given node has at least two siblings, false otherwise.
     */
    public static boolean hasMoreSiblings(Document document) {
        return document != null && !document.getChildren().isEmpty() && (document.getChildren().size() > 1 || document.getParent() instanceof Node);
    }
}

public class TextNodeTest {

    private Node document;
    private DocumentOutputSettings output;

    @Before
    public void setUp() throws IOException, ValidateException {
        document = createNode();
        output = new DocumentOutputSettings();
    }

    /**
     * Test if a text node is blank.
     */
    public void testIsBlank() {
        assertEquals(true, TextNodeUtils.isBlank(document));
        assertEquals(false, TextNodeUtils.isBlank(null));
    }

    /**
     * Test if a text node has more than one sibling.
     */
    public void testHasMoreSiblings() {
        assertEquals(true, TextNodeUtils.hasMoreSiblings(document));
        assertEquals(false, TextNodeUtils.hasMoreSiblings(null));
    }

    /**
     * Test that a newly created text node is not blank (i.e. it has children).
     */
    public void testNotBlank() {
        Node sibling = createSibling();
        assertTrue(TextNodeUtils.isBlank(document));
        assertTrue(document.getChildren().contains(sibling));
    }

    /**
     * Test that the outerHtml method of a text node indents its siblings correctly.
     */
    public void testOuterHtmlIndentation() throws IOException, ValidateException {
        document.setText("a\nb\n");
        Node sibling = createSibling();
        document.addChildren(1, sibling);
        String result = TextNodeUtils.outerHtml(document, output);
        assertEquals("<a>\\n<b>\\n", result);
    }

    /**
     * Test that the outerHtml method of a text node correctly handles block-level elements.
     */
    public void testOuterHtmlIndentationBlockLevel() throws IOException, ValidateException {
        document.setText("a\nb\n<br>");
        Node sibling = createSibling();
        document.addChildren(1, sibling);
        String result = TextNodeUtils.outerHtml(document, output);
        assertEquals("<a><br>\\n", result);
    }

    /**
     * Test that the outerHtml method of a text node correctly handles inline elements.
     */
    public void testOuterHtmlIndentationInline() throws IOException, ValidateException {
        document.setText("a\nb<br>");
        Node sibling = createSibling();
        document.addChildren(1, sibling);
        String result = TextNodeUtils.outerHtml(document, output);
        assertEquals("<a><br>\\n", result);
    }

    private Node createNode() throws IOException, ValidateException {
        return document.createText("Hello World!", "text/plain");
    }

    private Node createSibling() throws IOException, ValidateException {
        String text = " Foo Bar ";
        return document.createSpan(text, null);
    }
}
