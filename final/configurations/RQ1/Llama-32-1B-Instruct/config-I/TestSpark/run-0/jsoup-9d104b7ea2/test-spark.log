    public static void testOuterHtmlIndentationSpan() throws IOException, ValidateException {
        document.setText("a\nb<br>");
        Node sibling = createSibling();
        document.addChildren(1, sibling);
        String result = TextNodeUtils.outerHtml(document, output);
        assertEquals("<a><br>\\n", result);
    }

    private static void checkBlankNodes(Node node) {
        if (node instanceof TextNode) {
            TextNode textNode = (TextNode) node;
            assertTrue(isBlank(textNode.document));
            assertTrue(!textNode.getTextContent().isEmpty());
        } else if (node instanceof TextRange) {
            TextRange textRange = (TextRange) node;
            for (int i = 0; i < textRange.getLength(); i++) {
                Node child = textRange.item(i);
                checkBlankNodes(child);
            }
        } else if (node instanceof Element && ((Element) node).getTagName().equals("span")) {
            Element spanElement = (Element) node;
            for (int i = 0; i < spanElement.getChildNodes()..getLength(); i++) {
                Node child = (Node) spanElement.getChildNodes().item(i);
                checkBlankNodes(child);
            }
        } else if (node instanceof Element && ((Element) node).getTagName().equals("br")) {
            Element brElement = (Element) node;
            for (int i = 0; i < brElement.getChildNodes()..getLength(); i++) {
                Node child = (Node) brElement.getChildNodes().item(i);
                checkBlankNodes(child);
            }
        } else if (node instanceof Element && ((Element) node).getTagName().equals("a")) {
            Element aElement = (Element) node;
            for (int i = 0; i < aElement.getChildNodes()..getLength(); i++) {
                Node child = (Node) aElement.getChildNodes().item(i);
                checkBlankNodes(child);
            }
        } else if (node instanceof Element && ((Element) node).getTagName().equals("body")) {
            // Skip body elements
        } else if (node instanceof TextRange) {
            TextRange textRange = (TextRange) node;
            for (int i = 0; i < textRange.getLength(); i++) {
                Node child = textRange.item(i);
                checkBlankNodes(child);
            }
        } else {
            throw new RuntimeException("Unsupported node type: " + node.getNodeType());
        }
