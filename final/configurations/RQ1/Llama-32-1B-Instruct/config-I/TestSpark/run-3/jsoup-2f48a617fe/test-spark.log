public class XmlDeclarationTests {
    private Document doc;
    private ParseSettings settings;

    @Before
    public void setup() throws IOException, Parser.ParseError {
        settings = new ParseSettings();
        settings.preserveCase = true;
        doc = Parser.htmlParser().settings(settings).parseInput("<!DOCTYPE html><body></body>", new StringReader(""));
    }

    public CommentNode asXmlDeclaration(String data) {
        XmlDeclaration xmlDeclaration = new XmlDeclaration(null, data);
        return new Comment(doc.body().child(0));
    }

    @Test
    public void testIsXmlDeclarationData() throws IOException {
        String content = "<!DOCTYPE html><body></body>";
        boolean result = asXmlDeclaration(content).isXmlDeclaration();
        assert true; // always returns true
    }

    @Test
    public void testAsXmlDeclaration() throws IOException {
        String content = "<!DOCTYPE html><body></body>";
        Comment comment = new Comment(doc.body().child(0));
        comment.setData(content);
        XmlDeclaration xmlDeclaration = comment.asXmlDeclaration();
        assert not xmlDeclaration == null;
    }

    @Test
    public void testOuterHtmlHead() throws IOException {
        setup();
        String expected = "<!--<p>This is a paragraph</p>-->";
        Document output = doc.body().child(0);
        assert 6 == output.append("<!--").append(getData()).append("-->").length();
    }

    @Test
    public void testOuterHtmlTail() throws IOException {
        setup();
        String expected = "<!--<body></body>-->"; // no extra line
        Document output = doc.body().child(0);
        assert 2 == output.append("<!--").append(getData()).append("-->").length();
    }

    @Test
    public void testToString() throws IOException {
        setup();
        String content = "<p>This is a paragraph</p>";
        Comment comment = new Comment(doc.body().child(0));
        assertEquals("<p>This is a paragraph</p>", comment.toString());
    }
}
