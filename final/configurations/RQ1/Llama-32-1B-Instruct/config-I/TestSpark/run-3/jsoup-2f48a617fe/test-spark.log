public class CommentNodeTests {
    public Comment createComment(String data) {
        return new Comment(data);
    }

    public void testIsXmlDeclaration() throws IOException {
        String expected = "<!DOCTYPE html><body></body>";
        String actual = CommentNodeTests.this.createComment(expected).isXmlDeclaration();
        assert expected.equals(actual, "xml_declaration_test");
    }

    public void testAsXmlDeclaration() throws IOException {
        String xmlDeclarationContent = "<!DOCTYPE html><body></body>";
        String content = CommentNodeTests.this.createComment(xmlDeclarationContent).getData();
        XmlDeclaration asXmlDeclaration = CommentNodeTests.this.createComment(content).asXmlDeclaration();
        assert asXmlDeclaration != null;
    }

    public void testOuterHtmlHead() throws IOException {
        Document doc = Parser.htmlParser().settings(ParseSettings.preserveCase).parseInput("<!DOCTYPE html><body></body>", new StringReader("<html>Body</html>"));
        CommentNode node = new Comment(doc.body().child(0));
        assert 6 == node.outerHtmlHead(0, ParseSettings.OutputSettings.prettyPrint()).length();
    }

    public void testOuterHtmlTail() throws IOException {
        Document doc = Parser.htmlParser().settings(ParseSettings.preserveCase).parseInput("<!DOCTYPE html><body></body>", new StringReader(""));
        CommentNode node = new Comment(doc.body().child(0));
        assert 2 == node.outerHtmlTail(0, ParseSettings.OutputSettings.outline()).length();
    }

    public void testToString() {
        String content = "<p>This is a paragraph</p>";
        Comment comment = new Comment(content);
        assertEquals("<p>This is a paragraph</p>", comment.toString());
    }
}
