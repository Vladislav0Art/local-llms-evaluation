package org.jsoup.nodes;

import org.jsoup.helper.Validate;
import org.jsoup.internal.StringUtil;
import java.io.IOException;
import java.util.List;

public class TextNodeTest {

    @Test
    public void testIsBlank() {
        TextNode node = new TextNode("");
        assert node.isBlank() : "Expected isBlank to return true";
    }

    @Test
    public void testSplitText() {
        String text = "Hello World!";
        TextNode result = node.splitText(5);
        assert result.text().equals("Hello World!"); // Only two newlines are expected
    }

    @Test
    public void testOuterHtmlHead() throws IOException {
        Appendable accum = new StringBuilder();
        Document doc = new Document();
        Appender appender = new DocumentAppender(doc, accum, 0);
        node.outerHtmlHead(appender, 1, null); // Normalization is enabled
        System.out.println(accum.toString()); // Expected output: "<p>Hello World!</p>"
    }

    @Test
    public void testOuterHtmlTail() {
        Appendable accum = new StringBuilder();
        Document doc = new Document();
        Appender appender = new DocumentAppender(doc, accum, 0);
        node.outerHtmlHead(appender, 1, null); // Normalization is enabled
        System.out.println(accum.toString()); // Expected output: "<p>Hello World!</p>"
    }

    @Test
    public void testToString() {
        TextNode node = new TextNode("<p> Hello <b>World</b></p>");
        assert node.toString().equals("p <b>Hello</b> World");
    }
}
