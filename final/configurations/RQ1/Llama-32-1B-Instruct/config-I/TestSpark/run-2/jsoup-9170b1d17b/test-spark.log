    public static void main(String[] args) {
        System.out.println("Recursive Fibonacci with Memoization: ");
        int n = 10;
        for (int i = 0; i <= n; i++) {
            System.out.print(fibonacci(i, memo) + " ");
        }
    }

    private static Integer[] memo = new Integer[100];

    public static int fibonacci(int n, Integer[] memo) {
        if (n == 1 || n == 2)
            return n;
        else if (memo[n] != null)
            return memo[n];
        else
            memo[n] = fibonacci(n - 1, memo) + fibonacci(n - 2, memo);
        return memo[n];
    }
}

