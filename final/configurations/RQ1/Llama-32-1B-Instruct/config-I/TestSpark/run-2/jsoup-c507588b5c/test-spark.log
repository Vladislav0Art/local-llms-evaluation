            }
            sb.append("<").append(this.getText()).append(">");
            for (int i = 0; i < text.length(); i++) {
                if (i > 0 && (text.charAt(i) == '<' || text.charAt(i) == '>')) {
                    sb.append(" ").append(getChildNodes());
                } else {
                    sb.append(text.charAt(i));
                }
            }
            sb.append("</").append(this.getText()).append(">");
        }

        return sb.toString();
    }
}

public class TextNode extends Node {
    public static TextNode createTextNode(String text) {
        return new TextNode(text);
    }
}

class HtmlElement {
    // ...

    @Override
    protected List<Node> getChildNodes() {
        if (this == null || text.isEmpty()) return null;
        else {
            int index = this.getText().indexOf(' ');
            if (index == -1) {
                index = text.length();
            }

            String[] children = new String[text.substring(0, index).length()];
            for (int i = 0; i < text.substring(0, index).length(); i++) {
                if (text.charAt(i) != ' ') {
                    if (i > 0 && (text.charAt(i - 1) == '<' || text.charAt(i - 1) == '>')) {
                        children[i - 1] = "";
                    }
                    String child = TextNode.createTextNode(text.substring(i));
                    children[i - 1] += child;
                } else if (i > 0 && (text.charAt(i - 1) != '<' || text.charAt(i - 1) != '>')) {
                    children[i - 1] = "";
                }
            }

            return new ArrayList<>(Arrays.asList(this, createTextNode(children[0])));
        }
    }
}

