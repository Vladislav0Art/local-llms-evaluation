import java.util.*;

public class Main {

    public static String filterByText(Node node, Document doc) {
        NodeFilter filter = new TagFilter(node);
        if (!filter.accept(node)) return "";
        List<String> textList = new ArrayList<>();
        for (Node child : node.children()) {
            String text = child.text();
            textList.add(text);
        }
        Collections.sort(textList);
        for (int i = 0; i < textList.size(); i++) {
