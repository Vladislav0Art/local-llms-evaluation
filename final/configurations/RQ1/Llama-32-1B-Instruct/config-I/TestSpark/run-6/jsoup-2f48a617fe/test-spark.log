import java.util.HashMap;
import java.util.Map;

public class Xml {
    private Map<String, XmlElement> elements = new HashMap<>();

    public void addXmlElement(String name, XmlElement element) {
        elements.put(name, element);
    }

    public String toString() {
        StringBuilder result = new StringBuilder();
        for (Map.Entry<String, XmlElement> entry : elements.entrySet()) {
            result.append(entry.getKey()).append(": ").append(entry.getValue().toString());
        }
        return result.toString();
    }

    private static class Element {
        private String tag;
        private String content;

        public Element(String tag) {
            this.tag = tag;
            this.content = "";
        }

        public void appendContent(String str) {
            if (content.isEmpty()) {
                content = str;
            } else {
                content += " <" + tag + ">" + str + "</" + tag + ">";
            }
        }

        @Override
        public String toString() {
            return "<" + tag + ">" + content + "</" + tag + ">";
        }
    }

    public static void main(String[] args) {
        Xml xml = new Xml();

        Element rootElement = new Element("root");
        xml.addXmlElement("root", rootElement);
        rootElement.appendContent("<tag>");

        Element childElement = new Element("child");
        xml.addXmlElement("child", childElement);
        childElement.appendContent("<content>Text</content>");

        System.out.println(xml.toString());
    }
}
