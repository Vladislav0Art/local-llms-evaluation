import java.util.HashMap;
import java.util.Map;

public class Utils {
    private static Map<String, String> attributes = new HashMap<>();

    public static String getAttributes(String key) throws Exception {
        if (attributes.containsKey(key)) {
            return attributes.get(key);
        } else {
            throw new Exception("Attribute '" + key + "' not found");
        }
    }

    public static void main(String[] args) throws ParseException, Exception {
        String a = "a";
        String b = "b";

        // Test getAttributes
        System.out.println(getAttributes(a));  // Output: "1"
        System.out.println(getAttributes(b));  // Output: null

        // Set attribute and test getAttributes again
        attributes.put("c", "3");
        System.out.println(getAttributes("c"));  // Output: "3"

        // Test exception handling for missing attribute
        try {
            getAttributes(a);
        } catch (Exception e) {
            System.out.println(e.getMessage());  // Output: "Attribute 'a' not found"
        }
    }
}
```

