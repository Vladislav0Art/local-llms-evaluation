public class CommentTest {

    @Test
    public void testIsXmlDeclaration() {
        Comment comment = new Comment("!xml declaration");
        Assert.assertTrue(comment.isXmlDeclaration());
    }

    @Test
    public void testAsXmlDeclaration() {
        Comment comment = new Comment("!xml declaration content");
        XmlDeclaration expectedDecl = new XmlDeclaration("!xml declaration content", "");
        Comment parsedComment = (Comment) comment.asXmlDeclaration();
        Assert.assertEquals(expectedDecl, parsedComment);
    }

    @Test
    public void testClone() {
        Comment originalComment = new Comment("#original comment content");
        Comment clonedComment = originalComment.clone();
        Assert.assertNotNull(clonedComment);
        Assert.assertEquals(originalComment, clonedComment);
    }
}
