```java
import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.select.Elements;

public class JsoupTest {

    public static void main(String[] args) {
        Document doc = Jsoup.connect("http://example.com").get();

        // Get all applet tags
        Elements applets = doc.getElementsByTag("applet");

        for (Element applet : applets) {
            // Check if the applet tag has a src attribute
            if (applet.hasAttr("src")) {
                System.out.println(applet.attr("src"));
            }
        }

        // Get all child elements of the first applet tag
        Elements childElements = doc.childElements();

        for (Element element : childElements) {
            // Check if the element has an id attribute and its value is "applet"
            if (element.hasAttr("id") && element.attr("id").equals("applet")) {
                System.out.println(element.html());
            }
        }

        // Get all child elements of the first applet tag with an id of "applet"
        Elements appletChildElements = doc.getElementsByTag("applet", "applet");

        for (Element applet : appletChildElements) {
            System.out.println(applet.html());
        }
    }
}
```

This code will print the src attribute values, child element HTML, and child elements with an id of "applet" to the console.
