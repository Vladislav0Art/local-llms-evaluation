```java
public class Solution {
    public int[] movingStacks(int[][] piles, int k) {
        int n = piles.length;
        int[] ans = new int[n];

        for (int i = 0; i < n; i++) {
            while (piles[i].length > 1 && k > 0) {
                ans[i] += pileLength(piles[i]) * piles[i][k];
                pile(k, -piles[i][k]);
                k -= 1;
            }
        }

        return ans;
    }

    private int pile(int[] arr, int val) {
        while (arr.length > 0 && val == arr[arr.length - 1]) {
            arr.pop();
        }
        if (val != -1) {
            arr.push(val);
        } else {
            arr.clear();
        }
        return arr.length;
    }

    private int pileLength(int[] arr) {
        for (int i = 0; i < arr.length; i++) {
            if (arr[i] > 0) {
                return i + 1;
            }
        }
        return -1;
    }
}

