public class Solution {
    public int[] movingStacks(int[][] piles, int k) {
        int n = piles.length;
        int[] ans = new int[n];
        int[] arr = new int[n];

        // Initialize array to store final stacks
        for (int i = 0; i < n; i++) {
            arr[i] = piles[i].length;
        }

        int index = 0;

        while (k > 0) {
            while (index < n && piles[index].length > 1) {
                ans[index]++;
                pile(piles, -1);
                k -= 1;
            }
            for (int i = index; i < n; i++) {
                if (piles[i].length == 1) {
                    arr[i] = 0;
                } else {
                    arr[i] += piles[i].length * -1;
                }
            }

            int len = pileLength(arr);
            // Add the length to ans
            while (len > k) {
                ans[index]++;
                index++;
                if (index >= n) {
                    break;
                }
                len = pileLength(arr);
                // Update arr with correct value for index
                arr[index] += piles[index].length * -1;

                while (arr.length > 0 && arr[arr.length - 1] == -1) {
                    arr.pop();
                }
            }

            if (index < n) {
                k -= arr[index];
                arr[index] = 0;
            } else {
                break;
            }
        }

        return ans;
    }

    private int pile(int[] arr, int val) {
        while (arr.length > 0 && val == arr[arr.length - 1]) {
            arr.pop();
        }
        if (val != -1) {
            arr.push(val);
        } else {
            arr.clear();
        }
        return arr.length;
    }

    private int pileLength(int[] arr) {
        for (int i = 0; i < arr.length; i++) {
            if (arr[i] > 0) {
                return i + 1;
            }
        }
        return -1;
    }
}

