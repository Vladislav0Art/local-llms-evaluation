class onlineStockSpan {

    public List<Integer> calculateSpans(List<Double> prices) {
        int n = prices.size();
        List<Integer> list = new ArrayList<>();
        for (int i = 1; i < n; i++) {
            list.add(list.get(i - 1) + 1);
        }
        return list;
    }

