public class TextNodeTest {

    private static final Document document = new Document();

    @Mock
    private Appendable parent;

    @Mock
    private Document.OutputSettings out;

    public void testIsBlank() {
        TextNode textNode = new TextNode(" ");
        when(parent.toString()).thenReturn("");

        assertTrue(textNode.isBlank());
        verify(parent).toString();
    }

    public void testSplitText() {
        String text = "   \n  Hello World!";
        TextNode textNode = new TextNode(text);

        when(textNode.coreValue()).thenReturn(String.join("\n", new String[] {"Hello", "World"}));

        TextNode result = textNode.splitText(3);
        verify(out, times(1)).prettyPrint();
    }

    public void testOuterHtmlHead() {
        // No setup needed
        String text = "   \n  Hello World!";
        TextNode textNode = new TextNode(text);

        when(parent.toString()).thenReturn("");

        when(out.prettyPrint()).thenReturn(true);
        when(parent.formatAsBlock()).thenReturn(false);

        try {
            textNode.outerHtmlHead(document.createAppender(), 1, out);
        } catch (IOException e) {
            fail("Unexpected IOException: " + e.getMessage());
        }
    }

    public void testOuterHtmlTail() {
        // No setup needed
        String text = "   \n  Hello World!";
        TextNode textNode = new TextNode(text);

        when(parent.toString()).thenReturn("");

        when(out.prettyPrint()).thenReturn(true);
        when(parent.formatAsBlock()).thenReturn(false);

        try {
            textNode.outerHtmlTail(document.createAppender(), 1, out);
        } catch (IOException e) {
            fail("Unexpected IOException: " + e.getMessage());
        }
    }

    public void testClone() {
        // No setup needed
        TextNode textNode = new TextNode("   \n  Hello World!");
        TextNode cloned = textNode.clone();

        when(parent.toString()).thenReturn("");

        verify(out, times(1)).prettyPrint();
    }

    public void testCreateFromEncoded() {
        String encodedText = "&lt;Hello&gt;&lt;/Hello&gt;";
        TextNode textNode = TextNode.createFromEncoded(encodedText);

        when(parent.toString()).thenReturn("");

        assertEquals("Hello", textNode.text(encodedText));
        verify(out, times(1)).prettyPrint();
    }

    public void testNormaliseWhitespace() {
        String text = "   \n  Hello World!";
        TextNode textNode = new TextNode(text);

        when(parent.toString()).thenReturn("");

        String result = textNode.normaliseWhitespace(text);
        assertEquals("Hello World!", result);
        verify(parent, times(1)).toString();
    }

    public void testStripLeadingWhitespace() {
        StringBuilder sb = new StringBuilder("   \n  Hello World!");
        TextNode textNode = new TextNode(sb.toString());

        when(parent.toString()).thenReturn("");

        boolean result = textNode.stripLeadingWhitespace(new String[] {"Hello", "World"});
        assertTrue(result);
        verify(parent, times(1)).toString();
    }

    public void testLastCharIsWhitespace() {
        StringBuilder sb = new StringBuilder("   \n  Hello World!");
        TextNode textNode = new TextNode(sb.toString());

        when(parent.toString()).thenReturn("");

        boolean result = textNode.lastCharIsWhitespace(new String[] {" ", " "});
        assertTrue(result);
        verify(parent, times(1)).toString();
    }
}
