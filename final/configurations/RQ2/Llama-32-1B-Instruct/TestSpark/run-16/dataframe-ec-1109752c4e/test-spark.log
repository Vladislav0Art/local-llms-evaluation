public class Printer {
    public void printValue(String str, Value value) {
        System.out.println(str);
    }
}

class CollectingPrinter extends Printer {
    @Override
    public void collect(Values values) {
        for (Value value : values.values()) {
            this.printValue(value.toString(), value);
        }
    }
}

public class Main {

    public static List<String> printList(List<Values> values, int size) {
        CollectingPrinter printer = new CollectingPrinter();
        Values[] list = new Values[size];
        for (int i = 0; i < size; i++) {
            list[i] = new Values();
        }
        printer.collect(new Values(values));
        return list;
    }

    public static void main(String[] args) {
        List<Values> values = new ArrayList<>();
        values.add(1);
        values.add("apple");
        values.add(2.5);

        System.out.println(printList(values, 3).get(0).toString());
    }
}

class Value implements Serializable {
    private String str;
    private double num;

    public Value() {}

    public Value(String str) {
        this.str = str;
    }

    @Override
    public int hashCode() {
        return Objects.hash(str);
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj)
            return true;
        if (!(obj instanceof Value))
            return false;

        Value other = (Value) obj;

        if (!str.equals(other.str))
            return false;

        return num == other.num;
    }
}

class Values implements Serializable {
    private List<Values> values;

    public Values() {}

    public void add(Values value) {
        values.add(value);
    }

    @Override
    public int hashCode() {
        return Objects.hash(values);
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj)
            return true;
        if (!(obj instanceof Values))
            return false;

        Values other = (Values) obj;

        for (Value value : values) {
            if (!value.equals(other.getValue()))
                return false;
        }

        return true;
    }
