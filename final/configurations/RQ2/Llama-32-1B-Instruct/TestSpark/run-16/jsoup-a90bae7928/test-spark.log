        String inputString = "<root><a/> <b/></root>";
        XmlTreeBuilder builder = new XmlTreeBuilder();
        Token tokenToClose = new Token(Token.EndTag.end(), null, null, true);
        builder.popStackToClose(tokenToClose);
        assert inputString.contains(tokenToClose.toString());
    }

