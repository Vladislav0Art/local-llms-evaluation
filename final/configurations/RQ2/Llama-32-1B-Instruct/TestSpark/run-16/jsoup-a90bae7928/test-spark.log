        String inputString = "<root><a/> <b/></root>";
        XmlTreeBuilder builder = new XmlTreeBuilder();
        Token tokenToClose = new Token(Token.Doctype.doctype(), null, null, true);
        builder.popStackToClose(tokenToClose);
        assert inputString.contains(tokenToClose.toString());
    }

    private static void testPopStackToCloseComment(Token commentToken) {
        String inputString = "<root><a/> <b/></root>";
        XmlTreeBuilder builder = new XmlTreeBuilder();
        Token tokenToClose = new Token(Token.Comment.comment(), null, null, true);
        builder.popStackToClose(tokenToClose);
        assert inputString.contains(tokenToClose.toString());
    }

    private static void testPopStackToCloseContext() {
        String inputString = "<root><a/> <b/></root>";
        XmlTreeBuilder builder = new XmlTreeBuilder();
        Token tokenToClose = new Token(Token.EndTag.end(), null, null, true);
        builder.popStackToClose(tokenToClose);
    }

    private static void testParseFragment(String inputFragment, String expectedOutput, Parser parserMock, Optional<XmlTree> xmlTreeOptional) {
        Document document = Jsoup.parse(inputFragment);
        if (xmlTreeOptional.isPresent()) {
            XmlTree tree = xmlTreeOptional.get();
            builder = new XmlTreeBuilder(parserMock);
            for (Element element : document.getAllElements()) {
                builder.append(element);
            }
            List<Node> result = builder.result();
            assert result.size() > 0;
        } else {
            parserMock.parse(inputFragment, null);
            xmlTreeOptional = Optional.of(new Document());
            builder = new XmlTreeBuilder(parserMock);
            for (Element element : document.getAllElements()) {
                builder.append(element);
            }
            List<Node> result = builder.result();
            assert result.size() > 0;
        }

        if (!expectedOutput.equals(builder.toString())) {
            fail("Expected output is different from actual output");
        }
    }
}
