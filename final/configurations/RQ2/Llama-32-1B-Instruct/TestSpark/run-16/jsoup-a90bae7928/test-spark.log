        String inputString = "<root><a/> <b/></root>";
        XmlTreeBuilder builder = new XmlTreeBuilder();
        builder.append(new Element("root"));
        builder.append(new Element("a"));
        builder.append(new Element("b"));
    }

    private static void testParseFragment(String inputFragment, String expectedOutput, Parser parserMock) {
        Document document = Jsoup.parse(inputFragment);
        if (expectedOutput.equals(builder.toString())) {
            assert xmlTreeOptional.isEmpty();
        } else {
            parserMock.parse(inputFragment, null);
            xmlTreeOptional = Optional.of(new Document());
            builder = new XmlTreeBuilder(parserMock);
            for (Element element : document.getAllElements()) {
                builder.append(element);
            }
            List<Node> result = builder.result();
            assert result.size() > 0;
        }
    }

    private static void testParseFragmentWithParser(Parser parser) {
        String inputFragment = "<root><a/> <b/></root>";
        builder = new XmlTreeBuilder(parser);
        testParseFragment(inputFragment, "expected output", parser);
    }

    public interface Parser {
        void parse(String inputString, Element parentElement);
    }
