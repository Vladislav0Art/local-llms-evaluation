import org.jsoup.helper.UrlBuilder;
import org.junit.jupiter.api.Test;
import static org.jsoup.helper.DataUtil.UTF_8;
import java.net.MalformedURLException;
import java.net.URLDecoder;
import java.net.URLEncoder;
import org.junit.jupiter.api.BeforeEach;

public class UrlBuilderTest {

    private URLBuilder urlBuilder;
    private String testUrl = "https://example.com";

    @BeforeEach
    public void setUp() {
        urlBuilder = new UrlBuilder(new URL(testUrl));
    }

    @Test
    public void appendKeyVal_WithoutError() throws UnsupportedEncodingException {
        urlBuilder.appendKeyVal("key1=value1");
        assertEquals(testUrl + "?key1=value1", urlBuilder.build());
    }

    @Test
    public void appendKeyVal_URLEncoded() throws UnsupportedEncodingException {
        String encodedString = "key1=value1";
        URLBuilder.AppendKeyValTest test = new UrlBuilder.AppendKeyValTest(encodedString);
        test.appendKeyVal("key1=value1");
        assertEquals(testUrl + "?key1=value1", urlBuilder.build());
    }

    @Test
    public void appendKeyVal_NonEmptyValue() throws UnsupportedEncodingException {
        String encodedString = "key1=value1";
        URLBuilder.AppendKeyValTest test = new UrlBuilder.AppendKeyValTest(encodedString);
        test.appendKeyVal("value2");
        assertEquals(testUrl + "?key1=value1&value2", urlBuilder.build());
    }

    @Test
    public void build_WithoutError() throws MalformedURLException, URISyntaxException {
        URLBuilder.AppendKeyValTest test = new UrlBuilder.AppendKeyValTest();
        test.appendKeyVal("key1=value1");
        assertEquals(testUrl + "?key1=value1", test.build().toString());
    }

    @Test
    public void build_URLEncoded_WithoutError() throws MalformedURLException, URISyntaxException {
        String encodedString = "key1=value1";
        URLBuilder.AppendKeyValTest test = new UrlBuilder.AppendKeyValTest(encodedString);
        assertEquals(testUrl + "?key1=value1", test.build().toString());
    }

    @Test
    public void build_NonEmptyValue_WithoutError() throws MalformedURLException, URISyntaxException {
        String encodedString = "key1=value1";
        URLBuilder.AppendKeyValTest test = new UrlBuilder.AppendKeyValTest(encodedString);
        assertEquals(testUrl + "?key1=value1", test.build().toString());
    }

    @Test
    public void appendKeyVal_MalformedKey() throws UnsupportedEncodingException {
        URLBuilder.AppendKeyValTest test = new UrlBuilder.AppendKeyValTest("invalid-key");
        assertThrows(MalformedURLException.class, () -> urlBuilder.appendKeyVal(test));
    }
}

public class UrlBuilderAppendKeyValTest extends UrlBuilder.AppendKeyValTest {
    public void appendKeyVal(String key) throws UnsupportedEncodingException {
        // implementation
    }

    @Override
    protected String build() throws MalformedURLException, URISyntaxException {
        return buildWithDefaultValues();
    }

    private String buildWithDefaultValues() {
        return null;
    }
}

public interface UrlBuilder.AppendKeyValTest extends UrlBuilder {
    void appendKeyVal(String key);
}
