import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.select.Elements;

public class TextNodeTest {

    private Document document;

    @BeforeClass
    public static void init() {
        String html = "<html><body>Hello, world!</body></html>";
        document = new Document(html);
    }

    @Test
    public void nodeName() throws Exception {
        Elements elements = document.getElementsByTagName("text");
        for (Element element : elements) {
            assertEquals("text", element.getAttribute("name"));
        }
    }

    @Test
    public void text() throws Exception {
        TextNode node = new TextNode("Hello, world!");
        String expectedText = "Hello, world!";
        assertEquals(expectedText, node.getText());
    }

    @Test
    public void text(String text) throws Exception {
        TextNode node = new TextNode(text);
        String expectedText = text;
        assertEquals(expectedText, node.getText());
    }

    @Test
    public void getWholeText() throws Exception {
        Elements elements = document.getElementsByTagName("text");
        for (Element element : elements) {
            assertEquals("Hello, world!", element.getTextContent());
        }
    }

    @Test
    public void isBlank() throws Exception {
        TextNode node = new TextNode("");
        boolean expected = false;
        boolean actual = node.isBlank();
        assertEquals(expected, actual);
    }

    @Test
    public void splitText(int offset) {
        TextNode node = new TextNode("Hello, world!");
        Elements elements = document.getElementsByTagName("text");
        for (int i = 1; i <= elementCount(); i++) {
            if (element(i).getText().isEmpty()) {
                break;
            }
            int splitIndex = node.splitText(offset + i);
            assertEquals(2, splitIndex);
        }
    }

    @Test
    public void outerHtmlHead() throws Exception {
        Element head = document.getElementsByTagName("head").item(0);
        String expected = "<text>text</text>";
        TextNodeBuilder builder = new TextNodeBuilder();
        head.appendChild(builder.build());
        assertEquals(expected, builder.toString());
    }

    @Test
    public void outerHtmlTail() throws Exception {
        Element body = document.getElementsByTagName("body").item(0);
        String expected = "";
        TextNodeBuilder builder = new TextNodeBuilder();
        body.appendChild(builder.build());
        assertEquals(expected, builder.toString());
    }

    @Test
    public void toString() {
        Elements elements = document.getElementsByTagName("text");
        StringBuilder builder = new StringBuilder();
        for (Element element : elements) {
            builder.append(element.getText()).append("\n");
        }
        assertEquals("<text>Hello, world!</text>", builder.toString());
    }

    @Test
    public void clone() throws Exception {
        Document originalDocument = document.cloneNode(true);
        TextNode originalTextNode = new TextNode(originalDocument.text());
        TextNode clonedTextNode = new TextNode(originalTextNode.getText());
        assertEquals(originalTextNode, clonedTextNode);
    }

    private int elementCount() {
        return document.getElementsByTagName("text").length;
    }
}

class TextNodeBuilder extends org.jsoup.nodes.Builder {

