public class W3CDom {

    private Document document;

    public boolean namespaceAware() {
        return false;
    }

    public W3CDom namespaceAware(boolean namespaceAware) {
        return new W3CDom(namespaceAware);
    }

    public static Document convert(org.jsoup.nodes.Document in) {
        String documentString = in.outerHtml();
        document = DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(new java.io.StringWriter(), documentString.trim());
        return document;
    }

    @Test
    public void testConvertString() {
        org.jsoup.nodes.Document doc = new W3CDom().convert(org.jsoup.nodes.Document.createTag("html")));
        assertNotNull(doc);
        assert documentElement(doc, "html");
    }

    private static Node contextNode(Document wDoc) {
        return (org.jsoup.nodes.Element) wDoc.getDocumentElement();
    }

    @Test
    public void testContextNode() {
        org.jsoup.nodes.Document doc = new W3CDom().convert(org.jsoup.nodes.Document.createTag("html")));
        assertNotNull(doc);
        assertEquals("<html>", contextNode(doc).getTextContent());
    }

    @Test
    public void testSelectXpath() {
        org.jsoup.nodes.Document doc = new W3CDom().fromJsoup(org.jsoup.nodes.Document.createTag("body", "class=\"container\" id=\"main-content\"")));
        String xpath = "//div[@class=\"container\"]";
        NodeList nodeList = selectXpath(xpath, doc);
        assertNotNull(nodeList);
        assertEquals(1, nodeList.getLength());
    }

    @Test
    public void testSelectNode() {
        org.jsoup.nodes.Document doc = new W3CDom().fromJsoup(org.jsoup.nodes.Element.createTag("body", "class=\"container\" id=\"main-content\"")));
        String xpath = "//div[@class=\"container\"]";
        NodeList nodeList = selectXpath(xpath, doc);
        assertNotNull(nodeList);
        assertEquals(1, nodeList.getLength());
    }

    @Test
    public void testSourceNodes() {
        org.jsoup.nodes.Document doc = new W3CDom().fromJsoup(org.jsoup.nodes.Element.createTag("body", "class=\"container\" id=\"main-content\"")));
        String xpath = "//div[@class=\"container\"]";
        NodeList nodeList = sourceNodes(nodeList, Object.class);
        assertNotNull(nodeList);
    }

    @Test
    public void testStringAs() {
        org.jsoup.nodes.Document doc = new W3CDom().fromJsoup(org.jsoup.nodes.Element.createTag("body", "class=\"container\" id=\"main-content\"")));
        String properties = "<x-prop1='value1'>value1</x-prop1>";
        document = convert(doc);
        assertEquals(properties, asString(document, Map.of()));
    }
}
