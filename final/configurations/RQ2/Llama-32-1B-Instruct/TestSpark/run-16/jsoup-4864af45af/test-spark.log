import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import static org.jsoup.internal.Normalizer.lowerCase;

public class SafelistTest {

    private Document document;
    private Safelist safelist;

    @BeforeEach
    public void setup() {
        String html = "<html><body>Hello <a href=\"#\">world</a></body></html>";
        document = new Document();
        Element body = document.createElement("body");
        body.appendChild(document.createNode(document, lowerCase(html)));
        Safelist none = new Safelist();
        safelist = new Safelist(none);
    }

    @Test
    public void noneIsSafe() {
        Safelist safelistWithNoneTag = safelist.none();
        Assert.assertTrue(safelist.isSafeTag(safelistWithNoneTag.getTags()[0].getName()));
    }

    @Test
    public void simpleTextIsSafe() {
        Safelist safelistWithSimpleTextTag = new Safelist();
        safelistWithSimpleTextTag.addTags("p");
        Assert.assertTrue(safelist.isSafeTag("p"));
    }

    @Test
    public void basicIsSafe() {
        Safelist safelistWithBasicTag = new Safelist();
        safelistWithBasicTag.addAttributes("style", "color: red;");
        Assert.assertTrue(safelist.isSafeAttribute("basic", "style", "color: red;"));
    }

    @Test
    public void basicWithImagesIsSafe() {
        Safelist safelistWithBasicImagesTag = new Safelist();
        safelistWithBasicImagesTag.addTags("img");
        safelistWithBasicImagesTag.addProtocols("img", "src", "https://example.com/image.jpg");
        Assert.assertTrue(safelist.isSafeAttribute("basic_with_images", "style", "color: red;"));
    }

    @Test
    public void relaxedIsSafe() {
        Safelist safelistWithRelaxedTag = new Safelist();
        Assert.assertTrue(safelist.isSafeTag("relaxed"));
    }

    @Test
    public void relaxedIsNotSafeForAllTags() {
        Safelist safelistWithRelaxedTagWithoutStyleAttribute = new Safelist();
        Assert.assertFalse(safelist.isSafeTag("p"));
    }

    @Test
    public void simpleTextWithStylesIsSafe() {
        Safelist safelistWithSimpleTextTag = new Safelist();
        safelistWithSimpleTextTag.addTags("style", "color: red;");
        safelistWithSimpleTextTag.addAttributes("style", "width: 100px; height: 50px;");
        Assert.assertTrue(safelist.isSafeAttribute("simple_text", "style", "color: red; width: 100px; height: 50px;"));
    }

    @Test
    public void basicWithImagesStyleAndHeightIsSafe() {
        Safelist safelistWithBasicImagesTag = new Safelist();
        safelistWithBasicImagesTag.addTags("img");
        safelistWithBasicImagesTag.addProtocols("img", "src", "https://example.com/image.jpg");
        safelistWithBasicImagesTag.addAttributes("style", "width: 100px; height: 50px;");
        Assert.assertTrue(safelist.isSafeAttribute("basic_with_images", "style", "color: red; width: 100px; height: 50px;"));
    }

    @Test
    public void relaxedWithImagesStyleAndHeightIsSafe() {
        Safelist safelistWithRelaxedTag = new Safelist();
        Assert.assertTrue(safelist.isSafeAttribute("relaxed", "style", "color: red; width: 100px; height: 50px;"));
    }

    @Test
    public void addTagsAllAttributesIsSafe() {
        Safelist safelistWithAddTagsTag = new Safelist();
        safelistWithAddTagsTag.addTags("a");
        Assert.assertTrue(safelist.isSafeAttribute("add_tags", "style", "color: red;");
    }

    @Test
    public void removeTagsNoneTagIsNotSafe() {
        Safelist safelistWithRemoveTagsTag = new Safelist();
        safelistWithRemoveTagsTag.removeTags("a");
        Assert.assertFalse(safelist.isSafeTag("a"));
    }
}
