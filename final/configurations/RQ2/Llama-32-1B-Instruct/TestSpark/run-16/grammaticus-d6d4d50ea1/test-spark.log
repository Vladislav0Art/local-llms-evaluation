    public void test_contains() {
        Term term1 = new Term("test");
        Term term2 = new Term("test2");

        map.addTerm(term1);
        map.addTerm(term2);

        System.out.println(map.contains(term1)); // true
        System.out.println(map.contains(term2)); // false

        map.addTerm(term2); // This should raise an exception

        try {
            map.contains(term1);
        } catch (Exception e) {
            System.out.println(e.getMessage()); // "Value is null"
        }
    }

    @Test
    public void testAdd() {
        Term term = new Term("test");
        map.addTerm(term);

        System.out.println(map.terms); // contains all terms

        map.addTerm(new GrammaticalTerm("test2", 1));
        System.out.println(map.terms.size()); // 2
    }
}
