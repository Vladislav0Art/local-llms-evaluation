public class JacksonJsonTransformerTest {

    private static final String SIMPLE JacksonJson;

    @Before
    public void setup() {
        try (ObjectMapper mapper = new ObjectMapper()) {
            SimpleModule module = new SimpleModule();
            module.addDeserializer(String.class, new JacksonJsonDeserializer());
            mapper.registerModules(module);
            JacksonJsonTransformer transformer = new JacksonJsonTransformer();
            transformer.parse("", String.class);
        }
    }

    @Test
    public void testParse_Simple() throws Exception {
        String json = "{\"name\":\"Crowdin\",\"version\":1}";
        Assert.assertTrue(JacksonJsonTransformer.parse(json, Project.class).isSuccessful());
    }

    @Test
    public void testConvert_SingleObject() throws Exception {
        String json = "{\"name\":\"Crowdin\",\"version\":1}";
        Project project = JacksonJsonTransformer.convert(Project.class, json);
        Assert.assertEquals("Crowdin", project.getName());
        Assert.assertEquals(1, project.getVersion());
    }

    @Test
    public void testConvert_SingleArray() throws Exception {
        String json = "[{\"name\":\"Crowdin\",\"version\":1}]";
        Project[] projects = JacksonJsonTransformer.convert(Project[].class, json);
        Assert.assertEquals("Crowdin", projects[0].getName());
        Assert.assertEquals(1, projects[0]..getVersion());
    }

    @Test
    public void testConvert_SingleMap() throws Exception {
        String json = "{\"key\":\"value\"}";
        Map<String, Object> map = JacksonJsonTransformer.convert(Map.class, json);
        Assert.assertEquals("value", map.get("key"));
    }

    @Test
    public void testParse_Failed() throws Exception {
        String json = "{\"name\":\"Crowdin\",\"version\":1,nonExistingField:nonExistingValue}";
        Assert.assertFalse(JacksonJsonTransformer.parse(json, Project.class).isSuccessful());
    }
}
