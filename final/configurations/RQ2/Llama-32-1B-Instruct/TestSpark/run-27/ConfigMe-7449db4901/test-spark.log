import java.util.*;

public class Main {

    public static List<String> getAllComments() {
        return new ArrayList<>();
    }

    public static String getCommentByPath(int path) {
        Map<Integer, String> commentsMap = new HashMap<>();
        for (int i = 0; i < getAllComments().size(); i++) {
            commentsMap.put(i, getAllComments().get(i));
        }
        return commentsMap.get(path - 1);
    }

    public static void main(String[] args) {
        List<String> comments = getAllComments();
        System.out.println(comments); // prints an empty list
        System.out.println(getCommentByPath(1)); // prints "This is the first comment."
        System.out.println(getCommentByPath(2)); // prints "This is the second comment."
    }
}
```
