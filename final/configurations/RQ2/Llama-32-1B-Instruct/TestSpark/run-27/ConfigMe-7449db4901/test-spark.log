import java.util.ArrayList;
import java.util.List;

public class TestClass {

    private static List<String> getAllComments() {
        // Assuming we are storing comments in a database or a file
        String[] comments = { "This is the first comment.", "This is the second comment.", "" };
        List<String> list = new ArrayList<>();
        for (String s : comments) {
            list.add(s);
        }
        return list;
    }

    public static void main(String[] args) {
        System.out.println(getAllComments());
    }

    private static String getCommentByPath(int path) {
        // Assuming we are storing comments in a database or a file
        String comment = getAllComments().get(path - 1);
        if (comment != null && !comment.isEmpty()) {
            return comment;
        } else {
            return "";
        }
    }
}
```

