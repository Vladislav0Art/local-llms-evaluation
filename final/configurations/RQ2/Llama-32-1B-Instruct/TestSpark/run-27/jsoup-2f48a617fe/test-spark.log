        // Get Child from the comment
        Comment grandchild = rootComment.getChild(1);
        
        // Check if the child exists
        Assert.assertNotNull(grandchild);
    }
}

class Comment {
    public String text;
    
    public Comment(String text) {
        this.text = text;
    }
    
    public static Comment getFirst() throws Exception {
        return new Comment("This is content");
    }
    
    public void addChild(Comment child) {
        throw new UnsupportedOperationException("Method does not exist");
    }
    
    public String getText() {
        return text;
    }
}

class TestSpark {
    public void appendChild(Comment parent, Comment child) throws Exception {
        parent.addChild(child);
    }
}

