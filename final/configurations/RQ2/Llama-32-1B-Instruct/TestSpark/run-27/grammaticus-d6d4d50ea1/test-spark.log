public class GrammarTest {
    public static void testGetGrammaticalTerm(Grammar grammar) {
        // Test getting grammatical term from words list
        List<Word> actualWords = new ArrayList<>();
        actualWords.add(new Adjective(1));
        actualWords.add(new Noun("test"));
        
        List<Word> expectedWords = new ArrayList<>();
        expectedWords.add(new Adjective(1));
        expectedWords.add(new Adverb(2));

        List<GrammaticalTerm> actualTerms = grammar.get(actualWords);
        List<GrammaticalTerm> expectedTerms = grammar.get(expectedWords);

        System.out.println("Actual Terms: ");
        for (GrammaticalTerm term : actualTerms) {
            System.out.println(term.toString());
        }

        System.out.println("\nExpected Terms: ");
        for (GrammaticalTerm term : expectedTerms) {
            System.out.println(term.toString());
        }
    }

    public static void main(String[] args) {
        // Create a grammar
        List<Word> words = new ArrayList<>();
        words.add(new Adjective(1));
        words.add(new Noun("test"));
        
        Grammar grammar = new Grammar(words);

        testGetGrammaticalTerm(grammar);
    }
