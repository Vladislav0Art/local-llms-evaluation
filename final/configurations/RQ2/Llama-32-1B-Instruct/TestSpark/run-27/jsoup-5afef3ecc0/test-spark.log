        }
    }

    private static String generatePublicUrl(String url) {
        return url.replace("https://example.com/", "/api/");
    }

    private static String[] parseQueryParams(String url) {
        // Parse the URL to extract query parameters
        int start = url.indexOf('?');
        if (start == -1) {
            return null;
        }
        int end = url.indexOf('&', start);
        if (end == -1) {
            return new String[]{url.substring(start + 1).trim()};
