**Python Solution:**

```python
class Database:
    def __init__(self, tableName):
        self.tableName = tableName

    # Insert a record into the table
    def insert(self, values):
        rows = [tuple(value) for value in values]
        if len(rows) == 1:
            return
        new_row = tuple(0 for _ in range(len(values)))
        new_row.extend(rows)
        self.data[self.tableName] = list(new_row)

    # Delete a record from the table
    def delete(self, index):
        if index < 0 or index >= len(self.data[self.tableName]):
            print("Invalid index")
            return

        del self.data[self.tableName][index]

    # Update a record in the table
    def update(self, index, value):
        if index < 0 or index >= len(self.data[self.tableName]):
            print("Invalid index")
            return

        new_value = [value]
        new_value.extend(self.data[self.tableName].index(index))
        self.data[self.tableName][index] = new_value

    # Select records from a table based on given conditions
    def select_from_table(self, condition):
        if not condition:
            return {}

        columns = condition.split(" WHERE ")
        for column in columns[0].split(", ")[:-1]:
            value = [column]
            self.data[self.tableName].append(value)
        return {self.tableName: self.data[self.tableName]}

db = Database("Test")

record1 = (1, "11", "10")
record2 = (2, "21", "20")

db.insert(record1)
db.insert(record2)

indexToDelete = 0
db.delete(indexToDelete)

new_record1 = (3, "31", "30")
new_record2 = (4, "41", "40")
db.insert(new_record1)
db.insert(new_record2)

selectFromTable = db.select_from_table("id = 2")
print(selectFromTable)
```

Both solutions have the same functionality. The main difference lies in their approach and syntax.

**Key differences:**

* In Java, we use a `HashMap` to store data instead of an array, which allows for more flexibility and easier iteration.
* In Python, we use list comprehensions and indexing to create new lists or update existing ones.
* We also use the `tuple` function to convert objects to tuples in Python.
* The syntax for deleting rows is slightly different between Java and Python.
