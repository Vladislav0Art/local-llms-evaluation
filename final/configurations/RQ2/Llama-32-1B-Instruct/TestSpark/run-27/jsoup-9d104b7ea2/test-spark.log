public class TextNodeTest {

    private static Mockito mock;

    @Test
    public void testnodeName() {
        String expected = "text";
        String text = "Hello World!";
        when(nodeName()).thenReturn(expected);
        assertEquals("text", getText().nodeName());
    }

    @Test
    public void testText() {
        String expected = "This is a sample text.";
        String text = "This is a sample text.";
        when(text()).thenReturn(expected);
        assertEquals(text, getText().text());
    }

    @Test
    public void testTextConcatenation() {
        String expected = "Hello World!";
        String text = "This is a sample text.";
        when(text()).thenReturn(expected);
        assertEquals(text, getText().text());
    }

    @Test
    public void testGetWholeText() {
        String expected = "Hello World! This is a sample text.";
        Document document = new Document();
        document.appendChild(new TextNode("Hello World!"));
        document.appendChild(new TextNode("This is a sample text."));
        when(getWholeText()).thenReturn(expected);
        assertEquals(expected, getText().getWholeText());
    }

    @Test
    public void testIsBlank() {
        String expected = true;
        Document document = new Document();
        document.appendChild(new TextNode(""));
        when(isBlank()).thenReturn(expected);
        assertEquals(expected, getText().isBlank());
    }

    @Test
    public void testSplitTextOffset0() {
        String expected = "Hello World!";
        TextNode text = new TextNode("Hello World!");
        when(splitText(0)).thenReturn(text);
        assertEquals(text, getText().splitText(0));
    }

    @Test
    public void testSplitTextOffset1() {
        String expected = "sample";
        TextNode text = new TextNode("sample");
        when(splitText(1)).thenReturn(text);
        assertEquals(text, getText().splitText(1));
    }

    @Test
    public void testOuterHtmlHeadAppendableMocking() {
        Mockito mock = Mockito.mock(Appendable.class);
        when(mock.toString()).thenReturn(""));
        TextNode text = new TextNode("Hello World!");
        when(text.outerHtmlHead(any(Appendable.class), anyInt(), anyDocumentOutputSettings())).thenReturn(mock);
        assertEquals("", getText().outerHtmlHead(mock, 0, Document.OutputSettings.DEFAULT));
    }

    @Test
    public void testOuterHtmlTailAppendableMocking() {
        Mockito mock = Mockito.mock(Appendable.class);
        when(mock.toString()).thenReturn(""));
        TextNode text = new TextNode("Hello World!");
