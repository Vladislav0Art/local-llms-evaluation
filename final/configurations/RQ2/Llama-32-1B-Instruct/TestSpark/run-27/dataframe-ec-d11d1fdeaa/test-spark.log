```java
import java.util.*;

public class DataFrame {

    private List<List<Object>> data;

    public DataFrame(List<List<Object>> data) {
        this.data = data;
    }

    public void print() {
        for (List<Object> row : data) {
            for (Object value : row) {
                if (value instanceof String) {
                    System.out.println(value.toString());
                } else {
                    // You will need to implement a way to handle non-string values
                    System.out.print(value + ", ");
                }
            }
            System.out.println();
        }
    }

    public static void main(String[] args) {
        List<List<Object>> data = new ArrayList<>();
        data.add(Arrays.asList("John", 25, "New York"));
        data.add(Arrays.asList("Alice", 30, "London"));

        DataFrame df = new DataFrame(data);
        df.print();
    }
}
```

