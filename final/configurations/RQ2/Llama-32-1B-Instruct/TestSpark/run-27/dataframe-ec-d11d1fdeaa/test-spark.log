import java.util.*;

public class DataFrame {

    private List<String> columnNames;
    private List<ColumnInfo> columns;

    public DataFrame(List<String> columnNames) {
        this.columnNames = columnNames;
        this.columns = new ArrayList<>();
    }

    public void addColumn(String columnName, ColumnInfo info) {
        columns.add(info);
    }

    public DfCursor getCursor() {
        return new DataFrameCursor(this);
    }

    public void print() {
        System.out.println("columnNames: " + columnNames);
        for (int i = 0; i < columns.size(); i++) {
            ColumnInfo column = columns.get(i);
            System.out.println("Column " + (i + 1) + ": " + column.getName());
            if (column.isString()) {
                System.out.println(column.getValue().toString());
            } else {
                for (int j = 0; j < column.getValues().size(); j++) {
                    System.out.print(column.getValues().get(j) + ", ");
                }
                System.out.println();
            }
        }
    }

    public static class ColumnInfo {
        private String name;
        private boolean isString;

        public ColumnInfo(String name, boolean isString) {
            this.name = name;
            this.isString = isString;
        }

        public String getName() {
            return name;
        }

        public boolean isString() {
            return isString;
        }
    }

    public static class DfCursor implements Procedure<DfCursor> {

        private DataFrame data;

        public DfCursor(DataFrame data) {
            this.data = data;
        }

        @Override
        public void execute(ProcedureParameters parameters) throws Exception {
            for (Map.Entry<String, Object> entry : parameters.getValues().entrySet()) {
                String columnName = (String) entry.getKey();
                Object value = entry.getValue();

                if (value instanceof String) {
                    data.setColumn(columnName, ((String) value).trim());
                } else {
                    List<Object> values = new ArrayList<>();
                    for (Object obj : (List<?>) value) {
                        values.add(obj.toString().replaceAll("\\[|\\]|,", ""));
                    }
                    data.setColumn(columnName, values);
                }
            }
        }

        @Override
        public DfCursor next() throws Exception {
            return this;
        }

        @Override
        public boolean hasNext() throws Exception {
            return true;
        }
    }

    public static class DataFrameCursor implements Procedure<DfCursor> {

        private DataFrame data;

        public DataFrameCursor(DataFrame data) {
            this.data = data;
        }

        @Override
        public void execute(ProcedureParameters parameters) throws Exception {
            for (Map.Entry<String, Object> entry : parameters.getValues().entrySet()) {
                String columnName = (String) entry.getKey();
