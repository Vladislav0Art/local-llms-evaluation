                    for (Object obj : (List<?>) value) {
                        values.add(obj.toString().replaceAll("\\[|\\]|,", ""));
                    }
                    data.setColumn(columnName, values);
                }
            }
        }

        @Override
        public DfCursor next() throws Exception {
            return this;
        }

        @Override
        public boolean hasNext() throws Exception {
            return true;
        }

    }

    public static class Column {
        private String name;

        public Column(String name) {
            this.name = name;
        }

        public void setValue(Object value) {
            System.out.println("Setting value of column " + name + ": " + value);
        }

        public Object getValue() {
            return null;
        }

        public boolean isString() {
            return false;
        }
    }

    public static class ColumnInfo {
        private String name;

        public ColumnInfo(String name) {
            this.name = name;
        }

        public void setValue(Object value) {
            System.out.println("Setting value of column " + name + ": " + value);
        }

        public Object getValue() {
            return null;
        }

        public boolean isString() {
            return false;
        }
    }

    @Override
    public String toString() {
        return "DataFrame{" +
                "columnNames=" + columnNames +
                ", columns=[\n" +
                "        Column '" + columns.get(0).getName() + '\'' +
                "\n" +
                "    ]" +
                '}';
    }
}
