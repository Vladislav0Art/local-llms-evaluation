package ch.jalu.configme.configurationdata;

import ch.jalu.configme.exception.ConfigMeException;
import ch.jalu.configme.properties.Property;
import org.jetbrains.annotations.NotNull;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

public class PropertyListBuilder {

    public void addProperty(Property<?> property) {
        requireNonNull(property);
    }

    public List<Property<?>> create() {
        return new ArrayList<>();
    }

    protected Map<String, Object> getRootEntries() {
        return new LinkedHashMap<>();
    }
}

public class PropertyListBuilderTest extends TestCase {

    private PropertyListBuilder builder;

    @Override
    protected void setUp() throws Exception {
        super.setUp();
        builder = new PropertyListBuilder();
    }

    public void testAddPropertyWithoutRootEntries() throws ConfigMeException {
        @Mock
        Property property = mock(Property.class);
        requireNonNull(property);
        when(builder.addProperty(property)).thenReturn(null);

        List<Property<?>> list = builder.create();
        assertEquals(0, list.size());
    }

    public void testAddPropertyWithRootEntries() throws ConfigMeException {
        @Mock
        Property property1 = mock(Property.class);
        @Mock
        Property property2 = mock(Property.class);
        requireNonNull(property1);
        @NotNull
        requireNonNull(property2);

        when(builder.addProperty(property1)).thenReturn(property1);
        when(builder.addProperty(property2)).thenReturn(property2);

        List<Property<?>> list = builder.create();
        assertEquals(2, list.size());
        assertEquals(property1, list.get(0));
        assertEquals(property2, list.get(1));
    }

    public void testAddMultipleProperties() throws ConfigMeException {
        @Mock
        Property property1 = mock(Property.class);
        @NotNull
        requireNonNull(property1);

        List<Property<?>> list = builder.create();
        assertEquals(1, list.size());
        assertEquals(property1, list.get(0));
    }

    public void testCreate() throws ConfigMeException {
        @Mock
        Property property = mock(Property.class);
        requireNonNull(property);
        when(builder.getRootEntries()).thenReturn(new HashMap<>());

        List<Property<?>> list = builder.create();
        assertEquals(1, list.size());
        assertEquals(property, list.get(0));
    }

    public void testGetRootEntries() throws ConfigMeException {
        @Mock
        Property property1 = mock(Property.class);
        @NotNull
        requireNonNull(property1);

        Map<String, Object> map = new LinkedHashMap<>();
        map.put("property1", "value1");
        when(builder.getRootEntries()).thenReturn(map);

        List<Property<?>> list = builder.create();
        assertEquals(1, list.size());
        assertEquals(property1, list.get(0));
    }

    public void testGetRootEntriesWithMultipleProperties() throws ConfigMeException {
        @Mock
        Property property1 = mock(Property.class);
        @Mock
        Property property2 = mock(Property.class);

        Map<String, Object> map = new LinkedHashMap<>();
        map.put("property1", "value1");
        map.put("property2", "value2");
        when(builder.getRootEntries()).thenReturn(map);

        List<Property<?>> list = builder.create();
        assertEquals(2, list.size());
        assertEquals(property1, list.get(0));
        assertEquals(property2, list.get(1));
    }

    private void requireNonNull(Object value) {
        if (value == null) {
            fail("Expected non-null value");
        }
    }
}
