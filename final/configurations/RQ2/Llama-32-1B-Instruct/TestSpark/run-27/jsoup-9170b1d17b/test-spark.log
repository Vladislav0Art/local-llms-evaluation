        AttrKeys keys = new AttrKeys("key");
        System.out.println(keys.getValue(keys.getKey()));

        TestHelper.empty();

        String[] methods = {"getAge", "getStringValue"};
        for (String methodName : methods) {
            Method method = TestHelper.class.getMethod(methodName);
            if (method != null && !methodName.equals("_toString") && !methodName.startsWith("_")) {
                System.out.println(method.toString());
            }
        }

        Object obj = new Object();
        System.out.println(obj.getClass().getName() + ".test");
    }

    public static void getMethodsByClass(Class<?> clazz) throws IllegalAccessException {
        Map<String, Method> methodsMap = new HashMap<>();
        for (Method method : clazz.getDeclaredFields()) {
            String methodName = method.getName();
            if (!methodName.equals("toString") && !methodName.startsWith("_")) {
                methodsMap.put(methodName, method);
            }
        }
        System.out.println(methodsMap);
    }

    public static void getClassDeclaredFields(Class<?> clazz) throws IllegalAccessException {
        Method[] methods = clazz.getDeclaredFields();
        for (Method method : methods) {
            if (!method.getName().startsWith("_")) {
                System.out.println(method.getName());
            }
        }
    }

    public static String getStringValue(String value) {
        return stringValues.getOrDefault(value, "Unknown value");
    }
}

class Main {

