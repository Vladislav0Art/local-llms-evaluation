        System.out.println("Attributes.empty():");
    }
}

class AttrKeys {
    private String key;

    public AttrKeys(String key) {
        this.key = key;
    }

    public String getKey() {
        return key;
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj)
            return true;
        if (obj == null || getClass() != obj.getClass())
            return false;
        AttrKeys other = (AttrKeys) obj;
        return Objects.equals(key, other.key);
    }

    @Override
    public int hashCode() {
        return Objects.hash(key);
    }
}

class TestHelper {

    static Map<String, String> stringValues = new HashMap<>();

    static {
        stringValues.put("test", "Test value");
    }

