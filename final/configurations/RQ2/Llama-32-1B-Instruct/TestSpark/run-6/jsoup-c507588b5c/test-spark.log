package org.jsoup.nodes;

import org.jsoup.nodes.Appendable;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Node;
import org.jsoup.nodes.TextNode;
import org.junit.Test;

import java.io.IOException;

public class GeneratedTest {

    @Test
    public void nodeNameTests() {
        TextNode textNode = new TextNode("Hello");
        assertEquals("Hello", textNode.nodeName());
        assertEquals("text", textNode.getText());
    }

    @Test
    public void textTests() {
        TextNode textNode = new TextNode("Hello World");
        assertNotNull(textNode.getText());
    }

    @Test
    public void splitTextTests() {
        TextNode textNode = new TextNode("Hello World");
        assertEquals(3, textNode.splitText(2).getText().length());
    }

    @Test
    public void outerHtmlHeadTests() {
        Document document = new Document();
        Appendable accum = document.createOuterHtmlAccumulator();
        StringBuilder builder = new StringBuilder();
        TextNode textNode = new TextNode("Hello");
        int depth = 0;
        textNode.outerHtmlHead(accum, depth, null);
        assertEquals("<p>Hello</p>", accum.toString());
    }

    @Test
    public void outerHtmlTailTests() {
        Document document = new Document();
        Appendable accum = document.createOuterHtmlAccumulator();
        StringBuilder builder = new StringBuilder();
        TextNode textNode = new TextNode("Hello");
        int depth = 0;
        textNode.outerHtmlHead(accum, depth, null);
        textNode.outerHtmlTail(accum, depth, null);
        assertEquals("<p>Hello</p>", accum.toString());
    }

    @Test
    public void toStringTests() {
        TextNode textNode = new TextNode("Hello");
        assertEquals("Hello", textNode.toString());
    }

    @Test
    public void cloneTests() {
        TextNode textNode1 = new TextNode("Hello");
        TextNode textNode2 = textNode1.clone();
        assertNotNull(textNode2);
        assertEquals(textNode1, textNode2);
    }

    @Test
    public void createFromEncodedTests() throws IOException {
        String encodedText = "Hello World";
        TextNode textNode = TextNode.createFromEncoded(encodedText);
        assertNotNull(textNode);
        assertEquals("Hello", textNode.getText());
    }

    @Test
    public void normaliseWhitespaceTests() {
        assertEquals("", normaliseWhitespace(""));
        assertEquals(" ", normaliseWhitespace("   "));
        assertEquals("\n", normaliseWhitespace("\n\r\n"));
    }

    @Test
    public void stripLeadingWhitespaceTests() {
        assertEquals("", stripLeadingWhitespace(""));
        assertEquals("Hello World", stripLeadingWhitespace("Hello World"));
    }

    @Test
    public void lastCharIsWhitespaceTests() {
        assertEquals(" ", lastCharIsWhitespace(new StringBuilder()));
        assertEquals("\n\r\n", lastCharIsWhitespace(new StringBuilder("\n\r\n")));
        assertEquals("", lastCharIsWhitespace(new StringBuilder("   ")));
        assertEquals("World", lastCharIsWhitespace(new StringBuilder("Hello World")));
    }

}
