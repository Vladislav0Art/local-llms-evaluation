public class TestUtil {
    public static String generateHtml(String content) {
        // Create a new HTML document
        Document doc = new Document();
        
        // Parse the input content using XSLT
        Result result = new DocFX().parse(content);
        
        // Append the parsed elements to the main document
        var rootElement = doc.createElementNS("http://www.w3.org/1999/xhtml", "html");
        for (var xslNode : result.getNodes()) {
            if (xslNode instanceof HtmlNode) {
                ((HtmlNode)xslNode).appendChild(doc.createTextNode(xslNode.getTextContent()));
            }
        }
        
        // Add a title element
        var titleElement = doc.createElementNS("http://www.w3.org/1999/xhtml", "title");
        titleElement.setTextContent("Test Document");
        
        // Set the main document to the new root element
        doc.appendChild(rootElement);
        
        // Return the generated HTML content as a string
        return doc.body.outerHTML;
    }

    public static void testParse() {
        // Parse the input HTML using XSLT
        String htmlContent = "<html><body><h1>Hello World!</h1></body></html>";
        System.out.println("Parsed HTML:");
        String parsedHtml = TestUtil.generateHtml(htmlContent);
        
        // Print the generated HTML content
        System.out.println("\nGenerated HTML:");
        System.out.println(parsedHtml);

        // Parse a custom XSLT string using XSLT
        String xsltContent = "<xsl:stylesheet version=\"1.0\" xmlns:xsl=\"http://www.w3.org/1999/XSL/Transform\"><xsl:template match=\"/\"><html><body><h1>Hello World!</h1></body></html/></xsl:template></xsl:stylesheet>";
        System.out.println("\nParsed XSLT:");
        parsedHtml = TestUtil.generateHtml(xsltContent);
        
        // Print the generated HTML content
        System.out.println("\nGenerated XSLT:");
        System.out.println(parsedHtml);

        // Parse an XSLT string with a namespace using XSLT
        String xsltNamespaceString = "<xsl:stylesheet version=\"1.0\" xmlns:xsl=\"http://www.w3.org/1999/XSL/Transform><xsl:template match=\"/\"><html><body><h1>Hello World!</h1></body></html/></xsl:template></xsl:stylesheet>";
        System.out.println("\nParsed XSLT with namespace:");
        parsedHtml = TestUtil.generateHtml(xsltNamespaceString);
        
        // Print the generated HTML content
        System.out.println("\nGenerated XSLT with namespace:");
