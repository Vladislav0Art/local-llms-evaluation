    /**
     * Method to add an element to a list.
     *
     * @param id   The ID of the element to be added.
     * @param value The value of the element to be added.
     */
    public static void addElement(int id, int value) {
        // Create a new element with the given ID and value
        System.out.println("Adding element " + id + ": " + value);
        
        // Add the element to the list
        List<String> myList = new ArrayList<>();
        myList.add(id + ":" + value);
        myList.add(id + "," + value);
        myList.add(id + "-" + value);

        // Print the updated list
        for (String str : myList) {
            System.out.println(str);
        }
    }

    /**
     * Method to generate a text with nested elements.
     *
     * @param content The HTML content as a string.
     * @return A formatted version of the input content.
     */
    public static String generateText(String content) {
        // Use JavaScript to create the nested elements
        System.out.println("Generated Text:");
        
        // Parse the HTML content using JavaScript
        Document doc = new DOMParser().parseFromString(content, "text/html");
        
        // Create a new text element and append it to the parsed document
        var textElement = doc.createElementNS("http://www.w3.org/1999/xhtml", "span");
        textElement.textContent = "Text with nested elements";
        
        // Append the newly created text element to the parsed document
        doc.body.appendChild(textElement);
        
        // Serialize the modified document back into a string
        var formattedContent = doc.body.outerHTML;
        
        return formattedContent;
    }
}
