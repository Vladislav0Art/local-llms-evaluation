import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;

public class Safelist {
    private Document document;

    public String addEnforcedAttribute(String attr, String value) {
        if (document == null) {
            try {
                document = Jsoup.parse("html", "", "body");
            } catch (Exception e) {
                return null;
            }
        }

        Element tag = document.selectFirst("script[src*=\"" + attr + "\"]");

        if (tag != null) {
            String[] attrs = new String[0];
            tag.attr(attr, value);

            for (String attr : tag.attributes().keys()) {
                if (!attrs.length == 0 || !attr.equals(attrs[attr])) {
                    attrs = new String[attr, attributes.get(attr).length];
                    System.arraycopy(attrs, 0, attrs, 0, attr);
                    attrs[attr] = attr;
                }
            }

            for (Element child : tag.children()) {
                if (!child.tagName().equals("script")) {
                    addEnforcedAttribute(attr, value);
                }
            }
        }

        return value;
    }

    public String removeAttribute(String attr) {
        if (document == null || document.selectFirst("script[src*=\"" + attr + "\"]") != null) {
            try {
                Element tag = document.selectFirst("script[src*=\"" + attr + "\ "]");
                for (Element child : tag.children()) {
                    if (!child.tagName().equals("script")) {
                        removeEnforcedAttribute(attr, null);
                    }
                }

                tag.removeAttr(attr);

                return value;
            } catch (Exception e) {
                return null;
            }
        }
        return null;
    }

