        if (document == null || document.selectFirst("script[src*=\"" + attr + "\"]") != null) {
            try {
                Element tag = document.selectFirst("script[src*=\"" + attr + "\ "]");
                for (Element child : tag.children()) {
                    if (!child.tagName().equals("script")) {
                        addAttribute(attr, value);
