```java
public class OnlineStockSpan {

    private int[] record;
    private Stack<Integer> stack;

    public OnlineStockSpan() {
        this.record = new int[10000];
        this.stack = new Stack<>();
    }

    public int next(int price) {
        while (!stack.isEmpty()) {
            if (record[stack.peek()] <= price) {
                stack.pop();
            } else {
                break;
            }
        }
        record[stack.size()] = price;

        return stack.size();
    }

    public int[] calculateSpans(int[] prices) {
        OnlineStockSpan instance = new OnlineStockSpan();

        for (int i = 0; i < prices.length; i++) {
            if (!instance.stack.isEmpty()) {
                int span = next(prices[i]);
                if (prices[i] > prices[record.get(instance.stack.peek())]) {
                    instance.record[i + 1] = record[span];
                } else {
                    instance.record[i + 1] = i + 1;
                }
            }

            instance.record[i + 1] = i + 1;
        }

        return instance.record;
    }
}

public class Main {

    public static void main(String[] args) {
        OnlineStockSpan instance = new OnlineStockSpan();

        int[] prices1 = {10, 20, 30};
        int[] result1 = instance.calculateSpans(prices1);
        System.out.println("Result for prices1: " + java.util.Arrays.toString(result1));

        int[] prices2 = {50, 40, 70};
        int[] result2 = instance.calculateSpans(prices2);
        System.out.println("Result for prices2: " + java.util.Arrays.toString(result2));

        int[] prices3 = {100, 120, 130, 110};
        int[] result3 = instance.calculateSpans(prices3);
        System.out.println("Result for prices3: " + java.util.Arrays.toString(result3));
    }
}
