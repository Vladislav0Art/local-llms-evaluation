                }
            }
        }

        int[] result = instance.calculateSpans(prices3);

        assertEquals(expectedSpan, result.length - 1);
    }

    private static void testMaxLineCoverage(int price, int[] prices1, int expectedSpan) {
        OnlineStockSpan instance = new OnlineStockSpan();

        for (int i : prices1) {
            if (!instance.stack.isEmpty()) {
                instance.next(i);

                if (prices[i] > prices[record.get(instance.stack.peek())]) {
                    instance.record.add(record.get(instance.stack.pop()));
                } else {
                    instance.record.add(i + 1);
                }
            }
        }

        int[] result = instance.calculateSpans(prices1);

        assertEquals(expectedSpan, result.length - 1);
    }

    private static void testMinLineCoverage(int price, int[] prices3, int expectedSpan) {
        OnlineStockSpan instance = new OnlineStockSpan();

        for (int i : prices3) {
            if (!instance.stack.isEmpty()) {
                instance.next(i);

                if (prices[i] < prices[record.get(instance.stack.peek())]) {
                    instance.record.add(price);
                } else {
                    instance.record.add(i + 1);
                }
            }
        }

        int[] result = instance.calculateSpans(prices3);

        assertEquals(expectedSpan, result.length - 1);
    }
}

