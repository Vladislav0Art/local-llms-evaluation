            if (currentPosition < expression.length()) {
                // Check for arithmetic operators and add the corresponding token to the list
                int operatorPos = currentPosition;
                while (operatorPos < expression.length() && Character.isDigit(expression.charAt(operatorPos))) {
                    operatorPos++;
                }
                
                if (operatorPos >= expression.length() || expression.charAt(operatorPos) != '+') {
                    throw new ParseException("Invalid arithmetic operation: " + expression);
                }

                String tokenValue = "";
                while (currentPosition < expression.length()) {
                    if (Character.isDigit(expression.charAt(currentPosition))) {
                        tokenValue += expression.charAt(currentPosition++);
                    } else {
                        break;
                    }
                }

                tokensList.add(new BinaryOperation(tokenValue, expression.charAt(operatorPos + 1), tokens[i]));
            }
        }

        return tokensList;
    }

    private int parseType(Token token) {
        if (token instanceof IntegerLiteral || token instanceof FloatLiteral) {
            return 0; // Integer or float literal
        } else if (token instanceof Identifier) {
            return 1; // Identifier token
        } else if (token instanceof BinaryOperation) {
            String leftValue = ((BinaryOperation) token).getValue();
            String rightValue = ((BinaryOperation) token).getRightSide();
            return 2; // Binary operation (addition, subtraction, multiplication, division)
        } else {
            throw new ParseException("Invalid token: " + token);
        }
    }

    private List<String> splitExpression(String string) {
        // Use a simple tokenizer that splits at spaces
        String[] tokens = new String[string].split(" ");
        
        for (int i = 0; i < tokens.length; i++) {
            if (!configuration.isIdentify(tokens[i])) {
                // Token is not an identifier, add it to the list of literal tokens
                tokensList.add(new Literal(tokens[i]));
            }
        }

        return tokens;
    }
}

class BinaryOperation extends Token {
    private String leftValue;
    private String rightSide;

    public BinaryOperation(String leftValue, String rightSide) {
        this.leftValue = leftValue;
        this.rightSide = rightSide;
    }

    @Override
    public int getType() {
        return 2; // Binary operation (addition, subtraction, multiplication, division)
    }

    @Override
    public void print(Writer writer) throws Exception {
        writer.write(leftValue);
        writer.write(" ");
        writer.write(rightSide);
    }
}

class Literal extends Token {
    private String str;

    public Literal(String str) {
        this.str = str;
    }

    @Override
    public int getType() {
        return 0; // Literal token type (integer, float)
    }

    @Override
    public void print(Writer writer) throws Exception {
        writer.write(str);
    }
}

class Identifier extends Token {
    private String tokenName;

    public Identifier(String tokenName) {
        this.tokenName = tokenName;
    }

    @Override
    public int getType() {
        return 1; // Identifier token type (identifier)
    }

    @Override
    public void print(Writer writer) throws Exception {
        writer.write(tokenName);
    }
}

class Token {
    private String str;

    public Token(String str) {
        this.str = str;
    }

    public int getType() {
        return 0; // Token type (integer, float)
    }

    @Override
    public void print(Writer writer) throws Exception {
        writer.write(str);
    }
}
