```java
package com.ezylang.evalex.parser;

import static com.ezylang.evalex.config.ExpressionConfiguration.*;

public class Tokenizer {

    private String expressionString;
    private ExpressionConfiguration configuration;
    private int currentPosition = 0;
    
    public Tokenizer(String expressionString, ExpressionConfiguration configuration) {
        this.expressionString = expressionString;
        this.configuration = configuration;
    }

    public List<Token> parse() throws ParseException {
        return parse(expressionString, configuration);
    }

    private List<Token> parse(String expression, ExpressionConfiguration configuration) {
        // Split the expression into tokens
        String[] tokens = splitExpression(expression);

        // Initialize a list to store the parsed tokens
        List<Token> tokensList = new ArrayList<>();

        for (int i = 0; i < tokens.length; i++) {
            int type = parseType(tokens[i]);
            if (type != -1) {
                String literal = tokens[i].str;
                tokensList.add(new Literal(literal));
            } else {
                String tokenName = tokens[i].tokenName;
                if (configuration.isIdentify(tokenName)) {
                    // Token is an identifier
                    tokensList.add(new Identifier(tokenName));
                } else {
                    throw new ParseException("Unknown token: " + tokens[i]);
                }
            }

            if (currentPosition < expression.length()) {
                // Check for arithmetic operators and add the corresponding token to the list
                int operatorPos = currentPosition;
                while (operatorPos < expression.length() && Character.isLetter(expression.charAt(operatorPos))) {
                    operatorPos++;
                }
                if (operatorPos != expression.length()) {
                    String literal = new Token().str = expression.substring(currentPosition, operatorPos).trim();
                    tokensList.add(parseLiteral(literal));
                    currentPosition = operatorPos + 1;
                }
            }
        }

        return tokensList;
    }

    private int parseType(String token) throws ParseException {
        if (token.startsWith("LIT")) {
            String literal = token.substring(2);
            if (configuration.isIdentify(literal)) {
                // Token is an identifier
                return -1;
            } else {
                throw new ParseException("Invalid literal: " + literal);
            }
        } else if (token.startsWith("LT")) {
            int pos = 1;
            for (char c : token.toCharArray()) {
                if (c == 'L') {
                    pos++;
                } else {
                    break;
                }
            }
            String literal = new Token().str = token.substring(pos).trim();
            return -1; // Literal is not parsed
        } else if (token.startsWith("ADD")) {
            int pos = 1;
            for (char c : token.toCharArray()) {
                if (c == '+') {
                    pos++;
                } else {
                    break;
                }
            }
            String literal = new Token().str = token.substring(pos).trim();
            return -1; // Literal is not parsed
        } else if (token.startsWith("SUB")) {
            int pos = 1;
            for (char c : token.toCharArray()) {
                if (c == '-') {
                    pos++;
                } else {
                    break;
                }
            }
            String literal = new Token().str = token.substring(pos).trim();
            return -1; // Literal is not parsed
        } else if (token.startsWith("MUL")) {
            int pos = 1;
            for (char c : token.toCharArray()) {
                if (c == '*') {
                    pos++;
                } else {
                    break;
                }
            }
            String literal = new Token().str = token.substring(pos).trim();
            return -1; // Literal is not parsed
        } else if (token.startsWith("DIV")) {
            int pos = 1;
            for (char c : token.toCharArray()) {
                if (c == '/') {
                    pos++;
                } else {
                    break;
                }
            }
            String literal = new Token().str = token.substring(pos).trim();
            return -1; // Literal is not parsed
        } else {
            throw new ParseException("Unknown token: " + token);
        }
    }

    private List<String> splitExpression(String expression) {
        // Split the expression into tokens
        String[] tokens = tokenize(expression);

        return tokens;
    }

    private List<String> tokenize(String string) {
        // Use a simple tokenizer that splits at spaces
        String[] tokens = new String[string].split(" ");
        
        for (int i = 0; i < tokens.length; i++) {
            if (!configuration.isIdentify(tokens[i])) {
                // Token is not an identifier, add it to the list of literal tokens
                tokensList.add(new Literal(tokens[i]));
            }
        }

        return tokens;
    }
}

class Literal extends Token {
    private String str;

    public Literal(String str) {
        this.str = str;
    }

    @Override
    public int getType() {
        return 0; // Literal token type
    }

    @Override
    public void print(Writer writer) throws Exception {
        writer.write(str);
    }
}

class Identifier extends Token {
    private String tokenName;

    public Identifier(String tokenName) {
        this.tokenName = tokenName;
    }

    @Override
    public int getType() {
        return 1; // Identifier token type
    }

    @Override
    public void print(Writer writer) throws Exception {
        writer.write(tokenName);
    }
}

class Token {
    private String str;

    public Token(String str) {
        this.str = str;
    }

    public int getType() {
        return 0; // Token type (integer, identifier)
    }

    @Override
    public void print(Writer writer) throws Exception {
        writer.write(str);
    }
}
