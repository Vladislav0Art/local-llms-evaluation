public class JacksonJsonTransformerTest {

    @Test
    public void testParseJson() {
        JacksonJsonTransformer transformer = new JacksonJsonTransformer();
        String json = "{\"name\":\"John Doe\",\"age\":30}";
        Project project = JsonTransformer.parse(json, Project.class);
        assertEquals(project.getName(), "John Doe");
        assertEquals(project.getAge(), 30);

        JacksonJsonTransformer parseWithDefaultSettings = JacksonJsonTransformer.withDefaultSettings(transformer);
        Project parsedProject = parseWithDefaultSettings.parse(json, Project.class);
        assertEquals(project.getName(), "John Doe");
        assertEquals(project.getAge(), 30);
    }

    @Test
    public void testConvertString() {
        JacksonJsonTransformer transformer = new JacksonJsonTransformer();
        String json = "{\"name\":\"John Doe\",\"age\":30}";
        String convertedString = transformer.convert(json);
        assertEquals("John Doe", convertedString);

        JacksonJsonTransformer convertWithDefaultSettings = JacksonJsonTransformer.withDefaultSettings(transformer);
        String convertedString2 = convertWithDefaultSettings.convert(json);
        assertEquals("John Doe", convertedString2);
    }

    @Test
    public void testThrowExceptions() {
        JacksonJsonTransformer transformer = new JacksonJsonTransformer();
        try {
            transformer.parse("{\"name\":\"John Doe\",\"age\":30}", Project.class);
            assert false : "Expected CrowdinApiException";
        } catch (CrowdinApiException e) {}

        JacksonJsonTransformer parseWithDefaultSettings = JacksonJsonTransformer.withDefaultSettings(transformer);
        try {
            parseWithDefaultSettings.parse("{\"name\":\"John Doe\",\"age\":30}", Project.class);
            assert false : "Expected IOException";
        } catch (IOException e) {}

        JacksonJsonTransformer convertWithDefaultSettings = JacksonJsonTransformer.withDefaultSettings(transformer);
        try {
            convertWithDefaultSettings.convert("{\"name\":\"John Doe\",\"age\":30}");
            assert false : "Expected Exception in StringConverter";
        } catch (Exception e) {}
    }
}
