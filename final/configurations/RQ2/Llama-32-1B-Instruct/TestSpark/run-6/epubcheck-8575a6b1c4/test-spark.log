import java.lang.reflect.Constructor;
import java.lang.reflect.Method;

public class TestUtils {
    public static boolean isEmpty(Class<?> clazz) {
        Constructor<?> constructor = null;
        try {
            constructor = clazz.getConstructor();
        } catch (NoSuchMethodException e) {
            // If the class has no constructors, it's not an object
        }

        if (constructor == null) {
            return false;
        }

        Method method = null;
        try {
            method = constructor.newInstance().getClass().getMethod("getDeclaringClass");
        } catch (Exception e) {
            // If there is no getDeclaringClass, it's not an object
        }

        if (method == null) {
            return false;
        }

        Class<?> declaringClass = (Class<?>) method.invoke(constructor.newInstance());
        return declaringClass.isPrimitive() || (declaringClass.getName().contains("$") && !declaringClass.getSuperclass().getName().contains("$"));
    }

    public static void main(String[] args) {
        System.out.println(isEmpty(DefaultTestConfig.class));
        System.out.println(isEmpty(TestConfig.class));
        System.out.println(isEmpty(AppClass.class));
        // Add more classes as needed
    }
}

public class DefaultTestConfig {}
