public class TestUtils {
    public static boolean isPublic(Class<?> clazz) {
        return clazz.getSuperclass() == Object.class;
    }

    public static void main(String[] args) {
        System.out.println(isPublic(DefaultTestConfig.class));
        System.out.println(isPublic(TestConfig.class));
        System.out.println(isPublic(AppClass.class));
        // Add more public classes and methods as needed
    }
}

