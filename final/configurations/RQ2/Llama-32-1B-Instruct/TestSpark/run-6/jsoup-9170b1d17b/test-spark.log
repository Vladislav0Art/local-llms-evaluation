import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;

public class TestGenerator {
    public static void main(String[] args) throws Exception {
        // Example HTML content
        String html = "<html><body>Hello, World!</body></html>";

        // Generate attributes and values for the HTML element
        Document doc = Jsoup.parse(html);
        Element element = doc.getElementById("test");

        // Add attributes to the element
        String[] attributes = {"id", "class", "style"};
        for (String attribute : attributes) {
            element.attr(attribute, "value");
        }

        // Test values for attributes
        boolean firstAttribute = isAttributePresent(element, "first");
        System.out.println(firstAttribute);

        boolean secondAttribute = isAttributePresent(element, "second");
        System.out.println(secondAttribute);

        boolean thirdAttribute = isAttributePresent(element, "third");
        System.out.println(thirdAttribute);

        // Test values for non-existent attributes
        String fourthAttribute = isAttributePresent(element, "fourth");
        System.out.println(fourthAttribute);
    }

    public static void testAttributes() throws Exception {
        Document doc = Jsoup.parse("<html><body>Hello, World!</body></html>");
        Element element = doc.getElementById("test");

        // Test attributes for existing attribute
        String[] attributes = {"id", "class", "style"};
        boolean firstAttributePresent = isAttributePresent(element, "first");
        System.out.println(firstAttributePresent);

        // Test values for existing attribute
        boolean secondAttributePresent = isAttributePresent(element, "second");
        System.out.println(secondAttributePresent);

        // Test non-existent attributes
        String fourthAttributePresent = isAttributePresent(element, "fourth");
        System.out.println(fourthAttributePresent);
    }

    private static boolean isAttributePresent(Element element, String attribute) {
        try {
            return element.hasAttr(attribute);
        } catch (Exception e) {
            return false;
        }
    }
}
