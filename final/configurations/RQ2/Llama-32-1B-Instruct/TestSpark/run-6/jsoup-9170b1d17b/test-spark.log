public class TestGenerator {
    public static void main(String[] args) throws Exception {
        // Example HTML content
        String html = "<html><body>Hello, World!</body></html>";

        // Generate attributes and values for the HTML element
        Document doc = Jsoup.parse(html);
        Element element = doc.getElementById("test");

        // Add attributes to the element
        System.out.println("Attributes:");
        printAttributeValues(element, "id", "class");
        printAttributeValues(element, "style", "color: red; font-size: 20px;");
        printAttributeValues(element, "name", "username");
        printAttributeValues(element, "alt", "Image of John Doe");

        // Test values for attributes
        boolean idPresent = isAttributePresent(element, "id");
        System.out.println("ID present: " + idPresent);
        String classPresent = isAttributePresent(element, "class");
        System.out.println("Class present: " + classPresent);

        boolean stylePresent = isAttributePresent(element, "style");
        System.out.println("Style present: " + stylePresent);
        String namePresent = isAttributePresent(element, "name");
        System.out.println("Name present: " + namePresent);
        String altPresent = isAttributePresent(element, "alt");
        System.out.println("Alt present: " + altPresent);

        // Test values for non-existent attributes
        boolean idNonPresent = isAttributePresent(element, "nonexistent-id");
        System.out.println("ID not found: " + idNonPresent);
        String classNonPresent = isAttributePresent(element, "class-nonexistent");
        System.out.println("Class not found: " + classNonPresent);

        boolean styleNonPresent = isAttributePresent(element, "style-nonexistent");
        System.out.println("Style not found: " + styleNonPresent);

        // Test values for attributes with multiple values
        String[] attributes = {"id", "class"};
        for (String attribute : attributes) {
            printAttributeValues(element, attribute, "value1; value2");
        }

        // Test values for attributes without space
        String[] attributes2 = {"name", "alt"};
        for (String attribute : attributes2) {
            System.out.println(attribute + ": " + element.attr(attribute));
        }
    }

    public static void printAttributeValues(Element element, String attribute, String value) {
        try {
            System.out.println(attribute + ": " + value);
        } catch (Exception e) {
            System.out.println(e.getMessage());
        }
    }

    private static boolean isAttributePresent(Element element, String attribute) {
        try {
            return element.hasAttr(attribute);
        } catch (Exception e) {
            return false;
        }
    }
}
