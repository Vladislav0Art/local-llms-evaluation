import java.net.URI;
import java.net.URISyntaxException;

public class MyClass {
    public static String generateUrl(String url) throws URISyntaxException {
        URI uri = new URI(url);
        return "http://" + uri.getHost() + "/" + uri.getPath() + "/path";
    }

    public static boolean testGenerateUrl() throws URISyntaxException {
        try {
            System.out.println(generateUrl("https://example.com"));
            return true;
        } catch (URISyntaxException e) {
            throw new RuntimeException(e);
        }
    }
}

public class MyOtherClass {
    public static String generateKey(String key) throws URISyntaxException {
        URI uri = new URI(key);
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < uri.getPath().length(); i++) {
            if (i == 0) {
                sb.append(uri.getHost());
            } else {
                sb.append("-");
                sb.append(String.valueOf(uri.getHost()).charAt(i));
            }
        }
        return "key-" + sb.toString() + "/path";
    }

    public static boolean testGenerateKey() throws URISyntaxException {
        try {
            System.out.println(generateKey("https://example.com/123"));
            return true;
        } catch (URISyntaxException e) {
            throw new RuntimeException(e);
        }
    }
}

public class Main {

    public static void main(String[] args) {
        if (!MyClass.testGenerateUrl()) {
            throw new Exception("Test failed");
        }

        if (!MyOtherClass.testGenerateKey()) {
            throw new Exception("Test failed");
        }
    }
}
```

