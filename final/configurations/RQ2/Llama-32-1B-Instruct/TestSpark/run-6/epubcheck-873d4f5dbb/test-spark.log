        expected = "video";
        path = "/path/to/video/blessed/audio/file";

        fileExtension = OPFChecker.getPreferredFileFormat(expected, path);
        assertEquals(-1, fileExtension); // unknown

        expected = "common video";
        path = "/path/to/common/video/file";

