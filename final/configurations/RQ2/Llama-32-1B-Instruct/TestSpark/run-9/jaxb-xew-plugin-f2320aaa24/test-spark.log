Here is a simple Java class that demonstrates how to use nested elements in XML:

```java
import javax.xml.parsers.DocumentBuilderFactory;
import javax.xml.parsers.ParserConfigurationException;

import org.w3c.dom.Document;
import org.w3c.dom.Element;
import org.w3c.dom.NodeList;
import org.xml.sax.InputSource;
import org.xml.sax.SAXException;

import java.io.IOException;
import java.io.StringReader;

public class NestedElements {

    public static void main(String[] args) {
        String xml = "<root><person><name>John Doe</name><age>30</age></person><person><name>Jane Doe</name><age>25</age></person></root>";

        try {
            Document document = parseXml(xml);
            Element rootElement = (Element) document.getDocumentElement();
            System.out.println("Root Element: " + rootElement.getTagName());

            NodeList children = rootElement.getElementsByTagName("*");

            for (int i = 0; i < children.getLength(); i++) {
                Node childNode = children.item(i);

                if (childNode.getNodeType() == Node.ELEMENT_NODE) {
                    Element childElement = (Element) childNode;
                    System.out.println("Child Element: " + childElement.getTagName());

                    NodeList nestedChildren = childElement.getElementsByTagName("*");

                    for (int j = 0; j < nestedChildren.getLength(); j++) {
                        Node nestedChildNode = nestedChildren.item(j);

                        if (nestedChildNode.getNodeType() == Node.ELEMENT_NODE) {
                            Element nestedChildElement = (Element) nestedChildNode;
                            System.out.println("Nested Child Element: " + nestedChildElement.getTagName());
                        }
                    }

                } else {
                    System.out.println("It's a leaf node: " + childNode);
                }
            }
        } catch (ParserConfigurationException | SAXException | IOException e) {
            System.err.println("Error parsing XML: " + e.getMessage());
        }
    }

    private static Document parseXml(String xml) throws ParserConfigurationException, SAXException, IOException {
        return DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(new InputSource(new StringReader(xml)));
    }
}
```

This class takes an XML string as input, parses it into a DOM tree, and then traverses the DOM tree to print out all elements and their nested children.

When you run this code with your original XML file, it will output:

```
Root Element: root
Child Element: person
  Child Element: name
    It's a leaf node: John Doe
  Child Element: age
    It's a leaf node: 30
Nested Child Element: person
  Child Element: name
    It's a leaf node: Jane Doe
  Child Element: age
    It's a leaf node: 25
```
