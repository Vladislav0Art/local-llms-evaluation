import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;

/**
 * A utility class for working with URLs and HTML.
 */
public class TestUtil {

    /**
     * Returns the URL as a string, or null if an error occurs.
     *
     * @param url The URL to get the content from.
     * @return The URL as a string, or null if an error occurred.
     */
    public static String getUrl(String url) {
        try {
            // Create a Jsoup document object
            Document doc = Jsoup.connect(url).get();

            // Get the HTML of the page and return it as a string
            return doc.html();
        } catch (IOException e) {
            // If an error occurs, print an error message and return null
            System.out.println("Error: " + e.getMessage());
            return null;
        }
    }

    public static class HttpResponse {

        /**
         * The HTTP status code of the response.
         */
        private int statusCode;

        public int getStatusCode() {
            return statusCode;
        }

        @Override
        public String toString() {
            return "HttpResponse{" +
                    "statusCode=" + statusCode +
                    '}';
        }
    }

    // This is a custom HttpClient class that wraps the standard Apache HttpClient for testing purposes.
    public static class DefaultHttpClient extends org.apache.http.client.HttpClient {

        /**
         * The HTTP request to send.
         */
        private HttpGet request;

        public DefaultHttpClient() {
            // Create an instance of the default HTTP client
            this.request = new HttpGet("https://www.example.com");
        }

        @Override
        public void execute(HttpRequest request) throws IOException {
            try {
                // Send the request and get the response
                HttpResponse response = Jsoup.connect(request.getUri()).get();

                // Get the status code of the response
                this.statusCode = response.getStatusStatusCode();
            } catch (Exception e) {
                // If an error occurs, throw it
                throw new RuntimeException(e);
            }
        }

        public void close() throws IOException {
            // Close the HTTP connection if it's still open
            request.releaseConnection();
        }
    }

    // This is a custom HttpGet class that wraps the standard Apache HttpClient for testing purposes.
    public static class DefaultHttpGet extends org.apache.http.client.methods.HttpGet {

        /**
         * The URL to send the GET request to.
         */
        private String uri;

        public DefaultHttpGet(String uri) {
            this.uri = uri;
        }

        @Override
        public void execute(HttpResponse response) throws IOException {
            try {
                // Send the request and get the response
                Jsoup.connect(uri).get().html();
            } catch (IOException e) {
                throw new RuntimeException(e);
            }
        }
    }
}
```

