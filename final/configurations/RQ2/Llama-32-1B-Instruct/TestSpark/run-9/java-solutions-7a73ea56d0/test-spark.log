import org.junit.Test;
import org.mockito.Mockito;

public class OnlineStockSpanTest {

    @Test
    public void testMaximizeLineCoverage_Scenario1() {
        // Arrange
        int[] prices = {7, 6, 4, 3, 1};
        OnlineStockSpan stock = new OnlineStockSpan();
        int expectedSpans = calculateSpans(prices);

        // Act
        int actualSpans = stock.next(7);
        int actualTotalSpans = Mockito.mock(int.class);

        // Assert
        Mockito.verify(actualTotalSpans).intValueMethod("calculateSpans", Mockito.times(1));
        assert (actualSpans == expectedSpans);
    }

    @Test
    public void testMaximizeLineCoverage_Scenario2() {
        // Arrange
        int[] prices = {10, 9, 8, 7, 6, 5};
        OnlineStockSpan stock = new OnlineStockSpan();
        int expectedSpans = calculateSpans(prices);

        // Act
        int actualSpans = stock.next(10);
        Mockito.mock(int.class).intValueMethod("calculateSpans", Mockito.times(1));
        assert (actualSpans == expectedSpans);
    }

    @Test
    public void testMaximizeLineCoverage_Scenario3() {
        // Arrange
        int[] prices = {100, 200};
        OnlineStockSpan stock = new OnlineStockSpan();
        int expectedSpans = calculateSpans(prices);

        // Act
        int actualSpans = stock.next(100);
        Mockito.mock(int.class).intValueMethod("calculateSpans", Mockito.times(1));
        assert (actualSpans == 2);
    }

    @Test
    public void testMaximizeLineCoverage_Scenario4() {
        // Arrange
        int[] prices = {3, 30, 15};
        OnlineStockSpan stock = new OnlineStockSpan();
        int expectedSpans = calculateSpans(prices);

        // Act
        int actualSpans = stock.next(3);
        Mockito.mock(int.class).intValueMethod("calculateSpans", Mockito.times(1));
        assert (actualSpans == 2);
    }

    @Test
    public void testMaximizeLineCoverage_Scenario5() {
        // Arrange
        int[] prices = {4, 6};
        OnlineStockSpan stock = new OnlineStockSpan();
        int expectedSpans = calculateSpans(prices);

        // Act
        int actualSpans = stock.next(4);
        Mockito.mock(int.class).intValueMethod("calculateSpans", Mockito.times(1));
        assert (actualSpans == 2);
    }

    public int[] calculateSpans(int[] prices) {
        Stack<Integer> stack = new Stack<>();
        for (int price : prices) {
            while (!stack.isEmpty() && price > stack.peek()) {
                stack.pop();
            }
            if (!stack.isEmpty()) {
                stack.push(price);
            } else {
                stack.push(price);
            }
        }
        int totalSpans = 0;
        int[] result = new int[prices.length];
        for (int i = 0; i < prices.length; i++) {
            while (!stack.isEmpty() && stack.peek() <= prices[i]) {
                totalSpans += stack.pop();
            }
            result[i] = totalSpans + stack.size();
            stack.push(prices[i]);
        }
        return result;
    }
}
