import com.netflix.frigga.NameConstants;
import org.junit.Test;
import static org.junit.Assert.*;

public class AppVersionTest {

    @Test
    public void testParseName() {
        AppVersion appVersion = new AppVersion();
        String amiName = "ami-name";
        String parsedName = appVersion.parseName(amiName);
        assertEquals(amiName, parsedName);
    }

    @Test
    public void testGetPackageName() {
        AppVersion appVersion = new AppVersion();
        assertEquals("ami-name", appVersion.getPackageName());
    }

    @Test
    public void testGetVersion() {
        AppVersion appVersion = new AppVersion();
        String version = appVersion.getVersion();
        assertTrue(version.matches(NameConstants.AMI_VERSION_PATTERN));
        assertEquals("1.0.0", version);
    }

    @Test
    public void testGetBuildJobName() {
        AppVersion appVersion = new AppVersion();
        assertEquals("build-job-name", appVersion.getBuildJobName());
    }

    @Test
    public void testGetBuildNumber() {
        AppVersion appVersion = new AppVersion();
        String buildNumber = appVersion.getBuildNumber();
        assertTrue(buildNumber.matches(NameConstants.AMI_BUILD_NUMBER_PATTERN));
        assertEquals(123, Integer.parseInt(buildNumber));
    }

    @Test
    public void testGetCommit() {
        AppVersion appVersion = new AppVersion();
        String commit = appVersion.getCommit();
        assertTrue(commit.matches(NameConstants.AMI_COMMIT_PATTERN));
        assertEquals("commit", commit);
    }

    @Test
    public void testGetChangelist() {
        // No implementation as this method is deprecated
    }

    @Test
    public void testToString() {
        AppVersion appVersion = new AppVersion();
        String expectedString = "ami-name";
        assertEquals(expectedString, appVersion.toString());
    }
}
