package org.jsoup.nodes;

import org.jsoup.parser.ParseSettings;
import java.io.IOException;
import java.util.AbstractMap;
import java.util.AbstractSet;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.Collections;
import java.util Iterator;
import java.util.List;
import java.util.Map;
import java.util.Set;
import static org.jsoup.internal.Normalizer.lowerCase;

public class Attributes implements Iterable<Attribute> {
    private final Map<String, Object> attributesMap = new HashMap<>();

    @Override
    public boolean add(Attribute attribute) {
        for (Attribute a : this) {
            if (!a.equals(attribute)) {
                throw new RuntimeException("Attribute name must be unique");
            }
        }
        attributesMap.put(attribute.getKey(), attribute.getValue());
        return true;
    }

    @Override
    public boolean remove(String key) {
        if (this.attributesMap.containsKey(key)) {
            this.attributesMap.remove(key);
        }
        return false;
    }

    @Override
    public Iterator<Attribute> iterator() {
        return new AttributeIterator(this);
    }

    public static void main(String[] args) {
        Attributes attributes = new Attributes();

        attributes.append("name", "John Doe");
        attributes.append("age", 30);
        attributes.append("city", "New York");

        System.out.println(attributes);

        attributes.remove("age");

        System.out.println(attributes);

        attributes.clear();

        System.out.println(attributes);

        Set<String> keys = attributes.keys();
        System.out.println(keys);
    }

    private static class AttributeIterator implements Iterator<Attribute> {
        final Attributes attrs;

        public AttributeIterator(Attributes attrs) {
            this.attrs = attrs;
        }

        @Override
        public boolean hasNext() {
            return true; // All attributes are added
        }

        @Override
        public Attribute next() {
            if (this.hasNext()) {
                return this.attrs.attributesMap.get(new StringBuilder().append(key).append("="));
            } else {
                throw new NoSuchElementException();
            }
        }
    }

    private static class Attribute implements Cloneable {
        String key;
        Object value;

        public Attribute(String key, Object value) {
            this.key = key;
            this.value = value;
        }

        @Override
        public boolean equals(Object obj) {
            if (this == obj) {
                return true;
            }
            if (obj == null || getClass() != obj.getClass()) {
                return false;
            }
            Attribute attribute = (Attribute) obj;
            return Objects.equals(key, attribute.key);
        }

        @Override
        public int hashCode() {
            final int prime = 31;
            int result = 1;
            result = prime * result + ((key == null) ? 0 : key.hashCode());
            result = prime * result + (value != null ? value.hashCode() : 0);
            return result;
        }

        @Override
        public String toString() {
            return "Attribute{" +
                    "key='" + key + '\'' +
                    ", value=" + value +
                    '}';
        }
    }
}
