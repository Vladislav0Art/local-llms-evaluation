        // However, we can use the Date class to get the weekday
        return java.util.Calendar.getInstance().getTimeInMillis() % 7 + "D";
    }

    public static void testSolarPositioning() {
        LocalDate forDate = forDate();
        assertNotEquals(0.0, 1.0);
        assertNotEquals(36000.0, 90.0);
        DeltaTDeltaT deltaT = deltaT();
        assertNotEquals(0.0, 1000.0);
    }

    public static class DeltaT {
        private int i;
        private double j;

        public DeltaT() {
            this.i = 0;
            this.j = 1;
        }

        public void increment() {
            i++;
        }

        public double getJ() {
            return j;
        }
    }
}

