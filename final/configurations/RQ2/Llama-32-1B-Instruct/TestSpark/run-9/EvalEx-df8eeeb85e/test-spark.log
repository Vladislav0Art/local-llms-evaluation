    public ExpressionConfiguration configure() {
        // Mock expression configuration
        return new ExpressionConfiguration();
    }

    @Test
    public void [Tokenizer]__parseStringLiteral_SimpleScenarioTest() throws ParseException {
        String expression = "1 + 2";
        ExpressionConfiguration config = configure();

        List<Token> tokens = tokenizer.parse(config);
        assertEquals(4, tokens.size());
        assertHasElements(tokens, new String[] {"INT", "INT", "ADD", "INT"});
    }

    @Test
    public void [Tokenizer]__parseStringLiteral_DifferentOperatorsTest() throws ParseException {
        String expression = "1 + 2";
        ExpressionConfiguration config = configure();

        List<Token> tokens = tokenizer.parse(config);
        assertEquals(4, tokens.size());
        assertHasElements(tokens, new String[] {"INT", "INT", "ADD", "INT"});
    }

    @Test
    public void [Tokenizer]__parseStringLiteral_NoNumberTokenTest() throws ParseException {
        String expression = "  +";
        ExpressionConfiguration config = configure();

        List<Token> tokens = tokenizer.parse(config);
        assertEquals(3, tokens.size());
        assertHasElements(tokens, new String[] {"SPACE", "INT", "ADD"});
    }

    @Test
    public void [Tokenizer]__parseStringLiteral_NoParenthesisTest() throws ParseException {
        String expression = "+ 2";
        ExpressionConfiguration config = configure();

        List<Token> tokens = tokenizer.parse(config);
        assertEquals(1, tokens.size());
        assertHasElements(tokens, new String[] {"INT", "ADD"});
    }

