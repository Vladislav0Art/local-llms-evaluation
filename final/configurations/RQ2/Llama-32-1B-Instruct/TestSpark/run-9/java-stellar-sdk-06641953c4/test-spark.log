public class SignatureGeneratorTest {

    @Test
    public void testGenerateSignature() {
        ByteArrayOutputStream bos = new ByteArrayOutputStream();
        byte[] data = "Hello, World!".getBytes();
        byte[] payload = bos.toByteArray();

        SignatureKey signerKey = sign(payload);
        SignerKey xdrSignerKey = xdrSigner(signerKey);

        String signature = getSignature(xdrSignerKey);
        System.out.println("Generated signature: " + signature);

        PublicKey publicKey = new PublicKey("public-key");
        DecoratedSignature decoratedSignature = getDecoratedSignature(publicKey, signature);

        Preconditions.assertEquals(decoratedSignature, getDecoratedSignature(bos.toByteArray(), signature));
    }

    public SignerKey xdrSigner(SignatureKey key) throws IOException {
        ByteArrayOutputStream bos = new ByteArrayOutputStream();
        byte[] payload = key.getEncoded();
        byte[] data = "Hello, World!".getBytes();

        bos.write(payload);
        bos.write(data);

        return xdrSigner(bos.toByteArray());
    }

    public DecoratedSignature getDecoratedSignature(byte[] data, String signature) throws IOException {
        ByteArrayOutputStream bos = new ByteArrayOutputStream();
        byte[] payload = signature.getBytes();

        bos.write(data);
        bos.write(payload);

        return getDecodedSignature(bos.toByteArray(), signature);
    }

    public SignatureKey sign(byte[] payload) throws IOException {
        // implementation of SignerKey generation
        return new SignatureKey();
    }

    public byte[] xdrSigner(SignatureKey key) throws IOException {
        ByteArrayOutputStream bos = new ByteArrayOutputStream();
        byte[] encoded = key.getEncoded();

        bos.write(encoded);

        return bos.toByteArray();
    }

    public DecoratedSignature getDecodedSignature(byte[] data, String signature) throws IOException {
        // implementation of DecoratedSignature decoding
        return new DecoratedSignature();
    }
}
