            const value = token.value ? JSON.stringify(token.value) : 'undefined';
            if (type === 'listType1' || type === 'type1') {
                str += `${type} [${str}]`;
            } else {
                str += `${type} value=${value}`;
            }
        }
        return str;
    }

    public addToken(value?: any): void {
        this.push(new Token('listType1', value));
    }
}

