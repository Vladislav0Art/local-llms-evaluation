import org.junit.jupiter.api.Test;
import org.jsoup.nodes.TextNode;
import static org.mockito.Mockito.when;

public class TextNodeTest {

    @Test
    public void nodeName TestsTextNodenodeName() {
        TextNode node = new TextNode("Hello, World!");
        when(node.nodeName()).thenReturn("text");
        assertEquals("text", node.nodeName());
    }

    @Test
    public void textTestsTextNode_text() {
        TextNode node = new TextNode("Hello, World!");
        when(node.text()).thenReturn("Hello, World!");
        assertEquals("Hello, World!", node.text());
    }

    @Test
    public void textTestsTextNode_text() {
        TextNode node = new TextNode("");
        when(node.text()).thenReturn("");
        assertEquals("", node.text());
    }

    @Test
    public void getWholeTextTestsTextNode_getWholeText() {
        TextNode node = new TextNode("Hello, World!");
        when(node.getWholeText()).thenReturn("Hello, World!");
        assertEquals("Hello, World!", node.getWholeText());
    }

    @Test
    public void isBlankTestsTextNode_isBlank() {
        TextNode node = new TextNode("");
        when(node.isBlank()).thenReturn(true);
        assertTrue(node.isBlank());
    }

    @Test
    public void splitTextTestsTextNode_splitText() {
        TextNode node = new TextNode("Hello, World!");
        when(node.splitText(0)).thenReturn(new TextNode(""));
        assertEquals(new TextNode(""), node.splitText(0));
    }

    @Test
    public void outerHtmlHeadTestsTextNode_outerHtmlHead() {
        when(node.outerHtmlHead(any(Appendable.class), any(int.class), any(Document.OutputSettings.class))).thenReturn("Hello, World!");
        assertEquals("Hello, World!", node.outerHtmlHead(any(Appendable.class), any(int.class), any(Document.OutputSettings.class)));
    }

    @Test
    public void outerHtmlTailTestsTextNode_outerHtmlTail() {
        when(node.outerHtmlTail(any(Appendable.class), any(int.class), any(Document.OutputSettings.class))).thenReturn("Hello, World!");
        assertEquals("Hello, World!", node.outerHtmlTail(any(Appendable.class), any(int.class), any(Document.OutputSettings.class)));
    }

    @Test
    public void toStringTestsTextNodeToString() {
        TextNode node = new TextNode("Hello, World!");
        when(node.toString()).thenReturn("Hello, World!");
        assertEquals("Hello, World!", node.toString());
    }
}
