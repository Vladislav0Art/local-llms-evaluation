    public static String parseSingleArgInputUrl(String inputURL) throws URISyntaxException {
        if (inputURL == null || inputURL.isEmpty()) {
            throw new URISyntaxException("Invalid URL", "Input URL cannot be null or empty.");
        }
        File file = new File(inputURL);
        return URLParser.urlBuilder.buildFileToURIs(file);
    }

    public static String parseSingleArgInputUrls(String[] urls) throws URISyntaxException {
        StringBuilder builder = new StringBuilder();
        for (String url : urls) {
            try {
                URI uri = new URI(url);
                if (!uri.isAbsolute()) {
                    builder.append("file://").append(uri.getScheme()).append("://").append(uri.getHost());
                } else {
                    builder.append("https://").append(uri.getHost()).append(uri.getPath());
                }
            } catch (URISyntaxException e) {
                System.out.println(e.getMessage());
            }
        }
        return builder.toString();
    }

    public static String buildFileToURIs(File file) throws URISyntaxException {
        URI uri = new URI(file.toURI().toString());
        return "file://" + uri.getScheme() + ":///" + uri.getHost() + "/" + uri.getPath();
    }
}

