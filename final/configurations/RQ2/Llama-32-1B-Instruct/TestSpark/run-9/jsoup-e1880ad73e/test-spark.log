import java.io.File;
import java.net.URI;

public class URLParser {

    public static void main(String[] args) throws URISyntaxException {
        // Test 1: Handling single input URL
        String url = "https://example.com";
        System.out.println(urlBuilder.parseSingleArgInputUrl(url));

        // Test 2: Handling multiple input URLs
        String[] urls = {"https://example1.com", "https://example2.com"};
        for (String url : urls) {
            try {
                System.out.println(urlBuilder.parseSingleArgInputUrls(url));
            } catch (URISyntaxException e) {
                System.out.println(e.getMessage());
            }
        }

        // Test 3: Handling invalid URLs
        try {
            urlBuilder.parseInvalidUrl("https://example.com");
        } catch (URISyntaxException e) {
            System.out.println(e.getMessage());
        }

        // Test 4: Handling valid URLs with relative paths
        URI uri = new URI("https://example.com/path/to/resource");
        System.out.println("URI: " + uri);

        // Test 5: Handling valid URLs with absolute paths
        String absPath = "/path/to/resource";
        URI absUri = new URI(absPath);
        System.out.println("Absolute URI: " + absUri);

    }

    public static String parseSingleArgInputUrl(String inputURL) throws URISyntaxException {
        File file = new File(inputURL);
        return urlBuilder.buildFileToURIs(file);
    }

    public static String parseSingleArgInputUrls(String[] urls) throws URISyntaxException {
        StringBuilder builder = new StringBuilder();
        for (String url : urls) {
            try {
                URI uri = new URI(url);
                if (!uri.isAbsolute()) {
                    builder.append("file://").append(uri.getScheme()).append("://").append(uri.getHost());
                } else {
                    builder.append("https://").append(uri.getHost()).append(uri.getPath());
                }
            } catch (URISyntaxException e) {
                System.out.println(e.getMessage());
            }
        }
        return builder.toString();
    }

    public static String buildFileToURIs(File file) throws URISyntaxException {
        URI uri = new URI(file.toURI().toString());
        return "file://" + uri.getScheme() + ":///" + uri.getHost() + "/" + uri.getPath();
    }

    public static void main1(String[] args) throws URISyntaxException {
        // Test 6: Handling relative paths
        String relPath = "../path/to/resource";
        URI uri = new URI("https://example.com/path/to/parent/dir/" + relPath);
        System.out.println("Relative URI: " + uri);

        // Test 7: Handling absolute paths
        absPath = "/absolute/path";
        URI absUri = new URI(absPath);
        System.out.println("Absolute URI (with scheme and netloc): " + absUri);
    }
}

