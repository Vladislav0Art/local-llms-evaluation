import com.google.common.reflect.TypeToken;
import graphql.GraphQLArgument;
import graphql.GraphQLDirective;
import graphql.GraphQLFieldDefinition;
import graphql.GraphQLType;
import graphql.schema.GraphQLElement;

public class GeneratedTest {

    public static GraphQLElement directivesBuilder(DirectivesBuilder builder, TypeToken<Object> directiveType) {
        return (GraphQLElement) builder.build(directiveType);
    }

    public static GraphQLArgument getArgument(GraphQLElement element) {
        if (element instanceof GraphQLArgument) {
            return (GraphQLArgument) element;
        } else if (element instanceof GraphQLFieldDefinition) {
            return (GraphQLArgument) ((GraphQLFieldDefinition<?>) element).getArguments().get(0);
        } else if (element instanceof GraphQLDirective) {
            return (GraphQLArgument) ((GraphQLDirective<?>) element).argument();
        }
        throw new RuntimeException("Unsupported element type");
    }

    public static void main(String[] args) {
        TestDirectivesUtil testDirectives = new TestDirectivesUtil();

        GraphQLType directivesType = GraphQLArgument.directive();
        GraphQLElement directives = directivesBuilder(testDirectives, directivesType);

        // Assuming DirectivesBuilder has an addField method
        testDirectives.addField(directives);

        GraphQLType argumentType = GraphQLArgument.directive().argument();
        GraphQLElement arg = getArgument(argumentType);
        System.out.println(arg.toString());
    }
}

class TestDirectivesUtil {
    public void addField(GraphQLElement field) {}

    public List<GraphQLDirective> directives() {
        return new ArrayList<>();
    }

    public TypeToken<Object> type1() {
        return GraphQLTypeGraphQL Directive1.class;
    }

    public TypeToken<Object> type2() {
        return GraphQLTypeGraphQL Directive2.class;
    }
}
