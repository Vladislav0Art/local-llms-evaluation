public class Tag {

    private final String name;
    private boolean isBlock;

    public Tag(String name) {
        this.name = Normalizer.normalize(name, Normalizer.NFD);
        this.isBlock = false;
        for (int i = 0; i < name.length(); i++) {
            char c = name.charAt(i);
            if ((c == '-' && i + 1 >= name.length() || !Character.isLetterOrDigit(c)) || (c == '_' && i + 1 >= name.length()) || c == ' ') {
                isBlock = true;
                break;
            }
        }
    }

    public String getName() {
        return name;
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (!(o instanceof Tag)) return false;

        Tag tag = (Tag) o;

        if (!isBlock && !tag.isBlock()) return false;
        if (!name.equals(tag.name)) return false;

        return isInline();
    }

    @Override
    public int hashCode() {
        int result = 0; result = result * 31 + (isBlock ? 1 : 0) + (isInline() ? 17 : 0);
        result = 31 * result + name.hashCode();

        return result;
    }

    private boolean isInline() {
        // TO DO: implement this
        throw new UnsupportedOperationException();
    }

    @Override
    public String toString() {
        if (name.isEmpty()) return "inline";

        StringBuilder builder = new StringBuilder();
        if (!isBlock) {
            builder.append("<").append(name).append(">");
        } else {
            builder.append("&lt;").append(name).append(">");
        }
        if (isInline()) builder.append("/&gt;");
        return builder.toString();
    }

    public void setSelfClosing() {
        this.isBlock = false;
        this.isInline = true;
    }

    public static Tag valueOf(String tagName, ParseSettings settings) {
        return ParseSettings.parseTag(tagName, settings);
    }
}

