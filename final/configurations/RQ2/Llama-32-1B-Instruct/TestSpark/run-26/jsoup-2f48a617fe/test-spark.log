        // Check if the html tail tag is present in the parsed HTML
        System.out.println("The <html> or <head> tags are present in the HTML.");
        assertTrue(htmlTail != null && !htmlTail.isEmpty());

        // Get the expected string from a parse result of Comment class
        String expected = "Comment.html";
        // Check if the html tail matches with the expected string
        assertTrue(htmlTail.equals(expected));
    }

    public static void testOuterHtmlHead() throws Exception {
        // Create a Jsoup Document object from the HTML string
        Document doc = Jsoup.parse("<html><head></head><body>Hello World!</body></html>");

        // Get the outerHtmlHead from the parse result
        String htmlHead = doc.outerHtmlHead();

        // Check if the html head tag is present in the parsed HTML
