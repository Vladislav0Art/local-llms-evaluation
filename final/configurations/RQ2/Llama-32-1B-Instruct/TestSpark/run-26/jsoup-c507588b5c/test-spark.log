    public static int stripLeadingWhitespace(String input) {
        if (input.isEmpty()) {
            return 0;
        }
        while (!input.startsWith(" ")) {
            input = input.substring(1);
        }
        return input.length();
    }

    public static boolean lastCharIsWhitespace(StringBuilder sb) {
        return sb.length() > 0 && sb.charAt(sb.length() - 1) == ' ';
