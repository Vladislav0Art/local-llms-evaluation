        assertEquals(0, result); // Should be 0
    }

    @Test
    public void testLastCharIsWhitespacePublicMethod() {
        StringBuilder sb = new StringBuilder("   ");
        boolean expectedOutput = true;
        assertTrue(TestUtils.lastCharIsWhitespace(sb));
    }
