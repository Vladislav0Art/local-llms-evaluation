```java
import java.security.KeyFactory;
import java.security.PublicKey;
import java.security.PrivateKey;
import java.security.spec.PKCS8EncodedKeySpec;
import java.security.spec.X509EncodedKeySpec;

public class TestUtil {
    private static SecretKey secretKey;
    private static SecretKey secretSeed;

    public static SecretKey generateSecretKey() throws Exception {
        // Generate a new secret key
        byte[] data = new byte[32];
        new SecureRandom().nextBytes(data);
        secretSeed = new SecretKeySpec(data, "SHA-256");
        return generateSecretKeyFromSeed(secretSeed);
    }

    public static PrivateKey generatePrivateKey() throws Exception {
        return generatePrivate(secretKey);
    }

    private static SecretKey generateSecretKeyFromSeed(SecretKey seed) throws Exception {
        byte[] data = new byte[32];
        new SecureRandom().nextBytes(data);
        return generateKeyFromSeed(data, "SHA-256");
    }

    public static PublicKey generatePublicKey() throws Exception {
        return generatePublicKey(secretKey);
    }

    private static PrivateKey generatePrivate(SecretKey key) throws Exception {
        // Generate a private key from the secret key
        byte[] data = new byte[32];
        new SecureRandom().nextBytes(data);
        return KeyFactory.getInstance("RSA").generatePrivate(new PKCS8EncodedKeySpec(key.getEncoded()));
    }

    public static PublicKey generatePublicKey(PrivateKey privateKey) throws Exception {
        // Generate a public key from the private key
        byte[] data = new byte[32];
        new SecureRandom().nextBytes(data);
        return KeyFactory.getInstance("RSA").generatePublic(new X509EncodedKeySpec(privateKey.getEncoded()));
    }

    private static Key generateKeyFromSeed(byte[] seed, String algorithm) throws Exception {
        // Generate a key from the seed
        if (algorithm.equals("SHA-256")) {
            return new SecretKey(seed);
        } else if (algorithm.equals("RSA")) {
            return new PrivateKey(new PKCS8EncodedKeySpec(seed));
        }
        throw new Exception("Unsupported algorithm: " + algorithm);
    }

    private static Key generatePrivate(byte[] seed) throws Exception {
        // Generate a private key from the seed
        // This is a simple implementation that just returns the seed as is.
        return new SecretKey(seed);
    }
}
```

