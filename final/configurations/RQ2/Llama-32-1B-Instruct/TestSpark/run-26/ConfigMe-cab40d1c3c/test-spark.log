package ch.jalu.configme.configurationdata;

import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

public class PropertyListBuilderTest {

    private PropertyListBuilder builder;
    private List<Property> properties;

    @BeforeEach
    public void setup() {
        builder = new PropertyListBuilder();
        properties = new ArrayList<>();
    }

    @Test
    public void testAddProperty(@NotNull Property property) {
        properties.add(property);
        assertEquals(1, properties.size());
    }

    @Test
    public void testCreate() {
        assertTrue(builder.create().isEmpty());
        builder.add(new Property("prop1", "value1"));
        assertTrue(builder.create().size() == 1);
    }

    @Test
    public void testGetRootEntries() {
        assertEquals(null, builder.getRootEntries());
        builder.add(new Property("prop1", "value1"));
        assertEquals(new LinkedHashMap<>(), builder.getRootEntries());
    }

    @Test
    public void testCreateMultipleProperties() {
        assertTrue(builder.create().isEmpty());
        builder.add(new Property("prop1", "value1"));
        builder.add(new Property("prop2", "value2"));
        assertTrue(builder.create().size() == 1);
    }

    @Test
    public void testGetRootEntriesWithExistingProperty() {
        assertEquals(null, builder.getRootEntries());
        builder.add(new Property("existingProp", "existingValue"));
        assertEquals(new LinkedHashMap<>(), builder.getRootEntries());
    }
}
