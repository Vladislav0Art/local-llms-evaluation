import org.junit.Test;

public class TokenizerTest {

    @Test
    public void testGetToken() {
        String input = "1 + 2";
        assertEquals("Number", Tokenizer.tokenize(input)[0]);
        assertEquals("+", Tokenizer.tokenize(input)[1]);
        assertEquals("Number", Tokenizer.tokenize(input)[2]);
        assertEquals(3, Tokenizer.tokenize(input)[3].getLength());
    }

    @Test
    public void testGetTokenWithNoOperation() {
        String input = "";
        assertEquals("", input);
    }

    @Test
    public void testGetNextToken() {
        String input = "1 + 2";
        String[] output = Tokenizer.tokenize(input).length();
        assertEquals(4, output[0]);
    }

    @Test
    public void testGetLengthOfToken() {
        String input = "1 + 2";
        int[] output = Tokenizer.tokenize(input)[0].length();
        assertEquals(5, output[0]);
    }

    @Test
    public void testGetNextTokenWithEmptyInput() {
        String input = "";
        try {
            Tokenizer.nextToken(input);
        } catch (Exception e) {
            // expected behavior
        }
    }

    @Test
    public void testGetLengthOfNumber() {
        String input = "1 + 2";
        int[] output = Tokenizer.tokenize(input)[1].length();
        assertEquals(5, output[0]);
    }

    @Test
    public void testGetTokenWithMultipleNumbers() {
        String input = "1 + 2 + 3";
        assertEquals("Number, +, Number, 1, Number, 2, Number, 3", Tokenizer.tokenize(input));
    }
}
