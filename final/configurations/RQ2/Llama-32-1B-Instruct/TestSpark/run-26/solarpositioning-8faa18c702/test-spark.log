public class Calculator {
    private int result;

    public int add(int num1, int num2) {
        this.result = num1 + num2;
        return this.result;
    }

    public String subtract(int num1, int num2) throws Exception {
        if (num2 > num1) {
            throw new Exception("Number with second argument cannot be greater than the first");
        }
        this.result = num1 - num2;
        return Integer.toString(this.result);
    }

    public String multiply(int num1, int num2) {
        this.result = num1 * num2;
        return Integer.toString(this.result);
    }

    public String divide(int num1, int num2) throws Exception {
        if (num2 == 0) {
            throw new Exception("Cannot divide by zero");
        }
        this.result = num1 / num2;
        return Integer.toString(this.result);
    }

    public static void main(String[] args) throws Exception {
        Calculator calculator = new Calculator();

        System.out.println(calculator.subtract(5, 3)); // Expected: 2
        System.out.println(calculator.divide(10, 2)); // Expected: 5

        try {
            System.out.println(calculator.divide(10, 0)); // Expected: Cannot divide by zero
        } catch (Exception e) {
            System.out.println(e.getMessage()); // Expected: Cannot divide by zero
        }
    }
}
```

