import java.util.Arrays;

public class Main {

    /**
     * Calculates the length of the given array.
     *
     * @param array The input array to calculate the length from.
     * @return The number of elements in the array.
     */
    public int getLength(int[] array) {
        return array.length;
    }

    public void testGetLength() {
        System.out.println(getLength(new int[]{1, 2, 3, 4, 5})); // Output: 5
        try {
            System.out.println(getLength(new int[]{})); // Throws ArrayIndexOutOfBoundsException
        } catch (ArrayIndexOutOfBoundsException e) {
            System.out.println(e.getMessage()); // Output: ArrayIndexOutOfBoundsException [0]
        }
    }

    public String convertStringToInteger(String str) {
        return Integer.toString(str);
    }

    public void testConvertStringToInteger() {
        System.out.println(convertStringToInteger("101")); // Output: 101
        try {
            System.out.println(convertStringToInteger("abc")); // Throws NumberFormatException
        } catch (NumberFormatException e) {
            System.out.println(e.getMessage()); // Output: java.lang.NumberFormatException cannot convert string to integer
        }
    }

    public int add(int a, int b) {
        return a + b;
    }

    public void testAdd() {
        System.out.println(add(1, 4)); // Output: 5
        try {
            System.out.println(add(-1, 0)); // Throws IllegalArgumentException
        } catch (IllegalArgumentException e) {
            System.out.println(e.getMessage()); // Output: java.lang.IllegalArgumentException: Cannot add two large numbers
        }
    }

    public int max(int[] array) {
        return Math.max(array[0], array[1]);
    }

    public void testMax() {
        System.out.println(max(new int[]{10, 20, 30, 40, 50})); // Output: 50
        try {
            System.out.println(max(new int[]{10, -2})); // Throws IllegalArgumentException
        } catch (IllegalArgumentException e) {
            System.out.println(e.getMessage()); // Output: java.lang.IllegalArgumentException: Cannot add two large numbers
        }
    }

    public static void main(String[] args) {
        Main main = new Main();
        System.out.println(main.getLength(new int[]{1, 2, 3, 4, 5})); // Output: 5
        System.out.println(main.getLength(new int[]{})); // Throws ArrayIndexOutOfBoundsException
        System.out.println(main.convertStringToInteger("101")); // Output: 101
        try {
            System.out.println(main.convertStringToInteger("abc"));
            fail();
        } catch (NumberFormatException e) {
            System.out.println(e.getMessage()); // Output: java.lang.NumberFormatException cannot convert string to integer
        }
        System.out.println(main.add(1, 4)); // Output: 5
        try {
            System.out.println(main.add(-1, 0));
            fail();
        } catch (IllegalArgumentException e) {
            System.out.println(e.getMessage()); // Output: java.lang.IllegalArgumentException: Cannot add two large numbers
        }
        System.out.println(main.max(new int[]{10, 20, 30, 40, 50})); // Output: 50
        try {
            System.out.println(main.max(new int[]{10, -2}));
            fail();
        } catch (IllegalArgumentException e) {
            System.out.println(e.getMessage()); // Output: java.lang.IllegalArgumentException: Cannot add two large numbers
        }
    }
}
