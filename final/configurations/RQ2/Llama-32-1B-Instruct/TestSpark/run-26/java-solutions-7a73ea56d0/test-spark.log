import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertThrows;

public class Main {

    public int calculateLength(int[] array) {
        return array.length;
    }

    public void testCalculateLength() {
        assertEquals(5, calculateLength(new int[]{1, 2, 3, 4, 5}));
        assertThrows(IndexOutOfBoundsException.class, () -> calculateLength(new int[]{1, 2}));
    }

    public String convertStringToInteger(String str) {
        return Integer.toString(str);
    }

    public void testConvertStringToInteger() {
        assertEquals("101", convertStringToInteger("101"));
        try {
            convertStringToInteger("abc");
            fail();
        } catch (Exception e) {
            assertThrows(NumberFormatException.class, () -> convertStringToInteger("abc"));
        }
    }

    public int add(int a, int b) {
        return a + b;
    }

    public void testAdd() {
        assertEquals(5, add(1, 4));
        try {
            add(-1, 0);
            fail();
        } catch (Exception e) {
            assertThrows(NumberFormatException.class, () -> add(-1, 0));
        }
    }

    public int max(int[] array) {
        return Math.max(array[0], array[1]);
    }

    public void testMax() {
        assertEquals(5, max(new int[]{10, 20, 30, 40, 50}));
        try {
            max(new int[]{10, -2});
            fail();
        } catch (Exception e) {
            assertThrows(NumberFormatException.class, () -> max(new int[]{10, -2}));
        }
    }

    public static void main(String[] args) {
        Main main = new Main();
        System.out.println(main.calculateLength(new int[]{1, 2, 3, 4, 5})); // Output: 5
        System.out.println(main.calculateLength(new int[]{})); // Throws IndexOutOfBoundsException
        System.out.println(main.convertStringToInteger("101")); // Output: 101
        try {
            main.convertStringToInteger("abc");
            fail();
        } catch (Exception e) {
            assertThrows(NumberFormatException.class, () -> main.convertStringToInteger("abc"));
        }
        System.out.println(main.add(1, 4)); // Output: 5
        try {
            main.add(-1, 0);
            fail();
        } catch (Exception e) {
            assertThrows(NumberFormatException.class, () -> main.add(-1, 0));
        }
        System.out.println(main.max(new int[]{10, 20, 30, 40, 50})); // Output: 50
        try {
            main.max(new int[]{10, -2});
            fail();
        } catch (Exception e) {
            assertThrows(NumberFormatException.class, () -> main.max(new int[]{10, -2}));
        }
    }
}
