import org.junit.jupiter.api.Test;
import org.jsoup.helper.Validate;
import org.jsoup.nodes.Attribute;
import org.jsoup.nodes.Attributes;
import org.jsoup.nodes.Element;
import java.util.HashMap;
import java.util.HashSet;
import java.util.Iterator;
import java.util.Map;
import java.util.Set;
import static org.jsoup.internal.Normalizer.lowerCase;

public class SafelistTest {

    @Test
    public void simpleText_SafeList() {
        Safelist list = Safelist.simpleText();
        Assert.assertTrue(list.isSafeTag("a"));
        Assert.assertFalse(list.isSafeTag("p"));
        Assert.assertFalse(list.isSafeTag(""));
    }

    @Test
    public void basic_Safelist() {
        Safelist list = Safelist.basic();
        Assert.assertTrue(list.isSafeTag("img"));
        Assert.assertFalse(list.isSafeTag(""));
    }

    @Test
    public void relaxed_Safelist() {
        Safelist list = Safelist.relaxed();
        Assert.assertTrue(list.isSafeTag("a"));
        Assert.assertTrue(list.isSafeTag("<p>");
        Assert.assertFalse(list.isSafeTag(""));
    }

    @Test
    public void basicWithImages_Safelist() {
        Safelist list = Safelist.basicWithImages();
        Assert.assertTrue(list.isSafeTag("img"));
        Assert.assertTrue(list.isSafeTag("<img"));
        Assert.assertFalse(list.isSafeTag(""));
    }

    @Test
    public void addTags_Safelist() {
        Safelist list = Safelist.none();
        list.addTags("a", "b");
        Assert.assertTrue(list.isSafeTag("a"));
        Assert.assertFalse(list.isSafeTag("c"));
        Assert.assertTrue(list.isSafeTag("<p>");
    }

    @Test
    public void removeTags_Safelist() {
        Safelist list = Safelist.none();
        list.removeTags("a");
        Assert.assertFalse(list.isSafeTag("a"));
        Assert.assertTrue(list.isSafeTag("<p>");
    }

    @Test
    public void addAttributes_Safelist() {
        Safelist list = Safelist.none();
        List<String> tags = new ArrayList<>();
        tags.add("a", "href=\"https://example.com\"");
        list.addAttributes(tags);
        Assert.assertFalse(list.isSafeAttribute("a"));
        Assert.assertTrue(list.isSafeAttribute("href=\"https://example.com\""));
    }

    @Test
    public void removeAttributes_Safelist() {
        Safelist list = Safelist.none();
        List<String> tags = new ArrayList<>();
        tags.add("a", "href=\"https://example.com\"");
        list.removeAttributes(tags);
        Assert.assertFalse(list.isSafeAttribute("a"));
        Assert.assertTrue(list.isSafeAttribute("href=\"https://example.com\""));
    }

    @Test
    public void addEnforcedAttribute_Safelist() {
        Safelist list = Safelist.none();
        List<String> tags = new ArrayList<>();
        tags.add("img", "alt=\"Image\"");
        list.addEnforcedAttribute(tags);
        Assert.assertFalse(list.isSafeTag("p"));
        Assert.assertTrue(list.isSafeTag("<img"));
    }

    @Test
    public void removeEnforcedAttribute_Safelist() {
        Safelist list = Safelist.none();
        List<String> tags = new ArrayList<>();
        tags.add("a", "href=\"https://example.com\"");
        list.removeEnforcedAttribute(tags);
        Assert.assertFalse(list.isSafeTag("p"));
        Assert.assertTrue(list.isSafeTag("<img"));
    }

    @Test
    public void preserveRelativeLinks_Safelist() {
        Safelist list = Safelist.preserveRelativeLinks(true);
        Assert.assertTrue(list.isSafeTag("a", "href=\"https://example.com\"");
        Assert.assertFalse(list.isSafeTag("p", "href=\"https://example.com\""));
    }

    @Test
    public void addProtocols_Safelist() {
        Safelist list = Safelist.none();
        List<String> tags = new ArrayList<>();
        tags.add("a", "href=\"https://example.com\"", "rel=\"stylesheet\"");
        list.addProtocols(tags);
        Assert.assertFalse(list.isSafeTag("p"));
    }

    @Test
    public void removeProtocols_Safelist() {
        Safelist list = Safelist.none();
        List<String> tags = new ArrayList<>();
        tags.add("a", "href=\"https://example.com\"", "rel=\"stylesheet\"");
        list.removeProtocols(tags);
        Assert.assertFalse(list.isSafeTag("p"));
    }
}
