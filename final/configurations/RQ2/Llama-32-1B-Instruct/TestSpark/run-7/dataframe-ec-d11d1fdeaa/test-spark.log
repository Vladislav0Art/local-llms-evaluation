import java.util.*;

public class DataFrame {
    private Column[] columns;
    private String[][] indexNames;

    public DataFrame() {
        this.columns = new Column[0];
        this.indexNames = new String[0][];
    }

    public void addColumn(Column column) {
        if (this.columns.length == 0) {
            this.columns = column.toArray();
            this.indexNames = new String[column.getColumns().length][];
            for (int i = 0; i < this.columns.length; i++) {
                this.indexNames[i] = new String[this.columns[i].getColumns().length];
            }
        } else if (this.columns.length == column.getColumns().length) {
            for (int i = 0; i < this.columns.length; i++) {
                this.indexNames[i][i] = "Index_" + (i + 1);
            }
        } else {
            throw new IllegalArgumentException("Column cannot be added to a DataFrame with columns that are not compatible");
        }
    }

    public void dropColumn(String columnName) {
        for (int i = 0; i < this.columns.length; i++) {
            if (this.columns[i].getColumns().contains(columnName)) {
                this.columns = Arrays.copyOf(this.columns, i);
                break;
            }
        }
        if (this.columns.length > 0 && !Arrays.equals(this.indexNames[0], null)) {
            for (int i = 1; i < this.indexNames.length; i++) {
                if (!Arrays.equals(this.indexNames[i - 1], null)) {
                    Arrays.arraycopy(this.indexNames[i], 0, this.indexNames[i - 1], 0, this.columns.length);
                }
            }
        }
    }

    public void dropColumns(List<String> columnNames) {
        for (String columnName : columnNames) {
            for (int i = 0; i < this.columns.length; i++) {
                if (this.columns[i].getColumns().contains(columnName)) {
                    this.columns = Arrays.copyOf(this.columns, i);
                    break;
                }
            }
            if (this.columns.length > 0 && !Arrays.equals(this.indexNames[0], null)) {
                for (int i = 1; i < this.indexNames.length; i++) {
                    if (!Arrays.equals(this.indexNames[i - 1], null)) {
                        Arrays.arraycopy(this.indexNames[i], 0, this.indexNames[i - 1], 0, this.columns.length);
                    }
                }
            }
        }
    }

    public void renameColumns(String oldColumnName, String newColumnName) {
        for (int i = 0; i < this.columns.length; i++) {
            if (this.columns[i].getColumns().contains(oldColumnName)) {
                this.columns[i] = columns[i].renameColumn(newColumnName);
                break;
            }
        }
    }

    public void setIndex(String indexName) {
        for (int i = 0; i < this.indexNames.length; i++) {
            if (Arrays.equals(this.indexNames[i], null)) {
                this.indexNames[i] = new String[0];
            } else if (!Arrays.equals(this.indexNames[i][i], indexName)) {
                throw new IllegalArgumentException("Index name does not match expected format");
            }
        }
    }

