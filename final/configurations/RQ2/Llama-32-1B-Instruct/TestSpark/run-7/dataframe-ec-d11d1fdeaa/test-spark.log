import java.util.*;

public class DataFrame {
    private Column[] columns;
    private String[][] indexNames;

    public DataFrame() {
        this.columns = new Column[0];
        this.indexNames = new String[0][];
    }

    public void addColumn(Column column) {
        if (this.columns.length == 0) {
            this.columns = column.toArray();
            this.indexNames = new String[column.getColumns().length][];
            for (int i = 0; i < this.columns.length; i++) {
                this.indexNames[i] = new String[this.columns[i].getColumns().length];
            }
        } else if (this.columns.length == column.getColumns().length) {
            for (int i = 0; i < this.columns.length; i++) {
                this.indexNames[i][i] = "Index_" + (i + 1);
            }
        } else {
            throw new IllegalArgumentException("Column cannot be added to a DataFrame with columns that are not compatible");
        }
    }

    public void dropColumn(String columnName) {
        for (int i = 0; i < this.columns.length; i++) {
            if (this.columns[i].getColumns().contains(columnName)) {
                System.out.println("Column " + columnName + " found in DataFrame. Dropping...");
                int index = Arrays.asList(this.columns[i].getColumns()).indexOf(columnName);
                for (int j = 0; j < index; j++) {
                    this.columns[j] = this.columns[j + 1];
                }
                System.out.println(Arrays.toString(this.columns));
            } else {
                System.out.println("Column " + columnName + " not found in DataFrame.");
            }
        }
    }

    public void dropColumns(String[] columnNames) {
        for (int i = 0; i < this.columns.length; i++) {
            if (Arrays.asList(columnNames).contains(this.columns[i].getColumns()[i])) {
                System.out.println("Column " + Arrays.asList(columnNames).indexOf(this.columns[i].getColumns()[i]) + " found in DataFrame. Dropping...");
                for (int j = 0; j < this.columns.length; j++) {
                    if (Arrays.asList(columnNames).contains(this.columns[j].getColumns()[j])) {
                        System.out.println("Column " + Arrays.asList(columnNames).indexOf(this.columns[j].getColumns()[j]) + " found in DataFrame. Replacing...");
                        int index = Arrays.asList(this.columns[j].getColumns()).indexOf(Arrays.asList(columnNames).indexOf(this.columns[i].getColumns()[i]));
                        this.columns[index] = this.columns[index + 1];
                    }
                }
            } else {
                System.out.println("Column not found in DataFrame.");
            }
        }
    }

    public int getColumnIndex(String columnName) {
        for (int i = 0; i < this.columns.length; i++) {
            if (Arrays.asList(columnNames).contains(this.columns[i].getColumns()[i])) {
                return i;
            }
        }
        return -1;
    }

    public String getColumnName(int index) {
        for (int i = 0; i < this.columns.length; i++) {
            if (index == i) {
                return this.columns[i].getColumns()[i];
            }
        }
        return null;
    }

    private void swapColumns(Column column1, Column column2) {
        int index = Arrays.asList(columnNames).indexOf(column1.getColumns());
        for (int j = 0; j < index; j++) {
            Column temp = column1.columns[j];
            column1.columns[j] = column2.columns[index - j];
            column2.columns[Array.asList(columnNames).indexOf(temp)] = column1.columns[index - j];
        }
    }

    public void sortColumns() {
        int currentIndex = 0;
        for (int i = 1; i < this.columns.length; i++) {
            for (int j = 0; j < this.columns.length - i; j++) {
                if (Arrays.asList(columnNames).indexOf(this.columns[j].getColumns()) > Arrays.asList(columnNames).indexOf(this.columns[j + 1].getColumns())) {
                    swapColumns(this.columns[currentIndex], this.columns[j]);
                    currentIndex++;
                }
            }
        }
    }

    public static void main(String[] args) {
        Column column1 = new Column(Arrays.asList("A", "B"));
        Column column2 = new Column(Arrays.asList("C", "D"));

        DataFrame df = new DataFrame();
        df.addColumn(column1);
        df.addColumn(column2);

        System.out.println("Original DataFrame:");
        for (Column column : df.columns) {
            System.out.println(column.toString());
        }

        df.dropColumns(new String[]{"A"}); // Drop columns 'A'
        System.out.println("\nDataFrame after dropping columns 'A':");
        for (Column column : df.columns) {
            System.out.println(column.toString());
        }

        df.sortColumns(); // Sort columns in descending order
        System.out.println("\nDataFrame after sorting columns:");
        for (Column column : df.columns) {
            System.out.println(column.toString());
        }
    }
}

class Column {
    private String[] columns;

    public Column(String[] columns) {
        this.columns = columns;
    }

    public int size() {
        return this.columns.length;
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;

        Column column = (Column) o;

        if (!Arrays.equals(columns, column.columns)) return false;

        return true;
    }

    @Override
    public int hashCode() {
        return Arrays.hashCode(columns);
    }
}

class DfsCursor implements Scanner {
    private String[] args;
    public DfsCursor(String[] input) {
        this.args = input;
    }

    @Override
    public String next() {
        return String.join(" ", Arrays.copyOfRange(args, 1, args.length));
    }

    @Override
    public int nextInt() {
        return Integer.parseInt(this.next());
    }
}

class Scanner {
    private String[] tokens;
    private int index;

    public Scanner(String input) {
        this.tokens = input.split(" ");
        this.index = 0;
    }

    public String nextToken() {
        if (this.index >= tokens.length) {
            return null;
        }
        return tokens[this.index++];
    }
}

class Solution {
    static Scanner sc;

    public static void main(String[] args) {
        sc = new Scanner(System.in);
        int n = Integer.parseInt(sc.nextToken());
        String[] columnNames = new String[n];
        for (int i = 0; i < n; i++) {
            columnNames[i] = sc.nextToken();
        }
        System.out.println("Column names: " + Arrays.toString(columnNames));
    }
}
