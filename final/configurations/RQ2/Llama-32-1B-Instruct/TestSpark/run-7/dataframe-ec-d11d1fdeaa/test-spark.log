class Column {
    private List<String> columns;

    public Column(List<String> columns) {
        this.columns = columns;
    }

    public List<String> getColumns() {
        return columns;
    }

    @Override
    public String toString() {
        StringBuilder builder = new StringBuilder();
        for (String column : columns) {
            builder.append(column).append(",");
        }
        return builder.toString().trim();
    }

    public boolean contains(String value) {
        for (String column : columns) {
            if (column.contains(value)) {
                return true;
            }
        }
        return false;
    }

    public Column renameColumn(String oldColumnName, String newColumnName) {
        List<String> columnNames = new ArrayList<>(columns);
        List<String> newColumns = new ArrayList<>(columns);
        for (int i = 0; i < columns.length; i++) {
            if (columnNames.get(i).contains(oldColumnName)) {
                newColumns.set(i, newColumnName + "_" + oldColumnName);
            }
        }
        return new Column(newColumns);
    }

    public String[] toTable() {
        List<String> columnNames = new ArrayList<>(columns);
        StringBuilder builder = new StringBuilder();
        for (String columnName : columnNames) {
            builder.append(columnName).append(",");
        }
        return builder.toString().trim().split(",");
    }

    public int hashCode() {
        int result = 0;
        for (String column : columns) {
            result = result * 31 + column.hashCode();
        }
        return result;
    }

    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;

        Column column = (Column) o;

        if (!columns.equals(column.columns)) return false;

        for (int i = 0; i < columns.length; i++) {
            if (!column.columns.get(i).equals(columns[i])) return false;
        }

        return true;
    }
}

class Procedure<T> implements Comparable<T> {
    private T value;
    private String[] args;
    public Procedure(T value) {
        this.value = value;
    }

    public T getValue() {
        return value;
    }

    @Override
    public int compareTo(T o) {
        if (o instanceof Column) {
            return ((Column)o).getColumns().size() - ((Column)value).getColumns().size();
        } else {
            throw new UnsupportedOperationException("Unsupported type");
        }
    }

    public void call(Column column) {
        for (int i = 0; i < this.args.length; i++) {
            String arg = this.args[i];
            if (!column.getColumns().contains(arg)) {
                throw new RuntimeException("Column " + arg + " not found in DataFrame");
            }
        }

        for (int i = 0; i < column.getColumns().size(); i++) {
            ((String[]) this.args)[i] = String.valueOf(column.columns[i]);
        }

        System.out.println(Arrays.toString(this.args));
    }

    @Override
    public String toString() {
        return "Procedure{" +
                "value=" + value +
                ", args=[";
        for (int i = 0; i < args.length; i++) {
            if (i > 0) {
                this.args[i] = "'" + this.args[i] + "'";
            }
            this.args[i] = String.valueOf(args[i]);
        }
        this.args[args.length] = "]]";
        return "Procedure{" +
                "value=" + value +
                ", args=[" + String.join(", ", this.args) + "]";
    }

    public static void main(String[] args) {
        Column column1 = new Column(Arrays.asList("A", "B"));
        Column column2 = new Column(Arrays.asList("C", "D"));

        DataFrame df = new DataFrame();
        df.addColumn(column1);
        df.addColumn(column2);

        Procedure procedure = new Procedure<>(column1);
        for (int i = 0; i < df.columns.length; i++) {
            System.out.println(df.getColumns()[i].toString());
        }

        // Call the function with arguments
        Column column3 = new Column(Arrays.asList("X"));
        procedure.call(column3);

        // Get the columns of the DataFrame
        for (Column column : df.columns) {
            System.out.println(column.toString());
        }
    }
}

class DfsCursor implements Scanner {
