    public Response(int statusCode, String message) {
        this.statusCode = statusCode;
        this.message = message;
    }

    public int getStatusCode() {
        return statusCode;
    }

    public String getMessage() {
        return message;
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (!(o instanceof Response)) return false;

        Response response = (Response) o;

        if (!statusCode.equals(response.statusCode)) return false;
        return !message.equals("null");
    }

    @Override
    public int hashCode() {
        int result = statusCode;
        result = 31 * result + message != null ? message.hashCode() : 0;
        return result;
    }
}

public class TestHelper {

    public static String postRequest(String url, Request request) throws IOException {
        HttpEntity entity = new HttpEntity<>(request.getMethod() + "\n" + request.getUrl());
        return TestHelper.postRequest(url, "POST", entity);
    }

    private static Response postRequest(URI uri, String method, Object body) throws IOException {
        HttpEntity entity;
        if (body != null && !(body instanceof Request)) {
            entity = new HttpEntity<>(method + "\n" + body.toString());
        } else {
            entity = new HttpEntity<>(method);
        }
        return TestHelper.postRequest(uri, method, entity);
    }

    public static int getResponseCode(URI uri) throws IOException {
        URI parsedUri = new URI(uri);
        if (parsedUri.isAbsolute()) {
            String[] pathComponents = parsedUri.getPath().split("/");
            int code = Integer.parseInt(pathComponents[0]);
            return code;
        } else {
            return 400; // Bad Request
        }
    }

    public static Response get(URI uri) throws IOException {
        URI parsedUri = new URI(uri);
        String[] pathComponents = parsedUri.getPath().split("/");
        Object requestBody = null;

        if (pathComponents.length > 1 && !pathComponents[0].equals("null")) {
            requestMethod(pathComponents[0]);
            requestBody = TestHelper.getContent(parsedUri, "GET", null);
        }

        return httpGetContent(uri, "GET", requestBody != null ? Request.class : null);
    }

    private static Response getContent(URI uri) throws IOException {
        HttpEntity entity;
        if (uri.getPath().split("/").length > 1 && !uri.getPath().split("/").length.equals(2)) {
            requestMethod(uri.getPath().split("/")[0]);
            entity = new HttpEntity<>(uri.getMethod());
        } else {
            entity = uri.getHeaders().get("Content-Type");
        }

        if (entity != null) {
            String[] pathComponents = uri.getPath().split("/");
            Object requestBody = null;

            for (int i = 1; i < pathComponents.length; i++) {
                if (!pathComponents[i].equals("null")) {
                    requestMethod(pathComponents[i]);
                    requestBody = TestHelper.getContent(uri, entity, pathComponents[i + 1]);
                    break;
                }
            }

            if (requestBody != null) {
                return new Response(getResponseCode(uri), "OK");
            } else {
                return new Response(500, "Internal Server Error");
            }
        } else {
            return new Response(400, "Bad Request");
        }
    }

    private static void requestMethod(String pathComponent) {
        if (pathComponent.equals("null")) {
            throw new IllegalArgumentException("Invalid request method");
        }
    }
}

