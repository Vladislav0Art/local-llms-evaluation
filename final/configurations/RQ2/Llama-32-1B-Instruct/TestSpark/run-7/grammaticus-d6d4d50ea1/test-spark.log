            }
            sb.append(si);
        }
        return sb.toString();
    }

    private static class Grammar {
        public String root;
        public Node[] firstSymbol;
        public Map<String, Node> edges;

        public Grammar() {}

        public void addEdge(String symbol1, Node node) {
            if (edges.containsKey(symbol1)) {
                edges.get(symbol1).add(node);
            } else {
                edges.put(symbol1, new ArrayList<>());
                edges.get(symbol1).add(node);
            }
        }

        public String getRoot() {
            return root;
        }

        public Node getFirstSymbol(String symbol) {
            if (firstSymbol != null) {
                for (Node node : firstSymbol) {
                    if (node.getSymbol().equals(symbol)) {
                        return node;
                    }
                }
            }
            return null;
        }

        public boolean isEmpty() {
            return edges.isEmpty();
        }

        public String joinStrings(String s1, String... s2) {
            StringBuilder sb = new StringBuilder();
            for (String si : s2) {
                if (!sb.isEmpty()) {
                    sb.append(',');
                }
                sb.append(si);
            }
            return sb.toString();
        }
    }

    private static class Node {
        public String symbol;
        public String prefix;

        public Node(String symbol, String prefix) {
            this.symbol = symbol;
            this.prefix = prefix;
        }
    }

