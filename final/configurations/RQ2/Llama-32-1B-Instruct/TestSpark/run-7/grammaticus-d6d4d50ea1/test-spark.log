        Node first = getFirstSymbol("A");
        if (first != null) {
            System.out.println(first.symbol + ": " + first.prefix);
        } else {
            System.out.println("None");
        }
    }

    public void testEdges() {
        init();
        Map<String, String> edgesMap = new HashMap<>();
        for (String symbol : getFirstSymbol().keys()) {
            Node node1 = getFirstSymbol(symbol);
            Node node2 = getFirstSymbol(symbol);
            for (Node n : edgeList(node1)) {
                if (!edgeSet.contains(n)) {
                    continue;
                }
                edgesMap.put(n.getSymbol(), n.prefix + symbol + ": " + n.symbol + " -> " + symbol);
            }
        }
        System.out.println(edgesMap);

        Map<String, String> reversedEdges = new HashMap<>();
        for (Map.Entry<String, String> entry : edgeMap.entrySet()) {
            String prefix = entry.getValue().split(":")[0];
            reverse(prefix, entry.getKey());
            System.out.println("Reversed edges: " + reversedEdges);
        }
    }

    private static void reverse(String s1, String s2) {
        char[] chars = s1.toCharArray();
        char temp = chars[0];
        chars[0] = chars[chars.length - 1];
        chars[chars.length - 1] = temp;
        System.out.println(s1);
    }

    private static List<Node> edgeList(Node node) {
        if (node.getSymbol() == null || node.getSymbol().equals("")) {
            return new ArrayList<>();
        }
        String prefix = node.prefix + ": " + node.symbol;
        List<Node> edges = new ArrayList<>(Arrays.asList(edgeMap.get(prefix)));
        edges.add(node);
        return edges;
    }

    public static void main(String[] args) {
        TestGrammar testGrammar = new TestGrammar();
        testGrammar.testRoot();
        testGrammar.testFirstSymbol();
        testGrammar.testEdges();
