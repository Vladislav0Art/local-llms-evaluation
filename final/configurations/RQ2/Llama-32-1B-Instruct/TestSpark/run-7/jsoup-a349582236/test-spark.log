import org.jsoup.parser.Tag;
import org.jsoup.parser.Parser;

public class NormalizerTest {

    private Tag tag;

    @Before
    public void setUp() {
        Normalizer normalizer = new Normalizer();
        tag = new Tag();
        Normalizer.normalize(tag.getName());
    }

    public void testNormalizeTag(String tagName) {
        assertEquals(normalizer.normalize(tagName), tag.getTagName());
    }

    public void testNormalizeSelfClosingTag() {
        Tag selfClosing = tag.setSelfClosing();
        String selfClosingNormalized = normalizer.normalize(selfClosing.getTagNamespace().getName());
        assertEquals(selfClosingNormalized, "xml:");
    }
}

