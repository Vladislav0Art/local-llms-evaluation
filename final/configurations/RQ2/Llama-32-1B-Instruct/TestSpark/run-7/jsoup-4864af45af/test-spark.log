    public static Element safeAddElement(Document doc, Safelist safelist) {
        if (safelist != null && safelist.isSafeAttribute(safelist.tag(), safelist.element)) {
            return new Document(doc).append(safelist.safelyUnsafe(safelist.element, safelist.preserve));
        } else {
            return doc;
        }
    }

