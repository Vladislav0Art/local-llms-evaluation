```java
import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;

public class Main {

    public static void main(String[] args) {
        String htmlString = "<html><body><h1>Hello World</h1></body></html>";
        Document doc = Jsoup.parse(htmlString);

        Safelist safelist = new RelativelyUnsafe();
        Element element = doc.html(safelist);
        System.out.println("Before: " + element.asText());
        safelist = new Preserved();
        element = safelist.preserve(element);
        System.out.println("After: " + element.asText());

        Safelist customSafelist = new CustomSafelist();
        Element customUnsafeElement = customSafelist.safelyUnsafe(doc, false);
        System.out.println("Before: " + customUnsafeElement.asText());
    }
}

class RelativelyUnsafe extends Safelist {

    @Override
    public boolean isSafeAttribute(String tag, String element) {
        return true;
    }

    public static class RelativelyUnsafeImpl extends RelativelyUnsafe {
        private boolean preserveRelativeLinks;

        public RelativelyUnsafeImpl(boolean preserveRelativeLinks) {
            this.preserveRelativeLinks = preserveRelativeLinks;
        }

        @Override
        public boolean isSafeAttribute(String tag, String element) {
            if (tag.startsWith("a")) {
                return true; // A tags are relative links by default
            } else {
                return false;
            }
        }
    }
}

class Preserved extends Safelist {

    @Override
    public boolean isSafeAttribute(String tag, String element) {
        return true;
    }

    public static class PreservedImpl extends Preserved {
        private boolean preserveRelativeLinks;

        public PreservedImpl(boolean preserveRelativeLinks) {
            this.preserveRelativeLinks = preserveRelativeLinks;
        }

        @Override
        public boolean isSafeAttribute(String tag, String element) {
            if (tag.startsWith("img") || tag.equals("link")) {
                return true; // Images and links are always relative links
            } else {
                return false;
            }
        }
    }
}

class CustomSafelist extends Safelist {

    @Override
    public boolean isSafeAttribute(String tag, String element) {
        if (tag.startsWith("a") && tag.contains("href=")) {
            // Implement your own logic to determine whether a link should be preserved or not
            return true;
        } else {
            return false;
        }
    }

    public static class CustomSafelistImpl extends CustomSafelist {
        @Override
        public boolean isSafeAttribute(String tag, String element) {
            if (tag.startsWith("img")) {
                // Implement your own logic to determine whether an image should be preserved or not
                return true;
            } else {
                return false;
            }
        }
    }
}
