        } else {
            return element;
        }
    }

    public static Element customSafelistElement(Element element, Safelist safelist) {
        if (safelist != null && safelist.isSafeAttribute(element.tagName(), element)) {
            if (element.tagName().equals("a")) {
                // Implement your own logic to determine whether an anchor tag should be preserved or not
                return new Document(doc).append(safelist.safelyUnsafe(safelist.element, safelist.preserve));
            } else {
                return new Document(doc).append(safelist.safelyUnsafe(safelist.element, safelist.preserve));
            }
        } else {
            return element;
        }
    }

    public static class RelativelyUnsafeImpl extends RelativelyUnsafe {
        private boolean preserveRelativeLinks;

        public RelativelyUnsafeImpl(boolean preserveRelativeLinks) {
            this.preserveRelativeLinks = preserveRelativeLinks;
        }

        @Override
        public boolean isSafeAttribute(String tag, String element) {
            if (tag.startsWith("a")) {
                return true; // A tags are relative links by default
            } else {
