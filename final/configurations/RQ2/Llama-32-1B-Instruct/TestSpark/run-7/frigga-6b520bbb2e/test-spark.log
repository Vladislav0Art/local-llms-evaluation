            Pattern.compile("^([A-Za-z0-9]+)-([A-Z]{2})-(\\d{8})$");

    @Test
    public void testParseName_NameIsNotEmpty() {
        String amiName = "Example_AMI";
        AppVersion appVersion = new AppVersion();
        appVersion.parseName(amiName);
        assertNotNull(appVersion);
        assertEquals(NameConstants.AMI_NAME, appVersion.getPackageName());
    }

    @Test
    public void testParseName_InvalidAMIName() {
        String amiName = "";
        try {
            AppVersion.parseName(amiName);
            fail("Expected NullPointerException");
        } catch (NullPointerException e) {
            // expected
        }
    }

    @Test
    public void testParseName_NoSpacesInAMIName() {
        String amiName = "Example-AMI";
        AppVersion appVersion = new AppVersion();
        appVersion.parseName(amiName);
        assertNotNull(appVersion);
        assertEquals(NameConstants.AMI_NAME, appVersion.getPackageName());
    }

    @Test
    public void testGetAppVersionPattern_PatternIsDefined() {
        String pattern = APP_VERSION_PATTERN.toString();
        Matcher matcher = Pattern.compile(pattern).matcher("Example_AMI-12345678");
        assertTrue(matcher.matches());
    }

    @Test
    public void testGetAppVersionPattern_PatternMatches() {
        String pattern = "^([A-Za-z0-9]+)-[A-Z]{2}-(\\d{8})$";
        Matcher matcher = Pattern.compile(pattern).matcher("Example_AMI-12345678");
        assertTrue(matcher.matches());
    }

    @Test
    public void testGetAppVersionPattern_PatternMatchesRegex() {
        String pattern = "\\d{8}";
        Matcher matcher = Pattern.compile(pattern).matcher("1234567890");
        assertTrue(matcher.matches());
    }

    @Test
    public void testGetPackageName_NameIsNotEmpty() {
        AppVersion appVersion = new AppVersion();
        assertNotNull(appVersion.getPackageName());
    }

    @Test
    public void testGetPackageName_InvalidName() {
        AppVersion appVersion = new AppVersion();
        assertNull(appVersion.getPackageName());
    }

    @Test
    public void testGetVersion_PropsAreNotDefined() {
        AppVersion appVersion = new AppVersion();
        assertNotNull(appVersion.getVersion());
    }

    @Test
    public void testGetVersion_InvalidProp() {
        AppVersion appVersion = new AppVersion();
        assertNull(appVersion.getBuildNumber());
    }

    @Test
    public void testGetBuildJobName_PropsAreNotDefined() {
        AppVersion appVersion = new AppVersion();
        assertNotNull(appVersion.getBuildJobName());
    }

    @Test
    public void testGetBuildNumber_PropsAreNotDefined() {
        AppVersion appVersion = new AppVersion();
        assertNull(appVersion.getBuildNumber());
    }

    @Test
    public void testGetCommit_PropsAreNotDefined() {
        AppVersion appVersion = new AppVersion();
        assertNotNull(appVersion.getCommit());
    }

    @Test
    public void testGetChangelist_PropsAreNotDefined() {
        AppVersion appVersion = new AppVersion();
        assertNotNull(appVersion.getChangelist());
    }

    @Test
    public void testToString_PropsAreNotDefined() {
        AppVersion appVersion = new AppVersion();
        assertNotNull(appVersion.toString());
    }
}
