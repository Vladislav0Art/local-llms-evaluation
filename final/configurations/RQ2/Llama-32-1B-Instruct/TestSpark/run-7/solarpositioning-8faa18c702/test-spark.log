public class SolarPositioning {
    private int days;

    public SolarPositioning(int days) {
        this.days = days;
    }

    public int calculateDeltaT(LocalDate date, int daysToCalculate) {
        return Math.max(0, (int) ((double) days / 365.25 - 1) * days);
    }
