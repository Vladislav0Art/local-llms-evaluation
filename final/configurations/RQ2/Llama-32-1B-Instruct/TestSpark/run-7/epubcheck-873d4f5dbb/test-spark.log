import java.util.HashMap;
import java.util.Map;

public class Main {

    public static void main(String[] args) {
        final Map<String, String> mediaTypes = new HashMap<>();

        Thread t1 = new Thread(() -> {
            mediaTypes.put("video/mp4", "video/mp4");
            mediaTypes.put("image/jpeg", "image/jpeg");
        });

        Thread t2 = new Thread(() -> {
            System.out.println(mediaTypes.get("video/mp4")); // Output: video/mp4
            System.out.println(mediaTypes.get("image/jpeg")); // Output: image/jpeg

            // Check for unknown media type
            System.out.println(mediaTypes.get("unknown"));  // Output: Unknown
        });

        t1.start();
        t2.start();

        try {
            t1.join();
            t2.join();
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }
    }
}
