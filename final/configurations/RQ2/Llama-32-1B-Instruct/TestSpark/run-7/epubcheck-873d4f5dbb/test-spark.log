**Using a Java API**

In this problem, we are asked to use the `java.nio.file` package to store and retrieve media types.

```java
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;

public class Main {

    public static void main(String[] args) {
        try (Path path = Paths.get("path/to/media_types.txt")) {
            String[] lines = Files.readAllLines(path);

            for (String line : lines) {
                String[] parts = line.split(",");
                if (parts.length == 2 && parts[0].trim().equals("video") && parts[1].trim().equals("mp4")) {
                    System.out.println(parts[1]);
                } else if (parts.length == 2 && parts[0].trim().equals("image") && parts[1].trim().equals("jpeg")) {
                    System.out.println(parts[1]);
                }
            }

            // Check for unknown media type
            try (Path path = Paths.get("path/to/unknown_media_type.txt")) {
                String[] parts = Files.readAllLines(path).stream()
                        .filter(line -> line.trim().equals("audio/mpeg"))
                        .findFirst()
                        .orElseThrow();
                System.out.println(parts[1]);
            }
        } catch (IOException e) {
            System.err.println("Error: " + e.getMessage());
        }
    }
}
```

