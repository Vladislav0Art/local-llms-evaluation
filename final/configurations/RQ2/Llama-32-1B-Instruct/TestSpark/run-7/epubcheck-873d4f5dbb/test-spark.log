import org.json.JSONObject;

public class Main {

    public static void main(String[] args) {
        JSONObject jsonObject = new JSONObject();
        jsonObject.put("video/mp4", "video/mp4");
        jsonObject.put("image/jpeg", "image/jpeg");

        String[] videoTypes = jsonObject.getJSONArray("videos").getStringArray(0);

        for (String type : videoTypes) {
            System.out.println(type);
        }

        // Check for unknown media type
        String[] audioTypes = jsonObject.getStringArray("audio");
        if (audioTypes.length > 1 && audioTypes[0].equals("audio/mpeg")) {
            System.out.println(audioTypes[1]);
        }
    }
}
