    Document doc = new Document("My Document");

    Node heading = new TitleNode("Heading", "This is a heading");
    Node body = new BodyNode("Body text", "This is some body text.");

    Heading h1 = new Heading(heading, 1);
    Heading h2 = new Heading(body, 2);

    doc.setTitle(h1.outputSettings());
    doc.setContent(h1.outputSettings() + " and " + h2.outputSettings());
}
