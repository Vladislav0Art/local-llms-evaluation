    public void testGetSignatureHint() {
        // Arrange
        SignatureHint expectedHint = "some-signature-hint";
        KeyPair keyPair = KeyPair.fromSigningKey(new EdDSAPrivateKeySpec("some-signing-key"));

        // Act
