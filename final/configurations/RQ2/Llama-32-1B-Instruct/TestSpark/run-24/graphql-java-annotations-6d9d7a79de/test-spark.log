public class DirectivesBuilderTest {

    private AnnotatedElement object;
    private ProcessingElementsContainer container;

    @Before
    public void setup() {
        object = mock(AnnotatedElement.class);
        container = mock(ProcessingElementsContainer.class);
    }

    public DirectivesBuilder createDirectivesBuilder(Object[] arguments) {
        return new DirectivesBuilder(object, container);
    }

    @Test
    public void testBuildWithoutAnyArguments() throws GraphQLAnnotationsException {
        DirectivesBuilder builder = createDirectivesBuilder(new Object[0]);
        assertEquals(0, builder.build().length);
    }

    @Test
    public void testBuildWithNoDirective() {
        Object[] arguments = new Object[]{};
        DirectivesBuilder builder = createDirectivesBuilder(arguments);
        assertEquals(0, builder.build().length);
    }

    @Test
    public void testBuildWithOneArgument() throws GraphQLAnnotationsException {
        Object[] arguments = new Object[]{object};
        DirectivesBuilder builder = createDirectivesBuilder(arguments);
        assertEquals(1, builder.build().length);
        DirectiveJavaAnnotationUtil.assertNoDirectives(builder.build()[0], object);
    }

    @Test
    public void testBuildWithMultipleArguments() throws GraphQLAnnotationsException {
        Object[] arguments = new Object[]{object};
        for (int i = 0; i < 3; i++) {
            Object[] nestedArguments = new Object[]{object};
            nestedArguments[i] = i;
            DirectivesBuilder builder = createDirectivesBuilder(arguments);
            assertEquals(4, builder.build().length);
            DirectiveJavaAnnotationUtil.assertNoDirectives(builder.build()[0], arguments[0]);
        }
    }

    @Test
    public void testBuildWithMultipleFields() throws GraphQLAnnotationsException {
        Object[] arguments = new Object[]{object};
        List<GraphQLArgument> fieldDefinitions = Arrays.asList(
                mock(GraphQLArgument.class),
                mock(GraphQLArgument.class)
        );
        DirectivesBuilder builder = createDirectivesBuilder(arguments, fieldDefinitions);
        assertEquals(3, builder.build().length);
        DirectiveJavaAnnotationUtil.assertNoDirectives(builder.build()[0], arguments[0]);
    }

}

