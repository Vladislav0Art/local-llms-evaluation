import java.util.*;
import javax.imageio.ImageIO;

public class SafeTags {
    public static void testIsSafeTag(String tag) throws Exception {
        // Create a new safe tags object
        List<TagAttribute> attributes = new ArrayList<>();

        if (tag.startsWith("img")) {
            ImageIO.read(new File(tag.substring(8)));  // Assuming the image source is in the form of data:image/png;base64,iVBORw0KGg...
            String[] attrs = tag.substring(22).split(",");
            for (String attr : attrs) {
                attributes.add(new TagAttribute(attr.trim().split("=")[1], ""));
            }
        } else {
            String url = "https://" + tag.split("://").length > 1 ? tag.split("://")[1] : "";
            if (!url.startsWith("http")) {
                throw new Exception("Unsupported URL: " + url);
            }
            
            attributes.add(new TagAttribute("href", url));
        }

        try {
            SafeTags.testIsSafeTag(tag, attributes.toArray(new TagAttribute[0]));
        } catch (AssertionError e) {
            System.out.println("Error: " + e.getMessage());
        }
    }

    public static class TagImage extends HashMap<String, String> {
        @Override
        public void put(String key, String value) {
            super.put(key, value);
            this.src = value;
        }
    }

    public static void main(String[] args) throws Exception {
        testIsSafeTag("img src='data:image/png;base64,iVBORw0KGg...'");
        
        try {
            testIsSafeTag("unsupported-tag");
        } catch (Exception e) {
            System.out.println("Caught exception: " + e.getMessage());
        }
    }
}
```

