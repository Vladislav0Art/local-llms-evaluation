package org.jsoup.parser;

import java.util.HashMap;
import java.util.Map;

public class TagImpl implements Tag {

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (!(o instanceof Tag)) return false;
        Tag tag = (Tag) o;
        return preserveWhitespace() == tag.preserveWhitespace();
    }

    @Override
    public int hashCode() {
        final int hash = 31;
        return hash * 31 + preserveWhitespace();
    }

    @Override
    public String toString() {
        return "TagImpl{" +
                "name='" + getName() + '\'' +
                ", normalName()=" + Normalizer.normalize(getName(), Normalizer.NFD) +
                '}';
    }
}

public class TagValueTest {

    private final Tag tag;

    public TagValueTest(Tag value) {
        this.tag = value;
    }

    @Test
    public void testGetValueOfTagName() {
        assert tag.getValueOfTagName("tag") == "TagImpl{name='tag'}";
    }

    @Test
    public void testGetNormalName() {
        assertEquals("tag", Normalizer.normalize(tag.getName(), Normalizer.NFD).replaceAll("[^\\w]", ""));
    }

    @Test
    public void testGetValueOfTagName_() {
        assert tag.getValueOfTagName("") == null;
    }

    @Test
    public void testIsBlock() {
        assertTrue(tag.isBlock());
    }

    @Test
    public void testFormatAsBlock() {
        assertFalse(tag.formatAsBlock());
    }

    @Test
    public void testIsInline() {
        assertTrue(tag.isInline());
    }

    @Test
    public void testIsEmpty() {
        assertFalse(tag.isEmpty());
    }

    @Test
    public void testIsSelfClosing() {
        assertTrue(tag.isSelfClosing());
    }

    @Test
    public void testGetIsKnownTag_() {
        assert tag.getIsKnownTag("tag") == true;
    }

    @Test
    public void testGetKnownTag_() {
        assertTrue(tag.isKnownTag("form"));
    }
}

public class TagValue {

    private final String tagName;

    public TagValue(String tagName) {
        this.tagName = tagName;
    }

    public String getName() {
        return tagName;
    }

    @Test
    public void testGetValueOfTagName_1() {
        assertEquals(tagName, tag.getValueOfTagName());
    }
}

public class TagFactory {

