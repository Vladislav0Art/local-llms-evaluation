        System.out.println(app1.getName() + ": " + app1.getVersion());

        String version = "ami1234567890abcdef";
        Pattern pattern = Pattern.compile("^[a-zA-Z]+([a-zA-Z0-9_-]*)*:$");
        Matcher matcher = pattern.matcher(version);
        if (matcher.matches()) {
            System.out.println(matcher.group(1) + ": " + matcher.group(2));
        }

        version = "ami1234567890abcdef";
        assertEquals("ami1234567890abcdef", app1.getVersion());

        AppVersionMatcher.appVersion = app1;

        pattern = Pattern.compile("^[a-zA-Z]+([a-zA-Z0-9_-]*)*:$");
        matcher = pattern.matcher(version);
        if (matcher.matches()) {
            System.out.println(matcher.group(1) + ": " + matcher.group(2));
        }

        version = "ami1234567890abcdef";
        assertEquals("v1.2.3", appVersion.getVersion());
    }
}

class AppVersion {
