        System.out.println("Temperature Change: " + calculateTemperatureChange(20, 30));
        System.out.println("Delta T: " + calculateDeltaT(25));

        int initialTemp = 0;
        double finalTemp = 100;

        double change = calculateTemperatureChange(initialTemp, finalTemp);
        System.out.println("Temperature Change from " + initialTemp + " to " + finalTemp + ": " + change);

        System.out.println(calculateDeltaT(30));
    }
}
```

