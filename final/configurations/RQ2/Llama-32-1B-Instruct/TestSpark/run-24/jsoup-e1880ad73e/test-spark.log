import java.util.HashMap;
import java.util.Map;

public class Main {
    public static void main(String[] args) {
        Map<String, String> map = new HashMap<>();

        // create 5 key-value pairs
        map.put("key1", "value1");
        map.put("key2", "value2");
        map.put("key3", "value3");
        map.put("key4", "value4");
        map.put("key5", "value5");

        // print the contents of the dictionary
        System.out.println("Dictionary Contents: " + Arrays.toString(map.values()));

        // get the value associated with a specific key
        System.out.println("Value for key 'key1': " + map.get("key1"));

        // update a value in the dictionary
        map.put("key2", "Updated Value 2");
        System.out.println("Updated Dictionary Contents: " + Arrays.toString(map.values()));

        // delete a key-value pair from the dictionary
        map.remove("key3");
        System.out.println("Dictionary Contents After Removing 'key3': " + Arrays.toString(map.values()));
    }
}
```

