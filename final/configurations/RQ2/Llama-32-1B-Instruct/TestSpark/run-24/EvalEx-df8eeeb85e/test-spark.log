import org.junit.Test;
import static org.junit.Assert.*;

public class TokenizerTest {

    @Before
    public void setup() {
        String expressionString = "1 + 2";
        ExpressionConfiguration configuration = new DefaultExpressionConfiguration();
        tokenizer = new Tokenizer(expressionString, configuration);
    }

    @Test
    public void testParseStringLiteral() {
        String expressionString = "1 + 2";
        List<Token> expectedTokens = new ArrayList<>();
        expectedTokens.add(new SingleNumberToken(1));
        expectedTokens.add(new BinaryPlusToken(" + ", 2));
        assertEquals(expectedTokens, tokenizer.parseStringLiteral());
    }

    @Test
    public void testParseIntegerLiteral() {
        String expressionString = "123";
        List<Token> expectedTokens = new ArrayList<>();
        expectedTokens.add(new IntegerNumberToken(123));
        assertEquals(expectedTokens, tokenizer.parseIntegerLiteral(expressionString));
    }

    @Test
    public void testParseDoubleLiteral() {
        String expressionString = "12.3";
        List<Token> expectedTokens = new ArrayList<>();
        expectedTokens.add(new DoubleNumberToken(12.3));
        assertEquals(expectedTokens, tokenizer.parseDoubleLiteral(expressionString));
    }

    @Test
    public void testParseWhitespaceLiteral() {
        String expressionString = "   ";
        List<Token> expectedTokens = new ArrayList<>();
        expectedTokens.add(new WhitespaceToken());
        assertEquals(expectedTokens, tokenizer.parseWhitespaceLiteral(expressionString));
    }

    @Test
    public void testParseBooleanLiteral() {
        String expressionString = "true";
        List<Token> expectedTokens = new ArrayList<>();
        expectedTokens.add(new BooleanNumberToken(true));
        assertEquals(expectedTokens, tokenizer.parseBooleanLiteral(expressionString));
    }

    @Test
    public void testParseNoneLiteral() {
        String expressionString = "None";
        List<Token> expectedTokens = new ArrayList<>();
        expectedTokens.add(new WhitespaceToken());
        expectedTokens.add(new BooleanNumberToken(false));
        assertEquals(expectedTokens, tokenizer.parseNoneLiteral(expressionString));
    }

