import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;

public class AttributesTest {

    public Document getJsoupDoc() {
        return new Document();
    }

    @Before
    public void setup() {
        Document doc = getJsoupDoc();

        Element scriptTag = (Element) doc.getElementById("script");
        scriptTag.setTextContent("Object.assign();");

        scriptTag.setAttribute("type", "text/javascript");
        ((Element) scriptTag).setAttribute("src", "https://cdn.jsdelivr.net/npm/jsdom@17.0.2/build/GlobalNode.js");

        assertEquals(true, scriptTag.hasAttribute("id"));
    }

    public void testScriptTextContent() {
        Document doc = getJsoupDoc();

        assertEquals("Object.assign();", ((Element) doc.getElementById("script")).text());
    }

    public void testScriptAttribute() {
        Document doc = getJsoupDoc();

        Element scriptTag = (Element) doc.getElementById("script");

        assertTrue(scriptTag.hasAttribute("id"));
        assertEquals(true, scriptTag.hasAttribute("type"));
        assertEquals(false, scriptTag.hasAttribute("src"));

        ((Element) scriptTag).setAttribute("id", "test-script");
        ((Element) scriptTag).setAttribute("type", "text/html");
        ((Element) scriptTag).setAttribute("src", "");
    }

    public void testScriptCallCount() {
        Document doc = getJsoupDoc();

        Element scriptTag = (Element) doc.getElementById("script");

        assertEquals(0, ((Element) scriptTag).attr("call-count"));
    }

    @After
    public void tearDown() {
        Document doc = getJsoupDoc();
        if (!doc.body().contains(scriptTag)) {
            doc.deleteChild(scriptTag);
        }
    }
}
