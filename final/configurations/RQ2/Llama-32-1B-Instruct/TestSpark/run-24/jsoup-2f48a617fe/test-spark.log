import java.util.ArrayList;
import java.util.List;

public class Comment {
    private String data;
    private Appendable outerHtmlHead;
    private Appendable outerHtmlTail;

    public boolean isXmlDeclaration() {
        return true; // Replace with actual logic to check xml declaration
    }

    @Override
    public int size(int n) {
        return 0; // Replace with actual logic to get size of string
    }
}

public class Appender implements Appendable {
    private StringBuilder output;

    public void append(CharSequence csq) {
        output.append(csq);
    }

    public void append(char c) {
        output.append(c);
    }

    @Override
    public int size(int n) {
        return output.length();
    }
}

public class Document implements Appendable {
    private StringBuilder output;
    private List<Comment> comments;

    public void append(StringBuilder sb) {
        output.append(sb);
    }

    public String toString() {
        return output.toString();
    }

    public void setComments(List<Comment> comments) {
        this.comments = comments;
    }
}

public class Parser implements Parser {
    @Override
    public boolean parse(String data, Comment[] comments) {
        Document doc = new Document();
        StringBuilder sb = new StringBuilder();
        doc.setComments(comments);
        parser(sb.toString(), comments);
        return true; // Replace with actual logic to parse string into comments
    }

    private void parser(StringBuilder sb, List<Comment> comments) {
        for (int i = 0; i < comments.size(); i++) {
            Comment comment = comments.get(i);
            if (!comment.isXmlDeclaration()) {
                sb.append(comment.toString());
            }
        }
        System.out.println(sb.toString());
    }

    public void setComments(List<Comment> comments) {
        this.comments = comments;
    }

    public Comment getCommentAt(int index) {
        return comments.get(index);
    }
}

public class ParserExample implements Parser {
    @Override
    public boolean parse(String data, Comment[] comments) {
        System.out.println("Parsing...");
        Parser parser = new Parser();
        if (parser.parse(data, comments)) {
            System.out.println("Parsing completed.");
        } else {
            System.out.println("Error: " + parser.getCommentAt(0).toString());
        }
        return true;
    }

    public void setComments(List<Comment> comments) {
        this.comments = comments;
    }

    public Comment getCommentAt(int index) {
        return comments[index];
    }
}

public class Main {
