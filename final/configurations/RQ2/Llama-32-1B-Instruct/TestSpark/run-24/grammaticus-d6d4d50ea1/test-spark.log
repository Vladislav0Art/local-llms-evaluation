     *
     * @param x The first integer.
     * @param y The second integer.
     * @return int
     */
    public static int add(int x, int y) {
        if (x > 0 && y > 0) {
            return x + y;
        } else {
            throw new ArithmeticException("Both numbers must be positive.");
        }
    }

    /**
     * Returns the maximum of two integers.
     *
     * @param a The first integer.
     * @param b The second integer.
     * @return int
     */
    public static int max(int a, int b) {
        if (a > b) {
            return a;
        } else {
            return b;
        }
    }

    /**
     * Prints "fail" to the console.
     */
    public static void fail() {}

    /**
     * Tests the exampleFunction method with an invalid input (negative numbers).
     */
    public static void testExampleFunction() {
        System.out.println(exampleFunction());
    }

    /**
     * Tests the addMethod with two positive integers.
     */
    public static void testAddMethod() {
        try {
            int result = add(1, 2);
            System.out.println("Test pass: " + result);
        } catch (ArithmeticException e) {
            System.out.println(e.getMessage());
        }
    }

    /**
     * Tests the maxMethod with two positive integers.
     */
    public static void testMaxMethod() {
        try {
            int result = max(3, 4);
            System.out.println("Test pass: " + result);
        } catch (ArithmeticException e) {
            System.out.println(e.getMessage());
        }
    }
}
