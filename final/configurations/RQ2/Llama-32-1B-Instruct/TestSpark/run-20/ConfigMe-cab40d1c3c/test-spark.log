public class PropertyListBuilderTest {

    private PropertyListBuilder propertyListBuilder;
    private String rootKey1 = "root1";
    private List<Property<?>> properties1 = new ArrayList<>();
    private Map<String, Object> map1 = new LinkedHashMap<>();

    @Before
    public void setup() {
        MockitoAnnotations.initMocks(this);
        propertyListBuilder = new PropertyListBuilder();
    }

    public static class AddPropertyTest {

        @Test
        public void testAddProperty() throws ConfigMeException {
            Mockito.when(propertyListBuilder.getRootEntries().get(rootKey1).add(any(Property.class))).thenReturn(List.of(new Property("value1")));
            propertyListBuilder.add(Property.from("root1", "value1"));
            assertEquals(2, properties1.size());
            verify(properties1, times(1)).add(any(Property.class));
        }

        @Test
        public void testAddPropertyMultipleTimes() throws ConfigMeException {
            Mockito.when(propertyListBuilder.getRootEntries().get(rootKey1).add(any(Property.class))).thenReturn(List.of(new Property("value1")));
            propertyListBuilder.add(Property.from("root1", "value2"));
            assertEquals(2, properties1.size());
            verify(properties1, times(2)).add(any(Property.class));
        }

        @Test
        public void testAddMultipleProperties() throws ConfigMeException {
            Mockito.when(propertyListBuilder.getRootEntries().get(rootKey1).add(any(Property.class))).thenReturn(List.of(new Property("value1"), new Property("value2")));
            List<Property<?>> properties = propertyListBuilder.create();
            assertEquals(2, properties.size());
        }
    }

    public static class GetRootEntriesTest {

        @Test
        public void testGetRootEntries() throws ConfigMeException {
            Mockito.when(propertyListBuilder.getRootEntries().get(rootKey1).add(any(Property.class))).thenReturn(List.of(new Property("value1")));
            Map<String, Object> map = propertyListBuilder.getRootEntries();
            assertEquals(rootKey1, map.getOrDefault(rootKey1, Collections.emptyList()).iterator().next());
        }

    }

}
