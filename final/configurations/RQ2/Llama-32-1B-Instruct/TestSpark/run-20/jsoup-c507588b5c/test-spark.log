public class Node {
    public String text;
    public String type;

    public void toString() {
        System.out.println("Text: " + text);
        System.out.println("Type: " + type);
    }

    public boolean lastCharIsWhitespace(String s) {
        for (int i = 0; i < s.length(); i++) {
            if (!Character.isWhitespace(s.charAt(i))) {
                return true;
            }
        }
        return false;
    }

    public String normaliseWhitespace(String s) {
        StringBuilder sb = new StringBuilder();
        boolean lastCharIsWhitespace = false;

        for (int i = 0; i < s.length(); i++) {
            if (!Character.isWhitespace(s.charAt(i))) {
                sb.append(s.charAt(i));
            } else {
                if (lastCharIsWhitespace) {
                    sb.append(" ");
                }
                lastCharIsWhitespace = true;
            }
        }

        return sb.toString();
    }

    public boolean isLeaf() {
        return text.isEmpty();
    }

    public String getInnerText() {
        // Return the inner text of the node if it exists
        return null;
    }

