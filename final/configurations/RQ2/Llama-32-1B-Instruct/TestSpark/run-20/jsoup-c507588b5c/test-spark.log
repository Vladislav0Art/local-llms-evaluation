class Node {
    public String text;
    public String type;

    public void toString() {
        System.out.println(this.toString());
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (!(o instanceof Node)) return false;
        Node node = (Node) o;
        return this.text.equals(node.text);
    }

    @Override
    public int hashCode() {
        return this.text.hashCode();
    }

    public void addEdge(Node from, String to) {
        if (!from.isLeaf()) {
            throw new RuntimeException("Edge cannot be added from a non-leaf node");
        }
        if (this.type.equals(to)) {
            System.out.println("Cannot add edge from " + this + " to itself");
            return;
        }

        int indexFrom = getSiblingIndex(this, false);
        while (indexFrom != -1 && !getSiblingIndex(from, true).equals(indexFrom)) {
            if (!from.type.equals(getSiblingParent(this))) {
                throw new RuntimeException("Edge cannot be added from " + this + " to a sibling with different parent type");
            }
            indexFrom = getSiblingIndex(this, false);
        }

        String[] tempResult = getChildren(to);
        if (tempResult != null && !tempResult[0].equals(tempResult[1])) {
            throw new RuntimeException("Edge cannot be added from " + this + " to itself");
        }

        System.out.println("Add edge from " + this + " to " + to);
        root.setText(getSiblingParent(this).getText() + from.getType() + to.getType());
    }

    public void setParent(Node parent) {
        if (!parent.isLeaf()) {
            throw new RuntimeException("Cannot add an edge from a non-leaf node");
        }
        this.parent = parent;
    }

    private int getSiblingIndex(Node from, boolean findFirst) {
        for (Node sibling : root.getChildren()) {
            if (sibling != null && (findFirst ? sibling.isLeaf() : false)) {
                return sibling.getIndex(from, true);
            }
        }
        return -1;
    }

    private String getSiblingParent(Node node) {
        for (Node sibling : root.getChildren()) {
            if (sibling != null) {
                if (sibling.isLeaf()) {
                    return node.getText();
                } else {
                    int indexFrom = node.getText().indexOf(sibling.getType());
                    while (indexFrom != -1 && !root.getText().equals(root.getText() + 1)) {
                        if (!node.getText().contains(sibling.getType())) {
                            System.out.println(" sibling " + sibling + " is not a child of the parent.");
                            return "";
                        }
                        indexFrom = root.getText().indexOf(node.getText());
                    }
                }
            }
        }
        return "";
    }

    private Node getParent() {
        if (this.parent == null) {
            throw new RuntimeException("Parent is not set");
        }
        return this.parent;
    }

    public String getInnerText() {
        String[] children = getChildren(getText());
        for (String child : children) {
            if (!child.equals("leaf")) {
                System.out.println(child);
            }
        }
        return getText();
    }
}

class TagNode extends Node {
