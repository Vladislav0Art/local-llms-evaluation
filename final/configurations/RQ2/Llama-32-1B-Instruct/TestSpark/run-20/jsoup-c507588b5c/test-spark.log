            System.out.println("Text: " + text);
        }
        if (isLeaf()) {
            System.out.println("Is Leaf: true");
        } else if (!lastCharIsWhitespace(getInnerText())) {
            System.out.println("Last Char is not whitespace.");
        } else {
            System.out.println("Last Char is whitespace. Normalised: " + normaliseWhitespace(getInnerText()));
        }
    }

    public Node(String text, String type) {
        this.text = text;
        this.type = type;
    }
}

