import static org.junit.Assert.assertEquals;
import java.util.ArrayList;

public class Main {

    private static String publicClass1 = "public class MyClass { }";
    private static String publicMethod1() {
        return "This is a method in public class MyClass.";
    }

    private static String publicMethod2() {
        return "This is another method in the same package as publicMethod1, but outside of it.";
    }

    private static String printString(String str) {
        System.out.println(str);
        return str;
    }

    public void testPrintString() {
        testPrintString(printString(publicClass1));
        testPrintString(printString("Hello World"));
    }

    private static boolean isPublicMethodPresent(String module, String methodName) {
        try {
            Class<?> clazz = Class.forName(module);
            Method method = clazz.getMethod(methodName);
            return true;
        } catch (ClassNotFoundException | NoSuchMethodException e) {
            return false;
        }
    }

    public void testIsPublicMethodPresent() {
        System.out.println(isPublicMethodPresent("java.lang.Math", "sin"));
        System.out.println(isPublicMethodPresent("java.lang.Math", "cos"));
    }

    private static int add(int a, int b) {
        return a + b;
    }

    public void testAdd() {
        assertEquals(2, (int) Main.add(1, 2));
    }

    private static String splitString(String str) {
        StringBuilder builder = new StringBuilder();
        for (char c : str.toCharArray()) {
            if (!Character.isWhitespace(c)) {
                builder.append(c);
            }
        }
        return builder.toString();
    }

    public void testSplitString() {
        System.out.println(splitString("hello world"));
    }

    private static String createPublicClass() {
        StringBuilder builder = new StringBuilder();
        builder.append("public class MyTest { }");
        return builder.toString();
    }

    public static void main(String[] args) throws Exception {
        Main main = new Main();

        // Test cases
        main.testPrintString();
        System.out.println();
        main.testIsPublicMethodPresent();
        System.out.println();
        main.testAdd();

        // Public classes and methods
        main.publicClass1();
        assertEquals("public class MyClass { }", publicClass1);
        main.publicMethod1();
        assertEquals(publicMethod1(), "This is a method in public class MyClass.");
        main.publicMethod2();
        assertEquals(publicMethod2(), "This is another method in the same package as publicMethod1, but outside of it.");

        // Testing methods in different packages
        System.out.println("Testing printString function:");
        main.testPrintString();

        System.out.println("\nTesting isPublicMethodPresent function:");
        boolean isPresent = false;
        for (int i = 0; i < 10; i++) {
            if (!isPublicMethodPresent("java.lang.Math", "sin")) {
                isPresent = true;
                break;
            }
        }
        System.out.println(isPresent);

        // Testing add method in different packages
        System.out.println("\nTesting add function:");
        assertEquals(2, (int) Main.add(1, 2));

        System.out.println("\nTesting splitString function:");
        String result = Main.splitString("hello world");
        System.out.println(result);
    }
}
