    @Test
    public void testNewInstance() throws IOException, ParseException {
        Document doc = parseTree("<doc><root><child/></root></doc>");
        assertEquals(1, doc.childNodes().size());
        assertEquals("doc", doc.childNodes().get(0).getNodeName());
        assertEquals("<root>", doc.childNodes().get(0).getNodeName());
    }

    @Test
    public void testParseFragment() throws IOException, ParseException {
        String input = "<fragment><para>Hello World!</para></fragment>";
        Document doc = parseTree(input);
        List<Node> nodes = doc.getNodes();
        assertEquals(1, nodes.size());

        Element paraElement = (Element) nodes.get(0).getNodeName();
        assertEquals("<para>", paraElement.getNodeName());
        assertEquals("Hello World!", paraElement.getTextContent().trim());
    }

    @Test
    public void testInsertNode() throws IOException {
        Document doc = parseTree("<doc><root><child/></root></doc>");
        Element rootElement = (Element) doc.getNodes().get(0).getNodeName();
        rootElement.appendChild(parseTree("<child/>"));
        assertEquals(1, rootElement.childNodes().size());
    }

