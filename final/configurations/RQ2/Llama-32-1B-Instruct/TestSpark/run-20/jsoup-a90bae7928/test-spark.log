package org.jsoup.parser;

import java.io.IOException;
import java.io.StringReader;
import java.util.ArrayList;
import java.util.List;
import org.jsoup.nodes.Document;
import org.junit.AfterClass;
import org.junit.BeforeClass;
import org.junit.Test;
import org.jsoup.nodes.DocumentType;
import org.jsoup.nodes.Element;
import org.jsoup.nodes.Entities;
import org.jsoup.nodes.Node;
import org.jsoup.nodes.TextNode;
import org.jsoup.parser.XmlTreeBuilder;
import org.jsoup.parser.Token;
import org.jsoup.parser.TokenReader;
import org.jsoup.parser.ParseException;

public class XmlTreeBuilderTest {

    public static DocumentBuilder builder = new DocumentBuilder();

    @BeforeClass
    public static void init() {
        builder.setParseSettings(new ParseSettings());
    }

    @AfterClass
    public static void close() {
        builder.close();
    }

    private XmlTreeBuilder parseTree(String input) throws IOException, ParseException {
        return builder.parse(new StringReader(input));
    }

    @Test
    public void testNewInstance() throws IOException, ParseException {
        Document doc = parseTree("<doc><root><child/></root></doc>");
        assertEquals(1, doc.childNodes().size());
        assertEquals("doc", doc.childNodes().get(0).getNodeName());
        assertEquals("<root>", doc.childNodes().get(0).getNodeName());
    }

    @Test
    public void testParseFragment() throws IOException, ParseException {
        String input = "<fragment><para>Hello World!</para></fragment>";
        Document doc = parseTree(input);
        List<Node> nodes = doc.getNodes();
        assertEquals(1, nodes.size());

        Element paraElement = (Element) nodes.get(0).getNodeName();
        assertEquals("<para>", paraElement.getNodeName());
        assertEquals("Hello World!", paraElement.getTextContent().trim());
    }

    @Test
    public void testInsertNode() throws IOException {
        Document doc = parseTree("<doc><root><child/></root></doc>");
        Element rootElement = (Element) doc.getNodes().get(0).getNodeName();
        rootElement.appendChild(parseTree("<child/>"));
        assertEquals(1, rootElement.childNodes().size());
    }

    @Test
    public void testInsertNodeComment() throws IOException {
        String input = "<doc><root><child/></root></doc>";
        Document doc = parseTree(input);
        Element rootElement = (Element) doc.getNodes().get(0).getNodeName();
        Element childElement = (Element) rootElement.getElementsByTagName("child")[0];
        childElement.appendChild(parseTree("<child/>"));
    }

    @Test
    public void testInsertNodeCharacter() throws IOException {
        String input = "<doc><root><child></root></doc>";
        Document doc = parseTree(input);
        Element rootElement = (Element) doc.getNodes().get(0).getNodeName();
        element = (Element) rootElement.getElementsByTagName("child")[0];
        element.appendChild(parseTree("<child></child>"));
    }

    @Test
    public void testInsertToken() throws IOException {
        String input = "<doc><root><child/></root></doc>";
        Document doc = parseTree(input);
        Element rootElement = (Element) doc.getNodes().get(0).getNodeName();
        Element childElement = (Element) rootElement.getElementsByTagName("child")[0];
        Token token = parseTree("<child/>");
        childElement.appendChild(token);
    }

    @Test
    public void testInsertTokenComment() throws IOException {
        String input = "<doc><root><child/></root></doc>";
        Document doc = parseTree(input);
        Element rootElement = (Element) doc.getNodes().get(0).getNodeName();
        Element childElement = (Element) rootElement.getElementsByTagName("child")[0];
        Token commentToken = parseTree("<comment/>");
        childElement.appendChild(commentToken);
    }

    @Test
    public void testInsertTokenDoctype() throws IOException {
        String input = "<doc><root><child/></root></doc>";
        Document doc = parseTree(input);
        Element rootElement = (Element) doc.getNodes().get(0).getNodeName();
        Element childElement = (Element) rootElement.getElementsByTagName("child")[0];
        Token doctypeToken = parseTree("<doctype/>");
        childElement.appendChild(doctypeToken);
    }

    @Test
    public void testPopStackToClose() throws IOException {
        String input = "<doc><root><child/></root></doc>";
        Document doc = parseTree(input);
        Element rootElement = (Element) doc.getNodes().get(0).getNodeName();
        Token startTag = parseTree("<child/>");
        popStackToClose(startTag, "end");
    }

    @Test
    public void testParseFragmentComment() throws IOException {
        String input = "<doc><root><child/></root></doc>";
        Document doc = parseTree(input);
        Element rootElement = (Element) doc.getNodes().get(0).getNodeName();
        Token commentToken = parseTree("<comment/>");
        rootElement.appendChild(commentToken);
    }

    @Test
    public void testParseFragmentCharacter() throws IOException {
        String input = "<doc><root><child></root></doc>";
        Document doc = parseTree(input);
        Element rootElement = (Element) doc.getNodes().get(0).getNodeName();
        Token characterToken = parseTree("<char>abc</char>");
        rootElement.appendChild(characterToken);
    }
}
