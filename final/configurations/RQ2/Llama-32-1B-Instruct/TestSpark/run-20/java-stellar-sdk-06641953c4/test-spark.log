        String accountId = UUID.randomUUID().toString();
        KeyPair keyPair = KeyPair.fromAccountId(accountId);
        Preconditions.checkNotNull(keyPair, "Expected non-null KeyPair");
    }

    @Test
    public void testFromXdrPublicKey_SingleSeedShouldReturnXdrPublicKey() {
        KeyPair keyPair = KeyPair.fromXdrPublicKey(PUBLIC_KEY);
        Preconditions.checkNotNull(keyPair, "Expected non-null KeyPair");
    }

    @Test
    public void testFromXdrSignerKey_SingleSeedShouldReturnXdrSignerKey() {
        SignerKey signerKey = new SignerKey(BIP39_seed);
        KeyPair keyPair = KeyPair.fromXdrSignerKey(signerKey);
        Preconditions.checkNotNull(keyPair, "Expected non-null KeyPair");
    }

    @Test
    public void testFromBip39Seed_SingleSeedShouldReturnBip39SeedPublicKey() {
        byte[] bip39Seed = BIP39 seeds[SECRET_SEED.length() / 2];
        KeyPair keyPair = KeyPair.fromSecretSeed(bip39Seed);
        Preconditions.checkNotNull(keyPair, "Expected non-null KeyPair");
    }

    @Test
    public void testFromAccountId_SingleSeedShouldReturnAccountId() {
        String accountId = UUID.randomUUID().toString();
        KeyPair keyPair = KeyPair.fromAccountId(accountId);
        Preconditions.checkNotNull(keyPair, "Expected non-null KeyPair");
        Preconditions.assertEquals(accountId, keyPair.getAccountId());
    }

    @Test
    public void testFromPublicKey_SingleSeedShouldReturnPublicKey() {
        byte[] publicKey = BIP39 seeds[SECRET_SEED.length() / 2];
        KeyPair keyPair = KeyPair.fromSecretSeed(publicKey);
        Preconditions.checkNotNull(keyPair, "Expected non-null KeyPair");
    }

