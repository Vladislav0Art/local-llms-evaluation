        Preconditions.assertEquals(EdDSAPrivateKeySpec.valueOf(SECRET_SEED), keyPair.getPublicSpec());
        Preconditions.assertEquals(EdDSAPublicKeySpec.valueOf(""), keyPair.getPrivateSpec());
    }

