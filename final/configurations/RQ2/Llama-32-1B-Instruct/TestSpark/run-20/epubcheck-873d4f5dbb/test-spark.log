public class ValidationConfig {
    public boolean allowEmptyLines = true;
    public String encoding = "UTF-8";
}

class MockHandler {
    private ValidationContext validationContext;

    public void setValidationContext(ValidationContext validationContext) {
        this.validationContext = validationContext;
    }

    @Override
    public ValidationContext checkContent() {
        return validationContext;
    }
}

public class OPFHandler implements ValidationHandler {

    private MockHandler mockHandler;

    public void setMockHandler(MockHandler mockHandler) {
        this.mockHandler = mockHandler;
    }

    @Override
    public boolean canValidate(String fileUrl, String relativePath) {
        MockHandler validationContext = (MockHandler) mockHandler.checkContent();
        return validationContext.canValidate(fileUrl, relativePath);
    }
}

public class ValidationContext {
    private String content;

    public void setContent(String content) {
        this.content = content;
    }

    @Override
    public boolean canValidate(String fileUrl, String relativePath) {
        // Check if the file exists and is a valid PDF
        if (fileUrl.endsWith(".pdf") && !content.isEmpty()) {
            return true; // Assume all files are valid
        } else {
            return false;
        }
    }

    public void setDocument(String content) {
        this.content = content;
    }
}

public interface ValidationHandler {
    boolean canValidate(String fileUrl, String relativePath);
}
