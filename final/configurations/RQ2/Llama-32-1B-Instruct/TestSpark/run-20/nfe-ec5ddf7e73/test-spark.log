        Map<String, String> mdfInfoModalRodoviarioVeiculoReboque = new HashMap<>();
        mdfInfoModalRodoviarioVeiculoReboque.put("codigo_interno", "12345");
        mdfInfoModalRodoviarioVeiculoReboque.put("placa", "ABC123");
        mdfInfoModalRodoviarioVeiculoReboque.put("renavam", "2022");
        mdfInfoModalRodoviarioVeiculoReboque.put("tara", "SP");

        System.out.println(getCodigoInterno(mdfInfoModalRodoviarioVeiculoReboque));
        System.out.println(getPlaca(mdfInfoModalRodoviarioVeiculoReboque));
        System.out.println(getRenavam(mdfInfoModalRodoviarioVeiculoReboque));
        System.out.println(getTara(mdfInfoModalRodoviarioVeiculoReboque));
        System.out.println(getCapacidadeKG(mdfInfoModalRodoviarioVeiculoReboque));
