        } else {
            return 0;
        }
    }

    public static String getCapacidadeM3(Map<String, String> mdfInfoModalRodoviarioVeiculoReboque) {
        if (mdfInfoModalRodoviarioVeiculoReboque != null && !mdfInfoModalRodoviarioVeiculoReboque.isEmpty()) {
            return mdfInfoModalRodoviarioVeiculoReboque.get("capacidade_m3");
        } else {
            return "";
        }
    }

