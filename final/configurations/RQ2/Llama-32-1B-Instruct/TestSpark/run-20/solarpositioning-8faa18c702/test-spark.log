        LocalDate forDate = LocalDate.now();
        when(estimate(forDate)).thenReturn(Math::pow);
        double expected = 0.0;
        assertNotEquals(Double.NaN, estimate(forDate));
        assertEquals(expected, estimate(forDate), 1e-9);
