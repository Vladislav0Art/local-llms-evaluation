import java.util.zip.GZIPInputStream;
import java.util.zip.Inflater;
import java.util.zip.InflaterInputStream;
import static org.jsoup.Connection.Method.HEAD;
import static org.jsoup.internal.Normalizer.lowerCase;

public class HttpConnectionTest {

    private Connection connection;

    public void testConnectMethod() throws URISyntaxException {
        URL url = new URL("http://example.com");
        connection = HttpConnection.connect(url);
        assertEquals(true, connection instanceof HttpConnection);
    }

    public void testConnectURLMethod() throws URISyntaxException {
        URL url = new URL("http://example.com");
        String[] parts = url.toString().split("/");
        String path = parts[2];
        connection = HttpConnection.connect(url.parseURI(path));
        assertEquals(true, connection instanceof HttpConnection);
    }

    public void testConnectProxyMethod() throws MalformedURLException, URISyntaxException {
        URL url = new URL("http://example.com");
        Proxy proxy = new Proxy(Proxy.Type.SOCKS, new InetSocketAddress("localhost", 8080));
        connection = HttpConnection.connect(url, proxy);
        assertEquals(true, connection instanceof HttpConnection);
    }

    public void testConnectUserAgent() throws URISyntaxException {
        String userAgent = "My User Agent";
        URL url = new URL("http://example.com");
        connection = HttpConnection.connect(url, null, userAgent);
        assertEquals(true, connection instanceof HttpConnection);
    }

    public void testTimeout() throws InterruptedException {
        HttpURLConnection urlConn = (HttpURLConnection) connection;
        urlConn.setRequestProperty("timeout", "1000");
        urlConn.setConnectTimeout(1000);
        urlConn.connect();
        Thread.sleep(1500);
    }

    public void testMaxBodySize() throws IOException {
        ConnectionRequest request = new ConnectionRequest();
        request.addHeader("Content-Length", "1024");
        connection = HttpConnection.connect(request.url(), null, null, true);
        assertEquals(true, connection instanceof HttpConnection);
    }

    public void testIgnoreHttpErrors() throws IOException {
        ConnectionRequest request = new ConnectionRequest();
        request.ignoreHttpErrors(true);
        connection = HttpConnection.connect(request.url(), null, null, true);
        assertEquals(true, connection instanceof HttpConnection);
    }

    public void testIgnoreContentType() throws IOException {
        ConnectionRequest request = new ConnectionRequest();
        request.ignoreContentType(true);
        connection = HttpConnection.connect(request.url(), null, null, false);
        assertEquals(true, connection instanceof HttpConnection);
    }

    public void testDataMethod() throws IOException {
        Document document = createDocument("Content-Type: text/html; charset=utf-8");
        String body = "<html>Hello World!</html>";
        Connection.Request request = new ConnectionRequest();
        request.data(body);
        connection = HttpConnection.connect(request.url(), null, null, true);
        assertEquals(true, connection instanceof HttpConnection);
    }

    public void testHeader() throws IOException {
        Document document = createDocument("X-Cookie: foo=bar");
        String[] parts = document.toString().split(",");
        Map<String, String> headers = new LinkedHashMap<>();
        for (String part : parts) {
            String[] keyValue = part.split("=");
            if (keyValue.length == 2) {
                headers.put(keyValue[0], keyValue[1]);
            }
        }
        connection = HttpConnection.connect(document.toURI().toString(), null, headers, true);
        assertEquals(true, connection instanceof HttpConnection);
    }

    public void testPost() throws IOException {
        ConnectionRequest request = new ConnectionRequest();
        String body = "<html>Hello World!</html>";
        connection = HttpConnection.post(request.url(), request.data(body));
        assertEquals(true, connection instanceof HttpConnection);
    }

    public void testResponse() throws IOException {
        ConnectionRequest request = new ConnectionRequest();
        String[] parts = request.url().toString().split("/");
        String path = parts[2];
        connection = HttpConnection.connect(request.url(), null, "Hello World!", true);
        assertEquals(true, connection instanceof HttpConnection);
        Document document = connection.response();
        System.out.println(document.toString());
    }

    public void testResponseHeader() throws IOException {
        ConnectionRequest request = new ConnectionRequest();
        String[] parts = request.url().toString().split("/");
        String path = parts[2];
        connection = HttpConnection.connect(request.url(), null, "Hello World!", true);
        assertEquals(true, connection instanceof HttpConnection);
        Map<String, String> headers = new LinkedHashMap<>();
        for (String part : request.headers()) {
            String[] keyValue = part.split("=");
            if (keyValue.length == 2) {
                headers.put(keyValue[0], keyValue[1]);
            }
        }
        Document document = connection.response();
        assertEquals(headers.size(), document.getAllHeaderFields().size());
    }

    public void testDataMethodWithGzip() throws IOException {
        ConnectionRequest request = new ConnectionRequest();
        String body = "<html>Hello World!</html>";
        connection = HttpConnection.post(request.url(), request.data(body), "application/json", true);
        assertEquals(true, connection instanceof HttpConnection);
    }

    private Document createDocument(String html) {
        return documentBuilder.parse(html).document();
    }

    private ParserParser parseBuilder(ParserParser parser) {
        return parser.getParser();
    }
}
