        Elements links = new Elements(doc.getElementsByTag("a"));
        for (Element link : links) {
            if (!link.tagName().equals("p")) {
                String...links = {doc.getElementsByTag("p").get(0)};
                testLinks(link, links[0]);
            }
        }

        Elements images = new Elements(doc.getElementsByTag("img"));
        for (Element image : images) {
            if (!image.tagName().equals("p")) {
                String...images = {"doc.getElementsByTag(" + doc.getElementsById(String.valueOf(5 * i)).get(1).id() + "").get(0)};
                testImages(image, images[0]);
            }
        }

        Elements bodyTags = new Elements(doc.getElementsByTagNames("body"));
        for (Element tag : bodyTags) {
            if (!tag.tagName().equals("div")) {
                String...tags = {"a", "img"};
                testTags(tag, tags);
            }
        }
    }

    private void testTags(Element tag, String...args) {
        for (int i = 0; i < args.length; i++) {
            if (!tag.tagName().equals("div")) {
                Element element = doc.createElementTag("p").text(String.valueOf(i));
                elements.add(element);
                for (int j = 0; j < args[i].length; j++) {
                    tag.appendChild(doc.createTextNode(args[i][j]));
                }
                testTags(tag, tags);
            } else {
                Elements children = new Elements(tag.getFirstChild());
                for (String arg : args) {
                    Element element = doc.createElementTag(arg).text(String.valueOf(i));
                    children.appendChild(element);
                }
                testTags(tag, elements);
            }
        }
    }

    private void testLinks(Element link, String...args) {
        if (!link.tagName().equals("p")) {
            Elements children = new Elements(link.getFirstChild());
            for (int i = 0; i < args.length; i++) {
                Element element = doc.createElementTag("a").attr("href", "#" + i).attr("target", "_blank");
                children.appendChild(element);
                if (!element.tagName().equals("p")) {
                    testLinks(link, elements);
                }
            }
        } else {
            Elements children = new Elements(link.getFirstChild());
            for (String arg : args) {
                Element element = doc.createElementTag(arg).text(String.valueOf(i));
                children.appendChild(element);
            }
            testLinks(link, children);
        }
    }

    private void testImages(Element image, String...args) {
        if (!image.tagName().equals("p")) {
            Elements children = new Elements(image.getFirstChild());
            for (int i = 0; i < args.length; i++) {
                Element element = doc.createElementTag("a").attr("href", "#" + i).attr("target", "_blank");
                children.appendChild(element);
                if (!element.tagName().equals("p")) {
                    testImages(image, elements);
                }
            }
        } else {
            Elements children = new Elements(image.getFirstChild());
            for (String arg : args) {
                Element element = doc.createElementTag(arg).text(String.valueOf(i));
                children.appendChild(element);
            }
            testImages(image, children);
        }
    }

