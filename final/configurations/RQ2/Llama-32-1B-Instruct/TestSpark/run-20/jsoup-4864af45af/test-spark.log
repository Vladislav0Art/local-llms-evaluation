                elements.add(tag, tag);
            }
            for (int j = 0; j < 3; j++) {
                Element link = doc.createElementTag("a").attr("href", "#" + i).attr("target", "_blank");
                link.text("https://example.com" + i);
                tags.get(5 * i).appendChild(link);
            }
            for (int j = 0; j < 3; j++) {
                Element img = doc.createElementTag("img").attr("src", "#" + i);
                tags.get(6 * i).appendChild(img);
            }
        }

        Elements elements = new Elements(doc.getElementsByTag("p"));
        for (Element tag : elements) {
            if (!tag.tagName().equals("a") && !tag.tagName().equals("b")) {
                String...tags = {"a", "img"};
                testTags(tag, tags);
            }
