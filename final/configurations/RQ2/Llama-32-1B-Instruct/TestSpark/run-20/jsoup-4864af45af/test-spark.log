public class SafelistTest {

    private static Document doc;

    @BeforeEach
    public void setUp() {
        doc = new Document();
        doc.appendChild(doc.createDocumentElement());
        Elements tags = new Elements("a", "img");
        for (int i = 0; i < 10; i++) {
            tags.add(doc.createElementTag("p"));
            for (int j = 0; j < 5; j++) {
