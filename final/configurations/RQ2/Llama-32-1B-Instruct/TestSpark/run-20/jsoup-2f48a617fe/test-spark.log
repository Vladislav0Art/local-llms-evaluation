import org.jsoup.nodes.Comment;
import org.jsoup.nodes.Document;
import org.jsoup.parser.Parser;
import java.io.IOException;

public class CommentTest {

    @Test
    public void commentToString() {
        Document document = new Document();
        document.addTag(new Comment("This is a test comment"));
        System.out.println(CommentTest.class.getDeclaredField("nodeName").get(document));
    }

    @Test
    public void commentIsXmlDeclaration() {
        String xmlDeclaration = "<!DOCTYPE html><html></html>";
        Comment comment = new Comment(xmlDeclaration);
        assert comment.isXmlDeclaration();
    }

    @Test
    public void commentAsXmlDeclaration() {
        Comment comment = new Comment("<!DOCTYPE html><html></html>");
        XmlDeclaration asXmlDecl = comment.asXmlDeclaration();
        assert asXmlDecl == null;
    }

    @Test
    public void commentDataToString() {
        String data = "This is a test comment";
        Document document = new Document();
        document.addTag(new Comment(data));
        System.out.println(document.data().toString());
    }

    @Test
    public void commentDataAsXmlDeclaration() {
        String xmlDeclaration = "<!DOCTYPE html><html></html>";
        Comment comment = new Comment(xmlDeclaration);
        assert comment.getData() == null;
    }
}
