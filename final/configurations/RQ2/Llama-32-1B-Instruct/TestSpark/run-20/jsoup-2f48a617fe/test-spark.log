    public void addTag(Node node, String tagName) {
        node.setTag(tagName);
    }

    @Override
    public void removeTag(Node node, String tagName) {
        if (node.getTagName().equals(tagName)) {
            node.removeTag(tagName);
        }
    }

    @Override
    public void tagToString(Node node) {
        System.out.println(node.getTagName());
    }
}

class TaggedNode extends Node {
    private TagGenerator tagGenerator;

    public TaggedNode(TagGenerator tagGenerator) {
        this.tagGenerator = tagGenerator;
    }

    @Override
    public String toString() {
        return super.toString() + " - Tag: " + tagGenerator.getTagName();
    }
}

public class Main {
    public static void main(String[] args) {
        TagGenerator tagGenerator = new TagGenerator();

        Document document = new Document();
        Node root = new Node();
        tagGenerator.addTag(root, "div");
        tagGenerator.addTag(root, "span");

        TaggedNode taggedDiv = new TaggedNode(tagGenerator);
        TaggedNode taggedSpan = new TaggedNode(tagGenerator);

        System.out.println("Tag: div - Tag: span\n" + taggedDiv.toString());
        System.out.println("Tag: div - Tag: span\n" + taggedSpan.toString());

        document.setRoot(root);

        root.addTag(tagedDiv, "class");
        root.addTag(taggedSpan, "style");

        System.out.println("Tag: div - Tag: class");
        System.out.println("Tag: span - Tag: style");

        tagGenerator.tagToString(document.root);
    }
}

