import java.util.Map;

public class Solution {
    public int maximumNumber(String[] nums, String target) {
        return Math.max(findMaximum(nums), findMaximum(target));
    }

    private int findMaximum(Map<String, Integer> map) {
        if (!map.containsKey("1")) return 0;
        Map<Integer, Boolean> map2 = new HashMap<>();
        for (Map.Entry<String, Integer> entry : map.entrySet()) {
            String key = entry.getKey();
            int value = entry.getValue();
            if (!key.contains("-") || !isDigit(key)) continue;
            if (map2.containsKey(value)) return 0;
            map2.put(value, true);
            while (value < 9) {
                if (map2.containsKey(value + 1)) return 0;
                value *= 10;
            }
        }
        return Integer.parseInt(String.valueOf(map.get("9")));
    }

    private boolean isDigit(String s) {
        for (char c : s.toCharArray()) {
            if (!Character.isDigit(c)) return false;
        }
        return true;
    }

    public String buildJobName(String version, int suffix) {
        StringBuilder sb = new StringBuilder();
        while (version.length() > 0 && !isDigit(version.charAt(version.length() - 1))) {
            sb.append(version.charAt(version.length() - 1));
            version = version.substring(0, version.length() - 1);
        }
        sb.append("-").append(suffix).append(".").append(version);
        return sb.toString();
    }

    public String buildNumber(String number) {
        int count = 0;
        for (char c : number.toCharArray()) {
            if (!Character.isDigit(c)) break;
            count++;
        }
        StringBuilder sb = new StringBuilder();
        while (count > 0) {
            sb.append(c);
            count--;
        }
        return sb.toString();
    }

    public String getCommit(String number) {
        int count = 0;
