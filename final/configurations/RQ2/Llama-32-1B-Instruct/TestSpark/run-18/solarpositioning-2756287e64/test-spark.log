        assert azimuth == 270;
    }

    @Test
    public void testGetAzimuth_CoordinatedUniversalTime() {
        int azimuth = SolarPositionGenerator.getAzimuth(-40.7128, 114.1090);
        assert azimuth == 90;
    }
}
