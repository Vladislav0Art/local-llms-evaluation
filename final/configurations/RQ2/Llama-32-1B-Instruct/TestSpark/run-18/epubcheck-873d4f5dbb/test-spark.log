public class OPFChecker30Test {

    @Test
    public void testInitHandler() {
        OPFChecker30 checker = new OPFChecker30(new ValidationContext());
        assertEquals(true, checker.initHandler());
    }

    @Test
    public void testCheckPackage() {
        assertTrue(OPFChecker30.isAudioType("audio");
                &&OPFChecker30.isBlessedAudioType("audio");
                &&OPFChecker30.isVideoType("video");
                &&OPFChecker30.isBlessedVideoType("video"));
    }

    @Test
    public void testCheckContent() {
        assertTrue(OPFChecker30.isFontType("font");
                &&OPFChecker30.isBlessedFontType("font");
                &&OPFChecker30.isBlessedScriptType("script"));
    }

    @Test
    public void testCheckItem_OPFItem() {
        OPFItem item = new OPFItem();
        checkItem(item, null);
    }

    @Test
    public void testCheckItemAfterResourceValidation_OPFItem() {
        OPFItem item = new OPFItem();
        checkItemAfterResourceValidation(item);
    }

    @Test
    public void testCheckSpineItem_OPFItem() {
        OPFItem item = new OPFItem();
        checkSpineItem(item, null);
    }

    @Test
    public void testGetPreferredMediaType_OPFTypeMediaTypes() {
        assertTrue(OPFChecker30.getPreferredMediaType("audio", "file:///path/to/audio.mp3").equals("audio"));
        assertTrue(OPFChecker30.getPreferredMediaType("video", "file:///path/to/video.mp4").equals("video"));
        assertTrue(OPFChecker30.getPreferredMediaType("common", "file:///path/to/common.mp4").equals("common"));
    }
}
