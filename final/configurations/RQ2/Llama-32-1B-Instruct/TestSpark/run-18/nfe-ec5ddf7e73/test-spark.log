        car1.setCodigoInterno("123");
        car1.setPlaca("ABC123");
        car1.setRenavam(1000);
        car1.setTara(10);
        car1.setCapacidadeKG(5000);
        car1.setCapacidadeM3(10000);

        System.out.println("Carro 1: Codigo Interno = " + car1.getCodigoInterno());
        System.out.println("Carro 1: Placa = " + car1.getPlaca());
        System.out.println("Carro 1: Renavam = " + car1.getRenavam() + " m3");
        System.out.println("Carro 1: Area M3 = " + car1.calcularAreaM3());

        // Test 2
        car2.setCodigoInterno("456");
        car2.setPlaca("DEF456");
        car2.setRenavam(2000);
        car2.setTara(20);
        car2.setCapacidadeKG(7000);
        car2.setCapacidadeM3(15000);

        System.out.println("Carro 2: Codigo Interno = " + car2.getCodigoInterno());
        System.out.println("Carro 2: Placa = " + car2.getPlaca());
        System.out.println("Carro 2: Renavam = " + car2.getRenavam() + " m3");
        System.out.println("Carro 2: Area M3 = " + car2.calcularAreaM3());

        // Test 3
        System.out.println("\nTeste de Validade:");
        String input1 = "123";
        System.out.println("Validacao do Codigo Interno: " + Carro.testaCodigoInterno(input1));

        String input2 = "999";
        System.out.println("Validacao do Codigo Interno: " + !Carro.testaCodigoInterno(input2));
    }

    public static boolean testaCodigoInterno(String codigoInterno) {
        return Carro.getCodigoInterno().equals(codigoInterno);
    }
}
