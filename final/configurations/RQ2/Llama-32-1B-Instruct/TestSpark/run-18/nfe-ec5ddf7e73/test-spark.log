        double renavamValido = 1000.0;
        double taraValido = 10.0;
        int capacidadeKGValida = 5000;
        int capacidadeM3Valida = 10000;

        if (carro.getCodigoInterno().equals(codigoInternoValido) &&
                carro.getRenavam() == renavamValido && 
                carro.getTara() == taraValido && 
                carro.getCapacidadeKG() == capacidadeKGValida && 
                carro.getCapacidadeM3() == capacidadeM3Valida) {
