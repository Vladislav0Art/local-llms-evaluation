    public void testKeySet() {
        verify(keySet);
        map.forEach((k, v) -> entrySet.add(new AbstractMap.SimpleEntry<>(k, v)));
        assert !entrySet.isEmpty();
    }

    @Test
    public void testGetByName() throws IOException {
        T term = (T) this.get("term");
