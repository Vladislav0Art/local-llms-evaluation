import java.util.*;

public class AbstractMapExample {

    private Map<String, Object> map = new HashMap<>();

    public void put(String key, Object value) {
        this.map.put(key, value);
    }

    public boolean containsKey(String key) {
        return this.map.containsKey(key);
    }

    public Set<Object> getKeys() {
        return this.map.keySet();
    }

    public Collection<Map.Entry<String, Object>> entrySet() {
        return this.map.entrySet();
    }

    public void forEach(Object o, Consumer<? super ?, ?> action) {
        for (Map.Entry<String, Object> entry : this.getEntryMap()) {
            action.accept(entry.getKey(), entry.getValue());
        }
    }

    private Map<String, Object> getEntryMap() {
        return new HashMap<>(this.map);
    }

    public boolean isEmpty() {
        return this.map.isEmpty();
    }

    public int size() {
        return this.map.size();
    }

    public String toString() {
        return this.map.toString();
    }
}

public class GrammaticalTermImpl extends AbstractMap.Entry<String, Object> {

    private final String term;

    public GrammaticalTermImpl(String term) {
        this.term = term;
    }

    @Override
    public String getKey() {
        return this.term;
    }

    @Override
    public Object getValue() {
        return this.term;
    }
}

