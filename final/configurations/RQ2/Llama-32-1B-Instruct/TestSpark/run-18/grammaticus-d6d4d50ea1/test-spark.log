        Map<String, Object> map = new HashMap<>();
        for (int i = 0; i < values.length; i++) {
            map.put("value" + i, values[i]);
        }
        return map;
    }

    public static void main(String[] args) {

        // Test 1
        AbstractMapExample example = new AbstractMapExample();
        example.put("term", "value0");
        example.put("term2", "value1");

        GrammaticalTermImpl term1 = new GrammaticalTermImpl("value1");
        GrammaticalTermImpl term2 = new GrammaticalTermImpl("value0");

        // Test 2
