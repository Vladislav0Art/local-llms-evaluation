        example2.put("term", "value0");

        Set<GrammaticalTermImpl> gramTerms = example.getEntrySet();

        for (GrammaticalTermImpl gram : gramTerms) {
            assertEquals(term1.term, gram.getKey());
            assertEquals(term2.term, gram.getValue().getKey());
        }
