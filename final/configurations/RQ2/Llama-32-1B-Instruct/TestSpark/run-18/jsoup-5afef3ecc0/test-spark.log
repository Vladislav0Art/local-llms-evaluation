Here's a Java code that uses the URI class to create URLs from base URLs and keys:

```java
import java.net.URI;
import java.util.HashMap;
import java.util.Map;

public class Main {
    public static String buildUrl(String baseUrl, Map<String, String> keyPairs) throws URISyntaxException {
        URI uri = new URI(baseUrl);
        StringBuilder queryStringBuilder = new StringBuilder();
        for (Map.Entry<String, String> entry : keyPairs.entrySet()) {
            if (queryStringBuilder.length() > 0) {
                queryStringBuilder.append("&");
            }
            queryStringBuilder.append(entry.getKey()).append("=").append(entry.getValue());
        }

        return uri.getScheme() + "://" + uri.getHost() + "?" + queryStringBuilder.toString().toLowerCase();
    }

    public static void main(String[] args) throws URISyntaxException {
        // Create instances of the classes
        String baseUrl = "http://example.com";
        Map<String, String> keyPairs = new HashMap<>();
        keyPairs.put("key1", "value1");
        keyPairs.put("key2", "value2");

        // Test methods
        String actualUrl = buildUrl(baseUrl, keyPairs);
        System.out.println(actualUrl);

        assert actualUrl.equals(buildUrl("http://example.com", keyPairs)) : "Expected strings are not equal";
    }
}

class Connection {
    public Map<String, String> getKeys() {
        return new HashMap<>();
    }

    private class KeyVal {
        private final String key;
        private final String value;

        public KeyVal(String key, String value) {
            this.key = key;
            this.value = value;
        }
    }
}
```

