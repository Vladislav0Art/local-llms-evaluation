public class Main {
    public static String buildUrl(String baseUrl, String key) throws URISyntaxException {
        URI uri = new URI(baseUrl);
        return new URI(uri.getScheme(), uri.getHost(), uri.getPath(), uri.getQuery(), uri.getFragment()).toString();
    }

    public static void main(String[] args) throws URISyntaxException {
        // Create instances of the classes
        URL expectedUrl = buildUrl("http://example.com", "key");
        
        // Test methods
