        Assert.assertEquals(expectedUrl, actualUrl2);

        URI actualUrl3 = new URI("http://example.com", "/abc", "def", null, null).toString();
        assert (actualUrl3.length() == 26) : "Length is incorrect";

        System.out.println("All tests passed");
    }
}

class Connection {
    public String keyVal(String key, String value) {
        return new Connection.KeyVal(key, value);
    }
}
