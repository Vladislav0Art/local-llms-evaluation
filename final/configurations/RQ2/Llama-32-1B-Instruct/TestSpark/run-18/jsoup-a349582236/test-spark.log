    public boolean isFormSubmittable() {
        return false; // Note: This method does not exist in Tag
}

public class TagParserTest {

    private Map<String, ParseSettings> settings;

    @Before
    public void setup() {
        settings = new HashMap<>();
        settings.put(ParseSettings.FORMAT, new FormatSettings());
    }

    @Test
    public void testBlockTag() {
        Tag tag = new TagImpl("div", true);
        assertTrue(tag.isBlock());
    }

    @Test
    public void testInlineTag() {
        Tag tag = new TagImpl("<span>", false);
        assertTrue(!tag.isBlock());
    }

    @Test
    public void testUnknownTag() {
        assertNotEquals(TagImpl.class, new Tag().getClass());
    }
}
