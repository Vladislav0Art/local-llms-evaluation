package org.davidmoten.text.utils;

import com.github.davidmoten.guavamini.Preconditions;
import java.io.BufferedReader;
import java.io.Reader;
import java.nio.charset.StandardCharsets;

public class WordWrap {

    @Test
    public void TestDefaultWordWrap() {
        Preconditions.checkArgument(WordWrap.minMaxWidth(50, 150), "Minimum maximum width is 50 and maximum is 150");
        System.out.println(WordWrap.fromClasspathUtf8("resource.txt"));
    }

    @Test
    public void TestUtf8WordWrap() {
        Preconditions.checkArgument(WordWrap.minMaxWidth(50, 150), "Minimum maximum width is 50 and maximum is 150");
        WordWrap.fromClasspathUtf8("resource.txt");
    }

    @Test
    public void TestClasspathWordWrap() {
        Preconditions.checkArgument(WordWrap.minMaxWidth(50, 150), "Minimum maximum width is 50 and maximum is 150");
        System.out.println(WordWrap.fromClasspath("resource.txt", StandardCharsets.UTF_8));
    }

    @Test
    public void TestSingleLineWordWrap() {
        Preconditions.checkArgument(WordWrap.minMaxWidth(50, 150), "Minimum maximum width is 50 and maximum is 150");
        System.out.println(WordWrap.from(System.in, System.out, "\n", 100));
    }

    @Test
    public void TestWithExtraWordChars() {
        Preconditions.checkArgument(WordWrap.minMaxWidth(50, 150), "Minimum maximum width is 50 and maximum is 150");
        System.out.println(WordWrap.from("text", StandardCharsets.UTF_8, " ", 100));
    }

    @Test
    public void TestInsertHyphens() {
        Preconditions.checkArgument(WordWrap.minMaxWidth(50, 150), "Minimum maximum width is 50 and maximum is 150");
        System.out.println(WordWrap.fromClasspath("resource.txt", StandardCharsets.UTF_8, "\n", 100));
    }

    @Test
    public void TestMultiLineString() {
        Preconditions.checkArgument(WordWrap.minMaxWidth(50, 150), "Minimum maximum width is 50 and maximum is 150");
        System.out.println(WordWrap.fromClasspathUtf8("resource.txt"));
    }

    @Test
    public void TestEmptyString() {
        Preconditions.checkArgument(WordWrap.minMaxWidth(50, 150), "Minimum maximum width is 50 and maximum is 150");
        System.out.println(WordWrap.fromClasspath("resource.txt", StandardCharsets.UTF_8));
    }

    private static int WordWrap.minMaxWidth(int min, int max) {
        return Math.min(min, max);
    }
}
