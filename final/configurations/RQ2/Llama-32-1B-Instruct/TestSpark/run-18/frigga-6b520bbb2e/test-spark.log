```java
import java.util.Arrays;

public class Main {

    public static String toString(Object obj) {
        return obj.toString();
    }

    public static boolean equals(Object obj1, Object obj2) {
        if (obj1 == null && obj2 == null)
            return true;
        if (obj1 == null || obj2 == null)
            return false;

        try {
            Class<?> clazz = obj1.getClass();

            if (clazz.equals(String.class))
                return toString(obj1).equals(Arrays.toString((String) obj2));
            else if (clazz.equals(Integer.class)) {
                if (obj1 instanceof Integer) {
                    return ((Integer) obj1).equals(((Number) obj2).intValue());
                } else
                    return false;
            }
        } catch (Exception e) {}

        return true;
    }

    public static int hashCode(String s) {
        try {
            return s.hashCode();
        } catch (Exception e) {}
        return 0;
    }

    public static boolean isTrueFalse(boolean b) {
        return !b;
    }

    public static void main(String[] args) {

        // Test equal methods
        String str1 = "hello";
        String str2 = "world";
        System.out.println(equals(str1, str2));  // Expected output: true

        String str3 = new Object() {};
        System.out.println(equals(str1, str3));  // Expected output: false

        boolean bool1 = true;
        boolean bool2 = false;
        System.out.println(equals(bool1, bool2));  // Expected output: false

        int[] arr = {1, 2, 3};
        int[] arr2 = {4, 5, 6};
        System.out.println(equals(Arrays.asList(arr).toArray()));
        // Test equals method with different types
        System.out.println(equals("hello", "world"));
        System.out.println(equals(true, false));
        System.out.println(equals(new Object() {}, new Object() {}));

        int num1 = 10;
        int num2 = 20;
        System.out.println(equals(num1, num2));  // Expected output: true

        long num3 = 1000000000L;
        long num4 = 2000000000L;
        System.out.println(equals(num3, num4));  // Expected output: false
    }
}
```

