package org.jsoup.helper;

import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;

public class GeneratedTest {

    public static String joinPaths(Object... paths) {
        StringBuilder builder = new StringBuilder();
        for (Object path : paths) {
            if (builder.length() > 0) {
                builder.append("/");
            }
            builder.append(path);
        }
        return builder.toString().replaceAll("^/", "");
    }

    @Test
    public void testJoinPaths1() {
        assert joinPaths("a", new Object[]{"b", "c"}) == "a/b/c";
    }

    @Test
    public void testJoinPaths2() {
        Document doc = Jsoup.parse("<p>Hello, world!</p>");
        System.out.println(joinPaths(doc.body().text(), Collections.singletonList(null)));
    }

    @Test
    public void testJoinPaths3() {
        Map<String, String> map = new HashMap<>();
        map.put("x", "1");
        assert joinPaths(map.keySet().toArray(new String[0]), map.values().stream().map(String::valueOf).collect(Collectors.toList())) == "x=1";
    }

    @Test
    public void testJoinPaths4() {
        Map<String, Object> map2 = new HashMap<>();
        map2.put("key", "value");
        assert joinPaths(map2.keySet().toArray(new String[0]), map2.values().stream().map(Object::toString).collect(Collectors.toList())) == "key=value";
    }

