import org.junit.Test;
import static org.junit.Assert.assertSame;
import static org.mockito.Mockito.verify;

public class TextNodeTest {

    @Test
    public void test.nodeName() {
        TextNode node = new TextNode("Hello");
        assertEquals("node", node.nodeName());
    }

    @Test
    public void testText() {
        TextNode node = new TextNode("Hello");
        assertEquals("Hello", node.text());
    }

    @Test
    public void testTextFromEncoded() {
        String encodedText = "Hello";
        TextNode node = TextNode.createFromEncoded(encodedText);
        assertEquals("Hello", node.text());
    }

    @Test
    public void testGetWholeText() throws Exception {
        TextNode node = new TextNode("Hello");
        String expected = "Hello";
        verify(node).getWholeText().thenReturn(expected);
        assertSame(expected, node.getWholeText());
    }

    @Test
    public void testIsBlank() {
        TextNode node = new TextNode("");
        assertTrue(node.isBlank());
    }

    @Test
    public void testSplitText() throws Exception {
        TextNode node = new TextNode("Hello World");
        String expected = "Hello\nWorld";
        verify(node).splitText(0).getWholeText().thenReturn(expected);
        assertSame(expected, node.getWholeText());
    }

    @Test
    public void testOuterHtmlHead() throws Exception {
        Document document = new Document();
        Appendable accum = document.append(new StringReader("Hello World"));
        int depth = 1;
        TextNode node = new TextNode("Hello");
        document.outerHtmlHead(accum, depth, null).append().toString();
        verify(document).outerHtmlTail(accum, depth, null);
    }

    @Test
    public void testOuterHtmlTail() throws Exception {
        Document document = new Document();
        Appendable accum = document.append(new StringReader("Hello World"));
        int depth = 1;
        TextNode node = new TextNode("Hello");
        document.outerHtmlHead(accum, depth, null).append().toString();
        verify(document).outerHtmlTail(accum, depth, null);
    }

    @Test
    public void testToString() {
        TextNode node = new TextNode("Hello World");
        assertEquals("<text> Hello World </text>", node.toString());
    }
}
