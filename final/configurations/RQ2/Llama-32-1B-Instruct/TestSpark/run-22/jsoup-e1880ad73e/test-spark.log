import java.util.HashMap;
import java.util.Map;

public class UrlBuilder {
    private Map<String, Object> keyValues = new HashMap<>();

    public void appendKeyVal(String key, Object value) throws MalformedURLException, URISyntaxException {
        if (key == null || value == null) {
            throw new NullPointerException("Both keys and values must be provided.");
        }

        try {
            // Append a key-value pair
            keyValues.put(key, value);
