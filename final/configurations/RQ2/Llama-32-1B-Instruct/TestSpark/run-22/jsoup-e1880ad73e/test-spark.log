        }
    }

    public void appendUrl(URI uri) throws MalformedURLException, URISyntaxException {
        String path = new URI(uri.getScheme(), uri.getHost(), uri.getPort(), uri.getPath(), uri.getQuery(), uri.getFragment()).getPath();

        // Create the URL
        try {
            builder.appendUrl(new URI("https://example.com", "path/to/resource", null, null, "", ""));
        } catch (MalformedURLException e) {
            System.out.println("Test 8: appendUrl() - MalformedURLException");
        }
    }
}
