        String parameter = (String) getAnnotationMemberValue(annot, "parameter");
        assertEquals("test-parameter-value", parameter);
    }

    public void testHasPropertyNameCustomization() {
        boolean has = jclass.hasPropertyNameCustomization();
        assertTrue(has);
    }

    public void testHiddenClass() {
