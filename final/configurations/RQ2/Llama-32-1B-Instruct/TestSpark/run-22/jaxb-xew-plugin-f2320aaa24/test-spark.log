        assertEquals("test-value-1", value);
    }

    public void testGenerableToString() {
        String s = generableToString(jclass, "testAttribute");
        assertEquals("testAttribute", s);
    }

    public void testGetAnnotation() {
        JAnnotatable annot = jclass.getAnnotation("testAnnotation");
        Object annotationValue = getAnnotationValue(annot);
        assertNotNull(annotationValue);
        assertEquals("test-annotation-value", annotationValue.toString());
    }

    public void testGetAnnotationMember() {
        JAnnotatable annot = jclass.getAnnotation("testAnnotation");
        List<JCMethod> methods = (List<JCMethod>) getAnnotationMember(annot, "methods");
        assertNotNull(methods);
        assertEquals(1, methods.size());
    }

