        Object privateValue = getPrivateField(jclass, "test-attribute").get(jclass, "private-value");
        assertEquals("test-private-value", (String) privateValue.toString());
        jclass.setPrivateField(jclass, "test-attribute", privateValue);
        assertNotNull(getPrivateField(jclass, "test-attribute"));
