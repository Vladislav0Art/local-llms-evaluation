import org.junit.Test;
import static org.junit.Assert.assertEquals;

public class W3CDomHelperTest {

    @Test
    public void testNamespaceAware() {
        Element element = createElement("test", "attr1=0", "attr2");
        Document document = new Document();
        W3CDomHelper.w3cdom(element, document);
        assertEquals(0, W3CDomHelper.extractAttributeValues(element, null));
    }

    @Test
    public void testNamespaceAware(boolean namespaceAware) {
        Element element = createElement("test", "attr1=0", "namespace=abc");
        Document document = new Document();
        W3CDomHelper.w3cdom(element, document);
        assertEquals(0, W3CDomHelper.extractAttributeValues(element, null));
    }

    @Test
    public void testNamespaceAware(Map<String, String> properties) {
        Properties propertiesMap = new Properties();
        propertiesMap.put("attr1", "value1");
        propertiesMap.put("attr2", "value2");
        Element element = createElement("test", "attr1=value1", propertiesMap);
        Document document = new Document();
        W3CDomHelper.w3cdom(element, document);
        assertEquals(0, W3CDomHelper.extractAttributeValues(element, null));
    }

    @Test
    public void testConvert() {
        Document doc = convert(new Document());
        assertEquals(doc.toString(), W3CDomHelper.convertToString(doc));
    }

    @Test
    public void testAsString() {
        Document doc = asString(new Document(), new Properties());
        assertEquals(doc.toString(), W3CDomHelper.asString(doc, null));
    }

    private Element createElement(String name, String... attributes) {
        NodeTraversor tr = document.createElementNS("http://www.w3.org/1999/xhtml", name);
        for (int i = 0; i < attributes.length; i++) {
            Attribute attr = document.createAttribute(attributes[i]);
            tr.setAttribute(attr);
        }
        return tr;
    }

    private void extractAttributeValues(Element element, Map<String, String> properties) {
        for (int i = 0; i < element.attributes.length; i++) {
            if (properties != null && !properties.containsKey(element.attributes[i].getName())) {
                continue;
            }
            W3CDomHelper.extractValue(element, i);
        }
    }

    private void extractValue(Element element, int index) {
        String value = "";
        for (int i = 0; i < element.attributes.length; i++) {
            if (!element.attributes[i].getName().equals("value")) {
                break;
            }
            value += element.attributes[i].getValue() + " ";
        }
        W3CDomHelper.extractValue(element, index);
    }

    private Document convert(Document document) {
        return new Document();
    }

    private String asString(Document doc, Map<String, String> properties) {
        Properties propertiesMap = new Properties();
        for (int i = 0; i < properties.size(); i++) {
            propertiesMap.put(properties.getKey(i), properties.get(i));
        }
        return W3CDomHelper.asString(doc, propertiesMap);
    }

    private void W3CDomHelper.extractValue(Element element, int index) {
        String value = "";
        for (int i = 0; i < element.attributes.length; i++) {
            if (!element.attributes[i].getName().equals("value")) {
                break;
            }
            value += element.attributes[i].getValue() + " ";
        }
        for (int i = index + 1; i < element.attributes.length; i++) {
            String attrName = element.attributes[i].getName();
            if (!attrName.startsWith("value ")) {
                break;
            }
            W3CDomHelper.extractValue(element, i);
        }
    }

}
