import org.junit.Test;

public class TokenizerTest {

    private Tokenizer tokenizer = new Tokenizer("1 + 2", ExpressionConfiguration.empty());

    @Test
    public void parseStringLiteral() throws ParseException {
        String expectedToken = "Number";
        List<Token> tokens = tokenizer.parse();
        assertEquals(1, tokens.size());
        assertEquals(expectedToken, tokens.get(0).toString());
    }

    @Test
    public void parseIdentifier() throws ParseException {
        String expectedToken = "a";
        String actualToken = (String) tokenizer.parseStringLiteral().toString();
        assertEquals(expectedToken, actualToken);
    }

    @Test
    public void parseNumber() throws ParseException {
        String expectedToken = "Number";
        List<Token> tokens = tokenizer.parse();
        assertEquals(1, tokens.size());
        assertEquals(expectedToken, tokens.get(0).toString());
    }

    @Test
    public void parseKeyword() throws ParseException {
        String expectedToken = "if";
        List<Token> tokens = tokenizer.parse();
        assertEquals(1, tokens.size());
        assertEquals(expectedToken, tokens.get(0).toString());
    }

    @Test
    public void parseOperatorPlus() throws ParseException {
        String expectedToken = "+";
        List<Token> tokens = tokenizer.parse();
        assertEquals(1, tokens.size());
        assertEquals(expectedToken, tokens.get(0).toString());
