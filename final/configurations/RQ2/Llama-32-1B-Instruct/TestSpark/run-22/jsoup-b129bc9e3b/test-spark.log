```java
import java.util.ArrayList;
import java.util.List;

public class Main {
    public static void main(String[] args) {
        // Declare an empty list to store the result
        List<String> fruitCart = new ArrayList<>();

        // Add fruits to the cart using a lambda expression in a single line
        addFruit("apple", fruitCart);
        
        // Another method call is made using the same lambda expression
        addFruit("banana", fruitCart);

        // A third method call is also made using the same lambda expression
        addFruit("cherry", fruitCart);

        // The final line prints the list to the console, which now contains all three fruits
        System.out.println(fruitCart);
    }

    /**
     * A static method that adds a fruit to a given cart.
     * 
     * @param fruit   The fruit to be added to the cart.
     * @param cart    The cart where the fruit will be added.
     */
    private static void addFruit(String fruit, List<String> cart) {
        // This line checks if the fruit is already in the cart
        if (!cart.contains(fruit)) {
            // If it's not, this line adds it to the cart
            cart.add(fruit);
        }
    }
}
```

