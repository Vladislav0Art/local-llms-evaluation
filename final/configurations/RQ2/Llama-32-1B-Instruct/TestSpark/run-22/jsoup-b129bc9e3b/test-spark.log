import java.util.ArrayList;
import java.util.List;

public class Main {
    public static void main(String[] args) {
        // Declare an empty list to store the result
        List<String> result = new ArrayList<>();

        // Use a lambda expression to add strings to the list in a single line
        // The lambda expression takes a string as input and adds it to the list
        addString("string1", result);
        
        // Another method call is made using the same lambda expression
        addString("string2", result);

        // A third method call is also made using the same lambda expression
        addString("string3", result);

        // The final line prints the list to the console, which now contains all three strings
        System.out.println(result);
    }

    /**
     * A static method that adds a string to a given list.
     * 
     * @param str   The string to be added to the list.
     * @param list The list where the string will be added.
     */
    private static void addString(String str, List<String> list) {
        // This line is equivalent to list.add(str), but it's more concise and readable
        list.add(str);
    }
}
```

