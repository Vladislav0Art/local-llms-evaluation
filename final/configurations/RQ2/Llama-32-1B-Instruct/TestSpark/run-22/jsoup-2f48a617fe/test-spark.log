import org.jsoup.nodes.Comment;
import org.jsoup.nodes.Document;
import org.jsoup.parser.ParseSettings;
import org.jsoup.parser.Parser;
import javax.annotation.Nullable;
import java.io.IOException;

public class CommentTest {

    public static void testNodeName() {
        Comment comment = new Comment("This is a test");
        assertEquals("Comment", comment.nodeName());
    }

    public static void testGetData() {
        Comment comment = new Comment("This is a test");
        assertEquals("This is a test", comment.getData());
    }

    public static void test setData() {
        Comment comment = new Comment("This is a test");
        comment.setData("New data");
        assertEquals("New data", comment.getData());
    }

    public static void testOuterHtmlHead() throws IOException {
        Document document = new Document();
        ParseSettings settings = new ParseSettings();
        settings.setDocumentMode(true);
        ParseSettings parserSettings = new ParseSettings();
        parserSettings.setXmlDeclaration(false);

        Comment comment = new Comment(document.toString());
        comment.outerHtmlHead(parserSettings, 0, null).join();
    }

    public static void testOuterHtmlTail() {
        Document document = new Document();
        ParseSettings settings = new ParseSettings();
        settings.setDocumentMode(true);
        ParseSettings parserSettings = new ParseSettings();
        parserSettings.setXmlDeclaration(false);

        Comment comment = new Comment(document.toString());
        comment.outerHtmlTail(parserSettings, 0, null).join();
    }

    public static void testToString() {
        Comment comment = new Comment("This is a test");
        String expected = "Comment";
        assertEquals(expected, comment.toString());
    }

    public static void testClone() {
        Comment original = new Comment("This is a test");
        Comment cloned = original.clone();
        assertEquals(original, cloned);
    }

    public static void testIsXmlDeclaration() {
        Comment comment = new Comment("<!DOCTYPE html><body>Hello World!</body></html>");
        assertTrue(comment.isXmlDeclaration());
    }

    public static void testAsXmlDeclaration() {
        Comment comment = new Comment("<!DOCTYPE html><body>Hello World!</body></html>");
        XmlDeclaration xmlDecl = (XmlDeclaration) comment.asXmlDeclaration();
        assertEquals("<!DOCTYPE html><body>Hello World!</body></html>", xmlDecl.toString());
    }

    public static void testJoin() {
        Document document = new Document();
        Comment comment1 = new Comment(document.toString());
        Comment comment2 = new Comment(document.toString());

        String expected = "<Comment>";
        assertEquals(expected, comment1.outerHtmlHead(parserSettings, 0, null).join());
        assertEquals(expected, comment2.outerHtmlTail(parserSettings, 0, null).join());
    }
}
