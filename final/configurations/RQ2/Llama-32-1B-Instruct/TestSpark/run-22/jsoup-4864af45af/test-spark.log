import java.util.regex.Pattern;
import java.util.regex.Matcher;

public class Safelist {
    private static final String ENFORCEMENT_PATTERN = "(enforce_(\\w+))";

    public boolean removeEnforcedAttribute(String tag) {
        if (tag == null || tag.isEmpty()) {
            return false; // Tag is empty or null
        }
        for (String pattern : getPatterns()) {
            Pattern regex = Pattern.compile(pattern);
            Matcher matcher = regex.matcher(tag);
            if (matcher.find() && matcher.group(1).equals("enforce_")) {
                tag = tag.replaceFirst(pattern, "");
                break;
            }
        }
        return true; // Tag has no enforced attributes
    }

    private static String[] getPatterns() {
        return new String[]{ENFORCEMENT_PATTERN};
    }
}

public class TagParser {
    public boolean isSafeTag(String tag) {
        if (tag == null || tag.isEmpty()) {
            return false; // Tag is empty or null
        }
        Safelist safelist = new Safelist();
        for (String pattern : getPatterns()) {
            Pattern regex = Pattern.compile(pattern);
            Matcher matcher = regex.matcher(tag);
            while (matcher.find()) {
                safelist.removeEnforcedAttribute(matcher.group(0));
            }
        }
        return true; // Tag is safe
    }

    private static String[] getPatterns() {
        return new String[]{"enforce_tag_(\\w+)", "enforce_attribute_\\d+"};
    }

    public void parse(String tag) {
        for (String pattern : getPatterns()) {
            Pattern regex = Pattern.compile(pattern);
            Matcher matcher = regex.matcher(tag);
            while (matcher.find()) {
                safelist.removeEnforcedAttribute(matcher.group(0));
            }
        }
    }
}

public class TagUtils {
    public static String removeEnforceAttributes(String tag) {
        Safelist safelist = new Safelist();
        for (String pattern : getPatterns()) {
            Pattern regex = Pattern.compile(pattern);
            Matcher matcher = regex.matcher(tag);
            while (matcher.find()) {
                safelist.removeEnforcedAttribute(matcher.group(0));
            }
        }
        return tag.replaceAll("[^a-zA-Z_\\[\\]\\s]+", "");
    }

    public static void main(String[] args) {
        TagParser parser = new TagParser();
        System.out.println(parser.isSafeTag("enforce-tag-1")); // true
        System.out.println(parser.isSafeTag("enforce-tag-2")); // false
        System.out.println(parser.tag); // "tag"

        String safeTag = parser.removeEnforceAttributes("enforce-tag-1");
        System.out.println(safeTag); // "tag"
    }
}
