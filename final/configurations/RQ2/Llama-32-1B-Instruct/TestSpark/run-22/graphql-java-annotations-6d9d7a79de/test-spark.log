public class Query {
    public static String buildQuery() {
        return "query { foo }";
    }
}

public class Field {
    private final String field;
    private final List<GraphQLField> fields;

    public Field(String field, List<GraphQLField> fields) {
        this.field = field;
        this.fields = fields;
    }

    @Override
    public String toString() {
        return "Field{" +
                "field='" + field + '\'' +
                ", fields=" + fields +
                '}';
    }
}

public class GraphQLDirective {
    private final String directive;

    public GraphQLDirective(String directive) {
        this.directive = directive;
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;
        GraphQLDirective that = (GraphQLDirective) o;
        return Objects.equals(directive, that.directive);
    }

    @Override
    public int hashCode() {
        return Objects.hash(directive);
    }
}

public class QueryBuilder {
    private String query;

    public QueryBuilder(String query) {
        this.query = query;
    }

    public static Query buildQuery(String query) {
        return new QueryBuilder(query).build();
    }

    public GraphQLDirective addField(String field, GraphQLDirective directive) {
        return new GraphQLDirective(field + " " + directive);
    }

    @Override
    public String toString() {
        return query;
    }
}

public class Type {
    private final GraphQLField[] fields;

    public Type(GraphQLField... fields) {
        this.fields = fields;
    }

    @Override
    public String toString() {
        return "Type{" +
                "fields=" + fields +
                '}';
    }
}
