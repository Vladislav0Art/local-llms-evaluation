```java
import java.io.BufferedReader;
import java.io.BufferedWriter;
import java.io.FileReader;
import java.io.IOException;

public class Main {
    public static String readCSVFile(String filename) {
        try (BufferedReader reader = new BufferedReader(new FileReader(filename))) {
            StringBuilder csvContent = new StringBuilder();
            String line;
            while ((line = reader.readLine()) != null) {
                csvContent.append(line).append("\n");
            }
            return csvContent.toString().trim();
        } catch (IOException e) {
            System.out.println("Error reading file: " + e.getMessage());
            return "";
        }
    }

    public static void writeCSVFile(String filename, String[] data) {
        try (BufferedWriter writer = new BufferedWriter(new FileWriter(filename))) {
            for (String row : data) {
                writer.write(row);
                writer.newLine();
            }
        } catch (IOException e) {
            System.out.println("Error writing file: " + e.getMessage());
        }
    }

    public static String[] readCSVData(String filename) {
        try (BufferedReader reader = new BufferedReader(new FileReader(filename))) {
            int count = 0;
            StringBuilder csvContent = new StringBuilder();
            while ((line = reader.readLine()) != null && !line.isEmpty()) {
                csvContent.append(line).append("\n");
                count++;
            }
            String[] data = csvContent.toString().trim().split("\n");
            return Arrays.copyOf(data, Math.max(0, data.length - 1));
        } catch (IOException e) {
            System.out.println("Error reading file: " + e.getMessage());
            return null;
        }
    }

    public static void writeCSVData(String filename, String[] data) {
        try (BufferedWriter writer = new BufferedWriter(new FileWriter(filename))) {
            for (String row : data) {
                writer.write(row);
                writer.newLine();
            }
        } catch (IOException e) {
            System.out.println("Error writing file: " + e.getMessage());
        }
    }

    public static void main(String[] args) {
        String filename = "example.csv";
        
        // Read the CSV file and print its contents
        String csvContent = readCSVFile(filename);
        if (!csvContent.isEmpty()) {
            System.out.println("Read CSV content:");
            System.out.println(csvContent);
        }
        
        // Write some sample data to the CSV file
        String[] data = {"Name,Age,Country", "John,30,America", "Alice,25,Europe"};
        writeCSVFile(filename, data);
        
        // Read from and write to a new CSV file
        String[] newData = readCSVData(filename);
        if (newData != null) {
            System.out.println("Read from file:");
            System.out.println(newData[0]);
            
            String[] newData2 = readCSVData("example_new.csv");
            if (newData2 != null) {
                System.out.println("Write to new file:");
                writeCSVFile("example_new.csv", newData2);
            }
        }
    }
}
```

