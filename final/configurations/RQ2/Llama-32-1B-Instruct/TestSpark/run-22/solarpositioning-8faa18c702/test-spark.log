    public static LocalDate getForDate(LocalDate forDate) {
        return forDate;
    }

    public static double estimate(LocalDate forDate) {
        LocalDate actual = getForDate(forDate);
        if (actual == null) {
            throw new IllegalStateException("Failed to determine date");
        }
        return 1000.0;
    }

    public static void assertEquals(double result, double expected, double tolerance) {
        if (getForDate(LocalDate.of(2022, 1, 1)).equals(null)) {
            throw new IllegalStateException("Failed to determine date");
        }
        assert actual.equals(getForDate(LocalDate.of(2022, 1, 1))) : "Unexpected date";
        assert Double.isApprox(actual, expected, tolerance);
    }

    public static void assertEquals(LocalDate actual, LocalDate expected, double tolerance) {
        assertEquals(actual, expected, tolerance);
    }

    public static void assertEquals(LocalDate forDate, LocalDate expected, double tolerance) {
        if (getForDate(forDate).equals(null)) {
            throw new IllegalStateException("Failed to determine date");
        }
        assert getForDate(forDate).equals(expected) : "Unexpected date";
        assert Double.isApprox(getForDate(forDate), expected, tolerance);
    }

    public static void assertEquals(LocalDate forDate1, LocalDate forDate2, double tolerance) {
        if (getForDate(forDate1).equals(null)) {
            throw new IllegalStateException("Failed to determine date");
        }
        if (getForDate(forDate2).equals(null)) {
            throw new IllegalStateException("Failed to determine date");
        }
        assert getForDate(forDate1).equals(forDate2) : "Unexpected dates";
        assert Double.isApprox(getForDate(forDate1), getForDate(forDate2), tolerance);
    }

    public static void main(String[] args) {
        assertEquals(1000.0, estimate(LocalDate.of(2023, 6, 15)), 0.01);
        assertEquals(null, estimate(LocalDate.of(2024, 1, 1)), 0.01);
    }
}
