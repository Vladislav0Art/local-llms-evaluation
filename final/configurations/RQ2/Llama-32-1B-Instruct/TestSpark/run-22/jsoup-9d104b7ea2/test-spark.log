    public void testLeafNode() {
        Node root = Jsoup.parse("<p>Hello, World!</p>");
        LeafNode leaf1 = new LeafNode(root, "Hello, World!");
        LeafNode leaf2 = new LeafNode(root, "Universe has no meaning.");
