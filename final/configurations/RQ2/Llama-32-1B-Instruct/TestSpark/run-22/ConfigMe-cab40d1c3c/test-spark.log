import ch.jalu.configme.configurationdata.PropertyListBuilder;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.Arguments;

public class PropertyListBuilderTests {

    @ParameterizedTest
    @MethodUnderTest("add")
    @Scenario("When add a property with null value, then create an empty list")
    public void testAddNullProperty(@NotNull Property<?> property) {
        PropertyListBuilder builder = new PropertyListBuilder();
        List<Property<?>> list = builder.add(property);
        assertEquals(0, list.size());
    }

    @ParameterizedTest
    @MethodUnderTest("create")
    @Scenario("When add two properties with different types, then return a list containing both properties")
    public void testCreateWithDifferentProperties(@NotNull Property<?> property1, @NotNull Property<?> property2) {
        PropertyListBuilder builder = new PropertyListBuilder();
        List<Property<?>> list = builder.create();
        assertTrue(list.contains(property1));
        assertTrue(list.contains(property2));
    }

    @ParameterizedTest
    @MethodUnderTest("getRootEntries")
    @Scenario("When get the root entries, then return an empty map")
    public void testGetRootEntriesEmpty() {
        PropertyListBuilder builder = new PropertyListBuilder();
        Map<String, Object> map = builder.getRootEntries();
        assertEquals(0, map.size());
    }

    @ParameterizedTest
    @MethodUnderTest("getRootEntries")
    @Scenario("When get the root entries with a single entry, then return an empty map")
    public void testGetRootEntriesSingleEntry() {
        PropertyListBuilder builder = new PropertyListBuilder();
        Map<String, Object> map = builder.getRootEntries();
        assertEquals(1, map.size());
    }

    @ParameterizedTest
    @MethodUnderTest("getRootEntries")
    @Scenario("When get the root entries with multiple entries, then return a non-empty map")
    public void testGetRootEntriesMultipleEntries() {
        PropertyListBuilder builder = new PropertyListBuilder();
        Map<String, Object> map = builder.getRootEntries();
        assertNotNull(map);
    }

    @ParameterizedTest
    @MethodUnderTest("add")
    @Scenario("When add a property with an empty string value, then create an empty list")
    public void testAddEmptyStringProperty() {
        PropertyListBuilder builder = new PropertyListBuilder();
        List<Property<?>> list = builder.add(new Property());
        assertEquals(0, list.size());
    }

    @ParameterizedTest
    @MethodUnderTest("create")
    @Scenario("When add two properties with empty string values, then return a list containing both properties")
