    public void testEstimateForDateTimeWithInvalidInput_SingleDateTime() {
        LocalDate forDate = LocalDate.of(2024, 1, 1);
        assertThrows(IllegalArgumentException.class, () -> deltaT.estimate(forDate));
    }

    @Test
    public void testEstimateForMultipleDates_SingleDateTime() {
        LocalDate forDate1 = LocalDate.of(2024, 1, 1);
        LocalDate forDate2 = LocalDate.of(2024, 1, 2);
        double expected = pow(1e-5, 2) + (pow(9.81, 0.04) * 3600) + (pow(-9.81, 0.04) * 14400); // -10 m/s^2
        assertEquals(expected, deltaT.estimate(forDate1).estimate(forDate2));
    }

    @Test
    public void testEstimateForMultipleDates_SingleDateTimeWithNegativeDeltaT() {
        LocalDate forDate = LocalDate.of(2024, 1, 1);
        double expected = pow(1e-5, 2) + (pow(-9.81, 0.04) * 3600); // -10 m/s^2
        assertEquals(expected, deltaT.estimate(forDate).estimate(forDate));
    }

    @Test
    public void testEstimateForMultipleDates_SingleDateTimeWithPositiveDeltaT() {
        LocalDate forDate = LocalDate.of(2024, 1, 1);
        double expected = pow(1e-5, 2) + (pow(9.81, 0.04) * 3600); // 10 m/s^2
        assertEquals(expected, deltaT.estimate(forDate).estimate(forDate));
    }

    @Test
    public void testEstimateForMultipleDates_SingleDateTimeWithZeroDeltaT() {
        LocalDate forDate = LocalDate.of(2024, 1, 1);
        double expected = pow(1e-5, 2); // 0 m/s^2
        assertEquals(expected, deltaT.estimate(forDate).estimate(forDate));
    }

    @Test
    public void testEstimateForMultipleDates_SingleDateTimeWithDifferentDeltas() {
        LocalDate forDate1 = LocalDate.of(2024, 1, 1);
        LocalDate forDate2 = LocalDate.of(2024, 1, 2);
        double expected = pow(1e-5, 2) + (pow(9.81, 0.04) * 3600) + (pow(-9.81, 0.04) * 14400); // -10 m/s^2
        assertEquals(expected, deltaT.estimate(forDate1).estimate(forDate2));
    }

    @Test
    public void testEstimateForMultipleDates_SingleDateTimeWithDifferentSigns() {
        LocalDate forDate = LocalDate.of(2024, 1, 1);
        double expected = pow(1e-5, 2) + (pow(-9.81, 0.04) * 3600); // -10 m/s^2
