public class PrettyPrintVisitorTest {
    private static PrettyPrintVisitor visitor = new PrettyPrintVisitor();
    private static Printer printer;

    @Before
    public void setup() {
        printer = StringIterate.instance();
    }

    public void testVisitAssignExpr_AssingExpr() {
        visitAssignExpr(AssingExpr.ASSIG ExpressValue value);
        verifyPrinters(printer);
    }

    public void testVisitBinaryExpr_BinaryExpr() {
        visitBinaryExpr(BinaryExpr.BINARY value1, BinaryExpr.BINARY value2);
        verifyPrinters(printer);
    }

    public void testVisitUnaryExpr_UnaryExpr() {
        visitUnaryExpr(UnaryExpr.UNARY value1);
        verifyPrinters(printer);
    }

    public void testVisitConstExpr_ConstExpr() {
        visitConstExpr(Value.CONST ExpressValue value);
        verifyPrinters(printer);
    }

