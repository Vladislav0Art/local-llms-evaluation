        // Evaluate the binary expression and assign its result to a variable
        visitor.visit(binaryExpr);
        return value;
    }

    public static Value visitFunctionCallExpr(FunctionCallExpr.function) {
        // Call the function with the arguments on both sides of the parentheses
        visitor.visit(functionCallExpr);
        return value;
    }

    public static Value visitPropertyPathExpr(PropertyPathExpr.property) {
        // Evaluate the property path and assign its result to a variable
        visitor.visit(propertyPathExpr);
        return value;
    }

    public static Value visitAnonymousScriptExpr(AnonymousScript.annots) {
        // Call the anonymous function with arguments on both sides of the parentheses
        visitor.visit(anonymousScriptExpr);
        return value;
    }

    public static Value visitFunctionScriptExpr(FunctionScript.function) {
        // Call the function with arguments on both sides of the parentheses
        visitor.visit(functionScriptExpr);
        return value;
    }

    public static Value visitStatementSequenceScript(StatementSequenceScript.stream) {
        // Evaluate the statement sequence and assign its result to a variable
        visitor.visit(stream);
        return value;
    }

    public static Value visitVarExpr(VarExpr.var) {
        // Assign the value of the variable on both sides of the assignment operator
        visitor.visit(varExpr);
        return value;
    }

    public static Value visitProjectionExpr(ProjectionExpr.projection) {
        // Evaluate the projection and assign its result to a variable
        visitor.visit(projectionExpr);
        return value;
    }

    public static Value visitAliasExpr(AliasExpr.aliases) {
        // Assign the aliases on both sides of the assignment operator
        visitor.visit(aliases);
        return value;
    }

    public static Value visitVectorExpr(VectorExpr.variable) {
        // Assign a vector to a variable
        visitor.visit(variable);
        return value;
    }

    public static Value visitIndexExpr(IndexExpr.index) {
        // Evaluate the index and assign its result to a variable
        visitor.visit(indexExpr);
        return value;
    }

    public static Value visitDecimalExpr(DecimalExpr.decimal) {
