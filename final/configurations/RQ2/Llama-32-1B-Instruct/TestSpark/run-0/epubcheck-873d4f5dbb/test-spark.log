    public boolean checkSpineItem(OPFItem item, OPFChecker30 checker) {
        if (item.getType().equals("video")) {
            // Validate the video spine item
            return true; // This should be overridden by subclasses
        }
        return super.checkSpineItem(item, checker);
    }
}

// Main class to create an instance of handlers
