class OPFValidator {
    public void validateItems(OPFItem[] items, ValidationContext validationContext) {
        for (OPFItem item : items) {
            if (!validateItem(item, validationContext)) {
                System.out.println("Validation failed for item " + item.getType());
                return;
            }
        }
    }

    public void validateSpineItems(OPFItem[] spineItems, ValidationContext validationContext) {
        for (OPFItem spineItem : spineItems) {
            if (!validateSpineItem(spineItem, validationContext)) {
