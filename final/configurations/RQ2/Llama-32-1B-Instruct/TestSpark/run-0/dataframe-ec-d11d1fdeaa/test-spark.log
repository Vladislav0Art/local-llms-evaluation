        df.addColumn(new Column(column.name));
        df.getColumns().add(column);
        for (Function func : df.getFunctions()) {
            func.add(df, df.getRows(), column);
        }
    }

    public static DataFrame join(DataFrame left, DataFrame right, String thisJoinColumnName, String otherJoinColumnName) {
