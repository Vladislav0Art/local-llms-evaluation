        List<Function> functions = new ArrayList<>();
        for (DataFrame row : df.getRows()) {
            if (!row.getString(joinColumn).equals(otherJoinColumn)) {
                continue;
            }
            for (Function func : row.getFunctions()) {
                functions.add(func);
            }
        }

        String result = "";
        for (int i = 0; i < functions.size(); i++) {
            Function f1 = functions.get(i);
            if (!f1.apply(df, df.getRows())) {
                continue;
            }
            for (int j = 0; j < i; j++) {
                Function f2 = functions.get(j);
                if (f1.apply(df, df.getRows()).equals(f2.apply(df, df.getRows()))) {
