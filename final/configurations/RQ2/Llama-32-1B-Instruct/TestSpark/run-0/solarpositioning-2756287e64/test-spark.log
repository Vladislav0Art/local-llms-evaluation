		assertEquals(latitude + 0.01, result4.getAzimuthZenithAngle().getLatitude());
		assertEquals(longitude + 0.01, result4.getAzimuthZenithAngle().getLongitude());
	}
, 	@Test
	public void testCalculateSolarPositionMultiplePoints_DifferentDeltaTAndPressureTemperature() {
