import java.util.HashMap;
import java.util.Map;

public class Node {
    public String type;
    public Object value;

    public Node(String type, Object value) {
        this.type = type;
        this.value = value;
    }
}

public interface TerminalNode extends Node {
    @Override
    public Object getLeaf();
}

public interface NonTerminalNode extends Node {

    Object getLeftChild();
    Object getRightChild();

    default Object getLeaf() {
        return value;
    }

    default String toString() {
        switch (type) {
            case "symbol-table":
                return "Symbol Table";
            case "symbol":
                return "Symbol: " + value.toString();
            case "function":
                return "Function: " + value.toString();
            default:
                throw new RuntimeException("Unknown node type");
        }
    }
}

public class SymbolTable {
    private Map<String, String> symbolMap;

    public SymbolTable() {
        this.symbolMap = new HashMap<>();
    }

    public void addSymbol(String symbol, String value) {
        symbolMap.put(symbol, value);
    }

    public String getValue(String symbol) {
        return symbolMap.getOrDefault(symbol, "Unknown");
    }
}

public class Parser {
    private NonTerminalNode root;
    private SymbolTable symbolTable;

    public Parser(NonTerminalNode root, SymbolTable symbolTable) {
        this.root = root;
        this.symbolTable = symbolTable;
    }

    public String parse(String input) {
        if (input.isEmpty()) {
            return "";
        }

        try {
            String nodeType = getNodeType(input);
            if (nodeType.equals("symbol")) {
                Object rightChildValue = parseRightChild(input.substring(0, 1));
                Object leftChildValue = parseLeftChild(input.substring(2, input.length() - 1));

                return root.toString();
            } else if (nodeType.equals("symbol-table")) {
                Object value = parseString(input);
                String node = new NonTerminalNode("symbol-table", value);
                node.leftChild = parseRightChild(value);
                node.rightChild = parseLeftChild(value);

                return node.toString();
            } else {
                throw new RuntimeException("Unknown node type");
            }
        } catch (RuntimeException e) {
            System.out.println(e.getMessage());
            return "";
        }
    }

    private String getNodeType(String input) throws RuntimeException {
        if (input.equals("*")) {
            return "symbol-table";
        } else if (input.equals("+")) {
            return "symbol-table";
        } else if (input.equals("-")) {
            return "symbol-table";
        } else if (input.equals("function")) {
            return "function";
        } else if (input.equals("if") || input.equals("else")) {
            return "if-else";
        } else {
            throw new RuntimeException("Unknown node type");
        }
    }

    private String parseRightChild(String input) throws RuntimeException {
        String[] parts = input.split("-");
        Object value = symbolTable.getValue(parts[0]);
        if (parts.length == 1) {
            return value.toString();
        } else {
            return parseString(input.substring(1, input.length() - 1));
        }
    }

    private String parseLeftChild(String input) throws RuntimeException {
        try {
            Object value = symbolTable.getValue(input);
            String node = new TerminalNode("symbol", value);
            if (input.startsWith("function")) {
                return "Function: (" + value.toString() + ")";
            } else if (input.equals("if")) {
                return "(" + node.toString() + ")";
            } else if (input.equals("else")) {
                return "()" + node.toString();
            }
        } catch (RuntimeException e) {
            System.out.println(e.getMessage());
            return "";
        }
    }

    private Object parseString(String input) throws RuntimeException {
        try {
            Object value = symbolTable.getValue(input);
            String node = new TerminalNode("symbol", value);

            if (input.startsWith("function")) {
