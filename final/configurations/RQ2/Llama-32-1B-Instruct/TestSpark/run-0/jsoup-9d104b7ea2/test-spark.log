public class Node {
    public String type;
    public Object value;

    public Node(String type, Object value) {
        this.type = type;
        this.value = value;
    }
}

public interface TerminalNode extends Node {
    @Override
    public Object getLeaf();
}

public interface NonTerminalNode extends Node {

    Object getLeftChild();
    Object getRightChild();
}

public class SymbolTable {
    private Map<String, String> symbolMap;

    public SymbolTable() {
        this.symbolMap = new HashMap<>();
    }

    public void addSymbol(String symbol, String value) {
        symbolMap.put(symbol, value);
    }

    public String getValue(String symbol) {
        return symbolMap.getOrDefault(symbol, "Unknown");
    }
}

public class Parser {
    private TerminalNode root;
    private SymbolTable symbolTable;

    public Parser(TerminalNode root, SymbolTable symbolTable) {
        this.root = root;
        this.symbolTable = symbolTable;
    }

    public String parse(String input) {
        if (input.isEmpty()) {
            return "";
        }

        String nodeType = symbolTable.getValue(root.type);
        if (nodeType.equals("symbol")) {
            return (String) symbolTable.getValue(input.substring(0, 1));
        } else if (nodeType.equals("symbol-table")) {
            root.type = "symbol-table";
            Object rightChildValue = parse(input.substring(2, input.length() - 1));
            String leftChildValue = parse(input.substring(0, 2));
            return "(SymbolTable({{" + leftChildValue + ", " + rightChildValue + "})))";
        } else {
            throw new RuntimeException("Unknown node type");
        }
    }
}

public class Main {
    public static void main(String[] args) {
        String input = "A B C";
        Node root = new NonTerminalNode("symbol-table", new Object());
        TerminalNode terminal1 = new TerminalNode("A", new Object());
        TerminalNode terminal2 = new TerminalNode("B", new Object());
        TerminalNode terminal3 = new TerminalNode("C", new Object());

        Parser parser = new Parser(terminal1, new SymbolTable());
        System.out.println(parser.parse(input));
    }
}
