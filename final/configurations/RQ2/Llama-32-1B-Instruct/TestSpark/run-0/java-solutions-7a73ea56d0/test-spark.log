public class OnlineStockSpanTest {

    private OnlineStockSpan onlineStockSpan;

    public void setUp() {
        onlineStockSpan = new OnlineStockSpan();
    }

    public int next(int price) {
        return onlineStockSpan.next(price);
    }

    public int[] calculateSpans(int[] prices) {
        return onlineStockSpan.calculateSpans(prices);
    }
}

public class TestOnlineStockSpan {

    private final OnlineStockSpan onlineStockSpan;

    public TestOnlineStockSpan() {
        onlineStockSpan = new OnlineStockSpan();
    }

    @Test
    public void test_next_1() {
        // Arrange
        int price = 5;
        int[] prices = new int[]{price};
        onlineStockSpan.next(2);

        // Act and Assert
        assertEquals(0, onlineStockSpan.next(price));
        assertArrayEquals(new int[]{}, calculateSpans(prices));

        onlineStockSpan.next(price);
        onlineStockSpan.next(price);
    }

    @Test
    public void test_next_10() {
        // Arrange
        int price = 10;
        int[] prices = new int[]{price, price, price, price};
        onlineStockSpan.next(2);

        // Act and Assert
        assertEquals(1, onlineStockSpan.next(price));
        assertEquals(3, onlineStockSpan.next(price));

        onlineStockSpan.next(price);
        onlineStockSpan.next(price);
    }

    @Test
    public void test_next_100() {
        // Arrange
        int price = 2;
        int[] prices = new int[]{price};
        for (int i = 0; i < 99; i++) {
            onlineStockSpan.next(1);
        }
        onlineStockSpan.next(price);

        // Act and Assert
        assertEquals(100, onlineStockSpan.next(price));
    }

    @Test
    public void test_calculateSpans_() {
        // Arrange
        int[] prices = new int[]{10};
        onlineStockSpan = new OnlineStockSpan();

        // Act
        int[] result = calculateSpans(prices);

        // Assert
        assertEquals(0, Arrays.stream(result).sum());
    }
}

