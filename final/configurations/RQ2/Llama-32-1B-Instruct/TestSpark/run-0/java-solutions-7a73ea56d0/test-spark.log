        System.out.println(main.maxNumberOfSpans(new int[]{1,2,3,4,5})); // Output: 0
    }

    public int maxNumberOfSpans(int[] prices) {
        if (prices.length < 2) {
            return 0;
        }

        int n = prices.length;
        long[][] dp = new long[n][n];
        for (int i = 1; i < n; i++) {
            Arrays.fill(dp[i], 1);
        }
        for (int i = 2; i < n; i++) {
            for (int j = 0; j <= i - 1; j++) {
                dp[i][j] += dp[i-1][j];
                if (prices[j] >= prices[i]) {
                    dp[i][j+1] += dp[i-1][j];
                }
            }
        }

        int maxSpan = 0;
        for (int i = 0; i <= n - 2; i++) {
            maxSpan = Math.max(maxSpan, Arrays.stream(dp[n-1]).max().getAsInt());
        }
        return maxSpan == 0 ? 0 : (int)maxSpan;
    }

    public int[] binarySearch(int[] arr, int target) {
        for (int i = 0; i < arr.length; i++) {
            if (arr[i] == target) {
                return new int[]{i, i};
            }
        }
        return null;
    }

