import java.util.ArrayList;
import java.util.List;

public class AttrUtils {
    public static String getAttributeValue(String key, Attributes attributes) {
        return attributes.getValue(key);
    }

    public static void setAttributeValue(Attributes attributes, String key, String value) {
        attributes.setValue(key, value);
    }
}

class Attributes {
    private Map<String, Object> map;

    public Attributes() {
        this.map = new HashMap<>();
    }

    public void put(String key, Object value) {
        this.map.put(key, value);
    }

    public int size() {
        return this.map.size();
    }

    public String get(int index) {
        if (index >= 0 && index < this.map.size()) {
            return this.map.get(index).toString();
        } else {
            throw new IndexOutOfBoundsException("Index is out of range");
        }
    }

    public Object get(String key) {
        return this.map.get(key);
    }

    public boolean containsKey(String key) {
        return this.map.containsKey(key);
    }

    public void remove(String key) {
        if (this.map.containsKey(key)) {
            this.map.remove(key);
        } else {
            throw new RuntimeException("Key does not exist");
        }
    }

    @Override
    public String toString() {
        StringBuilder sb = new StringBuilder();
        for (Object value : map.values()) {
            sb.append(value.toString()).append(",");
        }
        return sb.toString().trim();
    }
}

class TestClass {
    public void test1() {
        Attributes attributes = new Attributes();

        // set attribute values
        attributes.put("key", "value");

        // get attribute values
        String value1 = AttrUtils.getAttributeValue("key", attributes);
        System.out.println(value1);

        // check if the key exists in the map
        boolean keyExists = AttrUtils.getAttributeValue("key", attributes).equals("value");
        System.out.println(keyExists); // false

        // check if the key does not exist in the map
        try {
            AttrUtils.getAttributeValue("key", attributes);
        } catch (IndexOutOfBoundsException e) {
            System.out.println(e.getMessage()); // Key does not exist
        }

        // remove attribute value
        AttrUtils.removeAttributeValue("key", attributes, "value");
        String value2 = AttrUtils.getAttributeValue("key", attributes);
        System.out.println(value2); // null

        // check if the key exists in the map after removal
        boolean keyExistsAfterRemoval = AttrUtils.getAttributeValue("key", attributes).equals("value");
        System.out.println(keyExistsAfterRemoval); // false
