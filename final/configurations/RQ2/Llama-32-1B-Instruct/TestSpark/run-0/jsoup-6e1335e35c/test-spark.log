        WebElement nestedClass1 = driver.findElement(By.tagName("div"));
        System.out.println(nestedClass1.getText());

        String expectedString = "Hello World!";
        if (!nestedClass1.getText().equals(expectedString)) {
            throw new RuntimeException("Expected \"Hello World!\" got " + nestedClass1.getText());
        }
    }

