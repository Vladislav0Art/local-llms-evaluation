    public void testNestedFunctions() throws Exception {
        WebDriver driver = new org.openqa.selenium.ChromeDriver();
        driver.get("http://www.test.com");

        WebElement element2 = driver.findElement(By.id("my_id"));
        System.out.println(element2.getText());

        String expectedString = "Hello World!";
        if (!element2.getText().equals(expectedString)) {
            throw new RuntimeException("Expected \"Hello World!\" got " + element2.getText());
        }
    }

