    public void testNestedObjects() throws Exception {
        WebDriver driver = new org.openqa.selenium.ChromeDriver();
        driver.get("http://www.test.com");

        WebElement element1 = driver.findElement(By.id("my_id"));
        System.out.println(element1.getText());

        String expectedString = "Hello World!";
        if (!element1.getText().equals(expectedString)) {
            throw new RuntimeException("Expected \"Hello World!\" got " + element1.getText());
        }
    }

