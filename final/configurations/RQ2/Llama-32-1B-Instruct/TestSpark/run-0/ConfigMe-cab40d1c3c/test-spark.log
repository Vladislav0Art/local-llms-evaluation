import java.util.Map;

public class PropertyListBuilderTest {

    public void testAddPropertyWithNull() {
        PropertyListBuilder builder = new PropertyListBuilder();
        try {
            builder.add(null);
        } catch (ConfigMeException e) {
            // expected exception
        }

        assertEquals(0, builder.create().size());
    }

    public void testAddPropertyWithEmptyList() {
