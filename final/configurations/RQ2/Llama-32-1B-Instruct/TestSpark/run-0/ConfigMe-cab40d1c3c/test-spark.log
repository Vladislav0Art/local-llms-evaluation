import ch.jalu.configme.configurationdata.PropertyListBuilder;
import ch.jalu.configme.exception.ConfigMeException;
import org.jetbrains.annotations.NotNull;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

public class PropertyListBuilderTest {

    public void testAddPropertyWithNullAndMap() {
        PropertyListBuilder builder = new PropertyListBuilder();
        try {
            builder.add(null);
            builder.add(new Property("key", "value"));
        } catch (ConfigMeException e) {
            // expected exception
        }

        assertEquals(2, builder.create().size());
    }

    public void testAddPropertyWithEmptyMap() {
        PropertyListBuilder builder = new PropertyListBuilder();
        List<Property> list = builder.create();

        assertEquals(0, list.size());

        Property property = new Property("key", "value");
        builder.add(property);

        assertEquals(1, list.size());
    }

    public void testAddPropertyWithMapInRootEntries() {
        PropertyListBuilder builder = new PropertyListBuilder();
        Map<String, Object> map = new LinkedHashMap<>();
        map.put("key1", "value1");

        builder.getRootEntries().putAll(map);

        assertEquals(1, builder.create().size());
    }

    public void testGetRootEntriesWithMapInRootEntries() {
        PropertyListBuilder builder = new PropertyListBuilder();
        Map<String, Object> map = new LinkedHashMap<>();
        map.put("key1", "value1");
        map.put("key2", "value2");

        builder.getRootEntries().putAll(map);

        assertEquals(1, builder.getRootEntries().size());
    }

    public void testAddPropertyWithExistingMap() {
        PropertyListBuilder builder = new PropertyListBuilder();
        List<Property> list = builder.create();

        assertEquals(0, list.size());

        Map<String, Object> map = new LinkedHashMap<>();
        map.put("key", "value");

        list.add(new Property("key1", "value1"));
        list.add(map);

        assertEquals(2, list.size());
    }

    public void testGetRootEntriesWithExistingMap() {
        PropertyListBuilder builder = new PropertyListBuilder();
        Map<String, Object> map = new LinkedHashMap<>();
        map.put("key", "value");

