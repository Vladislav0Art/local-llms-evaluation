import com.ezylang.evalex.parser.Token.Type;
import com.ezylang.evalex.config.ExpressionConfiguration;
import com.ezylang-evalex.functions.FunctionIfc;
import com.ezylang-evalex.ops.OperatorIfc;
import com.ezylang-evalex.parser.Token.TokenType;
import org.junit.jupiter.api.Test;

public class TokenizerTest {

    @Test
    public void testParseStringLiteral_Simple() throws ParseException {
        ExpressionConfiguration configuration = new ExpressionConfiguration();
        String expressionString = "1 + 2";
        Tokenizer tokenizer = new Tokenizer(expressionString, configuration);
        List<Token> tokens = tokenizer.parse();
        assertTokenCount(tokens, 4);

        // Verify token type
        assertTokenType(tokenizer.parseStringLiteral(), Type.SQUAREBRACKET);
    }

    @Test
    public void testParseStringLiteral_SameType() throws ParseException {
        ExpressionConfiguration configuration = new ExpressionConfiguration();
        String expressionString = "1 + 2";
        Tokenizer tokenizer = new Tokenizer(expressionString, configuration);
        List<Token> tokens = tokenizer.parse();
        assertTokenCount(tokens, 4);

        // Verify token type
        assertTokenType(tokenizer.parseStringLiteral(), Type.SQUAREBRACKET);
    }

    @Test
    public void testParseStringLiteral_MultipleTypes() throws ParseException {
        ExpressionConfiguration configuration = new ExpressionConfiguration();
        String expressionString = "1 + 2";
        Tokenizer tokenizer = new Tokenizer(expressionString, configuration);
        List<Token> tokens = tokenizer.parse();
        assertTokenCount(tokens, 5);

        // Verify token type
        assertTokenType(tokenizer.parseStringLiteral(), Type.SQUAREBRACKET);
    }

    @Test
    public void testParseStringLiteral_Optimized() throws ParseException {
        ExpressionConfiguration configuration = new ExpressionConfiguration();
        String expressionString = "1 + 2";
        Tokenizer tokenizer = new Tokenizer(expressionString, configuration);
        List<Token> tokens = tokenizer.parse();
        assertTokenCount(tokens, 4);

        // Verify token type
        assertTokenType(tokenizer.parseStringLiteral(), Type.SQUAREBRACKET);
    }

    private void assertTokenCount(List<Token> tokens, int expected) {
        assertEquals(expected, tokens.size());
    }

    private void assertTokenType(Token token, TokenType type) {
        assertEquals(type, token.getType());
    }
}
