        return normalized.replaceAll("\\W+", " ");
    }

    public static boolean isBlock() {
        return Jsoup.parse("div, span").text().trim().toLowerCase().contains("block");
    }

    public static boolean isNode() {
        return Jsoup.parse("<", "").text().trim().toLowerCase().contains("node");
    }

    public static String getTagName() {
        Document doc = Jsoup.parse("html", "https://jsoup.org/", new Element()).body();
        for (Element tag : doc.find("tag")) {
            if (!tag.name().equals("html") && !tag.name().equals("head") && !tag.name().equals("body")) {
                return tag.name();
            }
        }
        return null;
    }

