**Checking if an Element is Block-Level or Node-Level**

To check if an HTML element is block-level or node-level, you can use a regular expression to match any element that does not start with a space.

```java
import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;

public class HtmlElementChecker {
    public static boolean isBlockElement(String tagName) {
        Document doc = Jsoup.parse("html", "https://jsoup.org/", new Element()).body();
        for (Element tag : doc.find(tagName)) {
            if (!tag.name().startsWith(" ")) {
                return true;
            }
        }
        return false;
    }

    public static void main(String[] args) {
        System.out.println(isBlockElement("div"));
        
        String expected1 = "true";
        boolean actual1 = isBlockElement(expected1);
        assertTrue(actual1);

        System.out.println(isBlockElement("span"));
        
        expected2 = "false";
        actual2 = isBlockElement(expected2);
        assertFalse(actual2);
    }
}
