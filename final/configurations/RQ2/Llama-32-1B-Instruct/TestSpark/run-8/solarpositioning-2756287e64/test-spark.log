import java.time.ZonedDateTime;
import java.time.temporal.ChronoUnit;

public class GeneratedTest {

    public static ZonedDateTime of(int year, int month, int day) {
        return ZonedDateTime.of(year, month, day, 12, 0, 0);
    }

    public static String calculateSolarPosition(ZonedDateTime date, double latitude, double longitude, double deltaT) {
        // Assuming a simplified model where solar noon is at 12:00 UTC
        int solarNoon = (int) ((date.toEpochSecond() + 12 * ChronoUnit.SECONDS) / 24);

        if (solarNoon < 0 || solarNoon > 23) {
            return "Error";
        }

        double hour = Math.floor(solarNoon / 2.0);
        if (hour == 12) {
            hour = 0;
        } else if (hour >= 13 && hour < 16) {
            hour -= 3;
        }
        int minutesSinceSunrise = (int) ((solarNoon - 6) * ChronoUnit.MINUTES);
        double solarTime = Math.floor((hoursInDay - hour + minutesSinceSunrise / 60.0) / 24);

        if (solarTime < 1) {
            solarTime += 24;
        }

        return "Solar Noon: " + hoursInDay * 24 + ":" + minToHours(solarTime) + ".";
    }

    public static String calculateSolarPosition(ZonedDateTime date, double latitude, double longitude, double deltaT, double pressure, double temperature) {
        // Simplified model where solar noon is at 12:00 UTC
        int solarNoon = (int) ((date.toEpochSecond() + 12 * ChronoUnit.SECONDS) / 24);

        if (solarNoon < 0 || solarNoon > 23) {
            return "Error";
        }

        double hour = Math.floor(solarNoon / 2.0);
        if (hour == 12) {
            hour = 0;
        } else if (hour >= 13 && hour < 16) {
            hour -= 3;
        }
        int minutesSinceSunrise = (int) ((solarNoon - 6) * ChronoUnit.MINUTES);
        double solarTime = Math.floor((hoursInDay - hour + minutesSinceSunrise / 60.0) / 24);

        if (solarTime < 1) {
            solarTime += 24;
        }

        // Assuming temperature is in Kelvin
        double actualTemperature = temperature + 273.15;

        return "Solar Noon: " + hoursInDay * 24 + ":" + minToHours(solarTime) + ". Actual Temperature: " + actualTemperature + " K";
    }

    public static String calculateSolarPosition(ZonedDateTime date, double latitude, double longitude, double deltaT, double pressure, double temperature, boolean isCalm) {
        // Simplified model where solar noon is at 12:00 UTC
        int solarNoon = (int) ((date.toEpochSecond() + 12 * ChronoUnit.SECONDS) / 24);

        if (solarNoon < 0 || solarNoon > 23) {
            return "Error";
        }

        double hour = Math.floor(solarNoon / 2.0);
        if (hour == 12) {
            hour = 0;
        } else if (hour >= 13 && hour < 16) {
            hour -= 3;
        }
        int minutesSinceSunrise = (int) ((solarNoon - 6) * ChronoUnit.MINUTES);
        double solarTime = Math.floor((hoursInDay - hour + minutesSinceSunrise / 60.0) / 24);

        if (solarTime < 1) {
            solarTime += 24;
        }

        // Simplified model where temperature is in Kelvin
        double actualTemperature = temperature + 273.15;

        return "Solar Noon: " + hoursInDay * 24 + ":" + minToHours(solarTime) + ". Actual Temperature: " + actualTemperature + " K";
    }

    public static String calculateSunset(ZonedDateTime date, double latitude, double longitude) {
        // Assuming a simplified model where sunset is at the horizon
        double hour = Math.floor((date.toEpochSecond() / 3600.0) * 5);
        int minutesSinceSunrise = (int) ((date.toEpochSecond() % 3600.0 + (24 - date.getHour()) * 60) / 600);

        if (hour < 0 || hour > 23) {
            return "Error";
        }

        String direction = "";

        if (isNorthern hemisphere) {
            direction = getDirection(hour, minutesSinceSunrise);
        } else {
            direction = getDirection(360 - hour, minutesSinceSunrise);
        }

        return "Sunset: " + hoursInDay * 24 + ":" + minToHours(hour) + directions[direction];
    }

    private static String getDirection(double hour, int minutes) {
        if (hour < 6 || hour > 18) {
            return "North";
        } else if (hour >= 21 && hour <= 26) {
            return "South";
        } else {
            return "East";
        }
    }

    public static String directions = ["N", "S", "E", "W"];

    // Simplified model where solar noon is at 12:00 UTC
    private static double hoursInDay = 24;
}
