import java.net.URI;
import java.net.URISyntaxException;

public class URLGenerator {
    public static URI generatePublicURL(String host) throws URISyntaxException {
        return new URI("http://" + host);
    }

    public static void main(String[] args) throws URISyntaxException {
        System.out.println(generatePublicURL("google.com"));
        System.out.println(generatePublicURL("example.com"));
        System.out.println(generatePublicURL("unknown-host"));
    }
}

class TestGenerator {
    public static void testGeneratePublicURL1() throws URISyntaxException {
        System.out.println(new URLGenerator().generatePublicURL("google.com"));
        System.out.println(new URLGenerator().generatePublicURL("example.com"));
        try {
            new URLGenerator().generatePublicURL("unknown-host");
        } catch (URISyntaxException e) {
            System.out.println(e.getMessage());
        }
    }

    public static void main(String[] args) throws URISyntaxException {
        TestGenerator.testGeneratePublicURL1();
    }
}

class Main {
    public static void main(String[] args) {
        new TestGenerator().main(args);
    }
}
```

