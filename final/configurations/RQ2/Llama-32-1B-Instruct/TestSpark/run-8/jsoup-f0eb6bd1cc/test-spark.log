**Problem:**

Write a Java program that creates two classes `Person` and `Employee`, one with methods to calculate their respective salaries based on years of service.

```java
class Person {
    private int age;
    private String gender;

    public Person(int age, String gender) {
        this.age = age;
        this.gender = gender;
    }

    public void greet() {
        System.out.println("Hello, my name is " + gender + " and I'm " + age + " years old.");
    }
}

class Employee extends Person {
    private int yearsOfService;

    public Employee(int age, String gender, int yearsOfService) {
        super(age, gender);
        this.yearsOfService = yearsOfService;
    }

    public void getSalary() {
        System.out.println("Your salary is: " + (this.getAge() * 10000 / yearsOfService));
    }
}

public class Main {
    public static void main(String[] args) {
        Employee emp = new Employee(35, "male", 20);
        emp.greet();
        emp.getSalary();
    }
}
```

```java
import java.util.Scanner;

class Person {
    private int age;
    private String gender;

    public Person(int age, String gender) {
        this.age = age;
        this.gender = gender;
    }

    public void greet() {
        System.out.println("Hello, my name is " + gender + " and I'm " + age + " years old.");
    }
}

class Employee extends Person {
    private int yearsOfService;

    public Employee(int age, String gender, int yearsOfService) {
        super(age, gender);
        this.yearsOfService = yearsOfService;
    }

    public void getSalary() {
        System.out.println("Your salary is: " + (this.getAge() * 10000 / yearsOfService));
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        System.out.print("Enter your age: ");
        int age = scanner.nextInt();
        System.out.print("Enter gender (male/female): ");
        String gender = scanner.next().toLowerCase();

        Employee emp = new Employee(age, gender, 0); // Initialize years of service to 0
        emp.greet();
        System.out.println(emp.getSalary());
    }
}
