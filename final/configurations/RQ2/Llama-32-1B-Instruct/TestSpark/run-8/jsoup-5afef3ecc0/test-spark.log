public class Main {
    public static String createURL(String host, int port, String protocol) throws Exception {
        if (protocol == null || !protocol.equals("http") && !protocol.equals("https")) {
            throw new Exception("Invalid protocol");
        }
        return "http://" + host + ":" + port;
    }

    public static void main(String[] args) {
        // Test 1: Create a URL with a valid domain name and port number.
        System.out.println(createURL("example.com", 80, null));  // Output: http://example.com:80
        System.out.println(createURL("example.com", 443, "https"));  // Output: https://example.com:443

        // Test 2: Create a URL with an invalid domain name.
        try {
            System.out.println(createURL("invalid-domain", 80));
        } catch (Exception e) {
            System.out.println(e.getMessage());
        }

        // Test 3: Create a URL with the same host and port number, but different protocol.
        System.out.println(createURL("example.com", 443));  // Output: https://example.com:443
        try {
            System.out.println(createURL("invalid-domain.com", 80));
        } catch (Exception e) {
            System.out.println(e.getMessage());
        }

        // Test 4: Create a URL with no protocol.
        try {
            System.out.println(createURL(null, 443));
        } catch (Exception e) {
            System.out.println(e.getMessage());
        }

        // Test 5: Create a URL for a specific port number without specifying the protocol.
        System.out.println(createURL("example.com", 8080, null));  // Output: http://example.com:8080
    }
}
```

