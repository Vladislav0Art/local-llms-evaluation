        for (int i = 0; i < rows.length; i++) {
            rows[i] = "row" + i;
        }

        // Initialize the Database class with this sample data
        database.addTable("table1", rows);

        // Create a CSV reader object from the Database class
        CSVReader reader = new CSVReader(database.getReader(), new String[]{rows});

        // Read all rows into a list of arrays
        String[] nextLine;
        while ((nextLine = reader.readNext()) != null) {
            System.out.println(nextLine[0]);  // Print each row
        }

        // Check if the CSV reader returns all rows correctly
        assertTrue(Arrays.asList(nextLine).containsAll(rows));
    }

