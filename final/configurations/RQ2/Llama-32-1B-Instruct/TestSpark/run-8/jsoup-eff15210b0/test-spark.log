public class HttpHelperTest {

    @Test
    public void testConnect() {
        Connection connection = new HttpConnection();
        System.out.println(connection.connect("https://www.example.com"));
    }

    @Test
    public void testConnectUrl() {
        URL url = new URL("https://www.example.com");
        Connection connection = connect(url);
        System.out.println(connection.url(url));
    }

    @Test
    public void testHttpConnectionConstructor() {
        HttpConnection connection = new HttpConnection();
        System.out.println(connection.url(new URL("https://www.example.com")));
        System.out.println(connection.request());
        System.out.println(connection.response());
        System.out.println(connection.postDataCharset("utf-8"));
    }

    @Test
    public void testIgnoreHttpErrors() {
        Connection connection = new HttpConnection();
        connection.ignoreHttpErrors(true);
        try {
            connection.execute();
        } catch (IOException e) {
            // Expected exception
        }
    }

    @Test
    public void testIgnoreContentType() {
        Connection connection = new HttpConnection();
        connection.ignoreContentType(false);
        try {
            connection.execute();
        } catch (IOException e) {
            // Expected exception
        }
    }

    @Test
    public void testCookieManager() {
