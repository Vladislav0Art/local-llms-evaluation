public class TestClass {
    public static String getCookie() {
        return "session_id=12345";
    }

    public static Response post(String url, Map<String, String> data) {
        // Create a new Request object
        Request request = new Request(url);
        
        // Add the cookie to the request
        request.addHeader("Cookie", getCookie());
        
        // Send the POST request and get the response
        Response response = server.execute(request, data);
        
        return response;
    }

    public static void main(String[] args) {
        String url = "http://example.com";
        Map<String, String> data = new HashMap<>();
        data.put("key", "value");

        Response response = post(url, data);

        // Check the cookie
        assert !response.getCookie().containsKey("session_id");
    }
}

class Request {
    private final HttpUrl url;

    public Request(String url) {
        this.url = HttpUrl.parse(url);
    }

    public void addHeader(String key, String value) {
        URL locationUrl = url.getScheme() + "://" + url.getHost() + "/login";
        request = new Request(locationUrl);
        request.addHeader(key, value);
    }
}

class Response {
    private final Map<String, String> cookies;

    public Response(Map<String, String> cookies) {
        this.cookies = cookies;
    }

    public boolean containsKey(String key) {
        return cookies.containsKey(key);
    }
}
