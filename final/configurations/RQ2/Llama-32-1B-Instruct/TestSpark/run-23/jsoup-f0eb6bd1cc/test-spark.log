public class Person {
    private String name;
    private int age;

    public Person(String name, int age) {
        this.name = name;
        this.age = age;
    }

    @Override
    public String toString() {
        return "Name: " + name + ", Age: " + age;
    }
}

public class Main {

    public static void main(String[] args) {
        Person person = new Person("John Doe", 30);
        System.out.println(person); // Output: Name: John Doe, Age: 30

        String address = "123 Main St";
        Person...people = address.split("\\s+");
        for (Person p : people) {
            System.out.println(p); // Output: Name: John Doe, Age: 30
        }
    }

    public static void testStringSplit() {
        String[] array = {"apple", "banana", "cherry"};
        Person...people = array;
        for (Person p : people) {
            System.out.println(p);
        }
    }
}

class AnotherMain {

    public static void main(String[] args) {
        // Test the toString method
        System.out.println("Person: " + new Person("John Doe", 30));
        System.out.println("String: " + new String(new Object[]{"a", "b"}));

        // Test the ... operator
        String array = "apple";
        Person...people = array.split("\\s+");
        for (Person p : people) {
            System.out.println(p);
        }

        // Override toString method in a class
