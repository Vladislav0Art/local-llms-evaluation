import org.junit.Test;
import static org.junit.Assert.*;

public class UrlBuilderTest {

    @Test
    public void testUrlBuilder() {
        String inputUrl = "https://example.com/path?a=1&b=2";
        URLBuilder urlBuilder = new UrlBuilder(new URL(inputUrl));
        assertEquals("https:", urlBuilder.build().getScheme());
        assertEquals("path", urlBuilder.build().getPath());
        assertEquals("a", urlBuilder.appendKeyVal(new org.jsoup.KeyVal("a", "1")).getKey());
        assertEquals("b", urlBuilder.appendKeyVal(new org.jsoup.KeyVal("b", "2")).getKey());
    }

    @Test
    public void testAppendKeyVal() {
        URLBuilder urlBuilder = new UrlBuilder(new URL("https://example.com/path?a=1&b=2"));
        assertEquals("https://example.com/path?", urlBuilder.appendKeyVal(new org.jsoup.KeyVal("a", "1")).getKey());
        assertEquals("https://example.com/path?b=2", urlBuilder.appendKeyVal(new org.jsoup.KeyVal("b", "2")).getKey());
    }

    @Test
    public void testAppendKeyVal_WithMultipleKeys() {
        URLBuilder urlBuilder = new UrlBuilder(new URL("https://example.com/path?a=1&b=2"));
        assertEquals("https://example.com/path?a=1,b=2", urlBuilder.appendKeyVal(new org.jsoup.KeyVal("a", "1")).appendKeyVal(new org.jsoup.KeyVal("b", "2")).getKey());
    }

    @Test
    public void testAppendKeyVal_NullKeys() {
        URLBuilder urlBuilder = new UrlBuilder(new URL("https://example.com/path?"));
        assertNull(urlBuilder.appendKeyVal(null).get());
        assertNull(urlBuilder.appendKeyVal(new org.jsoup.KeyVal()).get());
    }
}
