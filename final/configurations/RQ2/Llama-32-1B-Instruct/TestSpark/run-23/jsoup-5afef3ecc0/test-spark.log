public class JsoupHelper {

    public static void generatePublicKey(String key) {
        System.out.println("Generated public key: " + key);
    }

    public static void generatePrivateKey(String key) {
        System.out.println("Generated private key: " + key);
    }
}

class KeyVal {
    String name;
    Object value;

    public KeyVal(String name, Object value) {
        this.name = name;
        this.value = value;
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj)
            return true;
        if (obj == null || getClass() != obj.getClass())
            return false;

        KeyVal keyVal = (KeyVal) obj;

        if (!value.equals(keyVal.value))
            return false;

        return name.equals(keyVal.name);
    }

    @Override
    public int hashCode() {
        int result = value instanceof String ? ((String) value).hashCode() : 0;
        result = 31 * result + key.length();
        return result;
    }
}

class TestSpark {

    public static void testGenerateKeyPair() {
        KeyVal[] keys = new KeyVal[]{new KeyVal("a", "1"), new KeyVal("", 0)};
        JsoupHelper.generatePublicKey(keys[0].name);
        JsoupHelper.generatePrivateKey(keys[0].value.toString());
    }

    public static void testGenerateKeyPairWithNull() {
        KeyVal[] keys = new KeyVal[]{new KeyVal("a", null), new KeyVal("", 0)};
        JsoupHelper.generatePublicKey(keys[0].name);
