    }

    public static void testGeneratePrivateKeyWithNull() {
        String key = null;
        try {
            JsoupHelper.generatePrivateKey(key);
            // expected exception
        } catch (Exception e) {
            // expected exception
        }
    }

    public static void main(String[] args) {
        testGenerateKeyPair();
        testGenerateKeyPairWithNull();
        testGeneratePublicKeyWithNull();
        testGeneratePrivateKeyWithNull();
    }
}
