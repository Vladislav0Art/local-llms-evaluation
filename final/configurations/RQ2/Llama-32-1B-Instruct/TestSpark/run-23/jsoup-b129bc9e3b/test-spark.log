        for (int i = 0; i < responses.length && i < 2; i++) {
            if (responses[i] != null) {
                String[] cookieNames = responses[i].getCookieNames();
                for (String name : cookieNames) {
                    String[] pairs = responses[i].getCookies(name).split("\\+");
                    for (String pair : pairs) {
                        System.out.println(pair);
                    }
                }

            } else {
                System.out.println("No cookies found");
            }
        }
    }
}

