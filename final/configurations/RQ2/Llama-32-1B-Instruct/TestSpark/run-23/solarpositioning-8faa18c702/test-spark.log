    public void testEstimate_PointsToTheCenter() {
        assertEquals(10000, SolarPositioning.estimate(LocalDate.now()));
    }

    @Test
    public void testEstimate_GoesOutsideTheBounds_WhenForDateIsPastNextSolarTerm() {
        double timeDifference = 366 * 24 * 60 * 60; // One day plus one year
        assertEquals(Double.MAX_VALUE, SolarPositioning.estimate(LocalDate.now().plusDays(1)));
    }

    @Test
    public void testEstimate_NegativesAreNotHandledYet() {
        assertFalse(SolarPositioning.estimate(LocalDate.now()).isNegative());
    }
}
