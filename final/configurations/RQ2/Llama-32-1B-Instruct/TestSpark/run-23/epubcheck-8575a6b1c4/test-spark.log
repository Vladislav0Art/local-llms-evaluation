                    } else if (line.contains("layout")) {
                        System.out.println(line.split("=")[1].trim());
                    }
                }

                // Check for invalid versions
                try {
                    String versionFromFile = scanner.next();
                    EpubChecker.Validator checker = new EpubChecker().createCheck(new File(versionFromFile));
                    int major = checker.main(null);
                    if (major < 2 || major > 12) {
                        throw new Exception("Invalid EPUB version: Major number");
                    }
