public class TestHelper {
    public static Document doc = null;

    public static void initDocument() {
        if (doc == null) {
            try {
                doc = new org.jsoup.Jsoup("<html><body>Hello World!</body></html>");
            } catch (Exception e) {}
        }
    }

    public static String asString(Document document) {
        return new org.jsoup.helper.StringBuilder().append(document.body()).toString();
    }

    public static void main(String[] args) {
        initDocument();

        // Test 1
        String text = "Hello World!";
        String result = asString(doc).contains(text);
        System.out.println(result); // true

        // Test 2
        initDocument();
        doc.body().text("Goodbye World!");
        result = asString(doc).contains("World");
        System.out.println(result); // false

        // Test 3
        try {
            new org.jsoup.Jsoup("<html><body>Hello</body></html>"); // should throw exception
        } catch (Exception e) {}

        // Test 4
        initDocument();
        doc.body().text("Goodbye World!");
