                System.out.print(Character.toLowerCase(c));
            } else {
                System.out.print(c);
            }
        }

        String str3 = "Hello";
        int index = 0;
        while (index < str3.length()) {
            char c = str3.charAt(index);
            if (Character.isUpperCase(c)) {
                System.out.print(Character.toLowerCase(c));
            } else {
                System.out.print(c);
            }
            index++;
        }

        String str4 = "Hello World!";
        for (int i = 0; i < str4.length(); i++) {
            char c = str4.charAt(i);
            if (c == 'W') {
                System.out.print("The word is Capital");
            } else {
