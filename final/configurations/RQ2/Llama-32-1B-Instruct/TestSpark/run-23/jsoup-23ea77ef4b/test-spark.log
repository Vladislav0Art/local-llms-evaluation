                System.out.println(arr18[i]);
            }
        }

        int[] arr19 = {1, 2, 3};
        for (int i = 0; i < arr19.length; i++) {
            if (arr19[i] == 10) {
                continue;
            } else {
                System.out.print("The element is equal to ten: ");
                System.out.println(arr19[i]);
            }
        }

        int[] arr20 = {1, 2, 3};
        for (int i = 0; i < arr20.length; i++) {
