            } else {
                System.out.print("The element is zero: ");
                System.out.println(arr16[i]);
            }
        }

        int[] arr17 = {1, 2, 3};
        for (int i = 0; i < arr17.length; i++) {
            if (arr17[i] % 2 == 0) {
                continue;
            } else {
                System.out.print("The element is odd: ");
                System.out.println(arr17[i]);
            }
        }

        int[] arr18 = {1, 2, 3};
        for (int i = 0; i < arr18.length; i++) {
            if (arr18[i] <= 10) {
