        return new URL("https://example.com").toString().split("\\.")[1];
    }

    public static void testGetDomainName() {
        try {
            System.out.println(getDomainName());
        } catch (MalformedURLException e) {
            System.err.println(e.getMessage());
        }
    }

    public static String getUrlWithProtocol() throws MalformedURLException, InterruptedException {
        Thread.sleep(1000);
        return new URL("https://example.com").toString();
    }

    public static void testgetUrlWithProtocol() {
        try {
            Thread.sleep(1000);
            System.out.println(getUrlWithProtocol());
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }
    }

