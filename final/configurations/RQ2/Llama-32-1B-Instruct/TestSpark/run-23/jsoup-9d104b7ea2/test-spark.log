public class TextNodeTest {
    private String text;

    public TestTextNodeCreateFromEncoded(TestTextNodeCreateFromEncoded createFromEncoded) {
        this.text = fromEncoded;
    }

    @Test
    public void testTextNodeCreateFromEncoded() {
        TextNode createdTextNode = createFromEncoded(text);
        assertEquals(text, createdTextNode.text());
    }

    @Test
    public void testTextNodeText() {
        text = "Hello World";
        TestTextNodeNode node = new TextNode(text);
        assertEquals("Hello World", node.text());
    }

    @Test
    public void testTextNodeTextNoBlank() {
        text = "Hello World\n";
        TestTextNodeNode node = new TextNode(text);
        assertTrue(node.isBlank());
    }

    @Test
    public void testTextNodeSplitText() {
        text = "Hello World\n";
        TestTextNodeNode node = new TextNode(text);
        String[] splitText = node.splitText(0);
        assertEquals("Hello", splitText[0]);
        assertEquals("\n", splitText[1].trim());
        assertTrue(splitText.length == 2);

        text = "Hello World\n\n";
        TestTextNodeNode node2 = new TextNode(text);
        String[] splitText2 = node2.splitText(0);
        assertEquals("Hello", splitText2[0]);
        assertEquals("\n", splitText2[1].trim());
        assertTrue(splitText2.length == 2);

        text = "Hello World\na";
        TestTextNodeNode node3 = new TextNode(text);
        String[] splitText3 = node3.splitText(0);
        assertEquals("Hello", splitText3[0]);
        assertEquals("\na", splitText3[1].trim());
        assertTrue(splitText3.length == 2);

        text = "a";
        TestTextNodeNode node4 = new TextNode(text);
        String[] splitText4 = node4.splitText(0);
        assertEquals("a", splitText4[0]);
        assertEquals("", splitText4[1].trim());
        assertTrue(splitText4.length == 1);

        text = "";
        TestTextNodeNode node5 = new TextNode(text);
        String[] splitText5 = node5.splitText(0);
        assertTrue(splitText5.length == 2);
    }

    @Test
    public void testTextNodeToString() {
        text = "Hello World";
        TestTextNodeNode node = new TextNode(text);
        assertEquals("Hello World", node.toString());
    }

    @Test
    public void testTextNodeOuterHtmlHead() throws IOException {
        text = "";
        TextNode node = new TextNode(text);
        assertEquals("", node.outerHtmlHead(null, 0, null).trim());
    }

    @Test
    public void testTextNodeOuterHtmlTail() throws IOException {
        text = "";
        TextNode node = new TextNode(text);
        assertEquals("", node.outerHtmlTail(null, 0, null).trim());
    }
}
