import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

class Row {
    private int id;
    private String column1;
    private String column2;

    public Row(int id, String column1, String column2) {
        this.id = id;
        this.column1 = column1;
        this.column2 = column2;
    }

    public int getId() {
        return id;
    }

    public String getColumn1() {
        return column1;
    }

    public String getColumn2() {
        return column2;
    }
}

public class Database {
    private List<Row> rows;

    public void insertMethodInsertIntoTable(List<Map<String, String>> table) {
        for (Map<String, String> row : table) {
            rows.add(new Row(row.get("id"), row.get("column1"), row.get("column2")));
        }
    }

    public List<Row> selectFromTable(String[] arrSQLTerms, String... strarrOperators) {
        List<Row> result = new ArrayList<>();
        for (String term : arrSQLTerms) {
            if (term.equals("SELECT")) {
                result.addAll(rows);
            } else if (strarrOperators.length > 0 && strarrOperators[0].equals(term)) {
                String[] columns = {term + " AS column", "column1 AS value1", "column2 AS value2"};
                for (int i = 1; i < terms.length - 1; i++) {
                    if (strarrOperators[i] == term) {
                        result.add(new Row(columns[i], columns[i + 1]));
                    } else {
                        result.addAll(rows);
                    }
                }
            } else {
                throw new RuntimeException("Invalid SQL syntax: " + term);
            }
        }
        return result;
    }

    public static void main(String[] args) {
        Database db = new Database();

        // Create tables
        Map<String, String> table1 = new HashMap<>();
        table1.put("id", "integer");
        table1.put("column1", "string");

        Map<String, String> table2 = new HashMap<>();
        table2.put("id", "integer");
        table2.put("column1", "string");
        table2.put("column3", "int");

        // Insert data into tables
        List<Row> rows1 = new ArrayList<>();
        Rows insertTable = new Rows();
        for (String term : new String[]{"INSERT INTO table1 VALUES (1, 'value1')"}){
            for(String op : new String[]{"id", "column1", "column2", "column3"}}) {
                if(op.equals(term)) {
                    rows1.add(insertTable.insertRow(0, 0, insertTable.getColumnValueOp(op)));
                }
            }
        }

        List<Row> rows2 = new ArrayList<>();
        Rows insertTable2 = new Rows();
        for (String term : new String[]{"INSERT INTO table2 VALUES (2, 'value3')"}) {
            for (String op : new String[]{"id", "column1", "column2"}}) {
                if (op.equals(term)) {
                    rows2.add(insertTable2.insertRow(0, 0, insertTable2.getColumnValueOp(op)));
                }
            }
        }

        // Select data from tables
        List<Row> result = db.selectFromTable(new String[]{"SELECT column1 AS id, column3 AS value2 FROM table1"} , new String[]{"column1", "column3"});

        System.out.println("\nResults of select statement:");
        for (Row row : result) {
            System.out.println(row);
        }

        List<Row> resultFromTable = db.selectFromTable(new String[]{"SELECT column1 AS id, column2 AS value FROM table2"}, new String[]{"column1", "column2"});

        System.out.println("\nResults of select statement:");
        for (Row row : resultFromTable) {
            System.out.println(row);
        }
    }

    public static class Rows {
        private List<Row> rows;

        public Row insertRow(int id, int column1, String column2) {
            return new Row(id, column1, column2);
        }

        public void insertValues(Row row, Object[] values) {
            for (Object value : values) {
                row.insert(row.getColumnValueOp(new String[]{"value"}));
            }
        }

        private static int getColumnIndex(String term, String... terms) {
            for (String s : terms) {
                if (s.equals(term)) {
                    return Integer.parseInt(s.split("\\[")[0]);
                }
            }
            throw new RuntimeException("Invalid SQL syntax: " + term);
        }

        public Row getRow(int id) {
            return rows.get(getColumnIndex("id", this));
        }

        public Object getColumnValueOp(String op) {
            int columnIndex = getColumnIndex(op, this.getColumns());
            switch (op) {
                case "id":
                    return ids[columnIndex];
                case "column1":
                    return column1s[columnIndex];
                case "column2":
                    return column2s[columnIndex];
                case "column3":
                    return column3s[columnIndex];
                default:
                    throw new RuntimeException("Invalid SQL syntax: " + op);
            }
        }

        private static String[] getColumns() {
            List<String> columns = new ArrayList<>();
            for (Row row : rows) {
                columns.add(row.getColumn1());
            }
            return columns.toArray(new String[0]);
        }

        public Row insert(Row row) {
            row.setId(id);
            return rows.add(row);
        }

        private int ids[];
        private String[] column1s;
        private String[] column2s;
        private int column3s[];

        public static class Database{
        }
    }
}
