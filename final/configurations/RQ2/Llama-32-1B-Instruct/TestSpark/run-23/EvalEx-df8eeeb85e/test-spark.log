import com.ezylang.evalex.functions.FunctionIfc;
import com.ezylang.evalex.parser.Token.Type;
import com.ezylang.evalex.parser.Tokenizer;
import com.ezylang.evalex.parsers.ParsingException;
import java.util.List;

public class TokenizerTest {

    public static void main(String[] args) {
        new TokenizerTest();
    }

    public TokenizerTest() throws ParseException, ParsingException {
        ExpressionConfiguration configuration = new ExpressionConfiguration("test expression", "test");
        List<Token> expectedTokens = parseStringLiteral();
        Tokenizer instance = new Tokenizer("test expression", configuration);

        // Test 1: parse() - single digit
        List<Token> resultTokens = parseSingleDigit();
        assertNotNull(resultTokens, expectedTokens);
        assertEquals(expectedTokens.size(), resultTokens.size());

        // Test 2: parse() - single word (e.g. "hello")
        String expressionString = "hello world";
        Tokenizer instanceWithMock = new Tokenizer(expressionString, configuration);
        List<Token> resultTokensWithMock = instanceWithMock.parse();
        assertNotNull(resultTokensWithMock, expectedTokens);

        // Test 3: parse() - multiple words (e.g. "hello world foo bar")
        expressionString = "hello world foo bar";
        Tokenizer instanceWithoutMock = new Tokenizer(expressionString, configuration);
        List<Token> resultTokensWithoutMock = instanceWithoutMock.parse();
        assertNotNull(resultTokensWithoutMock, expectedTokens);

        // Test 4: parse() - punctuation (e.g. ".")
        expressionString = ".";
        Tokenizer instanceWithMock = new Tokenizer(expressionString, configuration);
        List<Token> resultTokensWithMock = instanceWithMock.parse();
        assertNotNull(resultTokensWithMock, expectedTokens);

        // Test 5: parse() - multiple non-word characters (e.g. "-")
        expressionString = "-";
        Tokenizer instanceWithoutMock = new Tokenizer(expressionString, configuration);
        List<Token> resultTokensWithoutMock = instanceWithoutMock.parse();
        assertNotNull(resultTokensWithoutMock, expectedTokens);

        // Test 6: parse() - whitespace
        expressionString = "   ";
        Tokenizer instanceWithMock = new Tokenizer(expressionString, configuration);
        List<Token> resultTokensWithMock = instanceWithMock.parse();
        assertNotNull(resultTokensWithMock, expectedTokens);

    }

    public List<Token> parseSingleDigit() throws ParseException {
        return new ArrayList<>();
    }

    public List<Token> parseWord() throws ParseException {
        return new ArrayList<>();
    }

    public List<Token> parseMultipleWords() throws ParseException {
        return new ArrayList<>();
    }

    public List<Token> parseNumberString() throws ParseException {
        return new ArrayList<>();
    }

    public List<Token> parseParenthesesExpression() throws ParseException {
        return new ArrayList<>();
    }

    public Token parseStringLiteral() throws ParseException {
        if (type == Type.STRING) {
            return new Token(Type.STRING, "test");
        } else {
            throw new ParsingException("Invalid string literal.");
        }
    }

}
