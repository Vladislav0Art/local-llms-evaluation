import java.time.*;
import java.time.format.DateTimeFormatter;

public class SolarPosition {
    public static void main(String[] args) {
        // Define the ZonedDateTime object for the current date and time
        ZonedDateTime currentDate = ZonedDateTime.now();

        // Define the latitude and longitude of a location (San Francisco, CA)
        double latitude = 37.7749;
        double longitude = -122.4194;

        // Convert latitude and longitude to radians
        double latRad = Math.toRadians(latitude);
        double lonRad = Math.toRadians(longitude);

        // Define the time zone for the location (Pacific Standard Time)
        DateTimeFormatter tzFormatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
        ZonedDateTime date = currentDate.withZoneSameInstant(ZoneId.of("America/Los_Angeles"));

        System.out.println("Solar Position at " + date.format(tzFormatter) + ":");
        System.out.println("Latitude: " + latitude);
        System.out.println("Longitude: " + longitude);

        // Calculate the solar declination angle (in degrees)
        double declinationAngleInDegrees = 23.45 * currentDate.getDayOfWeek().getValue() - 2;
        System.out.println("Declination Angle (degrees): " + Math.toDegrees(declinationAngleInDegrees));

        // Calculate the observer location angle in radians
        double observerLocationAngleInRadians = Math.asin(Math.sin(latRad) * Math.cos(currentDate.getOffset()) / Math.sin(latRad));
        System.out.println("Observer Location Angle (radians): " + Math.toDegrees(observerLocationAngleInRadians));

        // Convert observer location angle to degrees
        double observerLocationAngleInDegrees = Math.toDegrees(observerLocationAngleInRadians);
        System.out.println("Observer Location Angle (degrees): " + observerLocationAngleInDegrees);

        // Calculate the solar altitude angle in radians
        double solarAltitudeAngleInRadians = Math.asin(Math.sin(latRad) * Math.cos(currentDate.getOffset()) / Math.sin(latRad));
        System.out.println("Solar Altitude Angle (radians): " + Math.toDegrees(solarAltitudeAngleInRadians));

        // Calculate the observer location angle in degrees
        double solarAltitudeAngleInDegrees = Math.toDegrees(Math.atan2(Math.sin(observerLocationAngleInRadians), Math.cos(observerLocationAngleInRadians)));
        System.out.println("Solar Altitude Angle (degrees): " + Math.toDegrees(solarAltitudeAngleInDegrees));

        // Calculate the declination angle in degrees
        double solarDeclinationAngleInDegrees = 23.45 * currentDate.getDayOfWeek().getValue() - 2;
        System.out.println("Solar Declination Angle (degrees): " + Math.toDegrees(solarDeclinationAngleInDegrees));

        // Calculate the observer location angle in radians
        double solarDeclinationAngleInRadians = Math.asin(Math.sin(latRad) * Math.cos(currentDate.getOffset()) / Math.sin(latRad));
        System.out.println("Solar Declination Angle (radians): " + Math.toDegrees(solarDeclinationAngleInRadians));

        // Calculate the angle between the sun's position and the observer's location
        double solarAltitudeAngleInDegreesFromTrigonometric = Math.toDegrees(Math.atan2(Math.sin(observerLocationAngleInRadians), Math.cos(observerLocationAngleInRadians)));
        System.out.println("Solar Altitude Angle (degrees): " + Math.toDegrees(solarAltitudeAngleInDegreesFromTrigonometric));

        // Calculate the final result
        double result = 90 - Math.min(currentDate.getDayOfWeek().getValue(), Math.abs(observerLocationAngleInRadians - solarAltitudeAngleInDegreesFromTrigonometric));
        System.out.println("Final Result: " + result);
    }
}
```

