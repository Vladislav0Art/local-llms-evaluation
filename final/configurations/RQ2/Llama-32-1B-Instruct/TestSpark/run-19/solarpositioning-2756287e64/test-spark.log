public class SolarPosition {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        System.out.println("Enter the date in the format yyyy-MM-dd:");
        String dateStr = scanner.nextLine();
        LocalDate localDate = LocalDate.parse(dateStr, DateTimeFormatter.ofPattern("yyyy-MM-dd"));
        ZonedDateTime currentDate = ZonedDateTime.now().withLocalTime(12).withZoneSameInstant(ZoneId.of("America/Los_Angeles"));

        System.out.println("Enter the latitude in degrees:");
        double latitude = scanner.nextDouble();
        scanner.nextLine(); // Consume newline left-over
        System.out.println("Enter the longitude in degrees:");
        double longitude = scanner.nextDouble();
        scanner.nextLine(); // Consume newline left-over

