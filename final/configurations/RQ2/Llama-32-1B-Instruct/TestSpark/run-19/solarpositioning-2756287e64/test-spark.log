        System.out.println("Solar Altitude Angle (radians): " + Math.toDegrees(solarAltitudeAngleInRadians));

        double observerLocationAngleInDegrees = Math.toDegrees(Math.atan2(Math.sin(observerLocationAngleInRadians), Math.cos(observerLocationAngleInRadians)));
        System.out.println("Observer Location Angle (degrees): " + Math.toDegrees(observerLocationAngleInDegrees));

        double solarDeclinationAngleInDegrees = 23.45 * localDate.getDayOfWeek().getValue() - 2;
        System.out.println("Solar Declination Angle (degrees): " + Math.toDegrees(solarDeclinationAngleInDegrees));

        double solarAltitudeAngleInDegreesFromTrigonometric = Math.toDegrees(Math.atan2(Math.sin(observerLocationAngleInRadians), Math.cos(observerLocationAngleInRadians)));
        System.out.println("Solar Altitude Angle (degrees): " + Math.toDegrees(solarAltitudeAngleInDegreesFromTrigonometric));

        double result = 90 - Math.min(currentdate.getDayOfWeek().getValue(), Math.abs(observerLocationAngleInRadians - solarAltitudeAngleInDegreesFromTrigonometric));
        System.out.println("Final Result: " + result);
    }
