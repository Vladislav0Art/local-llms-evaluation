        ZonedDateTime solarPosition = currentdate.withOffsetSameInstant(ZoneOffset.UTC);

        System.out.println("Solar Position at " + dateWithTimezone.format(DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss")));
