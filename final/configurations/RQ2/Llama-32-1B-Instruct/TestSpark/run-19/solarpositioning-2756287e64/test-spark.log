        double pressure = 1013.25; // Standard Atmospheric Pressure (millibars)
        double temperature = 22.2222; // Temperature in degrees Celsius

        System.out.println(SolarPosition.calculateSolarPosition(date, latitude, longitude, deltaT, pressure, temperature));
    }
}
