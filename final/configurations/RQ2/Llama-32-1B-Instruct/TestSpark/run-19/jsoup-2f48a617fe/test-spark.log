import org.junit.jupiter.api.Test;
import org.jsoup.nodes.Comment;
import org.jsoup.parser.ParseSettings;
import org.jsoup.parser.Parser;
import java.io.IOException;

public class CommentTest {

    @Test
    public void nodeNameTest() {
        Comment comment = new Comment("This is a test comment");
        assertEquals("Comment", comment.nodeName());
    }

    @Test
    public void getDataTest() {
        Comment comment = new Comment("This is a test comment");
        assertEquals("This is a test comment", comment.getData());
    }

    @Test
    public void setDataTest() {
        Comment comment = new Comment("This is a test comment");
        comment.setData("This is the updated data");
        assertEquals("This is the updated data", comment.getData());
    }

    @Test
    public void outerHtmlHeadTest() throws IOException {
        ParseSettings settings = new ParseSettings();
        settings.setDocumentMode(0);
        Comment comment = new Comment("This is a test comment");
        String expectedOuterHtmlHead = "<!-- This is the inner content -->";
        assertEquals(expectedOuterHtmlHead, comment.outerHtmlHead(settings, 1, null));
    }

    @Test
    public void outerHtmlTailTest() {
        ParseSettings settings = new ParseSettings();
        Comment comment = new Comment("This is a test comment");
        String expectedOuterHtmlTail = "<!-- This is the inner content -->";
        assertEquals(expectedOuterHtmlTail, comment.outerHtmlTail(settings, 1, null));
    }

    @Test
    public void toStringTest() {
        Comment comment = new Comment("This is a test comment");
        String expectedToString = "Comment\nThis is a test comment";
        assertEquals(expectedToString, comment.toString());
    }

    @Test
    public void cloneTest() {
        Comment originalComment = new Comment("This is a test comment");
        Comment clonedComment = originalComment.clone();
        assertEquals(originalComment, clonedComment);
    }

    @Test
    public void isXmlDeclarationTest() {
        boolean expectedIsXmlDeclaration = true;
        boolean actualIsXmlDeclaration = Comment.class.isXmlDeclaration();
        assertTrue(actualIsXmlDeclaration, "expected is_xml_declaration is false");
    }

    @Test
    public void asXmlDeclarationTest() throws IOException {
        Comment comment = new Comment("This is a test comment");
        String expectedAsXmlDeclaration = "<!DOCTYPE html><html><head></head><body>Comment</body></html>";
        String actualAsXmlDeclaration = comment.asXmlDeclaration();
        assertEquals(expectedAsXmlDeclaration, actualAsXmlDeclaration);
    }
}
