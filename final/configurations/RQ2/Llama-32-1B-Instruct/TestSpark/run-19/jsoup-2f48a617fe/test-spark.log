import org.jsoup.nodes.Comment;
import org.jsoup.parser.ParseSettings;
import org.jsoup.parser.Parser;

public class CommentTest {

    public static String nodeName(Comment comment) {
        return comment.nodeName();
    }

    public static String getData(Comment comment) {
        return comment.getData();
    }

    @Test
    public void nodeNameTest() {
        Comment comment = new Comment("This is a test comment");
        assertEquals("Comment", nodeName(comment));
    }

    @Test
    public void getDataTest() {
        Comment comment = new Comment("This is a test comment");
        assertEquals("This is a test comment", getData(comment));
    }

    @Test
    public void outerHtmlHeadTest() {
        Comment comment = new Comment("<html><body>Hello World!</body></html>");
        String expectedOuterHtmlHead = "<!DOCTYPE html><html><head><title>Test</title></head><body>" + comment.getData() + "</body></html>";
        assertEquals(expectedOuterHtmlHead, comment.outerHtmlHead(new ParseSettings(), 1, null));
    }

    @Test
    public void outerHtmlTailTest() {
        Comment comment = new Comment("<html><body>Hello World!</body></html>");
        String expectedOuterHtmlTail = "<!DOCTYPE html><html><head><title>Test</title></head><body>" + comment.getData() + "</body></html>";
        assertEquals(expectedOuterHtmlTail, comment.outerHtmlTail(new ParseSettings(), 1, null));
    }

    @Test
    public void toStringTest() {
        Comment comment = new Comment("This is a test comment");
        String expectedToString = "Comment This is a test comment";
        assertEquals(expectedToString, comment.toString());
    }

    @Test
    public void isXmlDeclarationTest() {
        Comment comment = new Comment("<html><body>Hello World!</body></html>");
        boolean actualIsXmlDeclaration = Comment.class.isXmlDeclaration(comment);
        assertTrue(actualIsXmlDeclaration, "expected is_xml_declaration to be true");
    }
}
