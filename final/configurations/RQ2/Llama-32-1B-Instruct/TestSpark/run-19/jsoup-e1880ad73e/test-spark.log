public class URLParser {

    /**
     * Splits an input URL into its components (base URL, path, query parts).
     *
     * @param inputUrl the input URL to parse
     * @return an array of strings containing the base URL, path, and query parts
     */
    public static String[] urls(String inputUrl) {
        // Split the input URL into its components
        String[] urlParts = inputUrl.split("/");
        
        // Get the base URL from the first part (everything except for any query parameters)
        String base = urlParts[0];
        
        // Split the path into individual parts using '/' as the delimiter
        String[] queryParts = urlParts[1].split("&");
        
        // Initialize a StringBuilder to build the final query string
        StringBuilder sb = new StringBuilder();
        
        // Iterate over each query part and append it to the StringBuilder
        for (String part : queryParts) {
            if (!part.isEmpty()) {
                String[] keyValue = part.split("=");
                
                // Append the base URL, query parameters, and value to the StringBuilder in the correct order
                sb.append(base).append("?").append(queryParts.indexOf(part)).append("=").append(keyValue[0]).append("=").append(keyValue[1]);
            }
        }
        
        return new String[]{base, sb.toString()};
    }

