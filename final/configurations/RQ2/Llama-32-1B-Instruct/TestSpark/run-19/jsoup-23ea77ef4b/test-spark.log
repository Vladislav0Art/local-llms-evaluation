    public void convertDocument_conversion() {
        Document in = new Document();
        W3CDom convert = new W3CDom(in);
        Document out = convert.convert();
        assertEquals(in, out);
    }

    @Test
    public void convertDocToString_conversion() {
        Document doc = new Document();
        String result = W3CDom.convert(doc, null);
        Assert.assertEquals("null", result);
    }

