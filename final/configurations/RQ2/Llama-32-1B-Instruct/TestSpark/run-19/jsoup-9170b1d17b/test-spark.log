import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;

public class JsoupTools {

    public static String parseHtml(String html) {
        return Jsoup.parse(html).html();
    }

    public static void main(String[] args) {
        Document document = parseHtml("<html><body>Hello World!</body></html>");
        System.out.println(parseHtml(document.outerHtml()));

        Map<String, String> dataset = new AbstractMap<>();
        for (int i = 1; i <= 10; i++) {
            dataset.put("id", "case_" + i);
            dataset.put("name", "case_" + i);
        }
        assertEquals(11, dataset.size());

        Document body = parseHtml("<body>Hello World!</body>");
        System.out.println(body.body().text());
    }

    public static void testParseHtml() {
        for (int i = 1; i <= 10; i++) {
            Map<String, String> dataset = new AbstractMap<>();
            for (int j = 1; j <= 10; j++) {
                dataset.put("id", "case_" + i);
                dataset.put("name", "case_" + i);
            }
            assertEquals(11, dataset.size());
        }

        Document body = parseHtml("<body>Hello World!</body>");
        System.out.println(body.body().text());
    }

    public static void testParseHtml2() {
        String html = "<p>Hello</p>";
        System.out.println(parseHtml(html));
    }

    public static void testPrintMap() {
        Map<String, String> dataset = new AbstractMap<>();
        for (int i = 1; i <= 10; i++) {
            dataset.put("id", "case_" + i);
            dataset.put("name", "case_" + i);
        }
        System.out.println(dataset);
    }

    public static void testParseHtml3() {
        Document document = parseHtml("<html><body>Hello World!</body></html>");
        System.out.println(document.body().text());
    }

    public static String generateRandomString(int length) {
        Random random = new Random();
        StringBuilder sb = new StringBuilder(length);
        for (int i = 0; i < length; i++) {
            sb.append((char) ('a' + random.nextInt(26)));
        }
        return sb.toString();
    }

    public static void main(String[] args) {
        System.out.println(generateRandomString(10));
    }
}
