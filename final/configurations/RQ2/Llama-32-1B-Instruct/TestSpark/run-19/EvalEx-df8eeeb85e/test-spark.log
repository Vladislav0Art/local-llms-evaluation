import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class EvalTest {

    public double calculate(String expression) {
        Pattern pattern = Pattern.compile("\\d+.*?\\s*(+|-|\\*|/|\^)");
        Matcher matcher = pattern.matcher(expression);
        StringBuffer result = new StringBuffer();

        while (matcher.find()) {
            if (!matcher.group(1).isEmpty() && !matcher.group(2).isEmpty()) {
                switch (matcher.group(0).charAt(0)) {
                    case '+':
                        result.append((double) Double.parseDouble(matcher.group(1)) + Double.parseDouble(matcher.group(2)));
                        break;
                    case '-':
                        result.append((double) Double.parseDouble(matcher.group(1)) - Double.parseDouble(matcher.group(2)));
                        break;
                    case '*':
                        result.append((double) Double.parseDouble(matcher.group(1)) * Double.parseDouble(matcher.group(2)));
                        break;
                    default:
                        result.append((double) Double.parseDouble(matcher.group(1)));
                }
            } else if (matcher.group(0).isEmpty()) {
                result.append(Double.parseDouble(matcher.group(2)));
            } else {
                result.append((double) Double.parseDouble(matcher.group(3)));
            }
        }

        return Double.parseDouble(result.toString());
    }

    public static void main(String[] args) {
        EvalTest eval = new EvalTest();

        System.out.println(eval.calculate("10 + 5 * 2")); // Expected output: 30.0
        System.out.println(eval.calculate("(10 - 5) / 2")); // Expected output: 2.0
    }
}
```

