```java
public class EvalTest {

    public double calculate(String expression) {
        return eval(expression);
    }

    private double eval(String expression) {
        // Remove leading and trailing whitespace, and any spaces around operators
        String trimmedExpression = expression.trim();

        // Check for parentheses to handle expressions like (1+2)*(3-4)
        int openParenthesisIndex = trimmedExpression.indexOf('(');
        if (openParenthesisIndex != -1) {
            double value;
            try {
                // Parse the expression inside the parentheses
                value = eval(trimmedExpression.substring(0, openParenthesisIndex));
            } catch (NumberFormatException e) {
                return 0; // Invalid expression
            }

            // Evaluate the outer part of the expression
            double result = eval(trimmedExpression.substring(openParenthesisIndex + 1));

            // Return the result
            return value * result;
        } else {
            try {
                // Parse the expression without parentheses (assuming it's a simple number)
                int index = trimmedExpression.indexOf('*');
                if (index == -1) {
                    index = trimmedExpression.indexOf('/');
                }
                double value = Double.parseDouble(trimmedExpression.substring(0, index));
                return value * eval(trimmedExpression.substring(index + 1));
            } catch (NumberFormatException e) {
                // Invalid expression
                return 0;
            }
        }
    }

    public static void main(String[] args) {
        EvalTest eval = new EvalTest();

        System.out.println(eval.calculate("10 + 2 * 3")); // Expected output: 16.0

        String expression = "5 > (2 - 1)";
        System.out.println("Is " + expression + " true? " + eval.calculate(expression));
    }
}
```

