        Row selectedRow = database.selectRow("Table1", "Name == 'John'");
        System.out.println(selectedRow);

        // Update a row in the database
        database.updateRow("Table1", "Name == 'John'", new Row("Age", "30"));

        System.out.println(database.toString());

        // Delete a row from the database
        database.deleteRow("Table2", "Age > 30");

        System.out.println(database.toString());

        // Add a new row to the database
        database.addNewRow("Table1", "Name", "Alice");
        database.printDatabase();

        System.out.println("All rows in Table 1:");
        for (Row row : database.getRowValues("Table1", "Name == 'John'")) {
            System.out.println(row);
        }

        System.out.println("All tables:");
        for (Map.Entry<String, List<Row>> entry : database.tables.entrySet()) {
            System.out.println(entry.getKey());
            for (Row row : entry.getValue()) {
                System.out.println(row);
            }
        }
    }
