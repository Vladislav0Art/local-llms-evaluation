class Database {
    private List<Table> tables;

    public Database() {
        this.tables = new ArrayList<>();
    }

    // Add a table to the database
    public void addTable(Table table) {
        this.tables.add(table);
    }

    // Select a table from the database
    public Table selectFromTable(String tableName, String condition) throws Exception {
        for (Table table : tables) {
            if (table.getName().equals(tableName)) {
                return table;
            }
        }
        throw new Exception("No matching table found");
    }

    // Update a table in the database
    public void updateFromTable(String tableName, String condition, Table table) throws Exception {
        for (Table existingTable : tables) {
            if (existingTable.getName().equals(tableName) && existingTable.getCondition().equals(condition)) {
                existingTable.setNew(table);
                return;
            }
        }
        throw new Exception("No matching table found");
    }

    // Delete a table from the database
    public void deleteFromTable(String tableName, String condition) throws Exception {
        for (Table table : tables) {
            if (table.getName().equals(tableName) && table.getCondition().equals(condition)) {
                this.tables.remove(table);
                return;
            }
        }
        throw new Exception("No matching table found");
    }

    // Add a new table to the database
    public void addNewTable(Table table) {
        this.tables.add(table);
    }

    // Get all tables from the database
    public List<Table> getTables() {
        return this.tables;
    }

    // Select a specific row from the database
    public Table selectRow(String tableName, String condition, String rowId) throws Exception {
        for (Table table : tables) {
            if (table.getName().equals(tableName)) {
                for (String key : table.getRowMap().keySet()) {
                    if (table.getRowMap().get(key).equals(rowId)) {
                        return table;
                    }
                }
            }
        }
        throw new Exception("No matching row found");
    }

    // Update a specific row in the database
    public void updateRow(String tableName, String condition, Table row) throws Exception {
        for (Table existingTable : tables) {
            if (existingTable.getName().equals(tableName) && existingTable.getCondition().equals(condition)) {
                existingTable.setNew(row);
                return;
            }
        }
        throw new Exception("No matching table found");
    }

    // Delete a specific row from the database
    public void deleteRow(String tableName, String condition, String rowId) throws Exception {
        for (Table table : tables) {
            if (table.getName().equals(tableName) && table.getCondition().equals(condition)) {
                this.tables.remove(table);
                return;
            }
        }
        throw new Exception("No matching table found");
    }

    // Get all rows from the database
    public List<Table> getRows(String tableName, String condition) throws Exception {
        for (Table table : tables) {
            if (table.getName().equals(tableName)) {
                Table row = selectFromTable(tableName, condition);
                return new ArrayList<>(row.getRowMap());
            }
        }
        throw new Exception("No matching table found");
    }

    // Print the database
    public void printDatabase() {
        for (Table table : tables) {
            System.out.println(table.toString());
        }
    }
}

class Table {
    private String name;
    private String condition;

    public Table(String name, String condition) {
        this.name = name;
        this.condition = condition;
    }

    public String getName() {
        return name;
    }

