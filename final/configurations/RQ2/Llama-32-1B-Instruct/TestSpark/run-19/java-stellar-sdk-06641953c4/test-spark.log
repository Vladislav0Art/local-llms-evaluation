    private byte[] generateSecretSeed(String password) throws IOException {
        // Generate secret seed from a password
        SecretKeyFactory f = SecretKeyFactory.getInstance("RSA");
        PrivateKey privateKey = f.generatePrivate(new PKCS8EncodedKeySpec(password.getBytes()));
        return f.generateSecret(secretSeed);
    }

    public static byte[] encrypt(byte[] data, byte[] key) throws Exception {
        // Encrypt the data using AES with CBC mode
        javax.crypto.Cipher cipher = javax.crypto.Cipher.getInstance("AES/CBC/PKCS5Padding");
        cipher.init(javax.crypto.Cipher.ENCRYPT_MODE, new javax.crypto.spec.PBEKeySpec(key));
        return cipher.doFinal(data);
