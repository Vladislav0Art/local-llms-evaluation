        javax.crypto.Cipher cipher = javax.crypto.Cipher.getInstance("AES/CBC/PKCS5Padding");
        cipher.init(javax.crypto.Cipher.ENCRYPT_MODE, new javax.crypto.spec.PBEKeySpec(key));
        return cipher.doFinal(key);
    }

    public static byte[] generatePrivateKeyFromPublicKey(byte[] publicKey) throws Exception {
        // Get private key from public byte array
        SecretKeyFactory f = SecretKeyFactory.getInstance("RSA");
        PrivateKey privateKey = f.generatePrivate(new PKCS8EncodedKeySpec(publicKey));
        return privateKey;
    }

