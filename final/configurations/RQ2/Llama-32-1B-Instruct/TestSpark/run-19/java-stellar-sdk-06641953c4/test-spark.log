import org.junit.jupiter.api.Test;
import java.io.ByteArrayOutputStream;
import java.io.IOException;

public class TestGeneratePublicKey {
    @Test
    void testGeneratePublicKey() throws IOException {
        // Generate public key
        byte[] publicKey = generatePublicKey();

        // Verify length of public key
        assert publicKey.length == 32;

        // Get public byte array from binary string
        byte[] publicKeyAsByteArray = new byte[32];
        for (int i = 0; i < publicKey.length; i++) {
            publicKeyAsByteArray[i] = publicKey[i];
        }

        // Verify length of public byte array
        assert publicKeyAsByteArray.length == 32;

        // Print binary string
        System.out.println("Binary String: " + new String(publicKey));

        // Get private key from public byte array
        byte[] privateKey = generatePrivateKeyFromPublicKey(publicKey);

        // Verify length of private key
        assert privateKey.length == 32;

        // Verify bytes are equal to private key
        assert publicKeyAsByteArray[0] == privateKey[0];

        for (int i = 1; i < privateKey.length; i++) {
            assert publicKeyAsByteArray[i] == privateKey[i];
        }
    }

    public byte[] generatePublicKey() throws IOException {
        // Generate secret seed from a password
        String password = "mysecretpassword";
        byte[] secretSeed = generateSecretSeed(password);

        // Encrypt the secret seed using public key
        byte[] publicKeyAsByteArray = encrypt(secretSeed, publicKeyToBytes());

        return publicKeyAsByteArray;
    }

    private byte[] generateSecretSeed(String password) throws IOException {
        // Generate secret seed from a password
        SecretKeyFactory f = SecretKeyFactory.getInstance("RSA");
        PrivateKey privateKey = f.generatePrivate(new PKCS8EncodedKeySpec(password.getBytes()));
        return f.generateSecret(secretSeed);
    }

    public static byte[] encrypt(byte[] data, byte[] key) throws Exception {
        // Encrypt the data using AES with CBC mode
        javax.crypto.Cipher cipher = javax.crypto.Cipher.getInstance("AES/CBC/PKCS5Padding");
        cipher.init(javax.crypto.Cipher.ENCRYPT_MODE, new javax.crypto.spec.PBEKeySpec(key));
        return cipher.doFinal(data);
    }

    public static byte[] encrypt(byte[] key) throws Exception {
        // Encrypt the data using AES with CBC mode
