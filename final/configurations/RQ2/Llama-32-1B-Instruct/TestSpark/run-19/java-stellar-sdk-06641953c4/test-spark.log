    private byte[] generateRandomBytes(int length) {
        try (ByteArrayOutputStream bos = new ByteArrayOutputStream()) {
            while (true) {
                byte[] chunk = new byte[length];
                int bytesRead = bos.read(chunk);
                if (bytesRead == -1) {
