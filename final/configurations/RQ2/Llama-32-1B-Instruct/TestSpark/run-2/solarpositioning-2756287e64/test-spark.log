import java.util.Arrays;

public class Main {
    public static void main(String[] args) {
        testGetSqrt();
        multiplyMatrix();
    }

    public static int[][] getSquareRoot(int[][] matrix) {
        Random rand = new Random();
        int length = matrix.length;
        for (int i = 0; i < length; i++) {
            if (i == 0 || i == length - 1) {
                for (int j = 0; j < length; j++) {
                    matrix[i][j] *= 2;
                }
            } else {
                for (int mid = rand.nextInt(length); mid < length / 2; mid++) {
                    int temp = matrix[mid][i];
                    matrix[mid][i] = matrix[rand.nextInt(length)][mid];
                    matrix[rand.nextInt(length)][mid] = temp;
                }
            }
        }

        return matrix;
    }

    public static void testGetSqrt() {
        int[][] matrix1 = {{1, 2}, {3, 4}};
        int[][] matrix2 = {{5, 6}, {7, 8}};

        System.out.println("Matrix A:");
        printMatrix(matrix1);
        System.out.println();

        int[] array = getSquareRoot(matrix1);
        System.out.println("Result of sqrt:");
        printArray(array);

        System.out.println("Transpose Matrix B:");
        System.out.println(printTranspose(matrix2));
    }

    public static void multiplyMatrix() {
        int[][] matrixA = {{1, 2}, {3, 4}};
        int[][] result = new int[matrixA.length][matrixA.length];

        for (int i = 0; i < matrixA.length; i++) {
            for (int j = 0; j < matrixA[i].length; j++) {
                if (i == j) {
                    result[i][j] = matrixA[0][j];
                } else {
                    for (int mid = 1; mid < matrixA.length; mid++) {
                        int sum = 0;
                        for (int k = 0; k < matrixA[mid].length; k++) {
                            sum += matrixA[i][k] * matrixA[mid][k];
                        }
                        result[i][j] = sum;
                    }
                }
            }
        }

        System.out.println("Result of Matrix A \*\* Matrix B:");
        printMatrix(result);
    }

    public static void printArray(int[] array) {
        for (int i = 0; i < array.length; i++) {
            System.out.print(array[i] + " ");
        }
        System.out.println();
    }

    public static int[][] printTranspose(int[][] matrix) {
