public class EvalFunc {
    private Map<String, Object> functions = new HashMap<>();
    private Map<String, Object> operators = new HashMap<>();

    public void addFunction(String key, String value) {
        functions.put(key, value);
    }

    public void addOperator(String key, String value) {
        operators.put(key, value);
    }

    public Map<String, Object> getFunctions() {
        return functions;
    }

    public Map<String, Object> getOperators() {
        return operators;
    }
}

