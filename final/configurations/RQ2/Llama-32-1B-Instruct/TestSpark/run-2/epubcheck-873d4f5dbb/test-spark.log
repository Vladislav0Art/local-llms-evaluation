        assertTrue(TestUtils.isValidString("hello"));
    }

    @Test
    public void testIsValidString_EmptyStrings() {
        assertFalse(TestUtils.isValidString(""));
    }
}

public class TestClass2 {
    @Test
    public void testCalculateSum_AnyNumbers() {
        int[] numbers = {1, 2};
        assertEquals(3, TestUtils.calculateSum(numbers));
    }
