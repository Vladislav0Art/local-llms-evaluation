public class TestHttpConnection {
    private static final CookieManager cookieManager = new DefaultCookieManager();
    private static final String url1 = "https://example.com";
    private static final URL url2 = new URI(url1).resolve("new-path");

    public static void main(String[] args) throws Exception {
        HttpConnection conn1 = TestHttpConnection.connect(url1);
        System.out.println(conn1.get().toString());

        ConnectionRequest request1 = new Request();
        request1.method(Method.HEAD);
        conn1.request(request1);

        ConnectionResponse response1 = conn1.response();
        System.out.println(response1.toString());
    }
}

class HttpConnectionTest {
    private CookieManager cookieManager = new DefaultCookieManager();

    public void testConnect() throws MalformedURLException, URISyntaxException {
        TestHttpConnection.conn1 = TestHttpConnection.connect(url1);
    }

    public void testGetResponse() throws IOException {
        System.out.println(TestHttpConnection.get().toString());
    }

    public void testCookieStore() throws CookieStoreException {
        String newKey = "new-value";
        Map<String, String> cookies = new LinkedHashMap<>();
        cookies.put(newKey, "value");
        TestHttpConnection.cookieManager.setCookieStore(cookieManager);
        System.out.println(TestHttpConnection.cookieManager.getCookieStore().toString());
    }

    public void testRequest() throws RequestException {
        Request request = new Request();
        request.method(Method.HEAD);
        request.from("from", "to");
        TestHttpConnection.conn1.request(request);
    }
}

