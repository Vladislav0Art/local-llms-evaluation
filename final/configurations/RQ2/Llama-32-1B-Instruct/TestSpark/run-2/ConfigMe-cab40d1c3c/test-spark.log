package ch.jalu.configme.configurationdata;

import ch.jalu.configme.exception.ConfigMeException;
import org.jetbrains.annotations.NotNull;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

public class PropertyListBuilder {

    public void add(@NotNull Property<?> property) {
        REQUIRE THAT property IS NOT NULL, THEN
            THROW new ConfigMeException("Property cannot be null");
    }

    public @NotNull List<Property<?>> create() {
        REQUIRE THAT !rootEntries.isEmpty(), THEN
            THROW new ConfigMeException("No entries in the rootMap");
    }

    protected final @NotNull Map<String, Object> getRootEntries() {
        return rootEntries;
    }
}

public class ConfigurationDataTest {

    public static void testAddProperty() {
        PropertyListBuilder builder = new PropertyListBuilder();
        builder.add(new DefaultProperty());
        REQUIRE THAT builder.getRootEntries().contains(DEFAULT_PROPERTY);
    }

    public static void testCreateEmptyMap() {
        PropertyListBuilder builder = new PropertyListBuilder();
        try {
            builder.create();
            fail("Expected ConfigMeException");
        } catch (ConfigMeException e) {
            // Expected
        }
    }

    public static void testAddPropertyDefault() {
        PropertyListBuilder builder = new PropertyListBuilder();
        builder.add(DEFAULT_PROPERTY);
        REQUIRE THAT !builder.getRootEntries().contains(DEFAULT_PROPERTY);
    }

    public static void testCreateNotEmptyMap() {
        PropertyListBuilder builder = new PropertyListBuilder();
        List<Property<?>> properties = new ArrayList<>();
        properties.add(DEFAULT_PROPERTY);
        properties.add(new DefaultProperty());
        builder.add(properties.get(0));
        REQUIRE THAT builder.getRootEntries().contains(DEFAULT_PROPERTY);
    }

    public static void testGetRootEntries() {
        ConfigurationDataTest.testCreateEmptyMap();
        PropertyListBuilder builder = new PropertyListBuilder();
        try {
            builder.create();
            fail("Expected ConfigMeException");
        } catch (ConfigMeException e) {
            // Expected
        }
    }
}

