        String html = "<html><body>Hello World!</body></html>";
        String encodedText = org.xml.sax.InputSource.fromString(html).getContents().replace("<", "&lt;").replace(">", "&gt;");
        Node outerNode = document.outerHtmlTail(encodedText);
        assertEquals("text", outerNode.nodeName());
    }

    public void testText() throws IOException {
        document = new Document();
        String html = "<html><body>Hello World!</body></html>";
        String encodedText = org.xml.sax.InputSource.fromString(html).getContents().replace("<", "&lt;").replace(">", "&gt;");
        TextNode node = document.getText(encodedText);
        assertEquals("Hello World!", node.text());
    }

    public void testSplitText() throws IOException {
        document = new Document();
        String html = "<html><body>Hello World!</body></html>";
        String encodedText = org.xml.sax.InputSource.fromString(html).getContents().replace("<", "&lt;").replace(">", "&gt;");
        Node outerNode = document.outerHtmlHead(encodedText);
        assertEquals(Arrays.asList("Hello", "World"), outerNode.splitText(0));
    }

    public void testGetWholeText() throws IOException {
        document = new Document();
        String html = "<html><body>Hello World!</body></html>";
        String encodedText = org.xml.sax.InputSource.fromString(html).getContents().replace("<", "&lt;").replace(">", "&gt;");
        TextNode node = document.getText(encodedText);
        assertEquals(HTMLParser.htmlToText(node), "Hello World!");
    }

    public void testHashCode() throws IOException {
        document = new Document();
        String html = "<html><body>Hello World!</body></html>";
        String encodedText = org.xml.sax.InputSource.fromString(html).getContents().replace("<", "&lt;").replace(">", "&gt;");
        Appendable result = document.outerHtmlTail(new ArrayList<>());
        assertEquals(123, Integer.hashCode(result));
    }

    public void testCompare() throws IOException {
        document = new Document();
        String html = "<html><body>Hello World!</body></html>";
        String encodedText = org.xml.sax.InputSource.fromString(html).getContents().replace("<", "&lt;").replace(">", "&gt;");
        Appendable result = document.outerHtmlHead(encodedText);
        assertEquals(456, Integer.compare(result.hashCode(), 123));
    }
}

