import java.util.Random;

public class TestKeyPair {

    public static class EdDSAPublicKey {
        private byte[] secretSeed;
        private String accountId;

        public EdDSAPublicKey(byte[] secretSeed, String accountId) {
            this.secretSeed = secretSeed;
            this.accountId = accountId;
        }

        public byte[] getSecretSeed() {
            return secretSeed;
        }

        public String getAccountId() {
            return accountId;
        }
    }

    public static class KeyPair {
        private EdDSAPublicKey publicKey;
        private char[] secretSeed;

        public KeyPair(EdDSAPublicKey publicKey, char[] secretSeed) {
            this.publicKey = publicKey;
            this.secretSeed = secretSeed;
        }

        public EdDSAPublicKey getPublicKey() {
            return publicKey;
        }

        public char[] getSecretSeed() {
            return secretSeed;
        }
    }

    public static void testRandomKeyPair() throws Exception {
        // Generate random data
        byte[] randomData = new byte[32];
        Random rand = new Random();
        for (int i = 0; i < randomData.length; i++) {
            randomData[i] = (byte) (rand.nextInt(256));
