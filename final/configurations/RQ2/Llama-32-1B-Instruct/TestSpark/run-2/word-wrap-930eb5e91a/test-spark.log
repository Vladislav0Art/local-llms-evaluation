            }
            builder.append("\n");
            len = 0;
        }
        // Return truncated line
        while (builder.length() < width && !buildNextLineHelper(builder, bufferChars)) {
            if (!lineConsumer.accept(builder.toString())) {
                throw new IOException("End of input reached");
