import org.davidmoten.text.utils.WordWrap.Builder;
import org.junit.jupiter.api.Test;
import static org.davidmoten.text.utils.WordWrap.*; // Use this to import the class you want to test

public class WordWrapBuilderTest {

    @Test
    public void wordWrap_WithClose() throws IOException {
        Builder builder = fromClasspathUtf8("test.txt");
        String text = "Hello World";
        StringBuilder2 result = wordWrap(new InputStreamReader(Builder.class.getResourceAsStream("test.txt")), System.out, 100,
                Function.identity(), null, false, true);
        assertEquals(text, result.toString());
    }

    @Test
    public void wordWrap_WithLineConsumer() throws IOException {
        Builder builder = fromClasspathUtf8("test.txt");
        String text = "Hello World\nThis is a test";
        LineConsumer out = System.out;
        BufferedWriter writer = new BufferedWriter(new OutputStreamWriter(System.out, StandardCharsets.UTF_8));
        wordWrap(builder, out, 100,
                Function.identity(), null, false, true);
        assertEquals(text, String.join("\n", Arrays.asList(out.toString(), "\n")));
    }

    @Test
    public void wordWrap_NoExtraChars() throws IOException {
        Builder builder = fromClasspathUtf8("test.txt");
        String text = "Hello World";
        StringBuilder2 result = wordWrap(new InputStreamReader(Builder.class.getResourceAsStream("test.txt")), System.out, 100,
                Function.identity(), null, false, true);
        assertEquals(text, result.toString());
    }

    @Test
    public void wordWrap_WithWhitespace() throws IOException {
        Builder builder = fromClasspathUtf8("test.txt");
        String text = "Hello World";
        assertTrue(WordWrap.isWhitespace(text));
    }

    @VisibleForTesting
    static void leftTrim(StringBuilder2 word) {
        if (word != null && !word.isEmpty()) {
            int lastNonSpaceIndex = word.lastIndexOf(' ');
            word.setLength(lastNonSpaceIndex + 1);
            word.setCharAt(0, ' ');
        }
    }

    @Test
    public void rightTrim() throws IOException {
        Builder builder = fromClasspathUtf8("test.txt");
        String text = "Hello World";
        CharSequence result = WordWrap.rightTrim(text);
        assertEquals(text, result.toString());
    }
}
