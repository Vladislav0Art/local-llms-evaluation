		assertEquals("John", project.getName());
		assertEquals(30, project.getAge());
		}
	}
, 	@Test
	public void testConvertStringToDouble() {
		String s = "12.5";
		double result = convert(s);
		assertEquals(12.5, result);
	}
, 	@Test
	public void testConvertNumberToInt() {
		int i = 123;
		Object[] array = (Object[]) convert(i);
		assertEquals(1, ((Number)array[0]).intValue());
	}
, 	@Test
	public void testConvertBooleanToBoolean() {
		boolean b = true;
		boolean result = convert(b);
