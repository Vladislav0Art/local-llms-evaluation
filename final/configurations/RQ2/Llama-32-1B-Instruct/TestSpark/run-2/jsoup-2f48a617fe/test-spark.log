        this.comments = comments;
    }

    public void appendComment(Comment comment) {
        if (comments == null || comments.length == 0) {
            comments = new Comment[1];
            comments[0] = comment;
        } else {
            comments[comments.length - 1].append(comment);
        }
    }

    public String getOutputFromDocument(int index) { return comments[index].getText(); }
}

