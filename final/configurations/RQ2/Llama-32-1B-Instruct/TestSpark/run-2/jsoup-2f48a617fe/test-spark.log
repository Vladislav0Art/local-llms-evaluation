        if (document.comments == null || document.comments.length == 0) {
            document.comments = new Comment[1];
            document.comments[0] = comment;
        } else {
            document.comments[document.comments.length - 1].appendChild(comment);
        }
    }

    public String getBody() { return document.getText(); }
}

