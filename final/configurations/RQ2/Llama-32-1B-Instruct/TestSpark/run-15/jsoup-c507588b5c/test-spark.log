        for (int i = 0; i < indentLevel; i++) {
            builder.append("  ");
        }
    }

    public String toString() {
        return builder.toString();
    }
}

public class OutputSettings {
    public static final Document.OutputSettings FORWARD = new Document.OutputSettings(true);
}
