public class PropertyListBuilderTest {
    private PropertyListBuilder subject;

    @Mock
    private ConfigurationProperties configurationProperties;

    @Spy
    private Map<String, Object> rootEntries;

    public void setup() throws Exception {
        subject = new PropertyListBuilder();
    }

    @Test
    public void test_add_property_gets_added_to_root_entries() {
        List<Property<?>> properties = List.of(new Property("property1"), new Property("property2"));
        subject.add(properties.get(0));
        verify(rootEntries).put("property1", "value1");
        verify(rootEntries).put("property2", "value2");
    }

    @Test
    public void test_add_property_returns_empty_list_when_no_properties_added() {
        List<Property<?>> properties = new ArrayList<>();
        subject.add(properties);
        verifyNoMoreInteractions(rootEntries);
    }

    @Test
    public void test_get_root_entries Returns_null_if_root_entries_are_none() {
        when(rootEntries).isEmpty().thenReturn(true);
        assertEquals(null, subject.getRootEntries());
    }

    @Test
    public void test_get_root_entries_returns_map_with_empty_list_when_no_root_entries() {
        when(rootEntries).isEmpty().thenReturn(false);
        assertEquals(Map.of(), subject.getRootEntries());
    }
}
