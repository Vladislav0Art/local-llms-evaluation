import java.util.ArrayList;
import java.util.List;

public class GrammarTester {
    private static final String EXPECTED = "Expected result";

    public static void testGrammar(String sentence, boolean expectedValue) {
        List<GrammaticalTerm> grammarTerms = generateGrammar(sentence);
        if (expectedValue == true) {
            assert grammarTerms.size() > 0 : EXPECTED;
        } else {
            assert !grammarTerms.size() > 0 : EXPECTED;
        }
    }

    private static List<GrammaticalTerm> generateGrammar(String sentence) {
        List<GrammaticalTerm> terms = new ArrayList<>();
        String[] words = sentence.split(" ");
        for (String word : words) {
            if (word.matches("[a-zA-Z]+")) {  // Add more specific grammar rules as needed
                terms.add(new GrammaticalTerm(word, true));
            } else {
                GrammaticalTerm term = new GrammaticalTerm(word, false);
                terms.add(term);
            }
        }
        return terms;
    }

    private static class GrammaticalTerm implements Comparable<GrammaticalTerm> {
        private final String word;
        private final boolean isNoun;

        public GrammaticalTerm(String word, boolean isNoun) {
            this.word = word;
            this.isNoun = isNoun;
        }

        @Override
        public int compareTo(GrammaticalTerm other) {
            if (word.compareTo(other.word) > 0) {
