import com.github.davidmoten.guavamini.Preconditions;
import com.github.davidmoten.guavamini.annotations.VisibleForTesting;

public final class WordWrap {
    public static Builder from(Reader reader) { return newBuilder(); }
    public static Builder fromClasspathUtf8(String resource) { return from(resource); }
    public static Builder fromClasspath(String resource, Charset charset) { return from(resource, charset); }
    public static Builder from(CharSequence text) { return newBuilder(text); }
    public static Builder fromUtf8(InputStream in) { return newBuilder(new InputStreamReader(in, StandardCharsets.UTF_8)); }
    public static Builder fromUtf8(Reader reader, Charset charset) { return newBuilder(reader, charset); }
    public static Builder from(File file, Charset charset) { return newBuilder(file.toPath(), charset); }

    @VisibleForTesting
    private static Builder from(Reader reader, boolean close) {
        Preconditions.checkArgument(!close, "Cannot call fromClasspath with a Reader");
        Preconditions.checkArgument(reader instanceof Reader, "Reader must be of type BufferedReader or InputStreamReader");

        return newBuilder((InputStream) reader);
    }

    @VisibleForTesting
    private static void close(Reader reader) {
        if (reader == null) return;
        Preconditions.checkArgument(reader instanceof Reader || reader instanceof BufferedReader || reader instanceof InputStreamReader);

        try (Reader in = new InputStreamReader(reader, StandardCharsets.UTF_8)) {
            wordWrap(in, null, 0, null, null, null, false, true);
        }
    }

    public static void wordWrap(Reader in, Writer out, String newLine, Number maxWidth,
            Function<? super CharSequence, ? extends Number> stringWidth,
            Set<Character> extraWordChars, boolean insertHyphens, boolean breakWords)
            throws IOException {
        Preconditions.checkArgument(maxWidth != null && maxWidth >= 0, "maxWidth must be non-negative");
        Preconditions.checkArgument(stringWidth != null, "stringWidth cannot be null");

        Preconditions.checkArgument(newLine == null || newLine.isEmpty(), "newLine is required when insertHyphens = false");

        wordWrap(in, out, newLine, maxWidth, stringWidth, extraWordChars, true, breakWords);
    }

    public static void wordWrap(Reader in, LineConsumer out, Number maxWidth,
            Function<? super CharSequence, ? extends Number> stringWidth,
            Set<Character> extraWordChars, boolean insertHyphens, boolean breakWords)
            throws IOException {
        Preconditions.checkArgument(maxWidth != null && maxWidth >= 0, "maxWidth must be non-negative");
        Preconditions.checkArgument(stringWidth != null, "stringWidth cannot be null");

        Preconditions.checkArgument(newLine == null || newLine.isEmpty(), "newLine is required when insertHyphens = false");

        wordWrap(in, out, newLine, maxWidth, stringWidth, extraWordChars, true, breakWords);
    }

    public static CharSequence rightTrim(CharSequence s) {
        Preconditions.checkArgument(s != null, "s cannot be null");
        Preconditions.checkArgument(s.length() > 0, "empty strings are not allowed");

        return s.substring(0, Math.min(s.length(), maxWidth));
    }

    public static boolean isWhitespace(CharSequence s) {
        Preconditions.checkArgument(s != null, "s cannot be null");
        Preconditions.checkArgument(s.length() == 0, "empty strings are not allowed");

        return !CharSequenceUtil.isWordChars(s);
    }

    @VisibleForTesting
    private static StringBuilder2 rightTrim(StringBuilder2 word) {
        Preconditions.checkArgument(word != null, "word cannot be null");
        Preconditions.checkArgument(word.length() > 0, "empty words are not allowed");

        return new StringBuilder2(Math.min(maxWidth, word.length()));
    }
