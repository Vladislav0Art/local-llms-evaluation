    Protocol protocol = ConnectionManager.createSocket();
    Socket socket = protocol.createSocket();

    // Send messages from client to server
    connectionManager.sendMessage(protocol, "Hello, server!");
    connectionManager.sendMessage(protocol, "How are you?");
    socket.close(); // Close the socket connection

    // Receive response from server
