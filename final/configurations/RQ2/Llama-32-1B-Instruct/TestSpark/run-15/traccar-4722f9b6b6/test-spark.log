public class NetworkMessage {
    private String[] message;
}

public interface Protocol {
    public SocketAddress getSocketAddress();
    public int getPort();
}

public class ConnectionManager {
    public static void sendMessage(Protocol protocol, Object message) throws Exception {
        // Send the message to the server using socket connections.
        protocol.sendMessage(message);
        System.out.println("Message sent successfully.");
    }

    public static SocketAddress createSocket() {
        // Create a new socket object for communication with the server.
        return new Socket();
    }

    public static int sendMessage(Socket socket, Object message) throws Exception {
        // Send the message to the server using socket connections.
        String data = message.toString();
        socket.getOutputStream().write(data.getBytes());
        System.out.println("Message sent successfully.");
        return 0;
    }
}

public class TestNetworkMessage extends TestCase {
    public void testSendMessage() throws Exception {
        NetworkMessage message = new NetworkMessage();
        ConnectionManager.sendMessage(message, "Hello, server!");
    }

    @Override
    protected void setUp() throws Exception {
        super.setUp();
    }

    @Override
    protected void tearDown() throws Exception {
        System.out.println("Test network message test complete.");
    }
}
