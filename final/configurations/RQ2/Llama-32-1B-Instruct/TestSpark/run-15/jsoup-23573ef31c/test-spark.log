public class DocumentTests {

    private Document document;

    @Before
    public void setup() {
        Document.createShell("http://example.com");
        document = new Document("http://example.com");
    }

    @Test
    public void title_test1() {
        assertEquals("Example", document.title());
        document.title("Example");
    }

    @Test
    public void body_test2() {
        List<FormElement> forms = document.forms();
        assertEquals(0, forms.size());
        document.forms().add(new FormElement("input"));
        assertEquals(1, forms.size());
    }

    @Test
    public void expectForm_test3() {
        String cssQuery = "#example input";
        DocumentExpectation expectation = new DocumentExpectation(document);
        Document expectForm = expectation.expectForm(cssQuery);
        assertEquals(expectForm, document.expectForm(cssQuery));
    }

    @Test
    public void title_test4() {
        document.title("New Title");
        assertEquals("New Title", document.title());
    }

    @Test
    public void quirksMode_test5() {
        QuirksMode defaultQuirks = document.quirksMode();
        assertEquals(0, defaultQuirks);
        defaultQuirks = document.quirksMode(QuirksMode.ALL);
        assertEquals(1, defaultQuirks);
    }

    @Test
    public void updateMetaCharsetElement_test6() {
        document.updateMetaCharsetElement(true);
        assertEquals(true, document.updateMetaCharsetElement());
        document.updateMetaCharsetElement(false);
        assertEquals(false, document.updateMetaCharsetElement());
    }
}

