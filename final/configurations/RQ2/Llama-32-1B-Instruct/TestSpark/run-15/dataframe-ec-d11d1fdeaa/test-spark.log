public class DataFrame {
    private List<DataRow> data;
    private String name;

    public DataFrame(String name) {
        this.name = name;
        this.data = new ArrayList<>();
    }

    public void addRow(DataRow row) {
        if (row != null && !row.toString().isEmpty()) {
            data.add(row);
        } else {
            throw new IllegalArgumentException("Invalid input: empty row or null");
        }
    }

    @Override
    public int hashCode() {
        final int prime = 31;
        int result = 1;
        for (Object row : data) {
            if (row instanceof String)
                ((String)row).hashCode();
            else if (row instanceof Object[]) {
                Object[] array = (Object[])row;
                for (int i = 0; i < array.length; i++) {
                    result *= prime;
                    result += ((Integer)array[i]).hashCode();
                }
            } else {
                throw new IllegalArgumentException("Can only add arrays of strings or objects");
            }
        }
        return prime * result + data.hashCode();
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj)
            return true;
        if (obj == null || getClass() != obj.getClass())
            return false;
        DataFrame other = (DataFrame) obj;
        return Objects.equals(name, other.name);
    }

    public void printDF() {
        for (int i = 0; i < data.size(); i++) {
            System.out.println("Row " + (i+1) + ":");
            for (Object column : data.get(i).get(0)) {
                if (column instanceof String)
                    System.out.print(column + " ");
                else if (column instanceof Integer[])
                    System.out.print(((Integer[])column)[0] + " ");
                else
                    System.out.print(column + " ");
            }
            System.out.println();
        }
    }

    public static class DataFrameRow {
        private String name;
        private Object[] columns;

        public DataFrameRow(String name, Object... columns) {
            this.name = name;
            this.columns = columns;
        }

        @Override
        public int hashCode() {
            final int prime = 31;
            int result = 1;
            for (Object column : columns) {
                if (column instanceof String)
                    ((String)column).hashCode();
                else if (column instanceof Object[]) {
                    Object[] array = (Object[])column;
                    for (int i = 0; i < array.length; i++) {
                        result *= prime;
                        result += ((Integer)array[i]).hashCode();
                    }
                } else {
                    throw new IllegalArgumentException("Can only add arrays of strings or objects");
                }
            }
            return prime * result + columns.hashCode();
        }

        @Override
        public boolean equals(Object obj) {
            if (this == obj)
                return true;
            if (obj == null || getClass() != obj.getClass())
                return false;
            DataFrameRow other = (DataFrameRow) obj;
            return Objects.equals(name, other.name);
        }
    }

    public static void main(String[] args) {
        DataFrame df = new DataFrame("Example");
        df.addRow(new DataFrameRow("John", "Doe", 25));
        df.addRow(new DataFrameRow("Jane", "Doe", 30));

        System.out.println("Original DataFrame:");
        df.printDF();

        // Add some columns
        df.addColumn("Age", new Integer[]{35, 40});
        df.addColumn("Salary", new String[]{"100", "200"});

        System.out.println("\nDataFrame after adding columns:");
        df.printDF();
    }
}
