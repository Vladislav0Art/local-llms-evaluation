public class Tag {
    private static final Map<String, String> tagNames = new HashMap<>();

    static {
        tagNames.put("b", "body");
        tagNames.put("em", "font em");
        tagNames.put("i", "font i");
        tagNames.put("u", "span u");
        tagNames.put("s", "abbr");
        tagNames.put("samp", "code");
        // Add more tags as needed
    }

    private String tagName;
    private String name;

    public Tag(String tagName) {
        this.tagName = tagName;
        String tagNameLower = normalizeTagName(tagName.toLowerCase());
        if (tagNames.containsKey(tagNameLower)) {
            this.name = tagNames.get(tagNameLower);
        } else {
            throw new IllegalArgumentException("Unknown tag: " + tagName);
        }
    }

    public static Tag valueOf(String tagName) {
        return new Tag(tagNames.get(tagName));
    }

    private String normalizeTagName(String tagName) {
        for (char c : tagName.toCharArray()) {
            if (!Character.isLetterOrDigit(c)) {
                tagName = tagName.replaceFirst("^[a-zA-Z]", "");
                break;
            }
        }
        return tagName.toLowerCase();
    }

    public String getName() {
        return name;
    }

    public boolean isBlock() {
        return "block".equals(tagName);
    }

    public boolean formatAsBlock() {
        return true;
    }

    public boolean isInline() {
        return false;
    }

    public boolean isEmpty() {
        return tagName.isEmpty();
    }

    public boolean isSelfClosing() {
        return false;
    }

    public boolean isKnownTag() {
        return true; // All tags are known
    }

    public static boolean isKnownTag(String tagName) {
        return tagNames.containsKey(tagName);
    }

    public boolean preserveWhitespace() {
        return false;
    }

    public boolean isFormListed() {
        return false;
    }

    public boolean isFormSubmittable() {
        return false;
    }

    public Tag setSelfClosing() {
        tagName = "self";
        name = tagNames.get(tagNameLower);
        return this;
    }
}

public class TestTag {
    private Tag tag;

    public void testTagToString() {
        assertEquals("body", tag.getName());
    }

    public void testTagIsBlock() {
        assertTrue(tag.isBlock());
    }

    public void testTagIsInline() {
        assertFalse(tag.isInline());
    }

    public void testEmptyString() {
        tag = Tag.valueOf("");
        assertTrue(tag.isEmpty());
    }
}

