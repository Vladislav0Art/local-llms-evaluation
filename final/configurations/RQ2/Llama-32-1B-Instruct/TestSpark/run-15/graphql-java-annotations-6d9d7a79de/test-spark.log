            GraphQLDirective[] directives1 = builder.build();
            assertEquals(2, directives1.length); // Two directives

            // Get the type of the first directive
            assertEquals(DirectiveJavaAnnotationUtil.directiveType, directives1[0].getDirectiveType());
            assertEquals(DirectiveJavaAnnotationUtil.directiveType, directives1[1].getDirectiveType());
        } catch (GraphQLAnnotationsException e) {
            fail("Failed to build a list of directedives");
        }
    }

    public static void testEmptyDirectivesBuilder(AnnotatedElement annotatedElement, ProcessingElementsContainer container) {
        try {
            // Create a DirectivesBuilder instance
            DirectivesBuilder builder = new DirectivesBuilder(annotatedElement, container);

            // Build an empty list of directives
            GraphQLDirective[] directives = builder.build();

            // Check the length of the returned array
            assertEquals(0, directives.length); // No directives

            // Fail with a message indicating that no directives were found
            fail("Expected no directives to be built");
        } catch (GraphQLAnnotationsException e) {
            // This should not happen as the DirectivesBuilder class is designed to return an empty array if no directives are defined.
        }
    }

    public static void testFieldBuilderWithDefaultValues() throws Exception {
        AnnotatedElement annotatedElement = createAnnotatedElement();
        ProcessingElementsContainer container = new ProcessingElementsContainer();

        // Create a DirectivesBuilder instance
        DirectivesBuilder builder = new DirectivesBuilder(annotatedElement, container);

        // Build a list of directives with default values
        GraphQLDirective[] directives = builder.build();

        // Check the length of the returned array
        assertEquals(1, directives.length); // Only one directive

        // Get the type of the first directive
        assertEquals(DirectiveJavaAnnotationUtil.directiveType, directives[0].getDirectiveType());
    }

    public static void testFieldBuilderWithMultipleDefaultValues() throws Exception {
        AnnotatedElement annotatedElement = createAnnotatedElement();
        ProcessingElementsContainer container = new ProcessingElementsContainer();

        // Create a DirectivesBuilder instance
        DirectivesBuilder builder = new DirectivesBuilder(annotatedElement, container);

        // Build a list of directives with default values
        GraphQLDirective[] directives1 = builder.build();
        assertEquals(1, directives1.length); // Only one directive

        // Get the type of the first directive
        assertEquals(DirectiveJavaAnnotationUtil.directiveType, directives1[0].getDirectiveType());
        assertEquals(DirectiveJavaAnnotationUtil.directiveType, directives1[0].getDefaultValues()[0].getDefaultValueType());

        // Add a default value to one of the existing defaults
        directives1[0].getDefaultValues().set(2, GraphQLValueFactory.createString("default2"));

        // Update the default values array
        directives1[0].getDefaultValues().update();

        // Get the type of the first directive again
        assertEquals(DirectiveJavaAnnotationUtil.directiveType, directives1[0].getDirectiveType());
    }

