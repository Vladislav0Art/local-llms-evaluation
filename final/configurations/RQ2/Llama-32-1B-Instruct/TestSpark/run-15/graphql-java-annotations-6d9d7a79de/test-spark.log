public class DirectivesBuilderTest {

    public static void main(String[] args) {
        // Create an instance of the DirectivesBuilder class
        AnnotatedElement annotatedElement = createAnnotatedElement();
        ProcessingElementsContainer container = new ProcessingElementsContainer();

        // Test 1: Build a list of directives with a single directive
        directivesBuilderTest(annotedElement, container);

        // Test 2: Build a list of directives with multiple directives
        directivesBuilderTestMultiple(annotedElement, container);

        // Test 3: Check if an empty list of directives is returned when no directives are defined
        emptyDirectivesBuilderTest(annotedElement, container);
    }

    public static void directivesBuilderTest(AnnotatedElement annotatedElement, ProcessingElementsContainer container) {
        try {
            DirectivesBuilder builder = new DirectivesBuilder(annotatedElement, container);
            GraphQLDirective[] directives = builder.build();
            assertEquals(1, directives.length); // Only one directive
            assertEquals(DirectiveJavaAnnotationUtil DIRECTIVE, directives[0].getDirectiveType());
        } catch (GraphQLAnnotationsException e) {
            fail("Failed to build a list of directives");
        }
    }

    public static void directivesBuilderTestMultiple(AnnotatedElement annotatedElement, ProcessingElementsContainer container) {
        try {
            DirectivesBuilder builder = new DirectivesBuilder(annotatedElement, container);
            GraphQLDirective[] directives1 = builder.build();
            assertEquals(1, directives1.length); // Only one directive
            assertEquals(DirectiveJavaAnnotationUtil DIRECTIVE, directives1[0].getDirectiveType());

            GraphQLDirective[] directives2 = builder.build();
            assertEquals(2, directives2.length); // Two directives
            assertEquals(DirectiveJavaAnnotationUtil DIRECTIVE, directives2[0].getDirectiveType());
            assertEquals(DirectiveJavaAnnotationUtil DIRECTIVE, directives2[1].getDirectiveType());
        } catch (GraphQLAnnotationsException e) {
            fail("Failed to build a list of directives with multiple directives");
        }
    }

    public static void emptyDirectivesBuilderTest(AnnotatedElement annotatedElement, ProcessingElementsContainer container) {
        try {
            DirectivesBuilder builder = new DirectivesBuilder(annotatedElement, container);
            GraphQLDirective[] directives = builder.build();
            assertEquals(0, directives.length); // No directives
            fail("Expected no directives to be built");
        } catch (GraphQLAnnotationsException e) {
            // Expected exception
        }
    }

    public static void testFieldBuilderWithDefaultValues() throws Exception {
        AnnotatedElement annotatedElement = createAnnotatedElement();
        ProcessingElementsContainer container = new ProcessingElementsContainer();

        DirectivesBuilder builder = new DirectivesBuilder(annotatedElement, container);
        GraphQLDirective[] directives = builder.build();

        assertEquals(1, directives.length); // Only one directive
        assertEquals(DirectiveJavaAnnotationUtil DIRECTIVE, directives[0].getDirectiveType());
