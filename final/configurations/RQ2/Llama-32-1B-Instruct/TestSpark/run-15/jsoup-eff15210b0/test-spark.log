import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;

public class PublicTest {
    public String generateHtml(String html) {
        return Jsoup.parse(html, "http://www.example.com", null).body().html();
    }

    public static void main(String[] args) {
        PublicTest test = new PublicTest();
        System.out.println("Original HTML:");
        System.out.println(test.generateHtml("<p>This is a paragraph of text.</p><span>This is a span element</span>"));
        
        String html = "<html><head></head><body><h1>Hello World!</h1></body></html>";
        System.out.println("\nGenerated HTML:");
        System.out.println(test.generateHtml(html));
    }
}
```

