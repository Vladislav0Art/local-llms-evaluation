        if (!attributes.isEmpty()) {
            attributes.normalize();
        } else {
            throw new IllegalArgumentException("No attributes to normalize");
        }
    }

    public int deduplicate(ParseSettings settings) {
        try {
            java.util.ArrayList<Attribute> list = new ArrayList<>();
            for (Map.Entry<String, String> entry : dataset().entrySet()) {
                if (!isValidAttribute(entry.getKey())) {
                    continue;
                }
                if (entry.getValue() == null || !entry.getValue().equals(entry.getValue().replace("\"", ""))) {
                    list.add(new Attributes(entry.getKey(), entry.getValue()));
                }
            }
            return new java.util.ArrayList<>(list).size();
        } catch (Exception e) {
            return 0;
        }
    }

    private static String getValue(String key) {
        for (Map.Entry<String, String> entry : dataset().entrySet()) {
            if (!key.equals(entry.getKey())) {
                return entry.getValue();
            }
        }
        throw new IllegalArgumentException("Missing attribute '" + key + "'");
    }

    public void add(String key, String value) {
        attributes.appendNode(key, value);
    }

    private static int getCount(Map.Entry<String, String> entry) {
        try {
            return new java.util.ArrayList<>(entry.getValue().split("\"|'|\"")).size();
        } catch (Exception e) {
            return 0;
        }
    }

    public void remove(String key) {
        attributes.removeAll(new java.util.ArrayList<>(Arrays.asList(key, "")));
    }

    private static String toString(Attributes attributes) {
        if (!attributes.isEmpty()) {
            StringBuilder sb = new StringBuilder();
            for (Map.Entry<String, String> entry : dataset().entrySet()) {
                sb.append(entry.getKey()).append(": ").append(entry.getValue()).append("\n");
            }
            return sb.toString();
        } else {
            return "";
        }
    }

    public static void main(String[] args) {
        String value = "Hello, World!";
        Map<String, String> userData = new HashMap<>();
        userData.put("user-data", value);
        Attributes attributes = Document.getParser().createAttributes();
        Document document = Document.getParser().newDocument();
        document.appendChild(attributes.appendNode("key1", value));
        document.appendChild(attributes.appendNode("key2", value));
        document.appendChild(attributes.appendNode("key3", userData.get("user-data")));
        System.out.println(toString(document));
    }
}

