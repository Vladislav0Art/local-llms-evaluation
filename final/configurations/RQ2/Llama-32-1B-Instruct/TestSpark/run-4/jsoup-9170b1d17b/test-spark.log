    }

    public Attributes put(String key, @Nullable String value) {
        Document doc = new Document();
        if (hasDeclaredValueForKey(key)) {
            checkNotNull(value, "Missing declared value for attribute '" + key + "'");
        }
        attributes.appendNode(key, value);
        return this;
    }

    private static boolean hasDeclaredValueForKey(String key) {
        Map.Entry<String, String> entry = dataset().entrySet().stream()
                .filter(e -> e.getKey().equals(key))
                .findFirst();
        return entry != null;
    }

    public void remove(String key) {
        attributes.removeAll(new java.util.ArrayList<>(Arrays.asList(key, "")));
        return this;
    }

    @Override
    public Iterator<Attribute> iterator() {
        return new AttributesIterator();
    }

    private static class AttributesIterator implements Iterator<Attribute> {
        private Map<String, String> attributeMap = new HashMap<>();
        private int index = 0;

        @Override
        public boolean hasNext() {
            return index < attributeMap.size();
        }

        @Override
        public Attribute next() {
            if (!hasNext()) {
                throw new NoSuchElementException();
            }
            String key = attributeMap.keySet().iterator().next();
            return new Attributes(attributeMap.get(key));
        }

        private void addAttribute(String key, String value) {
            attributes.appendNode(key, value);
            attributeMap.put(key, value);
        }
    }

    public Map<String, String> dataset() {
        try {
            java.util.Map<String, String> map = new HashMap<>();
            for (Map.Entry<String, String> entry : dataset().entrySet()) {
                if (!isValidAttribute(entry.getKey())) {
                    continue;
                }
                attributeMap.put(entry.getKey(), entry.getValue());
            }
            return map;
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    public String html(Appendable accum, Document.OutputSettings out) throws IOException {
        if (!isEmpty()) {
            for (Attribute attribute : attributes.getAllElements()) {
                accum.append(attribute.toString() + "\n");
            }
        }
        return out.toString();
    }

