public class CommentTest {

    private Comment comment;
    private ParseSettings parseSettings;
    private Parser parser;
    private Document document;

    @Before
    public void setUp() {
        parseSettings = new ParseSettings();
        parser = Parser.newParser(Parser.SIMPLE);
        parser.addHandler(Comment.class, "comment");
        document = new Document();

        // Add some sample data to the comment
        String[] data = {"<!-- This is a sample comment -->", "Another sample comment"};
        for (String s : data) {
            comment = parseComment(parser, document, s, parseSettings);
        }
    }

    @Test
    public void testGetNodeName() {
        assertEquals("comment", comment.getNodeName());
    }

    @Test
    public void testGetData() {
        assertEquals("<!-- This is a sample comment -->Another sample comment", comment.getData());
    }

    @Test
    public void test setData() {
        String newData = "<!-- This is another sample comment -->";
        comment.setData(newData);
        assertEquals("<!-- This is another sample comment -->Another sample comment", comment.getData());
    }

    @Test
    public void testOuterHtmlHead() {
        // Mock the Appendable interface to return a mock string
        StringBuilder mockStringBuilder = new StringBuilder();
        mockStringBuilder.append("<!-- This is a sample comment -->");
        mockStringBuilder.append("<!-- This is another sample comment -->");

        comment.outerHtmlHead(mockStringBuilder, 1, document.OutputSettings());
        assertEquals(mockStringBuilder.toString(), comment.outerHtml);
    }

    @Test
    public void testOuterHtmlTail() {
        // Mock the Appendable interface to return a mock string
        StringBuilder mockStringBuilder = new StringBuilder();
        mockStringBuilder.append("<!-- This is a sample comment -->");

        comment.outerHtmlHead(mockStringBuilder, 1, document.OutputSettings());
        comment.outerHtmlTail(mockStringBuilder, 1, document.OutputSettings());
        assertEquals(mockStringBuilder.toString(), comment.outerHtml);
    }

    @Test
    public void testToString() {
        // Mock the toString method to return a mock string
        String expected = "<comment><!-- This is a sample comment --></comment>";
        comment = new Comment(expected);

        assertEquals(expected, comment.toString());
    }

    @Test
    public void testIsXmlDeclaration() {
        // Mock the isXmlDeclaration method to return true
        boolean result = comment.isXmlDeclaration();
        assertTrue(result);
    }

    @Test
    public void testAsXmlDeclaration() {
        // Mock the asXmlDeclaration method to return a mock string
        String expected = "<!-- This is a sample comment -->";
        Comment comment2 = new Comment(expected);

        assertEquals(expected, comment2.asXmlDeclaration());
    }
}
