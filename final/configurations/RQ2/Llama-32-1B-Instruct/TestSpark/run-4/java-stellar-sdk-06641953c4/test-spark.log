public class KeyPairTest {

    private static KeyPair randomKeyPair = null;

    @Mock
    private EdDSAPublicKey mockEdDSAPublicKey;

    @Mock
    private EdDSAEngine mockEdDSAEngine;

    public void testCanSign() {
        when(mockEdDSAEngine.generateEdDSA()).thenReturn(mockEdDSAPublicKey);
        Assert.assertTrue(KeyPair.canSign());
    }

    public void testCanSignWithSeed() {
        when(mockEdDSAEngine.generateEddsaFromSecretseed(char[] seed)).thenReturn(mockEdDSAPublicKey);
        Assert.assertTrue(KeyPair.canSign());
    }

    @Test
    public void testFromSecretSeed() {
        byte[] secretSeed = "some_secret_seed".getBytes();
        KeyPair keyPair = KeyPair.fromSecretSeed(secretSeed);
        assertEquals(mockEdDSAEngine.generateEddsaFromSecretseed(secretSeed), keyPair.getPublicKey());
    }

    @Test
    public void testFromSecretSeedWithAccountId() {
        byte[] secretSeed = "some_secret_seed".getBytes();
        String accountId = "some_account_id".toString();
        KeyPair keyPair = KeyPair.fromSecretSeed(secretSeed, accountId);
        assertEquals(mockEdDSAEngine.generateEddsaFromSecretseed(secretSeed), keyPair.getPublicKey());
    }

    @Test
    public void testFromSecretSeedWithBip39Seed() {
        byte[] secretSeed = "some_secret_seed".getBytes();
        byte[] bip39Seed = "some_bip39_seed".getBytes();
        KeyPair keyPair = KeyPair.fromSecretSeed(secretSeed, bip39Seed);
        assertEquals(mockEdDSAEngine.generateEddsaFromSecretseed(secretSeed), keyPair.getPublicKey());
    }

    @Test
    public void testRandomKeyPair() {
        randomKeyPair = KeyPair.random();
        assertEquals(mockEdDSAEngine.generateEddsa().getSignature(), randomKeyPair.sign(randomKeyPair.getData()));
    }

    public static void main(String[] args) {
        KeyPairTest keyPairTest = new KeyPairTest();

        // Test 1
        keyPairTest.testCanSign();

        // Test 2
        keyPairTest.testCanSignWithSeed();

        // Test 3
        keyPairTest.testFromSecretSeed();
    }
}
