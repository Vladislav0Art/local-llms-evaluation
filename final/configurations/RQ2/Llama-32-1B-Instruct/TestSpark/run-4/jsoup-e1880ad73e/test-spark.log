        return privateKey.getPublic();
    }

    public static byte[] encrypt(String message, PublicKey publicKey) throws Exception {
        // Create a cipher object using the public key
        Cipher cipher = Cipher.getInstance("RSA-SHA256");
        SecretKeySpec secretKeySpec = new SecretKeySpec(publicKey.getEncoded(), "SHA1");
        cipher.init(Cipher.ENCRYPT_MODE, secretKeySpec);
        return cipher.doFinal(message.getBytes(StandardCharsets.UTF_8));
    }

    public static String decrypt(byte[] encryptedMessage, PrivateKey privateKey) throws Exception {
        // Create a cipher object using the private key
        Cipher cipher = Cipher.getInstance("RSA-SHA256");
        SecretKeySpec secretKeySpec = new SecretKeySpec(privateKey.getEncoded(), "SHA1");
        cipher.init(Cipher.DECRYPT_MODE, secretKeySpec);
        return (String) cipher.doFinal(encryptedMessage)._bytes().stream()
                .mapToUnsignedByte().reduce("", (a, b) -> a + b);
    }

