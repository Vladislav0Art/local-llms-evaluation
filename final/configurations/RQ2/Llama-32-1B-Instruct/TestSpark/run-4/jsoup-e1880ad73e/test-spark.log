            try (BufferedReader reader = new BufferedReader(new InputStreamReader(inputStream, "UTF-8"))) {
                String line;
                while ((line = reader.readLine()) != null) {
                    System.out.println("Got: " + line);
                    headerBytesArray = addBytes(headerBytesArray, Arrays.copyOf(line.getBytes(), line.length()));
                }
            } catch (IOException e) {
                return null;
            }

            return headerBytesArray;
        }
    }

    public static byte[] addBytes(byte[]... arrays) {
        if (arrays == null || arrays.length == 0)
            return new byte[0];

        int length = Arrays.stream(arrays).mapToInt(a -> a.length).max().getAsInt();
        byte[] result = new byte[length];
        int i = 0;
        for (byte[] array : arrays) {
            System.arraycopy(array, 0, result, i, array.length);
            i += array.length;
        }
        return result;
    }

    public static String signSignature(String publicKey, byte[] inputBytes) throws UnsupportedEncodingException {
        // Use a key pair to generate a signature
        try (Cipher cipher = Cipher.getInstance("RSA-SHA256")) {
            cipher.init(Cipher.ENCRYPT_MODE, new SecretKeySpec(publicKey.getBytes(), "SHA1"));
            return cipher.doFinal(inputBytes).toString();
        }
    }

    public static String verifySignature(String publicKey, byte[] inputBytes, String signature) throws UnsupportedEncodingException {
        // Use a key pair to generate a signature
        try (Cipher cipher = Cipher.getInstance("RSA-SHA256")) {
            cipher.init(Cipher.DECRYPT_MODE, new SecretKeySpec(publicKey.getBytes(), "SHA1"));
            return cipher.doFinal(inputBytes).equals(java.util.Base64.getDecoder().decode(signature));
        }
    }

