    public static byte[] getPublicKeyHeaderBytes(InputStream inputStream) throws UnsupportedEncodingException {
        // Create a key pair from the input stream
        try (PrintWriter printWriter = new PrintWriter(new java.io.BufferedOutputStream(inputStream))) {
            while (inputStream.available() > 0) {
                char[] buf = new char[1024];
                int len = printWriter.read(buf);
                if (len == -1)
                    break;
                System.out.println("Got: " + new String(buf, 0, len));
