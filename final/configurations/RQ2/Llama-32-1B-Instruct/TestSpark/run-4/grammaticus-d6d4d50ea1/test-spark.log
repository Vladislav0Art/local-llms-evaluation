public class GrammaticalTermMapImplTest {

    private static final Map<String, String> TEST_MAP = new HashMap<>();

    @InjectMocks
    private GrammaticalTermMapImpl<GrammaticalTerm> mock;

    @Test
    public void testGet() {
        // Arrange
        when(mock.get("test")).thenReturn(new GrammaticalTerm("test"));

        // Act
        String result = mock.get("test");

        // Assert
        assertEquals("test", result);
    }

    @Test
    public void testContainsKey() {
        // Arrange
        TEST_MAP.put("test", "value");
        when(mock.containsKey("test")).thenReturn(true);

        // Act
        boolean result = mock.containsKey("test");

        // Assert
        assertTrue(result);
    }

    @Test
    public void testIsSkinny() {
        // Arrange
        when(mock.isSkinny()).thenReturn(false);

        // Act
        boolean result = mock.isSkinny();

        // Assert
        assertFalse(result);
    }

    @Test
    public void testMakeSkinny() {
        // Arrange
        String name = "test";
        TEST_MAP.put(name, new GrammaticalTerm("value"));

        when(mock.makeSkinny()).thenReturn(new GrammaticalTermMapImpl<GrammaticalTerm>(TEST_MAP, false));

        // Act
        GrammaticalTermMapImpl<GrammaticalTerm> result = mock.makeSkinny();

        // Assert
        assertEquals(name, result.get(name));
    }

    @Test
    public void testWriteJson() {
        // Arrange
        String json = "{\"map\": [\"test\", \"value\"]}";
        Appendable out = System.out;

        when(mock.writeJson(out, null, LanguageDictionary.empty(), java.util.Arrays.asList(json))).thenReturn(true);

        // Act
        mock.writeJson(out, RenamingProvider.noop(), LanguageDictionary.empty(), java.util.Arrays.asList(json));

        // Assert
        assertTrue(System.getProperty("java.io.tmpdir") != null);
    }

    @Test
    public void testKeySet() {
        // Arrange
        when(mock.keySet()).thenReturn(java.util.Collections.emptySet());

        // Act
        Set<String> result = mock.keySet();

        // Assert
        assertEquals(0, result.size());
    }

    @Test
    public void testPutAll() {
        // Arrange
        when(mock.putAll(GrammaticalTermMapImpl.of(new HashMap<>())))
                .thenReturn(true);

        // Act
        boolean result = mock.putAll(null);

        // Assert
        assertTrue(result);
    }
}
