import com.ezylang.evalex.functions.FunctionIfc;
import org.junit.jupiter.api.Test;
import static com.ezylang.evalex.parser.Token.TokenType.*;
import java.util.ArrayList;

public class TokenizerTest {

    public ExpressionConfiguration createExpressionConfiguration() {
        return new ExpressionConfiguration();
    }

    @Test
    public void parseStringLiteralTokenTypeTest() {
        String expressionString = "5";
        ExpressionConfiguration configuration = createExpressionConfiguration();
        Tokenizer tokenizer = new Tokenizer(expressionString, configuration);
        List<Token> tokens = tokenizer.parseStringLiteral();
        assertEquals(TokenType.STRING_LITERAL, getMethodUnderTest("parseStringLiteral")[0]);
    }

    @Test
    public void parseLiteralNumberTokenTypeTest() {
        String expressionString = "5";
        ExpressionConfiguration configuration = createExpressionConfiguration();
        Tokenizer tokenizer = new Tokenizer(expressionString, configuration);
        List<Token> tokens = tokenizer.parse().get(0).getTokenTokens();
        assertEquals(TokenType.LIT_NUMBER, getMethodUnderTest("parseLiteralNumber")[0]);
    }

    @Test
    public void parseBinaryOperatorTokenTypeTest() {
        String expressionString = "5 + 3";
        ExpressionConfiguration configuration = createExpressionConfiguration();
        Tokenizer tokenizer = new Tokenizer(expressionString, configuration);
        List<Token> tokens = tokenizer.parse().get(0).getTokenTokens();
        assertEquals(TokenType.BINARY_OPERATOR, getMethodUnderTest("parseBinaryOperator")[0]);
    }

    public Token parseStringLiteral() {
        return parseStringLiteralExpression();
    }

    @Test
    public void parseStringLiteralExpressionTest() {
        String expressionString = "5";
        ExpressionConfiguration configuration = createExpressionConfiguration();
        Tokenizer tokenizer = new Tokenizer(expressionString, configuration);
        List<Token> tokens = tokenizer.parse().get(0).getTokenTokens();
        assertEquals(TokenType.STRING_LITERAL, getMethodUnderTest("parseStringLiteral")[0]);
    }

    public FunctionIfc parseFunction() {
        return parseFunctionExpression();
    }

    @Test
    public void parseFunctionTokenTypeTest() {
        String expressionString = "5";
        ExpressionConfiguration configuration = createExpressionConfiguration();
        Tokenizer tokenizer = new Tokenizer(expressionString, configuration);
        List<Token> tokens = tokenizer.parse().get(0).getTokenTokens();
        assertEquals(TokenType.FUNCTION, getMethodUnderTest("parseFunction")[0]);
    }

    public OperatorIfc parseOperator() {
        return parseOperatorExpression();
    }

    @Test
    public void parseOperatorTokenTypeTest() {
        String expressionString = "5 + 3";
        ExpressionConfiguration configuration = createExpressionConfiguration();
        Tokenizer tokenizer = new Tokenizer(expressionString, configuration);
        List<Token> tokens = tokenizer.parse().get(0).getTokenTokens();
        assertEquals(TokenType.OPERATOR, getMethodUnderTest("parseOperator")[0]);
    }

    private Token getMethodUnderTest(String methodName) {
        for (Token token : getTestData()) {
            if (token.getMethodName().equals(methodName)) {
                return token;
            }
        }
        throw new AssertionError("No method called " + methodName);
    }

    private List<Token> getTestData() {
        List<Token> tokens = new ArrayList<>();
        tokens.add(parseStringLiteral());
        tokens.add(parseLiteralNumber());
        tokens.add(parseBinaryOperator());
        return tokens;
    }
}
