    public void setPrice(double price) {
        this.price = price;
    }

    public boolean isAvailable() {
        return isAvailable;
    }

    public void setAvailability(boolean availability) {
        isAvailable = availability;
    }
}

class Bookshelf {
    private Map<String, Book> books;

    public Bookshelf() {
        this.books = new HashMap<>();
    }

    public void addBook(Book book) {
        if (books.containsKey(book.getTitle())) {
            System.out.println("Book already exists in the shelf");
        } else {
            books.put(book.getTitle(), book);
            System.out.println("Book added successfully");
        }
    }

    public Book getBook(String title) {
        return books.get(title);
    }

    public boolean removeBook(String title) {
        if (books.containsKey(title)) {
            books.remove(title);
            System.out.println("Book removed successfully");
            return true;
        } else {
            System.out.println("No book found with this title");
            return false;
        }
    }

    public void printBooks() {
        for (Map.Entry<String, Book> entry : books.entrySet()) {
            System.out.println(entry.getKey() + ": " + entry.getValue().getTitle());
        }
    }
}

public class Main {
    public static void main(String[] args) {
        // Create a bookshelf
        Bookshelf bookshelf = new Bookshelf();

        // Add some books to the shelf
        bookshelf.addBook(new Book("The Adventures of Tom Sawyer", "Mark Twain", 10.99));
        bookshelf.addBook(new Book("To Kill a Mockingbird", "Harper Lee", 12.99));
        bookshelf.addBook(new Book("1984", "George Orwell", 9.99));

        // Print all books on the shelf
        System.out.println("\nAll Books:");
        bookshelf.printBooks();

        // Try to add an existing book
        try {
            bookshelf.addBook(new Book("Pride and Prejudice", "Jane Austen", 8.99));
        } catch (Exception e) {
            System.out.println(e.getMessage());
        }

        // Remove a book
        if (bookshelf.removeBook("The Adventures of Tom Sawyer")) {
            System.out.println("\nUpdated Shelf after removing \"Tom Sawyer\":");
            System.out.println(bookshelf.printBooks());
        } else {
            System.out.println("No book found with this title");
        }

        // Try to print books without checking titles first
        try {
            bookshelf.printBooks();
        } catch (Exception e) {
            System.out.println(e.getMessage());
        }
    }
}
```

This program defines two classes: `Book` and `Bookshelf`. The `Book` class represents a book with properties like title, author, price, and availability. The `Bookshelf` class manages a collection of books and provides methods to add, remove, and print books.

In the `Main` class, we create a bookstore with different types of books and demonstrate various operations on it.
