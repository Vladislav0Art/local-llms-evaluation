public class PropertyListBuilderTest {

    @BeforeEach
    public void setup() {
        this.propertyListBuilder = new PropertyListBuilder();
    }

    @Test
    public void createPropertyCreatesProperty() {
        List<Property<?>> properties = propertyListBuilder.create();
        assertNotNull(properties);
    }

    @Test
    public void getRootEntries_ReturnsDefaultMap() {
        Map<String, Object> rootEntries = propertyListBuilder.getRootEntries();
        assertEquals("defaultMap", (String) rootEntries.get("key"));
    }

    @Test
    public void addProperty_AddsPropertyToList() {
        List<Property<?>> properties = new ArrayList<>();
        Property<?> property = this.propertyListBuilder.addProperty("testProperty");
        assertTrue(properties.contains(property));
        Property property2 = propertyListBuilder.addProperty("testProperty2");
        assertTrue(properties.contains(property2));
    }
}
