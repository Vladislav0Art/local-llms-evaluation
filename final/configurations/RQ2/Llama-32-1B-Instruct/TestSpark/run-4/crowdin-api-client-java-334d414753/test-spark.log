import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.ObjectMapper;

public class JacksonJsonTransformerTest {

    public static String parseStringToJsonObject(String json) throws JsonProcessingException {
        ObjectMapper objectMapper = new ObjectMapper();
        return objectMapper.writeValueAsString(json);
    }

    @Test
    [MethodUnderTest][Scenario]TestJacksonJsonTransformerParseStringToObject() throws JsonProcessingException {
        String json = "{\"key\":\"value\"}";
        Class<?> clazz = String.class;
        Object expectedResult = "value";
        when(objectMapper.readValue(json, clazz)).thenReturn(expectedResult);
        JacksonJsonTransformer transformer = new JacksonJsonTransformer();
        String result = transformer.parseStringToJsonObject(json);
        assertEquals(expectedResult, result);
    }

    @Test
    [MethodUnderTest][Scenario]TestJacksonJsonTransformerParseStringToObjectException() throws JsonProcessingException {
        String json = "{\"key\":\"value\"}";
        Object expectedResult = "value";
        when(objectMapper.readValue(json, Object.class)).thenReturn(Exception.class);
        JacksonJsonTransformer transformer = new JacksonJsonTransformer();
        try {
            transformer.parseStringToJsonObject(json);
            fail("Expected exception not thrown");
        } catch (JsonProcessingException e) {
            // expected
        }
    }

    @Test
    [MethodUnderTest][Scenario]TestJacksonJsonTransformerConvertStringToObject() throws JsonProcessingException {
        String json = "{\"key\":\"value\"}";
        Class<?> clazz = Object.class;
        Object expectedResult = new Object();
        when(objectMapper.writeValueAsString(json)).thenReturn(expectedResult);
        JacksonJsonTransformer transformer = new JacksonJsonTransformer();
        Object result = transformer.convertStringToJsonObject(json);
        assertEquals(expectedResult, result);
    }

    @Test
    [MethodUnderTest][Scenario]TestJacksonJsonTransformerConvertObjectToString() throws JsonProcessingException {
        Object obj = new Object();
        when(objectMapper.writeValueAsString(obj)).thenReturn("{\"key\":\"value\"}");
        JacksonJsonTransformer transformer = new JacksonJsonTransformer();
        String result = transformer.convertObjectToString(obj);
        assertEquals("{\"key\":\"value\"}", result);
    }

    @Test
    [MethodUnderTest][Scenario]TestJacksonJsonTransformerConvertStringToObjectException() throws JsonProcessingException {
        Object obj = new Object();
        when(objectMapper.writeValueAsString(obj)).thenReturn(Exception.class);
        JacksonJsonTransformer transformer = new JacksonJsonTransformer();
        try {
            transformer.convertObjectToString(obj);
            fail("Expected exception not thrown");
        } catch (JsonProcessingException e) {
            // expected
        }
    }

}
