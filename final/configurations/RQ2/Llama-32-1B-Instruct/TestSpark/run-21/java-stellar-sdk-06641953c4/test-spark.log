        ObjectOutput out = new ObjectOutputStream(bos);
        out.writeObject(key);
        out.close();

        return bos.toByteArray();
    }

    public static XDRKeyPair fromXdrPublicKey(Object input) throws Exception {
        ByteArrayInputStream bis = new ByteArrayInputStream(input.toString().getBytes());
        ObjectInputStream in = new ObjectInputStream(bis);

        XDRKeyPair key = (XDRKeyPair) in.readObject();

        in.close();
        return key;
    }

    public static PublicKey fromXdrPublicKey(XDRKeyPair key) throws Exception {
        byte[] encoded = key.getEncoded();
        ByteArrayInputStream bis = new ByteArrayInputStream(encoded);
        ObjectInputStream in = new ObjectInputStream(bis);

        return (PublicKey) in.readObject();
    }

    public static SignatureHint getSignatureHint() {
        return new SignatureHint("v", "a");
    }

    public static void testFromXdrPublicKey() throws Exception {
        byte[] publicKeyBytes = ("00".getBytes());
        XDRKeyPair key = fromXdrPublicKey(publicKeyBytes);
        assertNotEquals(new byte[0], key.getEncoded());

        PublicKey publicKey = fromXdrPublicKey(key);
        System.out.println(publicKey);

        SignatureHint hint = getSignatureHint();
        XDRKeyPair xdrKeyPair = fromXdrPublicKey(hint);
        assert(!xdrKeyPair.getEncoded().equals(publicKeyBytes));

        key = fromXdrPublicKey(new ByteArrayInputStream("01".getBytes()));
        System.out.println(key);

        hint = new SignatureHint();
        xdrKeyPair = fromXdrPublicKey(hint);
        System.out.println(xdrKeyPair.getEncoded());

        publicKey = fromXdrPublicKey(new PublicKey(new byte[]{publicKeyBytes}));
        System.out.println(publicKey);
    }

    public static void testFromXdrPublicKey2() throws Exception {
        byte[] publicKeyBytes = ("01".getBytes());
        XDRKeyPair key = fromXdrPublicKey(publicKeyBytes);
        assertNotEquals(new byte[0], key.getEncoded());

        PublicKey publicKey = fromXdrPublicKey(key);
        System.out.println(publicKey);

        SignatureHint hint1 = new SignatureHint("v", "a");
        XDRKeyPair xdrKeyPair1 = fromXdrPublicKey(hint1);
        assert(!xdrKeyPair1.getEncoded().equals(publicKeyBytes));

        byte[] publicKeyBytes2 = ("00".getBytes());
        XDRKeyPair key2 = fromXdrPublicKey(publicKeyBytes2);
        System.out.println(key2);

        SignatureHint hint2 = new SignatureHint();
        XDRKeyPair xdrKeyPair2 = fromXdrPublicKey(hint2);
        System.out.println(xdrKeyPair2.getEncoded());
    }

    public static void main(String[] args) throws Exception {
        testFromXdrPublicKey();
        testFromXdrPublicKey2();
    }
}

