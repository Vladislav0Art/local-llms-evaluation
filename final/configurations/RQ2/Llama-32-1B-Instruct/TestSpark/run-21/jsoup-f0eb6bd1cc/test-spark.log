package org.jsoup.helper;

import org.jsoup.Connection;
import org.jsoup.html.ParsedHtml;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.select.Elements;
import java.net.URLDecoder;
import static org.jsoup.helper.DataUtil.UTF_8;

public class UrlBuilderTest {

    public void testBuildWithoutKeyVal() throws Exception {
        String inputUrl = "https://example.com";
        URL url = new UrlBuilder(inputUrl).build();
        assert url.getScheme().equals("https");
        assert !url.getHost().isEmpty();
        assert !url.getPath().isEmpty();
    }

    public void testBuildWithNonEmptyKeyVal() throws Exception {
        String inputUrl = "https://example.com";
        String key = "key";
        String val = "value";
        URLBuilder urlBuilder = new UrlBuilder(inputUrl);
        urlBuilder.appendKeyVal(key, val);
        URL url = urlBuilder.build();
        assert url.getScheme().equals("https");
        assert !url.getHost().isEmpty();
        assert !url.getPath().isEmpty();
    }

    public void testBuildWithoutPath() {
        String inputUrl = "https://example.com";
        URLBuilder urlBuilder = new UrlBuilder(inputUrl);
        Object result = urlBuilder.build();
        if (result instanceof URL) {
            URL url = (URL) result;
            assert !url.isAbsolute();
        }
    }

    public void testBuildWithEmptyPath() {
        String inputUrl = "https://example.com";
        URLBuilder urlBuilder = new UrlBuilder(inputUrl);
        URL url = urlBuilder.build();
        assert url.getScheme().equals("http");
        assert !url.getHost().isEmpty();
    }

    public void testAppendKeyValToDocument() throws Exception {
        String html = "<html><body>Hello <script>alert('XSS')</script></body></html>";
        Document document = new ParsedHtml(html);
        URLBuilder urlBuilder = new UrlBuilder("https://example.com");
        Elements elements = urlBuilder.appendKeyVal(document, "Hello", "world").getElements();
        for (Element element : elements) {
            assert element.tagName().equals("BODY");
        }
    }

    public void testAppendKeyValToParsedHtml() throws Exception {
        String html = "<html><body>Hello <script>alert('XSS')</script></body></html>";
        ParsedHtml parsedHtml = new ParsedHtml(html);
        URLBuilder urlBuilder = new UrlBuilder("https://example.com");
        Element element = urlBuilder.appendKeyVal(parsedHtml, "Hello", "world").firstElement();
        assert element.tagName().equals("BODY");
    }

    public void testAppendKeyValToDocumentWithUrl() throws Exception {
        String html = "<html><body>Hello <script>alert('XSS')</script></body></html>";
        Document document = new ParsedHtml(html);
        URLBuilder urlBuilder = new UrlBuilder("https://example.com/123");
        Elements elements = urlBuilder.appendKeyVal(document, "Hello", "world").getElements();
        for (Element element : elements) {
            assert element.tagName().equals("A");
        }
    }

    public void testAppendKeyValToParsedHtmlWithUrl() throws Exception {
        String html = "<html><body>Hello <script>alert('XSS')</script></body></html>";
        ParsedHtml parsedHtml = new ParsedHtml(html);
        URLBuilder urlBuilder = new UrlBuilder("https://example.com/123");
        Element element = urlBuilder.appendKeyVal(parsedHtml, "Hello", "world").firstElement();
        assert element.tagName().equals("A");
    }

}
