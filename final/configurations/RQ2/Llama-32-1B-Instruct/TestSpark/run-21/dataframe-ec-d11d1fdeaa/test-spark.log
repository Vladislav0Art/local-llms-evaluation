import java.util.*;

public class DfCursor {
    public String procedure(DfCursor df, Object data) {
        List<String> columnNames = (List<String>) df.getRowIds().iterator().next();
        Map<String, Integer> map = new HashMap<>();
        for (String columnName : columnNames) {
            map.put(columnName, 0);
        }
        int rowNum = 1;
        while (df.hasMoreRows()) {
            for (Map.Entry<String, Integer> entry : map.entrySet()) {
                if (entry.getValue() == df.getNumberOfColumns()) break;
                String columnName = columnNames.get(entry.getKey());
                try {
                    System.out.println(df.row ColumName(rowNum));
                    System.out.println(df.col ColumName(entry.getKey()));
                    rowNum++;
                } catch (Exception e) {
                    e.printStackTrace();
                }
            }
        }
        return "df";
    }
}

