            testGetExpectedValue(i, ExpectedValue.getJsonResponse(i), GET);
        }
    }

    private static String getExpectedJson(String json) {
        return "{\"id\": " + Long.parseLong(json.substring(1, json.length() - 1)) + ", \"name\": \"" + json.substring(json.indexOf("\"") + 1, json.indexOf("\",\") + "\"" + "\"";
    }

    public static void testGetExpectedValue(int index, String expectedJson, String funcName) {
        Testable test = new Testable(funcName);
        for (int i = 0; i < EXPECTED_RESPONSES[index].length(); i++) {
            if (i == 1 && EXPECTED_RESPONSES[index].charAt(i) == '\n') {
                System.out.println("Line " + index + " contains a newline.");
            }
