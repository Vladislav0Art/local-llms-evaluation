import io.github(vmzakharov.ecdataframe.dsl.VectorExpr;
import io.github(vmzakharov.ecdataframe.dsl.value.Value;

public class AliasExpressionTest {
    private Printer printer = new CollectingPrinter();
    private Expression expr;

    public void testAliasExpr() {
        PrettyPrintVisitor visitor = new PrettyPrintVisitor(printer);
        AliasExpr aliasExpr = new AliasExpr("x", "Y");
        visitor.visitAliasExpr(aliasExpr);
        assertEquals("X", printer.toString(aliasExpr.getVariable()));
        assertEquals("Y", printer.toString(aliasExpr));
    }

    public void testAliasExprWithIndex() {
        PrettyPrintVisitor visitor = new PrettyPrintVisitor(printer);
        expr = new AliasExpr("x", "y");
        IndexExpr indexExpr = new IndexExpr(1, 2, "Z");
        visitor.visitAliasExpr(new AliasExpr("X", "Y").withIndex(indexExpr));
        assertEquals("X", printer.toString(expr.getVariable()));
        assertEquals("Y", printer.toString(expr.getIndexes()[0]));
    }

    public void testAliasExpressionWithVar() {
        PrettyPrintVisitor visitor = new PrettyPrintVisitor(printer);
        expr = new AliasExpr("x", "y");
        VarExpr varExpr = new VarExpr("z");
        visitor.visitAliasExpr(new AliasExpr("X", "Y").withVar(varExpr));
        assertEquals("X", printer.toString(expr.getVariable()));
        assertEquals("Y", printer.toString(expr.getVarVars()[0]));
    }

    public void testAliasExpressionWithProjection() {
        PrettyPrintVisitor visitor = new PrettyPrintVisitor(printer);
        expr = new AliasExpr("x", "y");
        ProjectionExpr projectionExpr = new ProjectionExpr(new VarExpr("z"), "[1,2,3]");
        visitor.visitAliasExpr(new AliasExpr("X", "Y").withProjection(projectionExpr));
        assertEquals("X", printer.toString(expr.getVariable()));
        assertEquals("[1,2,3]", printer.toString(projectionExpr));
    }

    public void testAliasExpressionWithPropertyPath() {
        PrettyPrintVisitor visitor = new PrettyPrintVisitor(printer);
        expr = new AliasExpr("x", "y");
        PropertyPathExpr propertyPathExpr = new PropertyPathExpr(new VarExpr("z"), "w");
        visitor.visitAliasExpr(new AliasExpr("X", "Y").withPropertyPath(propertyPathExpr));
        assertEquals("X", printer.toString(expr.getVariable()));
        assertEquals("W", printer.toString(propertyPathExpr));
    }

    public void testAliasExpressionWithFunctionCall() {
        PrettyPrintVisitor visitor = new PrettyPrintVisitor(printer);
        expr = new AliasExpr("x", "y");
        FunctionCallExpr functionCallExpr = new FunctionCallExpr("sum", new VarExpr("numbers"), "[1,2,3]");
        visitor.visitAliasExpr(new AliasExpr("X", "Y").withFunctionCall(functionCallExpr));
        assertEquals(3, printer.toString(expr.getVariables()[0]));
    }

    public void testAliasExpressionWithVector() {
        PrettyPrintVisitor visitor = new PrettyPrintVisitor(printer);
        expr = new AliasExpr("x", "y");
        VectorExpr vectorExpr = new VectorExpr(new VarExpr("numbers"), "[1,2,3]");
        visitor.visitAliasExpr(new AliasExpr("X", "Y").withVector(vectorExpr));
        assertEquals(3, printer.toString(expr.getVariables()[0]));
    }

    public void testAliasExpressionWithCollectingPrinter() {
        PrettyPrintVisitor visitor = new PrettyPrintVisitor(printer);
        expr = new AliasExpr("x", "y");
        CollectingPrinter collector = new CollectingPrinter();
        var out = collector.collect(printer.toString(expr));
        assertEquals(3, out.size());
    }
}
