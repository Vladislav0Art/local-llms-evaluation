```java
import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;

public class JsoupTest {

    public static void main(String[] args) {
        String html = "<html><body>Hello World!</body></html>";
        Document document = Jsoup.parse(html);
        
        System.out.println("Original HTML:");
        System.out.println(document.outerHtml());

        append(document.outerHtml(), "New content");
        
        System.out.println("\nModified HTML after appending new content:");
        System.out.println(document.outerHtml());
    }

    public static void append(String text, String newline) {
        Jsoup.jsoupTest = new JsoupTest();
        document.text(text + "\n" + newline);
        jsoupTest.printDocument();
    }

    public static void printDocument() {
        System.out.println("Printing the modified HTML:");
        System.out.println(document.outerHtml());
    }
}
```

This program creates a Jsoup instance with an initial HTML string, prints the original HTML, appends new content to the HTML, and then prints the modified HTML.
