```java
import java.io.*;
import java.util.*;

public class SerializationExample {

    private static Map<String, Object> obj;

    public void write(Object obj) {
        if (obj instanceof Map) {
            Map<String, Object> map = (Map<String, Object>) obj;
            try (ObjectOutputStream oos = new ObjectOutputStream(new FileOutputStream("serialized_data.dat"))) {
                oos.writeObject(map);
            } catch (IOException e) {
                System.out.println("Error writing to file: " + e.getMessage());
            }
        } else if (obj instanceof List) {
            List<?> list = (List<?>) obj;
            try (ObjectOutputStream oos = new ObjectOutputStream(new FileOutputStream("serialized_data.dat"))) {
                oos.writeObject(list);
            } catch (IOException e) {
                System.out.println("Error writing to file: " + e.getMessage());
            }
        } else {
            System.out.println(obj.toString());
        }
    }

    public static void main(String[] args) throws IOException, ClassNotFoundException {
        SerializationExample obj = new SerializationExample();
        
        // Create an instance of the class
        Person person = new Person("John Doe", 30);
        obj.obj.put("name", person.getName());
        obj.obj.put("age", person.getAge());

        System.out.println(obj.obj);

        // Write to a file
        obj.write(person);

        // Test with renaming
        System.out.println("Testing with RenamingProvider:");
        SerializationExample.renamedPerson = new Person("Jane Doe", 31);
        
        obj.renamedObj.put("name", "John Doe");
        obj.renamedObj.put("age", 30);

        System.out.println(obj.renamedObj);

    }

    static class Person {
        private String name;
        private int age;

        public Person(String name, int age) {
            this.name = name;
            this.age = age;
        }

        public String getName() {
            return name;
        }

        public int getAge() {
            return age;
        }
    }

    static class RenamingProvider extends PrintStream {
        @Override
        public void print(String s, boolean on) throws IOException {
            super.print(s);
            write(System.lineSeparator());
        }

        public static String printStream() {
            return System.out.println();
        }
    }
}
```

