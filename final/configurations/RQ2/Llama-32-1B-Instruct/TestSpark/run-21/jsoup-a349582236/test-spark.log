import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.select.Elements;

public class TagParser {

    public static void main(String[] args) {
        Document doc = Jsoup.parse("Hello World");

        Element originalTag = doc.body().selectFirst("img");
        System.out.println(originalTag.isBlock());

        Elements imgTags = originalTag.parents("img");
        for (Element tag : imgTags) {
            System.out.println(tag.isInline());
        }

        Element formTag = doc.selectFirst("form");
        System.out.println(formTag.name() == "img"); // false
    }
}
