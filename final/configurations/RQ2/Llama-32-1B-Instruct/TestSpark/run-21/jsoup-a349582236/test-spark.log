### Java Code for Parsing HTML Tags (Tag Names)

```java
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class TagParser {

    public static void main(String[] args) {
        // Parse HTML string using Jsoup library
        String htmlString = "<html><body><h1>Hello World!</h1></body></html>";
        Document doc = Jsoup.parse(htmlString);

        // Find all tag names in the HTML document
        Pattern pattern = Pattern.compile("<[^>]*>");
        Matcher matcher = pattern.matcher(doc.body().toString());
        while (matcher.find()) {
            System.out.println(matcher.group(0).trim());
        }
    }
}
```

### Java Code for Parsing HTML Tags (Attribute Names)

```java
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class TagParser {

    public static void main(String[] args) {
        // Parse HTML string using Jsoup library
        String htmlString = "<html><body><p id=\"myParagraph\" name=\"myName\"></p></body></html>";
        Document doc = Jsoup.parse(htmlString);

        // Find all attribute names in the HTML document
        Pattern pattern = Pattern.compile("=[^=]*=");
        Matcher matcher = pattern.matcher(doc.body().toString());
        while (matcher.find()) {
            System.out.println(matcher.group(0).trim());
        }
    }
}
