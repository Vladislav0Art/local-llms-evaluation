### Java Code for Parsing HTML Tags

```java
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class TagParser {

    public static void main(String[] args) {
        // Parse HTML string using Jsoup library
        String htmlString = "<html><body><h1>Hello World!</h1></body></html>";
        Document doc = Jsoup.parse(htmlString);

        // Find all tag elements in the HTML document
        Elements tags = doc.getAllElements();
        for (Element tag : tags) {
            System.out.println(tag.tagName());
            System.out.println(tag.attributes().get("name"));
            System.out.println(tag.attributes().get("id"));
        }

        // Parse an HTML form element using Jsoup library
        String formHtmlString = "<form id=\"myForm\" action=\"/submit\"></form>";
        Document formDoc = Jsoup.parse(formHtmlString);
        Element formTag = formDoc.selectFirst("form");
        System.out.println(formTag.tagName());
        System.out.println(formTag.attributes().get("id"));
    }
}
```

