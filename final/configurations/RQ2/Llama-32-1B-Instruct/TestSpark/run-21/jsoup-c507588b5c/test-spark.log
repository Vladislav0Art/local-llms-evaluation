package org.jsoup.nodes;

public class GeneratedTest {

    @Test
    public void testNodeType() {
        assertEquals("TextNode", TextNode.class.getSuperclass().getName());
    }

    @Test
    public void testNodeName() throws IOException, Exception {
        String text = "Hello";
        TextNode node = new TextNode(text);
        assertEquals("Hello", node.nodeName());
    }

    @Test
    public void testText() throws IOException, Exception {
        String text = "Hello World";
        TextNode node = new TextNode(text);
        assertEquals("Hello World", node.text());
    }

    @Test
    public void testTextClone() throws IOException, Exception {
        TextNode original = new TextNode("Hello");
        TextNode cloned = original.clone();
        assertEquals(original, cloned);
    }

    @Test
    public void testNormaliseWhitespace() throws IOException, Exception {
        String text = "   Hello World  ";
        String result = TextNode.normaliseWhitespace(text);
        assertEquals("Hello World", result);
    }

    @Test
    public void testStripLeadingWhitespace() throws IOException, Exception {
        String text = "Hello World";
        StringBuilder sb = new StringBuilder();
        TextNode node = new TextNode(text);
        while (node != null) {
            sb.append(node.text());
            if (!node.stripLeadingWhitespace()) {
                break;
            }
            node = node.splitText(0);
        }
        assertEquals("Hello World", sb.toString());
    }

    @Test
    public void testLastCharIsWhitespace() throws IOException, Exception {
        StringBuilder sb = new StringBuilder();
        TextNode node = new TextNode(sb.toString());
        assertTrue(node.lastCharIsWhitespace(sb));
    }

}
