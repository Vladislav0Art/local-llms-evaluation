public class UrlUtil {

    public static boolean isEncodedUrl(String url) {
        try {
            URI uri = new URI(url);
            return "http".equals(uri.getScheme());
        } catch (Exception e) {
            return false;
        }
    }

    public static void main(String[] args) {
        System.out.println(UrlUtil.isEncodedUrl("https://example.com"));  // Returns true
        System.out.println(UrlUtil.isEncodedUrl("http://example.com"));  // Returns false
        System.out.println(UrlUtil.isEncodedUrl(null));  // Returns false (null is not a valid URL)
        System.out.println(UrlUtil.isEncodedUrl(""));  // Returns false (empty string is not a valid URL)
    }
}
