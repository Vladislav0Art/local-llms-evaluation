```java
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        System.out.println("Enter your name: ");
        String name = scanner.nextLine();
        System.out.println(name + ", welcome to the program!");
        scanner.close();

        String greeting;
        System.out.println("Would you like to greet someone or yourself? (s/your): ");
        greeting = scanner.next().toLowerCase();

        if (greeting.equals("your")) {
            System.out.println("Hello, " + name);
        } else if (greeting.equals("s")) {
            System.out.println("Hi, " + name);
        }
    }

    public static String sayGreeting(String name) {
        return name.charAt(0) + ", " + name.substring(1);
    }
}
