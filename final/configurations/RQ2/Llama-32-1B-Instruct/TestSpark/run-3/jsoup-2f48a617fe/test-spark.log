public class DocumentTest {

    private Document document;

    public void setUp() throws IOException {
        document = DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(new FileReader("test.html"));
    }

    public void testCommentNodeIsNullWhenCommentIsNotPresent() {
        assertNotNull(CommentNode.getComment(), "Comment node is null when comment is not present");
    }

    public void testCommentNodeIsNonNullWhenCommentIsPresent() {
        assertNotNull(CommentNode.getComment(), "Comment node is null when comment is not present");
    }

    public void testCommentNodeHasDataWhenCommentIsPresent() {
        assertEquals("Hello, world!", CommentNode.getComment().getData(), "Comment node has data");
    }

    public void testCommentNodeSetsDataWhenCommentIsPresent() {
        CommentNode.comment.setData("New data", "New comment");
        assertNotNull(CommentNode.getComment(), "Comment node is null after setting data");
    }

    public void testCommentNodeCloneWithoutSettingData() {
        CommentNode.commented = new CommentNode();
        assertNotNull(CommentNode.commented, "Comment node cloned without setting data");
    }
}

public class CommentParserTest {

    private CommentParser parser;

    public void setUp() throws IOException {
        parser = new CommentParser();
    }

    public void testParsingComments() {
        Comment comment = parser.parse("<!-- This is a comment -->").getComments()[0];
        assertNotNull(comment, "Comment parsing failed");
    }
}

public class CommentPrinterTest {

    private CommentPrinter printer;

    public void setUp() throws IOException {
        printer = new CommentPrinter();
    }

    public void testPrintingComments() {
        String html = "<!-- This is a comment -->";
        CommentNode(comment) = parser.parse(html).getComments()[0];
        assertNotNull(comment, "Comment parsing failed");
        System.out.println(printer.print(comment));
    }
}

public class CommentCheckerTest {

    private CommentChecker checker;

    public void setUp() throws IOException {
        checker = new CommentChecker();
    }

    public void testCheckingComments() {
        String html = "<!-- This is a comment -->";
        CommentNode(comment) = parser.parse(html).getComments()[0];
        assertTrue(checker.check(comment), "Comment checking failed");
    }
}
