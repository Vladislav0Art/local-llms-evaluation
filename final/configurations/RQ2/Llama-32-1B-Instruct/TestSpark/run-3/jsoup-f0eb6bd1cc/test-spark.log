import org.jsoup.helper.DataUtil;
import org.jsoup.helper.UrlBuilder;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;

public class UrlBuilderTest {

    @Test
    public void testBuildUrls() {
        URLBuilder urlBuilder = new UrlBuilder("http://example.com");
        assertEquals(new URI("http://example.com"), urlBuilder.build());
    }

    @Test
    public void testAppendKeyVal() throws UnsupportedEncodingException {
        String key = "key";
        String value = "value";
        urlBuilder.appendKeyVal(new Connection.KeyVal(key, value));
        assertEquals(key + "=" + value, urlBuilder.appendKeyVal(new Connection.KeyVal(key, value)).toString());
    }

    @Test
    public void testAppendKeyValNull() throws UnsupportedEncodingException {
        URLBuilder urlBuilder = new UrlBuilder("http://example.com");
        String key = "key";
        urlBuilder.appendKeyVal(null);
        assertEquals(key + "=", urlBuilder.appendKeyVal(new Connection.KeyVal(key, "").toString()).toString());
    }

    @Test
    public void testAppendKeyValEmptyString() throws UnsupportedEncodingException {
        URLBuilder urlBuilder = new UrlBuilder("http://example.com");
        String key = "";
        urlBuilder.appendKeyVal(new Connection.KeyVal(key, ""));
        assertEquals("", urlBuilder.appendKeyVal(new Connection.KeyVal(key, "").toString()).toString());
    }

    @Test
    public void testAppendKeyValInvalidString() throws UnsupportedEncodingException {
        URLBuilder urlBuilder = new UrlBuilder("http://example.com");
        String key = "key";
        String invalidValue = "invalid value";
        urlBuilder.appendKeyVal(new Connection.KeyVal(key, invalidValue));
        assertEquals(key + "=" + invalidValue, urlBuilder.appendKeyVal(new Connection.KeyVal(key, "").toString()).toString());
    }

    @Test
    public void testBuildUrlsWithMultipleQueries() {
        URLBuilder urlBuilder = new UrlBuilder("http://example.com");
        URLBuilder secondUrlBuilder = new UrlBuilder("http://example.com?param1=value1&param2=value2");
        assertEquals(new URI("http://example.com?param1=value1&param2=value2"), urlBuilder.build());
    }

    @Test
    public void testBuildUrlsWithMultipleQueriesAndSpaces() {
        URLBuilder urlBuilder = new UrlBuilder("http://example.com? param=1=value1& param2=value2");
        assertEquals(new URI("http://example.com?param=1=value1&param2=value2"), urlBuilder.build());
    }

    @Test
    public void testBuildUrlsWithMultipleQueriesAndSpecialCharacters() {
        URLBuilder urlBuilder = new UrlBuilder("http://example.com? param%3D1%2Cvalue1& param2=value2");
        assertEquals(new URI("http://example.com?param=1&value=1%2Cvalue2"), urlBuilder.build());
    }

    @Test
    public void testBuildUrlsWithMultipleQueriesAndSpecialCharactersEscaped() {
        URLBuilder urlBuilder = new UrlBuilder("http://example.com? param&#39;3D1&#39;&amp;param2=value2");
        assertEquals(new URI("http://example.com?param&#39;=1&amp;value=1&#39;"), urlBuilder.build());
    }

    @Test
    public void testBuildUrlsWithMultipleQueriesAndSpecialCharactersUnescaped() {
        URLBuilder urlBuilder = new UrlBuilder("http://example.com? param%3D1&value1=value2");
        assertEquals(new URI("http://example.com?param=1&value=1"), urlBuilder.build());
    }

    @Test
    public void testBuildUrlsWithMultipleQueriesAndSpecialCharactersUnescapedWithQuotes() {
        URLBuilder urlBuilder = new UrlBuilder("http://example.com? param%3D1&value1=value2");
        assertEquals(new URI("http://example.com?param=1&value='1'", DataUtil.UTF_8), urlBuilder.build());
    }

    @Test
    public void testBuildUrlsWithMultipleQueriesAndSpecialCharactersUnescapedWithQuotesAndSpaces() {
        URLBuilder urlBuilder = new UrlBuilder("http://example.com? param&#39;3D1&amp;param2=value2");
        assertEquals(new URI("http://example.com?param&#39;=1&amp;value=1&quot;, DataUtil.UTF_8), urlBuilder.build());
    }

    @Test
    public void testBuildUrlsWithMultipleQueriesAndSpecialCharactersUnescapedWithQuotesAndSpacesAndDashes() {
        URLBuilder urlBuilder = new UrlBuilder("http://example.com? param%3D1&amp;param2=value2");
        assertEquals(new URI("http://example.com?param=1&value=1", DataUtil.UTF_8), urlBuilder.build());
    }

    @Test
    public void testBuildUrlsWithMultipleQueriesAndSpecialCharactersUnescapedWithQuotesAndSpacesAndDashesAndPercentSign() {
        URLBuilder urlBuilder = new UrlBuilder("http://example.com? param%3D1&amp;param2=value2");
        assertEquals(new URI("http://example.com?param=1&amp;value=1%23", DataUtil.UTF_8), urlBuilder.build());
    }

    @Test
    public void testBuildUrlsWithMultipleQueriesAndSpecialCharactersUnescapedWithQuotesAndSpacesAndDashesAndPercentSignAndPlusSign() {
        URLBuilder urlBuilder = new UrlBuilder("http://example.com? param&#39;3D1&amp;param2=value2");
        assertEquals(new URI("http://example.com?param&#39;=1+&amp;value=1", DataUtil.UTF_8), urlBuilder.build());
    }

    @Test
    public void testBuildUrlsWithMultipleQueriesAndSpecialCharactersUnescapedWithQuotesAndSpacesAndDashesAndPercentSignPlusSign() {
        URLBuilder urlBuilder = new UrlBuilder("http://example.com? param%3D1&amp;param2=value2");
        assertEquals(new URI("http://example.com?param=1&amp;value=1&quot;, DataUtil.UTF_8), urlBuilder.build());
    }

    @Test
    public void testBuildUrlsWithMultipleQueriesAndSpecialCharactersUnescapedWithQuotesAndSpacesAndDashesAndPercentSignPlusSignAndSlash() {
        URLBuilder urlBuilder = new UrlBuilder("http://example.com? param&#39;3D1&amp;param2=value2");
        assertEquals(new URI("http://example.com?param=1&amp;value=1/", DataUtil.UTF_8), urlBuilder.build());
    }

    @Test
    public void testBuildUrlsWithMultipleQueriesAndSpecialCharactersUnescapedWithQuotesAndSpacesAndDashesAndPercentSignPlusSignAndSlashAndQuote() {
        URLBuilder urlBuilder = new UrlBuilder("http://example.com? param%3D1&amp;param2=value2");
        assertEquals(new URI("http://example.com?param=1+&amp;value=1&quot;, DataUtil.UTF_8), urlBuilder.build());
    }
}
