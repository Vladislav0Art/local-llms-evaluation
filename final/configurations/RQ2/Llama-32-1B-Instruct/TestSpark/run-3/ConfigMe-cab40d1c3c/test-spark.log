import java.io.BufferedReader;
import java.io.FileReader;
import java.io.IOException;

public class ConfigMe {

    private Map<String, Object> rootEntries;

    public ConfigMe() {
        rootEntries = new HashMap<>();
    }

    // Method to add properties to the root entries
    public void testAddProperty() {
        try (BufferedReader reader = new BufferedReader(new FileReader("config.properties"))) {
            String line;
            while ((line = reader.readLine()) != null) {
                if (!line.equals("#")) {  // Ignore comments
                    String[] parts = line.split("\\s+");
                    String key = parts[0];
                    int value = Integer.parseInt(parts[1]);
                    rootEntries.put(key, value);
                }
            }
        } catch (IOException e) {
            System.out.println("Error reading config file");
        }
    }

    // Method to get the list of properties from the configuration
    public List<Property> getRootEntries() {
        return new ArrayList<>(rootEntries.values());
    }

    public static void main(String[] args) {
        ConfigMe config = new ConfigMe();
        config.testAddProperty();

        PropertyList propertyList = build(config.getRootEntries());

        System.out.println("Properties: " + propertyList);
        for (Property prop : propertyList) {
            System.out.println(prop.getKey() + ": " + prop.getValue());
        }
    }

    // Method to convert a list of properties into a new configuration
    public static PropertyList build(List<Property> properties) {
        return new PropertyList(properties);
    }
}

class Property {
    private String key;
    private Object value;

    public Property(String key, Object value) {
        this.key = key;
        this.value = value;
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;
        Property that = (Property) o;
        return Objects.equals(key, that.key) && Objects.equals(value, that.value);
    }

    @Override
    public int hashCode() {
        return Objects.hash(key, value);
    }
}

class PropertyListBuilder {
    public static PropertyList build(List<Property> properties) {
        return new PropertyList(properties);
    }

    // Method to add a property to the list
    public static void testAddProperty(PropertyList list, String key, int value) {
        Property property = new Property(key, value);
        list.add(property);
    }
}

class PropertyList {
    private List<Property> properties;

    public PropertyList(List<Property> properties) {
        this.properties = properties;
    }

    // Method to get the number of properties
    public int size() {
        return properties.size();
    }

    public boolean contains(Property property) {
        for (Property prop : properties) {
            if (prop.equals(property)) return true;
        }
        return false;
    }

    public String toString() {
        StringBuilder sb = new StringBuilder();
        for (Property prop : properties) {
