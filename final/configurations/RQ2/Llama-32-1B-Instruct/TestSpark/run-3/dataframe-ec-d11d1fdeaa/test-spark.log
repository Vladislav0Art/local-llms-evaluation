```java
import java.util.*;

public class Main {

    public static String join(String leftTableColumn, String rightTableColumn) {
        if (leftTableColumn == null || rightTableColumn == null) return "";
        List<String> columns = new ArrayList<>();
        for (String column : getColumns(leftTableColumn)) {
            columns.add(column);
        }
        for (String column : getColumns(rightTableColumn)) {
            columns.add(column);
        }

        Map<String, String> renamedColumns = new HashMap<>();
        for (int i = 0; i < columns.size(); i++) {
            renamedColumns.put(columns.get(i), "column" + i);
        }
        return leftTableColumn + "." + joinKey(leftTableColumn, rightTableColumn, renamedColumns);
    }

    public static void main(String[] args) {
        // Create two sample DataFrames
        DataFrame df1 = new DataFrame();
        df1.add("A", 5.0);
        df1.add("B", 7.0);

        DataFrame df2 = new DataFrame();
        df2.add("C", 10.0);
        df2.add("D", 12.0);

        // Join the two DataFrames
        String joinedTable = join("left", "right");
        System.out.println(joinedTable);

        // Perform some operations on the resulting DataFrame
        Map<String, Double> mean = new DfJoin().get(mean);
        for (Map.Entry<String, Double> entry : df1.columns.entrySet()) {
            if (entry.getKey().equals(mean.get())) {
                System.out.println(entry.getValue() + " for column " + df2.columns.get(0));
            }
        }

        List<String> columnNamesToKeep = Arrays.asList("column0");
        DfJoin joinDf = new DfJoin();
        DataFrame result = joinDf.get(columnNamesToKeep, "left", Collections.singletonList(df1.columns.get(0)));
        for (Map.Entry<String, String> entry : result.columns.entrySet()) {
            System.out.println(entry.getKey() + ": " + entry.getValue());
        }
    }

    public static class DataFrame {

        private List<List<Double>> data;

        public void add(String column, double value) {
            this.data.add(new ArrayList<>());
            this.data.get(this.data.size() - 1).add(value);
        }

        public List<String> getColumns() {
            return new ArrayList<>(this.data.get(0));
        }

        @Override
