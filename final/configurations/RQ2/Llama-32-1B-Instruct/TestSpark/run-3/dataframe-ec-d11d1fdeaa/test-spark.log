```java
import java.util.*;

public class Main {

    public static String join(String thisJoinColumnName, String otherJoinColumnName, DataFrame[] dataframes) {
        if (dataframes.length == 0) return "";
        List<String> columns = new ArrayList<>();
        for (DataFrame df : dataframes) {
            columns.addAll(df.columns);
        }
        Map<String, String> renamedColumns = new HashMap<>();
        for (int i = 0; i < columns.size(); i++) {
            renamedColumns.put(columns.get(i), "column" + i);
        }
        return dataframes[0].join(thisJoinColumnName, otherJoinColumnName, renamedColumns);
    }

    public static void main(String[] args) {
        DataFrame df1 = new DataFrame();
        df1.add(1, 5.0);
        df1.add(2, 7.0);

        DataFrame df2 = new DataFrame();
        df2.add(3, 10.0);
        df2.add(4, 12.0);

        DataFrame df3 = join("left", "right", new String[]{df1.columns[0], df1.columns[1]});
        for (Map.Entry<String, String> entry : df3.columns.entrySet()) {
            System.out.println(entry.getKey() + ": " + entry.getValue());
        }

        List<String> columnNamesToKeep = Arrays.asList("column0");
        DataFrame df4 = join(columnNamesToKeep, "left", new String[]{df1.columns[0], df2.columns[0]});
        for (Map.Entry<String, String> entry : df4.columns.entrySet()) {
            System.out.println(entry.getKey() + ": " + entry.getValue());
        }
    }

    public static class DataFrame {
        private List<String> columns;

        public void add(String column, double value) {
            this.columns.add(column);
        }

        public List<String> getColumns() {
            return columns;
        }

        @Override
        public String toString() {
            StringBuilder sb = new StringBuilder();
            for (String column : columns) {
                sb.append(column).append(" ");
            }
            return sb.toString().trim();
        }
    }

    public static class Triplet<DataFrame> {
        private DataFrame df;
        private List<String> thisJoinColumnName;
        private List<String> otherJoinColumnName;

        public Triplet(DataFrame df, String thisJoinColumnName, String otherJoinColumnName) {
            this.df = df;
            this.thisJoinColumnName = thisJoinColumnName;
            this.otherJoinColumnName = otherJoinColumnName;
        }

        @Override
        public boolean equals(Object o) {
            if (this == o) return true;
            if (o == null || getClass() != o.getClass()) return false;
            Triplet<DataFrame> that = (Triplet<DataFrame>) o;
            return this.thisJoinColumnName.equals(that.thisJoinColumnName) && this.otherJoinColumnName.equals(that.otherJoinColumnName);
        }

        @Override
        public int hashCode() {
            return Objects.hash(this.thisJoinColumnName, this.otherJoinColumnName);
        }
    }

    public static class DfIndex implements java.util.Map<String, String> {

        private final Map<String, String> indexedColumns;

        public DfIndex(Map<String, String> indexedColumns) {
            this.indexedColumns = indexedColumns;
        }

        @Override
        public String get(String key) {
            return indexedColumns.get(key);
        }
    }

    public static class DfJoin {

        private final Map<String, String> joinKey;
        private final List<String> leftColumns;
        private final List<String> rightColumns;

        public DfJoin(Map<String, String> joinKey, List<String> leftColumns, List<String> rightColumns) {
            this.joinKey = joinKey;
            this.leftColumns = leftColumns;
            this.rightColumns = rightColumns;
        }

        @Override
        public Map<String, String> get(String thisColumn) {
            if (thisColumn.equals(joinKey.get("on"))) return joinKey;
            else if (leftColumns.contains(thisColumn)) return Collections.singletonMap(thisColumn, leftColumns.get(leftColumns.indexOf(thisColumn)));
            else if (rightColumns.contains(thisColumn)) return Collections.singletonMap(thisColumn, rightColumns.get(rightColumns.indexOf(thisColumn)));
            throw new RuntimeException();
        }
    }

    public static class DfCellComparator implements java.util.Comparator<String> {

        private final String thisColumnName;

        public DfCellComparator(String thisColumnName) {
            this.thisColumnName = thisColumnName;
        }

        @Override
        public int compare(String s1, String s2) {
            return new Double(s1).compareTo(new Double(s2));
        }
    }
}
