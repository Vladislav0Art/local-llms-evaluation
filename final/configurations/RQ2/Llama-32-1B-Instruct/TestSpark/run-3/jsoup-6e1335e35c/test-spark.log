import static org.junit.Assert.*;

public class TestHelper {

    public void testPublicClassMethod() {
        Class<?> clazz = new Object(){}.getClass();
        Method method = clazz.getDeclaredMethod("myMethod", String.class);
        assertTrue(method != null);

        try {
            method.invoke(null, "Hello");
        } catch (Exception e) {
            fail("Expected no exception");
        }
    }

    public void testPublicMethodWithParams() {
        Method method = new Object(){}.getClass().getMethod("myMethod", int.class, String.class);
        assertTrue(method != null);

        try {
            method.invoke(null, 1, "World");
        } catch (Exception e) {
            fail("Expected no exception");
        }
    }

    public void testPublicStaticMethod() {
        Method method = new Object(){}.getClass().getMethod("myStaticMethod", int.class);
        assertTrue(method != null);

        try {
            method.invoke(null, 1);
        } catch (Exception e) {
            fail("Expected no exception");
        }
    }

    public static class MyPublicClass {

        public void myMethod(String param) {
            System.out.println(param);
        }
    }

    public static void main(String[] args) {
        TestHelper.testPublicClassMethod();
        TestHelper.testPublicMethodWithParams();
        TestHelper.testPublicStaticMethod();
    }
}
