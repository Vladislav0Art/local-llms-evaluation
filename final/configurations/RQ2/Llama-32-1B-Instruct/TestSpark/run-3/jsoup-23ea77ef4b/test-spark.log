import org.jsoup.helper.W3CDom;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.select.Elements;
import org.junit.Before;
import org.junit.Test;

public class W3CDomTest {

    private W3CDom w3cdom = new W3CDom();

    @Before
    public void setup() {
        String wsdl = "<wsdl:definitions xmlns:wsdl='http://schemas.xmlsoap.org/wsdl/' xmlns:xsd='http://www.w3.org/2001/XMLSchema'><wsdl:binding style='document' name='MyBinding'><wsdl:part name='myPart' element='MyElement'/></wsdl:binding></wsdl:definitions>";
        DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();
        DocumentBuilder builder = factory.newDocumentBuilder();
        Document doc = builder.parse(new java.io.ByteArrayInputStream(wsdl.getBytes()));
        W3CDom convertDoc = w3cdom.convert(doc);
        Properties propertiesFromMap = new Properties();
        propertiesFromMap.put("wsdl", wsdl);
        Map<String, String> map = w3cdom.OutputHtml().getOutputProperties(propertiesFromMap);

        w3cdom = new W3CDom(convertDoc, map);
    }

    @Test
    public void testNamespaceAware() {
        W3CDom.W3CDom namespaceAwareW3CDom = new W3CDom();
        assert namespaceAwareW3CDom.namespaceAware();
        assert !namespaceAwareW3CDom.namespaceAware(false);
    }

    @Test
    public void testNamespaceAwareFactory() {
        W3CDom.W3CDom namespaceAwareFactoryW3CDom = new W3CDom();
        assert namespaceAwareFactoryW3CDom.namespaceAware();
        assert !namespaceAwareFactoryW3CDom.namespaceAware(false);

        Properties propertiesFromMap = new Properties();
        propertiesFromMap.put("wsdl", wsdl);
        Map<String, String> map = w3cdom.OutputHtml().getOutputProperties(propertiesFromMap);

        W3CDom.W3CDom namespaceAwareFactoryW3CDom = new W3CDom(namespaceAwareFactoryW3CDom, map);
    }

    @Test
    public void testNamespaceAwareFactoryMap() {
        Properties propertiesFromMap = new Properties();
        Map<String, String> map = new HashMap<>();
        map.put("wsdl", wsdl);

        W3CDom.W3CDom namespaceAwareFactoryW3CDom = new W3CDom(namespaceAwareFactoryW3CDom, map);
        assert namespaceAwareFactoryW3CDom.namespaceAware();
        assert !namespaceAwareFactoryW3CDom.namespaceAware(false);

        Properties propertiesFromMap2 = new Properties();
        propertiesFromMap2.put("wsdl", wsdl);

        W3CDom.W3CDom namespaceAwareFactoryW3CDom2 = new W3CDom(namespaceAwareFactoryW3CDom, propertiesFromMap2);
    }

    @Test
    public void testNamespaceAwareFactoryProperties() {
        Properties propertiesFromMap = new Properties();
        propertiesFromMap.put("wsdl", wsdl);

        W3CDom.W3CDom namespaceAwareFactoryW3CDom = new W3CDom(namespaceAwareFactoryW3CDom, propertiesFromMap);
        assert namespaceAwareFactoryW3CDom.namespaceAware();
        assert !namespaceAwareFactoryW3CDom.namespaceAware(false);

        Properties propertiesFromMap2 = new Properties();
        propertiesFromMap2.put("wsdl", wsdl);

        W3CDom.W3CDom namespaceAwareFactoryW3CDom2 = new W3CDom(namespaceAwareFactoryW3CDom, propertiesFromMap2);
    }

    @Test
    public void testOutputHtml() {
        Document doc = w3cdom.fromJsoup(new org.jsoup.nodes.Document());
        String outputHtml = w3cdom.OutputHtml().getOutput();
        assertEquals(wsdl, outputHtml);
    }

    @Test
    public void testOutputXml() {
        Document doc = w3cdom.fromJsoup(new org.jsoup.nodes.Document());
        String outputXml = w3cdom.OutputXml().getOutput();
        assertEquals(wsdl, outputXml);
    }

    @Test
    public void testFromJsoup() {
        Document doc = new org.jsoup.nodes.Document();
        org.jsoup.nodes.Document fromJsoupDoc = w3cdom.fromJsoup(doc);
        assert fromJsoupDoc != null;
    }

    @Test
    public void testFromJsoupElement() {
        Element element = new org.jsoup.nodes.Element();
        W3CDom.W3CDom fromJsoupElementW3CDom = w3cdom.fromJsoup(element);
        assert fromJsoupElementW3CDom != null;
    }

    @Test
    public void testSelectXpath() {
        Document doc = new org.jsoup.nodes.Document();
        Elements elements = w3cdom.selectXpath("some xpath", doc);
        assertEquals(1, elements.size());
    }
}
