import java.util.*;

public class Grammar {
    private Map<String, String> rules;
    private Set<String> productionRules;

    public Grammar() {
        this.rules = new HashMap<>();
        this.productionRules = new HashSet<>();
    }

    public void addRule(String input, String output) {
        if (rules.containsKey(input)) {
            System.out.println("Input '" + input + "' already has a rule.");
            return;
        }
        productionRules.add(input);
        rules.put(input, output);
    }

    @Override
    public boolean equals(Object obj) {
        if (!(obj instanceof Grammar)) {
            return false;
        }
        Grammar other = (Grammar) obj;
        return this.productionRules.equals(other.productionRules);
    }

    @Override
    public int hashCode() {
        return productionRules.hashCode();
    }

    public void printProductionRules() {
        System.out.println("Production Rules:");
        for (String production : productionRules) {
            System.out.println(production);
        }
    }
}

public class GrammarTest {
    private Grammar grammar;

    public GrammarTest() {
        thisgrammar = new Grammar();
    }

    public static void main(String[] args) {
        GrammarTest tests = new GrammarTest();

        // Test 1
        tests.addRule("apple", "BANANA");
        System.out.println(tests.match("apple")); // true

        // Test 2
        tests.addRule("dog", "PUPPIE");
        System.out.println(tests.match("dog")); // false

        // Add more test cases here...

