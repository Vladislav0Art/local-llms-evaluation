import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;

public class W3CDomTest {

    public void testHtmlParse() {
        Document document = new Document();
        Element rootElement = document.createElement("html");
        document.appendChild(rootElement);
        Assert.assertEquals(document, rootElement);
    }

    public void testTextNode() {
        Document document = new Document();
        Element textElement = document.createElement("p");
        textElement.setTextContent("Hello World!");
        Assert.assertEquals(textElement.getTextContent(), "Hello World!");
        Assert.assertEquals(textElement.getNodeValue(), "Hello World!");
    }

    public void testDocumentType() {
        Document document = new Document();
        document.documentType = "html";
        Assert.assertEquals(document, new Document());
    }

    public void testHtmlTags() {
        Document document = new Document();
        Element element = document.createElement("img");
        element.attr("src", "image.jpg");
        element.appendChild(document.createAttribute("alt"));
        Assert.assertEquals(element.getAttributes().getByName("src"), "image.jpg");
        Assert.assertEquals(element.getAttribute("alt"), "image.jpg");
    }

    public void testCssStyles() {
        Document document = new Document();
        Element styleElement = document.createElement("style");
        styleElement.appendChild(document.createAttribute("style"));
        styleElement.appendChild(document.createTextNode("body { background-color: #f2f2f2; }"));
        Assert.assertEquals(styleElement.getAttributes().getByName("style"), "style");
        Assert.assertEquals(styleElement.getAttribute("style"), "body { background-color: #f2f2f2; }");
    }

    public void testJsoupConvert() {
        Document document = new Document();
        Element element = document.createElement("p");
        element.appendChild(document.createAttribute("href"));
        element.setAttribute("title", "This is a title");
        Assert.assertEquals(element, neworg.jsoup.nodes.Document().createElementTag("p").addAttribute("href", "#").addAttribute("title", "This is a title"));
    }

    public void testJsoupFrom() {
        Document document = new Document();
        Element element = document.createElement("html");
        document.appendChild(element);
        Assert.assertEquals(document, element);
    }

    public void testSelectXpath() {
        Document document = new Document();
        Element rootElement = document.createElement("html");
        rootElement.setAttribute("xmlns", "http://example.com");

        Element element1 = document.createElement("body");
        element1.setAttribute("class", "container");

        Element element2 = document.createElement("div");
        element2.setAttribute("style", "background-color: #f2f2f2;");
        element2.appendChild(document.createAttribute("href"));

        Assert.assertEquals(element1.getAttributes().getByName("xmlns"), "http://example.com");
        Assert.assertEquals(element2.getAttributes().getByName("class"), "container");

        Element selector = new org.jsoup.ElementSelect(document);
        Assert.assertEquals(selector.select("body"), element1);
        Assert.assertEquals(selector.select("div"), element2);

        Element node1 = selector.selectOne(element1);
        Assert.assertEquals(node1, null); // or any other expected result

        Element node2 = selector.selectFirst(element2);
        Assert.assertEquals(node2, null); // or any other expected result
    }

    public void testDomConstructorWithCustomAttr() {
        Document document = new Document();
        Element element = document.createElement("p");
        element.setAttribute("data-id", "123");
        Assert.assertEquals(document.createElementTag("p").getAttribute("data-id"), "123");
    }
}
