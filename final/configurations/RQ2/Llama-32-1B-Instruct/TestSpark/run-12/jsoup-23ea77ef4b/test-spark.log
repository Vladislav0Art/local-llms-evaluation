    public void setup() {
        Properties properties = new HashMap<>();
        properties.put("jsoup", "1.14.5");
        String xmlFile = "test.xml";
        document = DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(new File(xmlFile));
        Document wdoc = DocumentBuilderFactory.newInstance().newDocumentBuilder().newDocument();
        wdoc.appendChild(wdoc.importNode(document.getDocumentElement(), true));
    }

    public void testNamespaceAware() {
        org.jsoup.nodes.Document doc = neworg.jsoup.nodes.Document();
        org.jsoup.nodes.Document wdoc = new org.jsoup.nodes.Document();
        org.jsoup.nodes.Document resultDoc = W3CDom.convert(doc);
        Assert.assertTrue(resultDoc.is NamespaceAware());
    }

    public void testNamespaceAware(boolean namespaceAware) {
        org.jsoup.nodes.Document doc = new org.jsoup.nodes.Document();
        org.jsoup.nodes.Document wdoc = new org.jsoup.nodes.Document();
        org.jsoup.nodes.Document resultDoc = W3CDom.convert(doc, wdoc);
        Assert.assertTrue(resultDoc.is NamespaceAware(namespaceAware));
    }

