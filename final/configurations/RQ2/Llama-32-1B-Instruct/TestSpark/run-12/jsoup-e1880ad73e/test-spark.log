import org.jsoup.helper.DataUtil;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.CsvSource;

public class UrlBuilderTest {

    @ParameterizedTest
    @CsvSource({
            "https://example.com/path1",
            "https://example.com/path2?param=123",
            "https://example.com/path3&anotherParam=456"
    })
    void testBuildUrl(String inputUrl) {
        UrlBuilder builder = new UrlBuilder(new URI(inputUrl));
        assertEquals("https://example.com/path1", builder.build().toASCIIString());
    }

    @Test
    void testAppendKeyVal() throws UnsupportedEncodingException {
        UrlBuilder builder = new UrlBuilder("https://example.com/path");
        String key = "param1";
        String value = "123";
        builder.appendKeyVal(Connection.KeyVal.of(key, value));
        assertEquals("param1=123", builder.build().toASCIIString());
    }

    @ParameterizedTest
    @CsvSource({
            "\"https://example.com/path1\"",
            "\"https://example.com/path2?param=123&quot;
    })
    void testUrlEncode(String inputUrl) {
        UrlBuilder builder = new UrlBuilder(new URI(inputUrl));
        assertEquals("https%3A//example.com/path1", builder.build().toASCIIString());
    }

    @ParameterizedTest
    @CsvSource({
            "\"https://example.com/path1\"",
            "\"https://example.com/path2?param=123&anotherParam=456&quot;
    })
    void testUrlDecode(String inputUrl) {
        UrlBuilder builder = new UrlBuilder(new URI(inputUrl));
        assertEquals("https://example.com/path1", builder.build().toASCIIString());
    }

    @ParameterizedTest
    @CsvSource({
            "\"https://example.com/path1\"",
            "\"https://example.com/path2?param=123&anotherParam=456&quot;
    })
    void testMalformedURLException(String inputUrl) {
        try {
            new UrlBuilder(new URI(inputUrl));
            fail("Expected MalformedURLException");
        } catch (MalformedURLException e) {
            // Expected
        }
    }

    @ParameterizedTest
    @CsvSource({
            "\"https://example.com/path1\"",
            "\"https://example.com/path2?param=123&anotherParam=456&quot;
    })
    void testUriDecoder(String inputUrl) {
        UrlBuilder builder = new UrlBuilder(new URI(inputUrl));
        assertEquals("https%3A//example.com/path1", builder.build().toASCIIString());
    }

}
