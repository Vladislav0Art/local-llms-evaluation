public class TestClass {

    private Map<String, Boolean> mediaTypes = new HashMap<>();

    public void addMediaType(String name) {
        mediaTypes.put(name, true);
    }

    public boolean isMediaTypeExist(String name) {
        return mediaTypes.containsKey(name);
    }

    public String getMediaTypeName(String name) {
        if (mediaTypes.containsKey(name)) {
            return name;
        } else {
            return null;
        }
    }
}

