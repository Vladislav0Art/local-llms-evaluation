    private Map<String, Boolean> scriptMediaTypes = new HashMap<>();

    public void addScriptMediaType(String name) {
        scriptMediaTypes.put(name, true);
    }

    public boolean isScriptMediaTypeExist(String name) {
        return scriptMediaTypes.containsKey(name);
    }

    public String getScriptMediaTypeName(String name) {
        if (scriptMediaTypes.containsKey(name)) {
            return name;
        } else {
            return null;
        }
    }

    public static void main(String[] args) {
        TestScriptClass testScript = new TestScriptClass();

        testScript.addScriptMediaType("application/x-font");
