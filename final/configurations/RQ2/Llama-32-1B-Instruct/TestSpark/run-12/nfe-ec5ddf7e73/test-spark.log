import java.util.HashMap;
import java.util.Map;

public class Vehicle {
    private String brand;
    private int modelYear;
    private double capacity;

    public Vehicle(String brand, int modelYear) {
        this.brand = brand;
        this.modelYear = modelYear;
        this.capacity = 0.0;
    }

    public void setBrand(String brand) {
        this.brand = brand;
    }

    public String getBrand() {
        return brand;
    }

    public void setModelYear(int modelYear) {
        this.modelYear = modelYear;
    }

    public int getModelYear() {
        return modelYear;
    }

    public double getCapacity() {
        return capacity;
    }

    public void setCapacity(double capacity) {
        if (capacity > 0) {
            this.capacity = capacity;
        } else {
            throw new IllegalArgumentException("Invalid capacity");
        }
    }

    @Override
    public String toString() {
        return "Brand: " + brand + ", Model Year: " + modelYear + ", Capacity: " + capacity;
    }
}

public class Main {

    public static void main(String[] args) {
        VehicleTest vehicleTest = new VehicleTest();
        vehicleTest.setUp();

        // Test the getBrand() method
        System.out.println("Test Brand:");
        assertEquals("Toyota", vehicleTest.vehicle.getBrand());

        // Test the getModelYear() method
        System.out.println("\nTest Model Year:");
        assertEquals(2015, vehicleTest.vehicle.getModelYear(), 0);

        // Test the setCapacity() method with valid input
        System.out.println("\nTest Capacity (valid):");
        vehicleTest.vehicle.setCapacity(15000.0);
        assertEquals(15000.0, vehicleTest.vehicle.getCapacity(), 10);

        // Test the setCapacity() method with invalid input
        System.out.println("\nTest Capacity (invalid):");
        try {
            vehicleTest.vehicle.setCapacity(-1.0);
        } catch (IllegalArgumentException e) {
            System.out.println(e.getMessage());
        }
    }
}
