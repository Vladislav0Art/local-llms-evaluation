import static org.junit.Assert.assertEquals;

public class Vehicle {
    private String brand;
    private int modelYear;
    private double capacity;

    public Vehicle(String brand, int modelYear) {
        this.brand = brand;
        this.modelYear = modelYear;
        this.capacity = 0.0;
    }

    public void setBrand(String brand) {
        this.brand = brand;
    }

    public String getBrand() {
        return brand;
    }

    public void setModelYear(int modelYear) {
        this.modelYear = modelYear;
    }

    public int getModelYear() {
        return modelYear;
    }

    public double getCapacity() {
        return capacity;
    }

    public void setCapacity(double capacity) {
        if (capacity > 0) {
            this.capacity = capacity;
        } else {
            throw new IllegalArgumentException("Invalid capacity");
        }
    }

    @Override
    public String toString() {
        return "Brand: " + brand + ", Model Year: " + modelYear + ", Capacity: " + capacity;
    }
}

public class VehicleTest {
    private Vehicle vehicle;

    public void setUp() {
        vehicle = new Vehicle("Toyota", 2015);
    }

    public void testBrand() {
        assertEquals("Toyota", vehicle.getBrand());
    }

    public void testModelYear() {
        assertEquals(2015, vehicle.getModelYear(), 0);
    }

    public void testCapacity() {
        vehicle.setCapacity(15000.0);
        assertEquals(15000.0, vehicle.getCapacity(), 10);
    }
}

