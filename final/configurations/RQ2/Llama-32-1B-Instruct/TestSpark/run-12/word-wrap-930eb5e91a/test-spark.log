    public void testFromClasspath() throws IOException {
        File file = new File("hello.txt");
        WordWrap.Builder builder = WordWrap.fromFile(file, StandardCharsets.UTF_8);
        assertWordWrap(builder, "", "Hello World");
    }

    @Test
    public void testFromUtf8() throws IOException {
        WordWrap.Builder builder = WordWrap.fromClasspathUtf8("Hello World");
        assertWordWrap(builder, "", "Hello World");
    }

    private void assertWordWrap(WordWrap.Builder builder, String line1, String line2) {
        try (Writer out = new OutputStreamWriter(System.out)) {
            wordWrap(builder.reader(), out, 20L, null, null, false, true);
            assertEquals(line1 + "\n" + line2, out.toString());
        } catch (IOException e) {
            fail("Unexpected exception");
        }
    }

    private void wordWrap(Reader in, Writer out, String newLine, Number maxWidth, Function<? super CharSequence, ? extends Number> stringWidth, Set<Character> extraWordChars, boolean insertHyphens, boolean breakWords)
            throws IOException {
        char[] buffer = new char[maxWidth];
        int currentLength = 0;
        for (char c : in.read()) {
            if (!isWhitespace(c)) {
                StringBuilder word = new StringBuilder();
                while (c != '\n' && !extraWordChars.contains(c)) {
                    word.append(c);
                    if (breakWords || currentLength + stringWidth.apply(word.charAt(currentLength - 1)) > maxWidth) {
                        String line = insertHyphens ? breakWords ? word.toString() : word + " " + newLine else word;
                        out.write(newLine.equals(line) ? "" : "\n");
