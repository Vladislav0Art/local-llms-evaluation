import java.util.Arrays;
import java.util.HashMap;
import java.util.Map;

public class TestClass {

    private static Map<String, String> attrs = new HashMap<>();

    public void addAttr(String key, String value) {
        attrs.put(key, value);
    }

    public String getAttr(String key) {
        return attrs.getOrDefault(key, "");
    }

    public String getValue(String key) {
        return attrs.computeIfAbsent(key, k -> "");
    }
}

public class Attr {

    private Map<String, String> keyValueMap = new HashMap<>();

    public Attr(String key, String value) {
        this.keyValueMap.put(key, value);
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;
        Attr that = (Attr) o;
        return key.equals(that.key) && keyValueMap.equals(that.keyValueMap);
    }

    @Override
    public int hashCode() {
        return 31 * Objects.hash(key, keyValueMap);
    }
}

public class Main {

    public static void main(String[] args) {
        TestClass testClass = new TestClass();

        System.out.println(testClass.getValue("key1")); // returns ""

        testClass.addAttr("key2", "value2");

        System.out.println(testClass.getValue("key2")); // prints "value2"

        System.out.println(testClass.getAttribute("key1")); // returns ""
    }
}
```
