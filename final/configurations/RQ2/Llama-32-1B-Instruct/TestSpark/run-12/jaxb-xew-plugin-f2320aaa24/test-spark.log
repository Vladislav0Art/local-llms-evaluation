import java.lang.reflect.Field;
import java.util.HashMap;
import java.util.Map;

public class Main {
    private Map<String, Object> props = new HashMap<>();

    public void setProp(String key, String value) {
        this.props.put(key, value);
    }

    public Object getProp(String key) {
        return this.props.get(key);
    }

    public void removeProp(String key) {
        this.props.remove(key);
    }

    public void printProps() {
        for (Map.Entry<String, Object> entry : props.entrySet()) {
            System.out.println("Public field: " + entry.getKey());
            try {
                Field field = Main.class.getDeclaredField(entry.getKey());
                field.setAccessible(true);
                System.out.println(field.get(null));
            } catch (Exception e) {}
        }
    }

    public static void main(String[] args) throws Exception {
        // Test 1
        Object instance1 = new Main();
        instance1.setProp("x", "public");
        instance1.printProps();

        // Test 2
        Object instance2 = new Main();
        System.out.println(instance2.getProp("y"));

        // Test 3
        instance2.removeProp("y");

        // Test 4
        instance2.setProp("z", "private");
        instance2.printProps();

        // Test 5
        instance1.printProps();
    }
}
```

This class uses a HashMap to store the properties. The `setProp` method adds a new property, the `getProp` method retrieves a property, and the `removeProp` method removes a property. The `printProps` method prints out all public fields.

Please note that this is a very basic implementation and does not handle cases where the field is private or has security restrictions (e.g., no access to it). For a real-world application, you would need to add additional checks and handling.
