package io.github.vmzakharov.ecdataframe.dsl.visitor;

import org.junit.jupiter.api.Test;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.CsvSource;

public class PrettyPrintVisitorTest {

    @ParameterizedTest
    @CsvSource({"1, 2", "abc, def"})
    public void testVisitExpression(String expr) {
        PrettyPrintVisitor visitor = new PrettyPrintVisitor();
        Expression e = StringIterate.of(expr).toExpression();
        visitor.visit(e);
        Printers.assertPrints(eq(e));
    }

    @ParameterizedTest
    @CsvSource({"1, 2", "abc, def"})
    public void testVisitConstExpr(String expr) {
        PrettyPrintVisitor visitor = new PrettyPrintVisitor();
        Value v = StringIterate.of(expr).toValue();
        visitor.visit(v);
        Printers.assertPrints(eq(v));
    }

