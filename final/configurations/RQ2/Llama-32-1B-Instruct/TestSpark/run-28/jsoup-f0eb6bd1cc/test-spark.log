public class GeneratedTest {
    public static void main(String[] args) throws UnsupportedEncodingException {
        GeneratedTest test = new GeneratedTest();

        // Test that appendKeyVal() appends a key-value pair to the URL
        String url = "https://example.com/path/to/resource?key=value";
        test.appendKeyVal("key", "value");
        System.out.println("URL after appending key-value pair: " + url);

        // Test that appendKeyVal() throws an exception when given malformed data
        try {
            // Malformed key-value pair (incorrect key format)
            KeyVal key = new KeyVal("key- wrong-format", "value");
            test.appendKeyVal(key, 123);
        } catch (UnsupportedEncodingException e) {
            System.out.println("Exception thrown: " + e.getMessage());
        }

        // Test that appendKeyVal() throws an exception when given malformed data
        try {
            // Malformed value (missing quotes or incorrect type)
            KeyVal key = new KeyVal("key", "");
            test.appendKeyVal(key, 123);
        } catch (UnsupportedEncodingException e) {
            System.out.println("Exception thrown: " + e.getMessage());
        }

        // Test that appendKeyVal() throws an exception when given malformed data
        try {
            // Malformed value quotes (missing or incorrect quotes around string)
            KeyVal key = new KeyVal("key", "");
            test.appendKeyVal(key, 123);
        } catch (UnsupportedEncodingException e) {
            System.out.println("Exception thrown: " + e.getMessage());
        }
    }

    private static class UrlBuilder extends java.util.Base64CharArray {
        @Override
        public void appendKeyVal(KeyVal key, Value value) throws UnsupportedEncodingException {
            StringBuilder builder = new StringBuilder();
            builder.append(key.getPrefix()).append(":").append(value.getValue());

            String encodedValue = encode(String.valueOf(value));
            System.out.println("Encoded value: " + encodedValue);
            System.out.println("URL with appended key-value pair: " + URL + "?prefix=" + builder.toString());
        }

        private static void encode(String input) throws UnsupportedEncodingException {
            return java.util.Base64.getEncoder().encode(input.getBytes());
        }
    }
}
