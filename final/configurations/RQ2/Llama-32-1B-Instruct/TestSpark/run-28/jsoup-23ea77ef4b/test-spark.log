        String url = "http://example.com";
        try (Document doc = Jsoup.connect(url).get()) {
            return doc;
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    public void testGetPage() {
        Document doc = getDocument();
        System.out.println(doc);
    }

    public void testParseText(String text, String expected) {
        try {
            String result = Jsoup.parse(text).text().equals(expected);
            System.out.println(result);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    public void testGetParagraph() {
        Document doc = getDocument();
        NodeList nodeList = doc.select("p");
        for (int i = 0; i < nodeList.getLength(); i++) {
            System.out.println(nodeList.item(i).text());
        }
    }

