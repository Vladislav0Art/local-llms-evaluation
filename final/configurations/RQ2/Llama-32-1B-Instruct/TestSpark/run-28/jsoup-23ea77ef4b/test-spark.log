        try {
            String result = Jsoup.parse(text).html();
            System.out.println(result);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    public void testSelectXpath() throws Exception {
        Document doc = getDocument();
        NodeList nodeList = doc.select("p");
        for (int i = 0; i < nodeList.getLength(); i++) {
            System.out.println(nodeList.item(i).text());
        }
    }

    public void testGetText(String text) {
        try {
            String result = Jsoup.parse(text).text();
            System.out.println(result);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    public void testParseXpath() throws Exception {
        Document doc = getDocument();
        NodeList nodeList = doc.select("p");
        for (int i = 0; i < nodeList.getLength(); i++) {
            System.out.println(nodeList.item(i).text());
        }
