import org.junit.Before;
import org.junit.Test;

public class TagTest {

    private Tag tag;

    @Before
    public void setUp() {
        tag = new Tag();
    }

    @Test
    public void testGetName() {
        assertEquals("tag", tag.getName());
    }

    @Test
    public void testNormalName() {
        assertEquals("Tag", Normalizer.normalize(tag.getName(), Normalizer.NFD));
    }

    @Test
    public void testValueOfTagName() {
        Tag tagName = Tag.valueOf("p");
        assertEquals(tagName, tagName);
    }

    @Test
    public void testValueOfTagNames() {
        String[] tags = {"div", "span", "a"};
        for (String tag : tags) {
            Tag tagValue = Tag.valueOf(tag);
            assertNotNull(tagValue);
        }
    }

    @Test
    public void testIsBlock() {
        assertTrue(tag.isBlock());
    }

    @Test
    public void testFormatAsBlock() {
        assertFalse(tag.formatAsBlock());
    }

    @Test
    public void testIsInline() {
        assertTrue(tag.isInline());
    }

    @Test
    public void testIsEmpty() {
        assertTrue(tag.isEmpty());
    }

    @Test
    public void testIsSelfClosing() {
        assertTrue(tag.isSelfClosing());
    }

    @Test
    public void testIsKnownTag() {
        assertEquals(true, tag.isKnownTag("img"));
    }

    @Test
    public void testIsKnownTagWithoutSetting() {
        assertEquals(false, Tag.isKnownTag("input"));
    }

    @Test
    public void testSetSelfClosing() {
        Tag tag2 = new Tag();
        tag2.setSelfClosing(true);
        assertTrue(tag.isKnownTag("img"));
    }

    @Before
    public void tearDown() {}

    @Test
    public void testEquals() {
        Tag tag1 = new Tag();
        Tag tag2 = new Tag();
        assertEquals(tag1, tag2);
    }

    @Test
    public void testHashCode() {
        Tag tag1 = new Tag();
        Tag tag2 = new Tag();
        assertEquals(assertEquals(tag1.hashCode(), tag2.hashCode()));
    }

    @Before
    public void setUpTag2() {
        tag.setSelfClosing(true);
    }

    @Test
    public void testToString() {
        String tagName = "span";
        Tag tag = new Tag();
        tag.setName(tagName);
        assertTrue(tag.toString().contains(tagName));
    }
}
