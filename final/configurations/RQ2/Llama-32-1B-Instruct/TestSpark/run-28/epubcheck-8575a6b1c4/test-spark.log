public class EpubChecker {
    public static String checkEpub(String coverImage, String authorName) {
        if (coverImage == null || authorName == null) {
            throw new NullPointerException("Both coverImage and authorName must not be null");
        }
        return "Cover image is valid. Author name is: " + authorName;
    }

    public static String checkEpub(String coverImage, String authorName, String isbn) {
        if (coverImage == null || authorName == null || isbn == null) {
            throw new NullPointerException("Both coverImage and authorName must not be null");
        }
        return "Cover image is valid. Author name is: " + authorName + ". ISBN is: " + isbn;
    }

    public static boolean checkAuthor(String authorName) {
        if (authorName == null || authorName.isEmpty()) {
