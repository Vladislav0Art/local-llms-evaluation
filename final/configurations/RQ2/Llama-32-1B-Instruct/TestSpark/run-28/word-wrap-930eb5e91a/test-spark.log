public class WordWrapTest {

    @Test
    public void wordWrap_SingleLine_NoWhitespace() throws IOException {
        BufferedReader reader = new BufferedReader(new InputStreamReader(System.in));
        Writer out = new OutputStreamWriter(System.out);
        String line = "Hello, World!";
        Number maxWidth = 10;
        Function<? super CharSequence, ? extends Number> stringWidth = s -> s.length();
        Set<Character> extraWordChars = new HashSet<>();
        boolean insertHyphens = false;
        boolean breakWords = true;

        wordWrap(reader, out, line, maxWidth, stringWidth, extraWordChars, insertHyphens, breakWords);
        Assert.assertEquals(line, out.toString());
    }

