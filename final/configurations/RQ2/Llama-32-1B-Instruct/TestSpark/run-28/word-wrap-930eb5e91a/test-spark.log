```java
public class TestClass {

    public static String joinStrings(String... strings) {
        return String.join(" ", strings);
    }

    public static void testJoinStrings() {
        System.out.println(joinStrings("Hello, ", "world!"));
        System.out.println(joinStrings("", " "));
        System.out.println(joinStrings(null, 10));
    }

    public static int countLetters(String str) {
        return str.length();
    }

    public static void testCountLetters() {
        String s = "Hello";
        System.out.println(countLetters(s));
        s = "";
        System.out.println(countLetters(s));
        s = null;
        System.out.println(countLetters(s));
    }
}

public class TestClass2 {

    public int multiply(int a, int b) {
        return a * b;
    }

    public void testMultiply() {
        System.out.println(multiply(3, 4));
        try {
            throw new RuntimeException();
        } catch (RuntimeException e) {
            System.out.println(e.getMessage());
        }
    }
}
```
