import java.util.Scanner;

public class PublicClass {

    public static String generateKey(String prefix, int length) {
        StringBuilder sb = new StringBuilder(prefix);
        for (int i = 0; i < length - 1; i++) {
            sb.append(randomString(2));
        }
        return sb.toString();
    }

    private static char[] randomString(int length) {
        char[] chars = "abcdefghijklmnopqrstuvwxyz0123456789".toCharArray();
        Random rand = new Random();
        return new String(chars, rand.nextInt(chars.length()));
    }

    public static void main(String[] args) {
        PublicClass testPublicMethods = new PublicClass();
        testPublicMethods.testGetHtml();

        System.out.println(testPublicMethod.generateKey("my_prefix_", 10));
        if (testPublicMethod.isSubstring("my_prefix_123", "internal_key_")) {
            System.out.println(true);
        } else {
            System.out.println(false);
        }
    }

    private static String getHtml(String url) {
        return Jsoup.connect(url).get().html();
    }

    public void testGetHtml() {
        Document doc = getHtml("https://www.example.com");
        System.out.println(doc.html());
    }

    private static void testPublicMethods() {
        PublicClass testPublicClass = new PublicClass();

        System.out.println(testPublicMethod.generateKey("my_prefix_", 10));
        if (testPublicMethod.isSubstring(testPublicClass.internalKey("123"), "internal_key_")) {
            System.out.println(true);
        } else {
            System.out.println(false);
        }

        Document doc1 = getHtml("https://www.example.com");
        System.out.println(doc1.html().contains("my_prefix_123"));
        Document doc2 = getHtml("https://www.example.net");
        System.out.println(doc2.html().contains("internal_key_"));

        testPublicMethod.internalKey("456");
    }
}
```

