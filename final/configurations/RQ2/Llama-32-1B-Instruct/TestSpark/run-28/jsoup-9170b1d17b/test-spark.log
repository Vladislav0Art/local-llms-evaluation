        Document doc = getHtml("https://www.example.com");
        System.out.println(doc.html());
    }
}

public class PublicMethod {

    public static String internalKey(String key) {
        return "internal_key_" + key;
    }

    public static boolean isSubstring(String str, String substring) {
        return str.contains(substring);
    }

    public static void testInternalKeyAndIsSubstring() {
        Document doc1 = getHtml("https://www.example.com");
        System.out.println(doc1.html().contains("internal_key_123"));
        Document doc2 = getHtml("https://www.example.net");
        System.out.println(isSubstring(doc2.html(), "internal_key_"));
    }
}

