    public void setup() {
        AnnotatedElement object = new TestObjectAnnotation();
        container = new ProcessingElementsContainer();
        directives = new DirectivesBuilder(object, container);
    }

    @Test
    public void testBuild() {
        assertResult(Arrays.asList(
                GraphQLDirective.newBuilder(GraphQLArgument.builder().name("name").type(GraphQLScalarType.STRING).build()),
                GraphQLDirective.newBuilder(GraphQLArgument.builder().name("value").type(GraphQLScalarType.STRING).build())
        ), build());
    }

    @Test
    public void testBuild_directives() {
        assertResult(Arrays.asList(
                new GraphQLDirective[] {
                        GraphQLDirective.newBuilder(GraphQLDirectives.DIRECTIVE_NAME),
                        GraphQLDirective.newBuilder(GraphQLDirectives.DIRECTIVE_VALUE)
                }
        ), buildDirectives());
    }

    private List<GraphQLDirective> build() {
        return Arrays.asList(
            new GraphQLDirective(new GraphQLDirective.Builder().directive("name", "name").build())),
            new GraphQLDirective(new GraphQLDirective.Builder().directive("value", "value").build()))
        );
    }

