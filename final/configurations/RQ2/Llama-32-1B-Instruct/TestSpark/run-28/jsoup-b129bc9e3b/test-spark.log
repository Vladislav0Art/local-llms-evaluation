    public Person(String name) {
        this.name = name;
    }

    public String getName() {
        return name;
    }
}

class PersonBuilder {
    private String name;

    public PersonBuilder(String name) {
        this.name = name;
    }

    public PersonBuilder withName(String name) {
        this.name = name;
        return this;
    }

    public Person build() {
        return new Person(name);
    }
}

