import java.util.zip.Inflater;
import java.util.zip.InflaterInputStream;
import static org.jsoup.Connection.Method.HEAD;
import static org.jsoup.internal.Normalizer.lowerCase;

public class HttpConnection implements Connection {

    public String buildRequest(Method method, Connection.Request request) {
        return method.make().url(request.url());
    }

    @Override
    public Connection data(String key, Map<String, String> data) {
        Document doc = new Document();
        for (Map.Entry<String, String> entry : data.entrySet()) {
            doc.appendTag(entry.getKey(), entry.getValue());
        }
        return document(doc);
    }

    private static class Response implements Connection.Response {
        private final Connection.Response response;

        public Response(Connection.Response response) {
            this.response = response;
        }

        @Override
        public InputStream getInputStream() throws IOException {
            return response.getInputStream();
        }

        @Override
        public boolean isSuccessful() {
            return true;
        }
    }

    @Override
    public Connection execute() throws IOException {
        Connection.Request request = new Request();
        try {
            return buildRequest(new Method(), request);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    @Override
    public boolean isSuccessful() {
        return true;
    }

    private static class Document implements Connection.Document {
        private final Document document;

        public Document(Document document) {
            this.document = document;
        }

        @Override
        public String toString() {
            return document.toString();
        }
    }

    public static void testConnect(String url) throws IOException {
        HttpConnection connection = new HttpConnection();
        try (InputStream inputStream = connection.connect(url)) {
            Document document = new Document(inputStream);
            System.out.println(document.toString());
        } catch (IOException e) {
            throw new RuntimeException(e);
        }
    }

    @Test
    public void testConnect() throws IOException {
        testConnect("https://www.example.com");
    }

    private static class Request implements Connection.Request {

        public String url(String url) {
            return "http://" + url;
        }

        @Override
        public boolean isAbsolute() {
            return false;
        }

        @Override
        public boolean isAbsolutePath() {
            return true;
        }

        @Override
        public Method method(Method method) {
            return method;
        }
    }

    private static class Method implements Connection.Method {

        @Override
        public String toString() {
            return "HEAD";
        }
    }

    @Test
    public void testMethod() throws IOException {
        HttpConnection connection = new HttpConnection();
        Request request = new Request().method(Method.HEAD);
        try (InputStream inputStream = connection.execute()) {
            Document document = new Document(inputStream);
            System.out.println(document.toString());
        } catch (IOException e) {
            throw new RuntimeException(e);
        }
    }

    private static class RequestBody implements Connection.Request.Body {

        @Override
        public InputStream get() throws IOException {
            return null;
        }
    }

    @Test
    public void testRequestBody() throws IOException {
        HttpConnection connection = new HttpConnection();
        RequestBody requestBody = new RequestBody().request("GET", "/path");
        try (InputStream inputStream = connection.execute()) {
            Document document = new Document(inputStream);
            System.out.println(document.toString());
        } catch (IOException e) {
            throw new RuntimeException(e);
        }
    }

    @Test
    public void testHeaders() throws IOException {
        HttpConnection connection = new HttpConnection();
        Request request = new Request().headers("Header1", "Value1");
        try (InputStream inputStream = connection.execute()) {
            Document document = new Document(inputStream);
            System.out.println(document.toString());
        } catch (IOException e) {
            throw new RuntimeException(e);
        }
    }

    @Test
    public void testResponse() throws IOException {
        HttpConnection connection = new HttpConnection();
        Response response = new Response().response(new Response.ResponseBuilder().build());

        // Set the method to HEAD.
        Method method = new Method().method(Method.HEAD);

        // Send a GET request with the headers set by the Request
        Connection.Request request = new Request(method, response);
        try (InputStream inputStream = connection.execute()) {
            Document document = new Document(inputStream);
            System.out.println(document.toString());
        } catch (IOException e) {
            throw new RuntimeException(e);
        }
    }

    @Test
    public void testResponseBuilder() throws IOException {
        HttpConnection connection = new HttpConnection();
        Response response = new Response().response(new Response.ResponseBuilder()
                .build(200, "OK", new String[] {"header1", "header2"}, new String[]{"data1", "data2"})
                .setMethod(Method.HEAD)
                .addHeader("Content-Type", "text/plain")
                .addHeader("Accept", "application/json"))
                .addBody(new RequestBody().request("POST", "/path", Collections.singletonMap("body", Arrays.asList("json1")))));

        // Send a GET request with the headers set by the Request
        Connection.Request request = new Request(response);
        try (InputStream inputStream = connection.execute()) {
            Document document = new Document(inputStream);
            System.out.println(document.toString());
        } catch (IOException e) {
            throw new RuntimeException(e);
        }
    }

    @Test
    public void testBuildRequest() throws IOException {
        HttpConnection connection = new HttpConnection();
        Request request = new Request();
        try (InputStream inputStream = connection.execute()) {
            Document document = new Document(inputStream);
            System.out.println(document.toString());
        } catch (IOException e) {
            throw new RuntimeException(e);
        }
    }

    @Test
    public void testDocument() throws IOException {
        HttpConnection connection = new HttpConnection();
        Request request = new Request().method(Method.HEAD).buildRequest(request);
        try (InputStream inputStream = connection.execute()) {
            Document document = new Document(inputStream);
            System.out.println(document.toString());
        } catch (IOException e) {
            throw new RuntimeException(e);
        }
    }

    private static class ResponseBuilder {

        public ResponseResponse build() throws IOException {
            return new Response.ResponseBuilder().build();
        }

        public ResponseResponse addHeader(String header, String value) throws IOException {
            return new Response.ResponseBuilder()
                    .setHeader(header, value)
                    .build();
        }
    }
}
