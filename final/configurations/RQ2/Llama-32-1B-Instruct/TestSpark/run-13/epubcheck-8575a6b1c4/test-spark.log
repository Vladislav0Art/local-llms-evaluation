    public void checkFileMetadata(String path, EPUBVersion version, Report report, EPUBProfile profile) {
        try (FileReader reader = new FileReader(path)) {

            // Check if the file has metadata
            String[] files;
            try (BufferedReader reader = new BufferedReader(new InputStreamReader(reader))) {
                while ((files = reader.readLine().split(",")) != null) {}
            }

            // Write a message to the report indicating that the file has metadata
            for (String file : files) {
                String[] metadata = file.split("=");
                if (!metadata.length == 2 || !metadata[0].trim().equals("file:" + path) || !metadata[1].trim().equals("")); {
                    report.addMessage(new Messages.MessageDictionaryDumper().getMessages().findKeyByString(file), "");
                }
            }

        } catch (IOException e) {
            throw new RuntimeException(e);
        }
    }

    public void checkFileRights(String path, EPUBVersion version, Report report, EPUBProfile profile) {
        try (FileReader reader = new FileReader(path)) {

            // Check if the file has rights metadata
            String[] files;
            try (BufferedReader reader = new BufferedReader(new InputStreamReader(reader))) {
                while ((files = reader.readLine().split("=")) != null) {}
            }

            // Write a message to the report indicating that the file has rights metadata
            for (String file : files) {
                if (!file.trim().equals("file:" + path)) {
                    report.addMessage(new Messages.MessageDictionaryDumper().getMessages().findKeyByString(file), "");
                }
            }

        } catch (IOException e) {
            throw new RuntimeException(e);
        }
    }
}

