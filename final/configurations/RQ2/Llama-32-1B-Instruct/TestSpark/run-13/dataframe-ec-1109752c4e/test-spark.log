public class DataFrameVisitor extends BaseVisitor<IndexExpr> {
    @Override
    public IndexExpr visitDecimalExpression(DecimalExpression node) {
        if (node.getKind() == DecimalTypeKind.ONE_OF_A_NUMBER || node.getKind() == DecimalTypeKind.NUMBER) {
            return new IndexExpr("x", node.getValue());
        } else if (node.getKind() == DecimalTypeKind.MULTI_OF_A_NUMBER) {
            int index = 0;
            for (int i = 1; i <= node.getArguments().size(); i++) {
                if (i != 1 && !node.getArguments().get(i).equals("x")) {
                    return new IndexExpr("y", index);
                }
                index += node.getArguments().get(i) - '0';
            }
        } else if (node.getKind() == DecimalTypeKind.POSITIVE_NUMBER) {
            int exponent = 1;
            for (int i = 1; i <= node.getArguments().size(); i++) {
                if (i != 1 && !node.getArguments().get(i).equals("x")) {
                    return new IndexExpr("y", exponent * index);
                }
                exponent *= node.getArguments().get(i) - '0';
            }
        } else if (node.getKind() == DecimalTypeKind.NEGATIVE_NUMBER) {
            int exponent = 1;
            for (int i = 1; i <= node.getArguments().size(); i++) {
                if (i != 1 && !node.getArguments().get(i).equals("x")) {
                    return new IndexExpr("y", -exponent * index);
                }
                exponent *= node.getArguments().get(i) - '0';
            }
        } else if (node.getKind() == DecimalTypeKind.FIXED_NUMBER) {
            int num = 1;
            for (int i = 2; i <= node.getArguments().size(); i++) {
                if (i != 2 && !node.getArguments().get(i).equals("x")) {
                    return new IndexExpr("y", -num * index);
                }
                num *= node.getArguments().get(i) - '0';
            }
        } else {
            throw new RuntimeException("Unsupported type");
        }
        if (node instanceof MultiOfALongNumber && ((MultiOfALongNumber) node).getNum1() == 2) {
            return new IndexExpr("y", Math.abs((int) node.getValue()));
        } else if (node instanceof MultiOfAMultipleOfALongNumber && ((MultiOfAMultipleOfALongNumber) node).getNum1() == 3) {
            return new IndexExpr("x", node.getValue());
        }
        throw new RuntimeException();
    }

    @Override
    public BaseVisitor<IndexExpr> visitIfElse(IfElseExpression node) {
        return super.visit(node);
    }

    @Override
    public IndexExpr visitPositiveNumber(PositiveNumber node) {
        int exponent = 1;
        for (int i = 2; i <= node.getArguments().size(); i++) {
            if (i != 2 && !node.getArguments().get(i).equals("x")) {
                return new IndexExpr("y", exponent * index);
            }
            exponent *= node.getArguments().get(i) - '0';
        }
        return new IndexExpr("x", exponent * index);
    }

    @Override
    public BaseVisitor<IndexExpr> visitNegativeNumber(NegativeNumber node) {
        int exponent = 1;
        for (int i = 2; i <= node.getArguments().size(); i++) {
            if (i != 2 && !node.getArguments().get(i).equals("x")) {
                return new IndexExpr("y", -exponent * index);
            }
            exponent *= node.getArguments().get(i) - '0';
        }
        return new IndexExpr("x", -exponent * index);
    }

    @Override
    public BaseVisitor<IndexExpr> visitMultiOfALongNumber(MultiOfALongNumber node) {
        int num1 = 1;
        for (int i = 2; i <= node.getArguments().size(); i++) {
            if (i != 2 && !node.getArguments().get(i).equals("x")) {
                return new IndexExpr("y", -num1 * index);
            }
            num1 *= node.getArguments().get(i) - '0';
        }
        return new IndexExpr("x", num1);
    }

    @Override
    public BaseVisitor<IndexExpr> visitMultiOfAMultipleOfALongNumber(MultiOfAMultipleOfALongNumber node) {
        int num1 = 1;
        for (int i = 2; i <= node.getArguments().size(); i++) {
            if (i != 2 && !node.getArguments().get(i).equals("x")) {
                return new IndexExpr("y", -num1 * index);
            }
            num1 *= node.getArguments().get(i) - '0';
        }
        int num2 = Integer.parseInt(node.getArguments().get(3));
        if (node.getKind() == DecimalTypeKind.NEGATIVE_NUMBER) {
            return new IndexExpr("x", num1 * Math.abs(num2) * index);
        } else {
            return new IndexExpr("y", num1 * num2 * index);
        }
    }

    @Override
    public BaseVisitor<IndexExpr> visitArray(PositiveNumber node) {
        int exponent = 0;
        for (int i = 2; i <= node.getArguments().size(); i++) {
            if (i != 2 && !node.getArguments().get(i).equals("x")) {
                return new IndexExpr("y", index);
            }
            exponent += Integer.parseInt(node.getArguments().get(i)) - '0';
        }
        return new IndexExpr("x", Math.pow(10, exponent) * index);
    }

    @Override
    public BaseVisitor<IndexExpr> visitArray(IfElseExpression node) {
        // do nothing
        return this;
    }

    @Override
    public BaseVisitor<IndexExpr> visitArray(MultiOfALongNumber node) {
        return new IndexExpr("x", Math.pow(10, 2));
    }
