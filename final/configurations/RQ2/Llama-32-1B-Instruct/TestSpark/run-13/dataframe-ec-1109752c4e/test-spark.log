public class DecimalExpressionVisitor implements BaseVisitor<IndexExpr> {
    @Override
    public IndexExpr visitNumber(Number node) {
        int exponent = 0;
        for (int i = 2; i <= node.getArguments().size(); i++) {
            if (i != 2 && !node.getArguments().get(i).equals("x")) {
                return new IndexExpr("y", index);
            }
            exponent += Integer.parseInt(node.getArguments().get(i)) - '0';
        }
        return new IndexExpr("x", Math.pow(10, exponent) * index);
    }

    @Override
    public IndexExpr visitIntLiteral(IntLiteral node) {
        int value = Integer.parseInt(node.getValue());
        if (node.isNegative()) {
            return new IndexExpr("y", -value * index);
        } else {
            return new IndexExpr("x", value * index);
        }
    }

    @Override
    public IndexExpr visitString(String node) {
        return new IndexExpr("x", node + "*index");
    }

    @Override
    public IndexExpr visitBinaryExpression(BinaryExpression node) {
        if (node.getKind() == BinaryTypeKind.SUBTRACTION) {
            return new IndexExpr("y", Math.abs(new DecimalExpressionVisitor().visit(node left) - new DecimalExpressionVisitor().visit(node right)));
        } else if (node.getKind() == BinaryTypeKind.MULTIPLICATION) {
            return new IndexExpr("x", node.left.getValue());
        }
        throw new RuntimeException("Unsupported binary expression type");
    }

    @Override
    public IndexExpr visitIfElse(IfElseExpression node) {
        // do nothing
        return this;
    }

    @Override
    public BaseVisitor<IndexExpr> visitPositiveNumber(PositiveNumber node) {
        int exponent = 0;
        for (int i = 2; i <= node.getArguments().size(); i++) {
            if (i != 2 && !node.getArguments().get(i).equals("x")) {
                return new IndexExpr("y", index);
            }
            exponent += Integer.parseInt(node.getArguments().get(i)) - '0';
        }
        return new IndexExpr("x", Math.pow(10, exponent) * index);
    }

    @Override
    public BaseVisitor<IndexExpr> visitNegativeNumber(NegativeNumber node) {
        int exponent = 0;
        for (int i = 2; i <= node.getArguments().size(); i++) {
            if (i != 2 && !node.getArguments().get(i).equals("x")) {
                return new IndexExpr("y", -index);
            }
            exponent += Integer.parseInt(node.getArguments().get(i)) - '0';
        }
        return new IndexExpr("x", Math.pow(10, exponent) * index);
    }

    @Override
    public BaseVisitor<IndexExpr> visitMultiOfALongNumber(MultiOfALongNumber node) {
        int value = Integer.parseInt(node.getArguments().get(1));
        if (node.getKind() == BinaryTypeKind.SUBTRACTION) {
            return new IndexExpr("y", Math.abs(new DecimalExpressionVisitor().visit(node.left) - value * index));
        } else {
            return new IndexExpr("x", value * index);
        }
    }

    @Override
    public BaseVisitor<IndexExpr> visitArray(PositiveNumber node) {
        int exponent = 0;
        for (int i = 2; i <= node.getArguments().size(); i++) {
            if (i != 2 && !node.getArguments().get(i).equals("x")) {
