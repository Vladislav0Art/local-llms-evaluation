import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class HtmlParser {
    public static void main(String[] args) {
        String html = "<html><head></head><body>Hello, World!</body></html>";
        
        // Test 1: Parsing HTML with Jsoup
        Document document = parse(html);
        System.out.println("Title: " + document.title());
        System.out.println("Body: " + document.body().text());

        // Test 2: Parsing HTML with regular expressions
        String titleRegex = "<title>(.*?)</title>";
        Pattern pattern = Pattern.compile(titleRegex);
        Matcher matcher = pattern.matcher(html);
        if (matcher.find()) {
            System.out.println("Title: " + matcher.group(1).trim());
        } else {
            System.out.println("No title found.");
        }

        String textRegex = "<p>(.*?)</p>";
        pattern = Pattern.compile(textRegex);
        Matcher matcher = pattern.matcher(html);
        if (matcher.find()) {
            System.out.println("Text: " + matcher.group(1).trim());
        } else {
            System.out.println("No text found.");
        }

        // Test 3
        html = "<p>This is a paragraph of text.</p>";
        System.out.println("Title: " + extractTitle(html));
        System.out.println("Text: " + extractText(html));

        // Test 4
        html = "<h1>Hello, World!</h1><p>This is another paragraph.</p>";
        System.out.println("Title: " + extractTitle(html));
    }

    public static Document parse(String htmlString) {
        return Jsoup.parse(htmlString);
    }

    public static String extractTitle(String htmlString) {
        Pattern titlePattern = Pattern.compile("<title>(.*?)</title>");
        Matcher matcher = titlePattern.matcher(htmlString);
        if (matcher.find()) {
            return matcher.group(1).trim();
        } else {
            return null;
        }
    }

    public static String extractText(String htmlString) {
        Pattern textPattern = Pattern.compile("<p>(.*?)</p>", Pattern.DOTALL);
        Matcher matcher = textPattern.matcher(htmlString);
        if (matcher.find()) {
            return matcher.group(1).trim();
        } else {
            return null;
        }
    }

    public static String extractTitleAndText(String htmlString) {
        Document document = parse(htmlString);
        return document.title() + "\n" + document.body().text();
    }
}
