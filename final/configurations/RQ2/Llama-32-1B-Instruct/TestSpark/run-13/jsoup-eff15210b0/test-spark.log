import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;

public class ResponseTest {

    public static String getFirstElement(String message) {
        Document document = Jsoup.parse(message);
        Element element = document.body().first();
        return element.text();
    }

    public static void main(String[] args) {
        String responseMessage = "<html><body>Hello, World!</body></html>";
        System.out.println(getFirstElement(responseMessage));

        String cookieResponse = "Cookie: test = \"value\";";
        String responseBody = getResponseBody(cookieResponse);
        System.out.println(responseBody);

        Response firstCookie = new Response("Cookie: test = \"value\";");
        System.out.println(firstCookie.toString());
    }

    public static class Response {
        private CookieStore element;

        public Response(CookieStore element) {
            this.element = element;
        }

        @Override
        public String toString() {
            return "Response{" +
                    "element=" + element +
                    '}';
        }
    }

    public static class CookieStore {
        private String responseBody;

        public CookieStore(String responseBody) {
            this.responseBody = responseBody;
        }

        public String getResponseBody() {
            return responseBody;
        }
    }

    public static void main(String[] args) {
        ConnectionResponse connectionResponse = new Response(response("Hello, World!"));
        System.out.println(connectionResponse.toString());

        String cookieResponse = response("Cookie: test = \"value\";");
        System.out.println(cookieResponse);
    }
}
