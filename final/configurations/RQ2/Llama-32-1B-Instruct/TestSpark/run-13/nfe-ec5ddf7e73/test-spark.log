    public void testCodigoInterno() {
        carro = CreateCarro.createCarro("123", "ABC123", 1.5, 1000.0, 50.0, 10.0);
        assertEquals(carro.getCodigoInterno(), "123");
    }

    @Test
    public void testPlaca() {
        carro = CreateCarro.createCarro("123", "ABC123", 1.5, 1000.0, 50.0, 10.0);
        assertEquals(carro.getPlaca(), "ABC123");
    }

    @Test
    public void testRenavam() {
        carro = CreateCarro.createCarro("123", "ABC123", 1.5, 1000.0, 50.0, 10.0);
        assertEquals(carro.getRenavam(), 1.5);
    }

    @Test
    public void testTara() {
        carro = CreateCarro.createCarro("123", "ABC123", 1.5, 1000.0, 50.0, 10.0);
        assertEquals(carro.getTara(), 1000.0);
    }

    @Test
    public void testCapacidadeKG() {
        carro = CreateCarro.createCarro("123", "ABC123", 1.5, 1000.0, 50.0, 10.0);
        assertEquals(carro.getCapacidadeKG(), 50.0);
    }

    @Test
    public void testCapacidadeM3() {
        carro = CreateCarro.createCarro("123", "ABC123", 1.5, 1000.0, 50.0, 10.0);
        assertEquals(carro.getCapacidadeM3(), 10.0);
    }

    @Test
    public void testInit() {
        carro = CreateCarro.createCarro("123", "ABC123", 1.5, 1000.0, 50.0, 10.0);
        assertEquals(carro.getCodigoInterno(), "123");
        assertEquals(carro.getPlaca(), "ABC123");
        assertEquals(carro.getRenavam(), 1.5);
        assertEquals(carro.getTara(), 1000.0);
        assertEquals(carro.getCapacidadeKG(), 50.0);
        assertEquals(carro.getCapacidadeM3(), 10.0);
    }

