class Carro {
    String codigoInterno;
    String placa;
    int renavam;
    int tara;
    double capacidadeKG;
    double capacidadeM3;

    public void setCodigoInterno(String códigoInterno) {
        this.codigoInterno = códigoInterno;
    }

    public void setPlaca(String placa) {
        this.placa = placa;
    }

    public void setRenavam(int renavam) {
        this.renavam = renavam;
    }

    public void setTara(int tara) {
        this.tara = tara;
    }

    public void setCapacidadeKG(double capacidadeKG) {
        this.capacidadeKG = capacidadeKG;
    }

    public void setCapacidadeM3(double capacidadeM3) {
        this.capacidadeM3 = capacidadeM3;
    }

    public String getCodigoInterno() {
        return codigoInterno;
    }

    public String getPlaca() {
        return placa;
    }

    public int getRenavam() {
        return renavam;
    }

    public int getTara() {
        return tara;
    }

    public double getCapacidadeKG() {
        return capacidadeKG;
    }

    public double getCapacidadeM3() {
        return capacidadeM3;
    }
}

