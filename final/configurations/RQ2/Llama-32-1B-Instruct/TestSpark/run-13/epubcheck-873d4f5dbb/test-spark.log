```java
import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.text.PDFTextStripper;

/**
 * A utility class for checking the contents of Portable Document Format (PDF) files.
 */
public class OPFChecker {

    /**
     * Checks if a PDF file contains only one type of media content.
     *
     * @param file The name of the PDF file to check.
     * @return A string describing the media type, or an error message if the file is not valid.
     */
    public static String checkOPF(String file) {
        try (PDDocument doc = new PDDocument()) {
            // Create a PDFTextStripper object to extract text from the document
            PDFTextStripper stripper = new PDFTextStripper();
            
            // Set the window of the stripper to match the area of the input file
            stripper.setWindow(file);
            
            // Return the extracted text as a string
            return stripper.getText(doc);
        } catch (Exception e) {
            // Throw an exception if any error occurs during processing
            throw new RuntimeException(e);
        }
    }

    /**
     * Checks if a PDF file contains only images or audio/mpeg media types.
     *
     * @param file The name of the PDF file to check.
     * @param type The specific media type to look for (e.g. "image/jpeg", "audio/mpeg").
     * @return A string describing the media type, or an error message if the file is not valid.
     */
    public static String checkOPF(String file, int type) throws Exception {
        try (PDDocument doc = new PDDocument()) {
            // Create a PDFTextStripper object to extract text from the document
            PDFTextStripper stripper = new PDFTextStripper();
            
            // Check if the file starts with a valid media type header
            if (!file.startsWith("application/") && !file.startsWith("image/")) {
                throw new RuntimeException(file);
            }
            
            // Extract the content of the document and check its contents
            String content = stripper.getText(doc);
            
            // Return a string describing the media type, or an error message if not found
            if (!content.contains(type)) {
                return "Not a valid media type";
            } else if (type.equals("image/jpeg") || type.equals("image/png") || type.equals("audio/mpeg")) {
                return "It's an image or audio file.";
            } else {
                return content;
            }
        } catch (Exception e) {
            // Throw an exception if any error occurs during processing
            throw new RuntimeException(e);
        }
    }

    /**
     * The main method for testing the OPFChecker class.
     *
     * @param args Command-line arguments (not used).
     */
    public static void main(String[] args) throws Exception {
        System.out.println(checkOPF("file1.pdf", 8));
        System.out.println(checkOPF("file2.jpg", "image/jpeg"));
        System.out.println(checkOPF("file3.mp4", "audio/mpeg"));
    }
}
```

To compile and run this code, you will need to have the `junit` library included in your project. You can do this by adding the following dependency to your `pom.xml` file (if you're using Maven) or your `build.gradle` file (if you're using Gradle):

Maven:

