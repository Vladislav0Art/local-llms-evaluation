import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.text.PDFTextStripper;

public class OPFChecker {
    public static String checkOPF(String file) {
        try (PDDocument doc = new PDDocument()) {
            PDFTextStripper stripper = new PDFTextStripper();
            stripper.setWindow(file);
            return stripper.getText(doc);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    public static String checkOPF(String file, int type) throws Exception {
        try (PDDocument doc = new PDDocument()) {
            PDFTextStripper stripper = new PDFTextStripper();
            if (!file.startsWith("application/") && !file.startsWith("image/")) {
                throw new RuntimeException(file);
            }
            String content = stripper.getText(doc);
            if (!content.contains(type)) {
                return "Not a valid media type";
            } else if (type.equals("image/jpeg") || type.equals("image/png") || type.equals("audio/mpeg")) {
                return "It's an image or audio file.";
            } else {
                return content;
            }
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

