class Request {
    private String uri;
    private String method;
    private String body;

    public Request(String uri, String method, String body) {
        this.uri = uri;
        this.method = method;
        this.body = body;
    }

    public String getUri() {
        return uri;
    }

    public String getMethod() {
        return method;
    }

    public String.getBody() {
        return body;
    }
}

