    public static int[] convertIntArray(int[] array) {
        return Arrays.stream(array).mapToInt(Integer::intValue).toArray();
    }
}
```

#### `URIUtil.java`

```java
import java.net.URI;
import java.util.List;

public class URIUtil {
    public static String getUri(URI uri) {
        return uri.toString();
    }

    public static List<String> listPaths(List<URI> uris) {
        return uris.stream().map(uri -> uri.getPath()).collect(Collectors.toList());
    }
}
```

#### `HttpMethodUtil.java`

```java
import java.util.Arrays;

public class HttpMethodUtil {
    public static Request postRequest(Request request) {
        URI uri = new URI(request.getUri());
        String[] methods = {"GET", "POST"};
        return new Request(uri, methods[1], request.getBody().toString());
    }
}
```

### Example Use Case

```java
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

public class MainTestUtilsTest {
    @Test
    public void testGetString() {
        String s = "Hello World";
        System.out.println(StringConverter.printString(s));
    }

    @Test
    public void testGetUri() {
