public class TestSpark {

    public static void insertTable(String[] data) {
        // Generate table schema
        String tableSchema = "CREATE TABLE users (id INT PRIMARY KEY, name VARCHAR(255), age INT);";

        // Insert data into the table
        System.out.println("Inserting data into the 'users' table:");
        for (String row : data) {
            String[] columns = {"name", "age"};
            String[] values = new String[columns.length];
            for (int i = 0; i < columns.length; i++) {
                if (row != null && row.length > i) {
                    values[i] = row[i];
                } else {
                    values[i] = "NULL";
                }
            }
            String insertQuery = "INSERT INTO users (" + String.join(", ", columns) + ") VALUES (" + String.join(", ", values) + ");";
            System.out.println(insertQuery);
        }
    }

    public static void query(String[] column1, String[] column2) {
        // Generate test data for columns
        String tableSchema = "CREATE TABLE users (id INT PRIMARY KEY, name VARCHAR(255), age INT);";

        // Insert data into the 'users' table
        System.out.println("Inserting data into the 'users' table:");
        insertTable(new String[][]{
                {"John", "Doe", 30},
                {"Alice", "Smith", 25},
                {"Bob", "Johnson", 40}
        });

        // Fetch and print results from the database
        System.out.println("Querying the database for 'name' and 'age':");
        TestSpark.query(new String[]{"name", "age"}, new String[]{"name", "age"});
    }

    public static void query(String column1, String[] column2) {
        // Generate test data for columns
        String tableSchema = "CREATE TABLE users (id INT PRIMARY KEY, name VARCHAR(255), age INT);";

        // Insert data into the 'users' table
        System.out.println("Inserting data into the 'users' table:");
        insertTable(new String[][]{
                {"John", "Doe", 30},
                {"Alice", "Smith", 25},
                {"Bob", "Johnson", 40}
        });

        // Fetch and print results from the database
        System.out.println("Querying the database for 'name' and 'age':");
        TestSpark.query(new String[]{"name", "age"}, null);
    }
}

public class Main {
    public static void main(String[] args) {
        TestSpark.testQuery(new String[]{"name", "age"}, new String[]{"name", "age"});
        TestSpark.testQuery(null, new String[]{"name", "age"});
    }
}
