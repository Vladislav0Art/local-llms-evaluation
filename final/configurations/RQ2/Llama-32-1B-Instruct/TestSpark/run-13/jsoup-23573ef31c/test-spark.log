import java.io.IOException;
import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;

public class DocumentTest {

    private Document document;

    @Before
    public void setup() {
        String baseUri = "http://example.com";
        document = new Document(baseUri);
    }

    public String createShell(String baseUri) {
        Element shellElement = document.createElement("link");
        shellElement.attr("rel", "stylesheet");
        shellElement.attr("type", "text/css");
        shellElement.attr("href", baseUri + "/styles.css");
        return document.appendStyleSheet(shellElement);
    }

    public Connection connection() {
        return document.connection();
    }

    public Element head() {
        return document.head();
    }

    public List<FormElement> forms() {
        return document.forms();
    }

    public void testCreateShell() {
        String baseUri = "http://example.com";
        String shellLocation = createShell(baseUri);
        assertEquals(baseUri, shellLocation);
    }

    public void testConnection() {
        Connection connection = connection();
        assertNotNull(connection);
        assertEquals("http://example.com", connection.getUri());
    }

    public void testTitle() {
        String title = "My Title";
        document.title(title);
        assertEquals(title, document.title().toString());
    }

    public void testHead() {
        Element headElement = head();
        if (headElement != null) {
            assertTrue(headElement.isEmpty());
        } else {
            fail("Expected element to be empty");
        }
    }

    public void testBody() {
        List<FormElement> forms = forms();
        assertNotNull(forms);
        assertEquals(2, forms.size());
    }

    public void testExpectForm() {
        String cssQuery = ".my-class";
        Element element = document.expectForm(cssQuery);
        assertNotNull(element);
        assertEquals(".my-class", element.attr("class"));
    }

    public void testTitleWithSpaces() {
        String title = "My Title With Spaces";
        document.title(title);
        assertEquals(title, document.title().toString());
    }

    public void testGetHtml() {
        Element rootElement = head();
        if (rootElement != null) {
            Document documentBuilder = new DocumentBuilder(rootElement);
            String html = documentBuilder.toString();
            System.out.println(html);
        } else {
            fail("Expected element to be present");
        }
    }

    public void testGetCss() {
        Element headElement = head();
        if (headElement != null) {
            String cssString = "body { background-color: #f2f2f2; }";
            document.createStyleSheet().append(cssString);
            Element stylesheetElement = document.createElement("style");
            stylesheetElement.appendChild(document.createStyleSheet().trim().toString());
            rootElement.appendChild(stylesheetElement);
        } else {
            fail("Expected element to be present");
        }
    }

    public void testLink() {
        String linkText = "Click me!";
        Element aElement = document.createElement("a");
        aElement.attr("href", "#");
        aElement.text(linkText);
        aElement.attr("title", "Opens the link in new tab.");
        aElement.attr("target", "_blank");
        element.appendChild(aElement);
        assertEquals(linkText, element.text());
    }

    public void testLinkWithImage() {
        String linkText = "Click me! <img src=\"image.jpg\" alt=\"An image\">";
        Element aElement = document.createElement("a");
        aElement.attr("href", "#");
        aElement.text(linkText);
        aElement.attr("target", "_blank");
        element.appendChild(aElement);
    }

    public void testLinkWithAnchor() {
        String linkText = "Click me! <a href=\"#anchor\">An anchor</a>";
        Element aElement = document.createElement("a");
        aElement.attr("href", "#anchor");
        aElement.text(linkText);
        aElement.attr("target", "_blank");
        element.appendChild(aElement);
    }

    public void testLinkWithClickable() {
        String linkText = "Click me! <button>Click me!</button>";
        Element aElement = document.createElement("a");
        aElement.attr("href", "#");
        aElement.text(linkText);
        aElement.attr("target", "_blank");
        element.appendChild(aElement);
    }

    public void testLinkWithImageAndAnchor() {
        String linkText = "Click me! <img src=\"image.jpg\" alt=\"An image\"><a href=\"#anchor\">An anchor</a>";
        Element aElement = document.createElement("a");
        aElement.attr("href", "#anchor");
        aElement.text(linkText);
        aElement.attr("target", "_blank");
        element.appendChild(aElement);
    }

    public void testLinkWithImageAndClickable() {
        String linkText = "Click me! <button>Click me!</button><img src=\"image.jpg\" alt=\"An image\">";
        Element aElement = document.createElement("a");
        aElement.attr("href", "#");
        aElement.text(linkText);
        aElement.attr("target", "_blank");
        element.appendChild(aElement);
    }
}
