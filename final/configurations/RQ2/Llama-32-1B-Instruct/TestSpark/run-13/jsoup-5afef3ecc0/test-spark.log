        kv.put(key, value);
        setInputUrl(appendKeyVal(kv));
    }

    public String getPublicString() {
        if (inputUrl == null) {
            throw new NullPointerException("Input URL cannot be null");
        }
        return inputUrl;
    }

    public static void main(String[] args) {
