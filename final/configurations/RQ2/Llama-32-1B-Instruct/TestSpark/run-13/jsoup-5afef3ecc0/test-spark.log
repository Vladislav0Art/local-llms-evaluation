```java
import java.util.HashMap;
import java.util.Map;

public class UrlBuilder {
    private String inputUrl;

    public void setInputUrl(String url) {
        if (url == null || !url.startsWith("http://") && !url.startsWith("https://")) {
            throw new NullPointerException("Input URL must be a valid URL");
        }
        this.inputUrl = url;
    }

    public Map<String, String> appendKeyVal() {
        Map<String, String> kv = new HashMap<>();
        return inputUrl != null ? new HashMap<>(inputUrl.split("&")) : null;
    }

    public void appendKeyVal(String key, String value) {
        if (key == null || value == null) {
            throw new NullPointerException("Both key and value must be provided");
        }
        Map<String, String> kv = appendKeyVal();
        kv.put(key, value);
        setInputUrl(inputUrl + "?" + appendKeyVal().toString());
    }

    public void printInputUrl() {
        if (inputUrl != null) {
            System.out.println("Input URL: " + inputUrl);
        } else {
            System.out.println("No input URL provided");
        }
    }
}

public class Main {
    public static void main(String[] args) {
        UrlBuilder urlBuilder = new UrlBuilder();

        // Example tests
        String inputUrl1 = "https://example.com/path";
        urlBuilder.setInputUrl(inputUrl1);
        System.out.println("Initial URL: " + urlBuilder.getPublicString());

        Map<String, String> kv1 = null;
        urlBuilder.appendKeyVal();
        System.out.println(urlBuilder.getPublicString());  // Output: https://example.com?

        String inputUrl2 = "invalid_url";
        urlBuilder.setInputUrl(inputUrl2);
        System.out.println("Input URL updated to: " + urlBuilder.getPublicString());

        kv1 = new HashMap<>();
        kv1.put("key", "value");
        urlBuilder.appendKeyVal();
        System.out.println("Updated Map: " + urlBuilder.getPublicString());
    }
}
```

