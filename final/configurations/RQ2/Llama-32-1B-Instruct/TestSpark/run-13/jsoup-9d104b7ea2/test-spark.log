		private String generateHtml(String input) {
		StringBuilder builder = new StringBuilder();
		if (input.contains("<!")) {
		builder.append("<head>").append("\n");
		for (int i = 1; i < input.length(); i++) {
		if (!Character.isWhitespace(input.charAt(i))) {
