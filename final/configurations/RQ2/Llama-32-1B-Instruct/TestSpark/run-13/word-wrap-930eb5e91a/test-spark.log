        Preconditions.checkState(!fromClasspathUtf8("test.txt").isPresent());
        Preconditions.checkState(fromClasspath("test.txt", StandardCharsets.UTF_8).isPresent());

        Builder builder = from(new InputStreamReader(System.in));
