```java
import java.time.LocalDate;
import java.util.Random;

public class GeneratedTest {

    public static LocalDate generateRandomDate(int year, int month, int day) {
        Random rand = new Random();
        return LocalDate.of(year, month, day);
    }

    public static void main(String[] args) {
        for (int i = 0; i < 100; i++) {
            System.out.println(generateRandomDate(2022 + i, getMonthName(i), generateRandomNumberBetween1And31()));
        }
    }

    private static String getMonthName(int month) {
        switch (month) {
            case 0:
                return "January";
            case 1:
                return "February";
            case 2:
                return "March";
            case 3:
                return "April";
            case 4:
                return "May";
            case 5:
                return "June";
            case 6:
                return "July";
            case 7:
                return "August";
            case 8:
                return "September";
            case 9:
                return "October";
            case 10:
                return "November";
            default:
                throw new IllegalArgumentException("Invalid month");
        }
    }

    private static int generateRandomNumberBetween1And31() {
        Random rand = new Random();
        return rand.nextInt(30) + 1;
    }
}
```

This code generates random dates between January and December for the next 100 years. The `getMonthName` method is used to get the name of the month from its number, and the `generateRandomNumberBetween1And31` method is used to generate a random day between 1 and 31.

Please note that this code will print out 100 random dates, one for each year in the range specified.
