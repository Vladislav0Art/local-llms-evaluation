        // Test August
        assert (estimate >= forDate(2022, 8, 23).getDayOfMonth() + 19) : "August plus nineteen days should be September 1st";

        // Test September
        assert (estimate >= forDate(2022, 9, 1).getDayOfMonth()) : "September plus one day before the estimated day";

        // Test October
        assert (estimate >= forDate(2022, 10, 31).getDayOfMonth() + 16) : "October plus sixteen days should be November 17th";

        // Test November
        assert (estimate >= forDate(2022, 11, 8).getDayOfMonth()) : "November plus eight days before the estimated day";

        // Test December
        assert (estimate >= forDate(2022, 12, 15).getDayOfMonth() + 18) : "December plus eighteen days should be January 1st";
    }

    public static void main(String[] args) throws Exception {
        testEstimate();
    }
}
