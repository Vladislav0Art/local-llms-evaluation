public class URLUtils {
    public static String getAuthority(String scheme, String path) {
        return scheme + "://" + path;
    }

    public static void testGetAuthority_Scheme() {
        // Test case 1
        assertEquals("http://", getAuthority("http", "/"));
        assertEquals("https://", getAuthority("https", "/"));
        assertEquals("ftp://", getAuthority("ftp", "/"));

        // Test case 2
        assertEquals("ssh://", getAuthority("ssh", "/"));
        assertEquals("sftp://", getAuthority("sftp", "/"));
    }

    public static void testGetAuthority_Scheme_with_trailing_slash() {
