import javax.xml.parsers.DocumentBuilderFactory;
import javax.xml.parsers.DocumentBuilder;

public class HTMLElement {
    private String name;
    private Document document;

    public HTMLElement(String name, Document document) {
        super(name);
        this.document = document;
    }

    public void setAttribute(String key, String value) {
        if (document == null || !document.getDocumentElement().getTagName().equals(name)) throw new RuntimeException("Invalid element tag");
        document.setAttribute(key, value);
    }
}

public class HTMLTest {
    public static void main(String[] args) throws Exception {
        Document doc = createDocument();
        System.out.println(doc.documentElement); // prints: <html>

        Element head = new HTMLElement("head", doc);
        head.setAttribute("lang", "en");
        head.setAttribute("dir", "ltr");

        System.out.println(head); // prints: <head lang="en" dir="ltr">

        HTMLTest.test(doc, head);

        String text = "Hello World!";
        Appendable appendable = new Appendable(text);
