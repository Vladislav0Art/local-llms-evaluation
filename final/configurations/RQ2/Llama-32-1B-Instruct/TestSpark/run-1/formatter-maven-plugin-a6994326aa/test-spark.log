        String result = cssFormatter.doFormat("/* This is a CSS code */", LineEnding.INSERT);
        assertEquals("linear-gradient(90deg, linear-gradient(to right, red, blue), red)", result);
    }

    @Test
    public void testDoFormat_MultipleSelectors() {
