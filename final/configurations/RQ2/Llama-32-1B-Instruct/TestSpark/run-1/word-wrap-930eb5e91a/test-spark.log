public class WordWrapTest {
    @Test
    public void testWordWrap() throws IOException {
        // Arrange
        BufferedReader reader = new BufferedReader(new InputStreamReader(System.in));
        String input = "Lorem ipsum dolor sit amet, consectetur adipiscing elit.";
        Reader in = new LineReader(reader);
        Writer out = new StringWriter();
        int maxWidth = 10;

        // Act
        WordWrap wordWrap = new WordWrap();
        wordWrap.wordWrap(in, out, "\n", maxWidth, null, HashSet.of(' ', '\n'), true, false);

        // Assert
        assertEquals(input, out.toString().trim());
    }

