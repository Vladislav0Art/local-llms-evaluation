import com.fasterxml.jackson.databind.ObjectMapper;
import org.junit.Test;

public class Main {

    private ObjectMapper mapper = new ObjectMapper();

    @Test
    public void testGetUser() {
        String json = "{\"user\":\"John Doe\"}";
        String response = mapper.writeValueAsString(new User(json));
        assertEquals("Hello, World!", response);
    }

    @Test
    public void testGetUsers() {
        String json = "{\"users\":[{\"id\":1,\"name\":\"Alice Doe\"}]}";
        String response = mapper.writeValueAsString(new Users(json));
        System.out.println(response);
        assertEquals("{\"users\":[{\"id\":1,\"name\":\"Alice Doe\"}]", response);
    }

    @Test
    public void testPostUser() {
        User user = new User("John Doe");
        String json = mapper.writeValueAsString(user);
        String response = mapper.writeValueAsString(new Users(json));
        System.out.println(response);
        assertEquals("Hello, World!", response);
    }
}

class User {
    private String name;

    public User(String name) {
        this.name = name;
    }

    @Override
    public String toString() {
        return "name=" + name;
    }
}

class Users {
    private List<User> users;

    public Users(String json) {
        ObjectMapper mapper = new ObjectMapper();
        User user = mapper.readValue(json, User.class);
        this.users = Arrays.asList(user);
    }

    @Override
    public String toString() {
        return users.toString();
    }
}
