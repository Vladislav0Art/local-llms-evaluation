public class HttpConnectionTest {

    @Test
    public void testConnect() {
        MockHttpConnection mock = new MockHttpConnection();
        Connection actual = org.jsoup.helper.HttpConnection.connect(mock.url("http://www.example.com"));
        assertEquals(actual, mock);
    }

    @Test
    public void testConnectToNonExistentUrl() {
        MockHttpConnection mock = new MockHttpConnection();
        try {
            org.jsoup.helper.HttpConnection.connect(mock.url(null));
            fail("Expected IOException");
        } catch (IOException e) {
            // expected
        }
    }

    @Test
    public void testNewRequest() {
        MockHttpConnection mock = new MockHttpConnection();
        Request actual = org.jsoup.helper.HttpConnection.newRequest();
        assertEquals(actual, mock);
    }

