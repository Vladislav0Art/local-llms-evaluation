    public void normaliseWhitespace() {
        String text = "   Hello   ";
        StringBuilder expectedNormalisedWhitespace = new StringBuilder();
        for (int i = 0; i < text.length(); i++) {
            if (i == 0) {
                expectedNormalisedWhitespace.append(text.charAt(i));
            } else {
                if (text.charAt(i) != ' ') {
                    expectedNormalisedWhitespace.append(text.charAt(i));
                }
            }
        }
        assertEquals(expectedNormalisedWhitespace.toString(), normaliseWhitespace(text));
    }

    @Test
    public void stripLeadingWhitespace() {
        String text = "   Hello World  ";
        StringBuilder expectedStripLeadingWhitespace = new StringBuilder();
        for (int i = 0; i < text.length(); i++) {
            if (i == 0) {
                expectedStripLeadingWhitespace.append(text.charAt(i));
