public class TextNodeTest {

    @Test
    public void nodeName() {
        TextNode node = new TextNode("Hello World");
        assertEquals("TextNode", node.nodeName());
    }

    @Test
    public void text() {
        TextNode node = new TextNode("Hello World");
        String text = node.text();
        assertNotNull(text);
        assertEquals("Hello World", text);
    }

    @Test
    public void text(String text) {
        TextNode node = new TextNode("Hello World");
        node.text(text);
        assertEquals(text, node.text());
    }

    @Test
    public void getWholeText() {
        TextNode node = new TextNode("Hello World");
        String wholeText = node.getWholeText();
        assertNotNull(wholeText);
        assertEquals("Hello World", wholeText);
    }

    @Test
    public void isBlank() {
        TextNode node = new TextNode("   Hello ");
        assertTrue(node.isBlank());
    }

    @Test
    public void splitText(int offset) {
        TextNode node = new TextNode("Hello World");
        String text = node.splitText(2);
        assertNotNull(text);
        assertEquals("World", text);
    }

    @Test
    public void outerHtmlHead() {
        Appendable accum = new StringBuilder();
        Document doc = new Document();
        // Create a sample document with an empty head
        documentOutputSettings(doc, accum);
        outerHtmlHead(accum, 0, documentOutputSettings(doc, accum));
        String expectedOuterHtmlHead = "<head></head>";
        assertEquals(expectedOuterHtmlHead, accum.toString());
    }

    @Test
    public void outerHtmlTail() {
        Appendable accum = new StringBuilder();
        Document doc = new Document();
        // Create a sample document with an empty head and tail
        append(accum, "", 0);
        outerHtmlTail(accum, 1, documentOutputSettings(doc, accum));
        String expectedOuterHtmlTail = "</head></body>";
        assertEquals(expectedOuterHtmlTail, accum.toString());
    }

    @Test
    public void toString() {
        TextNode node = new TextNode("Hello World");
        String expectedToString = "Hello World";
        assertEquals(expectedToString, node.toString());
    }

    @Test
    public void clone() {
        TextNode original = new TextNode("Hello World");
        TextNode cloned = (TextNode) original.clone();
        assertNotNull(cloned);
        assertEquals(original, cloned);
    }

    @Test
    public void createFromEncoded(String encodedText) {
        TextNode node = TextNode.createFromEncoded(encodedText);
        assertNotNull(node);
        assertEquals("Hello World", node.text());
    }

    @Test
    public void normaliseWhitespace() {
        String text = "   Hello   ";
        StringBuilder expectedNormalisedWhitespace = new StringBuilder();
        for (char c : text.toCharArray()) {
            if (c != ' ') {
                expectedNormalisedWhitespace.append(c);
            }
        }
        assertEquals(expectedNormalisedWhitespace.toString(), normaliseWhitespace(text));
    }

    @Test
    public void stripLeadingWhitespace() {
        String text = "   Hello World  ";
        StringBuilder expectedStripLeadingWhitespace = new StringBuilder();
        for (int i = 0; i < text.length(); i++) {
            if (i == 0) {
                expectedStripLeadingWhitespace.append(text.charAt(i));
            } else {
                if (text.charAt(i) != ' ') {
                    expectedStripLeadingWhitespace.append(text.charAt(i));
                }
            }
        }
        assertEquals(expectedStripLeadingWhitespace.toString(), stripLeadingWhitespace(text));
    }

    @Test
    public void lastCharIsWhitespace() {
        StringBuilder expectedLastCharIsWhitespace = new StringBuilder();
        for (int i = 0; i < 10; i++) {
            if (i % 2 == 0) {
                expectedLastCharIsWhitespace.append(' ');
            } else {
                expectedLastCharIsWhitespace.append('\n');
            }
        }
        assertEquals(expectedLastCharIsWhitespace.toString(), lastCharIsWhitespace(new StringBuilder("Hello World")));
    }

}
