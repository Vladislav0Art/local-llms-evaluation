    }

    private String generateRandomString(int seed, int length) {
        StringBuilder sb = new StringBuilder(length);
        for (int i = 0; i < length; i++) {
            char c = (char) ('a' + rand.nextInt(26));
            while (sb.charAt(i) == c) {
                sb.setCharAt(i, (char) ('a' + rand.nextInt(26)));
