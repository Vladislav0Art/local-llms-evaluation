    }
}

class MyUtil {

    public String getMethod1(MyClass obj, int a, int b) {
        Random rand = new Random();
        return Integer.toString(obj.testPublicMethod() + a * b);
    }

    public Object[] getMethod2(MyClass obj) {
        String message = "Test";
        if (obj.testPublicMethod() == 42 && message.equals("Test")) {
            int seed = System.currentTimeMillis();
            String newMessage = generateRandomString(seed, 16);
