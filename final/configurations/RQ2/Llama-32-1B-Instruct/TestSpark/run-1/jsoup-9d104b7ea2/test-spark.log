import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;

public class DocumentTest {

    public static void main(String[] args) {
        String html = "<html><body>Hello World!</body></html>";
        Document document = Jsoup.parse(html);
        System.out.println(document.outerHtml());
    }

    public static String testTextAppend(String text) {
        return document.append(text).toString();
    }

    public static boolean testTextContains(String expected, String text) {
        return document.text().contains(expected);
    }

    public static void testTextEquals(String expected, String text) {
        if (text.equals(expected)) {
            System.out.println("Test passed");
        } else {
            System.out.println("Test failed");
        }
    }

    public static String testTextTail(String expected, String text) {
        return document.tail().toString();
    }

    public static String testAppendText(int position, String text) {
        Document document = Jsoup.parse(html);
        Element element = document.body().find("body").first();
        if (element == null) {
            System.out.println("Element found");
        } else {
            element.append(text).toString();
            return String.valueOf(element.outerHtml());
        }
    }

    public static boolean testContainsText(int position, String text) {
        Document document = Jsoup.parse(html);
        Element element = document.body().find("body").first();
        if (element == null) {
            System.out.println("Element found");
        } else {
            return element.text().contains(text);
        }
    }

    public static void testTailText(int position, String text) {
        Document document = Jsoup.parse(html);
        Element element = document.body().find("body").first();
        if (element == null) {
            System.out.println("Element found");
        } else {
            element.tail().toString();
        }
    }

    public static void testGetOuterHtml(String html) {
        Document document = Jsoup.parse(html);
        String outerHtml = document.outerHtml();
        System.out.println(outerHtml);
    }
}
