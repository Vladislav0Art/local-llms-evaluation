import java.io.File;
import java.lang.reflect.Method;

public class Example {
    public static boolean isFontType(String type) {
        return type.equals("font") || type.equals("script");
    }

    public static void main(String[] args) throws Exception {
        System.out.println(isFontType("font"));  // Outputs: true
        System.out.println(isFontType("script"));  // Outputs: true

        String font = Example.class.getResource("/example-font.woff2").toString();
        if (isFontType(font)) {
            System.out.println("The font is font type");
        } else {
            System.out.println("The font is not a font type");
        }

        File file = new File("/home/user/example.txt");
        if (file.exists() && file.isFile()) {
            System.out.println("The file exists and is a file");
        } else {
            System.out.println("The file does not exist or is not a file");
        }
    }
}
```

