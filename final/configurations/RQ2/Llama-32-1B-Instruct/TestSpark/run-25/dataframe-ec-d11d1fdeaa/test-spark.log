import java.util.ArrayList;
import java.util.List;

public class Main {
    public static void main(String[] args) {
        // Create a new DataFrame with two columns: 'Name' and 'Age'
        DataFrame df = new DataFrame("People", new ArrayList<>());

        // Add the columns to the DataFrame
        df.addColumn(new DataColumn("Name", "String"));
        df.addColumn(new DataColumn("Age", "Int"));

        // Print the initial DataFrame
        System.out.println(df);

        // Add a row with sample data
        DataRow newRow = new DataRow();
        newRow.setName("John");
        newRow.addColumn(new DataColumn("Age", 25));
        df.addRow(newRow);

        // Join another DataFrame (People) on the 'Name' column
        DataJoin joinDescriptor = new DataJoin("People");
        joinDescriptor.setJoinDescriptors(new String[]{"Name", "Age"});

        DataFrame joinedDf = df.join(joinDescriptor);

        // Print the joined DataFrame
        System.out.println(joinedDf);
    }
}

