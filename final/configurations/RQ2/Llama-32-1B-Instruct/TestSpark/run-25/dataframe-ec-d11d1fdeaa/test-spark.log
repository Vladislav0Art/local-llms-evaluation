import java.util.ArrayList;
import java.util.List;

public class DataFrameExample {
    public static void main(String[] args) {
        // Create two empty DataFrames with 'Name' and 'Age' as columns
        DataFrame df1 = new DataFrame("People", new ArrayList<>());
        DataFrame df2 = new DataFrame("Fruits", new ArrayList<>());

        System.out.println("DataFrame 1:");
        System.out.println(df1);

        System.out.println("\nDataFrame 2:");
        System.out.println(df2);

        // Add columns to the first DataFrame
        df1.addColumn(new DataColumn("Color", "String"));
        df1.addColumn(new DataColumn("Weight", "Double"));

        System.out.println("\nDataFrame 1 after adding columns:");
        System.out.println(df1);

        // Add a row with sample data
        DataRow newRow = new DataRow();
        newRow.setName("John");
        newRow.addColumn(new DataColumn("Age", 25));
        newRow.addColumn(new DataColumn("Height", 175.0));
        df1.addRow(newRow);

        System.out.println("\nDataFrame 1 after adding a new row:");
        System.out.println(df1);

        // Join the two DataFrames on the 'Name' column
        DataJoin joinDescriptor = new DataJoin("People");
        joinDescriptor.setJoinDescriptors(new String[]{"Name", "Age"});

        DataFrame joinedDf = df1.join(joinDescriptor);
        System.out.println("\nDataFrame 1 after joining:");
        System.out.println(joinedDf);

        // Filter the 'Fruits' DataFrame where the length of the fruit name is greater than 4
        DataJoin filterDescriptor = new DataJoin("Fruits");
