import java.util.*;

public class Database {
    private Map<String, Map<String, Object>> table = new HashMap<>();

    public void createTable(String tableName) {
        System.out.println("Creating table: " + tableName);
        if (!table.containsKey(tableName)) {
            try (Scanner scanner = new Scanner(System.in)) {
                String[] columns = scanner.nextLine().split(", ");
                for (int i = 0; i < columns.length; i++) {
                    table.put(tableName, new HashMap<>());
                    System.out.println("Enter value for " + columns[i] + ": ");
                    if (!scanner.hasNextLine()) {
                        break;
                    }
                    String[] values = scanner.nextLine().split(",");
                    for (int j = 0; j < values.length; j++) {
                        table.get(tableName).put(columns[j], Integer.parseInt(values[j]));
                    }
                }
            } catch (Exception e) {
                System.out.println(e.getMessage());
            }
        }
    }

    public void insert(String tableName, Object[] values) {
        System.out.println("Inserting into table: " + tableName);
        try (Scanner scanner = new Scanner(System.in)) {
            for (int i = 0; i < values.length; i++) {
                if (values[i] instanceof String) {
                    // convert string to char array
                    char[] charArray = ((String) values[i]).toCharArray();
                    System.out.println("Enter value for " + tableName + "_" + i + ": ");
                    scanner.nextLine();
                    System.out.println(new String(charArray));
                } else {
                    int valueInt = Integer.parseInt((String) values[i]);
                    if (valueInt > 0) {
                        table.get(tableName).put(i, valueInt);
                    }
                }
            }
        } catch (Exception e) {
            System.out.println(e.getMessage());
        }
    }

    public void update(String tableName, Object[] values) {
        System.out.println("Updating in table: " + tableName);
        try (Scanner scanner = new Scanner(System.in)) {
            if (!values.length == 2 && !values[0].equals(tableName)) {
                System.out.println("Error in column count or query.");
            } else {
                for (int i = 0; i < values.length; i++) {
                    if (i + 1 != values.length) {
                        try {
                            String[] columns = scanner.nextLine().split(", ");
                            table.get(tableName).put(columns[i], Integer.parseInt(values[i]));
                        } catch (Exception e) {
                            System.out.println(e.getMessage());
                        }
                    }
                }
            }
        } catch (Exception e) {
            System.out.println(e.getMessage());
        }
    }

    public void delete(String tableName, Object value) {
        System.out.println("Deleting from table: " + tableName);
        try (Scanner scanner = new Scanner(System.in)) {
            if (!value instanceof String && !value.equals(tableName)) {
                System.out.println("Error in column count or query.");
            } else {
                for (Map.Entry<String, Object> entry : table.get(tableName).entrySet()) {
                    if ((int) entry.getValue().equals((Integer) value)) {
                        table.remove(tableName);
                        break;
                    }
                }
            }
        } catch (Exception e) {
            System.out.println(e.getMessage());
        }
    }

    public void select(String tableName, Object[] values) {
        System.out.println("Selecting from table with name: " + tableName);

        try (Scanner scanner = new Scanner(System.in)) {
            if (!values.length == 2 && !values[0].equals(tableName)) {
                System.out.println("Error in column count or query.");
            } else {
                for (int i = 0; i < values.length; i++) {
                    System.out.println("Enter value for key to select: ");
                    String input = scanner.nextLine();
                    if (input.equals(values[i])) {
                        break;
                    }
                }

                String[] results = new String[values.length];
                for (int i = 0; i < values.length; i++) {
                    try {
                        results[i] = table.get(tableName).get((String) values[i]);
                    } catch (Exception e) {
                        System.out.println(e.getMessage());
                    }
                }

                if (results.length == 2) {
                    for (int i = 0; i < results.length; i++) {
                        System.out.println("Name: " + results[i] + ", Email: " + ((String[]) table.get(tableName).get((String) values[1])).length > 1 ? ((String[]) table.get(tableName).get((String) values[1])).length : 0);
                    }
                } else if (results.length == 2) {
                    System.out.println("Name: " + results[0] + ", Email: " + results[1]);
                } else if (results.length > 2 && results.length % 2 == 0) {
                    for (int i = 0; i < results.length - 1; i += 2) {
                        System.out.println("Name: " + results[i] + ", Email: " + ((String[]) table.get(tableName).get((String) values[values.length - 1])).length > 1 ? ((String[]) table.get(tableName).get((String) values[values.length - 1])).length : 0);
                    }
                } else {
                    System.out.println("Invalid number of columns.");
                }
            }
        } catch (Exception e) {
            System.out.println(e.getMessage());
        }
    }

    public static void main(String[] args) {
        Database db = new Database();
        db.createTable("users");
        db.insert("users", new String[]{"name", "email"});
        db.select("users", new Object[]{1, 2});
        db.update("users", new Object[]{"John Doe", "john.doe@example.com"});
        db.delete("users", 2);
        db.select("users", new Object[]{}); // Select from the empty table
    }
}
