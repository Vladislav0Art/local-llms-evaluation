import org.junit.Test;
import static org.hamcrest.MatcherAssert.assertThat;
import static org.hamcrest.Matchers.is;

public class MyServiceTest {

    @Test
    public void testGetResponse() {
        String response = MyService.get("https://jsonplaceholder.typicode.com/posts/1");
        assertThat(response, is("{\"id\":1,\"title\":\"Hello World\",\"body\":\"This is a demo post\"}");
    }

    @Test
    public void testGetResponseWithKeyValues() {
        Map<String, Object> request = new HashMap<>();
        request.put("key", "value");

        String response = MyService.get("https://jsonplaceholder.typicode.com/posts/1");
        assertThat(response, is("{\"key\":\"value\"}");
    }

    @Test
    public void testGetResponseWithMultipleKeys() {
        Map<String, Object> request = new HashMap<>();
        request.put("key1", "value1");
        request.put("key2", "value2");

        String response = MyService.get("https://jsonplaceholder.typicode.com/posts/1");
        assertThat(response, is("{\"key1\":\"value1\",\"key2\":\"value2\"}");
    }

    @Test
    public void testGetResponseWithNullValues() {
        String response = MyService.get("https://jsonplaceholder.typicode.com/posts/1").getOrDefault("null", "default value");
        assertThat(response, is(null));
    }

    @Test
    public void testGetResponseWithEmptyStringValues() {
        String response = MyService.get("https://jsonplaceholder.typicode.com/posts/1").getOrDefault("", "default value");
        assertThat(response, is(""));
    }
}
