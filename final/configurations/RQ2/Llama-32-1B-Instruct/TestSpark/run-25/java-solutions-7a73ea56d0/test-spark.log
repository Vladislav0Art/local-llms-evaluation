        int index = 2;
        for (int i = 3; i < prices.length; i++) {
            if (next(prices[i]) - next(prices[i-1]) == i - 2) {
                span.add(new Span(index, i, next(prices[i])));
                index++;
            }
        }
        return span;
    }

