```java
import static org.junit.Assert.assertEquals;

public class OnlineStockSpan {

    public static int next(int price) {
        return Integer.parseInt(String.valueOf(price));
    }

    public static SpanCalculateMethod calculateSpans(int[] prices) {
        if (prices.length == 0) {
            return null;
        }
        span = new SpanCalculateMethod();
        for (int i = 1; i < prices.length; i++) {
            int nextPrice = next(prices[i]);
            span.add(new Span(i, i + 1, nextPrice));
        }
        return span;
    }

    public static String[] getArraySize(int[] actualSpans) {
        if (actualSpans == null || actualSpans.length == 0) {
            return new String[0];
        }
        int length = actualSpans.length;
        StringBuilder sb = new StringBuilder();
        for (int i = 1; i < length; i++) {
            sb.append(i).append(",");
        }
        return sb.toString().split(",");

    }

    public static void main(String[] args) {

        OnlineStockSpan.SpanCalculateMethod span = calculateSpans(new int[]{10, 20, 30});
        String[] expectedPrices = new String[]{"1,2,3"};
        assertEquals(expectedPrices[0], span.getArraySize(span.actualSpans));

        OnlineStockSpan.SpanCalculateMethod span2 = calculateSpans(new int[]{5,7,8});
        String[] expectedSpans = new String[]{"6", "9", "10"};
        assertEquals(expectedSpans[0], span2.getArraySize(span2.actualSpans));
    }
}
