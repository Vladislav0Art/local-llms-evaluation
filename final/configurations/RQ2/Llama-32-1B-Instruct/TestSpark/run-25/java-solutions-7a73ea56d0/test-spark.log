        if (price < 0) {
            throw new IllegalArgumentException("Price cannot be negative");
        } else if (price == 0) {
            return 0;
        } else {
            return Integer.parseInt(String.valueOf(price));
        }
    }

    public static SpanCalculateMethod calculateSpans(int[] prices) {
        if (prices.length == 0) {
            throw new IllegalArgumentException("Array of stock prices cannot be empty");
        }
