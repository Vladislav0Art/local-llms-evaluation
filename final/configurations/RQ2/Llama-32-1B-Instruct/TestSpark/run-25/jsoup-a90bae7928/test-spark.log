public class XmlTreeBuilderTest {
    @Mock
    private Token CommentToken;

    @Mock
    private Token CharacterToken;
    @Mock
    private Token DoctypeD;

    @InjectMocks
    private XmlTreeBuilder xmlTreeBuilder;

    public void testParseElement() throws Exception {
        // Arrange
        Document document = new Document();
        CDataNode cdataNode = new CDataNode("test");
        Element element = new Element(document, "test");

        // Act
        String result = xmlTreeBuilder.parse(element, "test");
        
        // Assert
        assertTrue(result.startsWith("<![CDATA["));
    }

    public void testParseComment() throws Exception {
        // Arrange
        Document document = new Document();
        Comment commentNode = new Comment(document, "test");

        // Act
        String result = xmlTreeBuilder.parse(commentNode, "test");
        
        // Assert
        assertTrue(result.startsWith("<!--"));
    }

    public void testParseDocument() throws Exception {
        // Arrange
        Document document = new Document();
        XmlDeclaration xmlDeclaration = new XmlDeclaration("1.0", "UTF-8");

        // Act
        String result = xmlTreeBuilder.parse(document, "test");
        
        // Assert
        assertTrue(result.startsWith("<!DOCTYPE html>"));
    }

    public void testParseFragment() throws Exception {
        // Arrange
        Document document = new Document();
        XmlDeclaration xmlDeclaration = new XmlDeclaration("1.0", "UTF-8");

        // Act
        String result = xmlTreeBuilder.parseFragment("", "test", "test");
        
        // Assert
        assertTrue(result.length() > 10);
    }

    public void testInsertNode() throws Exception {
        // Arrange
        Element element = new Element(new Document(), "test");
        Token token = new Token("new-element");

        // Act
        String result = xmlTreeBuilder.insert(element, token);
        
        // Assert
        assertTrue(result.startsWith("<!DOCTYPE html>"));
    }

    public void testInsertComment() throws Exception {
        // Arrange
        Element element = new Element(new Document(), "test");
        Comment commentNode = new Comment(new Document(), "test");

        // Act
        String result = xmlTreeBuilder.insert(commentNode, commentToken);
        
        // Assert
        assertTrue(result.startsWith("<!--"));
    }

    public void testInsertCharacter() throws Exception {
        // Arrange
        Element element = new Element(new Document(), "test");
        CharacterToken token = new CharacterToken("test");

        // Act
        String result = xmlTreeBuilder.insert(token);
        
        // Assert
        assertTrue(result.startsWith("test"));
    }

    public void testInsertDoctype() throws Exception {
        // Arrange
        Element element = new Element(new Document(), "test");
        Token token = new Token("DOCTYPE");

        // Act
        String result = xmlTreeBuilder.insert(token);

        // Assert
        assertTrue(result.startsWith("<!DOCTYPE html>"));
    }

    public void testProcess() throws Exception {
        // Arrange
        Token token = new Token("test");

        // Act
        boolean result = xmlTreeBuilder.process(token);
        
        // Assert
        assertTrue(result);
    }
}
