        // Arrange
        String input = "";
        Element element = new Element(new Document(), "test");
        Comment commentNode = new Comment(new Document(), "test");

        // Act and Assert
        String result = xmlTreeBuilder.insert(commentNode, commentToken);
        assertEquals("<!--", result.substring(3));
    }

    public void testInsertCharacter() throws Exception {
        // Arrange
        Element element = new Element(new Document(), "test");
        CharacterToken token = new CharacterToken("test");

        // Act and Assert
        String result = xmlTreeBuilder.insert(token);
        assertEquals("test", result.substring(0, 1));
    }

    public void testInsertDoctype() throws Exception {
        // Arrange
        Element element = new Element(new Document(), "test");
        Token token = new Token("DOCTYPE");

        // Act and Assert
        String result = xmlTreeBuilder.insert(token);
        assertEquals("<!DOCTYPE html>", result.substring(3));
    }
}
