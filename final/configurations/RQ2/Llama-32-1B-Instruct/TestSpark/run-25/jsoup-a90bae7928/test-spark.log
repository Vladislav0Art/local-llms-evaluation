        // Act and Assert
        Document document = xmlTreeBuilder.parse(new InputStreamReader(System.in), baseUri, parser);
        assertTrue(document.getNode().getNodeName().equals("test"));
    }

    public void testParseComment() throws Exception {
        // Act and Assert
        String result = xmlTreeBuilder.parse(new CommentToken(), "test");
        assertEquals("<!--", result.substring(3));
    }

    public void testParseDocument() throws Exception {
        // Act and Assert
        Document document = xmlTreeBuilder.parse(new XmlDeclaration("1.0", "UTF-8"), baseUri);
        assertEquals("<!DOCTYPE html>", document.getNode().getNodeName());
    }

    public void testParseFragment() throws Exception {
        // Arrange
        String input = "";
        String baseUri = "";
        Parser parser = new Parser();

