Here's a simple example of how you can solve this problem using Java and HTML parsing libraries such as Jsoup.

```java
import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;

public class Main {

    public static void main(String[] args) {
        String html = "<html><body>Hello, World!</body></html>";
        
        Document expectedDoc = new Document();
        expectedDoc.setBody("<html><body>Hello, World!</body></html>");
        
        Document actualDoc = testDocument(html, expectedDoc);
        
        if (actualDoc.asString().equals(expectedDoc.asString())) {
            System.out.println("The HTML is parsed successfully.");
        } else {
            System.out.println("Error: The HTML is not parsed successfully.");
        }
    }

    public static Document testDocument(String html, Document expectedDoc) {
        Document doc = new Document();
        
        try {
            W3CDOM w3cdom = Jsoup.parse(html);
            
            for (Element element : w3cdom.html().elements()) {
                if (element.tagName().equals("html")) {
                    String content = element.text();
                    
                    if (content.equals(expectedDoc.asString())) {
                        return expectedDoc;
                    }
                } else if (element.tagName().equals("body")) {
                    doc.setBody(element.text());
                }
            }
        } catch (Exception e) {
            System.out.println(e.getMessage());
        }

        return null;
    }
}

class Document {

    private String body;

    public void setBody(String body) {
        this.body = body;
    }

    @Override
    public String toString() {
        return "<html>" + body + "</html>";
    }
}

class W3CDOM {

    private String html;

    public W3CDOM(String html) {
        this.html = html;
    }

    public Document asDocument(Document expectedDoc) {
        return new Document();
    }
}
```

