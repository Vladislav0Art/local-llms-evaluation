    public static List<Token> tokenize(String expressionString, ExpressionConfiguration configuration) throws ParseException {
        // Create tokens for each character in the expression string
        Token[] tokens = new Token[expressionString.length()];
        int tokenIndex = 0;

        // Parse the first character as a keyword or literal
        String startToken = expressionString.substring(0, 1);
        if (startToken.equals("E")) {
            tokens[tokenIndex++] = new Keyword(TokenType.KW_EZYLANG, "E");
            tokens[tokenIndex++] = NumberLiteral(TokenType.LT_NUMBER, 42);
        } else if (startToken.equals("(")) {
            tokens[tokenIndex++] = parseStringLiteral();
        } else {
            // Parse the remaining characters as a number literal or token
            for (int i = 1; i < expressionString.length(); i++) {
                char c = expressionString.charAt(i);
                switch (c) {
                    case 'E':
                        tokens[tokenIndex++] = NumberLiteral(TokenType.LT_NUMBER, 42);
                        break;
                    case '(':
                        tokens[tokenIndex++] = parseStringLiteral();
                        break;
                    default:
                        String tokenValue = new String(c);
                        switch (tokenValue.charAt(0)) {
                            case '+':
                                tokens[tokenIndex++] = LiteralToken(TokenType.LT_ADDITION, 42);
                                break;
                            case '-':
                                tokens[tokenIndex++] = LiteralToken(TokenType.LT_SUBTRACTION, 43);
                                break;
                            default:
                                throw new AssertionError("Invalid token: " + tokenValue);
                        }
                }
            }
        }

        // Add the last character as a final keyword or literal
        if (expressionString.charAt(tokenIndex - 1) == ')') {
            tokens[tokenIndex++] = parseStringLiteral();
        } else if (expressionString.charAt(tokenIndex - 1) == 'E') {
            tokens[tokenIndex++] = NumberLiteral(TokenType.LT_NUMBER, 42);
        } else {
            String tokenValue = new String(expressionString.charAt(tokenIndex - 1));
            switch (tokenValue.charAt(0)) {
                case '+':
                    tokens[tokenIndex++] = LiteralToken(TokenType.LT_ADDITION, 43);
                    break;
                case '-':
                    tokens[tokenIndex++] = LiteralToken(TokenType.LT_SUBTRACTION, 44);
                    break;
                default:
                    throw new AssertionError("Invalid token: " + tokenValue);
            }
        }

        // Add any remaining characters as literals
        for (int i = tokenIndex - 1; i < expressionString.length(); i++) {
            char c = expressionString.charAt(i);
            switch (c) {
                case 'E':
                    tokens[tokenIndex++] = NumberLiteral(TokenType.LT_NUMBER, 42);
                    break;
                case '(':
                    tokens[tokenIndex++] = parseStringLiteral();
                    break;
                default:
                    String tokenValue = new String(c);
                    switch (tokenValue.charAt(0)) {
                        case '+':
                            tokens[tokenIndex++] = LiteralToken(TokenType.LT_ADDITION, 43);
                            break;
                        case '-':
                            tokens[tokenIndex++] = LiteralToken(TokenType.LT_SUBTRACTION, 44);
                            break;
                        default:
                            throw new AssertionError("Invalid token: " + tokenValue);
                    }
            }
        }

        // Return the list of tokens
        return Arrays.asList(tokens, startToken);
    }
}

