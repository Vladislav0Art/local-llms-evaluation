package com.ezylang.evalex.parser;

import static com.ezylang-evalex.parser.Token.TokenType.*;
import java.util.ArrayList;
import java.util.List;

class TokenizerTest {

    public static class StringToken extends Token {
        private String value;

        public StringToken(TokenType type, String value) {
            super(type, value);
        }

        @Override
        public String toString() {
            return "StringToken{" +
                    "value='" + value + '\'' +
                    '}';
        }
    }

    public static class LiteralToken extends Token {
        private IntegerLiteral value;

        public LiteralToken(TokenType type, IntegerLiteral value) {
            super(type, value);
        }

        @Override
        public String toString() {
            return "LiteralToken{" +
                    "value=" + value +
                    '}';
        }
    }

    public static class Keyword extends Token {
        private String name;

        public Keyword(TokenType type, String name) {
            super(type, name);
        }

        @Override
        public String toString() {
            return "Keyword{" +
                    "name='" + name + '\'' +
                    '}';
        }
    }

    public static class NumberLiteral extends Token {
        private Integer literal;

        public NumberLiteral(TokenType type, Integer literal) {
            super(type, literal);
        }

        @Override
        public String toString() {
            return "NumberLiteral{" +
                    "literal=" + literal +
                    '}';
        }
    }

    public static void main(String[] args) throws ParseException {
        List<Token> tokens = new TokenizerTest().tokenizer.parse("def greet(name: str):");
        
        while (tokens.size() > 0) {
            for (Token token : tokens) {
                if (token.type == TokenType.SYMBOL) {
                    System.out.println(token.value.toString());
                } else if (token.type == TokenType.STRING) {
                    System.out.println("StringLiteral('" + token.value + "')");
                } else if (token.type == TokenType.LITERAL) {
                    System.out.println("NumberLiteral(" + token.value + ")");
                }
            }

            List<Token> newTokens = new ArrayList<>();
            for (Token t : tokens) {
                if (t.type != TokenType.SYMBOL && t.type != TokenType.STRING && t.type != TokenType.LITERAL) {
                    newTokens.add(tokenizer.tokenize());
                }
            }
            tokens = newTokens;
        }
    }
}
