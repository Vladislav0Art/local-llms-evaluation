import java.util.HashMap;
import java.util.Map;

public class Main {
    private static Map<String, String> inputs = new HashMap<>();
    private static Map<String, String> outputs = new HashMap<>();

    public static void main(String[] args) {
        // Define user input and expected output
        inputs.put("input1", "Hello");
        inputs.put("input2", 123);
        inputs.put("input3", "world");

        outputs.put("output1", "Hello world");
        outputs.put("output2", "123 abc");
        outputs.put("output3", "abc world");

        // Process user input and print the expected output
        for (Map.Entry<String, String> entry : inputs.entrySet()) {
            System.out.println("User Input: " + entry.getKey() + ", Expected Output: " + entry.getValue());
            System.out.println();

            String result = process(entry.getKey());

            if (result.equals(outputs.get(entry.getKey()))) {
                System.out.println("Correct!");
            } else {
                System.out.println("Incorrect. The correct output for '" + entry.getKey() + "' is: " + outputs.get(entry.getKey()));
            }

            // Process user input and print the expected output
            result = greet(entry.getKey());
            if (result.equals(outputs.get(entry.getKey()))) {
                System.out.println("Correct!");
            } else {
                System.out.println("Incorrect. The correct output for '" + entry.getKey() + "' is: " + outputs.get(entry.getKey()));
            }

            // Process user input and print the expected output
            result = add(10, 20);
            if (result.equals(outputs.get("output1"))) {
                System.out.println("Correct!");
            } else {
                System.out.println("Incorrect. The correct output for 'output1' is: " + outputs.get("output1"));
            }
        }

    }

    public static String process(String input) {
        return inputs.get(input);
    }

    public static String greet(String name) {
        return "Hello, " + name;
    }

    public static String add(int a, int b) {
        return Integer.toString(a + b);
    }
}
