        if (inputs.containsKey(input)) {
            return outputs.get(input);
        } else {
            return "";
        }
    }

    public static String greet(String name) {
        return "Hello, " + name;
    }

    public static String add(int a, int b) {
        return Integer.toString(a + b);
    }
}
