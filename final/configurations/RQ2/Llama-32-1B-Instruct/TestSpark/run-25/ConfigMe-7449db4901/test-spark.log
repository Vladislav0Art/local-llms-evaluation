public class CommentsConfigurationTest {

    private CommentsConfigurationImpl commentsConfiguration;

    @Before
    public void setup() {
    }

    @Test
    public void test_setComment_noNewLine() throws Exception {
        Map<String, List<String>> comments = new HashMap<>();
        comments.put("path", Arrays.asList("", ""));
        commentsConfiguration = new CommentsConfigurationImpl();
        commentsConfiguration.setComment("path", "comment1\ncomment2");
        Assert.assertTrue(comments.get("path").contains("/\ncomment1"));
    }

    @Test
    public void test_setComment_withNewLine() throws Exception {
        Map<String, List<String>> comments = new HashMap<>();
        comments.put("path", Arrays.asList("", ""));
        commentsConfiguration = new CommentsConfigurationImpl();
        commentsConfiguration.setComment("path", "comment1\ncomment2");
        Assert.assertTrue(comments.get("path").contains("/comment1\ncomment2"));
    }

    @Test
    public void test_getAllComments_noNewLine() throws Exception {
        Map<String, List<String>> comments = new HashMap<>();
        comments.put("path", Arrays.asList("", ""));
        commentsConfiguration.setComment("path", "comment1");
        Assert.assertTrue(comments.get("path").contains("comment1"));
    }

    @Test
    public void test_getAllComments_withNewLine() throws Exception {
        Map<String, List<String>> comments = new HashMap<>();
        comments.put("path", Arrays.asList("", ""));
        commentsConfiguration.setComment("path", "comment1\ncomment2");
        Assert.assertTrue(comments.get("path").contains("/\ncomment1"));
    }

}
