    public void testLinkedHashMapPutAll() {
        linkedMap.put("key1", "value1");
        linkedMap.put("key2", "value2");
        assertEquals(2, linkedMap.size());
    }

    @Test
    public void testLinkedHashMapGet() {
        String value = (String) linkedMap.get("key1");
        assertEquals("value1", value);
    }
}
