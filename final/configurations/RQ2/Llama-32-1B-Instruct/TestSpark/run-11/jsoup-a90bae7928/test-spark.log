```java
import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;

public class HtmlParser {

    public static void main(String[] args) {
        String html = "<html><body><h1>Hello World!</h1></body></html>";
        Document doc = Jsoup.parse(html);

        // Get all elements
        Element[] elements = doc.getAllElements();

        System.out.println("All Elements:");
        for (Element element : elements) {
            System.out.println(element.toString());
        }

        // Get all tags in an element
        String[] tagsInElement = getAllTagsInElement(doc, "h1");

        System.out.println("\nTags in <h1>:");
        for (String tag : tagsInElement) {
            System.out.println(tag);
        }

        // Get all attributes of an element
        Map<String, Object> attributesMap = getAllAttributesInElement(doc, "h1");

        System.out.println("\nAttributes of <h1>:");
        for (Map.Entry<String, Object> entry : (Map<String, Object>) attributesMap) {
            System.out.println(entry.getKey() + ": " + entry.getValue());
        }

        // Get all elements in an element
        Element[] elementsInElement = getAllElementsInElement(doc, "h1");

        System.out.println("\nAll Elements in <h1>:");
        for (Element element : elementsInElement) {
            System.out.println(element.toString());
        }
    }

    private static String[] getAllTagsInElement(Document doc, String tag) {
        List<String> tags = new ArrayList<>();
        for (Element element : doc.getAllElements()) {
            if (element.tagName().equals(tag)) {
                tags.add(element.tagName());
            }
        }
        return tags.toArray(new String[0]);
    }

    private static Map<String, Object> getAllAttributesInElement(Document doc, String tag) {
        List<String> attributes = new ArrayList<>();
        for (Attribute attr : doc.getAttributes()) {
            if (attr.nodeName().equals(tag)) {
                attributes.add(attr.nodeName());
            }
        }
        return mapListToMap(attributes);
    }

    private static Element[] getAllElementsInElement(Document doc, String tag) {
        List<Element> elements = new ArrayList<>();
        for (Element element : doc.getAllElements()) {
            if (element.tagName().equals(tag)) {
                elements.add(element);
            }
        }
        return elements.toArray(new Element[0]);
    }

    private static Map<String, Object> getAllElementsWithAttributesInElement(Document doc, String tag) {
        List<Map<String, Object>> lists = new ArrayList<>();
        for (Attribute attr : doc.getAttributes()) {
            if (attr.nodeName().equals(tag)) {
                lists.add(getAllAttributesInElement(doc, attr.nodeName()));
            }
        }
        return mapListToMap(lists);
    }

    private static Map<String, Object> mapListToMap(List<Map<String, Object>> list) {
        Map<String, Object> map = new HashMap<>();
        for (Map.Entry<String, Object> entry : list) {
            map.put(entry.getKey(), entry.getValue());
        }
        return map;
    }
}

class Element {
    public String tag;

    public Element(String tag) {
        this.tag = tag;
    }

    @Override
    public String toString() {
        return "Element {\n" +
                "tag: '" + tag + "'\n" +
                "}";
    }
}

class Tag {
    @Override
    public String toString() {
        return "Tag";
    }
}

interface Map<String, Object> {
    default Object get(String key) {
        return null;
    }

    default List<String> mapListToMap(List<String> list) {
        return new ArrayList<>();
    }
}
