        }
        return false;
    }

    @Override
    public V get(Object key) {
        String lowerCaseKey = lowerCase(key.toString());
        return new AttributesDataset(data).get(lowerCaseKey);
    }

    @Override
    public boolean remove(Object key) {
        return data.remove(key.toString()) != null;
    }
}

