class AttributesIterator implements Iterator<Map.Entry<String, Object>> {
    private final Iterator<AttributesDataset> iterator;

    public AttributesIterator() {
        this.iterator = data.values().iterator();
    }

    @Override
    public boolean hasNext() {
        return iterator.hasNext();
    }

    @Override
    public Map.Entry<String, Object> next() {
        while (hasNext()) {
            if (!iterator.hasNext()) throw new NoSuchElementException();
            AttributesDataset attributes = iterator.next();
            for (Map.Entry<String, Object> entry : attributes.getValues()) {
                return new AbstractMap.SimpleEntry<>(entry.getKey(), entry.getValue());
            }
        }
        return null;
    }
}

