    private static UrlBuilder urlBuilder;

    @Test
    public void testBuild() {
        urlBuilder = new UrlBuilder();
        URLBuilder.UrlBuilderTest(urlBuilder, "key1=value1", "key2=value2");
        assertEquals("https://www.example.com", urlBuilder.build().toString());
    }

    @Test
    public void testAppendKeyVal() throws Exception {
        urlBuilder = new UrlBuilder();
        String[] kvArray = {"key1", "value1"};
        String expectedStr = "key1=value1";
        assertEquals(expectedStr, urlBuilder.appendKeyVal(kvArray));
    }

    @Test
    public void testAppendKeyVal_MalformedURL() throws Exception {
        URLBuilder.UrlBuilderTest(urlBuilder, "key1=value1");
        assertEquals("java.net.MalformedURLException: The URL is malformed.", urlBuilder.appendKeyVal(null));
    }

    public static void main(String[] args) {
        UrlHelper helper = new UrlHelper();
