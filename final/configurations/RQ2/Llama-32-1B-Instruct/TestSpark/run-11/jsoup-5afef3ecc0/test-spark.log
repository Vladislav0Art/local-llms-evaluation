import org.jsoup.helper.DataUtil;
import org.jsoup.helper.UrlBuilder;
import org.jsoup.helper.DataUtil;
import java.io.UnsupportedEncodingException;
import java.net.IDN;
import java.net.MalformedURLException;
import java.net.URI;
import java.net.URISyntaxException;
import java.net.URLDecoder;
import java.net.URLEncoder;
import static org.jsoup.helper.DataUtil.UTF_8;

public class UrlHelperTest {

    private UrlBuilder urlBuilder;
    private String inputUrl;

    public UrlHelperTest() {
        this.urlBuilder = new UrlBuilder();
        this.inputUrl = "https://www.example.com";
    }

    @Test
    public void testBuild() {
        URLBuilder.UrlBuilderTest(urlBuilder);
        Assert.assertEquals("https://www.example.com", urlBuilder.build().toString());
    }

    @Test
    public void testAppendKeyVal() throws UnsupportedEncodingException {
        String[] kv = {"key1=value1", "key2=value2"};
        UrlBuilder.UrlBuilderTest(urlBuilder, kv);
        Assert.assertEquals("key1=value1&key2=value2", urlBuilder.appendKeyVal(kv).toString());
    }

    @Test
    public void testAppendKeyValMalformedURLException() throws UnsupportedEncodingException {
        String[] kv = {"key1=value1", "key2=value2"};
        URL url = new URI("https://www.example.com");
        Assert.fail("Malformed URL");
    }

    private UrlBuilder.UrlBuilderTest(UrlBuilder urlBuilder, String[] kv) {
        for (String kvValue : kv) {
            urlBuilder.appendKeyVal(new org.jsoup.helper.KeyVal("key", "value"));
        }
    }

}

