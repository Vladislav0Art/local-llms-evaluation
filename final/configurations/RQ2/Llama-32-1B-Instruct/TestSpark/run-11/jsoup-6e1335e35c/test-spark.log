        String html = "<html><body>Hello, World!</body></html>";
        Document doc = new Document(html);
        assertEquals("Hello, World!", doc.html());
    }

    @Test
    public void test_cssSelector() {
        // Test CSS selector creation and application to element object
        Element elem = document.createElement("p");
        assertTrue(document.cssSelector().contains(elem.tagName()));
    }

    @Test
    public void test_className() {
        // Test class name addition to element object
        Element elem = document.createElement("div");
        document.addClass("primary", elem);
        assertEquals("primary", elem.className());
    }

    @Test
    public void test_removeClass() {
        // Test class name removal from element object
        Element elem = document.createElement("span");
        assertTrue(document.removeClass("secondary", elem).className().equals(""));
    }
}
