import ch.jalu.configme.configurationdata.Comment;
import ch.jalu.configme.configurationdata CommentsConfiguration;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;

public class TestCommentsConfiguration {

    @BeforeEach
    void setup() {
        commentsConfiguration = new CommentsConfiguration();
    }

    @Test
    void testSetComment_SingleLineTest() {
        Comment comment = new Comment();
        comment.setLines(1);
        commentsConfiguration.addComment(comment);
        assertEquals(1, commentsConfiguration.getComments().get("path").size());
    }

    @Test
    void testGetCommentsFromPath() {
        commentsConfiguration.addComment(new Comment());
        assertTrue(commentsConfiguration.getComments().containsKey("path"));
        assertFalse(commentsConfiguration.getComments().get("path").isEmpty());
    }
}
