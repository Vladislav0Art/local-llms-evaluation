public String none() {
    Document document = Jsoup.parse("<html><body></body></html>");
    Set<String> result = document.select("h1").text();
    return null;
}

public String simpleText() {
    Document document = Jsoup.parse("<html><body><p>This is a <b>test</b> paragraph.</p></body></html>");
    return document.select("p").text();
}

public Document basicWithImages() {
    Document document = Jsoup.parse("<html><body><img src='image.jpg'></body></html>");
    return document;
}

public Safelist basicTextWithImages() {
    Document document = Jsoup.parse("<html><body><h1>This is a <b>test</b> headline.</h1><p>This is a paragraph with an image.</p></body></html>");
    return new Safelist().basicWithImages();
}

public boolean safeTagsOnlyAddAttribute(String tag) {
    try {
        Jsoup.parse("<html><body>" + tag + "</body></html>", true);
        return true;
    } catch (Exception e) {
        return false;
    }
}
