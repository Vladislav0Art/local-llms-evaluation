package org.davidmoten.text.utils;

import java.io.IOException;
import java.nio.charset.Charset;
import java.nio.charset.StandardCharsets;
import java.util.Set;
import java.util.function.Function;

public class TestWordWrap {

    @Test
    public void testFromReader() throws IOException {
        WordWrap.Builder builder = WordWrap.from(new InputStreamReader("Hello World", StandardCharsets.UTF_8));
        assertEquals("Hello World", builder.build());
    }

    @Test
    public void testFromClasspathUtf8() throws IOException {
        WordWrap.Builder builder = WordWrap.fromClasspathUtf8("resource");
        assertEquals("Hello World", builder.build());
    }

    @Test
    public void testFromClasspath() throws IOException {
        WordWrap.Builder builder = WordWrap.fromClasspath("resource", StandardCharsets.UTF_8);
        assertEquals("Hello World", builder.build());
    }

    @VisibleForTesting
    public static Writer from(Reader reader, boolean close) {
        return new Writer(new OutputStreamWriter(new FileOutputStream("target") { });
    }

    @Test
    public void testClose() throws IOException {
        WordWrap.Builder builder = WordWrap.from(new InputStreamReader("Hello World", StandardCharsets.UTF_8));
        WordWrap.close(builder);
    }

    @VisibleForTesting
    public static void close(Reader reader) {
        new Thread(() -> WordWrap.close(reader)).start();
    }

    private static Function<CharSequence, Double> stringWidth = s -> (s.length() + 4.0);

    @Test
    public void testWordWrapWithTrim() throws IOException {
        BufferedReader in = new BufferedReader(new InputStreamReader("Hello World"));
        Writer out = new StringWriter();
        wordWrap(in, out, 10, stringWidth, null, false, true);
        assertEquals("Hello\nWorld", out.toString());
    }

    @Test
    public void testWordWrapWithoutTrim() throws IOException {
        BufferedReader in = new BufferedReader(new InputStreamReader("Hello World"));
        WordWrap.Builder builder = WordWrap.fromClasspath("resource", StandardCharsets.UTF_8);
        wordWrap(builder, null, 10, stringWidth, null, false, true);
        assertEquals("Hello World\n", builder.build());
    }

    @VisibleForTesting
    public static CharSequence rightTrim(CharSequence s) {
        StringBuilder2 sb = new StringBuilder2();
        for (int i = 0; i < s.length(); i++) {
            if (!s.substring(i).equals(s.substring(0, i))) {
                sb.append(s.charAt(i));
            }
        }
        return sb.toString();
    }

    @Test
    public void testIsWhitespace() throws IOException {
        BufferedReader in = new BufferedReader(new InputStreamReader("Hello World"));
        assertEquals(true, WordWrap.isWhitespace(in.readLine()));
    }

    @Test
    public void testLeftTrim() throws IOException {
        StringBuilder2 word = new StringBuilder2();
        for (int i = 0; i < 5; i++) {
            word.append('a');
        }
        word.trimToSize();
        assertEquals("ab", word.toString());
    }
}

class StringBuilder2 {

    private int length;

    public void append(char c) {
        if (length == 0 || c != '\n') {
            length++;
        } else {
            throw new RuntimeException();
        }
    }

    public void clear() {
        length = 0;
    }

    public String toString() {
        return new String(new char[length]).replace('\0', ' ');
    }

    public int size() {
        return length;
    }

    public static class Builder {
        private StringBuilder2 word;

        public Builder append(char c) {
            if (word == null || !Character.isWhitespace(c)) {
                word.append(c);
            }
            return this;
        }

        public void clear() {
            word = new StringBuilder2();
        }

        public String build() {
            while (!word.isEmpty()) {
                char[] arr = word.toString().toCharArray();
                for (int i = 0; i < arr.length; i++) {
                    if (!Character.isWhitespace(arr[i])) {
                        return new String(arr);
                    }
                }
                word.clear();
            }
            return "";
        }

        public Builder trimToSize() {
            while (word.size() > 10) {
                char[] arr = word.toString().toCharArray();
                for (int i = 0; i < arr.length; i++) {
                    if (!Character.isWhitespace(arr[i])) {
                        word.setCharAt(i, arr[0]);
                        break;
                    }
                }
            }
            return this;
        }

        public void trimLeft(int size) {
            while (word.size() > size) {
                char[] arr = word.toString().toCharArray();
                for (int i = 0; i < arr.length; i++) {
                    if (!Character.isWhitespace(arr[i])) {
                        word.setCharAt(0, arr[0]);
                        break;
                    }
                }
            }
        }

        public void setCharAt(int index, char c) {
            word.setCharAt(index, c);
        }
    }
}
