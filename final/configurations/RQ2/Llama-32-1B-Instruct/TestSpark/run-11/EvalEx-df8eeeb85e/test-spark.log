public class Test {
    public static void main(String[] args) {
        String[][] testCases = {
            {"variable", "expression"},
            {"number", "number"},
            {"string", "string"}
        };

        for (String[] testCase : testCases) {
            System.out.println("Test Case: " + testCase[0] + ", " + testCase[1]);
            doTestCase(testCase);
            System.out.println();
        }
    }

    private static void doTestCase(String... variables) {
        Test test = new Test();

        for (String variable : variables) {
            String name = variable;
            Object value = null;

            if (variable.equals("number")) {
                value = 10.0;
            } else if (variable.equals("string")) {
                value = "Hello, World!";
            }

            System.out.println("Test: Variable '" + name + "' is " + test.getExpectedResult(variable) + ", Actual result is " + test.getValue(name));

            // Mocking the input stream
            Object[] inputs = new Object[1];
            inputs[0] = value;

            try {
                // Using the mock object to return a string or number
                String result = (String) test.getExpectedResult(variable);
                System.out.println("Test: Variable '" + name + "' is '" + result + "', Actual result is " + test.getValue(name));
            } catch (Exception e) {
                System.out.println("Test: Variable '" + name + "' is not a string or number, Actual result is " + test.getValue(name));
            }
        }

        // Printing the expected results
        for (String variable : variables) {
            String name = variable;
            Object value = null;

            if (variable.equals("number")) {
                value = 10.0;
            } else if (variable.equals("string")) {
                value = "Hello, World!";
            }

            test.setExpectedResult(name, test.getExpectedResult(variable));
        }
    }

    private static String getExpectedResult(String variable) {
        switch (variable) {
            case "number":
                return "Number";
            case "string":
                return "String";
            default:
                return "";
        }
    }

    private Object getValue(String variable) {
        switch (variable) {
            case "variable1":
                return 10;
            case "variable2":
                return "Hello, World!";
            default:
                return null;
        }
    }
}
