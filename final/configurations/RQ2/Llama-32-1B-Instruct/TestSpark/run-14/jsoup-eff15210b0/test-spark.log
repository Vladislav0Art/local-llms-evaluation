public class HttpConnectionTest {

    private static final String URL = "https://example.com";
    private static final int DEFAULT_TIMEOUT_MILLIS = 1000;
    private static final int DEFAULT_MAX_BODY_SIZE = 1024 * 1024;

    public static void testConnect() throws Exception {
        HttpConnection connection = new HttpConnection();
        assertEquals(URL, connection.connect(url(URL)));

        connection.timeout(DEFAULT_TIMEOUT_Millis);
        assertEquals(DEFAULT_TIMEOUT_Millis, connection.timeout(DEFAULT_TIMEOUT_Millis));

        connection.maxBodySize(DEFAULT_MAX_BODY_SIZE);
        assertEquals(DEFAULT_MAX_BODY_SIZE, connection.maxBodySize(DEFAULT_MAX_BODY_SIZE));
    }

    public static void testConnectWithProxy() throws Exception {
        HttpConnection connection = new HttpConnection();
        Proxy proxy = null;
        assertEquals(null, connection.connect(proxy(new URL(URL))));
    }

    public static void testConnectWithCookieStore() throws Exception {
        CookieManager cookieManager = new javax.net.ssl.CookieManager();
        HttpConnection connection = new HttpConnection(cookieManager);
        assertEquals("https://example.com", connection.connect(url(URL)));
    }

    public static void testNewRequest() {
        Request request = new Request();
        HttpConnection connection = new HttpConnection(request);
        assertEquals(connection, connection.newRequest());
    }

    public static void testUrl(String url) throws Exception {
        HttpConnection connection = new HttpConnection();
        assertEquals(url, connection.url(url));
    }

    public static void testProxy() {
        HttpConnection connection = new HttpConnection();
        Proxy proxy = null;
        assertEquals(proxy, connection.proxy(proxy));
    }

    public static void testUserAgent() throws Exception {
        Request request = new Request();
        HttpConnection connection = new HttpConnection(request);
        assertEquals("Mozilla/5.0", connection.userAgent());
    }

    public static void testTimeout(int millis) throws Exception {
        HttpConnection connection = new HttpConnection();
        assertEquals(DEFAULT_TIMEOUT_MILLIS, connection.timeout(millis));
    }

    public static void testMaxBodySize(int bytes) throws Exception {
        HttpConnection connection = new HttpConnection();
        assertEquals(DEFAULT_MAX_BODY_SIZE, connection.maxBodySize(bytes));
    }

    public static void testFollowRedirects() throws Exception {
        Request request = new Request();
        HttpConnection connection = new HttpConnection(request);
        assertTrue(connection.followRedirects(true));

        connection.maxBodySize(1024 * 1024 * 2); // large response
        assertTrue(connection.followRedirects(false));
    }

    public static void testIgnoreHttpErrors() throws Exception {
        Request request = new Request();
        HttpConnection connection = new HttpConnection(request);
        assertEquals("GET / HTTP/1.1", connection.ignoreHttpErrors(true).get());
    }

    public static void testIgnoreContentType() throws Exception {
        Request request = new Request();
        HttpConnection connection = new HttpConnection(request);
        assertEquals("", connection.ignoreContentType(false));
    }

    public static void testData(String key, String value) throws Exception {
        Request request = new Request();
        DataUtil.setData(key, value, request);
        HttpConnection connection = new HttpConnection(request);
        assertEquals(value, connection.data(key).value());
    }

    public static void testDataCollection() throws Exception {
        Request request = new Request();
        DataUtil.setData(keyVals("key1", "value1", keyVals("key2", "value2")), request);
        HttpConnection connection = new HttpConnection(request);
        assertTrue(connection.data(Arrays.asList(keyVals("key1", "value1", "key2", "value2"))).size() == 3);
    }

    public static void testDataRequest(String... keyvals) throws Exception {
        Request request = new Request();
        DataUtil.setData(keyvals, request);
        HttpConnection connection = new HttpConnection(request);
        assertEquals(Arrays.asList(keyvals), connection.data(Arrays.asList("key1", "value1", "key2", "value2")));
    }

    public static void testKeyVal(String... key) throws Exception {
        Request request = new Request();
        DataUtil.setData(key, null, request);
        HttpConnection connection = new HttpConnection(request);
        assertEquals(Arrays.asList(key), connection.data(Arrays.asList("key1", "value1")));
    }

    public static void testRequestBody(String body) throws Exception {
        Request request = new Request();
        DataUtil.setData(body, request);
        HttpConnection connection = new HttpConnection(request);
        assertEquals(body, connection.request().response().body());
    }

    public static void testPostDataCharset(String charset) throws Exception {
        Request request = new Request();
        DataUtil.setData(null, null, request);
        HttpConnection connection = new HttpConnection(request);
        assertEquals("UTF-8", connection.postDataCharset(charset));
    }
