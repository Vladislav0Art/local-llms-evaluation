        System.out.println(obj1.add(5, 6)); // Outputs: 11
        System.out.println(obj1.greeting("John")); // Outputs: Hello John

        MyClass2 obj2 = new MyClass2();
        int sumNumbers = obj2.addNumbers(10, 3);
        System.out.println(sumNumbers); // Outputs: 13

        String name = "Bob";
