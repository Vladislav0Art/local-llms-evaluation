import com.ezylang.evalex.config.ExpressionConfiguration;
import com.ezylang.evalex.config.FunctionDictionaryIfc;
import com.ezylang.evalex.config.OperatorDictionaryIfc;
import com.ezylang.evalex.functions.FunctionIfc;
import com.ezylang.evalex.operators.OperatorIfc;
import java.util.ArrayList;
import java.util.List;

public class TokenizerTest {

    public static class Parser {
        private String expressionString = "1 + 2 * 3";
        private ExpressionConfiguration configuration;
        private FunctionDictionaryIfc functionDictionary;
        private OperatorDictionaryIfc operatorDictionary;
        private List<Token> resultTokens;

        public Parser(String expressionString, ExpressionConfiguration configuration) {
            this.expressionString = expressionString;
            this.configuration = configuration;
            functionDictionary = new FunctionDictionaryIfc();
            operatorDictionary = new OperatorDictionaryIfc();
            resultTokens = new ArrayList<>();
        }

        public Token parse() throws ParseException {
            // implementation
        }

        public List<Token> parseStringLiteral() throws ParseException {
            return parse();
        }
    }

    @Test
    public void testParseSimpleExpression() {
        Parser parser = new Parser(expressionString, configuration);
        Tokenizer tokenizer = new Tokenizer(expressionString, configuration);
        tokenizers.parse().stream()
                .forEach(token -> resultTokens.add(token));
        assertEquals(expressionString, resultTokens.stream().map(Token::getType).collect(Collectors.joining(", ")));
    }

    @Test
    public void testParseMultipleExpressions() {
        Parser parser = new Parser(expressionString, configuration);
        Tokenizer tokenizer = new Tokenizer(expressionString, configuration);
        List<Token> expressions = tokenizers.parse();
        assertEquals(3, expressions.size());
        expressions.forEach(token -> resultTokens.add(token));
        assertEquals(expressionString, resultTokens.stream().map(Token::getType).collect(Collectors.joining(", ")));
    }

    @Test
    public void testParseInvalidExpression() {
        Parser parser = new Parser("1 + 2 *", configuration);
        Tokenizer tokenizer = new Tokenizer("1 + 2 *", configuration);
        tokenizers.parse().stream()
                .forEach(token -> resultTokens.add(token));
        assertEquals(null, resultTokens.stream().map(Token::getType).collect(Collectors.joining(", ")));
    }

    @Test
    public void testParseStringLiteral() {
        Parser parser = new Parser(expressionString, configuration);
        Tokenizer tokenizer = new Tokenizer(expressionString, configuration);
        tokenizer.parseStringLiteral();
        assertEquals("1", resultTokens.get(0).getType());
    }
}
