public class Main {

    private String input;
    private String expectedOutput;

    public void runTest(String input, String output) {
        try {
            this.input = input;
            this.expectedOutput = output;
            if (test(input)) {
                System.out.println("Test passed");
            } else {
                System.out.println("Test failed");
            }
        } catch (Exception e) {
            System.out.println("An error occurred: " + e.getMessage());
        }
    }

    public boolean test(String input) throws Exception {
        if (input.contains("1")) {
            return true;
        }

        if (input.equals("")) {
            throw new Exception("Input cannot be empty");
        }

        String[] tokens = input.split("\\s+");
        int length = tokens.length;

        for (int i = 0; i < length - 1; i++) {
            try {
                int index = Integer.parseInt(tokens[i]);
                if (i == length - 2) {
                    return true;
                }

                String expectedOutputForIndex = tokens[i + 1];
                boolean result = test(expectedOutputForIndex);
                if (!result) {
                    return false;
                }
            } catch (NumberFormatException e) {
                continue;
            }
        }

        return true;
    }

    public static void main(String[] args) throws Exception {
        Main main = new Main();

        String[][] tests = {
                {"1 2 3", "5"},
                {"a b c d e", "fghijk"},
                {"1 2 1 1 1", "5"}
        };

        for (String[] test : tests) {
            main.runTest(test[0], test[1]);
        }
    }
}
