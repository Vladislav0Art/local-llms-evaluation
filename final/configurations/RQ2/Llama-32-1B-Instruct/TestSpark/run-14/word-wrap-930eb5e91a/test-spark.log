import com.github.davidmoten.guavamini.Preconditions;
import org.junit.Test;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;

public final class WordWrapTest {

    @Mock
    private BufferedReader in;

    @Mock
    private Reader reader;

    @Mock
    private Writer out;

    @Mock
    private LineConsumer lineConsumer;

    @Mock
    private Number stringWidth;

    @Mock
    private Set<Character> extraWordChars;

    @Mock
    private boolean insertHyphens;

    @Mock
    private boolean breakWords;

    @Test
    public void testWordWrapFromReader() {
        Preconditions.checkNotNull(new WordWrap());

        when(in.read()).thenReturn(10);
        wordWrap(reader, out, "Hello World", 20, stringWidth::new, extraWordChars, insertHyphens, breakWords);

        verify(out).write("Hello World");
    }

    @Test
    public void testWordWrapFromClasspathUtf8() {
        Preconditions.checkNotNull(new WordWrap());

        when(in.read()).thenReturn(10);
        wordWrap(fromClasspathUtf8("hello-world.txt"), out, "Hello World", 20, stringWidth::new, extraWordChars, insertHyphens, breakWords);

        verify(out).write("Hello World");
    }

    @Test
    public void testWordWrapFromClasspath() {
        Preconditions.checkNotNull(new WordWrap());

        when(in.read()).thenReturn(10);
        wordWrap(from("hello-world.txt"), out, "Hello World", 20, stringWidth::new, extraWordChars, insertHyphens, breakWords);

        verify(out).write("Hello World");
    }

    @Test
    public void testWordWrapFromUtf8() {
        Preconditions.checkNotNull(new WordWrap());

        when(in.read()).thenReturn(10);
        wordWrap(fromUtf8(new FileInputStream("hello-world.txt")), out, "Hello World", 20, stringWidth::new, extraWordChars, insertHyphens, breakWords);

        verify(out).write("Hello World");
    }

    @Test
    public void testWordWrapFromFile() {
        Preconditions.checkNotNull(new WordWrap());

        when(in.read()).thenReturn(10);
        wordWrap(fromFile("hello-world.txt"), out, "Hello World", 20, stringWidth::new, extraWordChars, insertHyphens, breakWords);

        verify(out).write("Hello World");
    }

    @Test
    public void testWordWrapFromReaderInsertHyphens() {
        Preconditions.checkNotNull(new WordWrap());

        when(in.read()).thenReturn(10);
        wordWrap(fromReader(new Reader[]{new BufferedReader[]{}, new BufferedReader[]{}}), out, "Hello", 20, stringWidth::new, extraWordChars, insertHyphens, breakWords);

        verify(out).write("Hello");
    }

    @Test
    public void testWordWrapFromReaderBreakWords() {
        Preconditions.checkNotNull(new WordWrap());

        when(in.read()).thenReturn(10);
        wordWrap(fromReader(new Reader[]{new BufferedReader[]{}, new BufferedReader[]{}}, true), out, "Hello", 20, stringWidth::new, extraWordChars, insertHyphens, breakWords);

        verify(out).write("Hello");
    }

    @Test
    public void testWordWrapFromLineConsumer() {
        Preconditions.checkNotNull(new WordWrap());

        when(in.read()).thenReturn(10);
        wordWrap(fromLineConsumer(new LineConsumer[]{}, new Number(), 20, stringWidth::new, extraWordChars, insertHyphens, breakWords), out, "Hello", 20, stringWidth::new, extraWordChars, insertHyphens, breakWords);

        verify(out).write("Hello");
    }

    @Test
    public void testWordWrapFromReaderIsWhitespace() {
        Preconditions.checkNotNull(new WordWrap());

        when(in.read()).thenReturn(10);
        wordWrap(fromReader(new Reader[]{new BufferedReader[]{}, new BufferedReader[]{}}, false), out, "  ", 20, stringWidth::new, extraWordChars, insertHyphens, breakWords);

        verify(out).write(" ");
    }

    @Test
    public void testIsWhitespace() {
        Preconditions.checkNotNull(new WordWrap());

        when(in.read()).thenReturn(10);
        wordWrap(fromReader(new Reader[]{new BufferedReader[]{}, new BufferedReader[]{}}, false), out, "Hello", 20, stringWidth::new, extraWordChars, insertHyphens, breakWords);

        verify(extraWordChars).contains("H");
    }

    @Test
    public void testLeftTrim() {
        Preconditions.checkNotNull(new WordWrap());

        when(in.read()).thenReturn(10);
        wordWrap(fromReader(new Reader[]{new BufferedReader[]{}, new BufferedReader[]{}}, false), out, "Hello", 20, stringWidth::new, extraWordChars, insertHyphens, breakWords);

        verify(lineConsumer).trimLeft("Hello");
    }

