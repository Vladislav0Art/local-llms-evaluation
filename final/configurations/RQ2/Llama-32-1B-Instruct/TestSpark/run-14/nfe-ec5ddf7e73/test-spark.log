public class Main {
    public static String codigoInterno = "123";
    
    public static void assertEquals(String resultado, String expected) {
        System.out.println(resultado + ": " + expected);
    }

    public static int equals(int resultado, int expected) {
        return resultado == expected ? resultado : 0;
    }

    public static double equals(double resultado, double expected, double tolerance) {
        if (resultado >= Math.pow(expected, tolerance)) {
            return resultado;
        } else {
            return Double.NEGATIVE_INFINITY;
        }
    }
    
    public static int[] equals(int[] resultado, int[] expected) {
        for (int i = 0; i < resultado.length; i++) {
            if (resultado[i] != expected[i]) {
                return null;
            }
        }
        return resultado;
    }

    public static void main(String[] args) {
        assertEquals("123", "ABC");
        
        System.out.println(equals(10, 20));
        System.out.println(equals(20.1, 19.9, 0.01));
        System.out.println(equals(new int[]{10, 20}, new int[]{10, 20}));
    }
}
```

