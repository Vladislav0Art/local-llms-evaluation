                    throw new RuntimeException("Duplicate column");
                }
            }
            columns.set(index, columns.get(0));
            return this;
        }

        public DataFrameCell[] getCells() {
            List<DataFrameRow> cells = new ArrayList<>(rows);
            for (DataFrameColumn column : columns) {
                cells.addAll(column.getRowsForIndex(new String[]{column.getName()}));
            }
            return cells.toArray(new DataFrameCell[0]);
        }

        public void setIndex(int index) {
            this.index = index;
            for (DataFrameRow row : rows) {
                if (!rows.contains(row)) {
                    throw new RuntimeException("Duplicate row");
                }
            }
            rows.clear();
            rows.add(index, columns.get(0));
            return this;
        }

        public DataFrameRow build() {
            return new DataFrameRowBuilder(getSize()).setRows(getCells()).build();
        }
    }
