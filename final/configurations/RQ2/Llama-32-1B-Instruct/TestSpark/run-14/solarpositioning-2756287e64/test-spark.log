```java
import java.time.LocalDateTime;
import java.time.ZoneId;

public class SolarPositionCalculator {

    /**
     * Calculates the difference in time between now and the next solar noon.
     *
     * @return The difference in minutes, rounded to the nearest integer.
     */
    public int calculateDeltaT() {
        LocalDateTime now = LocalDateTime.now();
        ZoneId zoneId = ZoneId.systemDefault();
        int deltaHours = (now.getHour() + 12) / 24;
        return deltaHours * 60;
    }

    /**
     * Returns the current solar position.
     *
     * @param azimuth The angular distance from true north at local mean time (N).
     * @return The solar position. Can be "Equatorial", "Standard", or "Polar".
     */
    public String getSolarPosition(double azimuth) {
        ZoneId zoneId = ZoneId.systemDefault();
        LocalDateTime now = LocalDateTime.now();
        LocalDateTime next Noon = LocalDateTime.of(now.getYear(), now.getMonth(), now.getDayOfMonth(), 0, 0);
        Duration duration = Duration.between(nextNoon.toLocalTime(), now.toLocalTime());
        double deltaHours = duration.getSeconds() / 3600;
        int azimuthInDegrees = (int) ((azimuth * Math.PI) / (180));
        if (deltaHours >= 12 && deltaHours < 18) {
            return "Standard";
        } else {
            return "Polar";
        }
    }

    /**
     * Tests the calculateDeltaT method.
     */
    public void testCalculateDeltaT() {
        System.out.println(calculateDeltaT());
    }

    /**
     * Tests the getSolarPosition method with a polar position.
     */
    public void testGetSolarPosition_Polar() {
        System.out.println(getSolarPosition(0));
    }

    /**
     * Tests the getSolarPosition method with an equatorial position.
     */
    public void testGetSolarPosition_Equatorial() {
        System.out.println(getSolarPosition(Math.PI / 4));
    }
}
