public class SolarPositionCalculator {

    public double calculateDeltaT() {
        return 24;
    }

    public String getSolarPosition(double azimuth, double deltaT) {
        if (deltaT == 0) {
            return "Polar";
        } else if (azimuth > 90 || azimuth < -90) {
            return "Equatorial";
        }
        return "Standard";
    }

    public void testCalculateDeltaT() {
        System.out.println(calculateDeltaT());
    }

    public void testGetSolarPosition_Polar() {
        System.out.println(getSolarPosition(0, 1));
    }

    public void testGetSolarPosition_Equatorial() {
        System.out.println(getSolarPosition(Math.PI / 4, Math.PI / 2));
    }
}
