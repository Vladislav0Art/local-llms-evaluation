        }

        for (int i = 0; i < safes.length; i++) {
            if (!safes[i].contains("class")) break;
            Element classTag = doc.createElement("div");
            int pos = 0;
            while (pos < tagNames.indexOf(safes[i])) {
                if (tagNames.indexOf(element.getElementById(tag).toString()) == tagNames.indexOf(safes[i]) - safes[i].length() + safes[i].length()) break;
                classTag.appendChild(doc.getElementById(tag).cloneNode(true));
                pos++;
            }
            styles[i] = element.getAttribute("class") + "\n" + classTag.outerHTML;

        }

        for (int i = 0; i < safes.length - 1; i++) {
            String[] attributes = getAttributes(safes[i], attributeCount);
            if (!attributes[attributeCount - 1].contains(tagNames.indexOf(safes[i])) || !safes[i + 1].contains("style")) break;
            for (int j = 0; j < attributes.length && j < attributes[j].length(); j++) {
                styles[i] += attributes[j];
            }
        }

        return element.outerHTML + "\n" + styles[styles.length - 1];

    }
}

