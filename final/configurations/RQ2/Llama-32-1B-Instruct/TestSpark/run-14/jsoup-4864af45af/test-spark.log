import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;

public class SafelistTest {

    public Safelist safelist;

    public void setUp() {
        Document doc = new Document();
        safelist = new Safelist(doc);
    }

    @org.junit.Test
    public void testGetSafeTag() throws Exception {
        // Check if an "img" tag is considered safe by checking its class attribute
        safelist.addAttribute("class", "test-class1");
        assert (safelist.isSafeTag("img") == true);
        
        // Add another attribute to the "img" tag that makes it not safe
        safelist.addAttribute("style", "color: red;");
        assert (safelist.isSafeTag("img") == false);

        // Test a class name attribute on an "img" tag that is already considered safe
        String[] safeTags = {"p", "span", "a"};
        for (String t : safeTags) {
            if (safelist.getEnforcedAttributes(t).length > 0 && safelist.getEnforcedAttributes(t)[0].equals(safelist.getEnforcedAttributes(t)[0])) {
                assert (t.equals("class='test-class1'"));
            }
        }

        // Test an "img" tag with no attributes
        String[] safeTags = {"p", "span", "a"};
        for (String t : safeTags) {
            if (safelist.getEnforcedAttributes(t).length == 0 && safelist.getEnforcedAttributes(t)[0].equals(safelist.getEnforcedAttributes(t)[0])) {
                assert (t.equals("class='test-class1'"));
            }
        }

        // Test a class name attribute on an "img" tag with no attributes
        String[] safeTags = {"p", "span", "a"};
        for (String t : safeTags) {
            if (!safelist.getEnforcedAttributes(t).length > 0 && safelist.getEnforcedAttributes(t)[0].equals(safelist.getEnforcedAttributes(t)[0])) {
                assert (t.equals("class='test-class1'"));
            }
        }

        // Test a class name attribute on an "img" tag with multiple attributes
        String[] safeTags = {"p", "span", "a"};
        for (String t : safeTags) {
            if (!safelist.getEnforcedAttributes(t).length > 0 && safelist.getEnforcedAttributes(t)[0].equals(safelist.getEnforcedAttributes(t)[0])) {
