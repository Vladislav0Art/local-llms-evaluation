    private GrammarTest grammar;

    public GrammarGeneratorTest() {
        grammar = new GrammarTest();
    }

    public void testAddWordsToGrammar() {
        grammarTest.testAddWord();
        grammarTest.testAddWord();  // Test adding the same word again
    }

    public void testGetWordsFromGrammar() {
        System.out.println(grammar.getWord(0));  // Should print "hello"
        System.out.println(grammar.getWord(1));  // Should print "world"
        System.out.println(grammarTest.getWord(2)); // Should print "no word found"
