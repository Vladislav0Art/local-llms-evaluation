import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;

public class Main {

    public static void main(String[] args) {
        String url = "http://www.example.com";
        
        // Generate HTML structure
        Document doc = Jsoup.connect(url).get();
        System.out.println("Generated HTML Structure:");
        System.out.println(doc.html());
        
        // Set title for the webpage
        System.out.println("\nTitle of the Webpage: " + url);
        System.out.println(getTitle());

        // Get content of the webpage
        System.out.println("\nContent of the Webpage: ");
        System.out.println(getContent());

        // Generate output settings as XML
        System.out.println("\nOutput Settings:");
        System.out.println(getOutputSettings());
        
        // Get parser output settings as XML
        Document parsedDoc = Jsoup.parse(url);
        System.out.println("\nParser Output Settings (as HTML):");
        System.out.println(parsedDoc.html());

        // Set parser to generate HTML
        System.out.println("Setting Parser to Generate HTML:");
        System.out.println(getParser());
    }

    public static String getHtmlStructure() {
        return "<html><head>Header</head><body>" + Jsoup.connect(url).get().html() + "</body></html>";
    }

    public static String getTitle() {
        return url;
    }

    public static String getContent() {
        return "This is the content of the webpage.";
    }

    public static String getOutputSettings() {
        return Jsoup.parse(url).outputSettings();
    }

    public static String getParser() {
        return Jsoup.parse(url).toString();
    }
}
