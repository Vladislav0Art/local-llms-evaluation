public class MyClass {
    private String name;

    public MyClass(String name) {
        this.name = name;
    }

    public void setName(String newName) {
        if (newName == null || newName.isEmpty()) {
            throw new IllegalArgumentException("Name cannot be empty");
        }
        this.name = newName;
    }

    @Override
    public String toString() {
        return "MyClass{" +
                "name='" + name + '\'' +
                '}';
    }
}

public class Main {
    public static void main(String[] args) {
        MyClass myInstance1 = new MyClass("John");
        System.out.println(myInstance1.toString());

        try {
            MyClass myInstance2 = new MyClass();
            myInstance2.setName("");
            System.out.println(myInstance2.toString());
        } catch (IllegalArgumentException e) {
            System.out.println(e.getMessage());
        }

        try {
            MyClass myInstance3 = new MyClass("Jane");
            System.out.println(myInstance3.toString());
        } catch (IllegalArgumentException e) {
            System.out.println(e.getMessage());
        }
    }
}
```

