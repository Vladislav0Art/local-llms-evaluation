    public Dataset<Row> createTable(String tableName, String[] columns) throws DBAppException {
        return dbApp.getMyTables().create(tableName);
    }

    public void testCreateTable() throws DBAppException {
        dbApp.createTable("test_table", new String[]{"col1", "col2"});
    }

    public Dataset<Row> insertIntoTable(String tableName, Dataset<Row> data) throws DBAppException {
        return dbApp.getMyTables().insert(data);
    }

    public void testInsertIntoTable() throws DBAppException {
        DataStore data = new DataStore();
        data.insert(new String[]{"col1", "col2"});
        Dataset<Row> result = insertIntoTable("test_table", data);
        assert result.count() > 0;
    }

    public void updateTable(String tableName, Dataset<Row> data) throws DBAppException {
        dbApp.getMyTables().update(tableName, data);
    }

    public void testUpdateTable() throws DBAppException {
        DataStore data = new DataStore();
        data.insert(new String[]{"col1", "col2"});
        Dataset<Row> result = updateTable("test_table", data);
        assert result.count() > 0;
    }

    public Dataset<Row> deleteTable(String tableName) throws DBAppException {
        dbApp.getMyTables().delete(tableName);
        return createTable(tableName, new String[]{"col1", "col2"});
    }

    public void testDeleteTable() throws DBAppException {
        DataStore data = new DataStore();
        data.insert(new String[]{"col1", "col2"});
        Dataset<Row> result = deleteTable("test_table");
        assert result.count() == 0;
    }
}
