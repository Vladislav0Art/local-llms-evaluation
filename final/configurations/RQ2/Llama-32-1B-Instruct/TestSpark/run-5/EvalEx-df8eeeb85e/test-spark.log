                    int start = pos + 1;
                    while (pos < input.length() && input.charAt(pos) == quote.charAt(0)) {
                        pos++;
                    }
                    tokens.add(new Token("string", quote));
                } else {
                    char c = input.charAt(pos);
                    while (c != ' ') pos++;
                    if (!Character.isLetter(c)) {
                        tokens.add(new Token("identifier", Integer.parseInt(input.substring(start, pos))));
                    } else {
                        tokens.add(new Token("identifier", input.substring(start, pos)));
                    }
                }
            } else {
                int quotePos = input.indexOf('"', pos);
                if (quotePos != -1 && input.charAt(quotePos + 1) == '"') {
                    char c = input.charAt(pos);
                    while (c != '"' || quotePos != -1) {
                        if (c == '\\') c = Character.toLowerCase(c); // \u001B
                        else if (c == '(' || c == ')' || c == '[' || c == ']' || c == '{' || c == '}' || c == '|' || c == '&') {
                            pos++;
                            continue;
                        } else {
                            break;
                        }
                    }
                    quotePos = input.indexOf('"', pos);
                    if (quotePos != -1) {
                        String quote = input.substring(pos, quotePos + 1);
                        int start = pos + 1;
                        while (pos < input.length() && input.charAt(pos) == quote.charAt(0)) {
                            pos++;
                        }
                        tokens.add(new Token("string", quote));
                    } else {
                        pos++;
                        if (!Character.isLetter(c)) {
                            tokens.add(new Token("identifier", Integer.parseInt(input.substring(start, pos))));
                        } else {
                            tokens.add(new Token("identifier", input.substring(start, pos)));
                        }
                    }
                } else {
                    int start = pos + 1;
                    while (pos < input.length() && !Character.isLetterOrDigit(input.charAt(pos))) pos++;
                    if (pos == input.length()) return List.of();
                    tokens.add(new Token("identifier", Integer.parseInt(input.substring(start, pos))));
                    pos++;
                }
            }
        }
        return tokens;
    }

    public String parse(String input) {
        return tokenize(input).stream()
                .map(token -> {
                    switch (token.type) {
                        case "string":
                            return "\"" + token.value + "\"";
                        case "identifier":
                            return token.value.toString();
                        default:
                            throw new RuntimeException("Unknown token: " + token.type);
                    }
                })
                .collect(Collectors.joining());
    }

}

public class Main {
    public static void main(String[] args) {
        Lexer lexer = new Lexer();
        System.out.println(lexer.parse("x = 5")); // prints 'identifier x'
        System.out.println(lexer.parse("y = 3 + 'Hello, World!'));") // prints string "string Hello, World!"
    }
}
