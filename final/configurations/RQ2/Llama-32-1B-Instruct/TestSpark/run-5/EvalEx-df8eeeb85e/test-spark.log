    public static String parse(List<Token> tokens) {
        StringBuilder sb = new StringBuilder();
        int start = 0;
        while (start < tokens.size()) {
            Token token = tokens.get(start);
            if (token.type.equals("identifier")) {
                sb.append(token.value).append(" = ");
                start++;
            } else if (token.type.equals("string") && start + 1 >= tokens.size() || !Character.isLetterOrDigit(tokens.get(start + 1).value)) {
