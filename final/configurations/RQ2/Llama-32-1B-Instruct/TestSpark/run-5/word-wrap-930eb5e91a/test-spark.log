public class WordWrapTests {

    @Test
    public void testWordWrap_EmptyReader() {
        Preconditions.checkNotNull(new Reader());
        Preconditions.checkNotNull(new Writer());

        WordWrap wordWrap = WordWrap.from(new BufferedReader(new InputStreamReader(
                new FileInputStream(new File("empty.txt")))));

        assertEquals(0, wordWrap.wordWrap(new BufferedReader(new InputStreamReader(
                new FileInputStream(new File("empty.txt")))), new OutputStreamWriter(
                new FileOutputStream(new File("output.txt"))), "", 10000,
                Function.identity(), null, false, true).length());
    }

