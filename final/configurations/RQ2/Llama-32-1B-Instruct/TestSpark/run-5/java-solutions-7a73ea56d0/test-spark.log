```java
import java.util.Scanner;

public class StockPrices {

    public static int maxProfit(int[] prices) {
        if (prices.length < 2) {
            return 0;
        }

        int buy = -1000, sell = 0;
        for (int price : prices) {
            int currBuy = buy;
            int currSell = sell;

            while (price > currBuy) {
                currBuy = buy;
            }
            while (price < currSell) {
                currSell = sell;
            }

            sell += Math.max(0, price - currBuy);
            buy = currBuy;
        }

        return sell;
    }

    public static int maxProfit(int[] prices) {
        if (prices.length <= 2) {
            return 0;
        }

        int[] dp = new int[prices.length];
        for (int i = 1; i < prices.length; i++) {
            dp[i] = Math.max(dp[i-1], prices[i] - prices[i-1]);
        }
        return Math.max(dp[dp.length - 1], 0);
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        System.out.print("Enter the number of days: ");
        int n = scanner.nextInt();
        int[] prices = new int[n];
        for (int i = 0; i < n; i++) {
            System.out.print("Enter price at day " + (i+1) + ": ");
            prices[i] = scanner.nextInt();
        }
        System.out.println(maxProfit(prices));
    }

    public static void testMaxProfit() {
        int[] arr1 = {7, 1, 5, 3, 6, 4};
        System.out.println(maxProfit(arr1)); // Expected: 5

        int[] arr2 = {1, 2, 3, 4, 5};
        System.out.println(maxProfit(arr2)); // Expected: 4

        int[] arr3 = {7, 6, 5, 4, 3};
        System.out.println(maxProfit(arr3)); // Expected: 0

        int[] arr4 = {1, 100, 201, 301, 400};
        System.out.println(maxProfit(arr4)); // Expected: 201
    }

    public static void main(String[] args) {
        testMaxProfit();
    }
}
```

