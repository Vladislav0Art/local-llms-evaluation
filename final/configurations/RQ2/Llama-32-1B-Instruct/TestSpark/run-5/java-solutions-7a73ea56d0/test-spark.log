import java.util.Arrays;

public class Main {

    public static int maxProfit(int[] prices) {
        if (prices.length < 2) {
            return 0;
        }

        int[] hold1 = new int[prices.length];
        int[] hold2 = new int[prices.length];

        for (int i = 1; i < prices.length; i++) {
            if (i > 1 && prices[i] - prices[i-1] > prices[i] - prices[i-2]) {
                Arrays.fill(hold1, prices[i]);
            } else {
                Arrays.fill(hold2, Math.max(prices[i], prices[i] - hold2));
            }
        }

        int sell = 0;
        for (int i : hold1) {
            sell += Math.max(0, i - hold1[0]);
        }
        return sell;
    }

    public static int maxProfit(int[] prices) {
        if (prices.length <= 3) {
            return 0;
        }

        int[] price = new int[prices.length];
        Arrays.fill(price, Integer.MIN_VALUE);

        for (int i = 1; i < prices.length; i++) {
            price[i] = Math.max(prices[i], price[i-1]);
        }
        return price[price.length - 1];
    }

    public static void main(String[] args) {
        int[] arr1 = {7, 1, 5, 3, 6, 4};
        System.out.println(maxProfit(arr1)); // Expected: 5

        int[] arr2 = {1, 2, 3, 4, 5};
        System.out.println(maxProfit(arr2)); // Expected: 4

        int[] arr3 = {7, 6, 5, 4, 3};
        System.out.println(maxProfit(arr3)); // Expected: 0

        int[] arr4 = {1, 100, 201, 301, 400};
        System.out.println(maxProfit(arr4)); // Expected: 201
    }
}
```

Note that the second solution uses two arrays to keep track of the maximum profit after selling a stock at each price point. The first solution uses a single array and checks all possible intermediate prices.

The main difference between these two solutions is how they handle edge cases where the number of days is less than 3 (i.e., when there are no previous prices). In the second solution, we initialize `price[0]` to `-Integer.MAX_VALUE` because it's impossible to make a profit with zero initial investment.
