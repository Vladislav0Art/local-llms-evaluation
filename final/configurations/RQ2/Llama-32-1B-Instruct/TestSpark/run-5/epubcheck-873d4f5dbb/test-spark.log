class OPFHandler implements OPFChecker30.OPFHandler {
    @Override
    public String toString() {
        return "";
    }

    private final OPFChecker30_OPFItemChecker itemChecker;

    public OPFHandler(OPFItem item) {
        this.itemChecker = new OPFChecker30_OPFItemChecker();
        itemChecker.init(item);
    }

    @Override
    public boolean checkItem(OPFItem item) {
        return itemChecker.checkItem(item);
    }

    @Override
    public boolean checkItemAfterResourceValidation(OPFItem item) {
        return itemChecker.checkItemAfterResourceValidation(item);
    }

    @Override
    public boolean checkSpineItem(OPFItem item) {
        return itemChecker.checkSpineItem(item);
    }
}

class OPFChecker30_OPFItemChecker implements OPFChecker30.OPFItemChecker {

    private final String packageName;

    public OPFChecker30_OPFItemChecker() {
        this.packageName = "";
    }

    @Override
    public void init(OPFItem item) {
        this.packageName = item.getPackage().getName();
    }

    @Override
    public boolean checkItem(OPFItem item) {
        return packageName.equals(item.getNamespaceURI());
    }

    @Override
    public boolean checkItemAfterResourceValidation(OPFItem item) {
        return true;
    }

    @Override
    public boolean checkSpineItem(OPFItem item) {
        return false;
    }
}
