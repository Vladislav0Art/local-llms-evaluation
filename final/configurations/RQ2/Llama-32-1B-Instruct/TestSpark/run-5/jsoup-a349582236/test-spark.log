import static org.hamcrest.Matchers.is;

public class NormalizerTest {

    @Test
    public void testNormalize() {
        // Arrange
        String input = "Hello, World!";
        String expectedOutput = "Hello, \u00e0orld!";

        // Act
        Normalizer.normalize(input, Normalizer.NFD);

        // Assert
        assertThat(expectedOutput, is(input));
    }

    @Test
    public void testNormalizeSpaceInString() {
        // Arrange
        String input = "Hello   World!";
        String expectedOutput = "Hello \u00e0orld!";

        // Act
        Normalizer.normalize(input, Normalizer.NFD);

        // Assert
        assertThat(expectedOutput, is(input));
    }

    @Test
    public void testNormalizeNonAsciiChar() {
        // Arrange
        String input = "\u00a0World!";
        String expectedOutput = "Hello, World!";

        // Act
        Normalizer.normalize(input, Normalizer.NFD);

        // Assert
        assertThat(expectedOutput, is(input));
    }

    @Test
    public void testNormalizeNoSpaces() {
        // Arrange
        String input = "Hello";
        String expectedOutput = "Hello";

        // Act
        Normalizer.normalize(input, Normalizer.NFD);

        // Assert
        assertThat(expectedOutput, is(input));
    }
}
