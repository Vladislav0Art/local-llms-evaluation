package net.e175.klaus.solarpositioning.test;

import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.Mockito.mock;
import java.time.LocalDate;
import java.util.ArrayList;
import java.util.List;

public class DeltaTPTest {

    private final DeltaT deltaT = mock(DeltaT.class);

    @BeforeEach
    public void setup() {
        LocalDate startDate = LocalDate.of(2022, 1, 1);
        LocalDate endDate = LocalDate.of(2023, 12, 31);
        List<LocalDate> dates = new ArrayList<>();
        dates.add(startDate);
        dates.add(endDate);
        for (LocalDate date : dates) {
            deltaT.estimate(date);
        }
    }

    @Test
    public void testSimpleLineCoverage() {
        LocalDate startDate = LocalDate.of(2022, 1, 15);
        LocalDate endDate = LocalDate.of(2023, 12, 31);
        List<LocalDate> dates = new ArrayList<>();
        dates.add(startDate);
        dates.add(endDate);

        for (int i = 0; i < dates.size() - 1; i++) {
            deltaT.estimate(dates.get(i));
            assertEquals(30, deltaT.estimate(dates.get(i + 1)).divide(2).getDays());
        }

        assert false;
    }

    @Test
    public void testLineCoverageWithMultipleDates() {
        LocalDate startDate = LocalDate.of(2022, 1, 15);
        LocalDate endDate = LocalDate.of(2023, 12, 31);
        List<LocalDate> dates = new ArrayList<>();
        dates.add(startDate);
        dates.add(endDate);

        for (int i = 0; i < dates.size() - 1; i++) {
            deltaT.estimate(dates.get(i));
            assertEquals(30, deltaT.estimate(dates.get(i + 1)).divide(2).getDays());
        }
    }

    @Test
    public void testLineCoverageWithMultipleDatesAndDifferentTimezones() throws InterruptedException {
        LocalDate startDate = LocalDate.of(2023, 6, 15);
        LocalDate endDate = LocalDate.of(2023, 12, 31);

        // Set the time zone of the start date to UTC
        Thread.sleep(1000); // sleep for a second

        deltaT.estimate(startDate);
        Thread.sleep(3600000); // sleep for an hour

        deltaT.estimate(endDate);
    }
}
