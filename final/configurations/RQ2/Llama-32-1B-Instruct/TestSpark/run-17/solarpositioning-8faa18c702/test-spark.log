        List<LocalDate> datesWithEstimates = new ArrayList<>();
        for (int i = 0; i < dates.size() - 1; i++) {
            datesWithEstimates.add(dates.get(i + 1));
        }

        assertEquals(30, deltaT.estimate(datesWithEstimates.get(0)).divide(2).getDays());
    }

