                builder.append(entry.getKey()).append(": ").append(((TagValueImpl) entry.getValue()).getTagName()).append(", ");
            } else {
                builder.append(entry.getKey()).append(": ").append(entry.getValue());
            }
        }

        return builder.toString().trim();
    }

    private static final Map<String, Object> EMPTYAttributes = new HashMap<>();

    public void setSelfClosing(boolean selfClosing) {
        this.selfClosing = selfClosing;
    }

    private boolean selfClosing() { return getTagSettings().containsKey("type"); }
}

public class ParseSettings {
    private boolean allowComments;

    public ParseSettings(boolean allowComments) {
        this.allowComments = allowComments;
    }

    public boolean isAllowComments() {
        return allowComments;
    }
}

