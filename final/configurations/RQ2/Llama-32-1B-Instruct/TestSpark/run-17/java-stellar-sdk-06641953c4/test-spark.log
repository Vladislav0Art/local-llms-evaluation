import javax.crypto.spec.SecretKeySpec;
import java.nio.charset.StandardCharsets;
import java.security.MessageDigest;
import java.security.NoSuchAlgorithmException;

public class EdDSASignature {
    private byte[] signature;
    private MessageDigest digest;
    private SecretKeySpec secretKeySpec;

    public EdDSASignature(String data) throws NoSuchAlgorithmException {
        this(signature, data);
    }

    public EdDSASignature(byte[] bytes) throws NoSuchAlgorithmException {
        this.signature = bytes;
        digest = MessageDigest.getInstance("Ed25519");
        secretKeySpec = new SecretKeySpec(digest.digest(), "AES");
    }

    public byte[] getSignature() {
        return signature;
    }

    @Override
    public String toString() {
        return "EdDSASignature" + "\n" +
                "  public int code() { return this.signature.length; }\n" +
                "  public String getData() { return new String(this.signature, StandardCharsets.UTF_8); }\n" +
                "  public boolean isSignatureValid(byte[] signature) { return true; }";
    }
}

