import org.junit.Before;
import org.junit.Test;

public class TextNodeTest {

    private TextNode node;
    private Appendable accum;
    private Document document;

    @Before
    public void setup() {
        node = new TextNode("Hello World");
        document = new Document();
    }

    @Test
    public void test nodeName() {
        assertEquals("TextNode", node.nodeName());
    }

    @Test
    public void test text() {
        String result = "Hello World";
        assertEquals(result, node.text());
        assertEquals(0L, node.text().length(), 2);
    }

    @Test
    public void test textCreation() {
        TextNode createdNode = node.text("Hello World");
        assertEquals(createdNode, new TextNode("Hello World"));
    }

    @Test
    public void test getWholeText() {
        String result = "Hello World";
        assertEquals(result, node.getWholeText());
        assertEquals(0L, node.getWholeText().length(), 2);
    }

    @Test
    public void test isBlank() {
        assertTrue(node.isBlank());
    }

    @Test
    public void test splitText() {
        String result = "Hello World";
        TextNode[] expectedNodes = new TextNode[1];
        expectedNodes[0] = node.text();
        assertEquals(expectedNodes, node.splitText(3));
    }

    @Test
    public void test toString() {
        String result = "TextNode { text = Hello World }";
        assertEquals(result, node.toString());
    }

    @Before
    public void setupMockDocument() {
        accum = new StringBuilder();
        document = new Document();
    }

    @Test
    public void test clone() {
        TextNode clonedNode = node.clone();
        assertEquals(clonedNode, new TextNode("Hello World"));
    }

    @Test
    public void test createFromEncoded() {
        String encodedText = "Hello World";
        TextNode createdNode = org.jsoup.nodes.TextNode.createFromEncoded(encodedText);
        assertEquals(node, createdNode);
    }
}
