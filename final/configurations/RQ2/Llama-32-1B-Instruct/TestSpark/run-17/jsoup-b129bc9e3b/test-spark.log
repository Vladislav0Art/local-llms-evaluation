public class Test {
    public static void test() {
        // Create instance of Request
        Request request = new Request();
        
        // Get response code
        int responseCode = request.getResponseCode();
        
        // Assert that response code is valid
        if (responseCode != 200 && responseCode != 201) {
            throw new AssertionError("Expected a valid response code");
        }
    }

    public static void main(String[] args) throws Exception {
        test();
    }
}

class Request {
    private String method;
    private String url;

    public Request() {}

    public void setMethod(String method) {
        this.method = method;
    }

    public void setUrl(String url) {
        this.url = url;
    }

    public String getMethod() {
        return method;
    }

    public String getUrl() {
        return url;
    }

    public int getResponseCode() {
        // Simulate response code
        if (method.equals("GET")) {
            return 200;
        } else if (method.equals("POST")) {
            return 201;
        } else {
            throw new AssertionError("Unsupported method");
        }
    }

    @Override
    public String toString() {
        return "Request{" +
                "method='" + method + '\'' +
                ", url='" + url + '\'' +
                '}';
    }
}

class UrlUtils {

    public static Request createRequest(String method, String url) {
        Request request = new Request();
        request.setMethod(method);
        request.setUrl(url);
        return request;
    }

    public static void main(String[] args) throws Exception {
        Request request1 = createRequest("GET", "http://example.com");
        System.out.println(request1);

        Request request2 = createRequest("POST", "http://example.com");
        System.out.println(request2);
    }
}
