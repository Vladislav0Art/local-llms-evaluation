public class HttpConnectionTest {
    public static void testConnect() throws IOException, URISyntaxException {
        Connection connection = connect("http://example.com");
        assert connection != null;
    }

    public static void testConnectWithProxy() throws MalformedURLException, URISyntaxException {
        Proxy proxy = new Proxy(Proxy.Type.HTTP, new InetSocketAddress("proxy.example.com", 8080));
        URL url = new URL("http://example.com?proxy=1&proxyHost=proxy.example.com");
        Connection connection = connect(url);
        assert connection.getProxy() instanceof HttpsURLConnection;
    }

    public static void testConnectWithCookieStore() throws IOException, URISyntaxException {
        CookieManager cookieManager = new CustomCookieManager();
        URL url = new URL("http://example.com?cookie1=value1&cookie2=value2");
        Connection connection = connect(url);
        assert connection.getCookieStore() instanceof CookieManager;
    }

    public static void testGetResponse() throws IOException, URISyntaxException {
        Connection connection = HttpConnectionTest.class.getClassLoader().getResourceAsStream("/static/image.jpg");
        Document doc = connection.get();
        Assert.assertEquals("image.jpg", doc.toString());
    }

    public static void testPostRequest() throws IOException, URISyntaxException {
        Request request = new Request.Builder().method(Method.POST).url("http://example.com").build();
        Connection connection = HttpConnectionTest.class.getClassLoader().getResourceAsStream("/static/image.txt");
        String body = connection.readAllBytes();
        Document doc = new Document().addText(body);
        Assert.assertEquals("POST", doc.toString());
    }

    public static void testResponse() throws IOException, URISyntaxException {
        URL url = new URL("http://example.com");
        Connection response = HttpConnectionTest.class.getClassLoader().getResourceAsStream("/static/image.jpg");
        Assert.assertEquals(200, response.getResponseCode());
    }
}

class CustomCookieManager extends CookieManager {
    @Override
    protected void parseCookies(InputStream inputStream) throws MalformedURLException, URISyntaxException {
        // Implement custom cookie parsing logic here
        super.parseCookies(inputStream);
    }

    @Override
    public void storeCookies(CookieStore cookieStore, String[] domain, String[] path, Map<String, String> headers) throws MalformedURLException, URISyntaxException {
        // Implement custom cookie storage logic here
        super.storeCookies(cookieStore, domain, path, headers);
    }
}

class Request {
    private Method method;
    private URL url;

    public Request(Method method, URL url) {
        this.method = method;
        this.url = url;
    }

    public Method getMethod() {
        return method;
    }

    public URL getUrl() {
        return url;
    }
}
