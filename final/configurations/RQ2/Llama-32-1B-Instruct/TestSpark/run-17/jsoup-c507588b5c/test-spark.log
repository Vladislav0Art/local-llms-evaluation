        }
    }

    private Node root;

    public BinaryTree() {
        this.root = null;
    }

    // Function to insert a new node into the tree
    public void insert(String value) {
        root = insert(root, value);
    }

    // Helper function to insert a new node with given value
    private Node insert(Node node, String value) {
        if (node == null) {
            return new Node(value);
        } else if (value.compareTo(node.value) < 0 && !node.isLeaf()) {
            node.left = insert(node.left, value);
        }
        if (value.compareTo(node.value) > 0 && !node.isLeaf()) {
            node.right = insert(node.right, value);
        }

        return node;
    }

    // Function to print the tree in-order
    public void inorderTraversal() {
        inorder(root);
        System.out.println();
    }

    // Helper function for in-order traversal
    private void inorder(Node node) {
        if (node != null) {
            inorder(node.left);
            System.out.print(node.value + " ");
            inorder(node.right);
        }
    }

    // Function to print the tree pre-order
    public void preorderTraversal() {
        preorder(root);
        System.out.println();
    }

    // Helper function for pre-order traversal
    private void preorder(Node node) {
        if (node != null) {
            System.out.print(node.value + " ");
            preorder(node.left);
            preorder(node.right);
        }
    }

    // Function to print the tree post-order
    public void postOrderTraversal() {
        postOrder(root);
        System.out.println();
    }

    // Helper function for post-order traversal
    private void postOrder(Node node) {
        if (node != null) {
            postOrder(node.left);
            postOrder(node.right);
            System.out.print(node.value + " ");
        }
    }

    // Function to print the tree with levels
    public void inorderWithLevels() {
        int level = 1;
        for (Node node : traverse(root, level)) {
            if (node != null) {
                if (level == 1) System.out.print(node.value + " ");
                else System.out.print(" ".repeat(4 * level - 8) + "-> " + node.value);
                level++;
            }
        }
    }

    // Helper function for inorder traversal with levels
    private Node[] traverse(Node node, int level) {
        if (node == null) return new Node[0];

        Node[] array = new Node[level];
        for (int i = 0; i < array.length; i++) {
            if (i < array.length - 1 && level % 2 != 0) array[i] = traverse(node.left, level + 1);
            array[i] = node == null ? null : node;
            if (node.right != null && !node.right.isLeaf()) array[i] = node.right;
        }

        return array;
    }

    // Function to print the tree with spaces between elements
    public void inorderWithSpaces() {
        int level = 1;
        for (Node node : traverse(root, level)) {
            if (node != null) {
                System.out.print(" ".repeat(level) + node.value);
            }
        }
    }

    // Function to print the tree with indentation
    public void indent(String indent) {
        indented();
        System.out.println(indent);
    }

    private void indented() {
        for (int i = 0; i < root.left.length(); i++) {
            System.out.print(" " + new String(new char[i]).replace("\0", " "));
        }
        for (int i = 0; i < root.right.length(); i++) {
            if (i > 0) System.out.print("|");
            System.out.print(" " + new String(new char[i]).replace("\0", " "));
        }
    }

    public static void main(String[] args) {
        BinaryTree tree = new BinaryTree();
        tree.insert("A");
        tree.insert("B");
        tree.insert("C");
        tree.insert("D");

        System.out.println("In-order traversal:");
        tree.inorderTraversal();

        System.out.println("\nPre-order traversal:");
        tree.preorderTraversal();

        System.out.println("\nPost-order traversal:");
        tree.postOrderTraversal();

        System.out.println("\nIn-order with levels:");
        tree.inorderWithLevels();

        System.out.println("\nIn-order with spaces:");
        tree.inorderWithSpaces();

        System.out.println("\nIndentation (level 1):");
        tree.indent("    ");

        System.out.println("\nIndentation (level 2):");
        tree.indent("    \n");
    }
}

