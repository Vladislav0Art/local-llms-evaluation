Here is a Java solution that uses a binary tree for storing and traversing data, along with methods to insert nodes, print the tree in-order, pre-order, and post-order, and implement rotations.

```java
public class BinaryTree {

    private Node root;

    public BinaryTree() {
        this.root = null;
    }

    // Insert node into the tree
    public void insert(String value) {
        root = insert(root, value);
    }

    // Helper function to insert a new node with given value
    private Node insert(Node node, String value) {
        if (node == null) {
            return new Node(value);
        } else if (value.compareTo(node.value) < 0) {
            node.left = insert(node.left, value);
        } else {
            node.right = insert(node.right, value);
        }

        return node;
    }

    // Function to print the tree in-order
    public void inorderTraversal() {
        preorder(root);
        System.out.println();
    }

    private void preorder(Node node) {
        if (node == null) return;

        System.out.print(node.value + " ");

        preorder(node.left);
        preorder(node.right);
    }

    // Function to print the tree pre-order
    public void preOrderTraversal() {
        System.out.print(root.value + " ");
        preorder(root.left);
        preorder(root.right);
    }

    // Function to print the tree post-order
    public void postOrderTraversal() {
        if (root != null) {
            postOrderTraversal(root.left);
            postOrderTraversal(root.right);
            System.out.println();
        }
    }

    // Helper function for pre-order traversal
    private void postOrderTraversal(Node node) {
        if (node == null) return;

        postOrderTraversal(node.left);
        postOrderTraversal(node.right);

        System.out.print(node.value + " ");
    }

