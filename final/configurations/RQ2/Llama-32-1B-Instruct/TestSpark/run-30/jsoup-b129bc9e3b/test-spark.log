public class TestMockHttpConnection {
    public static class MockHttpConnection {
        private Connection mockConnection = Mockito.mock(Connection.class);

        public String connect(String url) throws MalformedURLException {
            return (String) mockConnection.connect(url).getCode();
        }

        public Response response(String url, String... args) {
            Document document = Jsoup.parse(new URL(url));
            if (args.length == 0) {
                return new Response(200, "Hello World!", null);
            } else {
                return new Response(200, "Hello World!" + args[0], null);
            }
        }

        public Method method(Method method) {
            return mockConnection.method(method).getCode();
        }

        public boolean ignoreHttpErrors(boolean ignore) {
