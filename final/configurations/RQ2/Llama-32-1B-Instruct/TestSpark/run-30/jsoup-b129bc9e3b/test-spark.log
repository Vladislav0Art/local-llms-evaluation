        TestMockHttpConnection.mockConnection = Mockito.mock(Connection.class);

        MockHttpConnection testMockHttpConnection = new MockHttpConnection();

        String url = "http://example.com";

        System.out.println(testMockHttpConnection.connect(url));

        Response response = testMockHttpConnection.response(url, "path");
        System.out.println(response.getMessage());

        Method method = testMockHttpConnection.method(Method.getMethods()[0]);
        System.out.println(method.getName());

        System.out.println(testMockHttpConnection.ignoreHttpErrors(true));
        System.out.println(testMockHttpConnection.ignoreContentType(false));

        int bodyLength = testMockHttpConnection.data("key", "value");
        System.out.println(bodyLength);

        boolean followRedirects = testMockHttpConnection.followRedirects(true);
