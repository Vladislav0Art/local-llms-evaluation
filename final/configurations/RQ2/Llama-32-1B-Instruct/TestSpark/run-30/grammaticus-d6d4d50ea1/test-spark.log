public static String parse(String expression) {
    int index = 0;
    Kind kind = null;

    while (index < expression.length()) {

        if (Character.isDigit(expression.charAt(index))) {
            String numberValue = "";

            while (index < expression.length() && Character.isDigit(expression.charAt(index))) {
                numberValue += expression.charAt(index);
                index++;
            }

            NumberToken numberToken = new NumberToken(numberValue);

            if (!kind.equals(NumberToken.KIND.valueOf("EOF"))) {
                kind = NumberToken.Kind.valueOf(expression.substring(index, index + numberValue.length()));
            } else {

                return String.format("%s %s", expression.substring(0, index), kind == Kind.NUMBER ? "" : kind.name());
            }
        }

        if (expression.charAt(index) == '+') {
            kind = PlusToken.KIND.valueOf("EOF");
            index++;
        } else if (expression.charAt(index) == '-') {
            kind = MinusToken.KIND.valueOf("EOF");
            index++;
        } else if (expression.charAt(index) == '*') {
            kind = StarToken.KIND.valueOf("EOF");
            index++;
        } else if (expression.charAt(index) == '/') {
            kind = SlashToken.KIND.valueOf("EOF");
            index++;
        }

        if (!kind.equals(Kind.EOF)) {

            if (numberToken != null && numberValue.length() > 0) {

                return String.format("%s %c %s", expression.substring(0, index), kind == Kind.NUMBER ? " " : kind.name(), kind == Kind.NUMBER ? numberValue : numberValue.toUpperCase());
            }

            if (kind == PlusToken.KIND.valueOf("EOF")) {
                index++;
                continue;
            } else if (kind == MinusToken.KIND.valueOf("EOF")) {
                index++;
                continue;
            } else if (kind == StarToken.KIND.valueOf("EOF")) {
                index++;
                continue;
            } else if (kind == SlashToken.KIND.valueOf("EOF")) {
                index++;
                continue;
            }

            throw new RuntimeException("Invalid token at position " + index);
        }
    }

    return String.format("%s %c %s", expression.substring(0, index), kind.name(), kind == Kind.NUMBER ? "" : kind.name());
}
