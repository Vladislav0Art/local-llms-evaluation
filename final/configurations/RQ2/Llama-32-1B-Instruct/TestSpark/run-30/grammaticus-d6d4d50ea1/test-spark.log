    public static <T> void parseGrammar(Parser parser, T element) throws ParserError {
        if (element instanceof String) {
            parser.result = new Token((String) element);
        } else if (!(element instanceof List)) {
            throw new ParserError("Expected a string");
        } else {
            for (Object token : ((List<?>) element).asIterator()) {
                try {
                    parseGrammar(parser, token);
                } catch (ParserError e) {
                    System.out.println(e.getMessage());
                }
            }
        }
    }

    public static void main(String[] args) throws ParserError {
        String input = "1.2 a.b";
        String[] tokens = new String[]{input};
        Parser parser = new Parser(tokens);
        Token token = (Token) parser.parseToken();
        System.out.println(token.token);

        List<String> list = new ArrayList<>();
        list.add("c.d");
        list.add("e.f");

        parseGrammar(parser, list);
    }
}

