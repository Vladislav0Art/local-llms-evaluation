import java.util.Stack;

public class Parser {
  private Stack<String> tokens;
  private int index;

  public Parser(String expression) {
    this.tokens = new Stack<>();
    this.index = 0;

    // Tokenize the input expression
    for (int i = 0; i < expression.length(); i++) {
      char c = expression.charAt(i);
      if (c == ' ') {
        continue;
      } else if (Character.isDigit(c)) {
        String numberValue = "";
        while (index < expression.length() && Character.isDigit(expression.charAt(index))) {
          numberValue += expression.charAt(index);
          index++;
        }
        tokens.push(numberValue);
      } else {
        // If we encounter a variable, it's the start of a new identifier
        if (Character.isLetter(c)) {
          String varName = "";
          while (index < expression.length() && Character.isLetter(expression.charAt(index))) {
            varName += expression.charAt(index);
            index++;
          }
          tokens.push(varName);
        } else if (c == ' ') {
          // If we encounter a space, it's the end of the identifier
          String varName = "";
          while (index < expression.length() && expression.charAt(index) != ' ') {
            varName += expression.charAt(index);
            index++;
          }
          tokens.push(varName);
        } else {
          throw new IllegalArgumentException("Invalid character: " + c);
        }
      }
    }

    // Handle the end of the input
    if (tokens.peek().equals("+")) {
      String op = tokens.pop();
      while (!tokens.isEmpty() && tokens.peek().equals("op")) {
        op = tokens.pop();
      }
    }
  }

  public String parse() {
