import java.util.Stack;

public class Parser {
  private Stack<String> tokens;
  private int index;

  public Parser(String expression) {
    this.tokens = new Stack<>();
    this.index = 0;

    // Tokenize the input expression
    for (int i = 0; i < expression.length(); i++) {
      char c = expression.charAt(i);
      if (c == ' ') {
        continue;
      } else if (Character.isDigit(c)) {
        String numberValue = "";
        while (index < expression.length() && Character.isDigit(expression.charAt(index))) {
          numberValue += expression.charAt(index);
          index++;
        }
        tokens.push(numberValue);
      } else {
        tokens.push(String.valueOf(c));
      }
    }

    // Handle the start of the input
    if (tokens.peek().equals("+")) {
      String op = tokens.pop();
      while (!tokens.isEmpty() && tokens.peek().equals("op")) {
        op = tokens.pop();
      }
    }
  }

  public String parse() {
    // Handle the rest of the input
    while (!tokens.isEmpty()) {
      if (tokens.peek().equals("+") || tokens.peek().equals("-") || tokens.peek().equals("*") || tokens.peek().equals("/")) {
        String op = tokens.pop();
        if (op.equals("+")) {
          tokens.push(tokens.pop());
        } else if (op.equals("-")) {
          tokens.push(tokens.pop());
        } else if (op.equals("*")) {
          tokens.push(tokens.pop());
        } else if (op.equals("/")) {
          // Handle division by zero
          throw new ArithmeticException("division by zero");
        }
      } else {
        // If the token is not a variable or operator, it's likely an operand
        String value = tokens.pop();
        return value;
      }
    }

    // The input has been fully parsed
    return "";
  }
}
```
**Example usage:**

