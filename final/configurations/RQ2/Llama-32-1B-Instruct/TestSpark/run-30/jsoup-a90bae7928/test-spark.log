import javax.annotation.ParametersAreNonnullByDefault;
import java.io.Reader;
import java.io.StringReader;

public class XmlTreeBuilderTest {

    public static void main(String[] args) {
        // Scenario Test
        new XmlTreeBuilderTest().testConstructDocument();
        new XmlTreeBuilderTest().testConstructDocumentWithFragment();
        new XmlTreeBuilderTest().testConstructorWithFragment();

        // Scenario Test
        new XmlTreeBuilderTest().testParseToken();
        new XmlTreeBuilderTest().testParseTokenWithFragment();
    }

    public void testConstructDocument() {
        assert XmlTreeBuilder.parse(new StringReader("<!DOCTYPE html><html></html>"), "http://example.com") != null : "Failed to construct document";
        XmlTreeBuilder xmlTreeBuilder = new XmlTreeBuilder();
        Document doc = xmlTreeBuilder.parse(new StringReader("<!DOCTYPE html><html></html>"));
    }

    public void testConstructDocumentWithFragment() {
        assert XmlTreeBuilder.parse(StringReader("<!DOCTYPE html><html><body></body></html>"), "http://example.com") != null : "Failed to construct document with fragment";
        Document doc = new XmlTreeBuilder().parse("http://example.com", "http://example.com");
    }

    public void testConstructorWithFragment() {
        List<Node> fragments = new XmlTreeBuilder().parseFragment(new StringReader("<!DOCTYPE html><html><body></body></html>"), "http://example.com");
        assert frag.contains(1, 0); // should return the index of the first fragment
    }

    public void testParseToken() {
        assert XmlTreeBuilder.parse(new StringReader("<!DOCTYPE html><html><head></head></html>"), "http://example.com") != null : "Failed to parse token";
    }

    public void testParseTokenWithFragment() {
        Document doc = new XmlTreeBuilder().parse(StringReader("<!DOCTYPE html><html><body></body></html>"));
        assert doc.getElementById("root").hasChildNodes();
    }

    protected void testInsertNode() {
        Node node = new Element("div");
        xmlTreeBuilder.insert(node);
    }

    protected void testInsertNodeWithFragment() {
        List<Node> fragments = new XmlTreeBuilder().parseFragment(StringReader("<!DOCTYPE html><html><body></body></html>"), "http://example.com");
        assert frag.contains(1, 0); // should return the index of the first fragment
    }

    public void testInsertToken() {
        Token token = new Token();
    }

    protected void testInsertComment() {
        Comment comment = new Comment("Hello, World!");
    }

    public void testInsertCharacter() {
        char c = '!';
    }

    protected void testInsertDoctype() {
        DocumentType doctype = new DocumentType("html");
    }
}
