public class Solution {
    public int findNumbers(int[] nums) {
        int sum = 0;
        for (int num : nums) {
            if ((num & 1) == 0) {
                sum++;
            }
        }
        return sum;
    }

    public void testFindNumbers() {
        System.out.println(findNumbers(new int[]{3,2})); // Expected output: 4
        System.out.println(findNumbers(new int[]{10,9})); // Expected output: 1
        System.out.println(findNumbers(new int[]{5,1,1,5})); // Expected output: 6
