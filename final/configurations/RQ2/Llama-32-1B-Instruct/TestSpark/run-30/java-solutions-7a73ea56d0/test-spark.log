import org.junit.Test;
import static org.junit.Assert.assertEquals;
import static org.mockito.Mockito.mock;
import java.util.ArrayList;
import java.util.List;

public class OnlineStockSpanTest {

    @Test
    public void testNext_1() {
        int price = 100, result = new OnlineStockSpan().next(price);
        assertEquals(1, result);
    }

    @Test
    public void testNext_2() {
        int price = 120, result = new OnlineStockSpan().next(price);
        assertEquals(1, result);
        result = new OnlineStockSpan().next(result);
        assertEquals(2, result);
    }

    @Test
    public void testCalculateSpans_WithEmptyArray() {
        List<Integer> prices = new ArrayList<>();
        int[] result = OnlineStockSpan.calculateSpans(prices);
        assertNotNull(result);
        assertEquals(0, result[0]);
        for (int i = 1; i < result.length; i++) {
            assertEquals(i - 1, result[i]);
        }
    }

    @Test
    public void testCalculateSpans_WithSinglePrice() {
        int price = 100;
        int[] result = OnlineStockSpan.calculateSpans(new ArrayList<>());
        assertNotNull(result);
        assertEquals(1, result[0]);
    }

    @Test
    public void testCalculateSpans_WithMultiplePrices() {
        int price = 120;
        int[] prices = new int[]{80, 100, 120};
        int[] result = OnlineStockSpan.calculateSpans(prices);
        assertNotNull(result);
        assertEquals(3, result[0]);
        for (int i = 1; i < result.length; i++) {
            assertEquals(i - 1, result[i]);
        }
    }

    @Test
    public void testCalculateSpans_WithNullPrice() {
        int price = null;
        OnlineStockSpan stock = new OnlineStockSpan();
        int[] result = stock.calculateSpans(new ArrayList<>());
        assertNotNull(result);
    }

    @Test
    public void testCalculateSpans_Duplication() {
        int price1 = 100, price2 = 120;
        int[] prices = new int[]{price1, price1};
        int[] result = OnlineStockSpan.calculateSpans(prices);
        assertEquals(3, result[0]);
    }

    @Test
    public void testCalculateSpans_Duplicates() {
        int price1 = 100, price2 = 120;
        int[] prices = new int[]{price1, price2, price1};
        int[] result = OnlineStockSpan.calculateSpans(prices);
        assertEquals(3, result[0]);
    }

}
