    public void testEstimate_SpecificDeltaT() {
        MockDeltaT mockDeltaT = new MockDeltaT();
        LocalDate forDate = LocalDate.now();
        int deltaT = mockDeltaT.estimate(forDate, 30);
        assertEquals(30, deltaT); // Test with a specific value.
    }

