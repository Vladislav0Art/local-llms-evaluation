        MockDeltaT mockDeltaT = new MockDeltaT();
        LocalDate forDate = null;
        try {
            mockDeltaT.estimate(forDate);
        } catch (NullPointerException e) {
            assertEquals("For date, value cannot be null", e.getMessage());
        }
