import org.junit.Before;
import org.junit.Test;
import static org.junit.Assert.*;
import java.util.Set;

public class SafelistTest {

    private Safelist none;
    private Safelist simpleText;
    private Safelist basic;
    private Safelist basicWithImages;
    private Safelist relaxed;

    @Before
    public void setup() {
        none = new Safelist();
        simpleText = new Safelist(none);
        basic = new Safelist(simpleText);
        basicWithImages = new Safelist(basic);
        relaxed = new Safelist();
    }

    @Test
    public void testNone_SafeTagsAreNotRelaxed() {
        assertFalse(none.isSafeTag("a"));
        assertTrue(none.isSafeTag("img"));
    }

    @Test
    public void testSimpleText_SafeAttributesArePreserved() {
        Set<String> enforcedAttributes = none.getEnforcedAttributes("p");
        assertEquals("[attribute1='value1'], [attribute2='value2']", getAttributeString(enforcedAttributes));
    }

    @Test
    public void testBasic_SafeTagsAreNotRelaxed() {
        assertFalse(basic.isSafeTag("a"));
        assertTrue(basic.isSafeTag("img"));
        assertFalse(basic.isSafeTag("span"));
    }

    @Test
    public void testBasicWithImages_SafeTagsArePreservedAndImagesAreAllowed() {
        Set<String> enforcedAttributes = basicWithImages.getEnforcedAttributes("p");
        assertEquals("[attribute1='value1'], [attribute2='value2']", getAttributeString(enforcedAttributes));
    }

    @Test
    public void testRelaxed_SafeTagsAreRelaxed() {
        assertFalse(relaxed.isSafeTag("a"));
        assertTrue(relaxed.isSafeTag("img"));
    }

    private String getAttributeString(Set<String> attributes) {
        StringBuilder sb = new StringBuilder();
        for (String attribute : attributes) {
            sb.append(attribute).append('=').append(attrValue).append(", ");
        }
        return sb.toString().trim();
    }

    @Test
    public void testRelaxed_SafeAttributesAreNotEnforced() {
        Set<String> enforcedAttributes = relaxed.getEnforcedAttributes("p");
        assertEquals("[attribute1='value1'], [attribute2='value2']", getAttributeString(enforcedAttributes));
    }

    @Test
    public void testRelaxed_SafeTagsAreRelaxedAndImagesAreAllowed() {
        assertFalse(relaxed.isSafeTag("a"));
        assertTrue(relaxed.isSafeTag("img"));
        assertFalse(relaxed.isSafeTag("span"));
    }
}
