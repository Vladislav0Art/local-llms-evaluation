public class JacksonJsonTransformerTest {

    private ObjectMapper objectMapper = new ObjectMapper();
    private SimpleDateFormat simpleDateFormat = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss");
    private SimpleModule simpleModule = new SimpleModule();

    @Test
    public void [MethodUnderTest][Scenario]Test_parse() {
        String json = "{\"project_id\":\"1\",\"branch_id\":\"2\",\"language\":\"English\"}";
        String expectedJson = "{\n" +
                "  \"project_id\": \"1\",\n" +
                "  \"branch_id\": \"2\",\n" +
                "  \"language\": \"English\"\n" +
                "}";
        JacksonJsonTransformer instance = new JacksonJsonTransformer();
        T actual = instance.parse(json, Project.class);
        assertEquals(expectedJson, String.valueOf(actual));
    }

    @Test
    public void [MethodUnderTest][Scenario]Test_convert() {
        Project project = new Project();
        project.setId(1L);
        project.setBranchId(2L);
        LanguageTranslations translations = new LanguageTranslations();
        translations.setLanguage("English");
        ImportOptions options = new ImportOptions();
        options.setExportOptions(new ExportOptions());
        FileInfo file = new FileInfo();
        file.setName("file");
        String json = "{\"project_id\":\"1\",\"branch_id\":2,\"language\":\"English\",\"translations\":{\"language\":\"English\"},\"files\":[{\"name\":\"file\",\"size\":1024}]}";
        Object actual = objectMapper.readValue(json, Project.class);
        assertEquals(project, (Project) actual);
    }

    @Test
    public void [MethodUnderTest][Scenario]Test_convert() {
        String json = "{\"project_id\":\"1\",\"branch_id\":2,\"language\":\"English\"}";
        Project project = objectMapper.readValue(json, Project.class);
        assertEquals(1L, project.getId());
        assertEquals(2L, project.getBranchId());
        assertEquals("English", project.getLanguage());
    }

    @Test
    public void [MethodUnderTest][Scenario]Test_convert() {
