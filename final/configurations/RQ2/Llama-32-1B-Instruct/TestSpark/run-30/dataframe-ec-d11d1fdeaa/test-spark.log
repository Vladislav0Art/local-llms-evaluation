public class MyJoinExample {
    private DfCursor joinCursor;

    public void join(MyTable table, MyTable otherTable) {
        joinCursor = table.getCursor();
        while (joinCursor.next()) {
            String row = joinCursor.getString(0);
            int id1 = Integer.parseInt(joinCursor.getString(1));
            int id2 = Integer.parseInt(joinCursor.getString(2));

            System.out.println("Joining rows with IDs " + id1 + " and " + id2 + ": " + row);
        }
    }

    @Override
    public void forEach(Procedure<DfCursor> action) {
        action.apply(joinCursor);
    }
}

