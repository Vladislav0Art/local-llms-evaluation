import java.util.List;

public class MyTable {
    private List<String> names;
    private int ages;

    public MyTable(List<String> names, int ages) {
        this.names = names;
        this.ages = ages;
    }

    public String getName() {
        return names.get(0);
    }

    public int getAge() {
        return ages;
    }
}

public class MyJoinExample {
    private DfCursor joinCursor;

    public void join(MyTable table, List<String> otherNames) {
        if (otherNames == null || otherNames.isEmpty()) {
            throw new NullPointerException("Other names cannot be empty");
        }

        for (String name : otherNames) {
            int age = Integer.parseInt(name.split("_")[1]);
            joinCursor.add(new MyTable(Arrays.asList(name, String.valueOf(age)), age));
        }
    }

    @Override
    public void forEach(Procedure<DfCursor> action) {
        action.apply(joinCursor);
    }
}

public class MyTableTest {
    public static void main(String[] args) {
        List<String> names = List.of("John", "Alice");
        int ages = 25;
        DfJoin join = new DfJoin("MyTable", "join");

        DfResult dfResult = new MyTable(new MyTable(names, ages)).getCursor().getDfResult();
        System.out.println(dfResult);
    }
}
