import org.junit.Before;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;

import java.io.IOException;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertTrue;
import static org.mockito.ArgumentMatchers.anyString;
import static org.mockito.Mockito.when;

@RunWith(MockitoJUnitRunner.class)
public class TextNodeTest {

    @InjectMocks
    private TextNode textNode;

    @Mock
    private Appendable parent;

    @Mock
    private Document document;

    @Before
    public void setUp() {
        when(document.getHtml()).thenReturn("Hello, World!");
        when(parent.toString()).thenReturn("");
        when(document.OutputSettings().hasHTML()).thenReturn(true);
    }

    @Test
    public void nodeName_MatchTextNodeName() {
        assertEquals("text", textNode.nodeName());
    }

    @Test
    public void text_MatchTextNodesText() {
        String text = "Hello, World!";
        TextNode node = new TextNode(text);
        assertEquals(text, node.text(text));
    }

    @Test
    public void text_MatchTextNodesBlankText() {
        String text = "";
        TextNode node = new TextNode(text);
        assertTrue(node.isBlank());
    }

    @Test
    public void splitText_MatchTextNodesSplit() {
        int offset = 0;
        TextNode node = new TextNode("Hello, World!");
        when(node.splitText(offset)).thenReturn(new String[]{"Hello", "World"});
        assertEquals(new String[]{"Hello", "World"}, node.getWholeText());
    }

    @Test
    public void outerHtmlHead_MatchTextNodesOuterHtmlHead() {
        int depth = 1;
        Document.OutputSettings out = new Document.OutputSettings();
        when(document.OutputSettings().hasHTML()).thenReturn(true);
        when(parent.toString()).thenReturn("Hello, World!");
        when(document.getHtml()).thenReturn("");
        when(out.hasHTML()).thenReturn(true);

        TextNode node = new TextNode("Hello, World!");
        assertEquals("<p>Hello, World!</p>", node.outerHtmlHead(parent, depth, out));
    }

    @Test
    public void outerHtmlTail_MatchTextNodesOuterHtmlTail() {
        int depth = 1;
        Document.OutputSettings out = new Document.OutputSettings();
        when(document.OutputSettings().hasHTML()).thenReturn(true);
        when(parent.toString()).thenReturn("Hello, World!");
        when(document.getHtml()).thenReturn("");
        when(out.hasHTML()).thenReturn(true);

        TextNode node = new TextNode("Hello, World!");
        assertEquals("<p>Hello, World!</p>", node.outerHtmlTail(parent, depth, out));
    }

    @Test
    public void toString_MatchTextNodesToString() {
        String text = "Hello, World!";
        TextNode node = new TextNode(text);
        assertEquals("Hello, World!", node.toString());
    }

    @Test
    public void clone_MatchTextNodesClone() {
        TextNode node1 = new TextNode("Hello, World!");
        TextNode node2 = node1.clone();
        assertEquals(node1, node2);
    }
}
