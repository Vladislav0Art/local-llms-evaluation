package io.github.vmzakharov.ecdataframe.dsl.visitor;

import org.eclipse.collections.api.list.ListIterable;
import org.eclipse.collections.impl.utility.StringIterate;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;

import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;

public class GeneratedTest {

    private PrettyPrintVisitor visitor;
    private Printer newPrinter;

    @BeforeEach
    public void setup() {
        visitor = new PrettyPrintVisitor();
        newPrinter = mock(Printer.class);
    }

    @Test
    public void testVisitAssignExpr() {
        Expression expr = StringIterate.generate("a + b", ListIterable.of(2, 3)).toExpression();
        when(expr.toString()).thenReturn("");

        visitor.visitAssignExpr(expr);

        verify(newPrinter).print("", "a + b");
    }

    @Test
    public void testVisitBinaryExpr() {
        Expression expr = StringIterate.generate("1 - 2", ListIterable.of(1, 2)).toExpression();
        when(expr.toString()).thenReturn("");

        visitor.visitBinaryExpr(expr);

        verify(newPrinter).print("1 - 2", "1 - 2");
    }

    @Test
    public void testVisitUnaryExpr() {
        Expression expr = StringIterate.generate("Math.sin(0.5)", ListIterable.of(0.5)).toExpression();
        when(expr.toString()).thenReturn("");

        visitor.visitUnaryExpr(expr);

        verify(newPrinter).print("Math.sin(0.5)", "Math.sin(0.5)");
    }

    @Test
    public void testVisitConstExpr() {
        Expression expr = StringIterate.generate("1", ListIterable.of(1)).toExpression();
        when(expr.toString()).thenReturn("");

        visitor.visitConstExpr(expr);

        verify(newPrinter).print("1", "1");
    }

    @Test
    public void testVisitFunctionCallExpr() {
        Expression expr = StringIterate.generate(() -> newVarExpr("x"), ListIterable.of(2)).toExpression();
        when(expr.toString()).thenReturn("");

        visitor.visitFunctionCallExpr(expr);

        verify(newPrinter).print(() -> newVarExpr("x"), "(() -> newVarExpr(\"x\")");
    }

    @Test
    public void testVisitPropertyPathExpr() {
        Expression expr = StringIterate.generate("x.y", ListIterable.of("x", "y")).toExpression();
        when(expr.toString()).thenReturn("");

        visitor.visitPropertyPathExpr(expr);

        verify(newPrinter).print("x.y", "x.y");
    }

    @Test
    public void testVisitAnonymousScriptExpr() {
        Expression expr = StringIterate.generate(() -> newAnonymousScriptExpr(), ListIterable.of(1)).toExpression();
        when(expr.toString()).thenReturn("");

        visitor.visitAnonymousScriptExpr(expr);

        verify(newPrinter).print(() -> newAnonymousScriptExpr(), "(() -> newAnonymousScriptExpr())");
    }

    @Test
    public void testVisitFunctionScriptExpr() {
        Expression expr = StringIterate.generate(() -> newFunctionCallExpr("x"), ListIterable.of(2)).toExpression();
        when(expr.toString()).thenReturn("");

        visitor.visitFunctionScriptExpr(expr);

        verify(newPrinter).print(() -> newFunctionCallExpr("x"), "(() -> newFunctionCallExpr(\"x\")");
    }

    @Test
    public void testVisitStatementSequenceScript() {
        Expression expr = StringIterate.generate("1 + 2", ListIterable.of(3)).toExpression();
        when(expr.toString()).thenReturn("");

        visitor.visitStatementSequenceScript(expr);

        verify(newPrinter).print("1 + 2", "1 + 2");
    }

    @Test
    public void testVisitVarExpr() {
        Expression expr = StringIterate.generate(() -> newVarExpr(), ListIterable.of(3)).toExpression();
        when(expr.toString()).thenReturn("");

        visitor.visitVarExpr(expr);

        verify(newPrinter).print(() -> newVarExpr(), "(() -> newVarExpr())");
    }

    @Test
    public void testVisitProjectionExpr() {
        Expression expr = StringIterate.generate(() -> newProjectionExpr(1), ListIterable.of(2)).toExpression();
        when(expr.toString()).thenReturn("");

        visitor.visitProjectionExpr(expr);

        verify(newPrinter).print(() -> newProjectionExpr(1), "(() -> newProjectionExpr(1))");
    }

    @Test
    public void testVisitAliasExpr() {
        Expression expr = StringIterate.generate(() -> newAliasExpr("x"), ListIterable.of(2)).toExpression();
        when(expr.toString()).thenReturn("");

