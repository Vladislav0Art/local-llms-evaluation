import java.util.*;

class Database {
    private Map<String, Object> tables;
    private Map<String, SQLTerm> sqlQueries;

    public Database() {
        this.tables = new HashMap<>();
        this.sqlQueries = new HashMap<>();
    }

    public void createTable(String tableName) throws Exception {
        // Implementation for creating a table
        System.out.println("Creating table " + tableName);
    }

    public void insertData(String tableName, Map<String, Object> data) throws Exception {
        // Implementation for inserting data into the table
        System.out.println("Inserting data into table " + tableName + "...");
        sqlQueries.put(tableName, new SQLTerm(data));
    }

    public void queryData(String tableName, String expression) throws Exception {
        // Implementation for executing a SQL query on the table
        System.out.println("Executing SQL query on table " + tableName + "...");
        if (sqlQueries.containsKey(tableName)) {
            SQLTerm sqlTerm = sqlQueries.get(tableName);
            Object result = db.executeSQLTerm(expression, map);
            if (result instanceof List) {
                String[] arr = (String[]) result;
                for (int i = 0; i < arr.length; i++) {
                    System.out.println(arr[i]);
                }
            } else {
                System.out.println("Result: " + result);
            }
        } else {
            throw new Exception("Table not found");
        }
    }

    public void deleteData(String tableName) throws Exception {
        // Implementation for deleting data from the table
        System.out.println("Deleting data from table " + tableName + "...");
        sqlQueries.remove(tableName);
    }

    private SQLTerm executeSQLTerm(String expression, Map<String, Object> map) throws Exception {
        return new SQLTerm(expression);
    }
}

class SQLTerm {
    private String expression;
    private List<Object> result;

    public SQLTerm(String expression) {
        this.expression = expression;
    }

    @Override
    public String toString() {
        return "SQLTerm{" +
                "expression='" + expression + '\'' +
                '}';
    }
}
