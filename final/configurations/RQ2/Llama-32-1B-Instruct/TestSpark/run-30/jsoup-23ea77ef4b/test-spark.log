		w3cdom = new W3CDom();
		w3cdom.namespaceAware(true);
		Element nsElement = document.createElementNS("http://example.com/ns", "ns");
		root.appendChild(nsElement);
		actual = true;
		System.out.println(w3cdom.namespaceAware());
