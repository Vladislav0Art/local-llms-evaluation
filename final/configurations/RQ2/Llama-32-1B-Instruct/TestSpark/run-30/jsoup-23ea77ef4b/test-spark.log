, 	@Test
	public void testSelectXpathWithElement() {
		DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();
		DocumentBuilder builder = factory.newDocumentBuilder();
		Document document = builder.parse("org.jsoup.nodes.Document");
		Element element = document.getDocumentElement();
		Selector selector = element.select("*");
		NodeList nodeList = selector.findall("p");
		List<String> expectedTags = Arrays.asList("p", "span", "a", "img");
		assertEquals(expectedTags, nodeList.toArray(new String[0]));
	}
, 	@Test
	public void testSourceNodes() {
		Document document = new DocumentBuilder().build(new StringWriter());
		Element root = document.createElement("root");
		W3CDom w3cdom = new W3CDom();
		List<String> expectedTags = Arrays.asList("p", "span", "a", "img");
		List<String> actualTags = w3cdom.sourceNodes(document, element -> Arrays.asList(element.tagName()));
		assertEquals(expectedTags, actualTags);
	}
, 	@Test
	public void testContextNode() {
		Document document = new DocumentBuilder().build(new StringWriter());
		Element root = document.createElement("root");
		W3CDom w3cdom = new W3CDom();
		w3cdom.contextNode(document, root);
		System.out.println(w3cdom.toString());
	}
, 	@Test
