public class Main {
    public static void main(String[] args) {
        TestClass testObj = new TestClass();
        PublicMethod publicMethod = new PublicMethod();

        System.out.println("Before");
        testObj.x = 5;
        testObj.y = 10;

        System.out.println("\nAfter setting x and y:");
        System.out.println("x: " + testObj.x);
        System.out.println("y: " + testObj.y);

        publicMethod.add(10, 5); // Call the add method

        System.out.println("\nAfter adding 10 and 5 using PublicMethod");
