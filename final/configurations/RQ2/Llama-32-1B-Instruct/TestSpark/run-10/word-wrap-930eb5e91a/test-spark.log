            if (!trimLeft && trimRight(s)) {
                continue;
            }

            out.write(trimLeft ? s : line.trim());
            i += s.length();
        }
    }

    public static void rightTrim(BufferedReader in, StringWriter out, String lineSeparator) throws IOException {
