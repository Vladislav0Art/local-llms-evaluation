        when(deltaT.estimate(any(LoadDate.class))).thenReturn(1.0);
        double actual = deltaT.estimate(forDate);
        assertTrue(actual >= 0, "Actual estimate is negative.");
    }

    @Test
    public void testEstimate_MultipleDays_Scenario4() {
