import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;

public class JSDocTest {

    public static String documentToSoup(String html) {
        Document doc = Jsoup.parse(html);
        return doc.body().outerHtml();
    }

    public static void main(String[] args) {
        String html = "<html><body>This is a sample HTML content</body></html>";
        System.out.println(documentToSoup(html));

        String bodyHtml = documentToSoup("<body>This is another sample HTML body</body>");

        // Extract nodes
        List<String> textNodes = new ArrayList<>();
        for (Element element : bodyHtml.select("body")._elements("*")) {
            textNodes.add(element.text().trim());
        }
        System.out.println(textNodes);

        String commentNodes = documentToSoup("<!-- This is a sample HTML comment -->");
        System.out.println(commentNodes);

        // Verify expected result
        for (String node : textNodes) {
            Assert.notNull(node, "Expected a valid string of Node objects");
        }

        for (String node : commentNodes) {
            Assert.isInstanceOf(String.class, node);
        }
    }
}
```
