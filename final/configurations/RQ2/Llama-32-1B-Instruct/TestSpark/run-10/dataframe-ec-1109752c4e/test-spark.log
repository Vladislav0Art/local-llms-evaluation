class CollectingPrinter extends Printer {

    @Override
    protected String collect(String indent, Object obj) {
        StringBuilder sb = new StringBuilder();
        for (Object o : obj) {
            sb.append(indent).append(o.toString()).append("\n");
        }
        return sb.toString();
    }

    @Override
    public void print(ListIterable<?> iterable, String indent) {
        System.out.println(indent + "List [" + (iterable instanceof ListIterable ? "List" : "Collection") + "]");
        for (Object o : iterable) {
            print((ListIterable<?>) o, indent + "  ");
        }
    }

    @Override
    public void print(Collection<?> collection, String indent) {
        System.out.println(indent + "Set [" + (collection instanceof Set || collection instanceof Collection ? "Collection" : "Set") + "]");
        for (Object o : collection) {
            print((Collection<?>) o, indent + "  ");
        }
    }

    @Override
    public void print(Set<?> set, String indent) {
        System.out.println(indent + "Map [" + (set instanceof Map ? "Map" : "Set") + "]");
        for (Object o : set) {
            print((Map<?, ?>) o, indent + "  ");
        }
    }

}

