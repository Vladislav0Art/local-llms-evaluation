        PrettyPrintVisitor prettyPrintVisitor = new CollectingPrinterTest();
        prettyPrintVisitor.visitAssignExpr(new AssignExpr(5, 10));
        prettyPrintVisitor.visitBinaryExpr(new BinaryExpr(2, 3, "add", true, false));
        prettyPrintVisitor.visitUnaryExpr(new UnaryExpr(1, "square"));
