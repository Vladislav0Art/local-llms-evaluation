    }

    @Override
    public void visitUnaryExpr(UnaryExpr expr) {
        String exprToString = exprToString(expr);
        String printer = new CollectingPrinter();
        System.out.println(printer.print(expr.getLeftOperand().toString(), "  "));
        System.out.println(printer.print(new CollectingPrinter().collect(" ", expr.getRightOperand()), "  "));
    }

    @Override
    public void visitConstExpr(Value expr) {
        String exprToString = exprToString(expr);
        System.out.println("ConstExpr[" + exprToString + "]");
    }

}

public class Main {
