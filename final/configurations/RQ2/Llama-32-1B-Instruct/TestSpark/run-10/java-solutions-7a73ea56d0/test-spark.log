import java.util.*;

public class Solution {
    public String findLengthOfShortestPath(String[][] graph, char startChar) {
        int rows = graph.length;
        int cols = graph[0].length;

        // Check if the start node is out of bounds
        for (int i = 0; i < rows; i++) {
            for (int j = 0; j < cols; j++) {
                String rowStart = getRow(i, startChar);
                String colStart = getCol(j, startChar);

                // Check if the end node is out of bounds
                if (i == rows - 1 || j == cols - 1) continue;

                String rowEnd = getRow(i + 1, endChar);
                String colEnd = getCol(j + 1, endChar);

                // Check if there is a path between the start and end nodes
                if (rowStart.equals(rowEnd) && colStart.equals(colEnd)) {
                    return "Shortest distance: " + rows * cols - i - j;
                }
            }
        }

        return "";
    }

    private String getRow(int row, char c) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < row; i++) {
            sb.append(c);
        }
        return sb.toString();
    }

    private String getCol(String col, char c) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < col.length(); i++) {
            sb.append(c);
        }
        return sb.toString();
    }

    public static void main(String[] args) {
        Solution solution = new Solution();

        String[][] graph = {
                {"A", "B", "C"},
                {"D", "E", "F"},
                {"G", "H", "I"}
        };

        char startChar = 'A';

        System.out.println(solution.findLengthOfShortestPath(graph, startChar));
    }
}
