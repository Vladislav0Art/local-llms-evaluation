import org.jsoup.Connection;
import org.junit.jupiter.api.Test;

import java.io.IOException;
import java.util.ArrayList;
import java.util.Collection;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

public class HttpConnectionTest {

    public static void main(String[] args) {
        HttpConnection.create("http://example.com");
    }

    @Test
    public void urlTest() {
        HttpConnection connection = new HttpConnection();
        assertEquals("http://example.com", connection.url("https://example.com"));
    }

    @Test
    public void urlStringTest() {
        HttpConnection connection = new HttpConnection();
        assertEquals("https://example.com", connection.url("https://example.com"));
    }

    @Test
    public void proxyTest() {
        HttpConnection connection = new HttpConnection(new Proxy("localhost", 8080));
        assertEquals("http://localhost:8080", connection.proxy(null));
    }

    @Test
    public void userAgentTest() {
        HttpConnection connection = new HttpConnection();
        String userAgent = "My User Agent";
        assertEquals(userAgent, connection.userAgent(userAgent));
    }

    @Test
    public void timeoutTest() {
        HttpConnection connection = new HttpConnection(1000);
        assertEquals(1000, connection.timeout(1000));
    }

    @Test
    public void maxBodySizeTest() {
        HttpConnection connection = new HttpConnection();
        assertEquals(1024 * 1024, connection.maxBodySize(1024 * 1024));
    }

    @Test
    public void followRedirectsTest() {
        HttpConnection connection = new HttpConnection(true);
        assertEquals(false, connection.followRedirects(true));
    }

    @Test
    public void referrerTest() {
        HttpConnection connection = new HttpConnection();
        assertEquals("", connection.referrer(""));
    }

    @Test
    public void methodTest() {
        HttpConnection connection = new HttpConnection(Method.GET);
        assertEquals(Method.GET, connection.method(connection));
    }

    @Test
    public void ignoreHttpErrorsTest() {
        HttpConnection connection = new HttpConnection();
        assertEquals(true, connection.ignoreHttpErrors(false));
    }

    @Test
    public void ignoreContentTypeTest() {
        HttpConnection connection = new HttpConnection();
        assertEquals(true, connection.ignoreContentType(false));
    }

    @Test
    public void dataTest() {
        HttpConnection connection = new HttpConnection();
        Map<String, String> data = new HashMap<>();
        data.put("key", "value");
        assertEquals(data, connection.data("key", "value"));
    }

    @Test
    public void dataKeysTest() {
        HttpConnection connection = new HttpConnection();
        List<Connection.KeyVal> keyvals = new ArrayList<>();
        keyvals.add(new Connection.KeyVal("key1", "value1"));
        assertEquals(keyvals, connection.dataCollection("key1"));
    }

    @Test
    public void dataCollectionTest() {
        HttpConnection connection = new HttpConnection();
        Map<String, String> data = new HashMap<>();
        data.put("key1", "value1");
        data.put("key2", "value2");
        assertEquals(data, connection.dataCollection("key1"));
    }

    @Test
    public void requestTest() {
        HttpConnection connection = new HttpConnection();
        assertEquals(200, connection.request().responseCode());
    }

    @Test
    public void requestResponseTest() {
        HttpConnection connection = new HttpConnection();
        assertEquals(200, connection.response().responseCode());
    }

    @Test
    public void postDataCharsetTest() {
        HttpConnection connection = new HttpConnection();
        String charset = "UTF-8";
        assertEquals(charset, connection.postDataCharset(charset));
    }
}
