package com.ezylang.evalex.parser;

import static com.ezylang.evalex.parser.Token.TokenType.*;
import com.ezylang.evalex.config.ExpressionConfiguration;
import com.ezylang.evalex.config.FunctionDictionaryIfc;
import com.ezylang.evalex.config.OperatorDictionaryIfc;
import com.ezylang.evalex.functions.FunctionIfc;
import com.ezylang.evalex.operators.OperatorIfc;
import com.ezylang.evalex.parser.Token.TokenType;
import java.util.ArrayList;
import java.util.List;

public class Tokenizer {

    public Tokenizer(String expressionString, ExpressionConfiguration configuration) {
        this.expressionString = expressionString;
        this.configuration = configuration;
    }

    public List<Token> parse() throws ParseException {
        return parseStringLiteral();
    }

    public Token parseStringLiteral() throws ParseException {
        String literal = expressionString.substring(0, expressionString.indexOf(' '));
        return new Token(literal, TokenType.SPLITTER);
    }
}

class TokenizerTest {

    private String expressionString;
    private ExpressionConfiguration configuration;
    private List<Token> result;

    public TokenizerTest(String expressionString) {
        this.expressionString = expressionString;
        this.configuration = new ExpressionConfiguration();
        this.result = new ArrayList<>();
    }

    @Test
    public void testParseStringLiteral() throws ParseException {
        Tokenizer tokenizer = new Tokenizer(expressionString, configuration);
        List<Token> expected = new ArrayList<>();
        expected.add(new Token("s", TokenType.SPLITTER));
        tokenizer.parse();
        assertEquals(expected.size(), result.size());
        for (int i = 0; i < expected.size(); i++) {
            assertEquals(expected.get(i).toString(), result.get(i).toString());
        }
    }

    @Test
    public void testParseInvalidToken() throws ParseException {
        Tokenizer tokenizer = new Tokenizer(expressionString, configuration);
        List<Token> expected = new ArrayList<>();
        expected.add(new Token("*", TokenType.FROM));
        tokenizer.parse();
        assertEquals(expected.size(), result.size());
        for (int i = 0; i < expected.size(); i++) {
            assertEquals(expected.get(i).toString(), result.get(i).toString());
        }
    }

    @Test
    public void testParseMultipleTokens() throws ParseException {
        Tokenizer tokenizer = new Tokenizer(expressionString, configuration);
        List<Token> expected = new ArrayList<>();
        expected.add(new Token("*", TokenType.FROM));
        expected.add(new Token("2", TokenType.NUMBER));
        expected.add(new Token("+", TokenType.ADD));
        expected.add(new Token("5", TokenType.NUMBER));
        tokenizer.parse();
        assertEquals(expected.size(), result.size());
        for (int i = 0; i < expected.size(); i++) {
            assertEquals(expected.get(i).toString(), result.get(i).toString());
        }
    }

}

class TokenizerTestHelper {

    public String expressionString;
    public ExpressionConfiguration configuration;

    public List<Token> parse(String expressionString, ExpressionConfiguration configuration) throws ParseException {
        Tokenizer tokenizer = new Tokenizer(expressionString, configuration);
        return tokenizer.parse();
    }

}
