import javax.xml.parsers.DocumentBuilderFactory;
import javax.xml.parsers.ParserConfigurationException;

import org.w3c.dom.Document;
import org.xml.sax.InputSource;
import org.xml.sax.SAXException;

public class XmlGenerator {

    public static String generateXml(String xmlString) {
        try (InputSource inputSource = new InputSource(new java.io.StringReader(xmlString))) {
            DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();
            Document document = factory.newDocumentBuilder().parse(inputSource);
            
            return generateDocument(document, null);  // Output XML
        } catch (ParserConfigurationException | SAXException e) {
            throw new RuntimeException("Failed to parse XML", e);
        }
    }

    public static String generateDocument(Document document, InputSource inputSource) {
        javax.xml.transform.OutputKeys keys = OutputKeys.FORMATTING;
        
        try (java.io.PrintWriter writer = new java.io.PrintWriter(new java.io.FileWriter("output.xml"))) {
            transformer = TransformerFactory.newInstance().newTransformer();
            
            transformer.setOutputProperty(OutputKeys.INDENT, "yes");
            transformer.setOutputProperty("{http://xml.apache.org/xslt}indent-amount", "2");
            
            // Transform the XML to an HTML file
            OutputHTML result = new OutputHTML(writer, false);
            transformer.transform(new DOMSource(document), new javax.xml.transform.stream.StreamResult(result));
        } catch (TransformerException e) {
            throw new RuntimeException("Failed to generate XML", e);
        }
        
        return result.toString();
    }

    public static void main(String[] args) throws Exception {
        String xmlString = "<root><person><name>John Doe</name><age>30</age></person></root>";
        System.out.println(generateXml(xmlString));  // Output XML

        // Read an XML input from a file
        InputStream inputStream = new FileInputStream("example.xml");
        System.out.println(generateXml(inputStream.toString()));  // Output XML

        // Read an XML input from a string
        String xmlString = "<root><person><name>John Doe</name><age>30</age></person></root>";
        Document document = createOutputHtml(new InputSource(xmlString));
        System.out.println(generateDocument(document, null));  // Output XML

    }
}
