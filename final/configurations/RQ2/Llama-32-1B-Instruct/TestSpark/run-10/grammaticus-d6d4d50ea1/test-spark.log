import java.util.*;

public class Test {

    public static void main(String[] args) {
        Map<String, String> map = ImmutableMap.of("noun", "value");
        System.out.println(map);
    }

    public static int getOtherNoun(Map<String, String> map) {
        return map.getOrDefault("otherNoun", "");
    }
}

class ImmutableMap<K, V> extends LinkedHashMap<K, V> {

    private final Comparator<? super K> comparator;

    public ImmutableMap(K key, V value) {
        super(key, value);
        this.comparator = (k1, k2) -> comparator.compare(k1, k2);
    }

    public int size() {
        return super.size();
    }

    @Override
    protected boolean removeEldestEntry(Map.Entry<K, V> eldest) {
        return size() > 10;
    }
}
