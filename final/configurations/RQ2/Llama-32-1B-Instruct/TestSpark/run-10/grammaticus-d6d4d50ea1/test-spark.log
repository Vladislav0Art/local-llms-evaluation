```java
import java.util.*;

public class Test {

    public static void main(String[] args) {
        Map<String, String> map = ImmutableMap.of("noun", "value");
        
        // Get all other nouns from the input map
        Set<String> otherNouns = getOtherNoun(map);
        
        System.out.println(otherNouns);

        if (map.containsKey("otherNoun")) {
            System.out.println("There is an existing 'otherNoun' entry in the map");
        } else {
            System.out.println("No 'otherNoun' entry found in the map");
        }
    }

    public static Set<String> getOtherNoun(Map<String, String> map) {
        return map.keySet().stream()
                .filter(key -> key.equals("otherNoun") || !map.getOrDefault(key, "").equals(""))
                .collect(Collectors.toSet());
    }
}
```

