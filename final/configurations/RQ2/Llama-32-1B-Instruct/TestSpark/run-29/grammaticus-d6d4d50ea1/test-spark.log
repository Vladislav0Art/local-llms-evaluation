        TestUtils.createGrammaticalTermMap(new HashMap<>(), true)
                .hashCode()
                .assertThat(123L);
    }

    @Test
    public void testIsSkinnyMethod() {
        TestUtils.createGrammaticalTermMap(new HashMap<>(), true)
                .isSkinny()
                .assertThat(true);
    }

