public class WordWrapTest {

    @Test
    public void testWordWrapFromReader() {
        Preconditions.checkNotNull(new BufferedReader(new InputStreamReader(System.in)));
        Preconditions.checkNotNull(new PrintWriter(System.out));
        String resource = "test.txt";
        Builder builder = WordWrap.fromClasspathUtf8(resource);
        String text = "This is a very long text that needs to be wrapped.";
        assertEquals("very long text", WordWrap.wordWrap(new BufferedReader(new InputStreamReader(System.in)), new OutputStreamWriter(System.out), "\n", 20, null, null, true, false), text);
    }

    @Test
    public void testWordWrapFromClasspathUtf8() {
        Preconditions.checkNotNull(new FileInputStream(new File("test.txt")));
        Preconditions.checkNotNull(new PrintStream(new FileOutputStream("output.txt")));
        String resource = "test.txt";
        Builder builder = WordWrap.fromClasspathUtf8(resource);
        String text = "This is a very long text that needs to be wrapped.";
        assertEquals("very long text", WordWrap.wordWrap(new FileInputStream(new File("test.txt")), new PrintStream(new FileOutputStream("output.txt")), "\n", 20, null, null, true, false), text);
    }

    @Test
    public void testWordWrapFromClasspath() {
        Preconditions.checkNotNull(new FileInputStream(new File("test.txt")));
        Preconditions.checkNotNull(new BufferedReader(new InputStreamReader(System.in)));
        String resource = "test.txt";
        Builder builder = WordWrap.fromClasspath(resource);
        String text = "This is a very long text that needs to be wrapped.";
        assertEquals("very long text", WordWrap.wordWrap(new FileInputStream(new File("test.txt")), new BufferedReader(new InputStreamReader(System.in)), "\n", 20, null, null, true, false), text);
    }

    @Test
    public void testWordWrapFromCharSequence() {
        Preconditions.checkNotNull(new StringReader(new char[] {'a', 'b'}));
        Preconditions.checkNotNull(new PrintStream(new OutputStreamWriter(System.out)));
        StringBuilder sb = new StringBuilder();
        WordWrap.wordWrap(new BufferedReader(new InputStreamReader(System.in)), new OutputStreamWriter(System.out), "\n", 20, null, null, true, false);
        assertEquals("ab\nba", WordWrap.rightTrim(sb.toString()));
    }

    @Test
    public void testIsWhitespace() {
        assertEquals(true, WordWrap.isWhitespace("   "));
        assertEquals(false, WordWrap.isWhitespace("\n"));
    }

    @Test
    public void testLeftTrim() {
        StringBuilder sb = new StringBuilder();
        Preconditions.checkNotNull(new StringBuilder2(sb));
        WordWrap.leftTrim(sb);
        assertEquals(7, sb.length());
    }
}
