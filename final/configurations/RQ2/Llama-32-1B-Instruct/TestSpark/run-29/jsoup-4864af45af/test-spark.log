        // Update documents
        service.updateDocument("document1", "New Name");

        // Get all tags
        List<Tag> tags = tagService.getAllTags();
        System.out.println("All Tags: ");
        for (Tag tag : tags) {
            System.out.println(tag.getName());
        }

        // Delete a tag
        service.deleteTag("tag1", "Tag 1 Name");

        // Update document name
        service.updateDocumentName("document2", "New Name");

        // Get all tags after update
        List<Tag> updatedTags = tagService.getAllTags();
        System.out.println("All Tags: ");
        for (Tag tag : updatedTags) {
            System.out.println(tag.getName());
        }
    }
