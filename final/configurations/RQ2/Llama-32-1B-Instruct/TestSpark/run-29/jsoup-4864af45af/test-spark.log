        List<String> tags = getTags(documentId);
        if (tags != null) {
            for (int i = 0; i < tags.size(); i++) {
                if (tags.get(i).equals(tag)) {
                    tags.remove(i);
                    saveDocument(documentId, tags);
                    break;
                }
            }
        } else {
            Document document = new Document();
            document.setContent("No content provided");
            document.setTags(new ArrayList<>());
            addTag(documentId, "tag1", document.getContent());
            saveDocument(documentId, document.getTags());
        }
    }
}

