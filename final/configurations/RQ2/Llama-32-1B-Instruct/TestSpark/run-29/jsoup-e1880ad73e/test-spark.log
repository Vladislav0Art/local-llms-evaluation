        URLBuilder urlBuilder = build();
        urlBuilder.appendKeyVal(emptyKV);

        // Act
        String result = urlBuilder.build().appendKeyVal(emptyKV).toString();

        // Assert
        assertNotEquals(null, result);
    }

    @Test
    public void appendKeyValInvalidKV() throws URISyntaxException {
        // Arrange
        Connection.KeyVal invalidKV = new Connection.KeyVal("invalid", "value");
        URLBuilder urlBuilder = build();
        urlBuilder.appendKeyVal(invalidKV);

        // Act
        String result = urlBuilder.build().appendKeyVal(invalidKV).toString();

        // Assert
        assertNotEquals(null, result);
    }

    @Test
    public void getScheme() {
        // Arrange
        URLBuilder urlBuilder = build();
        Document doc = Jsoup.connect(urlBuilder.getURI()).get();

        // Act
