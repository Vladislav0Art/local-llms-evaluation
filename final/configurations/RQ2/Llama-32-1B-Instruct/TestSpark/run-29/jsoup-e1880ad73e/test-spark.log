import org.jsoup.Connection;
import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import static org.jsoup.helper.DataUtil.UTF_8;

final class UrlBuilder {
    public String build() throws URISyntaxException {
        return Jsoup.connect(getURI()).get().toString();
    }

    private String getURI() {
        Connection conn = createConnection("http://example.com");
        URI uri = new URI(conn.getScheme(), conn.getHost(), conn.getPort() == -1 ? "https" : conn.getPort());
        return uri.toString();
    }

    public void appendKeyVal(Connection.KeyVal kv) throws UnsupportedEncodingException {
        String value = URLDecoder.decode(kv.getValue(), UTF_8);
        Connection.KeyVal keyVal = new Connection.KeyVal(kv.getKey(), value);
        appendKeyVal(keyVal);
    }
}

class UrlUtil {

    public static String getScheme(Connection conn) throws URISyntaxException {
        return conn.getURI().getScheme();
    }

    public static String getHost(Connection conn) throws URISyntaxException {
        return conn.getURI()..getHost();
    }

    public static String getProtocol(Connection conn) throws URISyntaxException {
        return conn.getURI().getPort() == -1 ? "https" : "";
    }

    public static int getPort(Connection conn) throws URISyntaxException {
        return conn.getURI().getPort();
    }
}

public class UrlBuilderTest {

    @Test
    public void appendKeyValEmptyInput() throws URISyntaxException {
        // Arrange
        Connection.KeyVal emptyKV = new Connection.KeyVal();

        // Act
        String result = UrlBuilder.build().appendKeyVal(emptyKV);

        // Assert
        assertNotEquals(null, result);
    }

    @Test
    public void appendKeyValValidInput() throws URISyntaxException {
        // Arrange
        Connection.KeyVal keyVal = new Connection.KeyVal("key", "value");
        URLBuilder urlBuilder = build();
        urlBuilder.appendKeyVal(keyVal);

        // Act
        String result = urlBuilder.build().appendKeyVal(keyVal).toString();

        // Assert
        assertNotEquals(null, result);
    }

    @Test
    public void appendKeyValEmptyKV() throws URISyntaxException {
        // Arrange
