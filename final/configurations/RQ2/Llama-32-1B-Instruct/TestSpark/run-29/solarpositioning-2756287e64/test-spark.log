        this.position = position;
    }

    public double getTime() {
        return time;
    }

    public void setTime(double time) {
        this.time = time;
    }
}

public class TestSolarPosition {
    public static void main(String[] args) {
        // Create a new SolarPosition object
        SolarPosition position1 = new SolarPosition("Sun 40.72° N", 0);
        
        System.out.println(position1.getPosition());
        
        // Update the time
        position1.setPosition("Sun 41.00° N");
        System.out.println(position1.getPosition());
        
        // Change the solar position
        position1.setPosition("Moon 23.56° W");
        System.out.println(position1.getPosition());

        // Calculate the distance of a location from the Sun (in degrees)
        double sunPosition = new SolarPosition("Sun", 0);
        double distanceFromSun = sunPosition.getPosition();
        System.out.println("Distance from the Sun: " + distanceFromSun);

        // Set the time to a specific date and time
        String dateString = "2023-03-01";
        solarPosition.setTime(dateString);

        // Print the solar position for the set date and time
        sunPosition.setPosition(dateString);
        System.out.println(sunPosition.getPosition());
    }
}

