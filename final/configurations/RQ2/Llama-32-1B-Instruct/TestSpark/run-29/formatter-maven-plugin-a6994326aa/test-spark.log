import java.io.*;
import java.util.*;

public class TestCSS {
    public static void testGeneratePublicStylesheet() {
        // Create a new CSSStyleSheet object
        CssStyleSheetImpl stylesheet = new CssStyleSheetImpl();

        Scanner scanner = new Scanner(System.in);

        System.out.println("Enter the path to your stylesheets (comma-separated):");
        String[] paths = scanner.nextLine().split(",");

        // Process each style sheet path
        for (String path : paths) {
            System.out.println("Processing stylesheet: " + path);

            try {
                // Create a new StyleSheet object
                CssStyleSheet stylesheet = new CssStyleSheetImpl();

                // Parse the stylesheets and add them to the stylesheet
                Map<String, String> stylesheets = parseStylesheet(path);
                stylesheet.addStylesheet(parseCss(stylesheetlesesPath: path));

                // Add the stylesheet to the CSSStyleSheet object
                stylesheet.addStyleheet(stylesheet.getStylesheet());

                // Append the stylesheet to the DOM
                for (Map.Entry<String, String> entry : stylesheets.entrySet()) {
                    System.out.println("Processing stylesheet: " + entry.getKey());
                    try {
                        // Create a new StyleSheet object
                        CssStyleSheet stylesheet = new CssStyleSheetImpl();

                        // Add the stylesheets to the stylesheet
                        stylesheet.addStylesheet(parseCss(entry.getValue()));

                        // Set the style sheet of the document
                        getOutputStream().setStyleSheet(stylesheet.getStylesheet());

                        System.out.println("Processed stylesheet: " + entry.getKey() + ", " + entry.getValue());
                    } catch (Exception e) {
                        System.out.println("Error processing stylesheet: " + e.getMessage());
                    }
                }

            } catch (Exception e) {
                System.out.println("Error parsing style sheet: " + e.getMessage());
            }
        }
    }

    // Helper method to parse a single stylesheet path
    public static Map<String, String> parseStylesheet(String path) {
        Map<String, String> stylesheets = new HashMap<>();
        String[] parts = path.split(":");
        if (parts.length != 2) {
            throw new RuntimeException("Invalid CSS path: " + path);
        }
        String stylesheetPath = parts[0];
        String stylesheetsPath = parts[1];

        // Parse the stylesheets and add them to the map
        try {
            // Create a new InputReader object
            InputStream inputStream = new FileInputStream(stylesheetPath);

            // Use an HTML parser to parse the contents of the stylesheet file
            Jsoup jsoup = Jsoup.parse(inputStream);
            String css = jsoup.toString();

            // Split the CSS into individual styles
            String[] lines = css.split("}");

            for (String line : lines) {
                if (!line.isEmpty()) { // Ignore empty lines
                    String[] parts = line.split(",");
                    if (parts.length == 3) {
                        stylesheets.put(parts[0], parts[1]);
                    }
                }
            }

        } catch (Exception e) {
            System.out.println("Error parsing stylesheet: " + e.getMessage());
        }

        return stylesheets;
    }

    // Helper method to parse a single CSS line
    public static String parseCss(String line) {
        try {
            Jsoup soup = Jsoup.parse(line);
            return soup.toString().trim();
        } catch (Exception e) {
            System.out.println("Error parsing CSS: " + e.getMessage());
            return "";
        }
    }

    // Helper method to print the contents of an object
    public static void print(Object obj, int indent) {
        for (int i = 0; i < indent; i++) {
            System.out.print("  ");
        }
        System.out.println(obj);
        for (java.util.Map.Entry<Object, Object> entry : ((Map<String, String>) obj).entrySet()) {
            print(entry.getValue(), indent + 1);
        }
    }

    public static void main(String[] args) {
        testGeneratePublicStylesheet();
    }
}
