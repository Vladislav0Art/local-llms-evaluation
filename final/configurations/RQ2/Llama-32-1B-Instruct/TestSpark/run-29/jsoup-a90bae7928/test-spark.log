```java
import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.select.Elements;

public class HtmlParser {

    public static void main(String[] args) {
        String html = "<html><head></head><body>Hello <b>World!</b></body></html>";
        
        // Parse the HTML and print out the text of all `a` tags with an href attribute
        Document document = parseHtml(html);
        Elements links = document.getElementsByTag("a");
        for (Element tag : links) {
            if (tag.attr("href") != null && !tag.attr("href").isEmpty()) {
                System.out.println(tag.attr("href"));
            }
        }
    }

    public static Document parseHtml(String html) {
        return Jsoup.parse(html);
    }
}
```

This code will print out the `href` attribute of all `a` tags in the given HTML, excluding any that may not be a valid link.

