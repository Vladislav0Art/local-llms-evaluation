public class Main {

    public String stripLeadingWhitespace(String str) {
        return str.replaceAll("^\\s+", "");
    }

    public boolean isStringEmpty(String str) {
        if (str == null || str.isEmpty()) {
            return true;
        } else {
            return false;
        }
    }

    public int normaliseWhitespace(String str, int length) {
        if (str.length() > length) {
            str = str.substring(0, length);
        }
        return str.length();
    }

    public String lastCharIsWhitespace(String str) {
        return str.charAt(str.length() - 1).equals(' ');
    }

    public boolean isStringNullOrEmpty(String str) {
        if (str == null || str.isEmpty()) {
            return true;
        } else {
            return false;
        }
    }

    public void testStripLeadingWhitespace() {
        System.out.println(stripLeadingWhitespace("   Hello World  "));
        System.out.println(stripLeadingWhitespace(""));
    }

    public void testIsStringEmpty() {
        System.out.println(isStringEmpty("Hello World")); // true
        System.out.println(isStringEmpty(null)); // true
        System.out.println(isStringEmpty("Hello"));
        System.out.println(isStringEmpty(""));
    }

