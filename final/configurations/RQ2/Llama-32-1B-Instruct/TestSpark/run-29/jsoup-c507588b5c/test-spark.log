import org.junit.Test;
import org.jsoup.nodes.TextNode;
import org.mockito.Mockito;

public class TextNodeTest {

    @Test
    public void nodeName_test() {
        String text = "Hello, World!";
        TextNode node = new TextNode(text);
        assertEquals("text", node.nodeName());
    }

    @Test
    public void text_text() {
        String text = "This is a test.";
        TextNode node = new TextNode(text);
        assertEquals("text", node.text());
    }

    @Test
    public void text_blank() {
        String text = "";
        TextNode node = new TextNode(text);
        assertFalse(node.isBlank());
    }

    @Test
    public void getWholeText_test() {
        String text = "Hello, World!";
        TextNode node = new TextNode(text);
        assertEquals("Hello, World!", node.getWholeText());
    }

    @Test
    public void isBlank_test() {
        String text = "Hello, World! ";
        TextNode node = new TextNode(text);
        assertFalse(node.isBlank());
    }

    @Test
    public void splitText_test() {
        String text = "Hello, World!";
        TextNode node = new TextNode(text);
        assertEquals(8, node.splitText(0).text().length());
        // assertEqual(5, node.splitText(2));
    }

    @Test
    public void outerHtmlHead_test() throws IOException {
        Appendable accum = Mockito.mock(Appendable.class);
        Document doc = new Document();
        StringBuilder sb = Mockito.mock(StringBuilder.class);
        Mockito.when(accum.toString()).thenReturn(sb.toString());
        Mockito.when(doc.outerHtmlTail(0, null)).thenReturn(sb.toString());
        TextNode node = new TextNode("Hello, World!");
        node.outerHtmlHead(accum, 1, doc.outputSettings());
        assertEquals(sb.toString(), accum.toString());
    }

    @Test
    public void outerHtmlTail_test() {
        Appendable accum = Mockito.mock(Appendable.class);
        Document doc = new Document();
        StringBuilder sb = Mockito.mock(StringBuilder.class);
        Mockito.when(accum.toString()).thenReturn(sb.toString());
        Mockito.when(doc.outerHtmlHead(0, null)).thenReturn(sb.toString());
        TextNode node = new TextNode("Hello, World!");
        node.outerHtmlTail(1, doc.outputSettings());
        assertEquals(sb.toString(), accum.toString());
    }

    @Test
    public void clone_test() {
        String text = "This is a test.";
        TextNode node = new TextNode(text);
        TextNode cloned = node.clone();
        assertNotSame(node, cloned);
    }

    @Test
    public void createFromEncoded_test() {
        String encodedText = Mockito.mock(String.class);
        TextNode node = TextNode.createFromEncoded(encodedText);
        assertEquals("This is a test.", node.text());
    }

    @Test
    public void normaliseWhitespace_test() {
        String text = "   Hello, World!  ";
        TextNode node = new TextNode(text);
        assertEquals(5, node.stripLeadingWhitespace().length());
        // assertEqual(4, node.stripLeadingWhitespace("Hello, World!"));
    }

    @Test
    public void stripLeadingWhitespace_test() {
        String text = "   Hello, World!";
        TextNode node = new TextNode(text);
        assertEquals(8, node.stripLeadingWhitespace().length());
        // assertEqual(3, node.stripLeadingWhitespace(""));
    }

    @Test
    public void lastCharIsWhitespace_test() {
        StringBuilder sb = Mockito.mock(StringBuilder.class);
        assertEquals(true, TextNode.lastCharIsWhitespace(sb));
        sb.setLength(0);
        assertEquals(false, TextNode.lastCharIsWhitespace(sb));
    }
}
