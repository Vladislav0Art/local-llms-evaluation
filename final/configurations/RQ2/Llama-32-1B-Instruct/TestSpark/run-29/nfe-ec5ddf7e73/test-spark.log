import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;

public class Nota {

    public String codigoInterno(int valor) {
        return String.valueOf(valor);
    }

    public String placa(String numero) {
        return "ABC" + numero;
    }

    public String renavam(String nombre) {
        return "Renavam" + nombre;
    }

    public String tara(String marca) {
        return "Tara" + marca;
    }

    public int capacidadeKG(int valor) {
        return valor * 100;
    }

    public double capacidadeM3(int valor) {
        return (double) valor / 300.0;
    }
}

@Test
public void testCodigoInterno() {
    assertEquals("100", Nota.codigoInterno(100));
}

@Test
public void testPlaca() {
    assertEquals("ABC123", Nota.placa("001"));
}

@Test
public void testRenavam() {
    assertEquals("Renavam", Nota.renavam("Fernando"));
}

@Test
public void testTara() {
    assertEquals("Tara", Nota.tara("Toyota"));
}

@Test
public void testCapacidadeKG() {
    assertEquals(100, Nota.capacidadKG(100));
}

@Test
public void testCapacidadeM3() {
    assertEquals(300.0, Nota.capacidadM3(300), 0.001);
}
