public class Main {
    public static String generateTest(String inputString) throws Exception {
        return build("file:///" + inputString, null, null, true);
    }

    private static URI build(String path, Map<String, String> query, Map<String, String> params, boolean secure) throws Exception {
        if (secure) {
            // Use HTTPS
            return new URI("https", null, path, null, "?".concat(query).toString());
        } else {
            // Use HTTP
            return new URI("http", null, path, null, "?".concat(query).toString());
