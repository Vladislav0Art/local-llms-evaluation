    }

    public static String getCommitHistory() {
        return toString("my_commit_history", 20);
    }

    public static GitUserBranchInfo getUserBranchInfo(int commitCount, int branchCount) {
        GitUser user = new GitUser();
        Random random = new Random();
        for (int i = 0; i < commitCount; i++) {
            user = addUser(random);
            System.out.println(user.getCommit());
        }
        return user;
    }

    public static GitRepositoryInfo getRepositoryInfo(int commitCount, int branchCount) {
        GitRepository repository = new GitRepository();
        Random random = new Random();
        for (int i = 0; i < commitCount; i++) {
            repository = addRepository(random);
            System.out.println(repository.getCommit());
        }
        return repository;
    }

    public static GitCommitInfo getCommitInfo(String name, int size) {
        GitCommit gitCommit = new GitCommit();
        Random random = new Random();
        for (int i = 0; i < size; i++) {
            gitCommit = addGitCommit(random, name);
            System.out.println(gitCommit.toString());
        }
        return gitCommit;
    }

    public static GitUser getUser(String username) {
        return new GitUser();
    }

    public static GitBranch getBranch(int commitCount, String branchName) {
        return new GitBranch();
    }
}

