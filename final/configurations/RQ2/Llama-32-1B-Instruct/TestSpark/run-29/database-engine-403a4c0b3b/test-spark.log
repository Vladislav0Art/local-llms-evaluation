            test.runDatabase(database);
        } catch (Exception e) {
            System.out.println("Error: " + e.getMessage());
        }
    }

    public static class DBAppException extends Exception {
        public DBAppException() {
            super("DBAppException");
        }
    }

    public interface Database {
        String getDatabaseName();
    }

    public static class SQLTerm {
        // Add test methods for SQLTerm
    }

    public static void testGetDatabaseName(Database database) {
        try (Connection connection = DriverManager.getConnection("jdbc:sqlite:test.db");
             PreparedStatement statement = connection.prepareStatement("SELECT database_name FROM sqlite_master WHERE type='table';")) {

            ResultSet resultSet = statement.executeQuery();

            while (resultSet.next()) {
                String databaseName = resultSet.getString("database_name");

                if (database.getDatabaseName() == null || !database.getDatabaseName().equals(databaseName)) {
                    throw new DBAppException();
                }
            }
        } catch (SQLException e) {
            System.out.println("Error: " + e.getMessage());
        }
    }

    public static void testGetTableNames(Database database) {
        try (Connection connection = DriverManager.getConnection("jdbc:sqlite:test.db");
             Statement statement = connection.createStatement();) {

            ResultSet resultSet = statement.executeQuery("SELECT name FROM sqlite_master WHERE type='table';");

            while (resultSet.next()) {
                String tableName = resultSet.getString("name");

                if (database.getDatabaseName() == null || !database.getDatabaseName().equals(tableName)) {
                    throw new DBAppException();
                }
            }

        } catch (SQLException e) {
            System.out.println("Error: " + e.getMessage());
        }
    }
}

interface DatabaseTest {
    void runDatabase(Database database);
}
