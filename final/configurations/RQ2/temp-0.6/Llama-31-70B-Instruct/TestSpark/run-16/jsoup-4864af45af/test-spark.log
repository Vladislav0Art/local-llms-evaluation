import org.jsoup.safety.Safelist;
import org.junit.Test;
import static org.junit.Assert.*;

public class SafelistUnitTest {
    @Test
    public void isSafeTagTest() {
        Safelist safelist = new Safelist();
        assertTrue(safelist.isSafeTag("p"));
        assertTrue(safelist.isSafeTag("div"));
        assertFalse(safelist.isSafeTag("script"));
        assertFalse(safelist.isSafeTag("style"));
    }

    @Test
    public void isSafeAttributeTest() {
        Safelist safelist = new Safelist();
        assertTrue(safelist.isSafeAttribute("p", null, new Attribute("class", "my-class")));
        assertFalse(safelist.isSafeAttribute("p", null, new Attribute("onclick", "alert('hi')")));
    }
}
```

This code tests the `isSafeTag` and `isSafeAttribute` methods of the `Safelist` class. It checks that the `p` and `div` tags are safe, and the `script` and `style` tags are not safe. It also checks that the `class` attribute is safe on the `p` tag, but the `onclick` attribute is not safe.
