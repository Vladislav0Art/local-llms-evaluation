@RunWith(MockitoJUnitRunner.class)
public class GeneratedTest {

    @Test
    public void parseName_ValidAMIName_ReturnsAppVersion() {
        String amiName = "ami-123456789012";
        AppVersion appVersion = AppVersion.parseName(amiName);
        assertNotNull(appVersion);
    }

    @Test
    public void parseName_InvalidAMIName_ReturnsNull() {
        String amiName = "invalid-ami-name";
        AppVersion appVersion = AppVersion.parseName(amiName);
        assertNull(appVersion);
    }

    @Test
    public void compareTo_SameVersion_ReturnsZero() {
        AppVersion appVersion1 = new AppVersion();
        appVersion1.setVersion("1.2.3");
        AppVersion appVersion2 = new AppVersion();
        appVersion2.setVersion("1.2.3");
        int result = appVersion1.compareTo(appVersion2);
        assertEquals(0, result);
    }

    @Test
    public void compareTo_LowerVersion_ReturnsNegative() {
        AppVersion appVersion1 = new AppVersion();
        appVersion1.setVersion("1.2.3");
        AppVersion appVersion2 = new AppVersion();
        appVersion2.setVersion("1.2.4");
        int result = appVersion1.compareTo(appVersion2);
        assertTrue(result < 0);
    }

}
