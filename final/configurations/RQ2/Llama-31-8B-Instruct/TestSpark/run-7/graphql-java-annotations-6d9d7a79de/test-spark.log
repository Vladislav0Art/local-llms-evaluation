import static org.junit.Assert.assertArrayEquals;
import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertThrows;
import static org.mockito.Mockito.when;

@RunWith(MockitoJUnitRunner.class)
public class DirectivesBuilderTest {

    @Mock
    private ProcessingElementsContainer container;

    @Mock
    private AnnotatedElement annotatedElement;

    @InjectMocks
    private DirectivesBuilder directivesBuilder;

    @Test
    public void build_NoDirectivesTest() {
        // Arrange
        when(annotatedElement.getAnnotations()).thenReturn(new Annotation[0]);

        // Act
        GraphQLDirective[] result = directivesBuilder.build();

        // Assert
        assertArrayEquals(new GraphQLDirective[0], result);
    }

    @Test
    public void build_DirectivesTest() {
        // Arrange
        GraphQLDirective directive1 = newDirective().build();
        GraphQLDirective directive2 = newDirective().build();
        when(annotatedElement.getAnnotations()).thenReturn(new Annotation[]{new GraphQLDirectives(directive1, directive2)});

        // Act
