    public void parse_SingleNumber_ReturnsNumberToken() {
        Tokenizer tokenizer = new Tokenizer("5", new ExpressionConfiguration());
        List<Token> result = tokenizer.parse();
        assertEquals(1, result.size());
        assertEquals(TokenType.NUMBER, result.get(0).getType());
        assertEquals("5", result.get(0).getValue());
    }

