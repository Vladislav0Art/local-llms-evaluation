	public void addTags_AddTagsTest() {
		Safelist safelist = Safelist.none();
		safelist.addTags("script", "style");
		assertTrue(safelist.isSafeTag("script"));
		assertTrue(safelist.isSafeTag("style"));
	}
, 	@Test
