import ch.jalu.configme.exception.ConfigMeException;
import org.junit.Test; 
import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertNotNull;
import static org.junit.Assert.fail;
import challenge.jalu.configme.configurationdata.PropertyListBuilder;

public class PropertyListBuilderTest {

    @Test
    public void addNewPropertyToBuilderTest() {
        PropertyListBuilder propertyListBuilder = new PropertyListBuilder();

        try {
            Property<String> testProperty = new Property<>("testPropertyPath", "defaultValue");
            propertyListBuilder.add(testProperty);
            List<Property<?>> properties = propertyListBuilder.create();
            assertEquals("Property list size should be 1.", 1, properties.size());
            assertEquals("Property is different.", testProperty, properties.get(0));
        } catch (ConfigMeException exception) {
            fail("ConfigMeException was thrown, but not expected.");
        }
    }

    @Test
    public void addDuplicatedPropertyToBuilderTest() {
        PropertyListBuilder propertyListBuilder = new PropertyListBuilder();

        try {
            Property<String> testProperty = new Property<>("testPropertyPath", "defaultValue");
            propertyListBuilder.add(testProperty);
            propertyListBuilder.add(testProperty);

            List<Property<?>> properties = propertyListBuilder.create();
            assertEquals("Property list size should be 1.", 1, properties.size());
        } catch (ConfigMeException exception) {
            fail("ConfigMeException was thrown, but not expected.");
        }
    }


    @Test
    public void getRootEntriesWhenNoPropertiesTest() {
        PropertyListBuilder propertyListBuilder = new PropertyListBuilder();

        try {
            Map<String, Object> rootEntries = propertyListBuilder.getRootEntries();
            assertNotNull(rootEntries);
            assertEquals("Root entries should be empty.", 0, rootEntries.size());
        } catch (ConfigMeException exception) {
            fail("ConfigMeException was thrown, but not expected.");
        }
    }

    @Test
    public void getRootEntriesWhenPropertiesExistTest() {
        PropertyListBuilder propertyListBuilder = new PropertyListBuilder();

        try {
            Property<String> testProperty1 = new Property<>("testPropertyPath1", "defaultValue1");
            Property<String> testProperty2 = new Property<>("testPropertyPath2", "defaultValue2");
            propertyListBuilder.add(testProperty1);
            propertyListBuilder.add(testProperty2);

            Map<String, Object> rootEntries = propertyListBuilder.getRootEntries();
            assertNotNull(rootEntries);
            assertEquals("Root entries should contain 2 elements.", 2, rootEntries.size());

        } catch (ConfigMeException exception) {
            fail("ConfigMeException was thrown, but not expected.");
        }
    }
}
