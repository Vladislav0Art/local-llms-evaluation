package io.github.vmzakharov.ecdataframe.dsl.visitor;

import static org.junit.Assert.*;

import org.junit.Test;
import io.github.vmzakharov.ecdataframe.dsl.*;
import io.github.vmzakharov.ecdataframe.dsl.visitor.*;
import io.github.vmzakharov.ecdataframe.dsl.value.*;

public class GeneratedTest {

    @Test
    public void exprToStringTest() {
        Expression expression = new DecimalExpr(new DecimalValue(10.5));
        String representation = PrettyPrintVisitor.exprToString(expression);

        assertNotNull(representation);
        assertEquals("10.5", representation);
    }

    @Test
    public void visitAssignExprTest() {
        Printer printer = PrinterFactory.newCollectingPrinter();
        AssingExpr assignExpr = new AssingExpr("var", new DecimalExpr(new DecimalValue(10.5)));
        PrettyPrintVisitor visitor = new PrettyPrintVisitor(printer);

        visitor.visitAssignExpr(assignExpr);
        assertEquals("var = 10.5", printer.print());
    }

    @Test
    public void visitBinaryExprTest() {
        Printer printer = PrinterFactory.newCollectingPrinter();
        DecimalExpr leftExpression = new DecimalExpr(new DecimalValue(10.5));
        DecimalExpr rightExpression = new DecimalExpr(new DecimalValue(5.5));
        BinaryExpr binaryExpr = new BinaryExpr(leftExpression, BinaryOp.ADDITION, rightExpression);
        PrettyPrintVisitor visitor = new PrettyPrintVisitor(printer);

        visitor.visitBinaryExpr(binaryExpr);
        assertEquals("10.5 + 5.5", printer.print());
    }

    @Test
