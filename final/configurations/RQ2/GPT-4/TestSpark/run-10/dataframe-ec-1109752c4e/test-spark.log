    @Test
    public void visitVarExprTest() {
        VarExpr varExpr = new VarExpr("var", false);
        PrettyPrintVisitor visitor = new PrettyPrintVisitor();

        assertNotNull(visitor.visitVarExpr(varExpr));
    }
}
