import static org.junit.Assert.*;
import org.junit.Test;
import io.github.vmzakharov.ecdataframe.dsl.*;
import io.github.vmzakharov.ecdataframe.dsl.visitor.*;
import io.github.vmzakharov.ecdataframe.dsl.value.*;

public class PrettyPrintVisitorTest {

    @Test
    public void exprToStringTest() {
        Expression expression = new DecimalExpr(new DecimalValue(10.5));
        String representation = PrettyPrintVisitor.exprToString(expression);

        assertNotNull(representation);
