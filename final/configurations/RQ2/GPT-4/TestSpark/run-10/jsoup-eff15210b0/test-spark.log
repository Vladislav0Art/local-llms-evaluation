import org.jsoup.Connection;
import org.jsoup.HttpStatusException;
import org.jsoup.UnsupportedMimeTypeException;
import org.jsoup.helper.HttpConnection;
import org.junit.Assert;
import org.junit.Test;
import java.io.IOException;
import java.net.MalformedURLException;
import java.net.URL;
import java.util.HashMap;
import java.util.Map;

public class HttpConnectionTest {

    @Test
    public void userAgentTest() {
        Connection connection = new HttpConnection();
        String expectedAgent = "Mozilla";
        connection.userAgent(expectedAgent);
        String actualAgent = connection.request().userAgent();
        Assert.assertEquals(expectedAgent, actualAgent);
    }

    @Test
    public void urlTest() throws MalformedURLException {
        Connection connection = new HttpConnection();
        URL expectedUrl = new URL("http://example.com");
        connection.url(expectedUrl);
        URL actualUrl = connection.request().url();
        Assert.assertEquals(expectedUrl, actualUrl);
    }

    @Test
    public void proxyTest() {
        Connection connection = new HttpConnection();
        Connection.Proxy expectedProxy = new Connection.Proxy("localhost", 8000);
        connection.proxy(expectedProxy);
        Connection.Proxy actualProxy = connection.request().proxy();
        Assert.assertEquals(expectedProxy, actualProxy);
    }

    @Test(expected = MalformedURLException.class)
    public void connectInvalidUrlTest() {
        String url ="example";
        Connection connection = HttpConnection.connect(url);
    }

    @Test
    public void cookieStoreTest() {
        Connection connection = new HttpConnection();
        CookieStore expectedCookieStore = new CookieManager().getCookieStore();
        connection.cookieStore(expectedCookieStore);
        CookieStore actualCookieStore = connection.request().cookieStore();
        Assert.assertEquals(expectedCookieStore, actualCookieStore);
    }

    @Test
    public void dataTest() {
        Connection connection = new HttpConnection();
        Map<String, String> data = new HashMap<>();
        data.put("key", "value");
        connection.data(data);
        Map<String, String> actualData = connection.request().data();
        Assert.assertEquals(data, actualData);
    }

    @Test
    public void userAgentConnectTest() throws IOException {
        String url = "http://example.com";
        String expectedAgent = "Mozilla";
        Connection connection = HttpConnection.connect(url).userAgent(expectedAgent);
        String actualAgent = connection.request().userAgent();
        Assert.assertEquals(expectedAgent, actualAgent);
    }

    @Test
    public void postTest() throws IOException {
        String url = "http://example.com";
        Connection connection = HttpConnection.connect(url);
        connection.post();
        Assert.assertEquals(Connection.Method.POST, connection.request().method());
    }

    @Test
    public void getTest() throws IOException {
        String url = "http://example.com";
        Connection connection = HttpConnection.connect(url);
        connection.get();
        Assert.assertEquals(Connection.Method.GET, connection.request().method());
    }

    @Test(expected = HttpStatusException.class)
    public void responseErrorTest()throws IOException{
        String url="http://nonexistent.com";
        Connection connection= HttpConnection.connect(url);
        connection.execute();
    }

    @Test(expected = UnsupportedMimeTypeException.class)
    public void responseUnsupportedMimeTypeTest() throws IOException {
        String url = "http://example.com";
        Connection connection = HttpConnection.connect(url);
        connection.ignoreContentType(false);
        connection.execute();
    }
}
