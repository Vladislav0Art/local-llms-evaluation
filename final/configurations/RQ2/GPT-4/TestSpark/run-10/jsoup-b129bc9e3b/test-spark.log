    public HttpConnectionTest() {
        MockitoAnnotations.initMocks(this);
    }

    @Test
    public void connectStringUrlTest() throws MalformedURLException {
        Connection result = HttpConnection.connect("http://example.com");
        assertNotNull(result);
    }

    @Test
    public void connectURLTest() throws MalformedURLException {
        Connection result = HttpConnection.connect(new URL("http://example.com"));
        assertNotNull(result);
    }

    @Test
    public void newRequestTest() {
        HttpConnection connection = new HttpConnection();
        Connection result = connection.newRequest();
        assertNotNull(result);
    }

    @Test
    public void urlTest() throws MalformedURLException {
        HttpConnection connection = new HttpConnection();
        Connection result = connection.url(new URL("http://example.com"));
        assertEquals(connection, result);
    }

    @Test
    public void proxyTest() {
        HttpConnection connection = new HttpConnection();
        Proxy p = new Proxy(Proxy.Type.HTTP, null);
        Connection result = connection.proxy(p);
        assertEquals(connection, result);
    }

    @Test
    public void proxyAddressTest() {
        HttpConnection connection = new HttpConnection();
        Connection result = connection.proxy("example.com", 8080);
        assertEquals(connection, result);
    }

    @Test
    public void dataInputStreamTest() {
        HttpConnection connection = new HttpConnection();
        Connection result = connection.data("key", "filename", mockedInputStream);
        assertEquals(connection, result);
    }

    @Test
    public void dataTest() {
        HttpConnection connection = new HttpConnection();
        Map<String, String> data = new HashMap<>();
        data.put("key", "value");
        Connection result = connection.data(data);
        assertEquals(connection, result);
    }

    @Test
    public void headerTest() {
        HttpConnection connection = new HttpConnection();
        Connection result = connection.header("name", "value");
        assertEquals(connection, result);
    }

    @Test
    public void headersTest() {
        HttpConnection connection = new HttpConnection();
        Map<String, String> headers = new HashMap<>();
        headers.put("name", "value");
        Connection result = connection.headers(headers);
        assertEquals(connection, result);
    }

    @Test
    public void cookieTest() {
        HttpConnection connection = new HttpConnection();
        Connection result = connection.cookie("name", "value");
        assertEquals(connection, result);
    }

    @Test
    public void cookiesTest() {
        HttpConnection connection = new HttpConnection();
        Map<String, String> cookies = new HashMap<>();
        cookies.put("name", "value");
        Connection result = connection.cookies(cookies);
        assertEquals(connection, result);
    }
}
