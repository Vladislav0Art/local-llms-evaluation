        String expression = "'abc'";
        Tokenizer tokenizer = new Tokenizer(expression, configuration);
        Token token = tokenizer.parseStringLiteral();
        assertNotNull(token);
        assertEquals(TokenType.CHARACTER, token.getType());
    }

