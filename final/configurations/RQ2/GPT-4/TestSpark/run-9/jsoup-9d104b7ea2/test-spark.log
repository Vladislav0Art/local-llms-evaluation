    public void createFromEncodedTest() {
        TextNode textNode = TextNode.createFromEncoded("Sample &amp; Text", false);
        Assert.assertEquals("Sample & Text", textNode.text());
    }

    @Test
    public void normaliseWhitespaceTest() {
