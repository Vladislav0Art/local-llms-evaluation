    public void virtualFileFromURITest() {
        VirtualFile result = FileUtils.virtualFileFromURI("testUri");
        assertNotNull(result);
    }

    @Test
    public void fileTypeFromEditorTest() {
        Editor mockEditor = mock(Editor.class);
        FileType result = FileUtils.fileTypeFromEditor(mockEditor);
        assertNotNull(result);
    }

    @Test
    public void isFileSupportedTest() {
        VirtualFile mockFile = mock(VirtualFile.class);
