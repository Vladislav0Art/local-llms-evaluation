package com.ezylang.evalex.parser;

import static org.junit.Assert.*;
import static org.mockito.Mockito.*;

import com.ezylang.evalex.config.ExpressionConfiguration;
import com.ezylang.evalex.functions.FunctionDictionaryIfc;
import com.ezylang.evalex.operators.OperatorIfc;
import java.util.List;
import org.junit.Test;

public class TokenizerTest {

    @Test
    public void parseExpressionWithAllCharactersTest() throws ParseException {
        ExpressionConfiguration configuration = new ExpressionConfiguration();
        Tokenizer tokenizer = new Tokenizer("1 + 1", configuration);
        List<Token> tokenList = tokenizer.parse();
        assertEquals(3, tokenList.size());
    }

    @Test
    public void parseEmptyExpressionTest() throws ParseException {
        ExpressionConfiguration configuration = new ExpressionConfiguration();
        Tokenizer tokenizer = new Tokenizer("", configuration);
        List<Token> tokenList = tokenizer.parse();
        assertEquals(0, tokenList.size());
    }

    @Test(expected = ParseException.class)
    public void parseInvalidExpressionTest() throws ParseException {
        ExpressionConfiguration configuration = new ExpressionConfiguration();
        Tokenizer tokenizer = new Tokenizer("1 +", configuration);
        tokenizer.parse(); // This should throw the exception
    }

    @Test
    public void parseStringLiteralWithQuotesTest() throws ParseException {
        ExpressionConfiguration configuration = new ExpressionConfiguration();
        Tokenizer tokenizer = new Tokenizer("\"Hello, World!\"", configuration);
        Token token = tokenizer.parseStringLiteral();
        assertEquals("Hello, World!", token.getLiteral());
    }

    @Test
    public void parseStringLiteralWithoutQuotesTest() throws ParseException {
        ExpressionConfiguration configuration = new ExpressionConfiguration();
        Tokenizer tokenizer = new Tokenizer("Hello, World!", configuration);
        Token token = tokenizer.parseStringLiteral();
        assertEquals("Hello, World!", token.getLiteral());
    }

    @Test(expected = ParseException.class)
    public void parseStringLiteralIncompleteQuoteTest() throws ParseException {
        ExpressionConfiguration configuration = new ExpressionConfiguration();
        Tokenizer tokenizer = new Tokenizer("\"Hello, World!", configuration);
        tokenizer.parseStringLiteral(); // This should throw the exception
    }

}
