        String output = PrettyPrintVisitor.exprToString(decimalExpr);
        assertEquals("10.0", output);
    }

    @Test
    public void visitAssignExprTest() {
        AssingExpr assignExpr = new AssingExpr(null, "x", new DecimalExpr(null, new ValueDecimal(10.0)));
        PrettyPrintVisitor visitor = new PrettyPrintVisitor();
        String output = PrettyPrintVisitor.exprToString(assignExpr);
        assertEquals("x = 10.0", output);
