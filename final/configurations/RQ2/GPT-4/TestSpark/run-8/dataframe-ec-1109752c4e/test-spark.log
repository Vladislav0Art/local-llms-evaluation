public class PrettyPrintVisitorTest {

    @Test
    public void exprToStringTest() {
        DecimalExpr decimalExpr = new DecimalExpr(null, 10.0);
        String output = PrettyPrintVisitor.exprToString(decimalExpr);
        assertEquals("DECIMAL ", output.trim());
    }

    @Test
    public void visitAssignExprTest() {
        AssingExpr assignExpr = new AssingExpr(null, "x", new DecimalExpr(null, 10.0));
        String output = PrettyPrintVisitor.exprToString(assignExpr);
        assertEquals("x = DECIMAL", output.trim());
    }

    @Test
    public void visitUnaryExprTest() {
        UnaryExpr unaryExpr = new UnaryExpr(null, UnaryOp.MINUS, new DecimalExpr(null, 10.0));
        String output = PrettyPrintVisitor.exprToString(unaryExpr);
        assertEquals("-DECIMAL", output.trim());
    }

    @Test
    public void visitVarExprTest() {
        VarExpr varExpr = new VarExpr(null, false, "x");
        String output = PrettyPrintVisitor.exprToString(varExpr);
        assertEquals("x", output.trim());
    }
}
