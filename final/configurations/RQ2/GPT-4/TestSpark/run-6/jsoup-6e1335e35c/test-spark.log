    public void attrTest() {
        Element element = new Element(TEST_TAG);
        element.attr(TEST_ATTRIBUTE_KEY, TEST_ATTRIBUTE_VALUE);
        Assert.assertEquals(TEST_ATTRIBUTE_VALUE, element.attr(TEST_ATTRIBUTE_KEY));
    }

    @Test
    public void idTest() {
        Element element = new Element(TEST_TAG);
        element.id(TEST_ID);
        Assert.assertEquals(TEST_ID, element.id());
    }

    @Test
    public void baseUriTest() {
        Element element = new Element(TEST_TAG, TEST_BASE_URI);
        Assert.assertEquals(TEST_BASE_URI, element.baseUri());
    }

    @Test
    public void selectTest() {
        Element element = new Element(TEST_TAG);
        Elements elements = element.select(TEST_TAG);
        Assert.assertNotNull(elements);
    }

    @Test
    public void appendTest() {
        Element element = new Element(TEST_TAG);
        element.append(TEST_HTML);
        Assert.assertEquals(TEST_HTML, element.html());
    }

    @Test
    public void prependTest() {
        Element element = new Element(TEST_TAG);
        element.prepend(TEST_HTML);
        Assert.assertEquals(TEST_HTML, element.html());
    }

    @Test
    public void textTest() {
        Element element = new Element(TEST_TAG);
        element.text(TEST_TEXT);
        Assert.assertEquals(TEST_TEXT, element.text());
    }

    @Test
    public void addClassTest() {
        Element element = new Element(TEST_TAG);
        element.addClass(TEST_ATTRIBUTE_VALUE);
        Assert.assertTrue(element.hasClass(TEST_ATTRIBUTE_VALUE));
    }

    @Test
    public void removeClassTest() {
        Element element = new Element(TEST_TAG);
        element.addClass(TEST_ATTRIBUTE_VALUE);
        element.removeClass(TEST_ATTRIBUTE_VALUE);
        Assert.assertFalse(element.hasClass(TEST_ATTRIBUTE_VALUE));
    }

    @Test
    public void cloneTest() {
