import org.junit.Assert;
import org.junit.Test;
import org.jsoup.nodes.Element;
import org.jsoup.nodes.Attributes;
import org.jsoup.parser.Tag;
import org.jsoup.select.Elements;

public class ElementTest {

    private static final String TEST_TAG = "p";
    private static final String TEST_ID = "testID";
    private static final String TEST_ATTRIBUTE_KEY = "testAttribute";
    private static final String TEST_ATTRIBUTE_VALUE = "testValue";
    private static final String TEST_BASE_URI = "http://test.com";
    private static final String TEST_HTML = "<div></div>";
    private static final String TEST_TEXT = "testText";

    @Test
    public void ElementConstructorTest() {
        Element element = new Element(Tag.valueOf(TEST_TAG), TEST_BASE_URI, new Attributes());
        Assert.assertNotNull(element);
    }

    @Test
    public void tagNameTest() {
        Element element = new Element(Tag.valueOf(TEST_TAG), TEST_BASE_URI, new Attributes());
        element.tagName(TEST_TAG);
        Assert.assertEquals(TEST_TAG, element.tagName());
    }

    @Test
    public void hasAttributesTest() {
        Element element = new Element(Tag.valueOf(TEST_TAG), TEST_BASE_URI, new Attributes());
        Assert.assertFalse(element.hasAttributes());
        element.attr(TEST_ATTRIBUTE_KEY, TEST_ATTRIBUTE_VALUE);
        Assert.assertTrue(element.hasAttributes());
    }

    @Test
    public void attrTest() {
        Element element = new Element(Tag.valueOf(TEST_TAG), TEST_BASE_URI, new Attributes());
        element.attr(TEST_ATTRIBUTE_KEY, TEST_ATTRIBUTE_VALUE);
        Assert.assertEquals(TEST_ATTRIBUTE_VALUE, element.attr(TEST_ATTRIBUTE_KEY));
    }

    @Test
    public void idTest() {
        Element element = new Element(Tag.valueOf(TEST_TAG), TEST_BASE_URI, new Attributes());
        element.id(TEST_ID);
        Assert.assertEquals(TEST_ID, element.id());
    }

    @Test
    public void baseUriTest() {
        Element element = new Element(Tag.valueOf(TEST_TAG), TEST_BASE_URI, new Attributes());
        Assert.assertEquals(TEST_BASE_URI, element.baseUri());
    }

    @Test
    public void selectTest() {
        Element element = new Element(Tag.valueOf(TEST_TAG), TEST_BASE_URI, new Attributes());
        Elements elements = element.select(TEST_TAG);
        Assert.assertNotNull(elements);
    }

    @Test
    public void appendTest() {
        Element element = new Element(Tag.valueOf(TEST_TAG), TEST_BASE_URI, new Attributes());
        element.append(TEST_HTML);
        Assert.assertEquals(TEST_HTML, element.html());
    }

    @Test
    public void prependTest() {
        Element element = new Element(Tag.valueOf(TEST_TAG), TEST_BASE_URI, new Attributes());
        element.prepend(TEST_HTML);
        Assert.assertEquals(TEST_HTML, element.html());
    }

    @Test
    public void textTest() {
        Element element = new Element(Tag.valueOf(TEST_TAG), TEST_BASE_URI, new Attributes());
        element.text(TEST_TEXT);
        Assert.assertEquals(TEST_TEXT, element.text());
    }

    @Test
    public void addClassTest() {
        Element element = new Element(Tag.valueOf(TEST_TAG), TEST_BASE_URI, new Attributes());
        element.addClass(TEST_ATTRIBUTE_VALUE);
        Assert.assertTrue(element.hasClass(TEST_ATTRIBUTE_VALUE));
    }

    @Test
    public void removeClassTest() {
        Element element = new Element(Tag.valueOf(TEST_TAG), TEST_BASE_URI, new Attributes());
        element.addClass(TEST_ATTRIBUTE_VALUE);
        element.removeClass(TEST_ATTRIBUTE_VALUE);
        Assert.assertFalse(element.hasClass(TEST_ATTRIBUTE_VALUE));
    }

    @Test
    public void cloneTest() {
        Element element = new Element(Tag.valueOf(TEST_TAG), TEST_BASE_URI, new Attributes());
        element.attr(TEST_ATTRIBUTE_KEY, TEST_ATTRIBUTE_VALUE);

        Element clonedElement = element.clone();
        Assert.assertNotNull(clonedElement);
        Assert.assertEquals(element.attr(TEST_ATTRIBUTE_KEY), clonedElement.attr(TEST_ATTRIBUTE_KEY));
    }

    @Test
    public void removeAttrTest() {
        Element element = new Element(Tag.valueOf(TEST_TAG), TEST_BASE_URI, new Attributes());
        element.attr(TEST_ATTRIBUTE_KEY, TEST_ATTRIBUTE_VALUE);

        element.removeAttr(TEST_ATTRIBUTE_KEY);
        Assert.assertNull(element.attr(TEST_ATTRIBUTE_KEY));
    }

    @Test
    public void valTest() {
        Element element = new Element(Tag.valueOf(TEST_TAG), TEST_BASE_URI, new Attributes());
        element.val(TEST_ID);

        Assert.assertEquals(TEST_ID, element.val());
    }
}
