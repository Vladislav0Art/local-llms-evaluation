import java.util.Properties;

import static org.junit.Assert.*;

public class W3CDomTest {

    @Test
    public void W3CDomConstructorTest() {
        W3CDom object = new W3CDom();
        assertNotNull(object);
    }

    @Test
    public void namespaceAwareTest() {
        W3CDom object = new W3CDom();
        assertTrue(object.namespaceAware());
    }

    @Test
    public void namespaceAwareBooleanTest() {
        W3CDom object = new W3CDom();
        object.namespaceAware(false);
        assertFalse(object.namespaceAware());
    }

    @Test
    public void convertDocumentInTest() {
        Document in = new Document("");
        assertNotNull(W3CDom.convert(in));
    }

    @Test
    public void asStringMapPropertiesTest() {
        Document document = new Document("");
        Map<String, String> map = new HashMap<>();
        assertNotNull(W3CDom.asString(document, map));
    }

    @Test
    public void propertiesFromMapTest() {
        Map<String, String> map = new HashMap<>();
        Properties properties = W3CDom.propertiesFromMap(map);
        assertTrue(properties instanceof Properties);
    }

    @Test
    public void outputHtmlTest() {
        HashMap<String, String> output = W3CDom.OutputHtml();
        assertTrue(output instanceof HashMap);
    }

    @Test
    public void outputXmlTest() {
        HashMap<String, String> output = W3CDom.OutputXml();
        assertTrue(output instanceof HashMap);
    }

    @Test
    public void fromJsoupDocumentInTest() {
        Document in = new Document("");
        W3CDom w3cDom = new W3CDom();
        assertNotNull(w3cDom.fromJsoup(in));
    }

    @Test
    public void fromJsoupElementInTest() {
        Element in = new Element("test");
        W3CDom w3cDom = new W3CDom();
        assertNotNull(w3cDom.fromJsoup(in));
    }

    @Test
    public void convertDocumentInAndDocumentOutTest() {
        W3CDom w3cDom = new W3CDom();
        Document in = new Document("");
        Document out = new Document("");
        w3cDom.convert(in, out);
        assertNotNull(out);
    }

    @Test
    public void convertElementInAndDocumentOutTest() {
        W3CDom w3cDom = new W3CDom();
        Element in = new Element("test");
        Document out = new Document("");
        w3cDom.convert(in, out);
        assertNotNull(out);
    }

    @Test
    public void selectXPathXPathAndDocumentTest() {
        W3CDom w3cDom = new W3CDom();
        Document doc = new Document("");
        NodeList nodeList = w3cDom.selectXpath("", doc);
        assertTrue(nodeList instanceof NodeList);
    }

    @Test
    public void selectXPathXPathAndNodeTest() {
        W3CDom w3cDom = new W3CDom();
        Document doc = new Document("");
        Node contextNode = doc; // Just to satisfy the parameter
