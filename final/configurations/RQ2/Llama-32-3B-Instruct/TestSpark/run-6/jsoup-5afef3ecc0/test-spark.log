package org.jsoup.helper;

import org.jsoup.Connection;
import org.jsoup.internal.StringUtil;
import org.junit.Test;
import static org.hamcrest.MatcherAssert.assertThat;
import static org.hamcrest.Matchers.*;
import java.net.IDN;
import java.net.MalformedURLException;
import java.net.URI;
import java.net.URISyntaxException;
import java.net.URL;
import java.net.URLDecoder;
import java.net.URLEncoder;

public class UrlBuilderTest {

    @Test
    public void newUrlBuilder() {
        assertThat(new UrlBuilder(null), notNullValue());
    }

    @Test
    public void buildUrlFromInputUrl() {
        URL url = new URL("https://example.com");
        UrlBuilder builder = new UrlBuilder(url);
        URI uri = builder.build().toURI();
        assertThat(uri, notNullValue());
        assertThat(uri.getScheme(), is("https"));
        assertThat(uri.getHost(), is("example.com"));
    }

    @Test
    public void buildUrlWithPath() {
        URL url = new URL("https://example.com/path");
        UrlBuilder builder = new UrlBuilder(url);
        URI uri = builder.build().toURI();
        assertThat(uri, notNullValue());
        assertThat(uri.getScheme(), is("https"));
        assertThat(uri.getHost(), is("example.com"));
        assertThat(uri.getPath(), is("/path"));
    }

    @Test
    public void buildUrlWithQuery() {
        URL url = new URL("https://example.com?query=hello");
        UrlBuilder builder = new UrlBuilder(url);
        URI uri = builder.build().toURI();
        assertThat(uri, notNullValue());
        assertThat(uri.getScheme(), is("https"));
        assertThat(uri.getHost(), is("example.com"));
        assertThat(uri.getQuery(), is("query=hello"));
    }

    @Test
    public void buildUrlWithFragment() {
        URL url = new URL("https://example.com#fragment");
        UrlBuilder builder = new UrlBuilder(url);
        URI uri = builder.build().toURI();
        assertThat(uri, notNullValue());
        assertThat(uri.getScheme(), is("https"));
        assertThat(uri.getHost(), is("example.com"));
        assertThat(uri.getFragment(), is("fragment"));
    }

    @Test
    public void appendKeyVal() {
        UrlBuilder builder = new UrlBuilder(null);
        Connection.KeyVal kv = Connection.KeyVal.of("key", "value");
        try {
            builder.appendKeyVal(kv);
            assertThat(builder.build().toURI().getQuery(), containsString("key=value"));
        } catch (UnsupportedEncodingException e) {
            fail(e.getMessage());
        }
    }

    @Test
    public void appendKeyValNonStringValue() {
        UrlBuilder builder = new UrlBuilder(null);
        Connection.KeyVal kv = Connection.KeyVal.of(123L, "value");
        try {
            builder.appendKeyVal(kv);
            assertThat(builder.build().toURI().getQuery(), containsString("123=value"));
        } catch (UnsupportedEncodingException e) {
            fail(e.getMessage());
        }
    }

}

