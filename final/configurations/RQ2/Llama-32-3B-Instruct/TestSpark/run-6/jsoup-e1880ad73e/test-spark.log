        }

        public static String encode_WithQuery(String query) {
            return query;
        }
    }

    public static class URL {
        private String host;
        private int port;

        public URL(String host, int port) {
            this.host = host;
            this.port = port;
        }

        @Override
        public String toString() {
            return "URL{" +
