public class Database {
    private static final String TABLE_NAME = "testTable";

    public void insertData(Hashtable<String, Object> data) {
        System.out.println("Inserting into table: " + TABLE_NAME);
        for (Map.Entry<String, Object> entry : data.entrySet()) {
            System.out.println("Key: " + entry.getKey() + ", Value: " + entry.getValue());
        }
    }

    public void updateData(String key, Hashtable<String, Object> newData) {
        System.out.println("Updating table: " + TABLE_NAME);
        for (Map.Entry<String, Object> entry : newData.entrySet()) {
            System.out.println("Key: " + entry.getKey() + ", Value: " + entry.getValue());
        }
    }

    public void selectData(SQLTerm[] data) {
        Iterator<SQLTerm> iterator = new Iterator<SQLTerm>() {
            private int index = 0;

            @Override
            public boolean hasNext() {
                return index < data.length;
            }

            @Override
            public SQLTerm next() {
                return data[index++];
            }
        };
        System.out.println("Selecting from table: " + TABLE_NAME);
    }

    public static void main(String[] args) {
        Database db = new Database();
        Hashtable<String, Object> data = new Hashtable<>();
        data.put("key1", "value1");
        data.put("key2", "value2");

        Hashtable<String, Object> newData = new Hashtable<>();
        newData.put("key1", "newValue1");
        newData.put("key3", "value3");

        SQLTerm[] dataArray = new SQLTerm[10];
        for (int i = 0; i < 10; i++) {
            dataArray[i] = new SQLTerm("SELECT * FROM " + TABLE_NAME);
        }

        db.insertData(data);
        db.updateData("key1", newData);
        db.selectData(dataArray);
    }
}

