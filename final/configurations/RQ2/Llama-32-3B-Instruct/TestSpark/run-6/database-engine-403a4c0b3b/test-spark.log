import java.util.*;

class SQLTerm {
    private String value;

    public SQLTerm(String value) {
        this.value = value;
    }

    @Override
    public String toString() {
        return value;
    }
}

public class Database {
    private static final String TABLE_NAME = "testTable";
    private List<SQLTerm> arrSQLTerms;
    private List<String> strarrOperators;

    public Database() {
        this.arrSQLTerms = new ArrayList<>();
        this.strarrOperators = new ArrayList<>();
    }

    // Insert data into the database
    public void insertIntoTable(String tableName, Hashtable<String, Object> htblColNameValue) {
        System.out.println("Inserting into table: " + tableName);
        for (Map.Entry<String, Object> entry : htblColNameValue.entrySet()) {
            SQLTerm term = new SQLTerm(entry.getKey() + " = " + entry.getValue());
            arrSQLTerms.add(term);
            strarrOperators.add("=");
        }
    }

    // Update data in the database
    public void updateTable(String tableName, String key, Hashtable<String, Object> htblColNameValue) {
        System.out.println("Updating table: " + tableName);
        for (Map.Entry<String, Object> entry : htblColNameValue.entrySet()) {
            SQLTerm term = new SQLTerm(key + " = " + entry.getValue());
            arrSQLTerms.add(term);
            strarrOperators.add("=");
        }
    }

    // Select data from the database
    public void selectFromTable(SQLTerm[] arrSQLTerms, List<String> strarrOperators) {
        System.out.println("Selecting from table");
        for (int i = 0; i < arrSQLTerms.length; i++) {
            System.out.println(arrSQLTerms[i].toString() + " " + strarrOperators.get(i));
        }
    }

    public static void main(String[] args) {
        Database db = new Database();
        Hashtable<String, Object> htblColNameValue1 = new Hashtable<>();
        htblColNameValue1.put("key1", "value1");
        htblColNameValue1.put("key2", "value2");

        Hashtable<String, Object> htblColNameValue2 = new Hashtable<>();
        htblColNameValue2.put("key3", "value3");
        htblColNameValue2.put("key4", "value4");

        db.insertIntoTable(TABLE_NAME, htblColNameValue1);
        db.updateTable(TABLE_NAME, "key1", htblColNameValue1);
        String[] newTerms = {"SELECT * FROM " + TABLE_NAME};
        List<String> newOperators = Arrays.asList("*");
        db.selectFromTable(newTerm, newOperator);
    }
}
```

