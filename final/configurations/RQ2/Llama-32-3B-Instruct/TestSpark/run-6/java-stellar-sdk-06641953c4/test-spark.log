        assertNotNull(keyPair);
    }

    @Test
    public void fromPublicKey_GivenValidPublickey_ReturnsKeyPair() {
        byte[] publicKey = new byte[32];
        Arrays.fill(publicKey, (byte) 0);
        KeyPair keyPair = KeyPair.fromPublicKey(publicKey);
        assertNotNull(keyPair);
    }

