private List<GraphQLDirective> build() throws GraphQLError {
    List<GraphQLDirective> directives = new ArrayList<>();

    // Get all annotations on the element
    Method[] methods = element.getClass().getMethods();
    for (Method method : methods) {
        // Check if the annotation is a GraphQLDirective
        GraphQLDirective directive = DirectiveJavaAnnotationUtil.extractArgument(method.getAnnotations());
        if (directive != null) {
            directives.add(directive);

            // Get additional information from the processing elements container
            ProcessingElement[] elements = container.getProcessingElements();
            for (ProcessingElement element : elements) {
                // Check if the element is related to the directive
                if (element.isRelatedTo(directive)) {
                    // Add more information to the directive
                    directive.setInfo(element.getInfo());
                }
            }
        }
    }

    return directives;
}
