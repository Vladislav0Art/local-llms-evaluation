    }

    @Test
    public void lastCharIsWhitespace_NoWhitespace_ReturnsFalse() {
        StringBuilder sb = mock(StringBuilder.class);
        when(sb.toString()).thenReturn("");
        assertFalse(lastCharIsWhitespace(sb));
