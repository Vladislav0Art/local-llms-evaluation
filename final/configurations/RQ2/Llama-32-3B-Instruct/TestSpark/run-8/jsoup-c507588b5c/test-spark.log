public class StringUtilTest {

    @org.junit.Test
    public void testStripLeadingWhitespace() {
        // Arrange
        String input = "   hello";
        int expectedLength = 5;

        // Act
        int actualLength = StringUtil.stripLeadingWhitespace(input).length();

        // Assert
        assertEquals(expectedLength, actualLength);
    }

    @org.junit.Test
    public void testStripTrailingWhitespace() {
        // Arrange
        String input = "hello   ";
        int expectedLength = 5;

        // Act
        int actualLength = StringUtil.stripTrailingWhitespace(input).length();

        // Assert
        assertEquals(expectedLength, actualLength);
    }

    @org.junit.Test
    public void testStripBothWhitespaces() {
        // Arrange
        String input = "   hello   ";
        int expectedLength = 5;

        // Act
        int actualLength = StringUtil.stripBothWhitespaces(input).length();

        // Assert
        assertEquals(expectedLength, actualLength);
    }

    @org.junit.Test
    public void testLastCharIsWhitespace() {
        // Arrange
        StringBuilder sb = new StringBuilder("   ");
        boolean expectedResult = true;

        // Act
        boolean result = StringUtil.lastCharIsWhitespace(sb);

        // Assert
        assertTrue(result);
    }
}

public class StringUtil {

    public static String stripLeadingWhitespace(String input) {
        int i = 0;
        while (i < input.length() && Character.isWhitespace(input.charAt(i))) {
            i++;
        }
        return input.substring(i);
    }

    public static String stripTrailingWhitespace(String input) {
        int i = input.length() - 1;
        while (i >= 0 && Character.isWhitespace(input.charAt(i))) {
            i--;
        }
        return input.substring(0, i + 1);
    }

    public static String stripBothWhitespaces(String input) {
        return stripLeadingWhitespace(stripTrailingWhitespace(input));
    }

    public static boolean lastCharIsWhitespace(StringBuilder sb) {
        if (sb.length() == 0) {
            return false;
        }
        return Character.isWhitespace(sb.charAt(sb.length() - 1));
    }
}
