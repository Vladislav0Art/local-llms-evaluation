package org.traccar.protocol;

import org.junit.Test;

import static org.junit.Assert.*;

import java.io.ByteArrayBuffer;

import io.netty.buffer.ByteBuf;
import io.netty.buffer.Unpooled;
import io.netty.channel.Channel;
import org.traccar.BaseProtocolDecoder;
import org.traccar.NetworkMessage;
import org.traccar.Protocol;
import org.traccar.helper.BitBuffer;
import org.traccar.helper.BitUtil;
import org.traccar.helper.UnitsConverter;
import org.traccar.model.Position;
import org.traccar.session.DeviceSession;

import java.net.SocketAddress;

public class GeneratedTest {

    private static final int DEFAULT_GALILEO_ID = 1;
    private static final String DEFAULT_DEVICE_ID = "device_id";
    private static final byte[] EMPTY_BYTES = new byte[0];
    private Channel channel;
    private SocketAddress remoteAddress;

    @Before
    public void setup() {
        channel = MockChannel.getNewChannel();
        remoteAddress = channelRemoteAddress(channel);
    }

    @After
    public void cleanup() {
        // No-op
    }

    @Test
    public void decodeDecodeTest() throws Exception {
        NetworkMessage message = new NetworkMessage(ByteBufUtil.hexToBytes("0x1234567890abcdef"));
        Object decodedObject = GalileoProtocolDecoder.decode(channel, remoteAddress, message);
        assertNotNull(decodedObject);
    }

    @Test
    public void decodeDecodeWithIdTest() throws Exception {
        NetworkMessage message = new NetworkMessage(ByteBufUtil.hexToBytes("0x1234567890abcdef"));
        NetworkMessage responseMessage = GalileoProtocolDecoder.decode(channel, remoteAddress, message);
        assertEquals(DEFAULT_GALILEO_ID, responseMessage.getId());
    }

    @Test
    public void decodeDecodeWithDeviceIdTest() throws Exception {
        NetworkMessage message = new NetworkMessage(ByteBufUtil.hexToBytes("0x1234567890abcdef"));
        Object decodedObject = GalileoProtocolDecoder.decode(channel, remoteAddress, message);
        assertEquals(DEFAULT_DEVICE_ID, (String) ((Map<String, String>) decodedObject).get("deviceId"));
    }

    @Test
    public void decodeDecodeWithPositionTest() throws Exception {
        NetworkMessage message = new NetworkMessage(ByteBufUtil.hexToBytes("0x1234567890abcdef"));
        Position position = GalileoProtocolDecoder.decode(channel, remoteAddress, message);
        assertNotNull(position);
    }

    @Test
    public void decodeDecodeWithTimestampTest() throws Exception {
        NetworkMessage message = new NetworkMessage(ByteBufUtil.hexToBytes("0x1234567890abcdef"));
        long timestamp = Calendar.getInstance(TimeZone.getDefault()).getTimeInMillis();
        Object decodedObject = GalileoProtocolDecoder.decode(channel, remoteAddress, message);
        assertTrue(decodedObject instanceof Date);
        assertEquals(timestamp, ((Date) decodedObject).getTime());
    }

    @Test
    public void decodeDecodeWithHeartbeatTest() throws Exception {
        NetworkMessage message = new NetworkMessage(ByteBufUtil.hexToBytes("0x1234567890abcdef"));
        boolean heartbeat = GalileoProtocolDecoder.decode(channel, remoteAddress, message);
        assertTrue(heartbeat);
    }

    @Test
    public void decodeDecodeWithUnknownCommandTest() throws Exception {
        NetworkMessage message = new NetworkMessage(ByteBufUtil.hexToBytes("0x1234567890abcdef"));
        Object decodedObject = GalileoProtocolDecoder.decode(channel, remoteAddress, message);
        assertNull(decodedObject);
    }
}

class MockChannel {

    public static Channel getNewChannel() {
        return Unpooled.buffer(1024).channel();
    }

    private static SocketAddress channelRemoteAddress(Channel channel) {
        // Implementation of channelRemoteAddress method
        return new InetSocketAddress("localhost", 12345);
    }

}
