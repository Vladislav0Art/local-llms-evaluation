public class CssFormatterTest {

    @Mock
    private ConfigurationSource cfg;

    public void setUp() {
        MockitoAnnotations.initMocks(this);
    }

    @Test
    public void init_emptyOptions_returnsTrue() throws IOException {
        when(cfg.getOptions()).thenReturn(null);
        assertTrue(new CssFormatter().init(Collections.emptyMap(), cfg));
    }

    @Test
    public void init_nonEmptyOptions_throwsIOException() throws IOException {
        when(cfg.getOptions()).thenReturn("non-empty");
        assertThrows(IOException.class, () -> new CssFormatter().init(Collections.emptyMap(), cfg));
    }

    @Test
    public void doFormat_emptyString_returnsEmptyString() throws IOException {
        assertEquals("", new CssFormatter().doFormat("", LineEnding.LF));
    }

    @Test
    public void doFormat_nonEmptyString_throwsIOException() throws IOException {
        when(cfg.getOptions()).thenReturn("non-empty");
        assertThrows(IOException.class, () -> new CssFormatter().doFormat("non-empty", LineEnding.LF));
    }

    @Test
    public void isInitialized_returnsFalse() {
        assertTrue(new CssFormatter().isInitialized());
    }
}

class MockConfigurationSource implements ConfigurationSource {

    private Map<String, String> options;

    public MockConfigurationSource(Map<String, String> options) {
        this.options = options;
    }

    @Override
    public Map<String, String> getOptions() {
        return options;
    }
}
