public class EpubCheckerTest {

    @Test
    public void getLocale_AnyLocale_ReturnsCorrectLocale() {
        EpubChecker checker = new EpubChecker();
        Locale locale = checker.getLocale();
        assertTrue(locale != null);
    }

    @Test
    public void run_AnyArgs_ReturnsCorrectResult() throws Exception {
        EpubChecker checker = new EpubChecker();
        File file = File.createTempFile("test", ".epub");
        FileWriter writer = new FileWriter(file);
        writer.write("<html><body>Hello World</body></html>");
        writer.close();

        int result = checker.run(new String[]{"--input", file.getAbsolutePath()});
        assertEquals(0, result);
    }

    @Test
    public void processEpubFile_AnyArgs_ReturnsCorrectResult() {
        EpubChecker checker = new EpubChecker();
        File file = File.createTempFile("test", ".epub");
        FileWriter writer = new FileWriter(file);
        writer.write("<html><body>Hello World</body></html>");
        writer.close();

        int result = checker.processEpubFile(new String[]{"--input", file.getAbsolutePath()});
        assertEquals(0, result);
    }

    @Test
    public void validateFile_InvalidVersion_ReturnsCorrectResult() throws Exception {
        EpubChecker checker = new EpubChecker();
        File file = File.createTempFile("test", ".epub");
        FileWriter writer = new FileWriter(file);
        writer.write("<html><body>Hello World</body></html>");
        writer.close();

        int result = checker.validateFile(file.getAbsolutePath(), EPUBVersion.V1, new Report(), new EPUBProfile());
        assertEquals(-1, result);
    }

    @Test
    public void validateFile_ValidVersion_ReturnsCorrectResult() throws Exception {
        EpubChecker checker = new EpubChecker();
        File file = File.createTempFile("test", ".epub");
        FileWriter writer = new FileWriter(file);
        writer.write("<html><body>Hello World</body></html>");
        writer.close();

        int result = checker.validateFile(file.getAbsolutePath(), EPUBVersion.V2, new Report(), new EPUBProfile());
        assertEquals(0, result);
    }

}

