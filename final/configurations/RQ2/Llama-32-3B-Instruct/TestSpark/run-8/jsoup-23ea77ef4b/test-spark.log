        Document htmlDoc = Jsoup.parse("<html><body>Hello World!</body></html>");
        
        org.jsoup.nodes.Element jsoupElement = htmlDoc.selectFirst("body").child(0);
        org.jsoup.nodes.Document fromJsoup = JsoupHelper.fromJsoupConvertsJsoupElementToW3CDom(jsoupElement);
        org.jsoup.nodes.Document expectedResult = htmlDoc;
        org.junit.Assert.assertEquals(expectedResult, fromJsoup);
    }

    @org.junit.Test
    public void testConvertConvertsDocumentToJsoupDoc() {
        Document htmlDoc = Jsoup.parse("<html><body>Hello World!</body></html>");
        
        org.jsoup.nodes.Document result = JsoupHelper.convertConvertsDocumentToJsoupDoc(htmlDoc);
        org.jsoup.nodes.Document expectedResult = Jsoup.parse(result.toString());
        org.junit.Assert.assertEquals(expectedResult, htmlDoc);
    }
}

