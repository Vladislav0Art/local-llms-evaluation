import org.jsoup.helper.Validate;
import org.jsoup.nodes.Attribute;
import org.jsoup.nodes.Attributes;
import org.jsoup.nodes.Element;
import java.util.HashMap;
import java.util.HashSet;
import java.util.Iterator;
import java.util.Map;
import java.util.Set;
import static org.jsoup.internal.Normalizer.lowerCase;

public class SafelistTest {

    @org.junit.Test
    public void noneTagTest() {
        Safelist safelist = Safelist.none();
        Assert.assertTrue(safelist.isSafeTag("img"));
        Assert.assertFalse(safelist.isSafeTag("script"));
    }

    @org.junit.Test
    public void simpleTextTagTest() {
        Safelist safelist = Safelist.simpleText();
        Assert.assertFalse(safelist.isSafeTag("script"));
        Assert.assertFalse(safelist.isSafeTag("style"));
    }

    @org.junit.Test
    public void basicTagTest() {
        Safelist safelist = Safelist.basic();
        Assert.assertTrue(safelist.isSafeTag("img"));
        Assert.assertTrue(safelist.isSafeTag("link"));
        Assert.assertFalse(safelist.isSafeTag("script"));
    }

    @org.junit.Test
    public void basicWithImagesTagTest() {
        Safelist safelist = Safelist.basicWithImages();
        Assert.assertTrue(safelist.isSafeTag("img"));
        Assert.assertTrue(safelist.isSafeTag("link"));
        Assert.assertFalse(safelist.isSafeTag("script"));
    }

    @org.junit.Test
    public void relaxedTagTest() {
        Safelist safelist = Safelist.relaxed();
        Assert.assertTrue(safelist.isSafeTag("a"));
        Assert.assertTrue(safelist.isSafeTag("abbr"));
        Assert.assertFalse(safelist.isSafeTag("script"));
    }

    @org.junit.Test
    public void addTagsTagTest() {
        Safelist safelist = Safelist.addTags("img", "link");
        Assert.assertTrue(safelist.isSafeTag("img"));
        Assert.assertTrue(safelist.isSafeTag("link"));
    }

    @org.junit.Test
    public void removeTagsTagTest() {
        Safelist safelist = Safelist.addTags("script", "style");
        Assert.assertFalse(safelist.isSafeTag("script"));
        Assert.assertFalse(safelist.isSafeTag("style"));
    }

    @org.junit.Test
    public void addAttributesTagTest() {
        Safelist safelist = Safelist.addAttributes("img", "alt", "image.jpg");
        Attribute attribute = new Attribute("alt", "image.jpg");
        Assert.assertTrue(safelist.isSafeAttribute("img", null, attribute));
    }

    @org.junit.Test
    public void removeAttributesTagTest() {
        Safelist safelist = Safelist.addAttributes("script", "src", "js.js");
        Attribute attribute = new Attribute("src", "js.js");
        Assert.assertFalse(safelist.isSafeAttribute("script", null, attribute));
    }

    @org.junit.Test
    public void addEnforcedAttributeTagTest() {
        Safelist safelist = Safelist.addEnforcedAttributes("img", "alt", "image.jpg");
        Attribute attribute = new Attribute("alt", "image.jpg");
        Assert.assertTrue(safelist.isSafeAttribute("img", null, attribute));
    }

    @org.junit.Test
    public void removeEnforcedAttributeTagTest() {
        Safelist safelist = Safelist.addEnforcedAttributes("script", "src", "js.js");
        Attribute attribute = new Attribute("src", "js.js");
        Assert.assertFalse(safelist.isSafeAttribute("script", null, attribute));
    }

    @org.junit.Test
    public void preserveRelativeLinksTest() {
        Safelist safelist = Safelist.preserveRelativeLinks(true);
        Assert.assertTrue(safelist.isSafeTag("a"));
        Assert.assertTrue(safelist.isSafeTag("abbr"));
    }

    @org.junit.Test
    public void addProtocolsAttributeTest() {
        Safelist safelist = Safelist.addAttributes("img", "src", "http://example.com");
        Set<String> protocols = new HashSet<>();
        protocols.add("http:");
        Assert.assertTrue(safelist.getEnforcedAttributes("img").containsKey("src"));
    }

    @org.junit.Test
    public void removeProtocolsAttributeTest() {
        Safelist safelist = Safelist.addAttributes("script", "src", "https://example.com");
        Set<String> protocols = new HashSet<>();
        protocols.add("https:");
        Assert.assertFalse(safelist.getEnforcedAttributes("script").containsKey("src"));
    }

