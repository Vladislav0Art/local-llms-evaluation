import org.junit.Test;
import static org.junit.Assert.assertEquals;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.Mockito;
import org.mockito.junit.MockitoJUnitRunner;

@RunWith(MockitoJUnitRunner.class)
public class OnlineStockSpanTest {

    @Mock
    private Stack<Integer> stack;

    public List<Integer> calculateSpans() {
        return new ArrayList<>();
    }

    @Test
    public void next_0_Returns1() {
        int result = OnlineStockSpan.next(0);
        assertEquals(1, result);
    }

    @Test
    public void next_NegativeNumber_Returns1() {
        int result = OnlineStockSpan.next(-1);
        assertEquals(1, result);
    }

    @Test
    public void next PositiveNumber_Returns1() {
        int result = OnlineStockSpan.next(1);
        assertEquals(1, result);
    }

    @Test
    public void calculateSpans_EmptyArray_ReturnsEmptyList() {
        int[] prices = new int[0];
        int[] result = OnlineStockSpan.calculateSpans(prices);
        assertEquals(0, result.length);
    }

    @Test
    public void calculateSpans_SingleElementArray_ReturnsSingleElement() {
        int[] prices = {1};
        int[] result = OnlineStockSpan.calculateSpans(prices);
        assertEquals(1, result[0]);
    }

    @Test
    public void next_0WithStack_Returns2() throws Exception {
        stack.add(0);
        OnlineStockSpan stockSpan = new OnlineStockSpan();
        for (int i : stack) {
            int temp = stockSpan.next(i);
            //do nothing
        }
        assertEquals(1, stockSpan.next(0));
    }

    @Test
    public void next_NegativeNumberWithStack_Returns2() throws Exception {
        stack.add(-1);
        OnlineStockSpan stockSpan = new OnlineStockSpan();
        for (int i : stack) {
            int temp = stockSpan.next(i);
            //do nothing
        }
        assertEquals(1, stockSpan.next(-1));
    }

    @Test
    public void next_PositiveNumberWithStack_Returns2() throws Exception {
        stack.add(1);
        OnlineStockSpan stockSpan = new OnlineStockSpan();
        for (int i : stack) {
            int temp = stockSpan.next(i);
            //do nothing
        }
        assertEquals(1, stockSpan.next(1));
    }

    @Test
    public void next_MultipleTimesWithStack_ReturnsIncreasingValues() throws Exception {
        stack.add(-5);
        stack.add(3);
        stack.add(1);
        OnlineStockSpan stockSpan = new OnlineStockSpan();
        for (int i : stack) {
            int temp = stockSpan.next(i);
            //do nothing
        }
        assertEquals(2, stockSpan.next(-5));
        assertEquals(3, stockSpan.next(3));
        assertEquals(1, stockSpan.next(1));
    }

}
