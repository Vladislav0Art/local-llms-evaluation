**Tokenization of HTML**

Here's an example of how to tokenize an HTML string into tokens using Java:

```java
import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;

public class Main {

    public static void main(String[] args) {
        String htmlString = "<html><body>Hello, world!</body></html>";

        // Parse the HTML string
        Document doc = Jsoup.parse(htmlString);

        // Get all tokens from the parsed document
        Token[] tokens = getTokens(doc);

        for (Token token : tokens) {
            System.out.println(token);
        }
    }

    public static Token[] getTokens(Document doc) {
        Element rootElement = doc.selectFirst("body").first();
        int index = 0;

        while (index < rootElement.length()) {
            char c = rootElement.charAt(index);

            if (c == '<') {
                // Doctype
                System.out.println("DOCTYPE");
            } else if (Character.isWhitespace(c)) {
                // White space
                System.out.println("WHITE_SPACE");
            } else if (c == '/') {
                // End tag
                System.out.println("END_TAG");
            } else if (Character.isLetter(c) || Character.isDigit(c)) {
                // Tag name
                String tagName = getTagName(rootElement, index);
                System.out.println("TAG_NAME:" + tagName);

                // Get the attributes of the tag
                Attribute[] attributes = getAttributes(rootElement, index);
                for (Attribute attribute : attributes) {
                    System.out.println(attribute);
                }
            } else if (!Character.isWhitespace(c)) {
                // Data
                String data = getData(rootElement, index);
                System.out.println("DATA:" + data);

                // Get the next token
                index++;
            }

            index++;
        }

        return new Token[tokens.length];
    }

    public static String getTagName(Element element, int index) {
        while (index < element.length() && Character.isWhitespace(element.charAt(index))) {
            index++;
        }

        if (index >= element.length()) {
            return null;
        }

        StringBuilder tagName = new StringBuilder();
        while (index < element.length() && !Character.isWhitespace(element.charAt(index))) {
            tagName.append(element.charAt(index));
            index++;
        }

        return tagName.toString();
    }

    public static Attribute[] getAttributes(Element element, int index) {
        // Get all attributes
        Document attrsDoc = Jsoup.parse("<" + element.tagName() + " " + element.attributes().keySet().iterator().next() + "></" + element.tagName() + ">");

        Element firstTagElement = attrsDoc.selectFirst("body").first();
        Attribute[] attributes = new Attribute[firstTagElement.length()];

        int i = 0;
        while (i < firstTagElement.length()) {
            if (Character.isLetter(firstTagElement.charAt(i)) || Character.isDigit(firstTagElement.charAt(i))) {
                break;
            }

            i++;
        }

        while (i < firstTagElement.length()) {
            // Get the attribute name
            String attributeName = getTagName(firstTagElement, i);

            // Get the attribute value
            String attributeValue = getData(firstTagElement, i + 1);

            // Add the attribute to the array
            attributes[i - 1] = new Attribute(attributeName, attributeValue);

            i += attributeName.length() + 2;
        }

        return attributes;
    }

    public static String getData(Element element, int index) {
        while (index < element.length() && Character.isWhitespace(element.charAt(index))) {
            index++;
        }

        if (index >= element.length()) {
            return null;
        }

        StringBuilder data = new StringBuilder();
        while (index < element.length() && !Character.isWhitespace(element.charAt(index))) {
            data.append(element.charAt(index));
            index++;
        }

        return data.toString();
    }
}

class Token {

    private int type;
    private String value;

    public Token(int type, String value) {
        this.type = type;
        this.value = value;
    }

    @Override
    public String toString() {
        return "Token{" +
                "type=" + type +
                ", value='" + value + '\'' +
                '}';
    }
}

class Attribute {

    private String name;
    private String value;

    public Attribute(String name, String value) {
        this.name = name;
        this.value = value;
    }

    @Override
    public String toString() {
        return "Attribute{" +
                "name='" + name + '\'' +
                ", value='" + value + '\'' +
                '}';
    }
}
```

In this example, we define a `Token` class to represent each token in the HTML string. We also define an `Attribute` class to represent each attribute of a tag.

The `getTokens` method is used to get all tokens from the parsed document. It iterates over the elements and gets the token type (doctype, white space, end tag, etc.) or value (tag name, data, etc.). The `getTagName` method is used to get the tag name of an element, and the `getAttributes` method is used to get all attributes of a tag.

Note that this is a simplified example and may not cover all possible HTML tokenization scenarios.
