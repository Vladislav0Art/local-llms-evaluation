    public void processTokenStartTagTest() {
        Token token = new Token(Token.Type.START_TAG, "tag");
        assertTrue(treeBuilder.process(token));
    }

    @Test
    public void processTokenEndTagTest() {
        Token token = new Token(Token.Type.END_TAG, "tag");
        assertTrue(treeBuilder.process(token));
    }

