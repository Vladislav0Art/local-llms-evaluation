import org.junit.Test;
import static org.junit.Assert.*;
import java.io.File;
import java.util.HashMap;

public class EpubCheckerTest {

    @Test
    public void getLocale_DeterminesDefaultLocale() {
        assertEquals(Locale.getDefault(), new EpubChecker().getLocale());
    }

    @Test
    public void run_ValidatesEpubFileAndReturnsSuccess() throws Exception {
        String[] args = {"-v", "1.0"};
        EpubChecker checker = new EpubChecker();
        int result = checker.run(args);
        assertTrue(result == 0);
    }

    @Test
    public void run_InvalidatesEpubFileWithNonZeroExitCode() throws Exception {
        String[] args = {"-v", "1.0"};
        EpubChecker checker = new EpubChecker();
        int result = checker.run(args);
        assertFalse(result == 0);
    }

    @Test
    public void validateFile_ValidatesEpubFileAndReturnsSuccess() throws Exception {
        File file = new File("test.epub");
        EpubChecker checker = new EpubChecker();
        int result = checker.validateFile(file.toURI().toString(), EPUBVersion.V2_0, new Report(), new EPUBProfile());
        assertTrue(result == 0);
    }

    @Test
    public void validateFile_ValidatesEpubFileAndReturnsFailure() throws Exception {
        File file = new File("test.epub");
        EpubChecker checker = new EpubChecker();
        int result = checker.validateFile(file.toURI().toString(), EPUBVersion.V3_0, new Report(), new EPUBProfile());
        assertTrue(result != 0);
    }

    @Test
    public void processEpubFile_DoesNotSupportMethod() {
        @SuppressWarnings("unused")
        EpubChecker checker = new EpubChecker();
        assertThrows(UnsupportedOperationException.class, () -> checker.processEpubFile(new String[]{"-v", "1.0"}));
    }

    private static class MockLocale extends Locale {
        public boolean getBestVariant() {
            return true;
        }
    }

    @Test
    public void getLocale_MatchesMockedLocale() throws Exception {
        MockLocale locale = new MockLocale();
        EpubChecker checker = new EpubChecker();
        Locale result = checkergetLocale();
        assertEquals(locale, result);
    }
}
