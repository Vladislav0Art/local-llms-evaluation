```java
public class HTMLParser implements NodeVisitor {

    private Document document;

    public HTMLParser(Document document) {
        this.document = document;
    }

    @Override
    public void visit(Node node) {
        if (node instanceof Element) {
            Element element = (Element) node;
            System.out.println(element.html);
            for (String attribute : element.outputSettings().attributeNames()) {
                String value = element.outputSettings().get(attribute);
                System.out.println("Attribute: " + attribute + ", Value: " + value);
            }
        } else if (node instanceof Document) {
            document = (Document) node;
        }
    }
}
```

```java
public class HTMLGenerator implements NodeVisitor {

    private Document document;

    public HTMLGenerator(Document document) {
        this.document = document;
    }

    @Override
    public void visit(Node node) {
        if (node instanceof Element) {
            Element element = (Element) node;
            System.out.println("<" + element.html + ">");
            for (String attribute : element.outputSettings().attributeNames()) {
                String value = element.outputSettings().get(attribute);
                System.out.print(" " + attribute + "=\"" + value + "\"");
            }
            System.out.println(">");
        } else if (node instanceof Document) {
            document = (Document) node;
        }
    }
}
```

```java
public class Main {

    public static void main(String[] args) {
        // Create a new HTML parser and generator
        HTMLParser parser = new HTMLParser(new Document());
        HTMLGenerator generator = new HTMLGenerator(new Document());

        // Create some nodes for testing
        Node element1 = new Element("<div>", 0);
        element1.outputSettings().add("class", "container");
        element1.outputSettings().add("id", "main-content");

        Node element2 = new Element("<p>", 0);

        Node document = new Document();
        document.add(element1);
        document.add(element2);

        // Traverse the tree with the parser
        parser.visit(document);

        // Generate HTML from the parsed elements
        generator.visit(document);

        System.out.println("\nGenerated HTML:");
        for (Element element : document.elements()) {
            generator.visit(element);
        }
    }
}
