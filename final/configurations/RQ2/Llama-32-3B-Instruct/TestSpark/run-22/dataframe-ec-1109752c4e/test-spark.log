        this.expr = expr;
    }

    public String getExpr() {
        return expr;
    }
}

public class PropertyPathExpr {
    private VarExpr varExpr;
    private String path;

    public PropertyPathExpr(VarExpr varExpr, String path) {
        this.varExpr = varExpr;
        this.path = path;
    }

    public VarExpr getVarExpr() {
        return varExpr;
    }
}

public class AliasExpr {
    private VarExpr varExpr;
    private String alias;

    public AliasExpr(VarExpr varExpr, String alias) {
        this.varExpr = varExpr;
        this.alias = alias;
    }

    public VarExpr getVarExpr() {
        return varExpr;
    }
}

