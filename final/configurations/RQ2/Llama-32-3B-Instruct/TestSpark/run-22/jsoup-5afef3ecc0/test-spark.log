package org.jsoup.helper;

import org.junit.Test;
import org.junit.runner.RunWith;
import org.junit.runners.JUnit4;
import java.net.MalformedURLException;
import java.net.URI;
import java.net.URISyntaxException;
import java.net.URL;
import java.net.URLEncoder;
import static org.junit.Assert.*;
import java.util.Map;
import java.util.HashMap;
import org.jsoup.Connection.KeyVal;
import static org.jsoup.helper.DataUtil.UTF_8;

@RunWith(JUnit4.class)
public class UrlBuilderTest {

    @Test
    public void newUrlBuilderEmptyUrl() {
        assertNull(new UrlBuilder(null).build());
    }

    @Test
    public void newUrlBuilderInvalidUrl() {
        assertThrows(MalformedURLException.class, () -> new UrlBuilder("invalid://url").build());
    }

    @Test
    public void buildUrl() {
        URL inputUrl = new URL("http://example.com");
        UrlBuilder builder = new UrlBuilder(inputUrl);
        assertEquals(new URL("http://example.com"), builder.build());
    }

    @Test
    public void appendKeyValUrlBuilder() throws UnsupportedEncodingException, URISyntaxException {
        String key = "key";
        String val = "value";
        Connection.KeyVal kv = new KeyVal(key, val);
        UrlBuilder builder = new UrlBuilder(new URL("http://example.com"));
        builder.appendKeyVal(kv);
        assertEquals(new URL("http://example.com?key=value"), builder.build());
    }

    @Test
    public void appendMultipleKeyValsUrlBuilder() throws UnsupportedEncodingException, URISyntaxException {
        String key1 = "key1";
        String val1 = "value1";
        String key2 = "key2";
        String val2 = "value2";
        Connection.KeyVal kv1 = new KeyVal(key1, val1);
        Connection.KeyVal kv2 = new KeyVal(key2, val2);
        UrlBuilder builder = new UrlBuilder(new URL("http://example.com"));
        builder.appendKeyVal(kv1);
        builder.appendKeyVal(kv2);
        assertEquals(new URL("http://example.com?key1=value1&key2=value2"), builder.build());
    }

    @Test
    public void appendNoKeyValsUrlBuilder() {
        UrlBuilder builder = new UrlBuilder(new URL("http://example.com"));
        assertTrue(builder.build().getQuery().isEmpty());
    }

    @Test
    public void buildQueryEmptyMap() {
        Map<String, String> map = new HashMap<>();
        UrlBuilder builder = new UrlBuilder(new URL("http://example.com"));
        assertEquals(new URI("http://example.com?"), builder.build());
    }

    @Test
    public void appendKeyValMultipleTimesUrlBuilder() throws UnsupportedEncodingException, URISyntaxException {
        String key1 = "key1";
        String val1 = "value1";
        String key2 = "key2";
        String val2 = "value2";
        Connection.KeyVal kv1 = new KeyVal(key1, val1);
        Connection.KeyVal kv2 = new KeyVal(key2, val2);
        UrlBuilder builder = new UrlBuilder(new URL("http://example.com"));
        builder.appendKeyVal(kv1);
        builder.appendKeyVal(kv2);
        builder.appendKeyVal(kv1); // append again to test overwrite
        assertEquals(new URL("http://example.com?key1=value1&key2=value2"), builder.build());
    }

    @Test
    public void appendNoUrlBuilder() {
        UrlBuilder builder = new UrlBuilder(null);
        assertThrows(UnsupportedEncodingException.class, () -> builder.appendKeyVal(null));
    }
}
