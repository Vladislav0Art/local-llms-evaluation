import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.select.Elements;

import java.io.IOException;
import java.net.URL;
import java.util.Arrays;

public class GeneratedTest {
    public static String build(String url) throws IOException, URISyntaxException {
        Document document = Jsoup.connect(url).get();
        StringBuilder sb = new StringBuilder();
        for (Element element : document.body().getAllElements()) {
            sb.append(element.text());
        }
        return sb.toString();
    }

    public void appendKeyVal(String key, String val, String url) throws IOException, URISyntaxException {
        try {
            Document document = Jsoup.connect(url).get();
            Elements elements = document.select("body");
            StringBuilder sb = new StringBuilder();
            for (Element element : elements) {
                sb.append(element.text());
            }
            if (!sb.toString().contains(key)) {
                sb.append(key);
                sb.append(val);
            }
        } catch (URISyntaxException e) {
            throw new URISyntaxException("Invalid URL", "URL cannot be parsed");
        }
    }

    public void appendKeyValMultipleTimes(String key, String val, String url) throws IOException, URISyntaxException {
        try {
            Document document = Jsoup.connect(url).get();
            Elements elements = document.select("body");
            StringBuilder sb = new StringBuilder();
            for (Element element : elements) {
                sb.append(element.text());
            }
            for (int i = 0; i < 5; i++) {
                sb.append(key);
                sb.append(val);
            }
        } catch (URISyntaxException e) {
            throw new URISyntaxException("Invalid URL", "URL cannot be parsed");
        }
    }

    public void appendMultipleKeyVal(String[] keyVals, String url) throws IOException, URISyntaxException {
        try {
            Document document = Jsoup.connect(url).get();
            Elements elements = document.select("body");
            StringBuilder sb = new StringBuilder();
            for (Element element : elements) {
                sb.append(element.text());
            }
            for (String[] kv : Arrays.asList(keyVals)) {
                String k = kv[0];
                String v = kv[1];
                if (!sb.toString().contains(k)) {
                    sb.append(k);
                    sb.append(v);
                }
            }
        } catch (URISyntaxException e) {
            throw new URISyntaxException("Invalid URL", "URL cannot be parsed");
        }
    }

    public void main() throws IOException, URISyntaxException {
        System.out.println(build("http://www.example.com"));
        appendKeyVal("hello world", "test url", "http://www.example.com");
        appendKeyValMultipleTimes("key1 value1 key2 value2 key3 value3", "test url", "http://www.example.com");
        String[] keyVals = {"key1", "value1", "key2", "value2"};
        appendMultipleKeyVal(keyVals, "http://www.example.com");
    }
}

class URISyntaxException extends Exception {
    public URISyntaxException(String message, Throwable cause) {
        super(message, cause);
    }

    public URISyntaxException(String message) {
        this(message, null);
    }
}
