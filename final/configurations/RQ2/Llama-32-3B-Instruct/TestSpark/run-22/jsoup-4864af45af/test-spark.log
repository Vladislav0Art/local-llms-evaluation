    @org.junit.Test
    public void testSafelistPreserveRelativeLinks() {
        Safelist safelist = new Safelist();
        Document doc = new Document("https://example.com");
        Element imgTag = doc.createElement("img");
        String link = "image.jpg";
        safelist.preserveRelativeLinks(true);
        String expectedLink = "https://example.com/image.jpg";
        assert link.equals(expectedLink);
    }

    public static class Safelist {
        private boolean preserveRelativeLinks;

        public Safelist() {}

        public void preserveRelativeLinks(boolean preserve) {
            this.preserveRelativeLinks = preserve;
        }

        public boolean preserveRelativeLinks() {
            return preserveRelativeLinks;
        }
    }
