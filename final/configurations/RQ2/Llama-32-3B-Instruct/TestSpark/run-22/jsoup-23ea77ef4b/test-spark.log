import org.jsoup.nodes.Document;
import javax.xml.parsers.DocumentBuilderFactory;
import org.w3c.dom.Document;

public class DocumentUtil {

    public static String asString(Document doc) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < doc.getDocumentElement().getAttributes().size(); i++) {
            sb.append(doc.getDocumentElement().getAttribute(i));
        }
        return sb.toString();
    }

    public static Document fromJsoup(org.jsoup.nodes.Document jsoupDoc) {
        DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();
        DocumentBuilder builder = factory.newDocumentBuilder();
        InputSource source = new InputSource(new StringReader(jsoupDoc.html()));
        return builder.parse(source);
    }
}

public class ContextNodeUtil {

    public static Node contextNode(Document doc) {
        // Assuming the node is a DOM element
        // This will throw an exception if it's not a DOM element
        org.w3c.dom.Node node = doc.getDocumentElement();
        if (node.getNodeType() == Node.ELEMENT_NODE) {
            return node;
        } else {
            // If it's not a DOM element, this could be a text or comment node
            // This will throw an exception if it's not a text or comment node
            org.w3c.dom.Node node = doc.getTextContent();
            if (node.getNodeType() == Node.TEXT_NODE) {
                return node;
            } else {
                return null; // or some other default value
            }
        }
    }

    public static void main(String[] args) {
        Document jsoupDoc = org.jsoup.nodes.Document.newBuilder().html("<html><body>Hello World!</body></html>").build();
        Document wDoc = DocumentUtil.fromJsoup(jsoupDoc);
        System.out.println(DocumentUtil.asString(wDoc));
        Node result = ContextNodeUtil.contextNode(wDoc);
        if (result != null) {
            System.out.println(result.getNodeName());
        } else {
            System.out.println("No context node found");
        }
    }
}
```

