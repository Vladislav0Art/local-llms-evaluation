        accum.append("</div>");
        return accum.toString();
    }
}

public class Document {
    private Node root;

    public void appendChild(Node child) {
        if (root == null) {
            root = new Node(child);
        } else {
            root.appendChild(child);
        }
    }

    @Override
    public String toString() {
        // assume a method to get the string representation of this document
        return "Document";
    }
}

public class Node {
    private final String text;
    private Node child;

    public Node(String text, Node child) {
        this.text = text;
        this.child = child;
    }

    @Override
    public String toString() {
        // assume a method to get the string representation of this node
        return text;
    }
}

