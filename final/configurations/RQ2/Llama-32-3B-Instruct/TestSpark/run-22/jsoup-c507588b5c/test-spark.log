        // create an Appendable to accumulate strings
        ByteArrayOutputStream accum = new ByteArrayOutputStream();
        
        // create a Document and append it to the accumulator
        Document document = new Document();
        Node node = new Node("Node", null);
        document.appendChild(node);
        
        // assert that the accumulated string is correct
        assertEquals("<div>Node</div>", GeneratedTest.accumulateToString(accum));
    }

