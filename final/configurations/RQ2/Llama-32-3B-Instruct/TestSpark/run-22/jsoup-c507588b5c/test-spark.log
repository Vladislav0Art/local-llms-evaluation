        String expected = TextNode.stripLeadingWhitespace(input);
        assertEquals(expected, "Hello, World!");
    }

    public static void testLastCharIsWhitespace() {
        char c = ' ';
        assertTrue(TextNode.lastCharIsWhitespace(c));
    }
}

