    public String getConfigurationSource(LineEnding lineEnding) {
        switch (lineEnding) {
            case LF:
                return "body { background-color: #f2f2f2; }";
            case LT:
                return "body { background-color: #f2f2f2; }";
            case TS:
                return "body { background-color: #f2f2f2; }";
            default:
                return "";
        }
    }

    public enum LineEnding {
        LF("lf"),
        LT("lt"),
        TS("ts");

        private String value;

        LineEnding(String value) {
            this.value = value;
        }

        public String getValue() {
            return value;
        }
    }
