                System.out.println("Adding column: " + column + " of type Float");
            }
        }

        // Add clustering key column
        System.out.println("Adding clustering key column: " + clusteringColumn);
    }

    public void insertIntoTable(String tableName, Hashtable<String, Object> htblColNameValueMock) {
        System.out.println("Inserting into table: " + tableName);

        for (String column : htblColNameValueMock.keySet()) {
            Object value = htblColNameValueMock.get(column);
            System.out.println("Adding value to column: " + column + " with value: " + value);
        }
    }

    public void updateTable(String tableName, String clusteringColumn, Hashtable<String, Object> htblClNameValueMock) {
        System.out.println("Updating table: " + tableName);

        for (String column : htblClNameValueMock.keySet()) {
            Object value = htblClNameValueMock.get(column);
            System.out.println("Updating column: " + column + " with new value: " + value);
        }

        // Update clustering key
        System.out.println("Updating clustering key: " + clusteringColumn);
    }

    public void deleteFromTable(String tableName, Hashtable<String, Object> htblClNameValueMock) {
        System.out.println("Deleting from table: " + tableName);

        for (String column : htblClNameValueMock.keySet()) {
            Object value = htblClNameValueMock.get(column);
            System.out.println("Deleting row with column: " + column + " and value: " + value);
        }
    }

    public String selectFromTable(SQLTerm[] arrSQLTermsMock, String[] strarrOperatorsMock) {
        System.out.println("Selecting from table");

        // Retrieve relevant data
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < arrSQLTermsMock.length; i++) {
            SQLTerm term = arrSQLTermsMock[i];
            if (strarrOperatorsMock[i].equals("AND")) {
                sb.append(term.sql);
            }
        }

        return sb.toString();
    }
}

public class SQLTerm {
    private String sql;

    public SQLTerm(String sql) {
        this.sql = sql;
    }

    @Override
    public String toString() {
        return sql;
    }
}

