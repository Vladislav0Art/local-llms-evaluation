import org.junit.Before;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;

import java.util.Arrays;
import java.util.List;

import static org.hamcrest.MatcherAssert.assertThat;
import static org.hamcrest.Matchers.is;
import static org.hamcrest.Matchers.not;
import static org.junit.Assert.assertEquals;
import static org.mockito.Mockito.when;

import com.ezylang.evalex.config.ExpressionConfiguration;
import com.ezylang.evalex.config.FunctionDictionaryIfc;
import com.ezylang.evalex.config.OperatorDictionaryIfc;
import com.ezylang.evalex.functions.FunctionIfc;
import com.ezylang.evalex.operators.OperatorIfc;
import com.ezylang.evalex.parser.ParserException;
import com.ezylang.evalex.parser.Token;
import com.ezylang.evalex.parser.Tokenizer;

@RunWith(org.junit.runners.JUnit4.class)
public class TokenizerTest {

    @Mock
    private ExpressionConfiguration configuration;

    @Mock
    private FunctionDictionaryIfc functionDictionary;

    @Mock
    private OperatorDictionaryIfc operatorDictionary;

    private List<Token> tokens;
    private Tokenizer tokenizer;

    public TokenizerTest() {
        MockitoAnnotations.initMocks(this);
        when(configuration.getFunctionDictionary()).thenReturn(functionDictionary);
        when(configuration.getOperatorDictionary()).thenReturn(operatorDictionary);

        tokens = Arrays.asList(new Token(TokenType.Ident, "test"));
    }

    @Test
    public void testConstructorWithValidExpressionString() throws ParseException {
        tokenizer = new Tokenizer("test expression", configuration);
    }

    @Test
    public void testConstructorWithoutExpressionString() throws ParseException {
        tokenizer = new Tokenizer("", configuration);
    }

    @Test
    public void testParseMethodReturnsEmptyListForEmptyInput() throws ParseException {
        when(tokenizer.parse()).thenReturn(new ArrayList<>());
        List<Token> result = tokenizer.parse();
        assertThat(result, is(new ArrayList<>()));
    }

    @Test
    public void testParseMethodReturnsCorrectTokensForValidInput() throws ParseException {
        List<Token> expected = Arrays.asList(new Token(TokenType.Ident, "test"));
        when(tokenizer.parse()).thenReturn(expected);
        List<Token> result = tokenizer.parse();
        assertThat(result, is(expected));
    }

    @Test
    public void testParseStringLiteralMethodReturnsNullForEmptyInput() throws ParseException {
        when(tokenizer.parseStringLiteral()).thenReturn(null);
        Token result = tokenizer.parseStringLiteral();
        assertThat(result, not(is(null)));
    }

    @Test
    public void testParseStringLiteralMethodReturnsCorrectTokenForValidInput() throws ParseException {
        List<Token> expected = Arrays.asList(new Token(TokenType.StringLiteral, "test"));
        when(tokenizer.parse()).thenReturn(expected);
        Token result = tokenizer.parseStringLiteral();
        assertThat(result, is(new Token(TokenType.StringLiteral, "test")));
    }

}
