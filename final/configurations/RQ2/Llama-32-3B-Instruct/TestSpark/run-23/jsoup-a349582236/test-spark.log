import org.jsoup.helper.Validate;
import org.jsoup.internal.Normalizer;
import org.junit.Test;
import static org.junit.Assert.*;
import java.util.HashMap;
import java.util.Map;

public class TagTest {

    @Test
    public void testNameGetTest() {
        Tag tag = new Tag();
        assertEquals("Tag", tag.getName());
    }

    @Test
    public void testNormalNameEmptyStringReturnEmptyStringTest() {
        Tag tag = new Tag();
        String normalName = tag.normalName();
        assertTrue(normalName.isEmpty());
    }

    @Test
    public void testNormalNameSingleCharacterReturnSingleCharacterTest() {
        Tag tag = new Tag();
        char[] expected = new char[1];
        char c = 'a';
        for (int i=0; i<1; ++i) {
            expected[i] = c;
        }
        String normalName = tag.normalName();
        assertTrue(normalName.length() == 1);
    }

    @Test
    public void testNormalNameMultipleCharactersReturnFirstCharacterInLowercaseTest() {
        Tag tag = new Tag();
        char[] expected = Normalizer.nfc("abc");
        char[] actual = tag.normalName().toCharArray();
        assertArrayEquals(expected, actual);
    }

    @Test
    public void testNormalNameMultipleCharactersReturnFirstCharacterUpperWithSpaceTest() {
        Tag tag = new Tag();
        String tagName = "Abc";
        String normalName = tag.normalName();
        assertTrue(normalName.length() > 0);
    }

    @Test
    public void testEmptyTagNameReturnUnknownTagTest() {
        Tag tag = Tag.valueOf("");
        assertTrue(!tag.isKnownTag());
    }

    @Test
    public void testUnknownTagNameReturnUnknownTagTest() {
        Tag tag = Tag.valueOf("abc");
        assertTrue(tag.isKnownTag());
    }

    @Test
    public void testEmptySelfClosingTagReturnTrueTest() {
        Tag tag = new Tag();
        assertTrue(tag.setSelfClosing().isSelfClosing());
    }

    @Test
    public void testNonEmptyTagNameFormatAsBlockTest() {
        Tag tag = new Tag();
        assertFalse(tag.formatAsBlock());
        // This is not very accurate because we have to rely on
        // the browser's DOM implementation.
    }

    @Test
    public void testTagWithBlockFormatReturnsTrueTest() {
        Tag tag = new Tag();
        tag.formatAsBlock();
        assertTrue(tag.formatAsBlock());
    }

    @Test
    public void testNullTagNameReturnFalseTest() {
        Tag tag = new Tag();
        assertFalse(tag.isKnownTag(null));
    }

    @Test
    public void testUnknownTagNamePreserveWhitespaceReturnsFalseTest() {
        Tag tag = Tag.valueOf("abc");
        assertFalse(tag.preserveWhitespace());
    }

    @Test
    public void testEmptyNameReturnFalseTest() {
        Tag tag = new Tag();
        assertFalse(tag.isFormListed());
    }

    @Test
    public void testUnknownTagNameIsSubmittableReturnsTrueTest() {
        Tag tag = Tag.valueOf("abc");
        assertTrue(tag.isFormSubmittable());
    }
}
