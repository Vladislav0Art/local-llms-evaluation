public class OnlineStockSpanTest {

    @Test
    public void next_PriceGreaterThan0_Returns1() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int result = onlineStockSpan.next(10);
        assertEquals(1, result);
    }

    @Test
    public void next_PriceEqualTo0_Returns1() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int result = onlineStockSpan.next(0);
        assertEquals(1, result);
    }

    @Test
    public void next_PriceLessThan0_Returns0() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int result = onlineStockSpan.next(-10);
        assertEquals(0, result);
    }

    @Test
    public void calculateSpans_EmptyArray_ReturnsEmptyArray() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int[] result = onlineStockSpan.calculateSpans(new int[0]);
        assertArrayEquals(int[], result);
    }

    @Test
    public void calculateSpans_SingleElementArray_ReturnsSingleElementArray() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int[] prices = {10};
        int[] result = onlineStockSpan.calculateSpans(prices);
        assertArrayEquals(int[]{1}, result);
    }

    @Test
    public void calculateSpans_MultipleElementArray_ReturnsCorrectSpans() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int[] prices = {10, 7, 5, 8, 11, 9};
        int[] result = onlineStockSpan.calculateSpans(prices);
        assertArrayEquals(int[]{1, 2, 1, 3, 4, 3}, result);
    }
}
