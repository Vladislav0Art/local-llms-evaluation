    @org.junit.Test
    public void testGetPublicAndSignerPublicKeys() {
        String secret = "secret_seed";
        String publicKey = "public_key";
        String signerPublicKey = "signer_public_key";

        org.stellar.sdk.KeyPair keyPair = KeyPair.fromSecretSeed(secret, publicKey, signerPublicKey);

        assertEquals(publicKey, keyPair.getPublicKey());
        assertEquals(signerPublicKey, keyPair.getSignerPublicKey());

        org.junit.Assert.assertTrue(keyPair.getPublicKey().equals(publicKey));
        org.junit.Assert.assertTrue(keyPair.getSignerPublicKey().equals(signerPublicKey));
    }

    @org.junit.Test
    public void testGetPublicAndSignerPublicKeysEmpty() {
        String secret = "";
        String publicKey = "public_key";
        String signerPublicKey = "";

        try {
            org.stellar.sdk.KeyPair keyPair = KeyPair.fromSecretSeed(secret, publicKey, signerPublicKey);
            fail("Expected exception");
        } catch (org.junit.Assert.fail.EvaluationFailureException e) {
