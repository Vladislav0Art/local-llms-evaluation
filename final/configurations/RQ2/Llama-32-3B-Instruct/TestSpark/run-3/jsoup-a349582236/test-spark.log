import org.jsoup.parser.Tag;
import org.junit.Test;
import static org.junit.Assert.*;
import java.util.HashMap;
import java.util.Map;

public class TagTest {

    @Test
    public void getName_EmptyName_ReturnsEmptyString() {
        Tag tag = new Tag();
        assertEquals("", tag.getName());
    }

    @Test
    public void normalName_UpperCaseTagName_ReturnsLowerCaseString() {
        Tag tag = new Tag();
        tag.setName("HTML");
        assertEquals("html", tag.normalName());
    }

    @Test
    public void normalName_EmptyTagName_ReturnsEmptyString() {
        Tag tag = new Tag();
        assertEquals("", tag.normalName());
    }

    @Test
    public void valueOf_NoSettings_ReturnsDefaultTag() {
        ParseSettings settings = null;
        Tag tag = Tag.valueOf("tag");
        assertNotNull(tag);
    }

    @Test
    public void valueOf_SimpleTagName_ReturnsKnownTag() {
        String tagName = "p";
        Tag tag = Tag.valueOf(tagName, new ParseSettings());
        assertTrue(Tag.isKnownTag(tagName));
    }

    @Test
    public void isBlock_NoStyle_ReturnsFalse() {
        Tag tag = new Tag();
        assertFalse(tag.isBlock());
    }

    @Test
    public void formatAsBlock_TagIsBlockAndStyleNotEmpty_ReturnsTrue() {
        Tag tag = new Tag();
        tag.setName("div");
        assertTrue(tag.formatAsBlock());
    }

    @Test
    public void isEmpty_EmptyTagName_ReturnsTrue() {
        Tag tag = new Tag();
        assertEquals(true, tag.isEmpty());
    }

    @Test
    public void isSelfClosing_SelfClosingTag_ReturnsTrue() {
        Tag tag = new Tag();
        assertTrue(tag.isSelfClosing());
    }

    @Test
    public void setSelfClosing_SettingSelfClosing ReturnsFalse() {
        Tag tag = new Tag();
        assertFalse(tag.setSelfClosing());
    }

    @Test
    public void clone_CloneCreatesNewTag() {
        Tag originalTag = new Tag();
        Tag clonedTag = (Tag) originalTag.clone();
        assertNotSame(originalTag, clonedTag);
    }

    @Test
    public void equals_SameTags_ReturnsTrue() {
        Tag tag1 = new Tag();
        Tag tag2 = new Tag();
        assertEquals(tag1, tag2);
    }
}
