import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.Mockito;
import org.mockito.junit.MockitoJUnitRunner;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import javax.xml.parsers.DocumentBuilderFactory;
import javax.xml.transform.TransformerFactory;
import javax.xml.transform.dom.DOMSource;
import javax.xml.transform.stream.StreamResult;

@RunWith(MockitoJUnitRunner.class)
public class W3CDomTest {

    @Mock
    private Document document;

    @Mock
    private Element element;

    public static final String XML = "<html><body>Hello World!</body></html>";

    public static final String HTML = "<html><body>Hello World!</body></html>";

    @Test
    public void convertTest() {
        W3CDom.fromJsoup(document).shouldHaveSameValueAs(document);
    }

    @Test
    public void namespaceAwareTest() {
        boolean result = W3CDom.namespaceAware();
        Mockito.when(element.getNamespaceURI()).thenReturn("http://example.com");
        boolean expectedResult = true;
        Mockito.when(element.getNamespaceURI()).thenReturn(expectedResult);
        org.junit.Assert.assertTrue(result);
    }

    @Test
    public void asStringDocumentTest() {
        String result = W3CDom.asString(document, null);
        Mockito.when(document.getTextContent()).thenReturn(HTML);
        org.junit.Assert.assertEquals(HTML, result);
    }

    @Test
    public void OutputHtmlTest() {
        Map<String, String> properties = new HashMap<>();
        properties.put("method", "html");
        W3CDom.OutputHtml().shouldHaveSameValuesAs(properties);
    }

    @Test
    public void selectXpathDocumentTest() {
        NodeList result = W3CDom.selectXpath("//body", document);
        Mockito.when(document.getTagName()).thenReturn("html");
        Mockito.when(document.getElementsByTagName("body")).thenReturn(new ArrayList<>());
        org.junit.Assert.assertSame(result, null);
    }

    @Test
    public void convertElementTest() {
        Document outDoc = W3CDom.fromJsoup(element).getDocument();
        Mockito.when(outDoc.getDocumentElement()).thenReturn(element);
        org.junit.Assert.assertTrue(outDoc.getDocumentElement().equals(element));
    }

    @Test
    public void sourceNodesNodeListTest() {
        List<Node> result = W3CDom.sourceNodes(new ArrayList<>(), Node.class);
        org.junit.Assert.assertSame(result, new ArrayList<>());
    }

    @Test
    public void contextNodeDocumentTest() {
        Document wDoc = W3CDom.contextNode(document);
        Mockito.when(document.getDocumentElement()).thenReturn(element);
        org.junit.Assert.assertEquals(wDoc.getDocumentElement(), element);
    }
}
