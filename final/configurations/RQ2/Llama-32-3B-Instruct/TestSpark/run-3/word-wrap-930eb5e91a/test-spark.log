        WordWrap.wordWrap(WordWrap.from(new String[]{"Hello", "World"}).writer(), consumer, "\n", 10,
                (s) -> s.length(), new HashSet<>(), false, true);
        assertEquals("He\nlo World\n", consumer.toString());
    }

