        return "";
    }
}

// DirectivesBuilderImpl.java
import javax.annotation.processing.AbstractProcessor;
import javax.annotation.processing.Processor;
import javax.annotation.processing.RoundEnvironment;
import javax.lang.model.element.Element;
import javax.lang.model.element.TypeElement;
import javax.lang.model.type.TypeKind;
import java.util.List;

@Processor("DirectivesBuilder")
public class DirectivesBuilderImpl extends AbstractProcessor {
    private static final String PROCESSOR_NAME = "DirectivesBuilder";

    @Override
    public synchronized void init() {
        super.init();
        supportsElementTypes(DirectiveTypeKind.TYPE, DirectiveTypeKind.FIELD);
    }

    @Override
    public boolean process(Set<? extends TypeElement> annotations, RoundEnvironment roundEnv) {
        List<Element> elements = roundEnv.getElementsAnnotatedWith(DirectivesBuilder.class);
        
        if (elements.isEmpty()) {
            return true;
        }
        
        for (Element element : elements) {
            DirectivesBuilder annotation = element.getAnnotation(DirectivesBuilder.class);
            GraphQLDirectives directives = annotation.value();
            
            if (directives == null || directives.length == 0) {
                throw new RuntimeException("GraphQLDirectives is required");
            }
            
            try {
                // Build the directives
                System.out.println("Processing " + element.toString());
            } catch (Exception e) {
                throw new RuntimeException(e.getMessage(), e);
            }
        }
        
        return true;
    }

    @Override
    public String[] getSupportedAnnotationTypes() {
        return new String[]{DirectivesBuilder.class.getName()};
    }

    @Override
    public boolean hasLocationInfo() {
        return false;
    }
}
