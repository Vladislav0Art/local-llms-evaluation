import javax.tools.StandardJavaFileObjects;
import javax.tools.ToolProvider;

public class DirectiveJavaAnnotationUtil {
    public static void generateDirectives(Class<?> clazz) throws Exception {
        Process process = ToolProvider.getSystemTool("javac").process(
                new JavaFileObjects[] { StandardJavaFileObjects.manifestContent("Manifest-Version: 1.0", "") },
                StandardJavaFileObjects.stringResource(clazz.getName() + ".java", getJavaSourceCode(clazz))
        );
        JavaFileObject output = process.getResult().getOutput();
        System.out.println(output.toString(Diagnostic.Kind.SOURCE, false));
    }

    private static String getJavaSourceCode(Class<?> clazz) {
