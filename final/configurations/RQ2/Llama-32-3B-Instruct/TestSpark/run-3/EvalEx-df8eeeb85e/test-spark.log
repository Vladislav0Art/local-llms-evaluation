    @Test
    public void testParse() {
        String expression = "1 + 2";
        ExpressionConfiguration configuration = ExpressionConfigurationFactory.create(expression);
        Token token = TokenFactory.createLiteral(1, TokenType.NUMBER);
        assertEquals(token, ((Literal) configuration.getTokens().get(0)).toString());
    }

