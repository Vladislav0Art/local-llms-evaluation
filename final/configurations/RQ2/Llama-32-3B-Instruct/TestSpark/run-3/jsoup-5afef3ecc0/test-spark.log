import org.junit.Test;
import static org.junit.Assert.assertEquals;

public class ConnectionKeyValTests {

    @Test
    public void testUrlWithSingleKeyAndValue() {
        String url = "http://example.com?key=value";
        ConnectionKeyVal connectionKeyVal = new ConnectionKeyVal(url);
        assertEquals("value", connectionKeyVal.getKey("key"));
    }

    @Test
    public void testUrlWithMultipleKeysAndValues() {
        String url = "http://example.com?key1=value1&key2=value2";
        ConnectionKeyVal connectionKeyVal = new ConnectionKeyVal(url);
        assertEquals("value1", connectionKeyVal.getKey("key1"));
        assertEquals("value2", connectionKeyVal.getKey("key2"));
    }

    @Test
    public void testUrlWithSingleKeyAndNullValue() {
        String url = "http://example.com?key";
        ConnectionKeyVal connectionKeyVal = new ConnectionKeyVal(url);
        assertEquals(null, connectionKeyVal.getKey("key"));
    }

    @Test
    public void testUrlWithMultipleKeysAndValuesWithFragment() {
        String url = "http://example.com?key1=value1&key2=value2#fragment";
        ConnectionKeyVal connectionKeyVal = new ConnectionKeyVal(url);
        assertEquals("value1", connectionKeyVal.getKey("key1"));
        assertEquals("value2", connectionKeyVal.getKey("key2"));
    }

    @Test
    public void testUrlWithSingleKeyAndEmptyValue() {
        String url = "http://example.com?key";
        ConnectionKeyVal connectionKeyVal = new ConnectionKeyVal(url);
        assertEquals(null, connectionKeyVal.getKey("key"));
    }
}

class ConnectionKeyVal {

    private String url;

    public ConnectionKeyVal(String url) {
        this.url = url;
    }

    public String getKey(String key) {
        return url.substring(url.indexOf(key + "="));
    }

    @Override
    public String toString() {
        return url;
    }
}
