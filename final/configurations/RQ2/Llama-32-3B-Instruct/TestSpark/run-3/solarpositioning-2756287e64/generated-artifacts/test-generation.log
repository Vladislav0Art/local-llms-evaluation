public class Grena3 {

    public static AzimuthZenithAngle calculateSolarPosition(ZonedDateTime date, double latitude, double longitude, double deltaT) {
        return MockGrena3.calculateSolarPosition(date, latitude, longitude, deltaT);
    }

    public static void main(String[] args) {}

    public class AzimuthZenithAngle implements Comparable<AzimuthZenithAngle> {
        private double azimuth;
        private double zenith;

        public AzimuthZenithAngle(double azimuth, double zenith) {
            this.azimuth = azimuth;
            this.zenith = zenith;
        }

        @Override
        public int compareTo(AzimuthZenithAngle other) {
            return Double.compare(this.azimuth, other.azimuth);
        }
    }
}

