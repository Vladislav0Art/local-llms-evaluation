public class CssFormatter {
    private Map<String, String> options;
    private ConfigurationSource cfg;

    public void init(Map<String, String> options, ConfigurationSource cfg) {
        this.options = options;
        this.cfg = cfg;
    }

    public String doFormat(String css, LineEnding ending) throws IOException {
        String formattedCss = "";
        for (String line : css.split("\n")) {
            if (options.containsKey("line_ending") && options.get("line_ending").equals("both")) {
                formattedCss += line + ending.getSymbol();
            } else {
                formattedCss += line;
            }
        }
        return formattedCss;
    }

    public boolean isInitialized() {
        return true;
    }
}

public class LineEnding {
    public static enum Type { CR, LF };

    private Type type;

    public LineEnding(Type type) {
        this.type = type;
    }

    public String getSymbol() {
        switch (type) {
            case CR:
                return "\r";
            case LF:
                return System.lineSeparator();
            default:
                throw new UnsupportedOperationException("Unsupported line ending");
        }
    }
}

public class ConfigurationSource {
    private Map<String, String> properties = new HashMap<>();

    public void addProperty(String key, String value) {
        properties.put(key, value);
    }

    public String getProperty(String key) {
        return properties.get(key);
    }
}
