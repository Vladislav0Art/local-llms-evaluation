import org.jsoup.Connection;
import org.jsoup.HttpStatusException;
import org.jsoup.UncheckedIOException;
import org.jsoup.UnsupportedMimeTypeException;
import org.jsoup.helper.HttpConnection;
import org.junit.Before;
import org.junit.Test;
import static org.junit.Assert.*;
import java.util.HashMap;
import java.util.Map;

public class HttpConnectionTest {

    @Before
    public void setup() {
        Connection.connect("http://example.com");
    }

    public static class TestConnection extends Connection {
        private Method method;
        private Map<String, String> cookies;
        private CookieStore cookieStore;
        private Proxy proxy;

        public TestConnection(Method method) {
            this.method = method;
        }
    }

    @Test
    public void url_String_url_connects() {
        HttpConnection connect = new HttpConnection();
        Connection url = connect.url("http://example.com");
        assertEquals(HEAD, url.request().method());
        assertFalse(url.ignoreHttpErrors());
    }

    @Test
    public void url_URL_connects() {
        HttpConnection connect = new HttpConnection();
        URL url = new URL("http://example.com");
        Connection url2 = connect.url(url);
        assertEquals(HEAD, url2.request().method());
        assertFalse(url2.ignoreHttpErrors());
    }

    @Test
    public void proxy_ProxyConnects() {
        HttpConnection connect = new HttpConnection();
        Proxy proxy = new Proxy(Proxy.Type.HTTP, new InetSocketAddress("localhost", 8080));
        Connection url = connect.proxy(proxy);
        assertEquals(HEAD, url.request().method());
        assertFalse(url.ignoreHttpErrors());
    }

    @Test
    public void proxy_String_host_connects() {
        HttpConnection connect = new HttpConnection();
        String host = "localhost";
        int port = 8080;
        Connection url = connect.proxy(host, port);
        assertEquals(HEAD, url.request().method());
        assertFalse(url.ignoreHttpErrors());
    }

    @Test
    public void userAgent_String_userAgent_sets() {
        HttpConnection connect = new HttpConnection();
        String userAgent = "Mozilla/5.0";
        Connection url = connect.userAgent(userAgent);
        assertEquals("Mozilla/5.0", url.request().headers("User-Agent"));
    }

    @Test
    public void timeout_Int_timeout_set() {
        HttpConnection connect = new HttpConnection();
        int millis = 1000;
        Connection url = connect.timeout(millis);
        assertEquals(HEAD, url.request().method());
        assertTrue(url.ignoreHttpErrors());
    }

    @Test
    public void followRedirects_Bolean_followRedirects_sets() {
        HttpConnection connect = new HttpConnection();
        boolean followRedirects = true;
        Connection url = connect.followRedirects(followRedirects);
        assertEquals(HEAD, url.request().method());
        assertTrue(url.ignoreHttpErrors());
    }

    @Test
    public void referrer_String_referrer_sets() {
        HttpConnection connect = new HttpConnection();
        String referrer = "https://www.example.com";
        Connection url = connect.referrer(referrer);
        assertEquals(HEAD, url.request().method());
        assertTrue(url.ignoreHttpErrors());
    }

    @Test
    public void data_String_key_sets() {
        HttpConnection connect = new HttpConnection();
        String key = "key";
        String value = "value";
        Connection url = connect.data(key, value);
        assertEquals(HEAD, url.request().method());
        assertTrue(url.ignoreHttpErrors());
    }

    @Test
    public void sslSocketFactory_SSLSocketFactory_sets() {
        HttpConnection connect = new HttpConnection();
        SSLSocketFactory sslSocketFactory = mock(SSLSocketFactory.class);
        Connection url = connect.sslSocketFactory(sslSocketFactory);
        assertEquals(HEAD, url.request().method());
        assertTrue(url.ignoreHttpErrors());
    }

    @Test
    public void postRequestBody_String_body_sets() {
        HttpConnection connect = new HttpConnection();
        String body = "Hello World";
        Connection url = connect.postRequestBody(body);
        assertEquals(POST, url.request().method());
        assertTrue(url.ignoreHttpErrors());
    }

    @Test
    public void headers_Maps_headers_sets() {
        HttpConnection connect = new HttpConnection();
        Map<String, String> headers = new HashMap<>();
        headers.put("Content-Type", "application/json");
        Connection url = connect.headers(headers);
        assertEquals(POST, url.request().method());
        assertTrue(url.ignoreHttpErrors());
    }

    @Test
    public void postDataCharset_String_charset_sets() {
        HttpConnection connect = new HttpConnection();
        String charset = "UTF-8";
        Connection url = connect.postDataCharset(charset);
        assertEquals(POST, url.request().method());
        assertTrue(url.ignoreHttpErrors());
    }
}
