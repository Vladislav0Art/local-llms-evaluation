    public void propertiesFromMapTest_returnsCorrectProperties() {
        Map<String, String> map = new HashMap<>();
        map.put("key1", "value1");
        Properties properties = W3CDom.propertiesFromMap(map);
        assertEquals(1, properties.size());
    }

