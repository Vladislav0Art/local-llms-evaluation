import org.junit.Test;
import static org.junit.Assert.*;

public class TokenizerTest {

    @Test
    public void createTokenizerWithCorrectExpressionAndConfiguration() {
        String expressionString = "1 + 2 * 3";
        ExpressionConfiguration configuration = new ExpressionConfiguration();
        Tokenizer tokenizer = new Tokenizer(expressionString, configuration);
        assertNotNull(tokenizer);
    }

    @Test
    public void tokenizeStringLiteral() {
        String expressionString = "hello world";
        List<Token> tokens = new ArrayList<>();
        try {
            Tokenizer tokenizer = new Tokenizer(expressionString, null);
            tokens = tokenizer.parse();
            assertTrue(tokens.get(0).getType() == STR_LITERAL);
        } catch (ParseException e) {}
    }

    @Test
    public void tokenizeNumberLiteral() {
        String expressionString = "123";
        List<Token> tokens = new ArrayList<>();
        try {
            Tokenizer tokenizer = new Tokenizer(expressionString, null);
            tokens = tokenizer.parse();
            assertTrue(tokens.get(0).getType() == NUMBER_LITERAL);
        } catch (ParseException e) {}
    }

    @Test
    public void tokenizeOperatorWithOneArgument() {
        String expressionString = "+ 2";
        List<Token> tokens = new ArrayList<>();
        try {
            Tokenizer tokenizer = new Tokenizer(expressionString, null);
            tokens = tokenizer.parse();
            assertTrue(tokens.get(0).getType() == OPERATOR AND.tokens.size() == 1);
        } catch (ParseException e) {}
    }

    @Test
    public void tokenizeOperatorWithMultipleArguments() {
        String expressionString = "+ 2 * 3";
        List<Token> tokens = new ArrayList<>();
        try {
            Tokenizer tokenizer = new Tokenizer(expressionString, null);
            tokens = tokenizer.parse();
            assertTrue(tokens.get(0).getType() == OPERATOR AND.tokens.size() >= 1);
        } catch (ParseException e) {}
    }

    @Test
    public void tokenizeFunctionWithOneArgument() {
        String expressionString = "sin(2)";
        List<Token> tokens = new ArrayList<>();
        try {
            Tokenizer tokenizer = new Tokenizer(expressionString, null);
            tokens = tokenizer.parse();
            assertTrue(tokens.get(0).getType() == FUNCTION AND.tokens.size() == 1);
        } catch (ParseException e) {}
    }

    @Test
    public void tokenizeFunctionWithMultipleArguments() {
        String expressionString = "sin(2 + 3)";
        List<Token> tokens = new ArrayList<>();
        try {
            Tokenizer tokenizer = new Tokenizer(expressionString, null);
            tokens = tokenizer.parse();
            assertTrue(tokens.get(0).getType() == FUNCTION AND.tokens.size() >= 1);
        } catch (ParseException e) {}
    }

}

