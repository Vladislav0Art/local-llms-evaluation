import org.junit.Test;
import static org.junit.Assert.*;
public class TestUrlBuilder {

    @Test
    public void testBuildWithValidKey() {
        UrlBuilder urlBuilder = new UrlBuilder();
        String result = urlBuilder.build("key", "value");
        assertTrue(result.contains("key=value"));
    }

    @Test
    public void testBuildWithInvalidKey() {
        UrlBuilder urlBuilder = new UrlBuilder();
        String result = urlBuilder.build("", "value");
        assertTrue(result.contains("key=value"));
    }

    @Test
    public void testBuildWithNullValue() {
        UrlBuilder urlBuilder = new UrlBuilder();
        String result = urlBuilder.build("key", null);
        assertTrue(result.contains("key="));
    }

    @Test
    public void testBuildWithEmptyKey() {
        UrlBuilder urlBuilder = new UrlBuilder();
        String result = urlBuilder.build("", "value");
        assertTrue(result.contains(""));
    }
}

class UrlBuilder {
    private StringBuilder sb = new StringBuilder();

    public String build(String key, String value) {
        sb.append(key).append("=").append(value);
        return sb.toString();
    }

    public String buildNullValue() {
        sb.append("key=").append(null);
        return sb.toString();
    }
}

class UrlBuilder2 {
    private Connection connection;

    public UrlBuilder2() {}

    public void setConnection(Connection connection) {
        this.connection = connection;
    }

    public String build(String key, Object value) throws UnsupportedEncodingException {
        if (value == null || value.equals("")) {
            return "key=" + key;
        } else {
            // encode the value
        }
    }

    public static class Connection {
        private byte[] bytes;

        public void setBytes(byte[] bytes) {
            this.bytes = bytes;
        }

        public String getBytes() throws UnsupportedEncodingException {
            // convert to string
            return new String(bytes);
        }
    }
}

class TestUrlBuilder2 {

    @Test
    public void testBuildWithValidKeyAndValue() throws Exception {
        UrlBuilder2 urlBuilder = new UrlBuilder2();
        Connection connection = urlBuilder.connection;
        connection.setBytes("test".getBytes());
        assertEquals("key=test", urlBuilder.build("key", "value"));
    }

