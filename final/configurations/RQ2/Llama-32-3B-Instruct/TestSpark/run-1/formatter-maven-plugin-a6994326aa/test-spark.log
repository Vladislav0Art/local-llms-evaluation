    @Mock
    private ConfigurationSource cfg;

    public void setup() {
        when(cfg.toString()).thenReturn("{}");
        when(cfg.getConfig()).thenReturn(new java.util.HashMap<>());
    }

    @Test
    public void init_ScenarioTest() throws IOException {
        setup();
        CssFormatter formatter = new CssFormatter(cfg);
        String code = "cssCode";
        formatter.init(Map.of("option1", "value1"), cfg);
        assertNotNull(formatter);
    }

    @Test
    public void doFormat_NothingSelected_ScenarioTest() throws IOException {
        setup();
        CssFormatter formatter = new CssFormatter(cfg);
        String code = "";
        String expected = "";
        when(cfg.getConfig()).thenReturn(java.util.Collections.singletonMap("output", "expected"));
        assertEquals(expected, formatter.doFormat(code, LineEnding.LF));
    }

    @Test
    public void doFormat_SomethingSelected_ScenarioTest() throws IOException {
        setup();
        CssFormatter formatter = new CssFormatter(cfg);
        String code = "cssCode";
        String expected = "formattedCssCode";
        when(cfg.getConfig()).thenReturn(java.util.Collections.singletonMap("output", expected));
        assertEquals(expected, formatter.doFormat(code, LineEnding.LF));
    }

    @Test
    public void doFormat_SACParserCSS3_ScenarioTest() throws IOException {
        setup();
        CssFormatter formatter = new CssFormatter(cfg);
        String code = "cssCode";
        CSSOMParser parser = Mockito.mock(CSSOMParser.class);
        when(parser.getSyntax()).thenReturn(new SACParserCSS3());
        formatter.doFormat(code, LineEnding.LF);
    }

    @Test
    public void isInitialized_ScenarioTest() {
        setup();
        CssFormatter formatter = new CssFormatter(cfg);
        assertTrue(formatter.isInitialized());
    }
}
