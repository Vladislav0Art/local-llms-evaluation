        return name;
    }
}

public class ParseTest {

    @Test
    public void testCloned() {
        // Arrange
        String cloned = "div";
        Tag expectedTag = new Tag("div");
        Parse settings = Parse.getInstance();

        // Act
        assertEquals(expectedTag, settings.cloned(cloned));
