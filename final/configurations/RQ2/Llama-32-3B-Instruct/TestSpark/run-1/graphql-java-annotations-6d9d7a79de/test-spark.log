```java
import com.graphql.java.GraphQLSchema;
import com.graphql.java.SchemaDirective;

public class SchemaBuilder {

    public GraphQLSchema build() {
        GraphQLSchema.Builder builder = new GraphQLSchema.Builder();

        // Define the Query type with the AuthenticationDirective
        builder.type(new QueryType());

        // Add the VerifyUserDirective to the schema
        builder.addDirective(VerifyUserDirective.class);

        // Add the AuthenticationDirective to the schema
        builder.addDirective(AuthenticationDirective.class);

        return builder.build();
    }
}

public class QueryType {
    
    public Object execute(QueryExecutor executor, GraphQLContext context) throws Exception {
        
        String token = (String) executorArgument(context, "token");
        
        if (!token.equals("valid_token")) {
            throw new Exception("Invalid token");
        }

        // Process the user data here...
        return "User data";
    }
}

public class QueryExecutor {
    
    public ObjectArgument executeArgument(GraphQLContext context, String argumentName) throws Exception {
        // Get the value of the argument from the context
        Object value = context.getArgument(argumentName);
        
        return (ObjectArgument) new ObjectArgument(value);
    }
}
```

```java
import com.graphql.java.GraphQLSchema;
import com.graphql.java.SchemaDirective;

public class GraphQLSchema implements GraphQLSchema {

    public static final String VERIFY_USER = "verifyUser";
    
    @Override
    public SchemaDirective[] getDirectives() {
        return new SchemaDirective[]{VerifyUserDirective.class};
    }
}

public class QueryType implements GraphQLObject {
    
    public Object execute(GraphQLContext context) throws Exception {
        
        // Process the user data here...
        return "User data";
    }

    @Override
    public GraphQLType getTypes() {
        // Define the types for this type
        return new GraphQLString("string");
    }
}
```

In this example, we have two custom directives: `VerifyUserDirective` and `AuthenticationDirective`. We define these directives in our schema using the `addDirective()` method. The `QueryType` class is annotated with the `@VerifyUser` directive, which means it will be processed by the `VerifyUserDirective` when executed.

When we execute a query on this schema, the `VerifyUserDirective` will validate the `token` argument and throw an exception if it's invalid.
