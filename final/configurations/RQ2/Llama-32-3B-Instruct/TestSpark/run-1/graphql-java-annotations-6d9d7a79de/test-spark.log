```java
import com.graphql.java.GraphQLDirective;
import com.graphql.java.GraphQLDirectiveArguments;

public class VerifyUserDirective implements GraphQLDirective {

    @Override
    public String getArgumentType() {
        return "String";
    }

    @Override
    public boolean isValidArgument(String argumentName) {
        return true; // This is a custom directive, so we always consider it valid
    }
}
