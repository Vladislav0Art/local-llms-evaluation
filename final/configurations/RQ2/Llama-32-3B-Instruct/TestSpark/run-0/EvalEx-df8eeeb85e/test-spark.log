import java.util.ArrayList;
import java.util.List;

public class Tokenizer {
    public static List<Token> tokenize(String expression) {
        List<Token> tokens = new ArrayList<>();
        boolean isDigit = false;
        StringBuilder currentNumber = new StringBuilder();

        for (char c : expression.toCharArray()) {

            if (Character.isDigit(c)) {
                isDigit = true;
                currentNumber.append(c);
            } else if (isDigit && (c == '+' || c == '-' || c == '*' || c == '/')) {
                tokens.add(new Token(TokenType.TYPE_NUMBER, Integer.parseInt(currentNumber.toString())));
                currentNumber.setLength(0);
                tokens.add(new Token(TokenType.TYPE_OPERATOR, String.valueOf(c)));
                isDigit = false;
            } else if (!Character.isDigit(c) && !isDigit) {
                // Handle operator as standalone token
                if (c == '+') {
                    tokens.add(new Token(TokenType.TYPE_PLUS, "+"));
                } else if (c == '-') {
                    tokens.add(new Token(TokenType.TYPE_MINUS, "-"));
                } else if (c == '*') {
                    tokens.add(new Token(TokenType.TYPE_STAR, "*"));
                } else if (c == '/') {
                    tokens.add(new Token(TokenType.TYPE_DIVIDE, "/"));
                }
            }

        }

        if (currentNumber.length() > 0) {
            tokens.add(new Token(TokenType.TYPE_NUMBER, Integer.parseInt(currentNumber.toString())));
        }

        return tokens;
    }

    public static class Token {
        private TokenType type;
        private Object value;

        public Token(TokenType type, Object value) {
            this.type = type;
            this.value = value;
        }

        @Override
        public String toString() {
            if (value instanceof Integer) {
                return "(" + type + ", " + value + ")";
            } else {
                return "(" + type + ", \"" + value.toString() + "\")";
            }
        }
    }

    public static enum TokenType {
        TYPE_NUMBER,
        TYPE_PLUS,
        TYPE_MINUS,
        TYPE_STAR,
        TYPE_DIVIDE
    }

    public static class ExpressionConfiguration {
        // This class can be implemented according to the requirements
    }

    public static void main(String[] args) {
        List<Token> tokens = tokenize("1+2*3");
        for (Token token : tokens) {
            System.out.println(token);
        }
    }
}
