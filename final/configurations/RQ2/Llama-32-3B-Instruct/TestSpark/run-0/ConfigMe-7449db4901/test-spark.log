import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;

public class CommentTest {

    @Test
    public void testCommentCreation() {
        public class CommentClass {
            private String comment;

            public CommentClass(String comment) {
                this.comment = comment;
            }

            public String getComment() {
                return comment;
            }
        }

        CommentClass comment = new CommentClass("testComment");
        System.out.println(comment.getComment());
    }

    @Test
    public void testConfigCreation() {
        public class ConfigClass {
            private String newPath;
            private String newComment;

            public ConfigClass(String newPath, String newComment) {
                this.newPath = newPath;
                this.newComment = newComment;
            }

            public String getNewPath() {
                return newPath;
            }

            public String getNewComment() {
                return newComment;
            }
        }

        ConfigClass config = new ConfigClass("newPath", "newComment");
        System.out.println(config.getNewPath());
        System.out.println(config.getNewComment());
    }

    @Test
    public void testCommentsInConfiguration() {
        public class CommentClass {
            private String comment;

            public CommentClass(String comment) {
                this.comment = comment;
            }

            public String getComment() {
                return comment;
            }
        }

        public class ConfigClass {
            private Map<String, List<String>> comments;

            public ConfigClass(Map<String, List<String>> comments) {
                this.comments = comments;
            }

            public void setComment(String key, String value) {
                if (comments == null) {
                    comments = new HashMap<>();
                }
                comments.put(key, Arrays.asList(value));
            }

            public Map<String, List<String>> getComments() {
                return comments;
            }
        }

        Map<String, List<String>> comments = new HashMap<>();
        comments.put("newPath", Arrays.asList("comment"));
        comments.put("path", Arrays.asList("comment"));

        ConfigClass config = new ConfigClass(comments);
        assertEquals(2, config.getComments().size());
    }
}
