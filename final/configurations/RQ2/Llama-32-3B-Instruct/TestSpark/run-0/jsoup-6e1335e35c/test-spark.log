public String generateOuterHtml() {
    StringBuilder html = new StringBuilder();
    for (HtmlElement element : elements) {
        html.append("<").append(element.getTagName()).append(">");
        if (element.getContent().contains("<")) {
            html.append("<script>alert('XSS')</script>").replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;");
        } else {
            html.append(element.getContent());
        }
        html.append("</").append(element.getTagName()).append(">");
    }
    return html.toString();
}
```

