import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.select.Elements;

public class JsoupTest {

    public static void main(String[] args) {
        String html = "<html><body><div><?xml version=\"1.0\"?><!-- This is a comment -->\n<div>Inner div</div></div></body></html>";

        // Create a Document object from the HTML string
        Document doc = Jsoup.parse(html);

        // Get all elements with the class "header"
        Elements headerElements = doc.getElementsByClass("header");
        System.out.println("Number of header elements: " + headerElements.size());

        // Iterate over each element and print its text content
        for (Element element : headerElements) {
            String text = element.text();
            if (!text.isEmpty()) {
                System.out.println(text);
            }
        }

        // Get all links in the HTML document
        Elements links = doc.select("a");
        System.out.println("Number of links: " + links.size());
        
        for (Element link : links) {
            String url = link.attr("href");
            if (!url.isEmpty()) {
                System.out.println(url);
            }
        }

        // Get all comments in the HTML document
        Elements comments = doc.select("comment");
        System.out.println("Number of comments: " + comments.size());
        
        for (Element comment : comments) {
            String text = comment.text();
            if (!text.isEmpty()) {
                System.out.println(text);
            }
        }

        // Get all paragraphs in the HTML document
        Elements paragraphs = doc.select("p");
        System.out.println("Number of paragraphs: " + paragraphs.size());
        
        for (Element paragraph : paragraphs) {
            String text = paragraph.text();
            if (!text.isEmpty()) {
                System.out.println(text);
            }
        }

        // Get all images in the HTML document
        Elements images = doc.select("img");
        System.out.println("Number of images: " + images.size());
        
        for (Element image : images) {
            String src = image.attr("src");
            if (!src.isEmpty()) {
                System.out.println(src);
            }
        }

    }
}
