```java
import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;

public class JsoupTest {

    public static void main(String[] args) {
        String html = "<html><body><div><?xml version=\"1.0\"?><!-- This is a comment -->\n<div>Inner div</div></div></body></html>";

        // Test for Document
        public static boolean testDocument() {
            return true;
        }
        
        System.out.println(testDocument());
        
        // Test for Element
        public static boolean testElement(String text) {
            if (text.contains("Inner div")) {
                return true;
            } else {
                return false;
            }
        }
        
        Document doc = Jsoup.parse(html);
        System.out.println(doc.selectFirst("div").html());
        
        // Test for Comment
        public static boolean testComment(String text) {
            if (text.contains("<!-- This is a comment -->")) {
                return true;
            } else {
                return false;
            }
        }
        
        Element element = doc.selectFirst("div");
        System.out.println(testComment(element.html()));
    }
}
```

In this example, the `testElement` method checks if the text of the first `<div>` element in the parsed HTML contains "Inner div". The `testComment` method checks if the text of the first `<div>` element contains a comment (`<!-- This is a comment -->`).
