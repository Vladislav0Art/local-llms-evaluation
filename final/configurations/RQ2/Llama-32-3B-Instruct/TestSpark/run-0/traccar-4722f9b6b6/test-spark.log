package org.traccar.protocol;

import org.junit.Test;
import static org.junit.Assert.*;
import java.nio.charset.StandardCharsets;
import java.util.Date;

public class WatchProtocolDecoderTest {

    @Test
    public void decode_WatchProtocolValidMessage_ReturnsCorrectData() throws Exception {
        // Arrange
        WatchProtocolDecoder decoder = new WatchProtocolDecoder(Protocol.WATCH);

        // Act
        Object result = decoder.decode(null, null, null);
        
        // Assert
        assertNull(result);
    }

    @Test
    public void decode_WatchProtocolInvalidMessage_ThrowsException() throws Exception {
        // Arrange
        WatchProtocolDecoder decoder = new WatchProtocolDecoder(Protocol.WATCH);

        // Act and Assert
        assertThrows(Exception.class, () -> decoder.decode(null, null, null));
    }

    @Test
    public void decode_WatchProtocolIndexHasValue_ReturnsCorrectData() throws Exception {
        // Arrange
        WatchProtocolDecoder decoder = new WatchProtocolDecoder(Protocol.WATCH);
        byte[] data = ByteBufUtil.createBuffer(10, StandardCharsets.UTF_8);

        // Set values in data
        data.writeBytes("1234".getBytes(StandardCharsets.UTF_8));

        // Act
        Object result = decoder.decode(null, null, data);

        // Assert
        assertNotNull(result);
    }

    @Test
    public void getHasIndex_WatchProtocolHasIndex_ReturnsTrue() throws Exception {
        // Arrange
        WatchProtocolDecoder decoder = new WatchProtocolDecoder(Protocol.WATCH);

        // Act and Assert
        assertTrue(decoder.getHasIndex());
    }

    @Test
    public void getHasIndex_WatchProtocolNoIndex_ReturnsFalse() throws Exception {
        // Arrange
        WatchProtocolDecoder decoder = new WatchProtocolDecoder(Protocol.NO_INDEX);

        // Act and Assert
        assertFalse(decoder.getHasIndex());
    }

    @Test
    public void getManufacturer_WatchProtocolManufacturer_ReturnsCorrectData() throws Exception {
        // Arrange
        WatchProtocolDecoder decoder = new WatchProtocolDecoder(Protocol.WATCH);

        // Act and Assert
        assertEquals("Watch", decoder.getManufacturer());
    }

    @Test
    public void getManufacturer_WatchProtocolNoManufacturer_ReturnsEmptyString() throws Exception {
        // Arrange
        WatchProtocolDecoder decoder = new WatchProtocolDecoder(Protocol.NO_MANUFACTURER);

        // Act and Assert
        assertEquals("", decoder.getManufacturer());
    }
}
