    private String inputUrl;

    public UrlBuilder(String inputUrl) {
        this.inputUrl = inputUrl;
    }

    public void appendKeyVal(String key, String value) {
        if (inputUrl.contains("?")) {
            inputUrl += "&" + key + "=" + value;
        } else {
            inputUrl += "?" + key + "=" + value;
        }
