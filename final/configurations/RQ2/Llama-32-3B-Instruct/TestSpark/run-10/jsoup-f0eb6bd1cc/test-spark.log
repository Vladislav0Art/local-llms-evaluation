import org.jsoup.nodes.Document;

public class UrlBuilder {
    private String url;
    public StringBuilder keyValue = new StringBuilder();

    public UrlBuilder(String url) {
        this.url = url;
    }

    public void addKeyValue(String entry) {
        if (keyValue.length() >= 10000) {
            System.out.println("Too many key-value pairs, cannot continue.");
            return;
        }
        String[] keyValueArray = entry.split("=");
        if (keyValueArray.length != 2) {
            System.out.println("Invalid key-value pair: " + entry);
            return;
        }
        keyValue.append(keyValueArray[0]);
        keyValue.append("=");
        keyValue.append(keyValueArray[1]);
    }

    public void printUrl() {
        Document doc = Jsoup.parse(url);
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < keyValue.length(); i += 2) {
            sb.append(doc.getElementById("kv").attr("value"));
            if (i != keyValue.length() - 1) {
                sb.append("&");
            }
        }
        System.out.println(sb.toString());
    }

    public static class TestUrlBuilder {

        @org.junit.Test
        public void testUrlBuilder() {
            UrlBuilder urlBuilder = new UrlBuilder("https://www.example.com?key1=value1&key2=value2");
            urlBuilder.addKeyValue("key3=value3&key4=value4");
            urlBuilder.printUrl();
        }

        @org.junit.Test
        public void testUrlBuilderTooManyKeyValues() {
            UrlBuilder urlBuilder = new UrlBuilder("https://www.example.com?key1=value1&key2=value2");
            for (int i = 0; i < 10000; i++) {
                urlBuilder.addKeyValue(String.valueOf(i) + "=" + String.valueOf(i));
            }
            urlBuilder.printUrl();
        }

        @org.junit.Test
        public void testUrlBuilderInvalidKeyValue() {
            UrlBuilder urlBuilder = new UrlBuilder("https://www.example.com");
            try {
                urlBuilder.addKeyValue("key=value"); // should throw exception
            } catch (Exception e) {
                System.out.println(e.getMessage());
            }
        }

        @org.junit.Test
        public void testUrlBuilderConstructor() {
            UrlBuilder urlBuilder = new UrlBuilder("https://www.example.com");
            assert urlBuilder.url.equals("https://www.example.com");
            assert urlBuilder.keyValue.length() == 0;
        }
    }
}
