import java.util.Arrays;
import java.util.Collections;
import java.util.Iterator;
import java.util.List;
import java.util.Map;
import java.util.Set;

public class AttributesTest {

    public static void testGetKeyDoesNotExist() {
        Attributes attributes = new Attributes();
        Assert.assertFalse(attributes.containsKey("non-existent-key"));
    }

    public static void testGetUserValues() {
        Attributes attributes = new Attributes();
        Object value = "value";
        attributes.put("key", value);
        Assert.assertEquals(value, attributes.getUserData("key"));
    }

    public static void testHasKey() {
        Attributes attributes = new Attributes();
        attributes.put("key", "value");
        Assert.assertTrue(attributes.hasKey("key"));
    }

    public static void testAdd() {
        Attributes attributes = new Attributes();
        String key = "key";
        String value = "value";
        attributes.add(key, value);
        Assert.assertEquals(value, attributes.get(key));
    }

    public static void testPut() {
        Attributes attributes = new Attributes();
        String key = "key";
        boolean value = true;
        attributes.put(key, value);
        Assert.assertTrue(attributes.hasKey(key));
    }

    public static void testRemoveKey() {
        Attributes attributes = new Attributes();
        attributes.add("key", "value");
        attributes.remove("key");
        Assert.assertFalse(attributes.hasKey("key"));
    }

    public static void testIsEmpty() {
        Attributes attributes = new Attributes();
        Assert.assertTrue(attributes.isEmpty());
    }

    public static void testAsList() {
        Attributes attributes = new Attributes();
        Attribute attribute1 = new Attribute("attribute1", "value1");
        Attribute attribute2 = new Attribute("attribute2", "value2");
        List<Attribute> list = attributes.asList();
        Assert.assertEquals(2, list.size());
    }

    public static void testDataset() {
        Attributes attributes = new Attributes();
        Map<String, String> map = attributes.dataset();
        Assert.assertEquals(0, map.size());
    }

    public static void testGet() {
        Attributes attributes = new Attributes();
        attributes.put("key", "value");
        Assert.assertEquals("value", attributes.get("key"));
    }

    public static void testGetIgnoreCase() {
        Attributes attributes = new Attributes();
        attributes.put("KEY", "Value");
        Assert.assertEquals("Value", attributes.getIgnoreCase("key"));
    }

    public static void testNormalize() {
        Attributes attributes = new Attributes();
        attributes.add("key", "value");
        attributes.normalize();
        // no-op
    }

    public static void testDeduplicate() {
        ParseSettings settings = new ParseSettings();
        Attributes attributes = new Attributes();
        List<Attribute> list = Arrays.asList(
                new Attribute("attribute1", "value1"),
                new Attribute("attribute2", "value2")
        );
        int deduplicatedValue = attributes.deduplicate(settings);
        Assert.assertEquals(1, deduplicatedValue);
    }

    public static void testClone() {
        Attributes originalAttributes = new Attributes();
        Attributes clonedAttributes = originalAttributes.clone();
        Assert.assertNotEquals(originalAttributes, clonedAttributes);
    }
}
