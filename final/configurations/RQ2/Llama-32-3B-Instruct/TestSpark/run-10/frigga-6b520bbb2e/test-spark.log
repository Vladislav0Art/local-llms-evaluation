    public void getBuildJobNameTest() {
        AppVersion appVersion = new AppVersion("1.9.2", "build-1.9.2", "commit-1");
        assertEquals("build-1.9.2", appVersion.getBuildJobName());
    }

    @Test
    public void getBuildNumberTest() {
        AppVersion appVersion = new AppVersion("1.9.2", "build-1.9.2", "commit-1");
        assertEquals("1.9.2", appVersion.getBuildNumber());
    }

    @Test
    public void getCommitTest() {
        AppVersion appVersion = new AppVersion("1.9.2", "build-1.9.2", "commit-1");
        assertEquals("commit-1", appVersion.getCommit());
    }

    @Test
    public void getChangelistTest() {
        @Deprecated
        String changelist = AppVersion.getChangelist();
        assertNull(changelist);
    }

