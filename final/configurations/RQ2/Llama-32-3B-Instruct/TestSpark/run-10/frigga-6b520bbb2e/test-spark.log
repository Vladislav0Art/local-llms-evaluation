    @Test
    public void parseNameValidAmeiNameTest() {
        AppVersion appVersion = AppVersion.parseName("1.9.2-amazon-linux-ufi");
        assertNotNull(appVersion);
        assertTrue(appVersion.getBuildJobName().equals("build-1.9.2"));
        assertTrue(appVersion.getVersion().equals("1.9.2"));
    }

    @Test
    public void parseNameInvalidAmeiNameTest() {
        AppVersion appVersion = AppVersion.parseName("Invalid");
        assertNotNull(appVersion);
        assertEquals("", appVersion.getBuildJobName());
        assertEquals("", appVersion.getVersion());
    }

    @Test
    public void compareToSameAppVersionTest() {
