        AppVersion appVersion2 = new AppVersion("1.9.2", "build-1.9.2", "commit-1");

        assertEquals(0, appVersion1.compareTo(appVersion2));
    }

    @Test
    public void compareToDifferentAppVersionTest() {
        AppVersion appVersion1 = new AppVersion("1.9.2", "build-1.9.2", "commit-1");
        AppVersion appVersion2 = new AppVersion("1.8.2", "build-1.8.2", "commit-1");

        assertTrue(appVersion1.compareTo(appVersion2) > 0);
    }

    @Test
    public void getAppVersionPatternTest() {
        Pattern pattern = AppVersion.getAppVersionPattern();
        assertNotNull(pattern);
        assertFalse(pattern.matcher("1234").matches());
    }

    @Test
    public void getPackageNameTest() {
        AppVersion appVersion = new AppVersion("1.9.2", "build-1.9.2", "commit-1");
        assertEquals(NameConstants.APP_VERSION, appVersion.getPackageName());
    }

