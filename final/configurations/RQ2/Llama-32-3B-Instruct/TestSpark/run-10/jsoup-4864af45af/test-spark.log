        // Test 4: Preserve relative links
        safelist.preserveRelativeLinks(true);
        assertTrue(safelist.isSafeAttribute("script", null, "type"));
    }

    public void addTags(String... tags) {
        this.tags.addAll(Arrays.asList(tags));
    }

    public boolean isSafeAttribute(String element, String attributeName) {
        if (!tags.contains(element)) {
            return false;
        }
        if (attributes.containsKey(element)) {
            for (String attr : attributes.get(element)) {
                if (attr.equals(attributeName)) {
                    return true;
                }
            }
        }
        return false;
    }

    public void removeEnforcedAttribute(String element, String attributeName) {
        if (!tags.contains(element)) {
