        }
        attributes.remove(element, new String[]{attributeName});
    }

    public void addProtocols(String element, String attribute, String protocol) {
        if (!tags.contains(element)) {
            throw new RuntimeException();
        }
        attributes.computeIfAbsent(element, k -> new String[0]).add(protocol);
    }

    public void removeProtocols(String element, String attribute, String protocol) {
        if (!tags.contains(element)) {
            throw new RuntimeException();
        }
        for (String attr : attributes.get(element)) {
            if (attr.equals(protocol)) {
                String[] newAttrArray = java.util.Arrays.copyOf(attributes.get(element), attributes.get(element).length - 1);
                attributes.put(element, newAttrArray);
                break;
            }
        }
    }

    public void preserveRelativeLinks(boolean preserve) {
        // Implement logic to preserve or discard relative links
    }
}
