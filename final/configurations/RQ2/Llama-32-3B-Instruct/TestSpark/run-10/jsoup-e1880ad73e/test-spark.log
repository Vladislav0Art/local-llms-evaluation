    @Test
    public void testUrlBuilderConstruct() {
        // Arrange
        Connection connection = new Connection();

        // Act
        new UrlBuilder(connection);

        // Assert
        // No specific assertion, just verifying no exception is thrown
    }

    @Test
    public void testBuildUrl() throws MalformedURLException, URISyntaxException {
        // Arrange
        URL url = new URL("http://example.com");

        // Act
        UrlBuilder builder = new UrlBuilder(url);
        String builtUri = builder.build().toString();

        // Assert
        assertEquals("http://example.com", builtUri);
    }

    @Test
    public void testBuildUrlInvalidUri() throws URISyntaxException, MalformedURLException {
        // Arrange
        String invalidUri = "invalid://example.com";

        // Act
        UrlBuilder builder = new UrlBuilder(null);

        // Assert
        try {
            builder.build();
            assertTrue(false);
        } catch (MalformedURLException e) {
            assertEquals("Invalid URI: " + invalidUri, e.getMessage());
        }
    }

    @Test
    public void testAppendKeyVal() throws UnsupportedEncodingException {
        // Arrange
        Connection.KeyVal kv = new Connection.KeyVal();

        // Act
        UrlBuilder builder = new UrlBuilder(null);
        builder.appendKeyVal(kv);

        // Assert
        assertEquals("key=value", kv.toString());
    }
}
