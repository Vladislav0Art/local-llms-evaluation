import java.util.ArrayList;
import java.util.List;

public class Stack {
    private int[] elements;
    private int size;

    public Stack(int maxSize) {
        this.elements = new int[maxSize];
        this.size = 0;
    }

    public void push(int element) {
        if (size == elements.length) {
            resize();
        }
        elements[size++] = element;
    }

    public int pop() {
        return elements[--size];
    }

    private void resize() {
        int[] newElements = new int[elements.length * 2];
        System.arraycopy(elements, 0, newElements, 0, size);
        elements = newElements;
    }
}

public class StockSpanCalculator {

    private Stack<Integer> stockSpanStack;

    public StockSpanCalculator(Stack<Integer> stack) {
        this.stockSpanStack = stack;
    }

    public int calculate(int price) {
        while (!stockSpanStack.isEmpty() && stockSpanStack.peek() <= price) {
            stockSpanStack.pop();
        }
        int span = stockSpanStack.isEmpty() ? 1 : stockSpanStack.peek() + 1;
        stockSpanStack.push(price);
        return span;
    }

    public static void main(String[] args) {
        Stack<Integer> stack = new Stack<>(1000);
        StockSpanCalculator calculator = new StockSpanCalculator(stack);

        List<Integer> result = new ArrayList<>();
        int[] prices = {100, 80, 75, 70, 60};
        for (int price : prices) {
            result.add(calculator.calculate(price));
        }

        System.out.println(result);
    }
}
