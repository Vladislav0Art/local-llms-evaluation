        assertThat(safelist.isSafeTag("a"), is(true));
        assertThat(safelist.isSafeAttribute("a", null, null), is(true));
    }

    @Test
    public void basic[]

    Test() {
        Safelist safelist = Safelist.basic();
        assertThat(safelist.isSafeTag("img"), is(false));
        assertThat(safelist.isSafeAttribute("img", null, null), is(false));
    }

    @Test
    public void basicWithImages[]

    Test() {
        Safelist safelist = Safelist.basicWithImages();
        assertThat(safelist.isSafeTag("img"), is(true));
        assertThat(safelist.isSafeAttribute("img", null, null), is(true));
    }

    @Test
    public void relaxed[]

    Test() {
        Safelist safelist = Safelist.relaxed();
        assertThat(safelist.isSafeTag("img"), is(true));
        assertThat(safelist.isSafeAttribute("img", null, null), is(false));
    }

    @Test
    public void addTags[]

    Test() {
        Safelist safelist = Safelist.addTags("strong", "b");
        assertTrue(safelist.isSafeTag("strong"));
        assertTrue(safelist.isSafeTag("b"));
    }

    @Test
    public void removeTags[]

    Test() {
        Safelist safelist = Safelist.basic();
        Safelist newSafelist = safelist.removeTags("strong", "b");
        assertFalse(newSafelist.isSafeTag("strong"));
        assertFalse(newSafelist.isSafeTag("b"));
    }

    @Test
    public void addAttributes[]

    Test() {
        Safelist safelist = Safelist.addAttributes("a", "href", "https://example.com");
        assertTrue(safelist.isSafeAttribute("a", null, null));
    }

    @Test
    public void removeAttributes[]

    Test() {
        Safelist safelist = Safelist.basic();
        Safelist newSafelist = safelist.removeAttributes("a", "href");
        assertFalse(newSafelist.isSafeAttribute("a", null, null));
    }

    @Test
    public void addEnforcedAttribute[]

    Test() {
        Safelist safelist = Safelist.addEnforcedAttribute("img", "src", "https://example.com");
        assertTrue(safelist.isSafeAttribute("img", null, null));
    }

    @Test
    public void removeEnforcedAttribute[]

    Test() {
        Safelist safelist = Safelist.basic();
        Safelist newSafelist = safelist.removeEnforcedAttribute("img", "src");
        assertFalse(newSafelist.isSafeAttribute("img", null, null));
    }

    @Test
    public void preserveRelativeLinks[]

    Test() {
        boolean expected = true;
        when(Safelist.prototype().preserveRelativeLinks()).thenReturn(expected);
        Safelist safelist = Safelist.prototype();
        assertTrue(safelist.preserveRelativeLinks());
    }

}
