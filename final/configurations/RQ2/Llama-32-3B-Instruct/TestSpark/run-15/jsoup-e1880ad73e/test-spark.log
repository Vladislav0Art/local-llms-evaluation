import java.net.URLEncoder;
import java.nio.charset.StandardCharsets;

public class UrlBuilder {
    private String baseUrl;
    private final StringBuilder queryParams = new StringBuilder();

    public UrlBuilder(String baseUrl) {
        this.baseUrl = baseUrl;
    }

    public void appendQuery_param(Connection.KeyVal kv) {
        if (queryParams.length() > 0) {
            queryParams.append("&");
        }
        queryParams.append("key=").append(URLEncoder.encode(kv.getKey(), StandardCharsets.UTF_8));
        queryParams.append("=").append(URLEncoder.encode(kv.getValue(), StandardCharsets.UTF_8));
    }

    public void appendQuery_params(Connection.KeyVal... kv) {
        for (Connection.KeyVal param : kv) {
            appendQuery_param(param);
        }
    }

    public String build() {
        if (baseUrl == null || baseUrl.isEmpty()) {
            return queryParams.toString();
        } else {
            return baseUrl + "?" + queryParams.toString();
        }
    }
}

