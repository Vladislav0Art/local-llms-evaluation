                    "&key3=" + URLEncoder.encode(kv.getKey(), DataUtil.UTF_8);
        } else {
            return "&key1=" + URLEncoder.encode(another.getKey(), DataUtil.UTF_8) +
                    "&key2=" + URLEncoder.encode(yetAnother.getKey(), DataUtil.UTF_8) +
                    "&key3=" + URLEncoder.encode(kv.getKey(), DataUtil.UTF_8);
        }
    }

    public String build() {
        return url;
    }
}

