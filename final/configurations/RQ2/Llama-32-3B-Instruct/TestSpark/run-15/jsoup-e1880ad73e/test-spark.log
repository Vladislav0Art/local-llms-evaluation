public class UrlBuilder {
    private String url;

    public UrlBuilder(String url) {
        this.url = url;
    }

    public void fromValidUrl(String validUrl) {
        this.url = validUrl;
    }

    public String appendKeyVal(Connection.KeyVal kv) {
        if (url == null || url.isEmpty()) {
            return "?key=" + URLEncoder.encode(kv.getKey(), DataUtil.UTF_8);
        } else {
            return "&key=" + URLEncoder.encode(kv.getKey(), DataUtil.UTF_8);
        }
    }

    public String appendKeyVal(Connection.KeyVal kv, Connection.KeyVal another) {
        if (url == null || url.isEmpty()) {
            return "?key1=" + URLEncoder.encode(another.getKey(), DataUtil.UTF_8) +
                    "&key2=" + URLEncoder.encode(kv.getKey(), DataUtil.UTF_8);
        } else {
            return "&key1=" + URLEncoder.encode(another.getKey(), DataUtil.UTF_8) +
                    "&key2=" + URLEncoder.encode(kv.getKey(), DataUtil.UTF_8);
        }
    }

    public String appendKeyVal(Connection.KeyVal kv, Connection.KeyVal another, Connection.KeyVal yetAnother) {
        if (url == null || url.isEmpty()) {
