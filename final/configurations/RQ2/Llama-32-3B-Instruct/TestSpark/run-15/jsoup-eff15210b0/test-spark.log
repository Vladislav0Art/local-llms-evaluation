import org.jsoup.Connection;
import org.jsoup.HttpStatusException;
import org.jsoup.UncheckedIOException;
import org.jsoup.UnsupportedMimeTypeException;
import org.jsoup.helper.HttpConnection;
import org.junit.Test;
import static org.junit.Assert.*;
import java.io.ByteArrayInputStream;
import java.io.IOException;
import java.util.HashMap;
import java.util.Map;

public class HttpConnectionTest {
    @Test
    public void connect_url_isNotNullTest() {
        String url = "http://example.com";
        Connection connection = HttpConnection.connect(url);
        assertNotNull(connection);
    }

    @Test
    public void connect_url_isNotNullTest() {
        String url = "http://example.com";
        Connection connection = HttpConnection.connect(url);
        assertFalse(connection == null);
    }

    @Test
    public void connect_url_withProxy_isNotNullTest() {
        Proxy proxy = new Proxy(Proxy.Type.HTTP, new InetSocketAddress("localhost", 8080));
        String url = "http://example.com";
        Connection connection = HttpConnection.connect(url, proxy);
        assertNotNull(connection);
    }

    @Test
    public void connect_url_withProxy_isNotNullTest() {
        Proxy proxy = new Proxy(Proxy.Type.HTTP, new InetSocketAddress("localhost", 8080));
        String url = "http://example.com";
        Connection connection = HttpConnection.connect(url, proxy);
        assertFalse(connection == null);
    }

    @Test
    public void connect_url_withUrl_isNotNullTest() {
        URL url = new URL("http://example.com");
        Connection connection = HttpConnection.connect(url);
        assertNotNull(connection);
    }

    @Test
    public void connect_url_withUrl_isNotNullTest() {
        URL url = new URL("http://example.com");
        Connection connection = HttpConnection.connect(url);
        assertFalse(connection == null);
    }

    @Test
    public void connect_url_withNullUrl_ThrowsExceptionTest() {
        try {
            String url = null;
            HttpConnection.connect(url);
            fail();
        } catch (UncheckedIOException e) {
            assertEquals("url", e.getMessage());
        }
    }

    @Test
    public void post_request_isNotNullTest() {
        Connection connection = new HttpConnection();
        connection.method(Connection.Method.POST);
        Connection.Request request = connection.request();
        assertNotNull(request);
    }

    @Test
    public void get_request_isNotNullTest() {
        Connection connection = new HttpConnection();
        connection.method(Connection.Method.GET);
        Connection.Request request = connection.request();
        assertNotNull(request);
    }

    @Test
    public void execute_response_isNotNullTest() throws IOException {
        Connection connection = new HttpConnection();
        connection.method(Connection.Method.GET);
        Connection.Response response = connection.execute();
        assertNotNull(response);
    }

    @Test
    public void get_body_isEmptyStringTest() throws IOException {
        Connection connection = new HttpConnection();
        connection.method(Connection.Method.GET);
        String body = connection.requestBody().body();
        assertEquals("", body, StringComparison.UTF_8);
    }

    @Test
    public void post_body_containsValuesTest() throws IOException {
        Connection connection = new HttpConnection();
        Map<String, String> data = new HashMap<>();
        data.put("key", "value");
        connection.data(data);
        String body = connection.requestBody().body();
        assertTrue(body.contains("key=value"));
    }

    @Test
    public void headers_isNotNullTest() {
        Connection connection = new HttpConnection();
        Map<String, String> headers = new HashMap<>();
        headers.put("Content-Type", "application/json");
        connection.headers(headers);
        assertNotNull(connection.request().headers());
    }
}
