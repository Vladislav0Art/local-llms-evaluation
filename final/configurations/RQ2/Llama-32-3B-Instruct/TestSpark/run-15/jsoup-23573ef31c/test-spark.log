import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.select.Elements;

public class FormElementTest {

    public static void main(String[] args) {
        // Test 1: Basic form validation
        testBasicFormValidation();

        // Test 2: Empty input fields
        testEmptyInputFields();

        // Test 3: Non-empty input fields
        testNonEmptyInputFields();
    }

    private static void testBasicFormValidation() {
        String html = "<form><input type='text' name='username'/><input type='password' name='password'/></form>";
        Document document = Jsoup.parse(html);
        Elements elements = document.getElementsByAttribute("name");
        for (Element element : elements) {
            System.out.println(element.attr("name"));
        }
    }

    private static void testEmptyInputFields() {
        String html = "<form><input type='text' name='username'/><input type='password' name='password'/></form>";
        Document document = Jsoup.parse(html);
        Elements elements = document.getElementsByAttribute("name");
        for (Element element : elements) {
            if (element.attr("value").isEmpty()) {
                System.out.println(element.attr("name"));
            }
        }
    }

    private static void testNonEmptyInputFields() {
        String html = "<form><input type='text' name='username' value='john'/><input type='password' name='password'/></form>";
        Document document = Jsoup.parse(html);
        Elements elements = document.getElementsByAttribute("name");
        for (Element element : elements) {
            if (!element.attr("value").isEmpty()) {
                System.out.println(element.attr("name"));
            }
        }
    }

}

public class FormElement {

    private String name;
    private String value;

    public FormElement(String name, String value) {
        this.name = name;
        this.value = value;
    }

    public String getName() {
        return name;
    }

    public void setName(String name) {
        this.name = name;
    }

    public String getValue() {
        return value;
    }

    public void setValue(String value) {
        this.value = value;
    }

    public boolean isEmpty() {
        if (name != null && !name.isEmpty()) {
            return false;
        }
        return true;
