package org.jsoup.nodes;

import org.junit.Test;
import static org.junit.Assert.*;
import java.io.ByteArrayOutputStream;
import java.io.IOException;
import java.util.concurrent.Callable;

public class TextNodeTest {

    @Test
    public void nodeName()[MethodUnderTest]Test() {
        TextNode node = new TextNode("Hello World");
        assertEquals("text", node.nodeName());
    }

    @Test
    public void text()[MethodUnderTest]Test() {
        TextNode node = new TextNode("");
        assertNull(node.text());
    }

    @Test
    public void textWithText()[MethodUnderTest]Test() {
        TextNode node = new TextNode("Hello World");
        assertEquals("Hello World", node.text());
    }

    @Test
    public void textWithEmptyString()[MethodUnderTest]Test() {
        TextNode node = new TextNode("");
        assertEquals("", node.text());
    }

    @Test
    public void textReplace()[MethodUnderTest]Test() throws IOException {
        TextNode node = new TextNode("Hello World");
        node.text("New Text");
        assertEquals("New Text", node.text());
    }

    @Test
    public void getWholeText()[MethodUnderTest]Test() {
        TextNode node = new TextNode("Hello World");
        assertEquals("Hello World", node.getWholeText());
    }

    @Test
    public void isBlank()[MethodUnderTest]Test() {
        TextNode node = new TextNode("");
        assertTrue(node.isBlank());
    }

    @Test
    public void isBlankNot()[MethodUnderTest]Test() {
        TextNode node = new TextNode("Hello World");
        assertFalse(node.isBlank());
    }

    @Test
    public void splitTextSingleCharacterOffset()[MethodUnderTest]Test() throws IOException {
        TextNode node = new TextNode("Hello\nWorld");
        TextNode result1 = (TextNode) node.splitText(0);
        assertEquals("Hello", result1.text());
        assertEquals("\n", result1.getWholeText());

        TextNode result2 = (TextNode) node.splitText(node.text().length() - 1);
        assertEquals("\nWorld", result2.text());
    }

    @Test
    public void splitTextMultipleCharacterOffset()[MethodUnderTest]Test() throws IOException {
        TextNode node = new TextNode("Hello\nWorld");
        TextNode result0 = (TextNode) node.splitText(4);
        assertEquals("llo", result0.text());

        TextNode result1 = (TextNode) node.splitText(result0.text().length());
        assertEquals("\nWorld", result1.text());
    }

    @Test
    public void outerHtmlHead()[MethodUnderTest]Test() throws IOException {
        TextNode node = new TextNode("Hello World");
        ByteArrayOutputStream output = new ByteArrayOutputStream();
        documentBuilder.append(node, 0, output);
        assertNotNull(output.toString().trim());
    }

    @Test
    public void outerHtmlTail()[MethodUnderTest]Test() throws IOException {
        TextNode node = new TextNode("");
        ByteArrayOutputStream output = new ByteArrayOutputStream();
        documentBuilder.append(node, 1, output);
        assertEquals("<br>", output.toString().trim());
    }

    @Test
    public void clone()[MethodUnderTest]Test() {
        TextNode node = new TextNode("Hello World");
        TextNode result = (TextNode) node.clone();
        assertNotNull(result);
    }

