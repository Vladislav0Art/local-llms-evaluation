import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.BeforeEach;
import static org.hamcrest.MatcherAssert.assertThat;
import static org.hamcrest.core.Is.is;
import static org.mockito.Mockito.when;
import static org.mockito.Mockito.anyMap;

public class PropertyListBuilderTest {

    public static class Property {
        public String key;
        public Object value;

        public Property(String key, Object value) {
            this.key = key;
            this.value = value;
        }
    }

    public interface PropertyListBuilder {
        Map<String, Object> create();
    }

    private PropertyListBuilder builder = new PropertyListBuilder() {
        @Override
        public Map<String, Object> create() {
            return null;
        }
    };

    @BeforeEach
    public void setup() {
        when(builder.getRootEntries()).thenReturn(anyMap());
    }

    @Test
    public void testRootEntries() {
        when(builder.getRootEntries()).thenReturn(new LinkedHashMap<>());
        assertThat(((Map) builder.create().get(0)), is(null)); // test properties are not present in the output
    }

    public static class PropertyListBuilderImpl implements PropertyListBuilder {
        private Map<String, Object> entries = new LinkedHashMap<>();

        @Override
        public Map<String, Object> create() {
            return entries;
        }

        public void add(Property property) {
            entries.put(property.key, property.value);
        }
    }

    @Test
    public void testAddProperties() {
        PropertyListBuilderImpl builder = new PropertyListBuilderImpl();
        Property property1 = new Property("key1", "value1");
        Property property2 = new Property("key2", "value2");

        builder.add(property1);
        builder.add(property2);

        Map<String, Object> map = builder.create();
        assertThat(map.get("key1"), is("value1"));
        assertThat(map.get("key2"), is("value2"));
    }
}
