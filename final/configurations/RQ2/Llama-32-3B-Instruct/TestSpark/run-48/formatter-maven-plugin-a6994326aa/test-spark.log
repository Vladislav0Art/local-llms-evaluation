        CssFormatter formatter = new CssFormatter();
        ByteArrayOutputStream bos = new ByteArrayOutputStream();
        boolean result = formatter.doFormat(content, LineEnding.LF, bos);
        assertTrue(result);
        assertEquals(DEFAULT_CONTENT + "\n .header { font-size: 1.5em; color: #333; }", bos.toString());
    }

    public void testDoFormatInvalidContent() {
        CssFormatter formatter = new CssFormatter();
        IOException exception = assertThrows(IOException.class, () -> formatter.doFormat(" invalid content", LineEnding.LF));
        assertTrue(exception.getMessage().contains("invalid CSS content"));
    }
}

