package graphql.annotations.processor.retrievers.fieldBuilders;

import graphql.annotations.annotationTypes.directives.activation.GraphQLDirectives;
import graphql.annotations.processor.ProcessingElementsContainer;
import graphql.annotations.processor.exceptions.GraphQLAnnotationsException;
import graphql.annotations.processor.util.DirectiveJavaAnnotationUtil;
import graphql.schema.GraphQLArgument;
import graphql.schema.GraphQLDirective;
import graphql.schema.GraphQLScalarType;
import graphql.schema.GraphQLType;

import java.lang.annotation.Annotation;
import java.lang.reflect.AnnotatedElement;
import java.lang.reflect.Method;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
import java.util.stream.Collectors;

import org.junit.Test;

import static org.hamcrest.MatcherAssert.assertThat;
import static org.hamcrest.Matchers.is;

import org.mockito.Mockito;

public class GeneratedTest {

    @Test
    public void builderShouldCreateDirectivesFromAnnotationsOnObject() {
        // Given
        AnnotatedElement object = Mockito.mock(AnnotatedElement.class);
        ProcessingElementsContainer container = new ProcessingElementsContainer();
        List<GraphQLDirective> expectedDirectives = Arrays.asList(
                GraphQLDirective.newDirective("directive1", "Argument1"),
                GraphQLDirective.newDirective("directive2", "Argument2")
        );

        // When
        DirectivesBuilder builder = new DirectivesBuilder(object, container);
        GraphQLDirective[] directives = builder.build();

        // Then
        assertThat(directives, is(expectedDirectives));
    }

    @Test
    public void builderShouldSkipDirectivesOnObjectWithoutDirectives() {
        // Given
        AnnotatedElement object = Mockito.mock(AnnotatedElement.class);
        ProcessingElementsContainer container = new ProcessingElementsContainer();
        List<GraphQLDirective> expectedDirectives = Collections.emptyList();

        // When
        DirectivesBuilder builder = new DirectivesBuilder(object, container);
        GraphQLDirective[] directives = builder.build();

        // Then
        assertThat(directives, is(expectedDirectives));
    }

    @Test
    public void builderShouldHandleMultipleDirectivesOnObject() {
        // Given
        AnnotatedElement object = Mockito.mock(AnnotatedElement.class);
        ProcessingElementsContainer container = new ProcessingElementsContainer();
        List<GraphQLDirective> expectedDirectives = Arrays.asList(
                GraphQLDirective.newDirective("directive1", "Argument1"),
                GraphQLDirective.newDirective("directive2", "Argument2")
        );

        // When
        DirectivesBuilder builder = new DirectivesBuilder(object, container);
        GraphQLDirective[] directives = builder.build();

        // Then
        assertThat(directives, is(expectedDirectives));
    }

    @Test
    public void directivesShouldBeSorted() {
        // Given
        AnnotatedElement object = Mockito.mock(AnnotatedElement.class);
        ProcessingElementsContainer container = new ProcessingElementsContainer();
        List<GraphQLDirective> expectedDirectives = Arrays.asList(
                GraphQLDirective.newDirective("directive2", "Argument2"),
                GraphQLDirective.newDirective("directive1", "Argument1")
        );

        // When
        DirectivesBuilder builder = new DirectivesBuilder(object, container);
        GraphQLDirective[] directives = builder.build();

        // Then
        assertThat(directives, is(expectedDirectives));
    }

    @Test
    public void directivesShouldNotIncludeUnknownDirectives() {
        // Given
        AnnotatedElement object = Mockito.mock(AnnotatedElement.class);
        ProcessingElementsContainer container = new ProcessingElementsContainer();
        List<GraphQLDirective> expectedDirectives = Arrays.asList(
                GraphQLDirective.newDirective("directive1", "Argument1"),
                GraphQLDirective.newDirective("directive2", "Argument2")
        );

        // When
        DirectivesBuilder builder = new DirectivesBuilder(object, container);
        GraphQLDirective[] directives = builder.build();

        // Then
        assertThat(directives.stream().map(directive -> directive.getName()).collect(Collectors.toList()), is(Arrays.asList(expectedDirectives.get(0).getName(), expectedDirectives.get(1).getName())));
    }

    @Test
    public void shouldThrowExceptionWhenBuildIsCalledWithoutContainer() {
        // Given
        AnnotatedElement object = Mockito.mock(AnnotatedElement.class);

        // When and Then
        assertThrows(GraphQLAnnotationsException.class, () -> new DirectivesBuilder(object, null).build());
