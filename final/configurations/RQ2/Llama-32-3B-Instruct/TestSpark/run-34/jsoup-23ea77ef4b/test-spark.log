        String xml = "<root><child>Child content</child></root>";
        org.jsoup.nodes.Document doc = new DOMBuilder().parseString(xml);
        org.jsoup.nodes.Element root = doc.select("root").get(0).children().first();
        assertNotNull(root);
    }

    @org.junit.Test
    public void testStringConversion() {
        String xml = "<root><child>Child content</child></root>";
        org.jsoup.nodes.Document doc = new DOMBuilder().parseString(xml);
        org.jsoup.nodes.Element context = DOMHelper.contextNode(doc);
        assertEquals("root", DOMHelper.asString(context));
    }
}

