import org.jsoup.Jsoup;
import org.jsoup.nodes.Attribute;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.select.Elements;

public class JsoupTest {

    public static void main(String[] args) {
        // Test parsing a URL
        Document document = Jsoup.connect("http://jsoup.org/").get();
        
        // Test parsing HTML content
        String htmlContent = "<html><body>Hello World!</body></html>";
        Document parsedDocument = Jsoup.parse(htmlContent);

        // Get the title of the page from the parsed URL's document
        Element titleElement = document.title().first();
        System.out.println("Title: " + titleElement.data());

        // Get the text content of a specific HTML element
        Element h1Element = parsedDocument.selectFirst("h1");
        System.out.println("H1 Text: " + h1Element.text());

        // Find all elements with a specific class or id attribute
        Elements paragraphs = document.select(".paragraph");
        for (Element paragraph : paragraphs) {
            System.out.println(paragraph.data());
        }

        // Add a new HTML element to the parsed URL's document
        Element newDiv = Jsoup.parse("<div>New Div</div>").body().first();
        document.body().appendChild(newDiv);

        // Save the modified document to a file
        document.writeTo("output.html");

        // Test get method
        Attribute hrefAttribute = document.selectFirst("a").attr("href");
        System.out.println("Link: " + hrefAttribute);

        // Test html method
        String htmlContent2 = "<p>This is a paragraph.</p><p>This is another paragraph.</p>";
        Document document2 = Jsoup.parse(htmlContent2);
        System.out.println(document2.html());
    }
}
```

This code tests the following aspects of Jsoup:

1.  Parsing a URL: The `Jsoup.connect("http://jsoup.org/").get()` method is used to connect to a URL and retrieve its content.
2.  Parsing HTML content: The `Jsoup.parse(htmlContent)` method is used to parse HTML content and create a Jsoup document.
3.  Getting elements by their type: The `first()` method can be used to get the first child element of a given tag, such as title or h1.
4.  Getting elements by class: The `select(".class")` method can be used to select all elements with a specific class.
5.  Getting elements by id attribute: The `select("#id")` method can be used to select an element based on its id attribute.
6.  Adding new HTML content: A new HTML element can be added to the document using `Jsoup.parse()` and appending it to the body of the document.
7.  Saving the modified document to a file: The `writeTo("filename")` method is used to save the modified document to a file.
8.  Getting attributes: The `attr("attributeName")` method can be used to get an attribute value from an element.
9.  Getting HTML content: The `html()` method is used to get the HTML content of a Jsoup document.
