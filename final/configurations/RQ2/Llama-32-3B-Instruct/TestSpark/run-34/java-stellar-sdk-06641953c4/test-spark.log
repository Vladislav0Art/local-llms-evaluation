import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.stellar.sdk.KeyPair;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertFalse;
import static org.junit.Assert.assertTrue;
import static org.junit.Assert.fail;
import static org.mockito.Mockito.when;

@RunWith(MockitoJUnitRunner.class)
public class KeyPairTest {

    @Mock
    private EdDSAPrivateKey edDsaprivateKey;

    @Mock
    private EdDSAEngine edDsaEngine;

    public void setUp() {
        MockitoAnnotations.initMocks(this);
        when(edDsaEngine.getEdDspRng()).thenReturn(new byte[]{1, 2, 3});
    }

    @Test
    public void canSign_ReturnsTrueWhenPublicAndPrivateKeysAreGeneratedCorrectly() {
        KeyPair keyPair = new KeyPair(edDsaprivateKey);
        assertTrue(keyPair.canSign());
    }

    @Test
    public void canSign_ReturnsFalseWhenPublicOrPrivateKeysAreMissing() {
        when(edDsaprivateKey).thenReturn(null);
        assertFalse(new KeyPair(edDsaEngine.getEdDspRng()).canSign());
        when(edDsaEngine).thenReturn(null);
        assertFalse(KeyPair.fromSecretSeed("missing seed").canSign());
    }

    @Test
    public void fromPublic_ReturnsCorrectKeyPair() {
        EdDSAPublicKey publicKey = new EdDSAPublicKey(new byte[]{1, 2, 3});
        KeyPair keyPair = KeyPair.fromPublic(publicKey);
        assertEquals(publicKey, keyPair.getPublicKey());
    }

    @Test
    public void fromAccount_ReturnsCorrectKeyPair() {
        String accountId = "test_account";
        KeyPair keyPair = KeyPair.fromAccountId(accountId);
        assertTrue(keyPair.getAccountId().equals(accountId));
    }

    @Test
    public void getAccountId_ReturnsEmptyStringWhenNoAccountIdIsSet() {
        when(edDsaEngine).thenReturn(new EdDSAEngine());
        assertEquals("", KeyPair.random().getAccountId());
    }

    @Test
    public void getSecretSeed_ReturnsCorrectSeed() {
        char[] seed = "1234567890";
        KeyPair keyPair = KeyPair.fromSecretSeed(seed);
        assertEquals(seed, keyPair.getSecretSeed());
    }

    @Test
    public void fromXdrPublicKey_ReturnsCorrectKeyPair() {
        PublicKey publicKey = new PublicKey(new byte[]{1, 2, 3});
        KeyPair keyPair = KeyPair.fromXdrPublicKey(publicKey);
        assertTrue(keyPair.getXdrPublicKey().equals(publicKey));
    }

    @Test
    public void sign_returnsCorrectSignature() throws IOException, GeneralSecurityException {
        ByteArrayOutputStream bos = new ByteArrayOutputStream();
        XdrDataOutputStream xdrDataOutputStream = new XdrDataOutputStream(bos);
        Uint256 uint256 = new Uint256(1234567890L);
        when(edDsaEngine.getEdDspRng()).thenReturn(new byte[]{1, 2, 3});
        Signature signature = keyPair.sign(uint256.getBytes());
        assertEquals(signature, DecoratedSignature.create(xdrDataOutputStream, signature));
    }

    @Test
    public void verify_returnsTrueWhenSignatureIsCorrect() {
        when(edDsaEngine.getEdDspRng()).thenReturn(new byte[]{1, 2, 3});
        assertTrue(keyPair.verify(DecoratedSignature.create(ByteArrayOutputStream::new, null).getData(), new byte[]{4, 5, 6}));
    }

    @Test
    public void verify_returnsFalseWhenSignatureIsIncorrect() {
        when(edDsaEngine.getEdDspRng()).thenReturn(new byte[]{1, 2, 3});
        assertFalse(keyPair.verify(DecoratedSignature.create(ByteArrayOutputStream::new, null).getData(), new byte[]{7, 8, 9}));
    }
}
