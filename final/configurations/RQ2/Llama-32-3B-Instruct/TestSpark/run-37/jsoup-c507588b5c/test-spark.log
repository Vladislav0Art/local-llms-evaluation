package org.jsoup.nodes;

import org.jsoup.helper.Validate;
import org.jsoup.internal.StringUtil;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.mockito.junit.MockitoJUnitRunner;

import static org.hamcrest.MatcherAssert.assertThat;
import static org.hamcrest.Matchers.is;
import static org.jsoup.helper.Validate.notEmpty;
import static org.jsoup.nodes.TextNode.clone;
import static org.jsoup.nodes.TextNode.createFromEncoded;
import static org.jsoup.nodes.TextNode.splitText;
import static org.jsoup.nodes.NodeType.TEXT;

@RunWith(MockitoJUnitRunner.class)
public class GeneratedTest {

    @Mock
    private Appendable accum;

    @Mock
    private Document.OutputSettings out;

    public TextNode createTextNode() {
        return new TextNode("");
    }

    @Test
    public void nodeName_TextIsPresent_Test() {
        createTextNode();
    }

    @Test
    public void text_ThrowsExceptionWhenEmptyText_isPresent_Test() {
        String text = StringUtil.EMPTY;
        try {
            new TextNode(text);
            Validate.that(false, "text").isTrue();
        } catch (NullPointerException e) {
        }
    }

    @Test
    public void text_GettingText_whenNotBlank_Test() {
        createTextNode();
        String text = "Hello World";
        TextNode node = new TextNode(text);
        assertThat(node.text(), is(text));
    }

    @Test
    public void text_GettingEmptyText_whenBlank_Test() {
        createTextNode();
        TextNode node = new TextNode(StringUtil.EMPTY);
        assertThat(node.text(), is(StringUtil.EMPTY));
    }

    @Test
    public void getWholeText_WhenNoChildNodes_Test() {
        TextNode node = new TextNode("Hello World");
        String wholeText = node.getWholeText();
        assertThat(wholeText, is("Hello World"));
    }

    @Test
    public void getWholeText_WhenChildrenNodesPresent_Test() throws IOException {
        createTextNode();
        Document doc = new Document();
        Appendable appendable = new StringBuilder();
        TextNode node = new TextNode("Hello");
        doc.appendChild(node);
        TextNode childNode = new TextNode(" World");
        node.appendChild(childNode);
        document.write(accum, out, 0);
        String wholeText = accum.toString();
        assertThat(wholeText, is("Hello World"));
    }

    @Test
    public void isBlank_TextIsNotPresent_Test() {
        createTextNode();
        String text = "Hello World";
        TextNode node = new TextNode(text);
        assertThat(node.isBlank(), is(false));
    }

    @Test
    public void isBlank_TextIsPresent_butEmptyText_Test() {
        createTextNode();
        assertThat(createTextNode().isBlank(), is(true));
    }

    @Test
    public void splitText_SplittingAtZeroOffset_Test() {
        TextNode node = new TextNode("Hello World");
        TextNode result = node.splitText(0);
        assertThat(result.text(), is("Hello "));
        assertThat(node.text(), is("World"));
    }

    @Test
    public void outerHtmlHead_WriteToHeadOfElement_Test() throws IOException {
        createTextNode();
        Appendable appendable = new StringBuilder();
        Document.OutputSettings outputSettings = new Document.OutputSettings();
        TextNode node = new TextNode("<p>Hello World</p>");
        document.appendChild(node);
        document.write(accum, out, 0);
        assertThat(accum.toString(), is("<p class=\"text\">Hello World</p>"));
    }

    @Test
    public void outerHtmlTail_WriteToTailOfElement_Test() {
        createTextNode();
        Appendable appendable = new StringBuilder();
        Document.OutputSettings outputSettings = new Document.OutputSettings();
        TextNode node = new TextNode("<p>Hello World</p>");
        document.write(accum, out, 0);
        assertThat(accum.toString(), is("<p class=\"text\">Hello World</p>"));
    }

    @Test
    public void clone_CloneNode_Test() {
        createTextNode();
        TextNode node = new TextNode("Hello World");
        TextNode cloned = node.clone();
        assertThat(cloned.text(), is("Hello World"));
    }

}
