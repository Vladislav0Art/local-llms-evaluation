import org.junit.Test;
import static org.junit.Assert.*;

public class KeyPairTest {

    @Test
    public void canSign_DoesNotRequirePublicInfo() {
        // Arrange and Act
        KeyPair keyPair = new KeyPair(null);
        boolean result = keyPair.canSign();

        // Assert
        assertTrue(result);
    }

    @Test
    public void fromSecretSeed_SignatureIsValidWithCorrectSeed() throws Exception {
        // Arrange
        byte[] seed = "my_seed".getBytes();
        KeyPair keyPair = KeyPair.fromSecretSeed(seed);

        // Act and Assert
        byte[] publicKey = keyPair.getPublicKey();
        boolean isValid = isValidSignature(publicKey, seed);
        assertTrue(isValid);
    }

    @Test
    public void fromPublicInfo_CanExtractPublicInfoCorrectly() {
        // Arrange
        byte[] publicKey = "my_public_key".getBytes();
        KeyPair keyPair = KeyPair.fromXdrPublicKey(new PublicKey(keyType -> publicKey));

        // Act and Assert
        assertTrue(Arrays.equals(keyPair.getPublicKey(), publicKey));
    }

    @Test
    public void canSign_BeforeSigning() {
        // Arrange and Act
        KeyPair keyPair = new KeyPair(null);
        boolean result = keyPair.canSign();

        // Assert
        assertTrue(result);
    }

    @Test
    public void fromAccountId_CanExtractAccountIdCorrectly() {
        // Arrange
        String accountId = "my_account_id";
        KeyPair keyPair = KeyPair.fromAccountId(accountId);

        // Act and Assert
        assertEquals(accountId, keyPair.getAccountId());
    }

    @Test
    public void random_GeneratesRandomKeyPair() throws Exception {
        // Act and Assert
        KeyPair keyPair = KeyPair.random();
        assertNotNull(keyPair);
        assertTrue(keyPair.canSign());
    }

    private boolean isValidSignature(byte[] publicKey, byte[] seed) throws GeneralSecurityException {
        Signature signature = Signature.getInstance("Ed25519WithSHA256");
        signature.initVerify(publicKey);
        signature.update(seed);
        return signature.verify(publicKey);
    }
}

