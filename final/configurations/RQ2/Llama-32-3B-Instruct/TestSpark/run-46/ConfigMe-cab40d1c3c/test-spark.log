    }
}

public class PropertyListBuilder {
    private Map<String, Object> rootEntries;

    public PropertyListBuilder() {
        this.rootEntries = new LinkedHashMap<>();
    }

    public void add(Property property) {
        rootEntries.put(property.getName(), property.getValue());
    }

    public List<Property> create() {
        return (List<Property>) rootEntries.get("properties");
    }

    public Map<String, Object> getRootEntries() {
        return rootEntries;
    }
}

