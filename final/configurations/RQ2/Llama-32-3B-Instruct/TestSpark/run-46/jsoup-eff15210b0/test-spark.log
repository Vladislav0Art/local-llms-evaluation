    @org.junit.Test
    public void testGet() {
        // Test URL
        String url = "http://example.com";

        // Set up the HTTP client
        HttpClient httpClient = new HttpClient();
        httpClient.setUrl(url);

        // Make a GET request
        Response response = httpClient.get();

        // Check the response status code
        org.junit.Assert.assertEquals(200, (int) response.getStatus());
    }

    @org.junit.Test
    public void testPost() {
        // Test URL
        String url = "http://example.com";

        // Set up the HTTP client
        HttpClient httpClient = new HttpClient();
        httpClient.setUrl(url);

        // Set data to post
        Map<String, Object> data = new HashMap<>();
        data.put("key", "value");

        // Post the data
        Response response = httpClient.post(data);

        // Check the response status code
        org.junit.Assert.assertEquals(200, (int) response.getStatus());

        // Check if the POST was successful
        org.junit.Assert.assertTrue(response.isPostSuccessful());
    }

    @org.junit.Test
    public void testSendRequest() {
        // Test URL
        String url = "http://example.com";

        // Set up the HTTP client
        HttpClient httpClient = new HttpClient();
        httpClient.setUrl(url);

        // Make a POST request with data
        Response response = httpClient.post(new Map<String, Object>() {{
            put("key", "value");
        }});

        // Check if the POST was successful
        org.junit.Assert.assertTrue(response.isPostSuccessful());

        // Set header
        httpClient.setHeaders(map -> map.put("Content-Type", "UTF_8"));

        // Send a request with a header
        response = httpClient.post();

        // Check if the POST was successful
        org.junit.Assert.assertTrue(response.isPostSuccessful());
    }

    public class HttpClient {
        private String url;

        public HttpClient setUrl(String url) {
