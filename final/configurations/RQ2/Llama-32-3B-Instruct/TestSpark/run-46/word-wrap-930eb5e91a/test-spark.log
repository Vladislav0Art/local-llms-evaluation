package org.davidmoten.text.utils;

import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;

import java.io.BufferedReader;
import java.io.File;
import java.io.FileInputStream;
import java.io.FileNotFoundException;
import java.io.IOException;
import java.io.InputStreamReader;
import java.util.ArrayList;
import java.util.List;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertTrue;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

@RunWith(MockitoJUnitRunner.class)
public class WordWrapTest {

    @Mock
    private Reader reader;

    @Mock
    private LineConsumer lineConsumer;

    @Mock
    private File file;

    @Test
    public void fromReader() {
        when(reader.read()).thenReturn(0);
        when(reader.readLine()).thenReturn("");
        assertEquals(WordWrap.Builder.from(reader), WordWrap.Builder.empty());
    }

    @Test
    public void fromClasspathUtf8() {
        when(file.getName()).thenReturn("resource.txt");
        when(new FileInputStream(file)).thenReturn(new MockInputStream());
        when(reader.read()).thenReturn(0);
        when(reader.readLine()).thenReturn("");
        assertEquals(WordWrap.Builder.fromClasspathUtf8("resource.txt"), WordWrap.Builder.empty());
    }

    @Test
    public void fromClasspath() {
        when(file.getName()).thenReturn("resource.txt");
        when(new FileInputStream(file)).thenReturn(new MockInputStream());
        when(reader.read()).thenReturn(0);
        when(reader.readLine()).thenReturn("");
        assertEquals(WordWrap.Builder.fromClasspath("resource.txt", StandardCharsets.UTF_8), WordWrap.Builder.empty());
    }

    @Test
    public void fromCharSequence() {
        when(reader.read()).thenReturn(0);
        when(reader.readLine()).thenReturn("");
        assertEquals(WordWrap.Builder.from("Hello World"), WordWrap.Builder.empty());
    }

    @Test
    public void fromUtf8InputStream() {
        when(new MockInputStream().read()).thenReturn(0);
        when(new MockInputStream().readLine()).thenReturn("");
        assertEquals(WordWrap.Builder.fromUtf8(new MockInputStream()), WordWrap.Builder.empty());
    }

    @Test
    public void wordWrapReaderWriter() throws IOException {
        String newLine = "\n";
        Number maxWidth = 10L;
        Function<CharSequence, Number> stringWidth = (s) -> s.length();
        Set<Character> extraWordChars = new HashSet<>();
        boolean insertHyphens = true;
        boolean breakWords = false;
        when(lineConsumer.write(any())).thenReturn(0);
        WordWrap.wordWrap(reader, lineConsumer, maxWidth, stringWidth, extraWordChars, insertHyphens, breakWords);
    }

    @Test
    public void wordWrapReaderLineConsumer() throws IOException {
        String newLine = "\n";
        Number maxWidth = 10L;
        Function<CharSequence, Number> stringWidth = (s) -> s.length();
        Set<Character> extraWordChars = new HashSet<>();
        boolean insertHyphens = true;
        boolean breakWords = false;
        when(lineConsumer.accept(any())).thenReturn(0);
        WordWrap.wordWrap(reader, lineConsumer, maxWidth, stringWidth, extraWordChars, insertHyphens, breakWords);
    }

    @Test
    public void isWhitespace() {
        assertTrue(WordWrap.isWhitespace("   "));
    }

    @Test
    public void rightTrim() {
        assertEquals("", WordWrap.rightTrim("\t  "));
    }

    private static class MockInputStream implements InputStream {
        private int cursor = 0;

        @Override
        public int read() throws IOException {
            return cursor++;
        }

        @Override
        public long skip(long toSkip) throws IOException, InterruptedException {
            throw new UnsupportedOperationException();
        }
    }

    private static class LineConsumer {
        boolean accepted = false;

        void accept(CharSequence line) {
            accepted = true;
        }
    }

