    @Test
    public void testGetAllComments() {
        CommentConfig commentConfig = new CommentConfig();
        commentConfig.setComment("line1");
        Set<String> expected = new HashSet<>(Arrays.asList("line1"));
        assertEquals(expected, commentConfig.getAllComments());
    }

    @Test
    public void testAddComment() {
        CommentConfig commentConfig = new CommentConfig();
        List<String> expected = Arrays.asList("line2", "line3");
        commentConfig.addComment("line2");
        commentConfig.addComment("line3");
        assertEquals(expected, commentConfig.getAllComments());
    }

    @Test
    public void testRemoveComment() {
        CommentConfig commentConfig = new CommentConfig();
        List<String> expected = Arrays.asList("line1", "line2");
        commentConfig.addComment("line1");
        commentConfig.removeComment("line1");
        commentConfig.addComment("line2");
        assertEquals(expected, commentConfig.getAllComments());
    }

    @Test
    public void testGetAllCommentsWithEmptySet() {
