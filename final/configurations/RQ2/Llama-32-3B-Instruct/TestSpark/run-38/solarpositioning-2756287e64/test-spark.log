public class DateUtil {

    public static Date getInitialDate() {
        return new Date(2024, 0, 1);
    }

    public static String calculateSunPosition(Date initialDate, Location location) {
        // implement your calculation here
        int sunriseHour = 6;
        int sunsetHour = 18;

        if (initialDate.getMonth() == 3 && initialDate.getDay() >= 20) {
            sunriseHour = 5;
        } else if (initialDate.getMonth() == 12 && initialDate.getDay() <= 25) {
            sunsetHour = 7;
        }

        return "Sunrise: " + initialDate.getYear() + "-" + initialDate.getMonth() + "-" + initialDate.getDay()
                + " - Sunrise Time: " + sunriseHour + ":00";
    }
}

