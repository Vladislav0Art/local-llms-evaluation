package org.jsoup.nodes;

public class TextNode {
    private String text;

    public TextNode(String text) {
        this.text = text;
    }

    public void setText(String text) {
        this.text = text;
    }

    public String getText() {
        return text;
    }

    public String text() {
        return text;
    }

    public String nodeName() {
        return "text-node";
    }

    public String getWholeText() {
        return text;
    }

    public boolean isBlank() {
        return text.isEmpty();
    }

    public TextNode clone() {
        return new TextNode(text);
    }

    public static TextNode fromEncoded(String encoded) {
        return new TextNode(encoded);
    }
}

public class StringUtil {

    public static String normalizeWhitespace(String str) {
        // implementation
        return str;
    }

    public static String stripLeadingWhitespace(String str) {
        // implementation
        return str;
    }

    public static boolean lastCharIsWhitespace(Document document) {
        org.jsoup.nodes.TextNode textNode = (org.jsoup.nodes.TextNode) document.getLastChild();
        return textNode.getText().charAt(textNode.getText().length() - 1) == ' ';
    }
}
