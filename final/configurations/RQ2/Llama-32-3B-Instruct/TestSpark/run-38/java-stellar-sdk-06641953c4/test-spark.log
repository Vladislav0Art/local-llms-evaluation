        assertTrue(keyPair1.equals(keyPair2));
    }

    @Test
    public void equalsWithDifferentKeyPairReturnsFalse()[Scenario]Test {
        KeyPair keyPair1 = new KeyPair();
        KeyPair keyPair2 = new KeyPair();
        assertFalse(keyPair1.equals(new Object()));
    }
