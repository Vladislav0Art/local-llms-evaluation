import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

public class TagTest {

    @Test
    public void testTagConstructor() {
        Tag tag = new Tag("a", "href", "https://example.com");
        assertEquals("a", tag.tagName);
        assertEquals("href", tag.attributeName);
        assertEquals("https://example.com", tag.value);
    }

    @Test
    public void testTagFormatAsBlock() {
        Tag tag = new Tag("div", null, "");
        assertTrue(tag.formatAsBlock());
    }

    @Test
    public void testTagIsInline() {
        Tag tag = new Tag("span", null, "");
        assertTrue(tag.isInline());
    }

    @Test
    public void testTagIsEmpty() {
        Tag tag = new Tag("", "class", "text");
        assertFalse(tag.isEmpty());
    }

    @Test
    public void testTagIsSelfClosing() {
        Tag tag = new Tag("img", null, "");
        assertTrue(tag.setSelfClosing());
    }
}

public class Tag {

    private String tagName;
    private String attributeName;
    private String value;

    public Tag(String tagName, String attributeName, String value) {
        this.tagName = tagName;
        this.attributeName = attributeName;
        this.value = value;
    }

    public String getTagName() {
        return tagName;
    }

    public String getAttributeName() {
        return attributeName;
    }

    public String getValue() {
        return value;
    }

    public boolean formatAsBlock() {
        return true;
    }

    public boolean isInline() {
        return true;
    }

    public boolean isEmpty() {
        return false;
    }

    public boolean setSelfClosing() {
        return true;
    }
}
