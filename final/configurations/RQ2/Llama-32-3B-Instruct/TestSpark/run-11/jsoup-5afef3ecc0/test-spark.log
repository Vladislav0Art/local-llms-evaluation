        Connection.KeyVal kv = new Connection.KeyVal("key", 123);
        UrlBuilder builder = new UrlBuilder(inputUrl);
        builder.appendKeyVal(kv);
        assertEquals("http://example.com?key=123", builder.build().toExternalForm());
    }

    @Test
    public void withQueryWithNonStringValueAndOtherParamAddsToUrlCorrectly() throws MalformedURLException, URISyntaxException {
        URL inputUrl = new URL("http://example.com");
        Connection.KeyVal kv = new Connection.KeyVal("key1", "value1");
        Connection.KeyVal kv2 = new Connection.KeyVal("key2", 123);
        UrlBuilder builder = new UrlBuilder(inputUrl);
        builder.appendKeyVal(kv);
        builder.appendKeyVal(kv2);
        assertEquals("http://example.com?key1=value1&key2=123", builder.build().toExternalForm());
    }

    @Test
    public void withQueryDecodesValueCorrectly() throws MalformedURLException, URISyntaxException {
        URL inputUrl = new URL("http://example.com");
        Connection.KeyVal kv = new Connection.KeyVal("key", "value");
        UrlBuilder builder = new UrlBuilder(inputUrl);
        builder.appendKeyVal(kv);
        assertEquals("http://example.com?key=value", builder.build().toExternalForm());
    }

    @Test
    public void withQueryDecodesValueCorrectlyWithNonUTF8String() throws MalformedURLException, URISyntaxException {
        URL inputUrl = new URL("http://example.com");
        Connection.KeyVal kv = new Connection.KeyVal("key", StringUtil.UTF_16);
        UrlBuilder builder = new UrlBuilder(inputUrl);
        builder.appendKeyVal(kv);
        assertEquals("http://example.com?key=utf-16", builder.build().toExternalForm());
    }

