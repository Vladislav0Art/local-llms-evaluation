        for (int i = 0; i < children.getLength(); i++) {
            Node child = children.item(i);
            if (child.getNodeType() == Node.ELEMENT_NODE && clazz.isInstance(child)) {
                result.add(child);
            } else if (child.getNodeType() == Node.TEXT_NODE) {
                String text = child.getNodeValue();
                if (clazz.equals(String.class) || clazz.isInstance(text)) {
                    result.add(text);
