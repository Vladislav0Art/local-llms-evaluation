    private static org.w3c.dom.Document parseXml(String xmlString) throws Exception {
        javax.xml.parsers.DocumentBuilderFactory factory = javax.xml.parsers.DocumentBuilderFactory.newInstance();
        javax.xml.parsers.DocumentBuilder builder = factory.newDocumentBuilder();
        java.io.ByteArrayInputStream input = new java.io.ByteArrayInputStream(xmlString.getBytes("UTF-8"));
        return builder.parse(input);
    }

    private static NodeList findElements(Node node, Class<?> clazz) {
        NodeList elements = new NodeList();

        if (node.getNodeType() == Node.ELEMENT_NODE) {
            Element element = (Element) node;
            if (clazz.isInstance(element)) {
                elements.add(element);
            }
        } else if (node.getNodeType() == Node.TEXT_NODE) {
            String text = node.getNodeValue();
            if (clazz.equals(String.class) || clazz.isInstance(text)) {
                elements.add(text);
            }
        }

        return elements;
    }

    public static String asString(Node node, HashMap<String, Object> attributes) {
        // implementation of converting a DOM node to a string
    }
}
