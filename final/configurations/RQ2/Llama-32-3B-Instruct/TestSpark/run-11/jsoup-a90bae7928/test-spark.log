public class XmlTreeBuilderTest {

    @Test
    public void initialiseParse_GivenDefaultSettings_WhenReadFromInput() {
        // given
        XmlTreeBuilder builder = new XmlTreeBuilder();
        Reader input = new StringReader("<root><child/></root>");
        String baseUri = "http://example.com";

        // when
        builder.initialiseParse(input, baseUri, null);

        // then
        assertEquals(2, builder.defaultSettings().getNamespacePrefixes().size());
    }

    @Test
    public void initialiseParse_GivenInputWithEntity_WhenReadFromInput() {
        // given
        XmlTreeBuilder builder = new XmlTreeBuilder();
        Reader input = new StringReader("<root><child>&amp;</child></root>");
        String baseUri = "http://example.com";

        // when
        builder.initialiseParse(input, baseUri, null);

        // then
        Document document = builder.parse(input, baseUri);
        assertEquals("amp", document.body(0).children().get(1).data());
    }

    @Test
    public void parse_GivenDefaultSettings_WhenReadFromInput() {
        // given
        XmlTreeBuilder builder = new XmlTreeBuilder();
        Reader input = new StringReader("<root><child/></root>");
        String baseUri = "http://example.com";

        // when
        Document document = builder.parse(input, baseUri);

        // then
        assertEquals(1, document.children().size());
    }

