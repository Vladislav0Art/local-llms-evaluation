**CsvWriter Class**
```java
import java.io.FileWriter;
import java.io.IOException;

public class CsvWriter {
    private boolean initialized;

    public CsvWriter() {
        this.initialized = false;
    }

    public void init() throws DBAppException {
        if (!initialized) {
            // Initialize writer
            FileWriter fw = new FileWriter("data.csv");
            fw.write("Data,Value\n");
            initialized = true;
            return;
        }
        throw new DBAppException("Writer already initialized");
    }

    public void writeLine(String line) throws IOException, DBAppException {
        if (initialized) {
            // Write CSV logic
            writer = new FileWriter("data.csv", true);
            writer.write(line + "\n");
            writer.close();
            return;
        } else {
            throw new DBAppException("Writer not initialized");
        }
    }
}
```

**Usage Example**
```java
public class Main {
    public static void main(String[] args) throws DBAppException {
        DBApp dbApp = new DBApp();
        try {
            dbApp.init();
            System.out.println(dbApp.getReader().readLine());
            dbApp.getWriter().writeLine("Data,Value");
            dbApp.executeQuery("SELECT * FROM table_name;");
        } catch (DBAppException e) {
            System.out.println(e.getMessage());
        }
    }
}
```
