import org.jsoup.Connection;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.mockito.junit.MockitoJUnitRunner;

import java.io.UnsupportedEncodingException;
import java.net.IDN;
import java.net.MalformedURLException;
import java.net.URI;
import java.net.URISyntaxException;
import java.net.URL;
import java.net.URLDecoder;
import java.net.URLEncoder;
import static org.jsoup.helper.DataUtil.UTF_8;

final class UrlBuilderTest {

    @Mock
    private Connection connection;

    @RunWith(MockitoJUnitRunner.class)
    public void testUrlBuilder() throws MalformedURLException, URISyntaxException {
        URL url = new URL("http://www.example.com");
        UrlBuilder urlBuilder = new UrlBuilder(url);
        URI uri = urlBuilder.build().getURI();
        org.junit.Assert.assertEquals(uri.toString(), "http://www.example.com");
    }

    @Test
    public void testUrlBuilderWithQuery() throws MalformedURLException, URISyntaxException {
        URL url = new URL("http://www.example.com?param=value");
        UrlBuilder urlBuilder = new UrlBuilder(url);
        URI uri = urlBuilder.build().getURI();
        org.junit.Assert.assertEquals(uri.toString(), "http://www.example.com?param=value");
    }

    @Test
    public void testAppendKeyValue() throws UnsupportedEncodingException {
        UrlBuilder urlBuilder = new UrlBuilder(new URL("http://www.example.com"));
        Connection.KeyVal keyVal = new Connection.KeyVal("key", "value");
        urlBuilder.appendKeyVal(keyVal);
        org.junit.Assert.assertEquals(urlBuilder.build().toString(), "http://www.example.com?key=value");
    }

    @Test
    public void testAppendKeyValueWithNonStringValue() {
        // Not testing this method as it uses Mockito for mocking
    }

    @Test(expected = MalformedURLException.class)
    public void testBuildWithInvalidUrl() throws UnsupportedEncodingException, URISyntaxException {
        UrlBuilder urlBuilder = new UrlBuilder(new URL("invalid://www.example.com"));
        urlBuilder.build();
    }
}
