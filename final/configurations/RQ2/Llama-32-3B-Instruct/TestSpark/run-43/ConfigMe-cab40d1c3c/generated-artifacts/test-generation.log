public class PropertyListBuilder {
    private Map<String, Object> entries = new LinkedHashMap<>();

    public void add(String key, Object value) {
        entries.put(key, value);
    }

    public PropertyListBuilder create() {
        return this;
    }

    public List<MockProperty> getRootEntries() {
        List<MockProperty> rootEntries = new ArrayList<>();
        for (Map.Entry<String, Object> entry : entries.entrySet()) {
            MockProperty mockProperty = new MockProperty(entry.getKey(), entry.getValue());
            rootEntries.add(mockProperty);
        }
        return rootEntries;
    }

    public static void main(String[] args) {
        PropertyListBuilder propertyListBuilder = new PropertyListBuilder();
        propertyListBuilder.add("key1", "value1");
        propertyListBuilder.add("key2", "value2");

        List<MockProperty> mockProperties = propertyListBuilder.getRootEntries();

        assertEquals(2, mockProperties.size());
    }
}

