public class ListUtils {

    public static void assertListEquals(List<MockProperty> expected, List<MockProperty> actual) {
        assertEquals(expected.size(), actual.size());
        for (int i = 0; i < expected.size(); i++) {
            MockProperty mockProperty1 = expected.get(i);
            MockProperty mockProperty2 = actual.get(i);
            assertEquals(mockProperty1.getKey(), mockProperty2.getKey());
            assertEquals(mockProperty1.getValue(), mockProperty2.getValue());
        }
    }

    public static void main(String[] args) {
        List<MockProperty> expectedList = new ArrayList<>();
        expectedList.add(new MockProperty("key1", "value1"));
        expectedList.add(new MockProperty("key2", "value2"));

        List<MockProperty> actualList = new ArrayList<>();
        actualList.add(new MockProperty("key1", "value1"));
        actualList.add(new MockProperty("key2", "value2"));

        ListUtils.assertListEquals(expectedList, actualList);
    }
}

