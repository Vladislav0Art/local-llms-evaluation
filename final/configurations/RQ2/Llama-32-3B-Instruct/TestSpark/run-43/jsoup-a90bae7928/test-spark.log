import org.jsoup.helper.Validate;
import org.jsoup.nodes.CDataNode;
import org.jsoup.nodes.Comment;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.DocumentType;
import org.jsoup.nodes.Element;
import org.jsoup.nodes.Entities;
import org.jsoup.nodes.Node;
import org.jsoup.nodes.TextNode;
import org.jsoup.nodes.XmlDeclaration;
import org.jsoup.parser.Token;
import org.junit.Test;
import static org.junit.Assert.*;
import java.io.Reader;
import java.io.StringReader;
import java.util.List;

public class XmlTreeBuilderTest {

    @Test
    public void initialiseParse_GivenValidInput_ThenInitialize() {
        Reader input = new StringReader("<root><child/></root>");
        XmlTreeBuilder builder = new XmlTreeBuilder();
        builder.initialiseParse(input, "http://example.com", null);
    }

    @Test
    public void initialiseParse_GivenInvalidInput_ThenNotInitialize() {
        Reader input = new StringReader("<invalid xml>");
        XmlTreeBuilder builder = new XmlTreeBuilder();
        assertFalse(builder.initialised());
    }

    @Test
    public void parse_GivenValidXml_ThenParseCorrectly() {
        Reader input = new StringReader("<root><child/></root>");
        XmlTreeBuilder builder = new XmlTreeBuilder();
        Document document = builder.parse(input, "http://example.com");
        assertNotNull(document);
    }

    @Test
    public void parse_GivenInvalidXml_ThenThrowException() {
        Reader input = new StringReader("<invalid xml>");
        XmlTreeBuilder builder = new XmlTreeBuilder();
        try {
            builder.parse(input, "http://example.com");
            fail("Expected exception not thrown");
        } catch (Exception e) {
            assertNotNull(e);
        }
    }

    @Test
    public void newInstance_GivenValidSettings_ThenReturnInstance() {
        XmlTreeBuilder builder = new XmlTreeBuilder();
        XmlTreeBuilder instance = builder.newInstance();
        assertSame(builder, instance);
    }

    @Test
    public void process_TokenStartTag_GivenValidInput_ThenProcessCorrectly() {
        Token token = new Token(Token.StartTag, "<child></child>");
        XmlTreeBuilder builder = new XmlTreeBuilder();
        assertTrue(builder.process(token));
    }

    @Test
    public void insertNode_GivenNodeAndNoToken_GivenValidInput_ThenInsertCorrectly() {
        Node node = new CDataNode("text");
        XmlTreeBuilder builder = new XmlTreeBuilder();
        builder.insertNode(node);
    }

    @Test
    public void insertCharacter_GivenValidToken_GivenValidInput_ThenInsertCorrectly() {
        Token token = new Token(Token.Character, "&");
        XmlTreeBuilder builder = new XmlTreeBuilder();
        builder.insert(token);
    }

    @Test
    public void popStackToClose_GivenEndTag_GivenValidInput_ThenPopStackCorrectly() {
        Token endTag = new Token(Token.EndTag, "</child>");
        XmlTreeBuilder builder = new XmlTreeBuilder();
        builder.popStackToClose(endTag);
    }

    @Test
    public void parseFragment_GivenValidInput_ThenParseCorrectly() {
        Reader input = new StringReader("<root><child/></root>");
        List<Node> nodes = new XmlTreeBuilder().parseFragment(input, "http://example.com", null);
        assertNotNull(nodes);
    }
}
