import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;

import java.io.BufferedReader;
import java.io.File;
import java.io.FileInputStream;
import java.io.FileNotFoundException;
import java.io.IOException;
import java.io.InputStreamReader;
import java.nio.charset.Charset;
import java.util.ArrayList;
import java.util.HashSet;
import java.util.List;
import java.util.Set;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertFalse;
import static org.junit.Assert.assertTrue;
import static org.mockito.Mockito.when;

@RunWith(MockitoJUnitRunner.class)
public class WordWrapTest {

    @Mock
    private Reader reader;

    @Mock
    private Writer writer;

    @Test
    public void fromReaderShouldReturnBuilder() {
        // Arrange
        Preconditions.checkState(reader != null);

        // Act
        WordWrap.Builder builder = WordWrap.from(reader);

        // Assert
        assertEquals(builder, WordWrap.Builder.class);
    }

    @Test
    public void fromClasspathUtf8ShouldReturnBuilder() {
        // Arrange
        Preconditions.checkState(reader == null);

        // Act
        WordWrap.Builder builder = WordWrap.fromClasspathUtf8("resource");

        // Assert
        assertNotNull(builder);
    }

    @Test
    public void fromReader_shouldCloseReader() {
        // Arrange
        Preconditions.checkState(reader != null);

        // Act
        WordWrap.Builder builder = WordWrap.from(reader, true);

        // Assert
        when(reader.close()).thenReturn(true);
    }

    @Test
    public void closeShouldCloseReader() {
        // Arrange
        Reader reader = Mockito.mock(Reader.class);
        Preconditions.checkState(reader != null);

        // Act
        WordWrap.close(reader);

        // Assert
        verify(reader, times(1)).close();
    }

    @Test
    public void wordWrapShouldWriteWrappedText() throws IOException {
        // Arrange
        Preconditions.checkState(writer != null);

        when(stringWidth.apply("hello world")).thenReturn(13L);
        Set<Character> extraWordChars = new HashSet<>();
        boolean insertHyphens = false;
        boolean breakWords = true;

        // Act
        WordWrap.wordWrap(reader, writer, "\n", 80, stringWidth, extraWordChars, insertHyphens, breakWords);

        // Assert
        assertEquals("hello\nworld", rightTrim(writer.toString()));
    }

    @Test
    public void wordWrapShouldNotWriteWrappedText() throws IOException {
        // Arrange
        Preconditions.checkState(writer != null);

        when(stringWidth.apply("hello world")).thenReturn(13L);
        Set<Character> extraWordChars = new HashSet<>();
        boolean insertHyphens = false;
        boolean breakWords = true;

        // Act
        WordWrap.wordWrap(reader, writer, "\n", 80, stringWidth, extraWordChars, insertHyphens, breakWords);

        // Assert
        assertEquals("hello world", writer.toString());
    }

    @Test
    public void isWhitespaceShouldReturnTrueForSpaces() {
        Preconditions.checkState(writer == null);
        assertTrue(WordWrap.isWhitespace("\n"));
    }

    @Test
    public void isWhitespaceShouldReturnFalseForNonSpaces() {
        Preconditions.checkState(writer == null);
        assertFalse(WordWrap.isWhitespace("hello"));
    }

    @Test
    public void leftTrimShouldRemoveLeadingWhitespaces() {
        Preconditions.checkState(writer == null);

        // Act
        WordWrap.leftTrim(new StringBuilder2("   hello world"));

        // Assert
        assertEquals("hello world", writer.toString());
    }
}
