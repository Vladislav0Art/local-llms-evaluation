        // Assert
        assertEquals(builder, WordWrap.Builder.class);
    }

    @Test
    public void fromClasspathUtf8ShouldReturnBuilder() {
        // Arrange
        Preconditions.checkState(bufferedReader == null);

        // Act
        WordWrap.Builder builder = WordWrap.fromClasspathUtf8("resource");

        // Assert
        assertNotNull(builder);
    }

    @Test
    public void fromReader_shouldCloseReader() {
        // Arrange
        Preconditions.checkState(bufferedReader != null);

        // Act
        WordWrap.Builder builder = WordWrap.from(bufferedReader, true);

        // Assert
        when(bufferedReader.close()).thenReturn(true);
    }

    @Test
    public void closeShouldCloseReader() {
        // Arrange
        BufferedReader bufferedReader = Mockito.mock(BufferedReader.class);
        Preconditions.checkState(bufferedReader != null);

        // Act
        WordWrap.close(bufferedReader);

        // Assert
        verify(bufferedReader, times(1)).close();
    }

    @Test
    public void wordWrapShouldWriteWrappedText() throws IOException {
        // Arrange
        Preconditions.checkState(writer != null);

        when(stringWidth.apply("hello world")).thenReturn(13L);
        Set<Character> extraWordChars = new HashSet<>();
        boolean insertHyphens = false;
        boolean breakWords = true;

        // Act
        WordWrap.wordWrap(bufferedReader, writer, "\n", 80, stringWidth, extraWordChars, insertHyphens, breakWords);

        // Assert
        assertEquals("hello\nworld", rightTrim(writer.toString()));
    }

    @Test
    public void wordWrapShouldNotWriteWrappedText() throws IOException {
        // Arrange
        Preconditions.checkState(writer != null);

        when(stringWidth.apply("hello world")).thenReturn(13L);
        Set<Character> extraWordChars = new HashSet<>();
        boolean insertHyphens = false;
        boolean breakWords = true;

        // Act
        WordWrap.wordWrap(bufferedReader, writer, "\n", 80, stringWidth, extraWordChars, insertHyphens, breakWords);

        // Assert
        assertEquals("hello world", writer.toString());
    }

    @Test
    public void isWhitespaceShouldReturnTrueForSpaces() {
