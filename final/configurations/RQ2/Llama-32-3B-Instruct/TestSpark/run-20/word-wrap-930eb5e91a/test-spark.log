        assertTrue(WordWrap.isWhitespace("\n"));
    }

    @Test
    public void isWhitespaceShouldReturnFalseForNonSpaces() {
        Preconditions.checkState(writer == null);
        assertFalse(WordWrap.isWhitespace("hello"));
    }

    @Test
    public void leftTrimShouldRemoveLeadingWhitespaces() {
        Preconditions.checkState(writer == null);

        // Act
        WordWrap.leftTrim(new StringBuilder2("   hello world"));

