import org.junit.Test;
import static org.junit.Assert.*;
import org.jsoup.helper.Validate;
import org.jsoup.internal.Normalizer;

public class TagTest {

    @Test
    public void getName_EmptyStringReturnsEmptyString() {
        assertTrue(Tag.getName("").isEmpty());
    }

    @Test
    public void getName_NullStringThrowsNullPointerException() {
        assertThrows(NullPointerException.class, () -> Tag.getName(null));
    }

    @Test
    public void normalName_EmptyStringReturnsEmptyString() {
        assertEquals("", Tag.normalName(""));
    }

    @Test
    public void normalName_NullStringThrowsNullPointerException() {
        assertThrows(NullPointerException.class, () -> Tag.normalName(null));
    }

    @Test
    public void valueOf_EmptyStringReturnsNullTag() {
        assertNull(Tag.valueOf(""));
    }

    @Test
    public void valueOf_NullStringReturnsNullTag() {
        assertNull(Tag.valueOf(null));
    }

    @Test
    public void isBlock_TagWithBlockAttributeReturnsTrue() {
        assertTrue(Tag.isBlock("div"));
    }

    @Test
    public void isBlock_TagWithoutBlockAttributeReturnsFalse() {
        assertFalse(Tag.isBlock("p"));
    }

    @Test
    public void formatAsBlock TagWithBlockAttributeReturnsTrue() {
        assertTrue(Tag.formatAsBlock("div"));
    }

    @Test
    public void formatAsBlock_TagWithoutBlockAttributeReturnsFalse() {
        assertFalse(Tag.formatAsBlock("p"));
    }

    @Test
    public void isInline_TagWithInlineAttributeReturnsTrue() {
        assertTrue(Tag.isInline("span"));
    }

    @Test
    public void isInline_TagWithoutInlineAttributeReturnsFalse() {
        assertFalse(Tag.isInline("div"));
    }

    @Test
    public void isEmpty_EmptyTagReturnsTrue() {
        assertTrue(Tag.isEmpty(""));
    }

    @Test
    public void isEmpty_TagWithNoAttributesOrChildNodesReturnsTrue() {
        assertTrue(Tag.isEmpty("<tag>"));
    }

    @Test
    public void isEmpty_TagWithAttributesButNoChildNodesReturnsFalse() {
        assertFalse(Tag.isEmpty("<tag attr>"));
    }

    @Test
    public void isSelfClosing_TagWithSelfClosingAttributeReturnsTrue() {
        assertTrue(Tag.isSelfClosing("img"));
    }

    @Test
    public void isSelfClosing TAGWithoutSelfClosingAttributeReturnsFalse() {
        assertFalse(Tag.isSelfClosing("p"));
    }

    @Test
    public void isKnownTag_TagNameMatchesKnownTagName() {
        assertTrue(Tag.isKnownTag("div"));
    }

    @Test
    public void isKnownTag_NullStringDoesNotMatchAnyKnownTag() {
        assertFalse(Tag.isKnownTag(null));
    }

    @Test
    public void preserveWhitespace_TagWithPreserveWhitespaceAttributeReturnsTrue() {
        assertTrue(Tag.preserveWhitespace("img"));
    }

    @Test
    public void preserveWhitespace_TagWithoutPreserveWhitespaceAttributeReturnsFalse() {
        assertFalse(Tag.preserveWhitespace("p"));
    }

    @Test
    public void isFormListed_TagWithNameAttrFormAttributesReturnsTrue() {
        assertTrue(Tag.isFormListed("<form><tag>"));
    }

    @Test
    public void isFormSubmittable_EmptyTagDoesNotReturnTrue() {
        assertFalse(Tag.isFormSubmittable(""));
    }

    @Test
    public void isFormSubmittable TAGWithoutFormAttributesReturnsFalse() {
        assertFalse(Tag.isFormSubmittable("<tag>"));
    }

    @Test
    public void setSelfClosing_TagWithSetSelfClosingMethodReturnsTrue() {
        Tag tag = new Tag();
        assertTrue(tag.setSelfClosing());
    }

    @Test
    public void setSelfClosing TAGWithoutSetSelfClosingMethodReturnsFalse() {
        Tag tag = new Tag();
        assertFalse(tag.setSelfClosing());
    }
}
