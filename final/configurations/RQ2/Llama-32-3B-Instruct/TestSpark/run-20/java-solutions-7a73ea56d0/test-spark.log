public class OnlineStockSpan {

    private int[] stack;

    public OnlineStockSpan() {
        stack = new int[0];
    }

    public void add(int num, int inc) {
        while (!stack.isEmpty() && stack.get(stack.size() - 1) >= num) {
            int count = stack.pop();
            stack[count] += inc;
        }
        stack = addElement(stack, num, inc);
    }

    private int[] addElement(int[] array, int num, int inc) {
        int[] newArray = new int[array.length + 1];
        System.arraycopy(array, 0, newArray, 0, array.length);
        newArray[array.length] = num;
        return newArray;
    }

    public int get() {
        return stack[0];
    }
}

