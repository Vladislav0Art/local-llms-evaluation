import static org.junit.jupiter.api.Assertions.assertEquals;

public class GrammarTest {

    @Test
    public void testGetTerms() {
        // Arrange
        Map<String, String> termsMap = new HashMap<>();
        termsMap.put("term1", "definition1");
        termsMap.put("term2", "definition2");

        // Act
        List<String> expectedTerms = new ArrayList<>(termsMap.keySet());
        assertEquals(expectedTerms, Grammar.getTerms(termsMap));

    }

    @Test
    public void testGetDefinitions() {
        // Arrange
        Map<String, String> termsMap = new HashMap<>();
        termsMap.put("term1", "definition1");
        termsMap.put("term2", "definition2");

        // Act
        List<String> expectedDefinitions = new ArrayList<>(termsMap.values());
        assertEquals(expectedDefinitions, Grammar.getDefinitions(termsMap));
    }
}

public class Grammar {

    public static List<String> getTerms(Map<String, String> termsMap) {
        return new ArrayList<>(termsMap.keySet());
    }

    public static List<String> getDefinitions(Map<String, String> termsMap) {
        return new ArrayList<>(termsMap.values());
    }
}
