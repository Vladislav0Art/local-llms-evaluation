    }

    @Test
    public void testRemoveTags() {
        Safelist safelist = new Safelist();
        safelist.addTags("tag1", "tag2");
        safelist.removeTags("tag1");
        assertFalse(safelist.isSafeTag("tag1"));
    }
}

