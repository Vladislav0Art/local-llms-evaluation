```java
import java.util.HashMap;
import java.util.Map;

// Represents a constant value in an expression
class Constant implements Expr {
    private double value;

    public Constant(double value) {
        this.value = value;
    }

    @Override
    public String toString() {
        return String.valueOf(value);
    }
}

// Represents a variable in an expression
class Var implements Expr {
    private String name;

    public Var(String name) {
        this.name = name;
    }

    @Override
    public String toString() {
        return "Var{" + name + "}";
    }
}

// Represents a binary operation (e.g. addition, subtraction)
abstract class BinaryOp implements Expr {
    protected Expr left, right;

    public BinaryOp(Expr left, Expr right) {
        this.left = left;
        this.right = right;
    }

    @Override
    public String toString() {
        throw new UnsupportedOperationException("Not implemented yet");
    }
}

// Adds two expressions together
class Add implements BinaryOp {
    public Add(Expr left, Expr right) {
        super(left, right);
    }

    @Override
    public String toString() {
        return "(" + left + " + " + right + ")";
    }
}

// Subtracts one expression from another
class Sub implements BinaryOp {
    public Sub(Expr left, Expr right) {
        super(left, right);
    }

    @Override
    public String toString() {
        return "(" + left + " - " + right + ")";
    }
}

// Multiplies two expressions together
class Mul implements BinaryOp {
    public Mul(Expr left, Expr right) {
        super(left, right);
    }

    @Override
    public String toString() {
        return "(" + left + " * " + right + ")";
    }
}

// Divides one expression by another
class Div implements BinaryOp {
    public Div(Expr left, Expr right) {
        super(left, right);
    }

    @Override
    public String toString() {
        return "(" + left + " / " + right + ")";
    }
}

// Represents a variable in an expression
class VarExpr implements Expr {
    private String name;

    public VarExpr(String name) {
        this.name = name;
    }

    @Override
    public String toString() {
        return "Var{" + name + "}";
    }
}

public class ExprUtil {
