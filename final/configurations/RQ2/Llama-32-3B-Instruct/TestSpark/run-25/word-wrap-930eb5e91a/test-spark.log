package org.davidmoten.text.utils;

import com.github.davidmoten.guavamini.Preconditions;
import com.github.davidmoten.guavamini.annotations.VisibleForTesting;
import org.junit.Test;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.mockito.junit.MockitoJUnitRunner;

import java.io.BufferedReader;
import java.io.File;
import java.io.FileInputStream;
import java.io.FileNotFoundException;
import java.io.IOException;
import java.io.InputStreamReader;
import java.nio.charset.Charset;
import java.util.List;
import java.util.Set;
import java.util.function.Function;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertFalse;
import static org.junit.Assert.assertTrue;
import static org.mockito.Mockito.when;

@RunWith(MockitoJUnitRunner.class)
public class WordWrapTest {

    @Mock
    private BufferedReader bufferedReader;

    @Mock
    private Writer writer;

    @Mock
    private LineConsumer lineConsumer;

    private WordWrap wordWrap = new WordWrap();

    @Test
    public void fromReaderReturnsBuilder() {
        Preconditions.checkState(wordWrap.from(bufferedReader) instanceof WordWrap.Builder);
    }

    @Test
    public void fromClasspathUtf8ReturnsBuilder() {
        Preconditions.checkState(wordWrap.fromClasspathUtf8("resource") instanceof WordWrap.Builder);
    }

    @Test
    public void fromClasspathReturnsBuilder() {
        Preconditions.checkState(wordWrap.fromClasspath("resource", StandardCharsets.UTF_8) instanceof WordWrap.Builder);
    }

    @Test
    public void fromCharSequenceReturnsBuilder() {
        Preconditions.checkState(wordWrap.from("text") instanceof WordWrap.Builder);
    }

    @Test
    public void fromUtf8InputStreamReturnsBuilder() {
        Preconditions.checkState(wordWrap.fromUtf8(new FileInputStream("resource")) instanceof WordWrap.Builder);
    }

    @Test
    public void fromInputStreamCharsetReturnsBuilder() {
        Preconditions.checkState(wordWrap.from(new FileInputStream("resource"), StandardCharsets.UTF_8) instanceof WordWrap.Builder);
    }

    @Test
    public void fromFileCharsetReturnsBuilder() {
        Preconditions.checkState(wordWrap.from(new File("resource"), StandardCharsets.UTF_8) instanceof WordWrap.Builder);
    }

    @VisibleForTesting
    @Test
    public void fromReaderClose() {
        wordWrap.close(bufferedReader);
        // verify close method called once
    }

    @VisibleForTesting
    @Test
    public void rightTrimReturnsStringWithLeadingWhitespaceRemoved() {
        assertEquals("text", wordWrap.rightTrim(" text "));
    }

    @VisibleForTesting
    @Test
    public void isWhitespaceReturnsTrueForEmptyString() {
        assertTrue(wordWrap.isWhitespace(""));
    }

    @VisibleForTesting
    @Test
    public void isWhitespaceReturnsFalseForNonEmptyString() {
        assertFalse(wordWrap.isWhitespace("text"));
    }
}
