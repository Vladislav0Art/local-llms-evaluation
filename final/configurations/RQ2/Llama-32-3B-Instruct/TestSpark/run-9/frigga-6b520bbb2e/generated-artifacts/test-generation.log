public class NameConstants {
    public static final String APP_VERSION_PACKAGE = "com.netflix.frigga.ami";
}

public class GeneratedTest {

    @org.junit.Test
    public void testParsedAppVersion() throws Exception {
        AppVersion appVersion1 = new AppVersion("1.2.3");
        assertEquals("1.2.3", appVersion1.getVersion());
        assertNull(appVersion1.getCommit());

        AppVersion appVersion2 = new AppVersion("4.5.6");
        assertTrue(appVersion1.compareTo(appVersion2) < 0);
    }

    @org.junit.Test
    public void testGetPackageName() throws Exception {
        AppVersion appVersion = new AppVersion("1.2.3");
        assertEquals(NameConstants.APP_VERSION_PACKAGE, appVersion.getPackageName());
    }
}

public class AppVersionComparator implements Comparator<AppVersion> {

    @Override
    public int compare(AppVersion o1, AppVersion o2) {
        return Integer.compare(o1.getVersion().compareTo(o2.getVersion()), 
                              (o1.getCommit() == null ? 0 : 1)
                              + (o2.getCommit() == null ? 0 : 1));
    }
}

