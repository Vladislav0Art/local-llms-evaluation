import java.util.*;

public class Main {
    public static void main(String[] args) {
        // Test 1: Using HashMap with ArrayList
        System.out.println("Test 1:");
        Map<String, List<String>> map = new HashMap<>();
        map.put("test", Arrays.asList("line1"));
        System.out.println(map);

        // Test 2: Using HashMap with another HashMap
        System.out.println("\nTest 2:");
        Map<String, Map<String, String>> map2 = new HashMap<>();
        Map<String, String> innerMap = new HashMap<>();
        innerMap.put("test1", "value1");
        map2.put("test", innerMap);
        System.out.println(map2);

        // Test 3: Using ArrayList
        System.out.println("\nTest 3:");
        List<String> list = Arrays.asList("line3");
        System.out.println(list);

        // Test 4: Using HashMap with ArrayList (similar to test 1)
        System.out.println("\nTest 4:");
        Map<String, List<String>> map3 = new HashMap<>();
        List<String> list2 = Arrays.asList("line4");
        map3.put("test2", list2);
        System.out.println(map3);

        // Test 5: Using HashMap and printing JSON
        System.out.println("\nTest 5:");
        Map<String, String> map4 = new HashMap<>();
        map4.put("test3", "value3");
        Map<String, String> map5 = new HashMap<>();
        map5.put("test4", "value4");
        System.out.println(JSON.toJSONString(map4));
        System.out.println(JSON.toJSONString(map5));
    }
}
```
