```java
public class Main {

    @Test
    public void testConnection() {
        String url = "https://www.example.com";
        Connection connection = HttpConnection.connect(url);
        assertEquals(url, connection.getUrl());
    }

    @Test
    public void testProxy() {
        String host = "localhost";
        int port = 8080;
        Connection connection = HttpConnection.proxy(host, port);
        assertEquals(host + ":" + Integer.toString(port), connection.getProxy());
    }

    @Test
    public void testUserAgent() {
        String userAgent = "Mozilla/5.0";
        Connection connection = HttpConnection.setUserAgent(userAgent);
        assertEquals(userAgent, connection.getUserAgent());
    }
}
