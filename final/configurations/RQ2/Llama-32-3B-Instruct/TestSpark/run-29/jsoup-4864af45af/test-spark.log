            }
        }
        return true;
    }

    public boolean isSafeAttribute(String attr, String value, Attribute a) {
        if (!enforcedAttributes.containsKey(attr)) {
            return true;
        }
        for (Rule rule : rules) {
            if (rule.apply(null)) {
                return false;
            }
        }
        return true;
    }

