        assertEquals("x.y\n", collectingPrinter.toString());
    }

    @Test
    public void visitAnonymousScriptExprPrintsCorrectly() {
        setup();
        PrettyPrintVisitor visitor = new PrettyPrintVisitor(printer);
        visitor.visitAnonymousScriptExpr(new AnonymousScript("x + 5", "x"));
        assertEquals("x + 5\n", collectingPrinter.toString());
    }

    @Test
    public void visitFunctionScriptExprPrintsCorrectly() {
        setup();
        PrettyPrintVisitor visitor = new PrettyPrintVisitor(printer);
        visitor.visitFunctionScriptExpr(new FunctionScript("add", "x", 5));
        assertEquals("add x 5\n", collectingPrinter.toString());
    }

    @Test
    public void visitStatementSequenceScriptPrintsCorrectly() {
        setup();
        PrettyPrintVisitor visitor = new PrettyPrintVisitor(printer);
