import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertThrows;

public class PropertyListBuilderTest {

    @Test
    public void testAddProperty() {
        PropertyListBuilder builder = new PropertyListBuilder();
        Property property = new Property("name", "value");
        builder.add(property);
        // Assert that the list contains one property with name and value
    }

    @Test
    public void testAddMultipleProperties() {
        PropertyListBuilder builder = new PropertyListBuilder();
        Property property1 = new Property("name1", "value1");
        Property property2 = new Property("name2", "value2");
        builder.add(property1);
        builder.add(property2);
        // Assert that the list contains two properties with names and values
    }

    @Test
    public void testAddNullProperty() {
        PropertyListBuilder builder = new PropertyListBuilder();
        assertThrows(ConfigMeException.class, () -> builder.add(null));
    }

    @Test
    public void testCreateList() {
        PropertyListBuilder builder = new PropertyListBuilder();
        builder.add(new Property("name", "value"));
        // Assert that the list is not empty
    }
}

public class ConfigMeException extends RuntimeException {}

public class PropertyListBuilder {

    private java.util.List<Property> properties = new java.util.ArrayList<>();

    public void add(Property property) {
        if (property == null) {
            throw new ConfigMeException();
        }
        properties.add(property);
    }

    // Add a public method to create the list
    public java.util.List<Property> getProperties() {
        return properties;
    }
}

public class Property {

    private String name;
    private String value;

    public Property(String name, String value) {
        this.name = name;
        this.value = value;
    }

    // Add public getters for name and value
    public String getName() {
        return name;
    }

    public String getValue() {
        return value;
    }
}
