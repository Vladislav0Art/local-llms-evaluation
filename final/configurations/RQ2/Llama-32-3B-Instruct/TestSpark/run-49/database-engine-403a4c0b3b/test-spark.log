        // Create a table with columns 'id', 'name', and 'age'
        Table table = new Table();
        table.addColumn("id", ColumnType.Int);
        table.addColumn("name", ColumnType.String);
        table.addColumn("age", ColumnType.Int);

        // Insert data into the table
        List<User> users = new ArrayList<>();
        users.add(new User(1, "John Doe", 30));
        users.add(new User(2, "Jane Doe", 25));

        // Execute a SQL query to select all data from the 'name' column
        String result = SQLQuery.query(table, "SELECT name FROM users");

        return result;
    }
}

class User {
    int id;
    String name;
    int age;

    public User(int id, String name, int age) {
        this.id = id;
        this.name = name;
        this.age = age;
    }
}

public class Table {
    private List<Column> columns;

    public void addColumn(String name, ColumnType type) {
        columns.add(new Column(name, type));
    }

    public Column[] getColumns() {
        return columns.toArray(new Column[0]);
    }
}

public class SQLQuery {
    public static String query(Table table, String query) throws Exception {
        // Connect to the database
        Connection conn = DriverManager.getConnection("jdbc:sqlite:example.db");

        // Create a statement object
        Statement stmt = conn.createStatement();

        // Parse and execute the query
        try (ResultSet result = stmt.executeQuery(query)) {
            StringBuilder sb = new StringBuilder();
            while (result.next()) {
                sb.append(result.getString(1));
                if (sb.length() > 0) sb.append(", ");
            }
            return sb.toString();
        } finally {
            // Close resources
            result.close();
            stmt.close();
            conn.close();
        }
    }

    public enum ColumnType {
        Int,
        String
    }
}
