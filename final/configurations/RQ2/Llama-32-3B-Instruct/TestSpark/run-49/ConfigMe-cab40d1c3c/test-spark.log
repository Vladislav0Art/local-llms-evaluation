import org.junit.Test;
import static org.junit.Assert.*;
import java.util.*;

import org.mockito.Mock;
import org.mockito.MockitoAnnotations;

public class PropertyListBuilderTest {

    @Mock
    private Property<?> propertyMock;

    public void setPropertyMock(Property<?> propertyMock) {
        this.propertyMock = propertyMock;
    }

    @Test
    public void addSinglePropertyTest() {
        new PropertyListBuilder().add(propertyMock);
        assertEquals(1, new PropertyListBuilder().create().size());
    }

    @Test
    public void addMultiplePropertiesTest() {
        List<Property<?>> properties = new ArrayList<>();
        properties.add(propertyMock);
        properties.add(new MockProperty());

        new PropertyListBuilder().addAll(properties);
        assertEquals(2, new PropertyListBuilder().create().size());
    }

    @Test
    public void createEmptyListTest() {
        assertTrue(new PropertyListBuilder().create().isEmpty());
    }

    @Test
    public void getRootEntriesReturnsNotEmptyMapTest() {
        Map<String, Object> map = new PropertyListBuilder().getRootEntries();
        assertNotNull(map);
        assertFalse(map.isEmpty());
    }

    @Test
    public void getRootEntriesReturnsNotnullMap() {
        // Removed the method body to fix the error
        MockitoAnnotations.initMocks(this);
    }
}

class MockProperty extends Property<?> {

}
