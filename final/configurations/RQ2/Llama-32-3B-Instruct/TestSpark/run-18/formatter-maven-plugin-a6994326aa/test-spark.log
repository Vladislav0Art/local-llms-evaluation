import javax.xml.transform.TransformerException;
import javax.xml.transform.TransformerFactory;

import com.steadystate.css.format.CSSFormat;

public class CssFormatterTest {

    @Test
    public void init_MockConfigurationSource_InitsFormatter() throws Exception {
        final Map<String, String> options = new HashMap<>();
        options.put("option", "value");
        
        final ConfigurationSource mockCfg = mock(ConfigurationSource.class);
        when(mockCfg.getOptions()).thenReturn(options);

        final CssFormatter formatter = new CssFormatter();
        formatter.init(options, mockCfg);
        assertNotNull(formatter);
    }

    @Test
    public void doFormat_ValidCode_ReturnsFormattedCss() throws Exception {
        final String code = "body { background-color: #fff; }";
        
        final CssFormatter formatter = new CssFormatter();

        final String formattedCss = formatter.doFormat(code, LineEnding.LF);
        assertNotNull(formattedCss);
        assertTrue(formattedCss.contains("background-color"));
    }

    @Test
    public void doFormat_InvalidCode_ThrowsIOException() throws Exception {
        final String code = "invalid";

        final CssFormatter formatter = new CssFormatter();

        final IOException exception = expectThrowingException(formatter.doFormat, code);
        assertNotNull(exception);
    }

    @Test
    public void isInitialized_InitMethodCalled_ReturnsTrue() throws Exception {
        final Map<String, String> options = new HashMap<>();
        options.put("option", "value");
        
        final ConfigurationSource mockCfg = mock(ConfigurationSource.class);
        when(mockCfg.getOptions()).thenReturn(options);

        final CssFormatter formatter = new CssFormatter();
        formatMethodCall(formatter.init, options, mockCfg);

        assertTrue(formatter.isInitialized());
    }

    private void formatMethodCall(final Method method, final Object... args) throws Exception {
        final Object[] originalArgs = method.invoke(null);
        method.invoke(method, args[0], args[1]);
        assertNotNull(originalArgs);
    }
}

class CssFormatter extends AbstractCacheableFormatter implements Formatter {

    @Override
    public void init(Map<String, String> options, ConfigurationSource cfg) { /* implementation */ }

    @Override
    protected String doFormat(String code, LineEnding ending) throws IOException { /* implementation */ }

    @Override
    public boolean isInitialized() { /* implementation */ }
}

