package net.e175.klaus.solarpositioning;

import org.junit.Test;
import static org.junit.Assert.assertEquals;

public class DeltaTEst {
 
    @Test
    public void estimateEmptyDateTest() {
        assertEquals(-9999999, DeltaT.estimate(null));
    }

    @Test
    public void estimateInvalidDateTest() {
        LocalDate date = null;
        Date invalidDate = null;
        double deltaT = 0.0;
        when(DeltaT.class).method().withArguments(date, invalidDate).thenThrow(NullPointerException.class);
    }

    @Test
    public void estimateSameDateTest() {
        LocalDate forDate = LocalDate.now();
        DeltaT.estimate(forDate); // no result expected
    }
 
    @Test(expected = IllegalArgumentException.class)
    public void estimateNegativeDaysTest() {
        when(DeltaT.class).method().withArguments(LocalDate.of(1, 1, 1), -10.0);
    }

    @Test
    public void estimatePositiveDaysTest() {
        LocalDate forDate = LocalDate.of(1, 1, 1);
        double deltaT = DeltaT.estimate(forDate); 
        assertEquals(-1.221399e+08, deltaT);
    }
}

