import org.junit.Test;
import static org.junit.Assert.*;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;

import java.util.ArrayList;
import java.util.List;

import com.ezylang.evalex.config.ExpressionConfiguration;
import com.ezylang.evalex.config.FunctionDictionaryIfc;
import com.ezylang.evalex.config.OperatorDictionaryIfc;
import com.ezylang.evalex.functions.FunctionIfc;
import com.ezylang	evalex.operators.OperatorIfc;
import java.util.Arrays;

@RunWith(org.junit.runners.JUnit4.class)
public class TokenizerTest {

    @Mock
    private ExpressionConfiguration expressionConfiguration;

    public List<Token> parseList() {
        return new ArrayList<>();
    }

    @Test
    public void parseStringLiteral_WithSingleQuote_ReturnsStringLiteralToken() throws ParseException {
        Token result = tokenizer.parseStringLiteral();
        assertNotNull(result);
        assertEquals(STR, result.getType());
    }

    @Test
    public void parseStringLiteral_WithoutQuotes_ReturnsParseException() throws ParseException {
        tokenizationResult = new Token("hello");
        assertionExceptionIsParseException(tokenizer.parseStringLiteral());
    }

    private static Token tokenizationResult;

    private static class ParseException extends Exception { /* implementation */ };

    private static class Token {
        TokenType type;
        String value;

        public Token(String value) {
            this.value = value;
        }
    }

    @Test
    public void parse_WithEmptyExpression_ReturnsParseException() throws ParseException {
        assertionExceptionIsParseException(tokenizer.parse());
    }

    private static void assertionExceptionIsParseException(ParseException exception) {
        assertTrue(exception instanceof ParseException);
    }
}
