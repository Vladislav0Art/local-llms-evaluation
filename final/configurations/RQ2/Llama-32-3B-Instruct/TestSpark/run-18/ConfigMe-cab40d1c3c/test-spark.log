    @Test
    public void testCreate() {
        Config config = new Config();
        assertEquals(0, config.getRootEntries().size());
    }

    @Test
    public void testAddEntry() {
        Config config = new Config();
        Map<String, Object> map = new HashMap<>();
        String key1 = "key1";
        String value1 = "value1";
        map.put(key1, value1);
        config.getRootEntries().put("key1", value1);
        assertEquals(1, config.getRootEntries().size());
    }

    @Test
    public void testGetEntry() {
        Config config = new Config();
        Map<String, Object> map = new HashMap<>();
        String key1 = "key1";
        String value1 = "value1";
        map.put(key1, value1);
        config.getRootEntries().put("key1", value1);
        assertEquals(value1, config.getRootEntries().get("key1"));
    }

    @Test
    public void testRemoveEntry() {
        Config config = new Config();
        Map<String, Object> map = new HashMap<>();
        String key1 = "key1";
        String value1 = "value1";
        map.put(key1, value1);
        config.getRootEntries().put("key1", value1);
        config.getRootEntries().remove("key1");
        assertEquals(0, config.getRootEntries().size());
    }
}

class Config {
    private Map<String, Object> rootEntries = new LinkedHashMap<>();

    public Map<String, Object> getRootEntries() {
        return rootEntries;
    }

    public void addEntry(String key, String value) {
        rootEntries.put(key, value);
    }

    public Object getEntry(String key) {
        return rootEntries.get(key);
    }

    public void removeEntry(String key) {
        rootEntries.remove(key);
    }
}
