        when(connection.getHost()).thenReturn("example.com");

        URL outputUrl = urlBuilder.build();
        assertEquals(inputUrl, outputUrl);
    }

    @Test
    public void buildUrl_WithoutHost() throws MalformedURLException {
        URL inputUrl = new URL("/path/to/resource");
        when(connection.getScheme()).thenReturn("");
        when(connection.getPath()).thenReturn("path/to/resource");

        URL outputUrl = urlBuilder.build();
        assertEquals(inputUrl, outputUrl);
    }

    @Test
    public void appendKeyVal_WithValidKeyAndValue() throws UnsupportedEncodingException {
        KeyVal kv = new KeyVal("key", "value");
        when(connection.getKey()).thenReturn(kv.getKey());
        when(connection.getValue()).thenReturn(kv.getValue());

        urlBuilder.appendKeyVal(kv);
        assertTrue(StringUtil.isEncodedKvPair(kv.getKey(), kv.getValue()));
    }

    @Test
    public void appendKeyVal_WithInvalidKey() throws UnsupportedEncodingException {
        KeyVal kv = new KeyVal("key", "value");
        when(connection.getKey()).thenReturn(null);

        try {
            urlBuilder.appendKeyVal(kv);
            assert false;
        } catch (UnsupportedEncodingException e) {
            // expected
        }
    }

    @Test
    public void appendKeyVal_WithInvalidValue() throws UnsupportedEncodingException {
        KeyVal kv = new KeyVal("key", "value");
        when(connection.getValue()).thenReturn(null);

        try {
            urlBuilder.appendKeyVal(kv);
            assert false;
        } catch (UnsupportedEncodingException e) {
            // expected
        }
    }

    @Test
    public void appendKeyVal_WithNullKeyValue() throws UnsupportedEncodingException {
        KeyVal kv = new KeyVal("key", null);
        when(connection.getKey()).thenReturn(kv.getKey());
        when(connection.getValue()).thenReturn(kv.getValue());

        urlBuilder.appendKeyVal(kv);
        assertNull(StringUtil.getEncodedKvPair(kv.getKey(), kv.getValue()));
    }

}
