public interface Expression {
    Object accept(Visitor v);
}

public abstract class Node implements Expression {
    public abstract String expression();
}

public class Number implements Node {
    private int value;

    public Number(int value) {
        this.value = value;
    }

    @Override
    public String expression() {
        return Integer.toString(value);
    }
}

public class BinaryExpression implements Node {
    protected Node left;
    protected Node right;
    protected char operator;

    public BinaryExpression(Node left, Node right, char operator) {
        this.left = left;
        this.right = right;
        this.operator = operator;
    }

    @Override
    public String expression() {
        return "(" + left.expression() + " " + operator + " " + right.expression() + ")";
    }
}

public class LiteralExpression implements Node {
    private int value;

    public LiteralExpression(int value) {
        this.value = value;
    }

    @Override
    public String expression() {
        return Integer.toString(value);
    }
}

public interface Visitor {
    Object visit(Number node);
    Object visit(BinaryExpression node);
}

public class BinaryOperatorVisitor implements Visitor {
    private char operator;

    public BinaryOperatorVisitor(char operator) {
        this.operator = operator;
    }

    @Override
    public Object visit(Number node) {
        return node.value;
    }

    @Override
    public Object visit(BinaryExpression node) {
        Number leftValue = (Number) node.left.accept(this);
        Number rightValue = (Number) node.right.accept(this);

        switch (node.operator) {
            case '+':
                return leftValue + rightValue;
            default:
                throw new UnsupportedOperationException("Unsupported operator");
        }
    }
}

