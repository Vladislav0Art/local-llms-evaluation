public class Expression {
    private String value;

    public Expression(String value) {
        this.value = value;
    }

    public String getValue() {
        return value;
    }
}

public class BinaryExpression extends Expression {
    private Expression left;
    private Expression right;

    public BinaryExpression(Expression left, Expression right, String operator) {
        super(operator + value);
        this.left = left;
        this.right = right;
    }

    public Expression getLeft() {
        return left;
    }

    public Expression getRight() {
        return right;
    }
}

public class ListIterable {
    private List<Expression> expressions;

    public ListIterable(List<Expression> expressions) {
        this.expressions = expressions;
    }

    public String toString() {
        StringBuilder sb = new StringBuilder();
        for (Expression expression : expressions) {
            sb.append(expression.getValue()).append(" ");
        }
        return sb.toString().trim();
    }
}

public class TestVisitor {
    private Expression expr;

    public TestVisitor(Expression expr) {
        this.expr = expr;
    }

    public String visit(BinaryExpression expression) {
        return "(" + expression.getLeft().getValue() + " " + expression.getValue() + " " + expression.getRight().getValue() + ")";
    }

    public void testBinaryExpression() {
        Expression left = new BinaryExpression(new NumberLiteral("x"), new NumberLiteral("+2"), "+");
        Expression right = new BinaryExpression(left, new NumberLiteral("+3"), "+");

        List<Expression> expressions = new ArrayList<>();
        expressions.add(right);
        expressions.add(left);

        String result = expr.visit(new ListIterable(expressions));
        System.out.println(result);  // Output: "x + 2 + 3"
    }
}

