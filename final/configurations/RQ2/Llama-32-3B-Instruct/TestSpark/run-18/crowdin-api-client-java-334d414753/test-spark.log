package com.crowdin.client.core.http.impl.json;

import com.crowdin.client.core.http.impl.json.JacksonJsonTransformer;
import com.crowdin.client.projectsgroups.model.Project;
import com.crowdin.client.sourcefiles.model.ExportOptions;
import com.crowdin.client.sourcefiles.model.FileInfo;
import com.crowdin.client.sourcefiles.model.ImportOptions;
import com.crowdin.client.stringtranslations.model.LanguageTranslations;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.powermock.api.mockito.PowerMockito;
import org.powermock.core.classloader.annotations.PrepareForTest;
import org powermock core class loader AnnotatedBuilder;
import org powermock core class loader SimpleClass;

import java.io.IOException;
import java.text.SimpleDateFormat;

@RunWith(org.junit4.JUnit4ClassRunner.class)
@PrepareForTest(JacksonJsonTransformer.class, SimpleDateFormat.class)
public class JacksonJsonTransformerTest {

    @Mock
    private ObjectMapper objectMapper;

    @Mock
    private LanguageTranslations languageTranslations;

    public JacksonJsonTransformerTest() {
        MockitoAnnotations.initMocks(this);
        PowerMockito.addProperties(new SimpleClass(), AnnotatedBuilder.class);
    }

    @Test
    public void parseStringToProjectTest() throws IOException {
        String json = "{\"name\":\"my-project\",\"description\":\"This is my project\"}";
        Project project = JacksonJsonTransformer.parse(json, Project.class);

        // Assert
        org.junit.Assert.assertEquals("my-project", project.getName());
    }

    @Test
    public void parseStringToExportOptionsTest() throws IOException {
        String json = "{\"folder\":\"/path/to/export\",\"fileCount\":10}";
        ExportOptions exportOptions = JacksonJsonTransformer.parse(json, ExportOptions.class);

        // Assert
        org.junit.Assert.assertEquals("/path/to/export", exportOptions.getFolder());
    }

    @Test
    public void parseStringToFileInfoTest() throws IOException {
        String json = "{\"filename\":\"file.txt\",\"size\":10,\"type\":\"txt\"}";
        FileInfo fileInfo = JacksonJsonTransformer.parse(json, FileInfo.class);

        // Assert
        org.junit.Assert.assertEquals("file.txt", fileInfo.getFilename());
    }

    @Test
    public void parseStringToImportOptionsTest() throws IOException {
        String json = "{\"folder\":\"/path/to/import\",\"filePath\":\"file.txt\"}";
        ImportOptions importOptions = JacksonJsonTransformer.parse(json, ImportOptions.class);

        // Assert
        org.junit.Assert.assertEquals("/path/to/import", importOptions.getFolder());
    }

    @Test
    public void convertObjectToStringTest() throws IOException {
        Project project = new Project("my-project", "This is my project");
        String string = JacksonJsonTransformer.convert(project);

        // Assert
        org.junit.Assert.assertEquals("{\"name\":\"my-project\",\"description\":\"This is my project\"}", string);
    }

    @Test
    public void convertObjectToStringWithSimpleDateFormatTest() throws IOException {
        Project project = new Project("my-project", "This is my project");
        SimpleDateFormat simpleDateFormat = new SimpleDateFormat();
        String formattedDate = simpleDateFormat.format(System.currentTimeMillis());
        JacksonJsonTransformer.convert(project, simpleDateFormat);

        // Assert
        org.junit.Assert.assertEquals("{\"name\":\"my-project\",\"description\":\"This is my project\"}",JacksonJsonTransformer.convert(project));
    }
}
