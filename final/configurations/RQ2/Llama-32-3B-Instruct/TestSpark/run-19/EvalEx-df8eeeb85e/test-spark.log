public class TokenizerTest {

    @Test
    public void createTokenizerWithValidExpressionAndConfigurationDoesNotThrowAnyException() {
        // Arrange
        String expressionString = "1 + 2 * 3";
        ExpressionConfiguration configuration = new ExpressionConfiguration();
        // Act & Assert
        assert tokenizer != null;
    }

    private Tokenizer tokenizer;

    @Test
    public void parseMethodReturnsCorrectNumberOfTokensForEmptyExpression() {
        // Arrange
        tokenizer = new Tokenizer("", new ExpressionConfiguration());
        List<Token> tokens = tokenizer.parse();

        // Act & Assert
        assertEquals(0, tokens.size());
    }

    @Test
    public void parseMethodReturnsCorrectNumberOfTokensForValidExpression() {
        // Arrange
        tokenizer = new Tokenizer("1 + 2 * 3", new ExpressionConfiguration());
        List<Token> tokens = tokenizer.parse();

        // Act & Assert
        assertEquals(5, tokens.size());
    }

    @Test
    public void parseMethodThrowsParseExceptionWhenExpressionIsInvalid() {
        // Arrange
        tokenizer = new Tokenizer(" invalid expression ", new ExpressionConfiguration());

        // Act & Assert
        assertThrows(ParseException.class, () -> tokenizer.parse());
    }

    @Test
    public void parseStringLiteralReturnsCorrectTokenType() {
        // Arrange
        tokenizer = new Tokenizer("\"hello\"", new ExpressionConfiguration());
        Token token = tokenizer.parseStringLiteral();

        // Act & Assert
        assertEquals(STRING_LITERAL, token.getType());
    }

    @Test
    public void parseStringLiteralThrowsParseExceptionWhenExpressionIsNotStringLiteral() {
        // Arrange
        tokenizer = new Tokenizer("not a string literal", new ExpressionConfiguration());

        // Act & Assert
        assertThrows(ParseException.class, () -> tokenizer.parseStringLiteral());
    }
}
