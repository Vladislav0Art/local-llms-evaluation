import org.jsoup.nodes.TextNode;
import org.junit.Test;
import static org.junit.Assert.*;
import java.io.ByteArrayOutputStream;
import java.io.PrintStream;
import java.util.Arrays;

public class TextNodeTest {

    @Test
    public void nodeName_EmptyTextNode ReturnsEmpty() {
        TextNode node = new TextNode("");
        assertEquals("text", node.nodeName());
    }

    @Test
    public void text_GettingTextValue_ReturnsInputText() {
        TextNode node = new TextNode("Hello");
        assertEquals("Hello", node.text());
    }

    @Test
    public void text_SettingTextNodeText SetsNewTextValue() {
        TextNode node = new TextNode("Old");
        node.text("New");
        assertEquals("New", node.text());
    }

    @Test
    public void splitText_SplittingAtOffset ReturnsNewNodeWithText() {
        String initialText = "HelloWorld";
        TextNode node = new TextNode(initialText);
        TextNode newNode = node.splitText(6);
        assertEquals("World", newNode.text());
        assertNotSame(node, newNode);
    }

    @Test
    public void isBlank_ReturnsFalseForNonEmptyTextNode() {
        TextNode node = new TextNode("Hello");
        assertFalse(node.isBlank());
    }

    @Test
    public void isBlank_ReturnsTrueForEmptyTextNode() {
        TextNode node = new TextNode("");
        assertTrue(node.isBlank());
    }

    @Test
    public void outerHtmlHead_AppendsNodeToOutput(StringBuilder output, PrintStream originalOut) throws IOException {
        TextNode node = new TextNode("Hello");
        Appendable accum = new ByteArrayOutputStream();
        Document.OutputSettings out = new Document.OutputSettings();
        node.outerHtmlHead(accum, 1, out);
        assertEquals("Hello", accum.toString());
    }

    @Test
    public void outerHtmlTail_AppendsNodeToOutput(StringBuilder output, PrintStream originalOut) throws IOException {
        TextNode node = new TextNode("Hello");
        Appendable accum = new ByteArrayOutputStream();
        Document.OutputSettings out = new Document.OutputSettings();
        node.outerHtmlTail(accum, 1, out);
        assertEquals("", accum.toString());
    }

    @Test
    public void toString_ReturnsTextContent() {
        TextNode node = new TextNode("Hello");
        assertEquals("Hello", node.toString());
    }

    @Test
    public void clone_ReturnsDeepCopyOfTextNode() {
        String initialText = "HelloWorld";
        TextNode node = new TextNode(initialText);
        TextNode cloned = node.clone();
        assertNotSame(node, cloned);
        assertEquals(initialText, cloned.text());
    }

    @Test
    public void createFromEncoded_ParsesEncodedText(String encodedText) {
        String expectedText = "HelloWorld";
        TextNode node = TextNode.createFromEncoded(encodedText);
        assertEquals(expectedText, node.text());
    }
}
