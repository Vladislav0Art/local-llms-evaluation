    public void nodeName_EmptyTextNode_ReturnsEmpty() {
        TextNode node = new TextNode("");
        assertEquals("text", node.nodeName());
    }

    @Test
    public void text_GettingTextValue_ReturnsInputText() {
        TextNode node = new TextNode("Hello");
        assertEquals("Hello", node.text());
    }

    @Test
    public void text_SettingTextNodeText_SetsNewTextValue() {
        TextNode node = new TextNode("Old");
        node.text("New");
        assertEquals("New", node.text());
    }

    @Test
    public void splitText_SplittingAtOffset_ReturnsNewNodeWithText() {
        String initialText = "HelloWorld";
        TextNode node = new TextNode(initialText);
        TextNode newNode = node.splitText(6);
        assertEquals("World", newNode.text());
        assertNotSame(node, newNode);
    }

    @Test
    public void isBlank_ReturnsFalseForNonEmptyTextNode() {
        TextNode node = new TextNode("Hello");
        assertFalse(node.isBlank());
    }

    @Test
    public void isBlank_ReturnsTrueForEmptyTextNode() {
        TextNode node = new TextNode("");
        assertTrue(node.isBlank());
    }

    @Test
    public void outerHtmlHead_AppendsNodeToOutput() throws IOException {
        String expectedText = "Hello";
        TextNode node = new TextNode("Hello");
        ByteArrayOutputStream outContent = new ByteArrayOutputStream();
        PrintStream originalOut = System.out;
        System.setOut(new PrintStream(outContent));
        Document.OutputSettings out = new Document.OutputSettings();
        node.outerHtmlHead(out, 1, out);
        assertEquals(expectedText, outContent.toString());
        System.setOut(originalOut);
    }

    @Test
    public void outerHtmlTail_AppendsNodeToOutput() throws IOException {
        String expectedText = "";
        TextNode node = new TextNode("Hello");
        ByteArrayOutputStream outContent = new ByteArrayOutputStream();
        PrintStream originalOut = System.out;
        System.setOut(new PrintStream(outContent));
        Document.OutputSettings out = new Document.OutputSettings();
        node.outerHtmlTail(out, 1, out);
        assertEquals(expectedText, outContent.toString());
        System.setOut(originalOut);
    }

    @Test
    public void toString_ReturnsTextContent() {
        TextNode node = new TextNode("Hello");
        assertEquals("Hello", node.toString());
    }

    @Test
    public void clone_ReturnsDeepCopyOfTextNode() {
        String initialText = "HelloWorld";
        TextNode node = new TextNode(initialText);
        TextNode cloned = node.clone();
        assertNotSame(node, cloned);
        assertEquals(initialText, cloned.text());
    }

    @Test
    public void createFromEncoded_ParsesEncodedText() {
        String encodedText = "HelloWorld";
        TextNode node = TextNode.createFromEncoded(encodedText);
        assertEquals("HelloWorld", node.text());
    }

}
