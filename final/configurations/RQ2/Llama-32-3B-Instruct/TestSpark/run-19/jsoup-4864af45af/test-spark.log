    public static Safelist none() {
        return new Safelist();
    }

    public Safelist simpleText() {
        return addTags(safeTags);
    }

    public Safelist addTags(String[] tags) {
        for (String tag : tags) {
            if (!safeTags.contains(tag)) {
                safeTags = new String[]{tag};
            }
        }
        return this;
    }

