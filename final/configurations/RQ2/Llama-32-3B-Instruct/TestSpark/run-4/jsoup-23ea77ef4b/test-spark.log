    @Test
    public void namespaceAwareReturnsFalse() {
        boolean result = w3cdom.namespaceAware();
        assert result == false;
    }

    @Test
    public void namespaceAwareSetToTrue() {
        boolean result = w3cdom.namespaceAware(true);
        assert result == true;
    }

    @Test
    public void convertJsoupDocument() {
        Document doc = mock(Document.class);
        Document out = w3cdom.convert(new org.jsoup.nodes.Document(), doc);
        assertNotNull(out);
    }

    @Test
    public void asStringHtmlDocWithProperties() {
        String result = W3CDom.asString(w3cdom.fromJsoup(new org.jsoup.nodes.Document()), new HashMap<>());
        assert result != null;
    }

    @Test
    public void propertiesFromMapToProperties() {
        Map<String, String> map = new HashMap<>();
        Properties result = W3CDom.propertiesFromMap(map);
        assertNotNull(result);
    }

    @Test
    public void outputHtmlReturnsEmptyHashMap() {
        HashMap<String, String> result = W3CDom.OutputHtml();
        assertEquals(0, result.size());
    }

    @Test
    public void outputXmlReturnsEmptyHashMap() {
        HashMap<String, String> result = W3CDom.OutputXml();
        assertEquals(0, result.size());
    }

    @Test
    public void fromJsoupDocumentReturnsDocument() {
        Document doc = mock(Document.class);
        Document out = w3cdom.fromJsoup(new org.jsoup.nodes.Document(), doc);
        assert out == doc;
    }

    @Test
    public void fromJsoupElementReturnsDocument() {
        Element element = mock(Element.class);
        Document doc = w3cdom.fromJsoup(element);
        assertNotNull(doc);
    }

    @Test
    public void convertDocumentFromJsoup() {
        Document in = mock(Document.class);
        Document out = w3cdom.convert(in, new org.jsoup.nodes.Document());
        assertNotNull(out);
    }

    @Test
    public void convertElementFromJsoup() {
        Element in = mock(Element.class);
        Document out = w3cdom.convert(in, new org.jsoup.nodes.Document());
        assertNotNull(out);
    }

