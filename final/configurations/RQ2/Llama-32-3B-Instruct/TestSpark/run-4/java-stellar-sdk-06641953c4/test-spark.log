    public void generate_WithIncorrectSeedTest() {
        byte[] seed = new byte[0];
        KeyPair keyPair = KeyPair.fromSecretSeed(seed);
        assertNotEquals(0, keyPair.hashCode());
    }
}

public class XdrPublicKeyTest {

