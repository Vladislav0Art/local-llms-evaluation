    private String amiId;
    private String packageName;
    private String commit;
    private String buildNumber;

    public AppVersion(String amiId, String packageName, String commit) {
        this.amiId = amiId;
        this.packageName = packageName;
        this.commit = commit;
        this.buildNumber = null;
    }

    public void setId(String id) {
        this.amiId = id;
    }

    public String getPackageName() {
        return this.packageName;
    }

    public void setPackageName(String packageName) {
        this.packageName = packageName;
    }

    public String getCommit() {
        return this.commit;
    }

    public void setCommit(String commit) {
        this.commit = commit;
    }

    public String getBuildNumber() {
        return this.buildNumber;
    }

    public void setBuildNumber(String buildNumber) {
        this.buildNumber = buildNumber;
    }
}

public class AppVersionTest {

    @org.junit.Test
    public void testAppVersion() {
        AppVersion appVersion = new AppVersion("ami-id", "package-name", "commit");
        org.junit.Assert.assertNotNull(appVersion);
        appVersion.setId("new-ami-id");
        org.junit.Assert.assertEquals("new-ami-id", appVersion.getId());
        org.junit.Assert.assertEquals("package-name", appVersion.getPackageName());
        org.junit.Assert.assertEquals("commit", appVersion.getCommit());
        org.junit.Assert.assertNull(appVersion.getBuildNumber());

        appVersion.setBuildNumber("build-number");
        org.junit.Assert.assertEquals("build-number", appVersion.getBuildNumber());
    }
}

