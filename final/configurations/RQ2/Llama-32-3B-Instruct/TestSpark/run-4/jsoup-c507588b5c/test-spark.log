import org.jsoup.nodes.Document;
import org.jsoup.nodes.LeafNode;
import org.jsoup.nodes.TextNode;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;

import java.io.ByteArrayOutputStream;
import java.io.IOException;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertTrue;
import static org.mockito.ArgumentMatchers.anyString;
import static org.mockito.Mockito.when;

@RunWith(MockitoJUnitRunner.class)
public class TextNodeTest {

    @Mock
    private Appendable accum;

    @Mock
    private Document.OutputSettings out;

    @Mock
    private LeafNode parent;

    public TextNode testTextNode() {
        return new TextNode("Hello World");
    }

    @Test
    public void nodeName()[MethodUnderTest]Test() {
        when(parent.nodeName()).thenReturn("");
        assertEquals("", testTextNode().nodeName());
    }

    @Test
    public void text()[MethodUnderTest]Test() {
        when(accum.append(anyString())).thenAnswer(i -> i);
        when(testTextNode().text()).thenReturn("Hello World");
        assertTrue(testTextNode().text().equals("Hello World"));
    }

    @Test
    public void text_[MethodUnderTest]Test() {
        when(accum.append(anyString())).thenAnswer(i -> i);
        assertEquals("  Hello ", testTextNode().text());
    }

    @Test
    public void splitText()[MethodUnderTest]Test() throws IOException {
        ByteArrayOutputStream output = new ByteArrayOutputStream();
        testTextNode().outerHtmlHead(output, 0, out).outerHtmlTail(output, 1, out);
        when(accum.append(anyString())).thenAnswer(i -> i);
        assertEquals("Hello\nWorld", testTextNode().splitText(0).text());
    }

    @Test
    public void outerHtmlHead_[MethodUnderTest]Test() throws IOException {
        ByteArrayOutputStream output = new ByteArrayOutputStream();
        testTextNode().outerHtmlHead(output, 1, out).outerHtmlTail(output, 2, out);
        when(accum.append(anyString())).thenAnswer(i -> i);
        assertEquals("<html><body>Hello </body></html>", String.format("%s", testTextNode()));
    }

    @Test
    public void outerHtmlTail_[MethodUnderTest]Test() {
        ByteArrayOutputStream output = new ByteArrayOutputStream();
        testTextNode().outerHtmlHead(output, 1, out).outerHtmlTail(output, 2, out);
        when(accum.append(anyString())).thenAnswer(i -> i);
        assertEquals("</body></html>", String.format("%s", testTextNode()));
    }

    @Test
    public void toString()[MethodUnderTest]Test() {
        when(out.getEncoding()).thenReturn("UTF-8");
        assertEquals("<td>Hello World</td>", testTextNode().toString());
    }

    @Test
    public void clone_[MethodUnderTest]Test() {
        TextNode node = new TextNode("Hello World");
        TextNode cloned = testTextNode().clone();
        when(parent.nodeName()).thenReturn("");
        when(testTextNode().nodeName()).thenReturn(cloned.nodeName());
        assertTrue(node.text().equals(cloned.text()));
    }

    @Test
    public void createFromEncoded_[MethodUnderTest]Test() {
        assertEquals(new TextNode("Hello World"), TextNode.createFromEncoded("Hello World"));
    }
}
