        LocalDate forDate = LocalDate.now();
        double result = DeltaT.estimate(forDate);
        assertEquals(0, result, 1e-6); // Use a delta to account for floating-point precision issues
    }

    public void testEstimateDeltaTDifferentFromZeroForDifferentDates() {
        LocalDate forDate1 = LocalDate.now().minusDays(10);
        LocalDate forDate2 = LocalDate.now().plusDays(5);
        double result1 = DeltaT.estimate(forDate1);
        double result2 = DeltaT.estimate(forDate2);
        assertTrue(result1 != 0);
        assertTrue(result2 != 0);
    }

    public void testEstimateDeltaTSameForDifferentDatesAtSameTime() {
        LocalDate forDate1 = LocalDate.now().minusDays(10);
        LocalDate forDate2 = LocalDate.now().minusDays(10); // Same time and date but different years
        double result1 = DeltaT.estimate(forDate1);
        double result2 = DeltaT.estimate(forDate2);
        assertEquals(result1, result2);
    }

    public void testEstimateDeltaTEqualForSameDayOnDifferentYears() {
        LocalDate forDate1 = LocalDate.now().minusDays(10).withYear(2023);
        LocalDate forDate2 = LocalDate.now().minusDays(10).withYear(2024);
        double result1 = DeltaT.estimate(forDate1);
        double result2 = DeltaT.estimate(forDate2);
        assertEquals(result1, result2);
    }

    public void testEstimateDeltaTFailsWithNegativeInput() {
        LocalDate forDate = LocalDate.now().minusDays(10L); // Use a long to avoid autoboxing
        try {
            DeltaT.estimate(forDate);
            assertFalse(true); // Failure should be detected here
        } catch (Exception e) {
            assertTrue(true);
        }
    }

    public void testEstimateDeltaTThrowsIllegalArgumentExceptionWithNullInput() {
        LocalDate forDate = null;
        boolean thrown = false;
        try {
            DeltaT.estimate(forDate);
        } catch (Exception e) {
            thrown = true;
        }
        assertFalse(thrown);
    }
}
