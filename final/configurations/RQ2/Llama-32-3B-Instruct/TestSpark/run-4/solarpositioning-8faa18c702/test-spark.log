package net.e175.klaus.solarpositioning;

import org.junit.Test;
import static org.junit.Assert.assertEquals;
import static java.lang.Math.pow;
import java.time.LocalDate;
import java.util.ArrayList;
import java.util.List;

public class DeltaTTest {

    @Test
    public void estimateDeltaTForAnyDateReturnsZero() {
        LocalDate forDate = LocalDate.now();
        double result = DeltaT.estimate(forDate);
        assertEquals(0, result);
    }

    @Test
    public void estimateDeltaTDifferentFromZeroForDifferentDates() {
        LocalDate forDate1 = LocalDate.now().plusDays(-10);
        LocalDate forDate2 = LocalDate.now().plusDays(5);
        double result1 = DeltaT.estimate(forDate1);
        double result2 = DeltaT.estimate(forDate2);
        assertNotEquals(0, result1);
        assertNotEquals(0, result2);
    }

    @Test
    public void estimateDeltaTSameForDifferentDatesAtSameTime() {
        LocalDate forDate1 = LocalDate.now().plusDays(-10).withHour(12).withMinute(30).withSecond(0);
        LocalDate forDate2 = LocalDate.now().plusDays(-10).withHour(12).withMinute(30).withSecond(0);
        double result1 = DeltaT.estimate(forDate1);
        double result2 = DeltaT.estimate(forDate2);
        assertEquals(result1, result2);
    }

    @Test
    public void estimateDeltaTEqualForSameDayOnDifferentYears() {
        LocalDate forDate1 = LocalDate.now().plusDays(-10).withYear(2023);
        LocalDate forDate2 = LocalDate.now().plusDays(-10).withYear(2024);
        double result1 = DeltaT.estimate(forDate1);
        double result2 = DeltaT.estimate(forDate2);
        assertEquals(result1, result2);
    }

    @Test
    public void estimateDeltaTFailsWithNegativeInput() {
        LocalDate forDate = LocalDate.now().minusDays(10);
        assertThrows(NullPointerException.class, () -> DeltaT.estimate(forDate));
    }
}
