public class Connection {
    public static interface KeyVal {
        String getKey();
        String getValue();

        default boolean isEmpty() {
            return getKey().isEmpty() && getValue().isEmpty();
        }
    }

    public static class UrlBuilder {
        private String scheme;
        private String host;

        public UrlBuilder(String url) {
            URL parsedUrl = new URL(url);
            this.scheme = parsedUrl.getProtocol();
            this.host = parsedUrl.getHost();

        }

        public Connection.KeyVal build() {
            return new Connection.KeyVal(scheme, host);
        }
    }

    public static class KeyValImpl implements Connection.KeyVal {
        private String key;
        private String value;

        public KeyValImpl(String key, String value) {
            this.key = key;
            this.value = value;
        }

        @Override
        public String getKey() {
            return key;
        }

        @Override
        public String getValue() {
            return value;
        }
    }
}

