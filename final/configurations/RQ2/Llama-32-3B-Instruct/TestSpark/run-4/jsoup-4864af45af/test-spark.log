import org.w3c.dom.Document;
import org.w3c.dom.Element;

public class ImageElement {
    public static Document createImageElement(String src, Attributes attribute) throws Exception {
        Document document = DocumentBuilderFactory.newInstance().newDocumentBuilder().newDocument();
        Element imageElement = document.createElement("img");
        imageElement.setAttribute("src", src);

        if (attribute != null && !attribute.isEmpty()) {
            for (Attribute attr : attribute.getAttributes()) {
                imageElement.setAttribute(attr.getName(), attr.getValue());
            }
        }

        return document;
    }

    public static class Attributes {
        private List<Attribute> attributes;

        public Attributes() {
            this.attributes = new ArrayList<>();
        }

        public void addSafeAttribute(String name, Object element, String value) {
            Attribute attribute = new Attribute(name, value, (Element) element);
            attributes.add(attribute);
        }
    }

