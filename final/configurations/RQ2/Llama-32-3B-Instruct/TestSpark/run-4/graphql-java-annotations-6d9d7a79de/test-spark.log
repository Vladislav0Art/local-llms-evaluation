public class GraphQLDirectiveBuilderTest {

    public static class CustomFilterFunction implements Function<List<GraphQLDirective>, List<GraphQLDirective>> {
        @Override
        public List<GraphQLDirective> apply(List<GraphQLDirective> directives) {
            return directives;
        }
    }

    public static class GraphQLDirectiveBuilder {
        private List<GraphQLDirective> directives;

        public GraphQLDirectiveBuilder() {
            this.directives = new ArrayList<>();
        }

        public CustomFilterFunction getCustomFilter() {
            return (directives) -> directives;
        }

        public List<GraphQLDirective> generateDirectives(List<GraphQLDirective> directives) {
            return directives;
        }

        public List<GraphQLDirective> build() {
            return this.directives;
        }

        public GraphQLDirective newDirective(String name, String type) {
            GraphQLDirective directive = new GraphQLDirective(name, type);
            this.directives.add(directive);
            return directive;
        }
    }

    @Test
    public void testGenerateCustomFilter() {
        // Given
        List<GraphQLDirective> directives = new ArrayList<>();
        directives.add(new GraphQLDirective("directive1", "type1"));
        directives.add(new GraphQLDirective("directive2", "type2"));

        CustomFilterFunction filterFunction = new CustomFilterFunction();

        when(Container.class.getMethods()).thenReturn(Arrays.asList(CustomFilterFunction.class.getMethod("apply", List.class), 
                CustomFilterFunction.class.getMethod("getCustomFilter")));

        // When
        GraphQLDirectiveBuilder builder = new GraphQLDirectiveBuilder();
        List<GraphQLDirective> result = builder.generateCustomFilter();

        // Then
        assertEquals(directives, result);
    }

    @Test
    public void testGenerateDirectives() {
        // Given
        List<GraphQLDirective> directives = Arrays.asList(
                new GraphQLDirective("directive1", "type1"),
                new GraphQLDirective("directive2", "type2")
        );

        GraphQLDirectiveBuilder builder = new GraphQLDirectiveBuilder();
        List<GraphQLDirective> result = builder.generateDirectives(directives);

        // Then
        assertEquals(directories, result);
    }

    @Test
    public void testBuild() {
        // Given
        GraphQLDirectiveBuilder builder = new GraphQLDirectiveBuilder();

        // When
        List<GraphQLDirective> result = builder.build();

        // Then
        assertEquals(2, result.size());
    }

    @Test
    public void testNewDirective() {
        // Given
        String directiveName = "directive1";
        String type = "type1";

        GraphQLDirectiveBuilder builder = new GraphQLDirectiveBuilder();
        GraphQLDirective result = builder.newDirective(directiveName, type);

        // Then
        assertEquals(directiveName, result.getName());
        assertEquals(type, result.getType());
    }
}

