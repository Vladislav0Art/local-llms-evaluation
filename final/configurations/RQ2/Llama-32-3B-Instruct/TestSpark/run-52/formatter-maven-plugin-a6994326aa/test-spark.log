import net.revelc.code.formatter.AbstractCacheableFormatter;
import net.revelc.code.formatter.ConfigurationSource;
import net.revelc.code.formatter.Formatter;

public class CssFormatterTest {

    @Test
    public void init(Map<String, String> options, ConfigurationSource cfg) {
        cssFormatter.init(options, cfg);
        assertTrue(cssFormatter.isInitialized());
    }

    private CssFormatter cssFormatter = new CssFormatter();

    @Test
    public void doFormat_emptyInput_throwsIOException() {
        assertThrows(IOException.class, () -> cssFormatter.doFormat("", LineEnding.LF));
    }

    @Test
    public void doFormat_validCssReturnsFormattedCss() throws IOException {
        String code = ".test { width: 100px; }";
        String formattedCss = cssFormatter.doFormat(code, LineEnding.CRLF);
        assertNotNull(formattedCss);
    }

    @Test
    public void doFormat_noLineEnding_throwsIOException() {
        assertThrows(IOException.class, () -> cssFormatter.doFormat("", LineEnding.LF));
    }

    @Test
    public void isInitialized_true_whenInitialized() {
        assertTrue(cssFormatter.isInitialized());
    }

    @Test
    public void isInitialized_false_whenNotInitialized() {
        cssFormatter.init(new java.util.HashMap<String, String>(), null);
        assertFalse(cssFormatter.isInitialized());
    }
}
