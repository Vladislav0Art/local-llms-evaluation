package org.jsoup.parser;

import org.jsoup.helper.Validate;
import org.junit.Test;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.springframework.test.context.ContextConfiguration;

import static org.junit.Assert.*;
import static org.mockito.Mockito.when;

@RunWith(org.junit.runners.JUnit4.class)
public class GeneratedTest {

    @Mock
    private TreeBuilder treeBuilder;

    @Mock
    private Token token;

    @Mock
    private Node node;

    @Mock
    private Element element;

    @Mock
    private Comment comment;

    @Mock
    private TextNode text;

    @Mock
    private DocumentType documentType;

    @Mock
    private Document document;

    @Config
    public static class Config {
    }

    @Test
    public void testProcess() {
        when(treeBuilder.process(token)).thenReturn(true);
        assertTrue(treeBuilder.process(token));
    }

    @Test
    public void testInsertNodeWithNode() {
        when(treeBuilder.insertNode(node)).thenReturn(element);
        Element result = treeBuilder.insertNode(node);
        assertNotNull(result);
    }

    @Test
    public void testInsertNodeWithToken() {
        when(treeBuilder.insertNode(node, token)).thenReturn(text);
        TextNode result = treeBuilder.insertNode(node, token);
        assertNotNull(result);
    }

    @Test
    public void testInsertStartTag() {
        when(treeBuilder.insert(token)).thenReturn(element);
        Element result = treeBuilder.insert(token);
        assertNotNull(result);
    }

    @Test
    public void testInsertCommentToken() {
        when(treeBuilder.insert(token)).thenReturn(comment);
        Comment result = treeBuilder.insert(token);
        assertNotNull(result);
    }

    @Test
    public void testInsertCharacterToken() {
        when(treeBuilder.insert(token)).thenReturn(text);
        TextNode result = treeBuilder.insert(token);
        assertNotNull(result);
    }

    @Test
    public void testInsertDoctypeToken() {
        when(treeBuilder.insert(token)).thenReturn(documentType);
        DocumentType result = treeBuilder.insert(token);
        assertNotNull(result);
    }

    @Test
    public void testPopStackToCloseEndTag() {
        when(treeBuilder.popStackToClose(token)).thenReturn(true);
        boolean result = treeBuilder.popStackToClose(token);
        assertTrue(result);
    }

    @Test
    public void testParseFragmentWithInputAndBaseUri() {
        when(treeBuilder.parseFragment("example", token, document)).thenReturn(List.of(node));
        List<Node> result = treeBuilder.parseFragment("example", token, document);
        assertNotNull(result);
        assertEquals(1, result.size());
    }

    @Test
    public void testParseFragmentWithInputAndContext() {
        when(treeBuilder.parseFragment("example", node, token)).thenReturn(List.of(node));
        List<Node> result = treeBuilder.parseFragment("example", node, token);
        assertNotNull(result);
        assertEquals(1, result.size());
    }

}
