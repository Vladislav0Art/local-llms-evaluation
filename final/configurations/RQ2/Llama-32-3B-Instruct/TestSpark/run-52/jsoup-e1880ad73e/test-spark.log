package org.jsoup.helper;

import org.junit.Test;
import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertNull;
import java.net.URL;
import org.jsoup.Connection.KeyVal;
import java.io.UnsupportedEncodingException;
import javax.annotation.Nullable;
import org.mockito.Mockito;
import org.jsoup.internal.StringUtil;
import org.jsoup.helper.DataUtil;

public class UrlBuilderTest {

    @Test
    public void ofUrlBuildsCorrectly() {
        URL url = new URL("https://example.com");
        UrlBuilder builder = new UrlBuilder(url);
        URL builtUrl = builder.build();
        assertEquals("https://example.com", builtUrl.toString());
    }

    @Test
    public void appendKeyValEncodesKeyAndValueCorrectly() throws UnsupportedEncodingException {
        String key = "test";
        String value = "value";
        Connection.KeyVal kv = new Connection.KeyVal(key, value);
        UrlBuilder builder = new UrlBuilder(null);
        builder.appendKeyVal(kv);
        URL builtUrl = builder.build();
        assertEquals("https://example.com?test=value", builtUrl.toString());
    }

    @Test
    public void appendKeyValEncodesKeyCorrectly() throws UnsupportedEncodingException {
        String key = "test";
        Connection.KeyVal kv = new Connection.KeyVal(key, null);
        UrlBuilder builder = new UrlBuilder(null);
        builder.appendKeyVal(kv);
        URL builtUrl = builder.build();
        assertEquals("https://example.com?test=%E8%A7%AE%E5%88%B6", builtUrl.toString());
    }

    @Test
    public void appendKeyValEncodesValueCorrectly() throws UnsupportedEncodingException {
        String value = "test";
        Connection.KeyVal kv = new Connection.KeyVal(null, value);
        UrlBuilder builder = new UrlBuilder(null);
        builder.appendKeyVal(kv);
        URL builtUrl = builder.build();
        assertEquals("https://example.com?%3C%3Ftest%3Dvalue", builtUrl.toString());
    }

    @Test
    public void buildThrowsNullPointerExceptionWhenInputUrlIsNull() {
        assertNull(new UrlBuilder(null).build());
    }

}

