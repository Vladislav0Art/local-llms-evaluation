import org.jsoup.Jsoup;
import org.jsoup.nodes.Comment;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.select.Elements;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertNotNull;
import static org.junit.Assert.assertNull;
import static org.junit.Assert.assertTrue;

public class GeneratedTest {
    @org.junit.Test
    public void testCreatedWithEmptyString() {
        Comment comment = new Comment("");
        assertNotNull(comment);
    }

    @org.junit.Test
    public void testCreatedWithNullContent() {
        Comment comment = new Comment(null);
        assertNotNull(comment);
    }

    @org.junit.Test
    public void testCreatedWithValidContent() {
        String content = "This is a valid comment content";
        Comment comment = new Comment(content);
        assertEquals(content, comment.getContent());
        assertNotNull(comment.getOuterHtmlHead());
        assertNotNull(comment.getOuterHtmlTail());
    }

    @org.junit.Test
    public void testCreatedWithInvalidContent() {
        try {
            new Comment("");
                .outerHtmlHead(null, 0, null)
                .outerHtmlTail(null, 0, null);
            assert false;
        } catch (UnsupportedOperationException e) {
            assertNotNull(e);
        }
    }

    @org.junit.Test
    public void testCreatedWithValidContentString() {
        String content = "This is a valid comment content";
        Comment comment = new Comment(content);
        assertEquals("<!--" + content + "-->", comment.toString());
        assertTrue(comment.isXmlDeclaration());
        assertNull(comment.asXmlDeclaration());
    }

    @org.junit.Test
    public void testCreatedWithNullContentString() {
        try {
            new Comment("")
                .outerHtmlHead(null, 0, null)
                .outerHtmlTail(null, 0, null);
            assert false;
        } catch (UnsupportedOperationException e) {
            assertNotNull(e);
        }
    }

    @org.junit.Test
    public void testCloning() {
        Document document = Jsoup.parse("<div><comment>This is a comment.</comment></div>");
        Comment comment = document.body().firstChild();
        Comment clonedComment = new Comment(comment.cloneNode(false));
        assertEquals(comment, clonedComment);
    }
}
