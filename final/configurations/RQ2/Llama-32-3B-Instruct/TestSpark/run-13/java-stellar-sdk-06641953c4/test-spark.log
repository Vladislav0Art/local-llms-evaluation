package org.stellar.sdk;

import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;

import static org.junit.Assert.*;
import static org.mockito.Mockito.*;

@RunWith(MockitoJUnitRunner.class)
public class GeneratedTest {

    @Mock
    private EdDSAPublicKey publicKeyMock;

    @Mock
    private EdDSADecoder decoderMock;

    @Test
    public void newKeyPairFromPublic() {
        when(publicKeyMock.getEncoded()).thenReturn(new byte[]{1, 2, 3});
        KeyPair keyPair = KeyPair.newKeyPair(publicKeyMock);
        assertNotNull(keyPair);
        assertEquals(3, keyPair.getPublicKey().length);
    }

    @Test
    public void newKeyPairFromPublic_CanSign() {
        when(publicKeyMock.getEncoded()).thenReturn(new byte[]{1, 2, 3});
        KeyPair keyPair = KeyPair.newKeyPair(publicKeyMock);
        assertTrue(keyPair.canSign());
    }

    @Test
    public void fromSecretSeed_WithBip39Seed() {
        when(decoderMock.decode(bip39Seed)).thenReturn(publicKeyMock);
        char[] seed = "12-34-56".toCharArray();
        KeyPair keyPair = KeyPair.fromSecretSeed(seed);
        assertNotNull(keyPair);
    }

    @Test
    public void fromSecretSeed_WithAccountNumber() {
        when(decoderMock.decode(accountId)).thenReturn(publicKeyMock);
        char[] seed = "12-34-56".toCharArray();
        KeyPair keyPair = KeyPair.fromSecretSeed(seed, 1);
        assertNotNull(keyPair);
    }

    @Test
    public void fromAccountId_WithAccountNumber() {
        when(decoderMock.decode(accountId)).thenReturn(publicKeyMock);
        char[] seed = "12-34-56".toCharArray();
        KeyPair keyPair = KeyPair.fromSecretSeed(seed, 1);
        assertNotNull(keyPair);
    }

    @Test
    public void getAccountId() {
        KeyPair keyPair = new KeyPair(publicKeyMock);
        String accountId = keyPair.getAccountId();
        assertNotNull(accountId);
    }

    @Test
    public void getSecretSeed() {
        KeyPair keyPair = new KeyPair(publicKeyMock);
        char[] secretSeed = keyPair.getSecretSeed();
        assertNotNull(secretSeed);
    }

    @Test
    public void getPublicKey() {
        KeyPair keyPair = new KeyPair(publicKeyMock);
        byte[] publicKey = keyPair.getPublicKey();
        assertEquals(3, publicKey.length);
    }

    @Test
    public void signDecorated() {
        KeyPair keyPair = new KeyPair(publicKeyMock);
        byte[] data = new byte[]{1, 2, 3};
        DecoratedSignature signature = keyPair.signDecorated(data);
        assertNotNull(signature);
    }

    @Test
    public void verify() {
        KeyPair keyPair = new KeyPair(publicKeyMock);
        byte[] data = new byte[]{1, 2, 3};
        byte[] signature = new byte[]{4, 5, 6};
        assertTrue(keyPair.verify(data, signature));
    }

    @Test
    public void hashCode() {
        KeyPair keyPair = new KeyPair(publicKeyMock);
        int hashCode = keyPair.hashCode();
        assertNotNull(hashCode);
    }

}
