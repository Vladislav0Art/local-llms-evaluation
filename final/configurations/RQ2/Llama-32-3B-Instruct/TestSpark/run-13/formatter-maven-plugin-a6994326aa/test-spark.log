public class LineEnding {
    public static final int Unix = 0;
    public static final int Mac = 1;

    private LineEnding() {}

    public static String toString(int lineEnding) {
        if (lineEnding == Unix) return "\n";
        else if (lineEnding == Mac) return "\\r\\n";
        else throw new IllegalArgumentException("Invalid line ending");
    }

    public static void main(String[] args) {
        System.out.println(toString(Unix));
        System.out.println(toString(Mac));
    }
}

class LineEndingTest {
    @Test
    public void testToString() {
        assertEquals("\n", LineEnding.toString(LineEnding.Unix));
        assertEquals("\\r\\n", LineEnding.toString(LineEnding.Mac));
        assertThrows(IllegalArgumentException.class, () -> LineEnding.toString(-1));
    }

    @Test
    public void testNull() {
        assertThrows(NullPointerException.class, () -> LineEnding.toString(null));
    }
}

