package ch.jalu.configme.configurationdata;

import org.junit.Test;
import static org.hamcrest.MatcherAssert.assertThat;
import static org.hamcrest.Matchers.is;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

public class PropertyListBuilderTest {

    @Test
    public void addProperty_NoPreviousProperties_BuilderIsNotModified() {
        PropertyListBuilder builder = new PropertyListBuilder();
        List<Property<?>> properties = new ArrayList<>();
        builder.add(properties);
        assertThat(builder.create(), is(properties));
    }

    @Test
    public void create_EmptyList_ReturnsEmptyList() {
        PropertyListBuilder builder = new PropertyListBuilder();
        assertThat(builder.create(), is(new ArrayList<>()));
    }

    @Test
    public void addProperty_BuilderContainsExistingProperties_BuilderIsModifiedCorrectly() {
        PropertyListBuilder builder = new PropertyListBuilder();
        List<Property<?>> properties = new ArrayList<>();
        PropertiesTestHelper.addProperty(properties);
        builder.add(properties);
        assertThat(builder.create(), is(new ArrayList<>()));
    }

    @Test
    public void addProperty_NoPreviousProperties_ReturnsOriginalProperty() {
        PropertyListBuilder builder = new PropertyListBuilder();
        Property<?> property = PropertiesTestHelper.getProperty();
        builder.add(property);
        assertThat(builder.create().get(0), is(property));
    }

    private static class PropertiesTestHelper {

        public static List<Property<?>> getProperties() {
            return new ArrayList<>();
        }

        public static void addProperty(List<Property<?>> properties) {
            PropertiesTestHelper.getProperties().add(new Property<>());
        }

        public static Property<?> getProperty() {
            return new Property<>();
        }
    }
}
