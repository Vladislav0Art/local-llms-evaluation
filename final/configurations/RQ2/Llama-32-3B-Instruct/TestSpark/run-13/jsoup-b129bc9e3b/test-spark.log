import org.jsoup.Connection;
import org.jsoup.HttpStatusException;
import org.jsoup.UncheckedIOException;
import org.jsoup.UnsupportedMimeTypeException;
import org.junit.Test;
import org.junit.Assert;
import org.mockito.Mockito;

import java.io.ByteArrayInputStream;
import java.io.IOException;
import java.net.URI;
import java.net.URL;
import java.util.List;
import java.util.Map;

public class HttpConnectionTest {

    @Test
    public void connectUrlConnects() throws IOException {
        Connection connection = HttpConnection.connect(new URL("http://example.com"));
        Assert.assertNotNull(connection);
    }

    @Test
    public void connectURLConnects() throws IOException {
        Connection connection = HttpConnection.connect(null);
        Assert.assertNotNull(connection);
    }

    @Test
    public void newRequestCreatesNewRequest() {
        Connection request = Mockito.mock(Connection.class);
        Connection newRequest = HttpConnection.newRequest();
        Assert.assertEquals(request, newRequest);
    }

    @Test
    public void urlConnects() throws IOException {
        Connection connection = HttpConnection.url(new URL("http://example.com"));
        Assert.assertNotNull(connection);
    }

    @Test
    public void urlStringsConnects() throws IOException {
        Connection connection = HttpConnection.url("http://example.com");
        Assert.assertNotNull(connection);
    }

    @Test
    public void proxyConnects() {
        Connection connection = HttpConnection.proxy(null);
        Assert.assertNotNull(connection);
    }

    @Test
    public void proxyHostPortConnects() {
        Connection connection = HttpConnection.proxy("localhost", 8080);
        Assert.assertNotNull(connection);
    }

    @Test
    public void userAgentSetsUserAgent() {
        String userAgent = "Mozilla/5.0";
        Connection connection = HttpConnection.userAgent(userAgent);
        Assert.assertEquals(userAgent, connection.userAgent());
    }

    @Test
    public void timeoutSetsTimeout() {
        int millis = 1000;
        Connection connection = HttpConnection.timeout(millis);
        Assert.assertEquals(millis, connection.timeout());
    }

    @Test
    public void maxBodySizeSetsMaxBodySize() {
        int bytes = 1024;
        Connection connection = HttpConnection.maxBodySize(bytes);
        Assert.assertEquals(bytes, connection.maxBodySize());
    }

    @Test
    public void followRedirectsSetsFollowRedirects() {
        boolean followsRedirects = true;
        Connection connection = HttpConnection.followRedirects(followsRedirects);
        Assert.assertEquals(followsRedirects, connection.followRedirects());
    }

    @Test
    public void referrerSetsReferrer() {
        String referrer = "http://example.com";
        Connection connection = HttpConnection.referrer(referrer);
        Assert.assertEquals(referrer, connection.referrer());
    }

    @Test
    public void methodSetsMethod() {
        Method method = Method.GET;
        Connection connection = HttpConnection.method(method);
        Assert.assertEquals(method, connection.method());
    }

    @Test
    public void ignoreHttpErrorsSetsIgnoreHttpErrors() {
        boolean ignoresHttpErrors = true;
        Connection connection = HttpConnection.ignoreHttpErrors(ignoresHttpErrors);
        Assert.assertEquals(ignoresHttpErrors, connection.ignoreHttpErrors());
    }

    @Test
    public void ignoreContentTypeSetsIgnoreContentType() {
        boolean ignoresContentType = true;
        Connection connection = HttpConnection.ignoreContentType(ignoresContentType);
        Assert.assertEquals(ignoresContentType, connection.ignoreContentType());
    }

    @Test
    public void dataStringData() throws IOException {
        String key = "key";
        String value = "value";
        Connection connection = HttpConnection.data(key, value);
        Assert.assertNotNull(connection);
    }

    @Test
    public void dataMapData() throws IOException {
        Map<String, String> data = new LinkedHashMap<>();
        data.put("key", "value");
        Connection connection = HttpConnection.data(data);
        Assert.assertNotNull(connection);
    }

    @Test
    public void dataStringDataAndContentType() throws IOException {
        String key = "key";
        String value = "value";
        String contentType = "text/plain";
        Connection connection = HttpConnection.data(key, value, contentType);
        Assert.assertNotNull(connection);
    }

    @Test
    public void executeReturnsResponse() throws IOException {
        Connection response = Mockito.mock(Connection.Response.class);
        Connection connection = HttpConnection.execute(response);
        Assert.assertEquals(response, connection.response());
    }

    @Test
    public void getReturnsDocument() throws IOException {
        Document document = Mockito.mock(Document.class);
        Connection connection = HttpConnection.get(document);
        Assert.assertEquals(document, connection.get());
    }

    @Test
    public void postReturnsDocument() throws IOException {
        Document document = Mockito.mock(Document.class);
        Connection connection = HttpConnection.post(document);
        Assert.assertEquals(document, connection.post());
    }
}
