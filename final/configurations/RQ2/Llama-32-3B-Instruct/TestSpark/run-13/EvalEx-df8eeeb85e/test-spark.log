        assertEquals(1, tokens.get(0).getNumber());
        assertEquals(2, tokens.get(1).getNumber());
        assertEquals(ADD, tokens.get(1).getType());
        assertEquals(3, tokens.get(2).getNumber());
        assertEquals(MUL, tokens.get(2).getType());
    }

    @Test
    public void parseStringLiteral_validLiteral() {
        Tokenizer tokenizer = new Tokenizer("'hello'", new ExpressionConfiguration());
        List<Token> tokens = tokenizer.parse();
        assertEquals(1, tokens.size());

        assertTrue(tokens.get(0).getType() == STRING_LITERAL);
        assertEquals("hello", tokens.get(0).getStringValue());
    }

    @Test
    public void parseStringLiteral_invalidLiteral() {
        Tokenizer tokenizer = new Tokenizer("'h'", new ExpressionConfiguration());
        try {
            List<Token> tokens = tokenizer.parse();
            fail("ParseException was not thrown");
        } catch (ParseException e) {
            // Expected
        }
    }

    @Test
    public void parseStringLiteral_missingQuote() {
        Tokenizer tokenizer = new Tokenizer("'h", new ExpressionConfiguration());
        try {
            List<Token> tokens = tokenizer.parse();
            fail("ParseException was not thrown");
        } catch (ParseException e) {
            // Expected
        }
    }

}
