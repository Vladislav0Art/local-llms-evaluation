import org.junit.Test;
import static org.junit.Assert.*;
import java.util.Arrays;
import java.util.HashSet;
import org.jsoup.nodes.Attribute;
import org.jsoup.nodes.Element;

public class SafelistTest {

    @Test
    public void none_SimpleText_Test() {
        Safelist safelist = Safelist.safelist();
        assertTrue(safelist.isSimpleText());
    }

    @Test
    public void simpleText_AddTags Test() {
        Safelist safelist = Safelist.simpleText();
        Set<String> tags = new HashSet<>(Arrays.asList("p", "img"));
        safelist = safelist.addTags(tags.toArray(new String[0]));
        assertFalse(safelist.isSimpleText());
    }

    @Test
    public void basic_NoAttributes_Test() {
        Safelist safelist = Safelist.basic();
        Set<String> tags = new HashSet<>(Arrays.asList("p", "img"));
        assertTrue(!safelist.addTags(tags.toArray(new String[0])).isBasic());
    }

    @Test
    public void basic_WithImages_Test() {
        Safelist safelist = Safelist.basicWithImages();
        Set<String> tags = new HashSet<>(Arrays.asList("p", "img"));
        safelist = safelist.addTags(tags.toArray(new String[0]));
        assertTrue(safelist.isBasic());
    }

    @Test
    public void relaxed_NoAttributes_Test() {
        Safelist safelist = Safelist.relaxed();
        Set<String> tags = new HashSet<>(Arrays.asList("p", "img"));
        assertTrue(!safelist.addTags(tags.toArray(new String[0])).isRelaxed());
    }

    @Test
    public void relaxed_WithImages_Test() {
        Safelist safelist = Safelist.relaxed();
        Set<String> tags = new HashSet<>(Arrays.asList("p", "img"));
        safelist = safelist.addTags(tags.toArray(new String[0]));
        assertTrue(safelist.isRelaxed());
    }

    @Test
    public void addAttributes_SameTag_Test() {
        Safelist safelist = Safelist.relaxed();
        Set<String> tags = new HashSet<>(Arrays.asList("p", "img"));
        safelist = safelist.addTags(tags.toArray(new String[0]));
        assertTrue(!safelist.addAttributes("p", Arrays.asList("style")).isRelaxed());
    }

    @Test
    public void removeEnforcedAttribute_SameTag_Test() {
        Safelist safelist = Safelist.relaxed();
        Set<String> tags = new HashSet<>(Arrays.asList("p", "img"));
        safelist = safelist.addTags(tags.toArray(new String[0]));
        assertTrue(!safelist.removeEnforcedAttribute("p", "style").isRelaxed());
    }

    @Test
    public void preserveRelativeLinks_NoPreserve_Test() {
        Safelist safelist = Safelist.relaxed();
        Set<String> tags = new HashSet<>(Arrays.asList("p", "img"));
        safelist = safelist.addTags(tags.toArray(new String[0]));
        assertFalse(safelist.preserveRelativeLinks(false));
    }

    @Test
    public void addProtocols_SameTag_Test() {
        Safelist safelist = Safelist.relaxed();
        Set<String> tags = new HashSet<>(Arrays.asList("p", "img"));
        safelist = safelist.addTags(tags.toArray(new String[0]));
        assertTrue(!safelist.addProtocols("p", Arrays.asList("http://example.com")).isRelaxed());
    }

    @Test
    public void removeEnforcedAttribute_SameTag_Test() {
        Safelist safelist = Safelist.relaxed();
        Set<String> tags = new HashSet<>(Arrays.asList("p", "img"));
        safelist = safelist.addTags(tags.toArray(new String[0]));
        assertTrue(!safelist.removeProtocols("p", Arrays.asList("http://example.com")).isRelaxed());
    }
