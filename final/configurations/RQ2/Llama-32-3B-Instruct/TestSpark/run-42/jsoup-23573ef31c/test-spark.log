package org.jsoup.nodes;

import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.select.Elements;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.Mockito;
import org.mockito.junit.MockitoJUnitRunner;

import java.util.List;

@RunWith(MockitoJUnitRunner.class)
public class GeneratedTest {

    @Mock
    private Connection connection;

    @Mock
    private Parser parser;

    @Mock
    private OutputSettings outputSettings;

    @Mock
    private QuirksMode quirksMode;

    private Document document;

    @Before
    public void setup() {
        document = new Document("https://www.example.com");
        document.parser(parser);
        document.connection(connection);
        document.outputSettings(outputSettings);
        document.quirksMode(quirksMode);
    }

    public String createShell(String baseUri) {
        return "shell";
    }

    @Test
    public void testLocation() {
        String expectedLocation = "https://www.example.com";
        Document location = document.location();
        Mockito.when(connection.uri()).thenReturn(expectedLocation);
        assertEquals(expectedLocation, location);
    }

    @Test
    public void testConnection() {
        Connection connection = new Connection();
        Document connectionDocument = document.connection(connection);
        Mockito.when(document.parser().parse(Mockito.any(String.class))).thenReturn(connectionDocument);
        assertEquals(connectionDocument, document.connection());
    }

    @Test
    public void testHead() {
        Element head = document.head();
        Mockito.when(parser.parse(Mockito.any(String.class))).thenReturn(head);
        assertEquals(head, document.head());
    }

    @Test
    public void testBody() {
        Element body = document.body();
        Mockito.when(parser.parse(Mockito.any(String.class))).thenReturn(body);
        assertEquals(body, document.body());
    }

    @Test
    public void testForms() {
        List<FormElement> forms = document.forms();
        Mockito.when(parser.parse(Mockito.any(String.class))).thenReturn(forms);
        assertEquals(forms, document.forms());
    }

    @Test
    public void testExpectForm() {
        FormElement form = new FormElement();
        Document expectForm = document.expectForm("cssQuery");
        Mockito.when(parser.parse(Mockito.any(String.class))).thenReturn(form);
        assertEquals(form, document.expectForm("cssQuery"));
    }

    @Test
    public void testTitle() {
        String title = "title";
        Document titleDocument = document.title(title);
        Mockito.when(connection.uri()).thenReturn(document.location());
        assertEquals(title, titleDocument);
        document.title(title);
    }

    @Test
    public void testCreateElement() {
        Element element = document.createElement("tagName");
        Mockito.when(parser.parse(Mockito.any(String.class))).thenReturn(element);
        assertEquals(element, document.createElement("tagName"));
    }

    @Test
    public void testOuterHtml() {
        String outerHtml = "outerHtml";
        Document document = new Document(outerHtml);
        assertEquals(outerHtml, document.outerHtml());
    }

    @Test
    public void testText() {
        Element element = new Element();
        Mockito.when(parser.parse(Mockito.any(String.class))).thenReturn(element);
        Document textDocument = document.text("text");
        assertEquals(textDocument, document.text("text"));
    }

    @Test
    public void testNodeName() {
        String nodeName = "nodeName";
        Document document = new Document(nodeName);
        assertEquals(nodeName, document.nodeName());
    }

    @Test
    public void testCharset() {
        Charset charset = Charset.forName("utf-8");
        document.charset(charset);
        assertEquals(charset, document.charset());
    }

    @Test
    public void testUpdateMetaCharsetElement() {
        boolean update = true;
        document.updateMetaCharsetElement(update);
        assertTrue(document.updateMetaCharsetElement());
    }

    @Test
    public void testClone() {
        Document clone = document.clone();
        Mockito.when(parser.parse(Mockito.any(String.class))).thenReturn(clone);
        assertEquals(clone, document.clone());
    }

    @Test
    public void testShallowClone() {
        Document shallowClone = document.shallowClone();
        Mockito.when(parser.parse(Mockito.any(String.class))).thenReturn(shallowClone);
        assertEquals(shallowClone, document.shallowClone());
    }

    @Test
    public void testOutputSettings() {
        OutputSettings outputSettings = new OutputSettings();
        Document outputSettingsDocument = document.outputSettings(outputSettings);
        Mockito.when(parser.parse(Mockito.any(String.class))).thenReturn(outputSettingsDocument);
        assertEquals(outputSettingsDocument, document.outputSettings(outputSettings));
    }

    @Test
    public void testQuirksMode() {
        QuirksMode quirksMode = new QuirksMode();
        Document quirksModeDocument = document.quirksMode(quirksMode);
        Mockito.when(parser.parse(Mockito.any(String.class))).thenReturn(quirksModeDocument);
        assertEquals(quirksModeDocument, document.quirksMode(quirksMode));
    }

    @Test
    public void testParser() {
        Parser parser = new Parser();
        Document parserDocument = document.parser(parser);
        Mockito.when(parser.parse(Mockito.any(String.class))).thenReturn(parserDocument);
        assertEquals(parserDocument, document.parser(parser));
