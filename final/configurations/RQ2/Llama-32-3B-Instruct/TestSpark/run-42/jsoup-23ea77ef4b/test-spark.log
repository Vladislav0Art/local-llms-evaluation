public class W3CDomTest {

    @Test
    public void testContextNode() {
        Document wDoc = new org.jsoup.nodes.Document();
        Node contextNode = W3CDom.contextNode(wDoc);
        assertTrue(contextNode == null);
    }

    @Test
    public void testContextNodeId() {
        Document wDoc = new org.jsoup.nodes.Document();
        String id = "someId";
        Document node = wDoc.getElementById(id);
        assertNotNull(node);
        Node contextNode = W3CDom.contextNode(wDoc);
        assertEquals(id, contextNode.getId());
    }

    @Test
    public void testContextNodeAsElement() {
        Document wDoc = new org.jsoup.nodes.Document();
        Element element = wDoc.createElement("div");
        wDoc.appendChild(element);
        Node contextNode = W3CDom.contextNode(wDoc);
        assertTrue(contextNode instanceof org.jsoup.nodes.Element);
    }

    @Test
    public void testContextNodeAsElementString() {
        Document wDoc = new org.jsoup.nodes.Document();
        Element element = wDoc.createElement("div");
        wDoc.appendChild(element);
        String contextNodeStr = W3CDom.asString(W3CDom.contextNode(wDoc));
        assertEquals("<div>", contextNodeStr);
    }
}

public class W3CDom {

    public static Node contextNode(Document doc) {
        return null;
    }

    public static String asString(Node node) {
        return "";
    }
}
