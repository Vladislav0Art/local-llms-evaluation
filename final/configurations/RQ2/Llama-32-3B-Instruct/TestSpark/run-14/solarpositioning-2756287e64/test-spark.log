public class ZonedDateTimeGenerator {
    public static String generateDate(int year, int month, int dayOfMonth, int hour, int minute, int second, int nano) {
        return ZonedDateTime.of(year, month, dayOfMonth, hour, minute, second, nano, ZoneId.of("UTC"))
                .toString();
    }

    public static class Coordinates {
        public double latitude;
        public double longitude;

        public String generateCoordinate() {
            if (Double.isNaN(latitude)) latitude = 0;
            if (Double.isNaN(longitude)) longitude = 0;

            return latitude + " " + longitude;
        }
    }

