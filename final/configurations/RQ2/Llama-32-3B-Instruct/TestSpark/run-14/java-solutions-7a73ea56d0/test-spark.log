import org.junit.Test;
import static org.hamcrest.CoreMatchers.is;
import static org.junit.Assert.assertThat;
import java.util.Arrays;

public class OnlineStockSpanTest {

    @Test
    public void nextPrice_ReturnsNextDaySpan_WhenPriceIncrease() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int price = 10;
        int expectedSpan = 1;
        onlineStockSpan.next(price);
        assertThat(onlineStockSpan.next(price), is(expectedSpan));
    }

    @Test
    public void nextPrice_ReturnsNextDaySpan_WhenPriceDecrease() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int price = 10;
        int expectedSpan = 1;
        onlineStockSpan.next(price);
        onlineStockSpan.next(9);
        assertThat(onlineStockSpan.next(9), is(expectedSpan));
    }

    @Test
    public void nextPrice_ReturnsNextDaySpan_WhenSamePrice() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int price1 = 10;
        int price2 = 10;
        onlineStockSpan.next(price1);
        onlineStockSpan.next(price2);
        assertThat(onlineStockSpan.next(price2), is(1));
    }

    @Test
    public void calculateSpans_ReturnsCorrectArray_WhenEmptyPrices() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int[] prices = {};
        int[] expectedSpans = {};
        onlineStockSpan.calculateSpans(prices);
        assertThat(Arrays.equals(onlineStockSpan.calculateSpans(prices), expectedSpans), is(true));
    }

    @Test
    public void calculateSpans_ReturnsCorrectArray_WhenSinglePrice() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int[] prices = {10};
        int[] expectedSpans = {1};
        onlineStockSpan.calculateSpans(prices);
        assertThat(Arrays.equals(onlineStockSpan.calculateSpans(prices), expectedSpans), is(true));
    }

    @Test
    public void calculateSpans_ReturnsCorrectArray_WhenMultiplePrices() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int[] prices = {10, 9, 8};
        int[] expectedSpans = {2, 1, 1};
        onlineStockSpan.calculateSpans(prices);
        assertThat(Arrays.equals(onlineStockSpan.calculateSpans(prices), expectedSpans), is(true));
    }

    @Test
    public void calculateSpans_ReturnsCorrectArray_WhenMultiplePricesWithDifferentSpans() {
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        int[] prices = {10, 9, 8, 7};
        int[] expectedSpans = {3, 2, 1, 1};
        onlineStockSpan.calculateSpans(prices);
        assertThat(Arrays.equals(onlineStockSpan.calculateSpans(prices), expectedSpans), is(true));
    }

    @Test
    public void calculateSpans_MocksNext() {
        Stack<Integer> nextSpy = Mockito.spy(new Stack<>());
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        onlineStockSpan.next = nextSpy;
        int[] prices = {10, 9, 8};
        onlineStockSpan.calculateSpans(prices);
        Mockito.verify(nextSpy).push(10);
    }

    @Test
    public void calculateSpans_MocksNextForAllPrices() {
        Stack<Integer> nextSpy = Mockito.spy(new Stack<>());
        OnlineStockSpan onlineStockSpan = new OnlineStockSpan();
        onlineStockSpan.next = nextSpy;
        int[] prices = {10, 9, 8};
        onlineStockSpan.calculateSpans(prices);
        Mockito.verify(nextSpy).push(10); // correct
        Mockito.verify(nextSpy).push(9); // correct
        Mockito.verify(nextSpy).push(8); // correct
    }
}
