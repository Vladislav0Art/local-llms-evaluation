    public void checkItem_checkSpineItemIsCalledWhenOPFItemHasSpineItems() throws MalformedURLException {
        // given:
        OPFItem item = mock(OPFItem.class);

        when(context.getValidationResult()).thenReturn(Optional.empty());

        // when and then
        OPFChecker30 checker = new OPFChecker30(context);
        Set<FeatureReport.Feature> features = Iterables.collect(checker.checkItem(item, null), Features::isPresent);
        assertTrue(features.contains(mock(FeatureReport.Feature.class)));
    }

    @Test
    public void checkContent_checkMetadataIsCalledWhenOPFItemHasMetadata() throws MalformedURLException {
        // given:
        OPFItem item = mock(OPFItem.class);

        when(context.getValidationResult()).thenReturn(Optional.empty());

        // when and then
        OPFChecker30 checker = new OPFChecker30(context);
        Set<FeatureReport.Feature> features = Iterables.collect(checker.checkContent(item), Features::isPresent);
        assertTrue(features.contains(mock(FeatureReport.Feature.class)));
    }

    @Test
    public void checkItem_checkItemIsCalledForAllOPFItems() {
        // given:
        when(context.getValidationResult()).thenReturn(Optional.empty());

        // when and then
        OPFChecker30 checker = new OPFChecker30(context);
        Set<FeatureReport.Feature> features = Iterables.collect(checker.checkItem(null, null), Features::isPresent);
        assertFalse(features.isEmpty());
    }

    @Test
    public void checkItemAfterResourceValidation_checkItemIsCalledWhenOPFItemHasResources() {
        // given:
        OPFItem item = mock(OPFItem.class);

        when(context.getValidationResult()).thenReturn(Optional.empty());

        // when and then
        OPFChecker30 checker = new OPFChecker30(context);
        Set<FeatureReport.Feature> features = Iterables.collect(checker.checkItemAfterResourceValidation(item), Features::isPresent);
        assertTrue(features.contains(mock(FeatureReport.Feature.class)));
    }

    @Test
    public void isAudioType_isFalseWhenInputIsNotAudio() {
        // given:
        when(context.getValidationResult()).thenReturn(Optional.empty());

        // when and then
        OPFChecker30 checker = new OPFChecker30(context);
        assertFalse(checker.isAudioType("not_audio"));
    }

    @Test
    public void isVideoType_isFalseWhenInputIsNotVideo() {
        // given:
        when(context.getValidationResult()).thenReturn(Optional.empty());

