import org.jsoup.Connection;
import org.junit.Test;

import static org.junit.Assert.*;

import org.mockito.Mockito;

public class GeneratedTest {

    @Test
    public void builderInitializedWithUrl() {
        UrlBuilder builder = new UrlBuilder(new URL("https://example.com"));
        assertNotNull(builder);
    }

    @Test
    public void buildUrlReturnsCorrectlyConstructedUrl() throws MalformedURLException, URISyntaxException {
        UrlBuilder builder = new UrlBuilder(new URL("https://example.com/path/to/resource"));
        String result = builder.build().toString();
        assertTrue(result.contains("https://example.com/"));
        assertTrue(result.contains("/path/to/resource"));
    }

    @Test
    public void appendKeyValPreservesUrl() throws UnsupportedEncodingException, URISyntaxException {
        UrlBuilder builder = new UrlBuilder(new URL("https://example.com/path/to/resource"));
        String url = builder.build().toString();
        assertEquals(url, builder.appendKeyVal(Connection.KeyVal.of(0, url)).build().toString());
    }

    @Test
    public void appendKeyValPreservesUrlWithQuery() throws UnsupportedEncodingException, URISyntaxException {
        UrlBuilder builder = new UrlBuilder(new URL("https://example.com/path/to/resource?query=string"));
        String url = builder.build().toString();
        assertEquals(url, builder.appendKeyVal(Connection.KeyVal.of(0, url)).build().toString());
    }

    @Test
    public void appendKeyValModifiesUrl() throws UnsupportedEncodingException, URISyntaxException {
        UrlBuilder builder = new UrlBuilder(new URL("https://example.com/path/to/resource"));
        String url = builder.build().toString();
        assertEquals(url, builder.appendKeyVal(Connection.KeyVal.of(1, "new=query")).build().toString());
    }

    @Test
    public void appendKeyValModifiesUrlWithQuery() throws UnsupportedEncodingException, URISyntaxException {
        UrlBuilder builder = new UrlBuilder(new URL("https://example.com/path/to/resource?query=string"));
        String url = builder.build().toString();
        assertEquals(url, builder.appendKeyVal(Connection.KeyVal.of(1, "new=query")).build().toString());
