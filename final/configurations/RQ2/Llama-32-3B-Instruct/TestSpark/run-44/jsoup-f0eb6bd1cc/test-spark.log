import org.junit.Test;
import static org.junit.Assert.*;
import java.net.URI;
import java.net.URISyntaxException;

public class UrlBuilderTest {

    @Test
    public void newUrlBuilderCreationTest() {
        UrlBuilder builder = new UrlBuilder(null);
        assertNotNull(builder);
    }

    @Test
    public void buildEmptyUrlTest() throws URISyntaxException {
        UrlBuilder builder = new UrlBuilder(new URI("http://localhost"));
        URL url = builder.build();
        assertEquals("http://localhost", url.toString());
    }

    @Test
    public void buildValidUrlTest() throws URISyntaxException {
        UrlBuilder builder = new UrlBuilder(new URI("http://localhost/path"));
        URL url = builder.build();
        assertEquals("http://localhost/path", url.toString());
    }

    @Test
    public void appendKeyValWithEmptyValueTest() {
        UrlBuilder builder = new UrlBuilder(new URI("http://localhost"));
        builder.appendKeyVal(Connection.KeyVal.builder().key("a").value("").build());
        assertTrue(builder.build().toString().contains("?a="));
    }

    @Test
    public void appendKeyValWithNonEmptyValueTest() throws UnsupportedEncodingException {
        UrlBuilder builder = new UrlBuilder(new URI("http://localhost"));
        String value = URLEncoder.encode("non-empty-value", DataUtil.UTF_8);
        builder.appendKeyVal(Connection.KeyVal.builder().key("a").value(value).build());
        assertTrue(builder.build().toString().contains("?a=non-empty-value"));
    }

    @Test
    public void appendKeyValWithNullValueTest() {
        UrlBuilder builder = new UrlBuilder(new URI("http://localhost"));
        assertNotNull(builder.appendKeyVal(Connection.KeyVal.builder().key("a").value(null).build()));
        assertTrue(builder.build().toString().contains("?a="));
    }

}

