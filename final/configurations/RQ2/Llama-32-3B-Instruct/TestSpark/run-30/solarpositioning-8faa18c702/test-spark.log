    public void estimateZeroDeltaT() {
        LocalDate zeroDate = LocalDate.now();
        double result = DeltaT.estimate(zeroDate);
        assertEquals(0, result, 1e-9);
    }

    @Test
    public void estimateNegativeDeltaT() {
        LocalDate date = LocalDate.now().minusDays(10);
        double result = DeltaT.estimate(date);
        assertTrue(result < 0);
    }

    @Test
    public void estimatePositiveDeltaT() {
        LocalDate date = LocalDate.now().plusDays(10);
        double result = DeltaT.estimate(date);
        assertTrue(result > 0);
    }

    @Test
    public void estimateDifferentMonths() {
        LocalDate firstDay = LocalDate.of(2022, 12, 31);
        LocalDate secondDay = LocalDate.of(2023, 1, 10);
        double result = DeltaT.estimate(secondDay);
        assertTrue(result > DeltaT.estimate(firstDay));
    }

    @Test
    public void estimateDifferentYears() {
        LocalDate firstDate = LocalDate.now().minusYears(20);
        LocalDate secondDate = LocalDate.now();
        double result1 = DeltaT.estimate(firstDate);
        double result2 = DeltaT.estimate(secondDate);
        assertTrue(result1 < result2);
    }

    @Test
    public void estimateMockReturnsPositiveValue() {
        when(DeltaT.estimateMock()).thenReturn(10.0);
        double result = DeltaT.estimateMock();
        assertEquals(10, result, 1e-9);
    }

    @Test
    public void estimateMockReturnsNegativeValue() {
        when(DeltaT.estimateMock()).thenReturn(-5.0);
        double result = DeltaT.estimateMock();
        assertEquals(-5, result, 1e-9);
    }
}
