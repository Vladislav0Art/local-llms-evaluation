    public void getPackageName_ReturnsCorrectPackageNames() {
        when(nameConstants.getPackageNames()).thenReturn(PACKAGES);
        AppVersion appVersion = new AppVersion();
        assertEquals(PACKAGES, appVersion.getPackageName());
    }

    @Test
    public void getVersion_ReturnsCorrectBuildNumber() {
        when(nameConstants.getBuildNumber()).thenReturn(BUILD_NUMBER);
        AppVersion appVersion = new AppVersion();
        assertEquals(BUILD_NUMBER, appVersion.getVersion());
    }

    @Test
    public void getBuildJobName_ReturnsCorrectBuildJobName() {
        when(nameConstants.getBuildJobName()).thenReturn(BUILD_JOB_NAME);
        AppVersion appVersion = new AppVersion();
        assertEquals(BUILD_JOB_NAME, appVersion.getBuildJobName());
    }

    @Test
    public void getBuildNumber_ReturnsCorrectCommit() {
        when(nameConstants.getCommit()).thenReturn(COMMIT);
        AppVersion appVersion = new AppVersion();
        assertEquals(COMMIT, appVersion.getBuildNumber());
    }

    @Test
    public void getCommit_ReturnsCorrectChangelist() {
        @Deprecated
        String changelist = "changelist";
