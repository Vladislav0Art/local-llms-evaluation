        return scheme + "://" + netloc + path;
    }
}
```

And here's an example of how you could use it:

```java
public class Main {
    public static void main(String[] args) throws URISyntaxException {
        UrlBuilder builder = new UrlBuilder("https://example.com/path?query=value");
        System.out.println(builder.getScheme()); // prints "https"
        System.out.println(builder.getNetloc()); // prints "example.com"
        System.out.println(builder.getPath()); // prints "/path"
        System.out.println(builder.getQuery()); // prints "?query=value"

        builder.setPath("/subpath");
        System.out.println(builder); // prints "https://example.com/subpath?query=value"
    }
}
```

