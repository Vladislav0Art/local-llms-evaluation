import java.lang.reflect.Method;
import java.util.*;

public class GraphQLAnnotationsProcessor {

    public GraphQLAnnotationsException process(Object object, ProcessingElementsContainer container) throws GraphQLAnnotationsException {
        Set<String> foundDirectives = new HashSet<>();

        Class<?> clazz = object.getClass();
        for (Method method : clazz.getDeclaredMethods()) {
            if (method.isAnnotationPresent(GraphQLDirective.class)) {
                String directiveName = ((GraphQLDirective) method.getAnnotation(GraphQLDirective.class)).value();
                foundDirectives.add(directiveName);
            }
        }

        List<GraphQLDirective> directives = new ArrayList<>(foundDirectives);

        for (Method method : clazz.getDeclaredMethods()) {
            if (method.isAnnotationPresent(GraphQLDirective.class)) {
                GraphQLDirective annotation = method.getAnnotation(GraphQLDirective.class);
                String directiveName = annotation.value();

                try {
                    Method originalMethod = clazz.getMethod(method.getName(), getParameterTypes(method));
                    Object[] params = getParameterValues(originalMethod, container);

                    if (params != null) {
                        // Process the method with the found directives
                        Object result = processMethodWithDirectives(method, originalMethod, params);
                        return new GraphQLAnnotationsException(result);
                    }
                } catch (NoSuchMethodException ex) {
                    // Ignore methods without parameters
                }
            }
        }

        if (!foundDirectives.isEmpty()) {
            throw new GraphQLAnnotationsException("No directives found on the object");
        }

        return null;
    }

    private Class<?>[] getParameterTypes(Method method) {
        Parameter[] parameters = method.getParameters();
        Class<?>[] types = new Class<?>[parameters.length];
        for (int i = 0; i < parameters.length; i++) {
            types[i] = parameters[i].getType();
        }
        return types;
    }

