package ch.jalu.configme.configurationdata;

import org.junit.Test;
import static org.junit.Assert.*;
import java.util.*;

public class PropertyListBuilderTest {

    @Test
    public void addProperty_DoesAddPropertyToInternalList() {
        List<Property<?>> internalList = new ArrayList<>();
        Property<?> property = new Property<>("test", "test");
        PropertyListBuilder builder = new PropertyListBuilder();
        builder.add(property);
        assertEquals(1, builder.create().size());
    }

    @Test
    public void addProperty_DoesNotAddDuplicateProperties() {
        List<Property<?>> internalList = new ArrayList<>();
        Property<?> property = new Property<>("test", "test");
        PropertyListBuilder builder = new PropertyListBuilder();
        builder.add(property);
        assertEquals(1, builder.create().size());
        assertTrue(builder.create().get(0) == property);
    }

    @Test
    public void create_ReturnsNotEmptyList() {
        List<Property<?>> internalList = new ArrayList<>();
        PropertyListBuilder builder = new PropertyListBuilder();
        builder.add(new Property<>("test", "test"));
        assertNotEquals(0, builder.create().size());
    }

    @Test
    public void getRootEntries_ReturnsNotEmptyMap() {
        Map<String, Object> map = new LinkedHashMap<>();
        assertEquals(1, ((LinkedHashMap) PropertyListBuilder.getRootEntries()).size());
    }
}
