public class DataFrame {

    private ListRow[] rows;

    public DataFrame() {
        this.rows = new ArrayListRow[0];
    }

    public DataFrame(ListRow[] rows) {
        this.rows = rows;
    }

    public DataFrame selectAll() {
        return new DataFrame();
    }

    public DataFrame selectFlagged() {
        ListRow[] filteredRows = new ArrayListRow[rows.length];
        int j = 0;
        for (ListRow row : rows) {
            boolean isFlagged = false;
            for (int value : row.values) {
                if (value == 1) {
                    isFlagged = true;
                    break;
                }
            }
            if (isFlagged) {
                filteredRows[j++] = row;
            }
        }
        ListRow[] tempRows = new ArrayListRow[j];
        System.arraycopy(filteredRows, 0, tempRows, 0, j);
        return new DataFrame(tempRows);
    }

    public DataFrame sortBy(DfColumnSortOrder sortOrders) {
        ListRow[] sortedRows = rows.clone();
        Collections.sort(sortedRows, (a, b) -> {
            int column = a.values[sortOrders.columnName.ordinal()];
            if (column == 0 || column == 1) {
                return Integer.compare(column, b.values[sortOrders.columnName.ordinal()]);
            } else {
                return Integer.compare(a.values[2], b.values[2]);
            }
        });
        return new DataFrame(sortedRows);
    }

    public DataFrame distinct() {
        Set<ListRow> uniqueRows = new HashSet<>();
        for (ListRow row : rows) {
            boolean found = false;
            for (ListRow uniqueRow : uniqueRows) {
                if (Arrays.equals(row.values, uniqueRow.values)) {
                    found = true;
                    break;
                }
            }
            if (!found) {
                uniqueRows.add(row);
            }
        }

        ListRow[] distinctRows = new ArrayListRow[uniqueRows.size()];
        int i = 0;
        for (ListRow row : uniqueRows) {
            distinctRows[i++] = row;
        }
        return new DataFrame(distinctRows);
    }

    public static class ListRow implements Comparable<ListRow> {
        private int[] values;

        public ListRow(int[] values) {
            this.values = values;
        }

        @Override
        public int compareTo(ListRow other) {
            for (int i = 0; i < values.length && i < other.values.length; i++) {
                if (!values[i].equals(other.values[i])) {
                    return Integer.compare(values[i], other.values[i]);
                }
            }
            return Integer.compare(values.length, other.values.length);
        }

        @Override
        public boolean equals(Object o) {
            if (this == o) return true;
            if (o == null || getClass() != o.getClass()) return false;
            ListRow that = (ListRow) o;
            return Arrays.equals(values, that.values);
        }

        @Override
        public int hashCode() {
            return Arrays.hashCode(values);
        }
    }

    public static class DfColumnSortOrder implements Comparable<DfColumnSortOrder> {
        private String columnName;
        private boolean ascending;

        public DfColumnSortOrder(String columnName, boolean ascending) {
            this.columnName = columnName;
            this.ascending = ascending;
        }

        @Override
        public int compareTo(DfColumnSortOrder other) {
            return this.columnName.compareTo(other.columnName);
        }
    }
}
