    public DataFrame distinct() {
        // Calculate the discriminant for each row in the dataframe
        Set<ListRow> uniqueRows = new HashSet<>();
        ListRow[] distinctRows = new ArrayListRow[uniqueRows.size()];
        int i = 0;
        for (ListRow row : rows) {
            boolean found = false;
            for (int j = 0; j < i; j++) {
                if (row.values.equals(distinctRows[j].values)) {
                    found = true;
                    break;
                }
            }
            if (!found) {
                uniqueRows.add(row);
                distinctRows[i++] = row;
            }
        }
        return new DataFrame(distinctRows);
