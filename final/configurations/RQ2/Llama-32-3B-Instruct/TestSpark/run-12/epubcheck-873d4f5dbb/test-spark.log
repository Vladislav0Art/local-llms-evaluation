    public void checkPackage_shouldReturnTrue() {
        // when
        boolean result = new OPFChecker30(context).checkPackage();

        // then
        assertTrue(result);
    }

    @Test
    public void checkContent_shouldReturnFalse() {
        // when
        boolean result = new OPFChecker30(context).checkContent();

        // then
        assertFalse(result);
    }

