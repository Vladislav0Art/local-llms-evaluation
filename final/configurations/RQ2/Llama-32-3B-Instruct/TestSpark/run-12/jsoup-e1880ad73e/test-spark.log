    public void appendKeyVal_keyAndValueAreEncodedCorrectlyWithMultipleSpaces() throws Exception {
        Document doc = Jsoup.connect("https://example.com").get();
        Elements urls = doc.select("[name='url']");
        String keyValue = urls.attr(0);
        assertEquals("https://example.com/value%20with%20multiple%20spaces", keyValue);
    }

