        assertEquals("https://example.com/=", keyValue);
    }

    public void appendKeyVal_keyAndValueAreEncodedCorrectlyWithEmptyString() throws Exception {
        Document doc = Jsoup.connect("https://example.com").get();
        Elements urls = doc.select("[name='url']");
        String keyValue = urls.attr(0);
        assertEquals("https://example.com/", keyValue);
