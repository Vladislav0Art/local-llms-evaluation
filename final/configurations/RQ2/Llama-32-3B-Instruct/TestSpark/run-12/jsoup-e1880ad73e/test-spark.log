    public void appendKeyVal_keyAndValueAreEncodedCorrectly() throws Exception {
        Document doc = Jsoup.connect("https://example.com").get();
        Elements urls = doc.select("[name='url']");
        String keyValue = urls.attr(0);
        assertEquals("https://example.com/value", keyValue);
    }

    public void appendKeyVal_keyAndValueAreEncodedCorrectlyWithNull() throws Exception {
        Document doc = Jsoup.connect("https://example.com").get();
        Elements urls = doc.select("[name='url']");
