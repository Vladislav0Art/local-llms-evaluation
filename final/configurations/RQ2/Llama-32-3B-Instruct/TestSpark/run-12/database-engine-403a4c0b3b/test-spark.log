    public void testUpdate() {
        // Arrange
        String[] values = {"1", "2", "3"};
        // Act
        db.update("testTable", "testColumn", values);
        // Assert
        assertEquals(3, db.countRows("testTable"));
    }

    @Test
    public void testDelete() {
