import java.io.StringWriter;
import java.util.Map;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertTrue;
import static org.mockito.Mockito.when;

@RunWith(SpringJUnit4ClassRunner.class)
@ContextConfiguration(classes = CssFormatter.class)
public class CssFormatterTest {

    @Mock
    private ConfigurationSource cfg;

    @Autowired
    private CssFormatter formatter;

    @Before
    public void setup() {
        MockitoAnnotations.initMocks(this);
    }

    @Test
    public void init_EmptyMap_initCorrectly() throws Exception {
        String result = "";
        Map<String, String> options = new java.util.HashMap<>();
        when(cfg.getOptions()).thenReturn(options);

        formatter.init(options, cfg);

        assertEquals(result, formatter.doFormat("", LineEnding.LF));
    }

    @Test
    public void doFormat_WellFormedCssFormatCorrectly() throws Exception {
        String cssCode = "body { color: red; }";
        String expected = "body { color: red; }\n";

        Map<String, String> options = new java.util.HashMap<>();
        when(cfg.getOptions()).thenReturn(options);

        formatter.init(options, cfg);
        StringWriter output = new StringWriter();
        formatter.doFormat(cssCode, LineEnding.LF).writeTo(output);
        String result = output.toString();

        assertEquals(expected, result);
    }

    @Test
    public void doFormat_WronglyFormedCss_formatCorrectly() throws Exception {
        String cssCode = "body { color: red";
        String expected = "body { color: red; }\n";

        Map<String, String> options = new java.util.HashMap<>();
        when(cfg.getOptions()).thenReturn(options);

        formatter.init(options, cfg);
        StringWriter output = new StringWriter();
        formatter.doFormat(cssCode, LineEnding.LF).writeTo(output);
        String result = output.toString();

        assertEquals(expected, result);
    }

    @Test
    public void doFormat_MissingClosingBrace_formatCorrectly() throws Exception {
        String cssCode = "body { color: red";
        String expected = "body { color: red; }\n";

        Map<String, String> options = new java.util.HashMap<>();
        when(cfg.getOptions()).thenReturn(options);

        formatter.init(options, cfg);
        StringWriter output = new StringWriter();
        formatter.doFormat(cssCode, LineEnding.LF).writeTo(output);
        String result = output.toString();

        assertEquals(expected, result);
    }

    @Test
    public void doFormat_TooManyOpeningBraces_formatCorrectly() throws Exception {
        String cssCode = "body { color: red; }";
        String expected = "body { color: red; }\n";

        Map<String, String> options = new java.util.HashMap<>();
        when(cfg.getOptions()).thenReturn(options);

        formatter.init(options, cfg);
        StringWriter output = new StringWriter();
        formatter.doFormat(cssCode + " {", LineEnding.LF).writeTo(output);
        String result = output.toString();

        assertEquals(expected, result);
    }

    @Test
    public void isInitialized_ReturnsCorrectResult() {
        assertTrue(formatter.isInitialized());
    }
}
