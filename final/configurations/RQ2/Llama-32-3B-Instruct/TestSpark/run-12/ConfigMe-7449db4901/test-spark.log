public class CommentsConfiguration {
    private SettingsHolder settingsHolder;
    private Map<String, Object[]> comment;

    public CommentsConfiguration(Map<String, Object[]> map) {
        this.comment = map;
    }

    public void setComment(String path, List<String> commentLines) {
        if (commentLines == null || Arrays.asList(commentLines).contains("")) {
            return;
        }
        settingsHolder.getCommentMap().put(path, commentLines.toArray());
    }

    public Object[] getComment(String path) {
        return settingsHolder.getCommentMap().get(path);
    }

    public Map<String, List<String>> getAllComments() {
        return settingsHolder.getCommentMap();
    }
}

