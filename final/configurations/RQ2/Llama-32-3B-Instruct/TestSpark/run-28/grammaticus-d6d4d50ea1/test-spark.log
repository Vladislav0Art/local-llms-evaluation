import java.util.*;

public class TestGrammar {
    public static void main(String[] args) {
        System.out.println("Running TestGrammar...");
        
        try {
            TestGrammar();
        } catch (Exception e) {
            System.out.println("Error running tests: " + e.getMessage());
        }
        System.out.println("TestGrammar finished.");
    }

    public static void TestGrammar() throws Exception {
        // Create a new dictionary
        Dictionary dictionary = new Dictionary();

        // Add terms to the dictionary
        dictionary.addTerm(new GrammaticalTerm("Term1", "Value1"));
        dictionary.addTerm(new GrammaticalTerm("Term2", "Value2"));
        dictionary.addTerm(new GrammaticalTerm("Term3", "Value3"));

        // Test 1: Check if terms are included in the map
        String[] test1Terms = {"Term1", "Term2"};
        Set<GrammaticalTerm> termsToInclude = new HashSet<>();
        for (GrammaticalTerm term : dictionary.getTerms()) {
            termsToInclude.add(term);
        }
        
        // Test 2: Check if keys are included in the map
        String[] test2Terms = {"Term4", "Term5"};
        Set<String> keys = new HashSet<>();
        for (GrammaticalTerm term : dictionary.getTerms()) {
            keys.add(term.getKey());
        }

        System.out.println("Test 1: Terms included in the map");
        printSet(termsToInclude);

        System.out.println("Test 2: Keys included in the map");
        printSet(keys);

        // Test 3: Check if terms are not included in the map
        String[] test3Terms = {"Term6", "Term7"};
        Set<GrammaticalTerm> termsToExclude = new HashSet<>();
        for (GrammaticalTerm term : dictionary.getTerms()) {
            termsToExclude.add(term);
        }

        System.out.println("Test 3: Terms excluded from the map");
        printSet(termsToExclude);

        // Test 4: Check if keys are not included in the map
        String[] test4Terms = {"Term8", "Term9"};
        Set<String> keysToExclude = new HashSet<>();
        for (GrammaticalTerm term : dictionary.getTerms()) {
            keysToExclude.add(term.getKey());
        }

        System.out.println("Test 4: Keys excluded from the map");
        printSet(keysToExclude);
    }

    public static void printSet(Set<GrammaticalTerm> set) {
        if (set == null || set.isEmpty()) {
            System.out.println("Empty Set");
        } else {
            for (GrammaticalTerm term : set) {
                System.out.print(term.getKey() + " ");
            }
            System.out.println();
        }
    }

    class GrammaticalTerm {
        private String key;
        private String value;

        public GrammaticalTerm(String key, String value) {
            this.key = key;
            this.value = value;
        }

        public String getKey() {
            return key;
        }

        public void setKey(String key) {
            this.key = key;
        }

        public String getValue() {
            return value;
        }
    }

    class Dictionary extends LanguageDictionary {
        @Override
        public void addTerm(GrammaticalTerm term) {
            super.addTerm(term);
        }

        @Override
        protected Collection<GrammaticalTerm> getTerms() {
            Set<GrammaticalTerm> terms = new HashSet<>();
            for (Object obj : super.getTerms()) {
                if (obj instanceof GrammaticalTerm) {
                    terms.add((GrammaticalTerm) obj);
                }
            }
            return terms;
        }

        @Override
        protected String getKey(Object term) {
            return ((GrammaticalTerm) term).getKey();
        }

        @Override
        public String getValue(String key) {
            // Return an empty string if the key is not found
            return "";
        }
    }

    class LanguageDictionary extends Dictionary {
    }

    class HashSetTest extends TestGrammar {}
}
