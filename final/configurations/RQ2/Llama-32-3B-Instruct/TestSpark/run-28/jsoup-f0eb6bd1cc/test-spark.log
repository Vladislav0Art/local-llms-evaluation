    @Test
    public void appendKeyValNoKey() throws UnsupportedEncodingException {
        Connection.KeyVal kv = new Connection.KeyVal(null, "value");
        UrlBuilder urlBuilder = new UrlBuilder(new URL("http://example.com"));
