package org.jsoup.helper;

import org.jsoup.Connection;
import org.jsoup.internal.StringUtil;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;

import java.io.UnsupportedEncodingException;
import java.net.IDN;
import java.net.MalformedURLException;
import java.net.URI;
import java.net.URISyntaxException;
import java.net.URL;
import java.net.URLDecoder;
import java.net.URLEncoder;
import static org.jsoup.helper.DataUtil.UTF_8;

public class UrlBuilderTest {

    @Mock
    private Connection connection;

    @RunWith(MockitoJUnitRunner.class)
    public void testUrlBuilder constructor() {
        // given
        URL inputUrl = new URL("https://www.example.com");
        // when
        UrlBuilder urlBuilder = new UrlBuilder(inputUrl);
        // then
        org.junit.Assert.assertNotNull(urlBuilder);
        org.junit.Assert.assertEquals(inputUrl, urlBuilder.inputUrl);
    }

    @Test
    public void testBuild_urlWithoutQuery() {
        // given
        UrlBuilder urlBuilder = new UrlBuilder(new URL("https://www.example.com"));
        Connection.KeyVal[] kv = {};
        // when
        String url = urlBuilder.build();
        // then
        org.junit.Assert.assertEquals("https://www.example.com", url);
    }

    @Test
    public void testBuild_urlWithQuery() {
        // given
        UrlBuilder urlBuilder = new UrlBuilder(new URL("https://www.example.com?a=1&b=2"));
        Connection.KeyVal[] kv = {Connection.KeyVal.of("a", "valueA")};
        // when
        String url = urlBuilder.build();
        // then
        org.junit.Assert.assertEquals("https://www.example.com?a=valueA&b=2", url);
    }

    @Test
    public void testAppendKeyVal_urlWithoutQuery() {
        // given
        UrlBuilder urlBuilder = new UrlBuilder(new URL("https://www.example.com"));
        Connection.KeyVal kv = Connection.KeyVal.of("a", "valueA");
        // when
        try {
            urlBuilder.appendKeyVal(kv);
            org.junit.Assert.fail();
        } catch (UnsupportedEncodingException e) {
            // expected exception
        }
    }

    @Test
    public void testAppendKeyVal_urlWithQuery() {
        // given
        UrlBuilder urlBuilder = new UrlBuilder(new URL("https://www.example.com?a=1&b=2"));
        Connection.KeyVal kv = Connection.KeyVal.of("a", "valueA");
        // when
        try {
            urlBuilder.appendKeyVal(kv);
            org.junit.Assert.fail();
        } catch (UnsupportedEncodingException e) {
            // expected exception
        }
    }

    @Test
    public void testUrlBuilding_withIDN() {
        // given
        UrlBuilder urlBuilder = new UrlBuilder(new URL("https://www.example.com"));
        String query = "a=" + URLEncoder.encode("valueA", UTF_8) + "&b=2";
        // when
        String url = urlBuilder.build(query);
        // then
        org.junit.Assert.assertEquals("https://www.example.com?" + query, url);
    }

    @Test
    public void testUrlBuilding_withMalformedURL() {
        // given
        UrlBuilder urlBuilder = new UrlBuilder(new URL("invalid://www.example.com"));
        String query = "a=" + URLEncoder.encode("valueA", UTF_8) + "&b=2";
        // when
        try {
            urlBuilder.build(query);
            org.junit.Assert.fail();
        } catch (MalformedURLException e) {
            // expected exception
        }
    }

    @Test
    public void testAppendKeyVal_encoding() throws UnsupportedEncodingException {
        // given
        UrlBuilder urlBuilder = new UrlBuilder(new URL("https://www.example.com"));
        Connection.KeyVal kv = Connection.KeyVal.of("a", "valueA");
        // when
        String encodedQuery = urlBuilder.appendKeyVal(kv);
        org.junit.Assert.assertEquals("a=valueA&b=2", encodedQuery);
    }

    @Test
    public void testAppendKeyVal_encoding_withInvalidCharacter() throws UnsupportedEncodingException {
        // given
        UrlBuilder urlBuilder = new UrlBuilder(new URL("https://www.example.com"));
        Connection.KeyVal kv = Connection.KeyVal.of("a", "valueA");
        String invalidChar = String.valueOf((char) 0x7f);
        // when
        try {
            urlBuilder.appendKeyVal(kv);
            org.junit.Assert.fail();
        } catch (UnsupportedEncodingException e) {
            // expected exception
        }
    }

}
