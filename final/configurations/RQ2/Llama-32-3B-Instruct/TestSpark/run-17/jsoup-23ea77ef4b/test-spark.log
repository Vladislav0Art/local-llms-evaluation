public class W3CDomTest {

    @Test
    public void namespaceAware_ReturnsTrue() {
        assertFalse(W3CDom.namespaceAware());
    }

    @Test
    public void namespaceAware_WrapperMethod() {
        assertTrue(W3CDom.namespaceAware(true));
    }

    @Test
    public void convert_TakesJsoupDocument() {
        Document soup = Document.createElement();
        Document doc = W3CDom.convert(soup);
        assertNotNull(doc);
    }

    @Test
    public void asString_TakesDocAndProperties() {
        Document doc = Document.createElement();
        String output = W3CDom.asString(doc, null);
        assertNotNull(output);
    }

    @Test
    public void propertiesFromMap_ReturnsProperties() {
        Properties expected = new Properties();
        expected.setProperty("property", "value");
        Properties actual = W3CDom.propertiesFromMap(new HashMap<String, String>() {{
            put("property", "value");
        }});
        assertEquals(expected, actual);
    }

    @Test
    public void OutputHtml_ReturnsHashMap() {
        assertNotNull(W3CDom.OutputHtml());
    }

    @Test
    public void OutputXml_ReturnsHashMap() {
        assertNotNull(W3CDom.OutputXml());
    }

    @Test
    public void fromJsoup_TakesDoc() {
        Document soup = Document.createElement();
        Document expected = W3CDom.convert(soup);
        Document actual = W3CDom.fromJsoup(soup);
        assertEquals(expected, actual);
    }

    @Test
    public void fromJsoup_TakesElement() {
        Element element = Document.createElement();
        Document expected = W3CDom.convert(element);
        Document actual = W3CDom.fromJsoup(element);
        assertEquals(expected, actual);
    }

    @Test
    public void convert_TakesDocumentAndOut() {
        Document doc = Document.createElement();
        Document out = new Document();
        W3CDom.convert(doc, out);
    }

    @Test
    public void convert_TakesElementAndOut() {
        Element element = Document.createElement();
        Document out = new Document();
        W3CDom.convert(element, out);
    }

    @Test
    public void selectXpath_TakesXPathAndDoc() {
        NodeList expected = W3CDom.selectXpath("//tag", Document.createElement());
        NodeList actual = W3CDom.selectXpath("//tag", Document.createElement());
        assertEquals(expected, actual);
    }

    @Test
    public void selectXpath_TakesContextNodeAndXPath() {
        NodeList expected = W3CDom.selectXpath("//tag", Document.createElement());
        NodeList actual = W3CDom.selectXpath("//tag", Document.createElement());
        assertEquals(expected, actual);
    }

