public class StockSpanner {
    private int[] stack;

    public StockSpanner() {
        stack = new int[0];
    }

    public int calculateSpans(int[] prices) {
        for (int i = 0; i < prices.length; i++) {
            int count = 1;
            while (!stack.isEmpty() && stack[stack.length - 1] <= prices[i]) {
                int top = stack[stack.length - 1];
                stack.remove(stack.length - 1);
                if (top == prices[i - 1]) {
                    count += stack[stack.length - 1];
                } else {
                    count++;
                }
            }
            stack = addElementToStack(count, i, stack);
        }
        return stack[0];
    }

    private int[] addElementToStack(int count, int index, int[] stack) {
        int[] tempStack = new int[stack.length + 1];
        for (int i = 0; i < stack.length; i++) {
            tempStack[i] = stack[i];
        }
        tempStack[tempStack.length - 1] = count;
        return tempStack;
    }
}

public class Main {
    public static void main(String[] args) {
        StockSpanner stockSpanner = new StockSpanner();
        int[] prices = {100, 80, 75, 70, 60, 85};
        System.out.println(stockSpanner.calculateSpans(prices));
    }
}
