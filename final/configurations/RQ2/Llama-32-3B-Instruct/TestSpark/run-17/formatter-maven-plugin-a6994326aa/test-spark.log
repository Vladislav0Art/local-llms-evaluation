    public void init_ValidOptions_CacheIsInitialized() throws IOException {
        CssFormatter formatter = new CssFormatter();
        Mockito.when(cfg.getCacheDirectory()).thenReturn("path/to/cache");
        Mockito.when(options.get(CssFormatter.OPTIONS_CACHE)).thenReturn(true);
        Mockito.when(options.get(CssFormatter.OPTIONS_DEBUG)).thenReturn(false);

        formatter.init(options, cfg);
        assert (formatter.isInitialized());
    }

    @Test
    public void init_InvalidOptions_CacheIsNotInitialized() throws IOException {
        CssFormatter formatter = new CssFormatter();
        Mockito.when(cfg.getCacheDirectory()).thenReturn("path/to/cache");
        Mockito.when(options.get(CssFormatter.OPTIONS_CACHE)).thenReturn(false);
        Mockito.when(options.get(CssFormatter.OPTIONS_DEBUG)).thenReturn(true);

        formatter.init(options, cfg);
        assert (!formatter.isInitialized());
    }

    @Test
    public void doFormat_CleanCss_ReturnsCleanCss() throws IOException {
        CssFormatter formatter = new CssFormatter();
        String cssCode = "/* clean css */";
        LineEnding lineEnding = LineEnding.LF;

        String formattedCss = formatter.doFormat(cssCode, lineEnding);
        assert (formattedCss.contains("/*"));
    }

