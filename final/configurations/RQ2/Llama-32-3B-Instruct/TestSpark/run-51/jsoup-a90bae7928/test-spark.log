    public void [parseElementWithAttributeAndNoContent]Test() throws Exception {
        String input = "<element attr=\"value\"></element>";
        Document document = xmlTreeBuilder.parse(new StringReader(input), "");
        assert null != document;
    }

    // Test parsing a single element with content
    public void [parseSingleElementWithContent]Test() throws Exception {
        String input = "<element>content</element>";
        Document document = xmlTreeBuilder.parse(new StringReader(input), "");
        assert null != document;
    }

    // Test parsing an element with attributes and content
    public void [parseElementWithAttributesAndContent]Test() throws Exception {
        String input = "<element attr=\"value\">content</element>";
        Document document = xmlTreeBuilder.parse(new StringReader(input), "");
        assert null != document;
    }

