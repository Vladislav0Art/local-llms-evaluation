    // Test parsing a single element with no attributes and no content
    public void [parseSingleElementWithNoAttributesAndNoContent]Test() throws Exception {
        String input = "<element></element>";
        Document document = xmlTreeBuilder.parse(new StringReader(input), "");
        assert null != document;
    }

