        subject = new OPFChecker30();
    }

    @Test
    public void testInitHandler() {
        try {
            subject.initHandler();
        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    @Test
    public void testCheckPackage() {
        boolean result = subject.checkPackage();
        Mockito.when(subject.getValidationResult()).thenReturn(result);
        assertTrue(subject.getValidationResult());
