        assertTrue(result);
    }

    @Test
    public void testIsAudioType() {
        String type = "audio";
        boolean result = isAudioType(type);
        assertTrue(result.equals("audio"));
    }

    private boolean isAudioType(String type) {
        return type.equals("audio");
    }

}
