import java.util.*;

public class DataFrame {
    private List<String> columnNames;
    private List<Column> columns;
    private Map<String, Object[]> data;

    // Constructor
    public DataFrame(List<String> columnNames, List<Column> columns, Map<String, Object[]> data) {
        this.columnNames = columnNames;
        this.columns = columns;
        this.data = data;
    }

    // Getters and setters
    public List<String> getColumnNames() {
        return columnNames;
    }

    public List<Column> getColumns() {
        return columns;
    }

    public Map<String, Object[]> getData() {
        return data;
    }

    // Method to select rows based on a filter expression
    public DataFrame selectBy(String filterExpressionString) {
        Map<String, Object[]> filteredData = new HashMap<>();
        for (Object[] row : data.values()) {
            boolean match = true;
            String[] parts = filterExpressionString.split(",");
            for (int i = 0; i < parts.length; i++) {
                if (!row[i].equals(parts[i])) {
                    match = false;
                    break;
                }
            }
            if (match) {
                filteredData.put(row[0], row);
            }
        }
        return new DataFrame(columnNames, columns, filteredData);
    }

    // Method to drop a column
    public DataFrame dropColumn(String columnName) {
        List<String> newColumnNames = new ArrayList<>();
        for (String name : columnNames) {
            if (!name.equals(columnName)) {
                newColumnNames.add(name);
            }
        }
        Map<String, Object[]> newData = new HashMap<>();
        for (Object[] row : data.values()) {
            Object[] newRow = new Object[newRow.length - 1];
            System.arraycopy(row, 0, newRow, 0, newRow.length - 1);
            newRow[rowNew.length] = null;
            if (row[newRow.length] != null) {
                newData.put(String.valueOf(newRow.length), row);
            }
        }
        return new DataFrame(newColumnNames, columns.subList(0, columns.indexOf(columnName)), newData);
    }

    // Method to drop a row
    public DataFrame dropRow(String rowValue) {
        Map<String, Object[]> filteredData = new HashMap<>();
        for (Object[] row : data.values()) {
            if (!row[0].equals(rowValue)) {
                filteredData.put(row[0], row);
            }
        }
        return new DataFrame(columnNames, columns, filteredData);
    }

    // Method to calculate the mean of a column
    public Double calculateMean(String columnName) {
        double sum = 0;
        int count = 0;
        for (Object[] row : data.values()) {
            if (row.length > 1 && row[1].equals(columnName)) {
                sum += (double) row[2];
                count++;
            }
        }
        return count == 0 ? null : sum / count;
    }

    // Method to calculate the standard deviation of a column
    public Double calculateStdDev(String columnName) {
        double mean = calculateMean(columnName);
        double sumSquares = 0;
        int count = 0;
        for (Object[] row : data.values()) {
            if (row.length > 1 && row[1].equals(columnName)) {
                double value = (double) row[2];
                sumSquares += Math.pow(value - mean, 2);
                count++;
            }
        }
        return count == 0 ? null : Math.sqrt(sumSquares / count);
    }

    // Method to print the DataFrame
    public void print() {
        for (Object[] row : data.values()) {
            for (int i = 0; i < row.length; i++) {
                System.out.print(row[i] + " ");
            }
            System.out.println();
        }
    }

    // Method to execute a procedure on the DataFrame
    public void executeProcedure(Procedure<DfCursor> procedure) {
        DfCursor cursor = new DfCursor(data);
        Thread thread = new Thread(new Procedure<>(cursor));
        thread.start();
    }
}

public class Column {
    private String name;

    public Column(String name) {
        this.name = name;
    }

    public String getName() {
        return name;
    }
}

class Procedure<DfCursor> implements Runnable {
    private DfCursor cursor;

    public Procedure(DfCursor cursor) {
        this.cursor = cursor;
    }

    @Override
    public void run() {
        // Execute the procedure
        while (cursor.hasNext()) {
            Object[] row = cursor.next();
            System.out.println(Arrays.toString(row));
            try {
                Thread.sleep(100);
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
            }
        }
    }

    public void executeProcedure(Object[] row) {
        System.out.println(Arrays.toString(row));
    }
}

public class DfCursor implements Iterator<Object[]> {
    private Map<String, Object[]> data;

    public DfCursor(Map<String, Object[]> data) {
        this.data = data;
    }

    @Override
    public boolean hasNext() {
        return !data.isEmpty();
    }

    @Override
    public Object[] next() {
        return data.keySet().iterator().next();
    }
}
