```java
import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.select.Elements;

public class Tag {
    private String name;
    private boolean selfClosing;

    public Tag(String name) {
        this.name = name;
    }

    public void setSelfClosing(boolean selfClosing) {
        this.selfClosing = selfClosing;
    }

    public String getName() {
        return name;
    }
}

public class GeneratedTest {

    @org.junit.Test
    public void test() {
        Document doc = Jsoup.parse("<html><body><h1>Hello</h1></body></html>");
        Element h1 = doc.selectFirst("h1");
        Tag tag = new Tag(h1.tagName());
        System.out.println(tag.getName());
    }

    @org.junit.Test
    public void testIsFormListed() {
        Document doc = Jsoup.parse("<form><input type='text'></form>");
        Elements forms = doc.getElementsByTag("form");
        boolean result = !forms.isEmpty();
        System.out.println(result);
    }

    @org.junit.Test
    public void testIsFormSubmittable() {
        Document doc = Jsoup.parse("<form action='/submit' method='post'><input type='text'></form>");
        Elements forms = doc.getElementsByTag("form");
        boolean result = !forms.isEmpty();
        String formAction = ((Element) forms.get(0)).attr("action");
        System.out.println(result && !formAction.isEmpty());
    }
}
```

In this code, `testIsFormListed` method checks if the HTML document contains any `<form>` elements. If there are no `<form>` elements, it returns false. 

In `testIsFormSubmittable` method, it first checks if a `<form>` element exists in the HTML document. Then, it retrieves the action attribute of the first form element and checks if the action is not empty. It returns true only if both conditions are met.
