import java.net.URI;
import java.net.URISyntaxException;

public class Connection {
    public static enum KeyVal { KEY1, VALUE1, KEY2, VALUE2 }
}

public class URL {
    private String scheme;
    private String host;
    private String query;

    public URL(String url) throws URISyntaxException {
        URI uri = new URI(url);
        this.scheme = uri.getScheme();
        this.host = uri.getHost();
        this.query = uri.getQuery();
    }

    public void setScheme(String scheme) {
        this.scheme = scheme;
    }

    public void setHost(String host) {
        this.host = host;
    }

    public void setQuery(String query) {
        this.query = query;
    }

    public String getScheme() {
        return scheme;
    }

    public String getHost() {
        return host;
    }

    public String getQuery() {
        return query;
    }
}

public class ConnectionKeyVal {
    private Connection.KeyVal key;
    private String value;

    public ConnectionKeyVal(Connection.KeyVal key, String value) {
        this.key = key;
        this.value = value;
    }

    @Override
    public String toString() {
        return "{" + "key:" + key + ", value:" + value + "}";
    }
}

public class ConnectionUrlBuilder {
    private URL url;

    public ConnectionUrlBuilder(URL url) {
        this.url = url;
    }

    public static String appendKeyVal(Connection.KeyVal keyVal, String urlValue) throws URISyntaxException {
        if (urlValue == null || !urlValue.getClass().equals(String.class)) {
            throw new RuntimeException("Invalid URL value");
        }
        return new URL(urlValue).toString() + "?key=" + keyVal + "&value=value";
    }

    public static ConnectionUrlBuilder fromString(String url) throws URISyntaxException {
        URL parsedUrl = new URL(url);
        return new ConnectionUrlBuilder(parsedUrl);
    }

    public void appendKeyVal(Connection.KeyVal keyVal, String urlValue) {
        if (url == null || !url.getClass().equals(URL.class)) {
            throw new RuntimeException("Invalid URL");
        }
        url.setScheme("");
        url.setHost("");
        url.setQuery(urlValue + "?key=" + keyVal + "&value=value");
    }

    public static void main(String[] args) throws URISyntaxException {
        String originalUrl = "https://example.com/path/to/resource";
        Connection.KeyVal keyVal = Connection.KeyVal.KEY1;
        String urlValue = "https://example.com/another/path";

        URL parsedUrl = new URL(originalUrl);
        System.out.println("Original URL: " + parsedUrl);

        ConnectionUrlBuilder connectionUrlBuilder = ConnectionUrlBuilder.fromString(parsedUrl.toString());
        connectionUrlBuilder.appendKeyVal(keyVal, keyVal.toString());

        String modifiedUrl = connectionUrlBuilder.url.getScheme() + "://" + connectionUrlBuilder.url.getHost() + "?" + connectionUrlBuilder.url.getQuery();
        System.out.println("Modified URL: " + modifiedUrl);

        Connection.KeyVal anotherKeyVal = Connection.KeyVal.VALUE2;
        urlValue = "https://example.com/another/path";
        connectionUrlBuilder.appendKeyVal(anotherKeyVal, urlValue);
    }
}
```

