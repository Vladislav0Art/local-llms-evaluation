    public static String buildUrl(Map<String, String> queryParams) throws URISyntaxException {
        StringBuilder sb = new StringBuilder();
        if (queryParams.size() > 0) {
            sb.append("?").append(queryParams.keySet().iterator().next()).append("=").append(queryParams.get(queryParams.keySet().iterator().next()));
        }
        return sb.toString();
    }

    public static Map<String, String> parseQuery(String query) {
        Map<String, String> queryParams = new HashMap<>();
        if (query != null && !query.isEmpty()) {
            String[] params = query.split("&");
            for (String param : params) {
                String[] keyValue = param.split("=");
                if (keyValue.length == 2) {
                    queryParams.put(keyValue[0], keyValue[1]);
                }
            }
        }
        return queryParams;
    }

    public static void main(String[] args) throws URIISyntaxException {
        String originalUrl = "https://example.com/path/to/resource";
        Connection.KeyVal keyVal = Connection.KeyVal.KEY1;
        String urlValue = "https://example.com/another/path";

        URL parsedUrl = new URL(originalUrl);
        System.out.println("Original URL: " + parsedUrl);

        ConnectionUrlBuilder connectionUrlBuilder = new ConnectionUrlBuilder(parsedUrl);
        connectionUrlBuilder.appendKeyVal(keyVal, urlValue);
        String modifiedUrl = connectionUrlBuilder.url.getScheme() + "://" + connectionUrlBuilder.url.getHost() + "?" + connectionUrlBuilder.url.getQuery();
        System.out.println("Modified URL: " + modifiedUrl);

        Connection.KeyVal anotherKeyVal = Connection.KeyVal.VALUE2;
        urlValue = "https://example.com/another/path";
        connectionUrlBuilder.appendKeyVal(anotherKeyVal, urlValue);
    }
}

