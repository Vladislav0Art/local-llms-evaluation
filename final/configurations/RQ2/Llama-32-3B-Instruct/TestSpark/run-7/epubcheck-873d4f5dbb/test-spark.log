public class OpfTest {
    @Test
    public void testPreferredMediaType() {
        AssertThrows(NullPointerException.class, () -> OPFChecker30.getPreferredMediaType(null, "path"));
    }

    @Test
    public void testPreferredMediaTypeWithValidPath() {
