package ch.jalu.configme.configurationdata;

import org.junit.Test;
import static org.hamcrest.MatcherAssert.assertThat;
import static org.hamcrest.Matchers.is;
import java.util.Arrays;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

public class CommentsConfigurationTest {

    @Test
    public void newCommentsConfiguration_isEmpty() {
        CommentsConfiguration config = new CommentsConfiguration();
        assertThat(config.getAllComments(), is(Collections.emptyMap()));
    }

    @Test
    public void newCommentsConfiguration_emptyString() {
        CommentsConfiguration config = new CommentsConfiguration(new HashMap<String, List<String>>() {{
            put("", Arrays.asList(""));}};
        assertThat(config.getAllComments().get(""), is(Arrays.asList("")));

    }

    @Test
    public void newCommentsConfiguration_singleLineComment() {
        Map<String, List<String>> comments = new HashMap<String, List<String>>() {{
            put("", Arrays.asList(""));
            put("key", Arrays.asList("$"));
        }};
        CommentsConfiguration config = new CommentsConfiguration(comments);
        assertThat(config.getAllComments().get("key"), is(Arrays.asList("$")));
    }

    @Test
    public void newCommentsConfiguration_multiLineComment() {
        Map<String, List<String>> comments = new HashMap<String, List<String>>() {{
            put("", Arrays.asList(""));
            put("key", Arrays.asList("$", "value"));
        }};
        CommentsConfiguration config = new CommentsConfiguration(comments);
        assertThat(config.getAllComments().get("key"), is(Arrays.asList("$", "value")));
    }

    @Test
    public void existingComment_configuration_update() {
        Map<String, List<String>> comments = new HashMap<String, List<String>>() {{
            put("", Arrays.asList(""));
            put("key", Arrays.asList("$"));
        }};
        CommentsConfiguration config = new CommentsConfiguration(comments);
        config.setComment("key", "value");
        assertThat(config.getAllComments().get("key"), is(Arrays.asList("value")));
    }

    @Test
    public void existingComment_configuration_addLine() {
        Map<String, List<String>> comments = new HashMap<String, List<String>>() {{
            put("", Arrays.asList(""));
            put("key", Arrays.asList("$"));
        }};
        CommentsConfiguration config = new CommentsConfiguration(comments);
        config.setComment("key", "value", "");
        assertThat(config.getAllComments().get("key"), is(Arrays.asList("")));
    }

    @Test
    public void existingComment_configuration_removeLine() {
        Map<String, List<String>> comments = new HashMap<String, List<String>>() {{
            put("", Arrays.asList(""));
            put("key", Arrays.asList("$"));
        }};
        CommentsConfiguration config = new CommentsConfiguration(comments);
        config.setComment("key", "", "$");
        assertThat(config.getAllComments().get("key"), is(Arrays.asList("$")));
    }

}
