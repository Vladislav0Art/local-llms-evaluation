```java
import org.junit.Test;
import static org.junit.Assert.*;

public class AppVersionTest {

    @Test
    public void testNegative() {
        AppVersion appVersion = new AppVersion("1.2.3");
        assertTrue(appVersion.negative(true));
        assertFalse(appVersion.negative(false));

        appVersion = new AppVersion("4.5.6");
        assertTrue(appVersion.negative(false));
        assertFalse(appVersion.negative(true));
    }

    @Test
    public void testPositive() {
        AppVersion appVersion = new AppVersion("1.2.3");
        assertFalse(appVersion.positive(true));
        assertTrue(appVersion.positive(false));

        appVersion = new AppVersion("4.5.6");
        assertTrue(appVersion.positive(true));
        assertFalse(appVersion.positive(false));
    }

    @Test
    public void testConstructor() {
        AppVersion appVersion = new AppVersion("1.2.3");
        assertEquals("1.2.3", appVersion.version);

        appVersion = new AppVersion(123);
        assertEquals(String.valueOf(123), appVersion.version);
    }
}
```

