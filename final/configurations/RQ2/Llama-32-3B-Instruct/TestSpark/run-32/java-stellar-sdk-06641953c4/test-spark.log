        byte[] seed = new byte[32];
        Arrays.fill(seed, 'a');
        KeyPair keyPair = KeyPair.fromSecretSeed(seed);
        assertNotNull(keyPair);
    }

    @Test
    public void fromSecretSeedWithNullSeedpreconditionCheck() {
        KeyPair keyPair = KeyPair.fromSecretSeed(null);
    }

    @Test
    public void fromAccountIdWithValidAccountIdReturnsKeypair() throws Exception {
        String accountId = "account_id";
        KeyPair keyPair = KeyPair.fromAccountId(accountId);
        assertNotNull(keyPair);
    }

    @Test
    public void fromAccountIdWithNullAccountidpreconditionCheck() {
        KeyPair keyPair = KeyPair.fromAccountId(null);
    }

    @Test
    public void getPublicKeyFromKeypreconditionCheckReturnsNotNullValue() {
        KeyPair keyPair = new KeyPair(new EdDSAPublicKey());
        assertNotNull(keyPair.getPublicKey());
    }

