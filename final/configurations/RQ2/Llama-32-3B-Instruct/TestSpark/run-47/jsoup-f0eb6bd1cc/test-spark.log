    public void testUrlBuilderEmpty() throws URISyntaxException, UnsupportedEncodingException {
        UrlBuilder urlBuilder = new UrlBuilder();
        String expectedUrl = "";
        assertEquals(expectedUrl, urlBuilder.toString());
