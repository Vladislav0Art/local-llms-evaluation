public class HttpConnectionTest {

    @Mock
    private SSLSocketFactory sslSocketFactory;

    @Mock
    private CookieManager cookieManager;

    @Test
    public void connect_MocksConnect_ReturnsHttpConnection() {
        Connection connection = new HttpConnection();
        Mockito.when(HttpConnection.connect(Mockito.anyString())).thenReturn(connection);
    }

    @Test
    public void connect_MalformedUrl_ThrowsUncheckedIOException() throws MalformedURLException, IOException {
        URL url = null;
        try {
            new HttpConnection().url(url);
            assert false : "Expected exception not thrown";
        } catch (UncheckedIOException e) {
            // Expected exception
        }
    }

    @Test
    public void connect_ValidUrl_ReturnsHttpConnection() throws MalformedURLException, IOException {
        URL url = new URL("http://example.com");
        Connection connection = new HttpConnection().url(url);
        assert connection != null;
    }

    @Test
    public void connect_ValidUrlWithQuery_ReturnsHttpConnection() throws MalformedURLException, IOException {
        URL url = new URL("http://example.com/path?a=1&b=2");
        Connection connection = new HttpConnection().url(url);
        assert connection != null;
    }

    @Test
    public void connect_ValidUrlWithFragment_ReturnsHttpConnection() throws MalformedURLException, IOException {
        URL url = new URL("http://example.com/path#fragment");
        Connection connection = new HttpConnection().url(url);
        assert connection != null;
    }

    @Test
    public void proxy_MocksProxy_ReturnsHttpConnection() {
        Proxy proxy = Mockito.mock(Proxy.class);
        Connection connection = new HttpConnection().proxy(proxy);
        assert connection != null;
    }

    @Test
    public void proxy_ValidHostAndPort_ReturnsHttpConnection() throws IOException {
        String host = "example.com";
        int port = 80;
        Connection connection = new HttpConnection().proxy(host, port);
        assert connection != null;
    }

    @Test
    public void userAgent_MocksUserAgent_ReturnsHttpConnection() {
        String userAgent = Mockito.mock(String.class);
        Connection connection = new HttpConnection().userAgent(userAgent);
        assert connection != null;
    }

    @Test
    public void timeout_MocksTimeout_ReturnsHttpConnection() {
        int millis = 1000;
        Connection connection = new HttpConnection().timeout(millis);
        assert connection != null;
    }

    @Test
    public void maxBodySize_MocksMaxBodySize_ReturnsHttpConnection() {
        int bytes = 1024;
        Connection connection = new HttpConnection().maxBodySize(bytes);
        assert connection != null;
    }

    @Test
    public void followRedirects_MocksFollowRedirects_ReturnsHttpConnection() {
        boolean followRedirects = Mockito.mock(boolean.class);
        Connection connection = new HttpConnection().followRedirects(followRedirects);
        assert connection != null;
    }

