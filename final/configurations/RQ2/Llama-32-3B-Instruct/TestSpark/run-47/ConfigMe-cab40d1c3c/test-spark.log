package ch.jalu.configme.configurationdata;

import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.Mockito;
import org.mockito.junit.MockitoJUnitRunner;

import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

@RunWith(MockitoJUnitRunner.class)
public class PropertyListBuilderTest {

    @Mock
    private Property<?> property;

    @Test
    public void addProperty() {
        new PropertyListBuilder().add(property);
        Mockito.verify(property).toString();
    }

    @Test
    public void createListWithSingleProperty() {
        List<Property<?>> expected = new ArrayList<>();
        expected.add(property);
        PropertyListBuilder builder = new PropertyListBuilder();
        builder.add(property);
        assertEquals(expected, builder.create());
    }

    @Test
    public void createListWithoutProperties() {
        List<Property<?>> expected = new ArrayList<>();
        assertEquals(expected, new PropertyListBuilder().create());
    }

    @Test
    public void getRootEntries() {
        Map<String, Object> map = new LinkedHashMap<>();
        Mockito.when(property.toString()).thenReturn("test");
        PropertyListBuilder builder = new PropertyListBuilder();
        builder.add(property);
        Map<String, Object> actual = builder.getRootEntries();
        assertEquals(map, actual);
    }

    @Test
    public void addNullProperty() {
        assertThrows(ConfigMeException.class, () -> new PropertyListBuilder().add(null));
    }
}
