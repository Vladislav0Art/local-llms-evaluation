package org.jsoup.parser;

public class GeneratedTest {

    @Test
    public void getName_EmptyString_ReturnsEmptyString() {
        String result = new Tag().getName();
        assertEquals("", result);
    }

    @Test
    public void getName_NonEmptyString_ReturnsName() {
        String name = "div";
        Tag tag = new Tag();
        tag.setName(name);
        assertEquals(name, tag.getName());
    }

    @Test
    public void normalName_AcceptableTagName_ReturnsSameName() {
        String name = "span";
        Tag tag = new Tag();
        tag.setName(name);
        assertEquals(name, tag.normalName());
    }

    @Test
    public void normalName_InvalidTagName_ThrowsException() {
        String invalidName = "invalid-tag";
        assertThrows(InvalidArgumentException.class, () -> new Tag().normalName(invalidName));
    }

    @Test
    public void valueOf_EmptyString_ReturnsUnknownTag() {
        String result = Tag.valueOf("", new ParseSettings());
        assertTrue(Tag.isKnownTag(result.getName()));
    }

    @Test
    public void valueOf_NonEmptyString_ReturnsSameTag() {
        String name = "div";
        Tag tag = Tag.valueOf(name, new ParseSettings());
        assertEquals(tag.getName(), name);
    }

    @Test
    public void isBlock_BasicBlockTags_ReturnsTrue() {
        assertTrue(Tag.isBlock("p"));
        assertTrue(Tag.isBlock("table"));
        assertFalse(Tag.isBlock("span"));
    }

    @Test
    public void formatAsBlock_AcceptableBlocks_ReturnsTrue() {
        assertTrue(Tag.formatAsBlock("p"));
        assertTrue(Tag.formatAsBlock("table"));
        assertFalse(Tag.formatAsBlock("span"));
    }

    @Test
    public void isInline_AcceptableInlineTags_ReturnsTrue() {
        assertTrue(Tag.isInline("img"));
        assertTrue(Tag.isInline("a"));
        assertFalse(Tag.isInline("div"));
    }

    @Test
    public void isEmpty_BasicEmptyTags_ReturnsTrue() {
        assertTrue(Tag.isEmpty("br"));
        assertTrue(Tag.isEmpty("<p></p>"));
        assertFalse(Tag.isEmpty("<p>Hello World</p>"));
    }

    @Test
    public void isSelfClosing_AcceptableSelfClosingTags_ReturnsTrue() {
        assertTrue(Tag.isSelfClosing("img"));
        assertTrue(Tag.isSelfClosing("<input type='image'>"));
        assertFalse(Tag.isSelfClosing("<div></div>"));
    }

    @Test
    public void isKnownTag_KnownTagName_ReturnsTrue() {
        assertTrue(Tag.isKnownTag("img"));
        assertTrue(Tag.isKnownTag("<p>"));
        assertFalse(Tag.isKnownTag("invalid-tag"));
    }

    @Test
    public void preserveWhitespace_AcceptableTagsPreserveWhitespace_ReturnsTrue() {
        assertTrue(Tag.preserveWhitespace("span"));
        assertTrue(Tag.preserveWhitespace("<input type='image'>"));
        assertFalse(Tag.preserveWhitespace("img"));
    }

    @Test
    public void isFormListed_AcceptableTagsReturnTrue() {
        assertTrue(Tag.isFormListed("form"));
        assertFalse(Tag.isFormListed("div"));
    }

    @Test
    public void isFormSubmittable_AcceptableTagsReturnFalse() {
        assertFalse(Tag.isFormSubmittable("img"));
        assertFalse(Tag.isFormSubmittable("<input type='image'>"));
        assertTrue(Tag.isFormSubmittable("form"));
    }

    @Test
    public void setSelfClosing_SelfClosingTag_ReturnsTrue() {
        Tag tag = new Tag();
        boolean result = tag.setSelfClosing();
        assertTrue(result);
    }

    @Test
    public void equals_EqualTags_ReturnsTrue() {
        String name1 = "div";
        String name2 = "div";
        Tag tag1 = new Tag();
        Tag tag2 = new Tag();
        tag1.setName(name1);
        tag2.setName(name2);
        assertTrue(tag1.equals(tag2));
    }

    @Test
    public void equals_NonEqualTags_ReturnsFalse() {
        String name1 = "div";
        String name2 = "span";
        Tag tag1 = new Tag();
        Tag tag2 = new Tag();
        tag1.setName(name1);
        tag2.setName(name2);
        assertFalse(tag1.equals(tag2));
    }

    @Test
    public void hashCode_AcceptableTagsHaveSameHashcode_ReturnsSameHashcode() {
        String name1 = "div";
        String name2 = "div";
        Tag tag1 = new Tag();
        Tag tag2 = new Tag();
        tag1.setName(name1);
        tag2.setName(name2);
        assertEquals(tag1.hashCode(), tag2.hashCode());
    }

    @Test
    public void toString_AcceptableTagsReturnCorrectString_ReturnsSameString() {
        String name = "div";
        Tag tag = new Tag();
        tag.setName(name);
        assertEquals(name, tag.toString());
    }

    @Test
    public void clone_CloneTagReturnsNewCloneObject() {
        Tag original = new Tag();
        Tag clone = original.clone();
        assertNotNull(clone);
        assertNotSame(original, clone);
    }

