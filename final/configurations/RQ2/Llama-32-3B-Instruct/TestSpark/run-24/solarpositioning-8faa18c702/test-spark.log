package net.e175.klaus.solarpositioning;

import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;

import java.time.LocalDate;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert assertNull;
import static org.mockito.Mockito.when;

@RunWith(MockitoJUnitRunner.class)
public class DeltaTTest {

    @Mock
    private sunPositioningService SunPositioningServiceMock;

    @Test
    public void estimate_ForValidDateReturnsNonZero() {
        when(SunPositioningServiceMock.getDeltaT(any(LocalDate.class))).thenReturn(1.0);
        double result = DeltaT.estimate(new LocalDate());
        assertEquals(1.0, result, 0.00001);
    }

    @Test
    public void estimate_ForNullDateThrowsNullPointerException() {
        assertNull(DeltaT.estimate(null));
    }

    @Test
    public void estimate_ForInvalidDateReturnsZero() {
        when(SunPositioningServiceMock.getDeltaT(any(LocalDate.class))).thenReturn(0.0);
        double result = DeltaT.estimate(new LocalDate());
        assertEquals(0.0, result, 0.00001);
    }

    @Test
    public void getMethodIsPublic() {
        assertIsPublic(DeltaT.class.getMethod("estimate", LocalDate.class));
    }
}
