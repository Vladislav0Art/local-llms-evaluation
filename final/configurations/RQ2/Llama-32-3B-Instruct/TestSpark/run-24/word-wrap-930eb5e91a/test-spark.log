package org.davidmoten.text.utils;

import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;

import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.nio.charset.StandardCharsets;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertTrue;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

@RunWith(MockitoJUnitRunner.class)
public class GeneratedTest {

    @Mock
    private java.io.Reader reader;

    @Mock
    private java.io.Writer writer;

    @Mock
    private org.davidmoten.text.utils.LineConsumer lineConsumer;

    @Test
    public void fromReader_ReturnsBuilder() {
        // Given
        WordWrap.Builder builder = WordWrap.from(reader);

        // Then
        assertEquals(java.util.Collections.singletonList(reader), builder.input());
    }

    @Test
    public void fromClasspathUtf8_ReturnsBuilder() {
        // Given
        String resource = "resource";
        WordWrap.Builder builder = WordWrap.fromClasspathUtf8(resource);

        // Then
        assertEquals(StandardCharsets.UTF_8, builder.charset());
        assertEquals(resource, builder.resource());
    }

    @Test
    public void wordWrap_WithReader_OutsideBuilder() throws java.io.IOException {
        // Given
        when(java.util.Arrays.asList(reader).get(0)).thenReturn('a');
        when(writer.write(any())).thenReturn(0);
        WordWrap.Builder builder = new WordWrap.Builder();

        // When
        WordWrap.wordWrap(reader, writer, "\n", 10, (s) -> 5L, new java.util.HashSet<>(), false);

        // Then
        assertTrue(new java.util.ArrayList<>(writer.getBuffer().toString().split("\n")).contains("a"));
    }

    @Test
    public void isWhitespace_CharactersStartingWithSpace_ReturnsTrue() {
        // Given
        when(reader.read()).thenReturn(' ');
        boolean result = WordWrap.isWhitespace(" ");

        // Then
        assertTrue(result);
    }

    @Test
    public void rightTrim_StringEndingWithCharacterReturnsTrimmedString() {
        // Given
        String s = "   abc";
        char c = ' ';
        when(reader.read()).thenReturn(c);

        // When
        String trimmed = WordWrap.rightTrim(s, true);

        // Then
        assertEquals("abc", trimmed);
    }

    @Test
    public void leftTrim_StringStartingWithCharacterReturnsTrimmedString() {
        // Given
        StringBuilder sBuilder = new java.util.LinkedList<>();
        sBuilder.add(' ');
        sBuilder.add('a');
        sBuilder.add('b');
        sBuilder.add('c');
        when(reader.read()).thenReturn(sBuilder.poll());
        WordWrap leftTrimTest = new WordWrap();
        leftTrimTest.leftTrim(" ", true);

        // When
        String trimmed = ((StringBuilder) leftTrimTest.rightTrim("", false)).toString();

        // Then
        assertEquals("abc", trimmed);
    }

    @Test
    public void close_ReaderIsClosedAfterUse() {
        // Given
        when(reader.read()).thenReturn('a');
        WordWrap fromTest = new WordWrap();
        fromTest.from(new java.io.ByteArrayInputStream("Hello".getBytes()), false);

        // When
        fromTest.close();

        // Then
        assertTrue(((java.util.ArrayList) fromTest.writer).isEmpty());
    }

}
