import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;

import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.nio.charset.StandardCharsets;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertTrue;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

@RunWith(MockitoJUnitRunner.class)
public class WordWrapTest {

    @Mock
    private Reader reader;

    @Mock
    private Writer writer;

    @Mock
    private LineConsumer lineConsumer;

    @Test
    public void fromReader_ReturnsBuilder() {
        // Given
        WordWrap.Builder builder = WordWrap.from(reader);

        // Then
        assertEquals(reader, builder.input());
    }

    @Test
    public void fromClasspathUtf8_ReturnsBuilder() {
        // Given
        String resource = "resource";
        WordWrap.Builder builder = WordWrap.fromClasspathUtf8(resource);

        // Then
        assertEquals(resource, builder.resource());
    }

    @Test
    public void wordWrap_WithReader_OutsideBuilder() throws IOException {
        // Given
        when(reader.read()).thenReturn(1);
        when(writer.write(any())).thenReturn(0);
        WordWrap.Builder builder = new WordWrap.Builder();

        // When
        WordWrap.wordWrap(reader, writer, "\n", 10, (s) -> 5L, new HashSet<>(), false, true);

        // Then
        assertTrue(builder.build().length() > 0);
    }

    @Test
    public void wordWrap_WithLineConsumer_OutsideBuilder() throws IOException {
        // Given
        when(lineConsumer.consume(any())).thenReturn(0);
        WordWrap.Builder builder = new WordWrap.Builder();

        // When
        WordWrap.wordWrap(reader, lineConsumer, 10, (s) -> 5L, new HashSet<>(), false, true);

        // Then
        assertTrue(lineConsumer.consume().length() > 0);
    }

    @Test
    public void isWhitespace_CharactersStartingWithSpace_ReturnsTrue() {
        // Given
        when(reader.read()).thenReturn(1);

        // When
        boolean result = WordWrap.isWhitespace(" ");

        // Then
        assertTrue(result);
    }

    @Test
    public void rightTrim_StringEndingWithCharacterReturnsTrimmedString() {
        // Given
        String s = "   abc";
        when(reader.read()).thenReturn(1);

        // When
        String trimmed = WordWrap.rightTrim(s);

        // Then
        assertEquals("abc", trimmed);
    }

    @Test
    public void leftTrim_StringStartingWithCharacterReturnsTrimmedString() {
        // Given
        StringBuilder2 word = new StringBuilder2();
        word.append("   abc");
        when(reader.read()).thenReturn(1);

        // When
        String trimmed = WordWrap.leftTrim(word.toString());

        // Then
        assertEquals("abc", trimmed);
    }

    @Test
    public void close_ReaderIsClosedAfterUse() {
        // Given
        when(reader.read()).thenReturn(1);
        WordWrap.from(reader, false);

        // When
        WordWrap.close(reader);

        // Then
        assertTrue(reader.isClosed());
    }
}
