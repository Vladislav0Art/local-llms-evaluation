import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertNotNull;
import static org.junit.Assert.assertTrue;
import java.io.IOException;
import org.jsoup.helper.Validate;
import org.jsoup.parser.Parser;

public class GeneratedTest {

    public String stripLeadingWhitespace(String input) {
        return input.replaceAll("^\\s+", "");
    }

    @Test
    public void newTextNodeHasValidNodeName() {
        TextNode textNode = new TextNode("Hello, World!");
        assertEquals("Hello, World!", textNode.data());
    }

    @Test
    public void testTextNodeData() throws Exception {
        Element element = new Element();
        Document document = new Document(element);
        Elements elements = document.getAllElements();
        TextNode textNode = (TextNode) elements.get(0);
        assertNotNull(textNode);
    }

    @Test
    public void testTextNodeEquals() throws Exception {
        Element element1 = new Element();
        Element element2 = new Element();

        Document document = new Document(element1);
        TextNode textNode1 = (TextNode) document.getAllElements().get(0);

        Document document2 = new Document(element2);
        TextNode textNode2 = (TextNode) document2.getAllElements().get(0);

        assertTrue(textNode1.equals(textNode2));
    }

    @Test
    public void testTextEquals() throws Exception {
        Element element = new Element();
        element.data("Hello, World!");

        Document document = new Document(element);
        Elements elements = document.getAllElements();

        TextNode textNode = (TextNode) elements.get(0);

        assertTrue(textNode.equals(new TextNode("Hello, World!")));
    }

    @Test
    public void testTextNodeEqualsWithNull() throws Exception {
        Element element = new Element();
        Document document = new Document(element);
        Elements elements = document.getAllElements();

        TextNode textNode = (TextNode) elements.get(0);

        assertTrue(textNode.equals(null));
    }
}
