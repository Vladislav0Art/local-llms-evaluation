        assertNotNull(wholeText);
        assertTrue(wholeText.contains("Hello"));
        assertTrue(wholeText.contains("World"));
    }

    @Test
    public void isBlankTextNodeReturnsFalse() {
        TextNode textNode = new TextNode("");
        assertTrue(!textNode.isBlank());
