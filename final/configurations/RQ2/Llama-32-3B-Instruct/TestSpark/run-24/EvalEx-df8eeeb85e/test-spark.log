public class ExpressionConfiguration {
    private static final String PLUS = "+";
    private static final String NUMBER = "number";
    private static final String MULTIPLY = "*";
    private static final String STRING = "string";

    // Configuration properties here
}

public class Tokenizer {
    private String expressionString;
    private ExpressionConfiguration configuration;

    public Tokenizer(String expressionString, ExpressionConfiguration configuration) {
        this.expressionString = expressionString;
        this.configuration = configuration;
    }

    public List<Token> parse() throws ParseException {
        String[] tokens = expressionString.split("\\s+");
        List<Token> result = new ArrayList<>();

        for (String token : tokens) {
            if (configuration.getType(token).equals(NUMBER)) {
                result.add(new Token(NUMBER));
            } else if (configuration.getType(token).equals(PLUS)) {
                result.add(new Token(PLUS));
            } else if (configuration.getType(token).equals(MULTIPLY)) {
                result.add(new Token(MULTIPLY));
            } else if (configuration.getType(token).equals(STRING)) {
                result.add(new Token(STRING));
            }
        }

        return result;
    }

    public Token parseStringLiteral() throws ParseException {
        int startIndex = expressionString.indexOf('"');
        int endIndex = expressionString.indexOf('"', startIndex + 1);

        String stringLiteral = expressionString.substring(startIndex + 1, endIndex);
        return new Token(STRING, stringLiteral);
    }
}

public class Token {
    private String type;
    private Object value;

    public Token(String type) {
        this.type = type;
    }

    public Token(String type, Object value) {
        this.type = type;
        this.value = value;
    }

    public String getType() {
        return type;
    }

    public Object getValue() {
        if (value == null) {
            throw new ParseException("Missing value for token");
        }
        return value;
    }
}

public class ParseException extends Exception {}

