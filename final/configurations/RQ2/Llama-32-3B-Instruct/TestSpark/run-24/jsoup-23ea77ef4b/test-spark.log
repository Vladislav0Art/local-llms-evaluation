public class W3CTests {

    @Test
    public void testSelectNodes() {
        NodeList nodeList = new ArrayList<>(Arrays.asList(new Node("1"), new Node("2")));
        NodeList result = W3CDomHelper.sourceNodes(nodeList, Node.class);
        assertEquals(2, result.getLength());
    }

    @Test
    public void testAsstring() {
        Node node = new Node("Hello");
        String result = W3CDomHelper.asString(node);
        assertEquals("Hello", result);
    }

    @Test
    public void testSelectXpath() throws XPathException {
        NodeList nodeList = new ArrayList<>(Arrays.asList(new Node("1"), new Node("2")));
        NodeList contextNodeList = new ArrayList<>(Arrays.asList(new Node("3"), new Node("4")));
        W3CDomHelper.selectXpath(Arrays.asList("/node[@id='1']", "/node[@id='2']"), (Node) contextNodeList.get(0));
    }

    @Test
    public void testConvertToDocument() {
        String content = "Hello World!";
        String result = W3CTests.convertToDocument(content);
        assertEquals("Hello World!", result);
    }
}

