        return content;
    }

    public void setContent(String content) {
        this.content = content;
    }
}

public class W3CTests {
    public static Document convertToDocument(String content) {
        Node node = new Node();
        node.setId("1");
        Document document = new Document();
        document.setContent(content);
        return document;
    }

    public static void selectXpath(List<String> xpaths, String contextNode) {
        for (String xpath : xpaths) {
            if (xpath.contains(contextNode)) {
                System.out.println(xpath);
            }
        }
    }

    @Test
    public void testSelectXpath() {
        List<String> xpaths = Arrays.asList("/node[@id='1']", "/node[@id='2']");
        String contextNode = "1";
        selectXpath(xpaths, contextNode);
    }

    @Test
    public void testConvertToDocument() {
        String content = "Hello World!";
        Document document = convertToDocument(content);
        assertEquals("Hello World!", document.getContent());
    }
}

public class NodeList {
    private List<Node> nodes;

    public NodeList() {
        this.nodes = new ArrayList<>();
    }

    public void addNode(Node node) {
        this.nodes.add(node);
    }

    public String getNodes() {
        StringBuilder sb = new StringBuilder();
        for (Node node : nodes) {
            sb.append(node.getId()).append(",");
        }
        return sb.toString().substring(0, sb.length() - 1); // remove last comma and space
    }
}

@Test
public void testConvertToDocumentAndSelectXpath() {
    String content = "Hello World!";
    Document document = convertToDocument(content);
    List<Node> nodeList = new NodeList();
    nodeList.addNode(document.getNode());
    assertEquals("1", nodeList.getNodes()); // select xpath returns node id
}

@Test
public void testConvertToDocumentAndSelectXpathWithContextNode() {
