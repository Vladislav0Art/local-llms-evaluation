package org.jsoup.safety;

import org.junit.Test;
import static org.junit.Assert.*;
import java.util.Arrays;
import java.util.HashSet;
import java.util.Map;
import org.jsoup.helper.Validate;

public class SafelistTest {

    @Test
    public void noneTest() {
        assertTrue(Safelist.none().isNone());
    }

    @Test
    public void simpleTextTest() {
        Safelist sut = Safelist.simpleText();
        assertEquals(Validate.TAGS, new HashSet<>(Arrays.asList(sut.getSafeTags())));
    }

    @Test
    public void basicTagTest() {
        assertTrue(Safelist.basic().isSafeTag("html"));
        assertFalse(Safelist.basic().isSafeTag("script"));
    }

    @Test
    public void basicEnforcedAttributeTest() {
        Safelist sut = Safelist.basic();
        assertEquals(Validate.ATTRIBUTE, new HashSet<>(Arrays.asList(sut.getEnforcedAttributes("html").getKeys())));
    }

    @Test
    public void noneIsNoneTest() {
        Safelist sut1 = Safelist.none();
        Safelist sut2 = Safelist.none();
        assertTrue(sut1.isNone());
        assertTrue(sut2.isNone());
    }

    @Test
    public void simpleTextIsSimpleTextTest() {
        Safelist sut1 = Safelist.simpleText();
        Safelist sut2 = Safelist.simpleText();
        assertTrue(sut1.getSafeTags().equals(sut2.getSafeTags()));
    }

    @Test
    public void basicIsBasicTest() {
        Safelist sut1 = Safelist.basic();
        Safelist sut2 = Safelist.basic();
        assertTrue(sut1.isBasic());
        assertTrue(sut2.isBasic());
    }

    @Test
    public void noneCanBeCopiedTest() {
        Safelist sut = Safelist.none();
        Safelist copy = new Safelist(sut);
        assertTrue(copy.isNone());
    }

    @Test
    public void simpleTextCanBeCopiedTest() {
        Safelist sut1 = Safelist.simpleText();
        Safelist copy = new Safelist(sut1);
        assertEquals(sut1, copy);
    }

    @Test
    public void basicCanBeCopiedTest() {
        Safelist sut1 = Safelist.basic();
        Safelist copy = new Safelist(sut1);
        assertTrue(copy.isBasic());
    }

    @Test
    public void noneAddTagsTest() {
        Safelist sut = Safelist.none();
        safelistAddTagsAndRemoveTags(sut, "p", "span");
        assertTrue(sut.getSafeTags().contains("p"));
        assertFalse(sut.getSafeTags().contains("span"));
    }

    @Test
    public void basicAddTagsTest() {
        Safelist sut = Safelist.basic();
        safelistAddTagsAndRemoveTags(sut, "img", "a");
        assertTrue(sut.getSafeTags().contains("img"));
        assertTrue(sut.getSafeTags().contains("a"));
    }

    @Test
    public void noneRemoveTagsTest() {
        Safelist sut = Safelist.none();
        safelistAddTagsAndRemoveTags(sut, "p", "span");
        assertFalse(sut.getSafeTags().contains("p"));
        assertTrue(sut.getSafeTags().contains("span"));
    }

    @Test
    public void basicRemoveTagsTest() {
        Safelist sut = Safelist.basic();
        safelistAddTagsAndRemoveTags(sut, "img", "a");
        assertFalse(sut.getSafeTags().contains("img"));
        assertFalse(sut.getSafeTags().contains("a"));
    }

    @Test
    public void noneAddAttributesTest() {
        Safelist sut = Safelist.none();
        safelistAddTagsAndRemoveTags(sut, "p", "span");
        assertEquals(0, sut.getEnforcedAttributes("html").size());
    }

    @Test
    public void basicAddAttributesTest() {
        Safelist sut = Safelist.basic();
        safelistAddTagsAndRemoveTags(sut, "img", "a");
        assertEquals(2, sut.getEnforcedAttributes("img").size());
    }

    @Test
    public void noneRemoveAttributesTest() {
        Safelist sut = Safelist.none();
        safelistAddTagsAndRemoveTags(sut, "p", "span");
        assertEquals(0, sut.getEnforcedAttributes("html").size());
    }

    @Test
    public void basicRemoveAttributesTest() {
        Safelist sut = Safelist.basic();
        safelistAddTagsAndRemoveTags(sut, "img", "a");
        assertEquals(0, sut.getEnforcedAttributes("img").size());
    }

    @Test
    public void nonePreserveRelativeLinksTest() {
        Safelist sut = Safelist.none();
        assertTrue(sut.preserveRelativeLinks(true));
    }

    @Test
    public void basicPreserveRelativeLinksTest() {
        Safelist sut = Safelist.basic();
        assertTrue(sut.preserveRelativeLinks(true));
    }
}

public class Util {

    private static final Set<String> SAFE_TAGS = new HashSet<>(Arrays.asList("html", "p", "span"));
    private static final Map<String, String[]> SAFE_ATTRIBUTES = new HashMap<>();
    private static final Map<String, String[]> SAFE_PROTOCOLS = new HashMap<>();

    public static void safelistAddTagsAndRemoveTags(Safelist sut, String... tags) {
        for (String tag : tags) {
            if (!SAFE_TAGS.contains(tag)) {
                sut.addTag(tag);
            } else {
                sut.removeTag(tag);
            }
        }
        sut.removeTags(tags);
    }

}
