    private String scheme;
    private String host;
    private int port;
    private String path;

    public UrlBuilder(String scheme, String host) {
        this.scheme = scheme;
        this.host = host;
    }

    public UrlBuilder withPort(int port) {
        this.port = port;
        return this;
    }

    public UrlBuilder withPath(String path) {
        this.path = path;
        return this;
    }

    public URI buildUrl() {
        if (port == 0) {
            String protocol = scheme.toLowerCase();
            if (protocol.equals("http")) {
                return new URI(protocol, host, DEFAULT_PORT, "/" + path);
            } else if (protocol.equals("https")) {
                return new URI(protocol, host, DEFAULT_PORT, "/" + path);
            }
        }
        return new URI(scheme, host, port, "/" + path);
    }

    private static final int DEFAULT_PORT = 80;

    public String getScheme() {
        return scheme;
    }

    public String getHost() {
        return host;
    }

    public int getPort() {
        return port;
    }

    public String getPath() {
        return path;
    }
}

public class Connection {
    private static final int DEFAULT_PORT = 80;

    public enum KeyVal {
        KEY("key"),
        VALUE("value");

        private String value;

        Connection(KeyVal keyVal) {
            this.value = keyVal.toString();
        }

        public String getValue() {
            return value;
        }
    }

    public static class KeyValImpl implements KeyVal {
        private final String key;
        private final String value;

        public KeyValImpl(String key, String value) {
            this.key = key;
            this.value = value;
        }

        @Override
        public String getValue() {
            return value;
        }
    }
}

public class GeneratedTest {

    public static void main(String[] args) {
        UrlBuilder urlBuilder = new UrlBuilder("http", "localhost");
        urlBuilder.withPort(8080).withPath("/api/v1").buildUrl();
        assertEquals(new URI("http", "localhost", 8080, "/", "/api/v1"), urlBuilder.buildUrl());

        urlBuilder = new UrlBuilder("https", "localhost");
        urlBuilder.withPort(8443).withPath("/test/path").buildUrl();
        assertEquals(new URI("https", "localhost", 8443, "/", "/test/path"), urlBuilder.buildUrl());

        urlBuilder = new UrlBuilder("http", "localhost:8080");
        urlBuilder.withPort(80).withPath("/api/v1").buildUrl();
        assertEquals(new URI("http", "localhost:8080", 80, "/", "/api/v1"), urlBuilder.buildUrl());
    }
}

