import org.jsoup.Connection;
import org.jsoup.Document;
import org.jsoup.HttpStatusException;
import org.jsoup.UncheckedIOException;
import org.jsoup.UnsupportedMimeTypeException;
import org.jsoup.helper.HttpConnection;
import org.junit.Test;
import static org.junit.Assert.*;
import java.io.ByteArrayInputStream;
import java.io.IOException;

public class HttpConnectionTest {

    @Test
    public void connectValidUrl_ReturnsConnection() {
        Connection connection = HttpConnection.connect("http://example.com");
        assertNotNull(connection);
    }

    @Test(expected = MalformedURLException.class)
    public void connectInvalidUrl_ThrowsMalformedURLException() {
        HttpConnection.connect("invalid-url");
    }

    @Test
    public void urlValidUrl_ReturnsConnection() {
        Connection connection = HttpConnection.url(new URL("http://example.com"));
        assertNotNull(connection);
    }

    @Test
    public void urlInvalidUrl_ThrowsMalformedURLException() {
        try {
            HttpConnection.url(new URL("invalid-url"));
            fail("Expected MalformedURLException");
        } catch (MalformedURLException e) {}
    }

    @Test
    public void newRequest_ReturnsNewConnection() {
        Connection request = HttpConnection.newRequest();
        assertNotNull(request);
    }

    @Test
    public void urlValidUrl_ReturnsConnection() {
        Connection connection = HttpConnection.url("http://example.com");
        assertNotNull(connection);
    }

    @Test
    public void proxySetsProxy() {
        Proxy proxy = new Proxy(Proxy.Type.HTTP, "host", 8080);
        Connection connection = HttpConnection.proxy(proxy);
        assertEquals(proxy, connection.proxy());
    }

    @Test
    public void userAgentSetsUserAgent() {
        String userAgent = "Mozilla/5.0";
        Connection connection = HttpConnection.userAgent(userAgent);
        assertEquals(userAgent, connection.userAgent());
    }

    @Test
    public void timeoutSetsTimeout() {
        int timeout = 100;
        Connection connection = HttpConnection.timeout(timeout);
        assertEquals(timeout, connection.timeout());
    }

    @Test
    public void dataSetsData() {
        String key = "key";
        String value = "value";
        Connection connection = HttpConnection.data(key, value);
        assertEquals(connection.data(key), new java.util.HashMap<String, String>() {{
            put("key", "value");
        }});
    }

    @Test
    public void get_ReturnsDocument() throws IOException {
        Document document = new Document();
        byte[] data = {"<html><body>Hello World!</body></html>".getBytes(UTF_8));
        ByteArrayInputStream inputStream = new ByteArrayInputStream(data);
        HttpURLConnection connection = (HttpURLConnection) inputStream.getInputStream();
        Connection request = HttpConnection.request().url("http://example.com");
        request.get().connect();
        assertEquals(document, ((Document) request.execute().response()).get());
    }

    @Test
    public void post_ReturnsDocument() throws IOException {
        Document document = new Document();
        byte[] data = {"<html><body>Hello World!</body></html>".getBytes(UTF_8)};
        ByteArrayInputStream inputStream = new ByteArrayInputStream(data);
        HttpURLConnection connection = (HttpURLConnection) inputStream.getInputStream();
        Connection request = HttpConnection.request().url("http://example.com").requestBody(String.valueOf(document));
        request.post().connect();
        assertEquals(document, ((Document) request.execute().response()).get());
    }

}

