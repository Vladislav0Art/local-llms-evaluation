    public void createTable_InvalidData_ReturnsFalse() throws DBAppException, IOException, CsvValidationException {
        Hashtable<String, String> htblColNameType = new Hashtable<>();
        Hashtable<String, String> htblColNameMin = new Hashtable<>();
        Hashtable<String, String> htblColNameMax = new Hashtable<>();

        when(serializer.readTables()).thenReturn(new ArrayList<>());
        when(serializer.getType(anyString())).thenReturn(null);

        assertFalse(dbApp.createTable("table1", "id", htblColNameType, htblColNameMin, htblColNameMax));
    }

    @Test
    public void insertIntoTable_ValidData_ReturnsTrue() throws DBAppException {
        Hashtable<String, Object> htblColNameValue = new Hashtable<>();

        assertTrue(dbApp.insertIntoTable("table1", htblColNameValue));
    }

    @Test
    public void insertIntoTable_InvalidData_ReturnsFalse() throws DBAppException {
        Hashtable<String, Object> htblColNameValue = null;

        assertFalse(dbApp.insertIntoTable("table1", htblColNameValue));
    }

    @Test
    public void updateTable_ValidData_ReturnsTrue() throws DBAppException {
        Hashtable<String, Object> htblColNameValue = new Hashtable<>();

        assertTrue(dbApp.updateTable("table1", "id", htblColNameValue));
    }

    @Test
    public void updateTable_InvalidData_ReturnsFalse() throws DBAppException {
        Hashtable<String, Object> htblColNameValue = null;

        assertFalse(dbApp.updateTable("table1", "id", htblColNameValue));
    }

    @Test
    public void deleteFromTable_ValidData_ReturnsTrue() throws DBAppException {
        Hashtable<String, Object> htblColNameValue = new Hashtable<>();

        assertTrue(dbApp.deleteFromTable("table1", htblColNameValue));
    }

