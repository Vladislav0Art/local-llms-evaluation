package net.e175.klaus.solarpositioning;

import org.junit.BeforeClass;
import org.junit.Test;
import static org.junit.Assert.*;
import java.time.LocalDate;
import java.util.Random;

public class DeltaTTest {

    @BeforeClass
    public static void init() {
        LocalDate today = LocalDate.now();
        for (int i = 0; i < 10; i++) {
            DeltaT.estimate(today.plusDays(i));
        }
    }

    @Test
    public void estimate_ReturnsDouble() {
        double result = DeltaT.estimate(LocalDate.now());
        assertTrue Double.isFinite(result) && Double.isPositive(result);
    }

    @Test
    public void estimate_InvalidInput_ThrowsException() {
        assertThrows(IllegalArgumentException.class, () -> DeltaT.estimate(null));
    }

    @Test
    public void estimate_DifferentDates_ReturnsDifferentValues() {
        LocalDate today = LocalDate.now();
        double result1 = DeltaT.estimate(today);
        double result2 = DeltaT.estimate(today.plusDays(1));
        assertTrue result1 != result2;
    }

    @Test
    public void estimate_SameDate_ReturnsSameValue() {
        LocalDate today = LocalDate.now();
        double result1 = DeltaT.estimate(today);
        double result2 = DeltaT.estimate(today);
        assertEquals(result1, result2);
    }
}
