import org.junit.Test;
import org.jsoup.helper.Validate;
import org.jsoup.internal.Normalizer;
import org.junit.Assert;

import java.util.HashMap;
import java.util.Map;

public class TagTest {

    @Test
    public void getName() {
        String tagName = "div";
        Tag tag = new Tag(tagName);
        Assert.assertEquals(tagName, tag.getName());
    }

    @Test
    public void normalName_WithSpecialChars() {
        String tagName = "<span>";
        Tag tag = new Tag(tagName);
        Assert.assertEquals("span", tag.normalName());
    }

    @Test
    public void valueOf_NameOnly() {
        String tagName = "p";
        ParseSettings settings = new ParseSettings();
        Tag tag = Tag.valueOf(tagName, settings);
        Assert.assertEquals(tagName, tag.getName());
    }

    @Test
    public void valueOf_NamesWithMultipleChars() {
        String tagName = "img";
        ParseSettings settings = new ParseSettings();
        Tag tag = Tag.valueOf(tagName, settings);
        Assert.assertEquals("img", tag.getName());
    }

    @Test
    public void isBlock_DivTag() {
        Tag tag = new Tag("div");
        Assert.assertTrue(tag.isBlock());
    }

    @Test
    public void isBlock_PTag() {
        Tag tag = new Tag("p");
        Assert.assertFalse(tag.isBlock());
    }

    @Test
    public void formatAsBlock_DivTag() {
        Tag tag = new Tag("div");
        Assert.assertTrue(tag.formatAsBlock());
    }

    @Test
    public void isInline_DivTag() {
        Tag tag = new Tag("div");
        Assert.assertFalse(tag.isInline());
    }

    @Test
    public void isEmpty_EmptyTag() {
        Tag tag = new Tag("");
        Assert.assertTrue(tag.isEmpty());
    }

    @Test
    public void isEmpty_NonEmptyTag() {
        Tag tag = new Tag("tag");
        Assert.assertFalse(tag.isEmpty());
    }

    @Test
    public void isSelfClosing_AselfClosingTag() {
        Tag tag = new Tag("<img>");
        Assert.assertTrue(tag.isSelfClosing());
    }

    @Test
    public void isKnownTag_ExistingTag() {
        String tagName = "script";
        Assert.assertTrue(Tag.isKnownTag(tagName));
    }

    @Test
    public void isFormListed_SelfClosingTag() {
        Tag tag = new Tag("<input>");
        Assert.assertTrue(tag.isFormListable());
    }

    @Test
    public void isFormSubmittable_NotSelfClosingTag() {
        Tag tag = new Tag("<form>");
        Assert.assertFalse(tag.isFormSubmittable());
    }

    @Test
    public void setSelfClosing_SelfClosingTag() {
        String tagName = "<img>";
        Tag tag = new Tag(tagName);
        Tag selfClosingTag = (Tag) tag.setSelfClosing();
        Assert.assertEquals(selfClosingTag, tag);
    }
}
