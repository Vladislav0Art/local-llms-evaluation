    private Set<String> patterns = new HashSet<>();

    public void addPattern(String pattern) {
        this.patterns.add(pattern);
    }

    public boolean match(String url, String path) {
        for (String pattern : patterns) {
            if (path.startsWith(pattern)) {
                return true;
            }
        }
        return false;
    }
}

class URLParser {
    private Safelist safelist;

    public URLParser() {
        this.safelist = new Safelist();
        this.safelist.addPattern("^https://");
    }

    public boolean preserveRelativeLinks(String url, String path) {
        URI parsedUrl = URI.create(url);
        String scheme = parsedUrl.getScheme();
        if (!safelist.match(scheme, path)) {
            return false;
        }
        // implement logic to preserve relative links
        return true;
    }

    public void addProtocol(String protocol) {
        safelist.addPattern(protocol + "://");
    }

    public void removeProtocol(String protocol) {
        safelist.patterns.remove(protocol + "://");
    }
}

class URLManager {
    private Set<String> protocols = new HashSet<>();

    public void addProtocol(String protocol) {
        this.protocols.add(protocol);
    }

    public void removeProtocol(String protocol) {
        this.protocols.remove(protocol);
    }

    public String getProtocols() {
        return protocols.toString();
    }
}

public class Main {
    public static void main(String[] args) {
        URLParser parser = new URLParser();

        System.out.println(parser.preserveRelativeLinks("https://example.com", "/path/to/resource"));
        parser.addProtocol("http://");
        System.out.println(parser.preserveRelativeLinks("http://example.com", "/path/to/resource"));
        parser.removeProtocol("http://");
        System.out.println(parser.preserveRelativeLinks("http://example.com", "/path/to/resource"));

        URLManager manager = new URLManager();
        manager.addProtocol("https:");
        System.out.println(manager.getProtocols());
        manager.removeProtocol("https:");
        System.out.println(manager.getProtocols());
    }
}

