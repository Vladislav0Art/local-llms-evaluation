@RunWith(MockitoJUnitRunner.class)
public class HttpConnectionTest {

    @Mock
    private Connection connectionMock;

    @Test
    public void connectStringUrlReturnsNewRequest() {
        Connection newRequest = HttpConnection.connect("http://example.com");
        Mockito.verify(connectionMock, Mockito.times(1)).newRequest();
    }

    @Test
    public void connectUrlReturnsNewRequest() {
        URL url = new URL("http://example.com");
        Connection newRequest = HttpConnection.connect(url);
        Mockito.verify(connectionMock, Mockito.times(1)).newRequest();
    }

    @Test
    public void connectStringUrlWithProxy() {
        String proxy = "http://proxy.example.com:8080";
        Connection newRequest = HttpConnection.connect("http://example.com", proxy);
        Mockito.verify(connectionMock, Mockito.times(1)).proxy(Mockito.any(Proxy.class));
    }

    @Test
    public void connectStringUrlWithUserAgent() {
        String userAgent = "Mozilla/5.0";
        Connection newRequest = HttpConnection.connect("http://example.com", userAgent);
        Mockito.verify(connectionMock, Mockito.times(1)).userAgent(Mockito.anyString());
    }

    @Test
    public void urlStringReturnsNewRequest() {
        String url = "http://example.com";
        Connection newRequest = HttpConnection.url(url);
        Mockito.verify(connectionMock, Mockito.times(1)).url(Mockito.any(URL.class));
    }

    @Test
    public void urlURLReturnsSameObject() {
        URL url = new URL("http://example.com");
        Connection connection = HttpConnection.connect(url);
        Mockito.verify(connectionMock, Mockito.times(1)).url(url);
    }

    @Test
    public void urlStringWithProxyReturnsNewRequest() {
        String proxy = "http://proxy.example.com:8080";
        String url = "http://example.com";
        Connection newRequest = HttpConnection.url(url, proxy);
        Mockito.verify(connectionMock, Mockito.times(1)).url(Mockito.any(URL.class));
    }

    @Test
    public void urlStringWithUserAgentReturnsNewRequest() {
        String userAgent = "Mozilla/5.0";
        String url = "http://example.com";
        Connection newRequest = HttpConnection.url(url, userAgent);
        Mockito.verify(connectionMock, Mockito.times(1)).userAgent(Mockito.anyString());
    }

    @Test
