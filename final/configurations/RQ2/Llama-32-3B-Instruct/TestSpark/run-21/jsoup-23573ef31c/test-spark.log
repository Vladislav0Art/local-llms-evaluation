package org.jsoup.nodes;

import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.select.Elements;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.junit.runners.JUnit4;
import org.mockito.Mock;

import static org.hamcrest.CoreMatchers.is;
import static org.hamcrest.MatcherAssert.assertThat;
import static org.junit.Assert.assertEquals;
import static org.mockito.Mockito.when;

@RunWith(JUnit4.class)
public class GeneratedTest {

    @Mock
    private Connection connection;

    @Test
    public void createShell_ReturnsDocument() {
        when(Document.createShell("baseUri")).thenReturn(new Document("baseUri"));
        Document document = Document.createShell("baseUri");
        assertThat(document, is(new Document("baseUri")));
    }

    @Test
    public void location_ReturnsString() {
        String location = "http://example.com";
        when(connection.location()).thenReturn(location);
        Document document = new Document("baseUri", connection);
        assertThat(document.location(), is(location));
    }

    @Test
    public void connection_ReturnsConnection() {
        Connection connection = mock(Connection.class);
        when(Document.connection()).thenReturn(connection);
        Document document = new Document("baseUri", connection);
        assertEquals(connection, document.connection());
    }

    @Test
    public void expectForm_ReturnsFormElement() {
        String cssQuery = "form";
        FormElement formElement = mock(FormElement.class);
        when(connection.expectForm(cssQuery)).thenReturn(formElement);
        Document document = new Document("baseUri", connection);
        assertEquals(formElement, document.expectForm(cssQuery));
    }

    @Test
    public void title_ReturnsString() {
        String title = "Title";
        Document document = new Document("baseUri");
        document.title(title);
        assertThat(document.title(), is(title));
    }

    @Test
    public void createElement_ReturnsElement() {
        String tagName = "div";
        Element element = mock(Element.class);
        when(Document.createElement(tagName)).thenReturn(element);
        Document document = new Document("baseUri");
        assertEquals(element, document.createElement(tagName));
    }

    @Test
    public void outerHtml_ReturnsString() {
        String html = "<html><body>Hello World!</body></html>";
        Document document = new Document("baseUri", connection);
        document.html(html);
        assertThat(document.outerHtml(), is(html));
    }

    @Test
    public void text_ReturnsElement() {
        String text = "Hello World!";
        Element element = mock(Element.class);
        when(Document.text(text)).thenReturn(element);
        Document document = new Document("baseUri");
        assertEquals(element, document.text(text));
    }

    @Test
    public void nodeName_ReturnsString() {
        String name = "html";
        Document document = new Document("baseUri", connection);
        document.nodeName(name);
        assertThat(document.nodeName(), is(name));
    }

    @Test
    public void charset_ReturnsCharset() {
        Charset charset = mock(Charset.class);
        when(connection.charset()).thenReturn(charset);
        Document document = new Document("baseUri");
        assertEquals(charset, document.charset());
    }

    @Test
    public void updateMetaCharsetElement_ReturnsBoolean() {
        boolean update = true;
        when(connection.updateMetaCharsetElement()).thenReturn(update);
        Document document = new Document("baseUri", connection);
        assertEquals(update, document.updateMetaCharsetElement());
    }

    @Test
    public void clone_ReturnsDocument() {
        Document document = mock(Document.class);
        when(document.clone()).thenReturn(document);
        Document clonedDocument = Document.createShell("baseUri");
        assertEquals(document, clonedDocument);
    }

    @Test
    public void shallowClone_ReturnsDocument() {
        Document document = mock(Document.class);
        when(document.shallowClone()).thenReturn(document);
        Document shallowClonedDocument = Document.createShell("baseUri");
        assertEquals(document, shallowClonedDocument);
    }

}
