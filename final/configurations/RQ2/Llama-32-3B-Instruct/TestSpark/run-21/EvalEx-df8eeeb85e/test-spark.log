public class Token {
    public enum TokenType {
        INVALID_OPERATOR,
        INVALID_TOKEN,
        STRING_LITERAL,
        INVALID_OPERATOR_TOKEN,
        VALID_TOKEN,
    }

    private final TokenType type;
    private final String value;

    public Token(TokenType type, String value) {
        this.type = type;
        this.value = value;
    }

    public static Token create(String value) {
        if (value.matches("[^\\w\s]+")) { // invalid operator
            return new Token(TokenType.INVALID_OPERATOR_TOKEN, value);
        } else if (value.startsWith("\"") && value.endsWith("\"")) { // string literal
            return new Token(TokenType.STRING_LITERAL, value.substring(1, value.length() - 1));
        } else if (!Character.isLetterOrDigit(value.charAt(0))) {
            return new Token(TokenType.INVALID_TOKEN, value);
        } else { // valid token
            return new Token(TokenType.VALID_TOKEN, value);
        }
    }

    public TokenType getType() {
        return type;
    }

    @Override
    public String toString() {
        return "Token{" +
                "type=" + type +
                ", value='" + value + '\'' +
                '}';
    }
}

public class InvalidOperatorToken extends Token {
    public InvalidOperatorToken(String value) {
        super(Token.TokenType.INVALID_OPERATOR_TOKEN, value);
    }

    @Override
    public String toString() {
        return "InvalidOperatorToken{" +
                "value='" + value + '\'' +
                '}';
    }
}

public class InvalidToken extends Token {
    public InvalidToken(String value) {
        super(Token.TokenType.INVALID_TOKEN, value);
    }

    @Override
    public String toString() {
        return "InvalidToken{" +
                "value='" + value + '\'' +
                '}';
    }
}

public class StringLiteralToken extends Token {
    public StringLiteralToken(String value) {
        super(Token.TokenType.STRING_LITERAL, value);
    }

    @Override
    public String toString() {
        return "StringLiteralToken{" +
                "value='" + value + '\'' +
                '}';
    }
}

public class ValidToken extends Token {
    public ValidToken(String value) {
        super(Token.TokenType.VALID_TOKEN, value);
    }

    @Override
    public String toString() {
        return "ValidToken{" +
                "value='" + value + '\'' +
                '}';
    }
}

public class ExpressionConfigurationTest {

    public void testInvalidOperatorToken() throws Exception {
        Token token = Token.create("not a valid operator");
        System.out.println(token);
    }

    public void testInvalidToken() throws Exception {
        Token token = Token.create("!@#$");
        System.out.println(token);
    }

    public void testStringLiteralToken() throws Exception {
        Token token = Token.create("\"hello world\"");
        System.out.println(token);
    }

    public void testValidToken() throws Exception {
        Token token = Token.create("abcdefg");
        System.out.println(token);
    }
}
