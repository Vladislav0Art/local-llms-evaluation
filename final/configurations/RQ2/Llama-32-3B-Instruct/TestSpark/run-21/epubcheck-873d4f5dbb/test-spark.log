    public void isAudioType_ReturnsTrueWhenAudioType() {
        String type = "audio";
        assertTrue(opfChecker30.isAudioType(type));
    }

    @Test
    public void isVideoType_ReturnsTrueWhenVideoType() {
        String type = "video";
        assertTrue(opfChecker30.isVideoType(type));
    }

    @Test
    public void isFontType_ReturnsFalseWhenNotFontType() {
        String type = "text";
        assertFalse(opfChecker30.isFontType(type));
    }

    @Test
    public void getPreferredMediaType_ReturnsTypeWhenNoPath() {
        String type = "type";
        String path = "";
        assertEquals("type", opfChecker30.getPreferredMediaType(type, path));
    }

}
