    public void isSameLeapYearTrue() {
        assertTrue(DeltaTStub.isSameLeapYear(LocalDate.of(2020, 2, 29)));
    }

    @Test
    public void isSameLeapYearFalse() {
        assertFalse(DeltaTStub.isSameLeapYear(LocalDate.of(2019, 2, 28)));
    }
