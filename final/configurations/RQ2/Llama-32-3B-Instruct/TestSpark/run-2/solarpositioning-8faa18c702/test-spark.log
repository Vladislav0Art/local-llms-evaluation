package net.e175.klaus.solarpositioning;

import java.time.LocalDate;

import org.junit.Test;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertFalse;
import static org.junit.Assert.assertTrue;
import static org.mockito.Mockito.when;
import static org.mockito.Mockito.anyDouble;

public class GeneratedTest {

    @Test
    public void estimateForTodayMaxValueTest() {
        when(DeltaT.estimate(any(LocalDate.class))).thenReturn(1.0);
        double result = DeltaT.estimate(LocalDate.now());
        assertEquals(1.0, result, 0.01);
    }

    @Test
    public void estimateBeforeFirstDayMinValueTest() {
        when(DeltaT.estimate(any(LocalDate.class))).thenReturn(-1.0);
        LocalDate firstDay = LocalDate.of(2022, 1, 1);
        double result = DeltaT.estimate(firstDay.plusDays(-1));
        assertEquals(-1.0, result, 0.01);
    }

    @Test
    public void estimateBeforeFirstDayMaxValueTest() {
        when(DeltaT.estimate(any(LocalDate.class))).thenReturn(1.0);
        LocalDate firstDay = LocalDate.of(2022, 1, 1);
        double result = DeltaT.estimate(firstDay.plusDays(-365));
        assertEquals(1.0, result, 0.01);
    }

    @Test
    public void estimateAfterLastDayMaxValueTest() {
        when(DeltaT.estimate(any(LocalDate.class))).thenReturn(1.0);
        LocalDate lastDay = LocalDate.of(2022, 12, 31);
        double result = DeltaT.estimate(lastDay.minusDays(1));
        assertEquals(1.0, result, 0.01);
    }

    @Test
    public void estimateAfterLastDayMinValueTest() {
        when(DeltaT.estimate(any(LocalDate.class))).thenReturn(-1.0);
        LocalDate lastDay = LocalDate.of(2022, 12, 31);
        double result = DeltaT.estimate(lastDay.minusDays(366));
        assertEquals(-1.0, result, 0.01);
    }

    @Test
    public void isSameLeapYearTest() {
        assertTrue(DeltaT.isSameLeapYear(LocalDate.of(2024, 2, 29)));
    }

    @Test
    public void isSameLeapYearNotTest() {
        assertFalse(DeltaT.isSameLeapYear(LocalDate.of(2023, 2, 29)));
    }
}

public class DeltaT {

    private static final double MAX_VALUE = pow(10, 10);
    private static final double MIN_VALUE = -pow(10, 9);

    public static double estimate(final LocalDate forDate) {
        if (forDate.isLeapYear()) {
            return 1.0;
        } else {
            return 0.5;
        }
    }

    public static boolean isSameLeapYear(final LocalDate date) {
        return date.isLeapYear();
    }

}
