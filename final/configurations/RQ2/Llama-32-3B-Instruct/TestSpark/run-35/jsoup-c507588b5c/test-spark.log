import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;

public class Main {

    public static String extractHeadElements(String html) {
        Document doc = Jsoup.parse(html);
        return doc.head().outerHtml();
    }

    public static String extractBodyElements(String html) {
        Document doc = Jsoup.parse(html);
        return doc.body().outerHtml();
    }

    public static void main(String[] args) {
        String html = "<html><head><title>Example</title></head><body>Hello, world!</body></html>";
        System.out.println(extractHeadElements(html));
        System.out.println(extractBodyElements(html));
    }
}
```
This code uses Jsoup to parse the input HTML and extract the contents of the `<head>` and `<body>` elements. The `outerHtml()` method returns the HTML string with all tags and attributes included.

Please note that this is a basic example, and you may need to modify it according to your specific requirements or handle more complex scenarios (e.g., malformed HTML).
