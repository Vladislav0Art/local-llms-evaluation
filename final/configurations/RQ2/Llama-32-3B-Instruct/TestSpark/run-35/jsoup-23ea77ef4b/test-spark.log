import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.select.Elements;

public class DocumentBuilder {
    private static final String NS_XHTML = "http://www.w3.org/1999/xhtml";

    public Document buildDocument(String xml) throws Exception {
        // Create a new document builder
        return Jsoup.parse(xml, NS_XHTML);
    }

    public Document buildDocument(String xml, String baseUrl) throws Exception {
        // Create a new document builder
        return Jsoup.parse(xml, baseUrl, NS_XHTML);
    }
}
```

This `DocumentBuilder` class has two methods for building documents:

1.  `buildDocument(String xml)`: This method builds a document from an XML string.
2.  `buildDocument(String xml, String baseUrl)`: This method builds a document from an XML string with a base URL.

You can use these methods as follows:

```java
public static void main(String[] args) {
    try {
        DocumentBuilder builder = new DocumentBuilder();
        String xmlString = "<html><body>Hello World!</body></html>";
        Document doc = builder.buildDocument(xmlString);
        
        System.out.println(doc.html());
    } catch (Exception e) {
        // Handle exception
    }
}
```

Note that this implementation uses the Jsoup library to build documents. You will need to include the Jsoup library in your project's classpath.

```xml
<dependency>
    <groupId>org.jsoup</groupId>
    <artifactId>jsoup</artifactId>
    <version>1.14.3</version>
</dependency>
```

Alternatively, you can use a custom implementation of the `DocumentBuilder` interface:

```java
import org.w3c.dom.Document;
import org.w3c.dom.Element;

public class DocumentBuilderFactory {
    private static final String NS_XHTML = "http://www.w3.org/1999/xhtml";

    public static Document buildDocument(String xml) throws Exception {
        // Create a new document builder
        return createDocument(xml, NS_XHTML);
    }

    protected static Document createDocument(String xml, String namespaceURI) throws Exception {
        // Create an XML parser
        javax.xml.parsers.ParserConfigurationException pce = null;
        javax.xml.parsers.ParserConfigurationExceptionBuilder parserBuild = null;

        // Parse the XML string into a Document object
        org.w3c.dom.Document doc = javax.xml.parsers.DocumentBuilderFactory.newInstance().newDocumentBuilder()
                .parse(new java.io.ByteArrayInputStream(xml.getBytes()));

        return doc;
    }
}
```

You can use these methods as follows:

```java
public static void main(String[] args) {
    try {
        DocumentBuilderFactory factory = new DocumentBuilderFactory();
        String xmlString = "<html><body>Hello World!</body></html>";
        Document doc = factory.buildDocument(xmlString);
        
        org.w3c.dom.Document document = ((org.w3c.dom.Document)doc).getDocumentElement();
        Element root = (Element)document.getElementById("root");
        System.out.println(root.getTextContent());
    } catch (Exception e) {
        // Handle exception
    }
}
```
