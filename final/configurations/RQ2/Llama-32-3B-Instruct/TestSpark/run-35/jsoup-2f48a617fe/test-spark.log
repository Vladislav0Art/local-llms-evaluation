    public void isXmlDeclaration_ReturnsTrue() {
        Comment comment = new Comment("");
        assertTrue(comment.isXmlDeclaration());
    }

    @Test
    public void asXmlDeclaration_RetrunsNullIfNotXmlDeclaration() {
        Comment comment = new Comment("");
        assertNull(comment.asXmlDeclaration());
    }

}
