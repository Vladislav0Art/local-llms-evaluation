    public void sourceNodes_NullList_ReturnsEmptyList() {
        List<Node> nodeList = new ArrayList<>();
        NodeList result = W3CDom.sourceNodes(null, Node.class);
        assertNotNull(result);
        assertTrue(nodeList.size() == 0);
    }

