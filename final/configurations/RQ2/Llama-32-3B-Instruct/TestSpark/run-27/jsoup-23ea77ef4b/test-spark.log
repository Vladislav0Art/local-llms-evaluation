    public void namespaceAware_True_ReturnsTrue() {
        assertTrue(W3CDom.namespaceAware(true));
    }

    @Test
    public void namespaceAware_False_ReturnsFalse() {
        assertFalse(W3CDom.namespaceAware(false));
    }

    @Test
    public void convert_NullDocument_ThrowsNullPointerException() {
        assertThrows(NullPointerException.class, () -> W3CDom.convert(null));
    }

