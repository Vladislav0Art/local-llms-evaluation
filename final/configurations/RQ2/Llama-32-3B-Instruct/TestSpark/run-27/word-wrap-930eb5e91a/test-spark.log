public class WordWrap {
    public static String rightTrim(String input) {
        int start = input.lastIndexOf(' ');
        if (start == -1) {
            return input;
        } else {
            return input.substring(0, start + 1);
        }
    }

    public static void leftTrim(StringBuilder word, String input) {
        for (int i = 0; i < input.length(); i++) {
            char c = input.charAt(i);
            if (!Character.isWhitespace(c)) {
                word.setStart(i);
                return;
            }
        }
        word.setStart(0);
    }

    public static class StringBuilder2 extends StringBuilder {
        private int start;
        private int end;

        public StringBuilder2(String string) {
            super(string);
            if (string.length() > 0) {
                this.start = 0;
                this.end = string.length();
