        boolean followRedirects = true;
        Connection connection = HttpConnection.followRedirects(followRedirects);
        Mockito.verify(connection).followRedirects(Mockito.anyBoolean());
    }

    @Test
    public void referrer() {
        String referrer = "https://example.com";
        Connection connection = HttpConnection.referrer(referrer);
        Mockito.verify(connection).referrer(Mockito.any(String.class));
    }

