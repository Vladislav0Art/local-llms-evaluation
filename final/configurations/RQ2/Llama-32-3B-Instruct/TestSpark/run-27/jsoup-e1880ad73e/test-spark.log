    public String getKey() {
        return key;
    }

    public String getValue() {
        return value;
    }
}

public class UrlBuilder {
    private URL url;

    public UrlBuilder(URL url) {
        this.url = url;
    }

    public String build() throws MalformedURLException {
        if (url.getQuery() != null) {
            return url.toString() + "&" + url.getQuery();
        } else {
            return url.toString();
        }
    }

    public void appendKeyVal(Connection.KeyVal kv, OutputStream out) throws URISyntaxException, UnsupportedEncodingException {
        // implementation
    }

    public static UrlBuilder createUrlBuilder(String urlStr) {
        URL url = null;
        try {
            url = new URL(urlStr);
        } catch (MalformedURLException e) {
            throw new RuntimeException(e);
        }
        return new UrlBuilder(url);
    }
}

public class StringUtil {
    public static String toString(Connection connection) {
        return "key=" + connection.getQuery();
    }

    public static String toString(KeyVal kv) {
        return kv.getKey() + "=" + kv.getValue();
    }
}
