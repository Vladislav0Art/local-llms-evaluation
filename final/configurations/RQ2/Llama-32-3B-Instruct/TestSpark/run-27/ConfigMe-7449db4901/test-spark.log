    @Test
    public void newCommentsConfiguration_emptyMap() {
        CommentsConfiguration comments = new CommentsConfiguration();
        Map<String, List<String>> map = comments.getAllComments();
        assertTrue(map.isEmpty());
    }

    @Test
    public void setComment_newLineOnly_emptyLine() {
        CommentsConfiguration comments = new CommentsConfiguration();
        Map<String, List<String>> map = new HashMap<>();
        comments.setComment("path", "");
        Map<String, List<String>> resultMap = comments.getAllComments();
        assertTrue(resultMap.isEmpty());
    }

