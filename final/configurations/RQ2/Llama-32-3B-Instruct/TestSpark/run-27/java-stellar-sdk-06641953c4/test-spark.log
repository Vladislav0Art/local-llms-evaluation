```java
import java.security.KeyFactory;
import java.security.KeyPair;
import java.security.PrivateKey;
import java.security.PublicKey;
import java.util.Base64;

import javax.crypto.Mac;
import javax.crypto.spec.PBEKeySpec;
import javax.xml.bind.DatatypeConverter;

public class EdDSAPublicKey {
    private String publicKeyStr;

    public EdDSAPublicKey(String publicKeyStr) {
        this.publicKeyStr = publicKeyStr;
    }

    public String getPublicKeyStr() {
        return publicKeyStr;
    }
}

public class Main {

    public static void main(String[] args) throws Exception {
        // Generate a new key pair
        KeyPair keyPair = generateKeyPair();

        EdDSAPublicKey publicKey = (EdDSAPublicKey) keyPair.getPublic();

        String signature = "your eddsa signature";
        String message = "Hello, World!";

        Mac mac = Mac.getInstance("HmacSHA512WithRSA");
        PrivateKey privateKey = ((KeyPair) keyPair).getPrivate();
        mac.init(new PBEKeySpec(privateKey.getEncoded(), null, 0, 256));

        byte[] macValue = mac.doFinal(message.getBytes());

        // Verify the signature
        KeyFactory kf = KeyFactory.getInstance("ECDSA");
        kf.generatePublic((javax.crypto.spec.ECParameterSpec) java.security.MessageDigest.getInstance("SHA512").digest(publicKey.getPublicKeyStr().getBytes())).generatePrivate(new java.security.spec.X509EncodedKeySpec(publicKey.getPublicKeyStr().getBytes()));

        PrivateKey verifiedPrivateKey = kf.generatePrivate(new java.security.spec.X509EncodedKeySpec(publicKey.getPublicKeyStr().getBytes()));
        mac.init(new PBEKeySpec(verifiedPrivateKey.getEncoded(), null, 0, 256));
        byte[] newMacValue = mac.doFinal(message.getBytes());

        if (java.util.Arrays.equals(macValue, newMacValue)) {
            System.out.println("Signature is valid");
        } else {
            System.out.println("Invalid signature");
        }
    }

    public static KeyPair generateKeyPair() throws Exception {
        // EdDSA keys are generated using the SEC2 library
        java.security.KeyPair keyPair = java.security.KeyFactory.getInstance("EC").generatePrivate(new javax.crypto.spec.ECParameterSpec(
                "secp521r1", // Curve name
                "P-524",      // Prime parameters
                "MSS",         // Coordinate system
                "cofactor"     // Coefficient for the quadratic polynomial defining the group law
        ));
        return keyPair;
    }
}
