package org.jsoup.nodes;

import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.nodes.LeafNode;
import org.jsoup.nodes.Node;
import org.jsoup.nodes.Text;
import org.jsoup.select.Elements;
import org.junit.Test;
import org.mockito.Mockito;

public class GeneratedTest {

    @Test
    public void newNodeTextIsCorrectTest() {
        String text = "Hello World";
        TextNode node = new TextNode(text);
        assertEquals(text, node.text());
    }

    @Test
    public void normaliseWhitespaceTest() {
        String text = "   Hello World  ";
        assertEquals("Hello World", TextNode.normaliseWhitespace(text));
    }

    @Test
    public void stripLeadingWhitespaceTest() {
        String text = "   Hello World  ";
        assertEquals("Hello World", TextNode.stripLeadingWhitespace(text));
    }

    @Test
    public void cloneIsCorrectTest() {
        String text = "Hello World";
        TextNode node = new TextNode(text);
        TextNode clone = node.clone();
        assertEquals(node.text(), clone.text());
    }

    @Test
    public void lastCharIsWhitespaceTest() {
        StringBuilder sb = Mockito.mock(StringBuilder.class);
        when(sb.length()).thenReturn(5);
        assertTrue(TextNode.lastCharIsWhitespace(sb));
    }

    @Test
    public void splitTextOffsetCorrectTest() {
        String text = "Hello World";
        TextNode node = new TextNode(text);
        TextNode result1 = node.splitText(0);
        assertEquals("Hello", result1.text());
        assertEquals("World", node.text());

        TextNode result2 = node.splitText(node.text().length());
        assertEquals("", result2.text());
    }

    @Test
    public void isBlankTest() {
        String text = "";
        assertTrue(TextNode.isBlank(text));

        String text2 = "   ";
        assertTrue(TextNode.isBlank(text2));
    }

    @Test
    public void nodeNameIsCorrectTest() {
        TextNode node = new TextNode("text");
        assertEquals("text", node.nodeName());
    }

    @Test
    public void getWholeTextIsCorrectTest() {
        String text = "Hello World";
        TextNode node = new TextNode(text);
        assertEquals(text, node.getWholeText());
    }

    @Test
    public void outerHtmlHeadAndTailIsCorrectTest() throws IOException {
        Document document = new Document();
        Appendable accum = Mockito.mock(Appendable.class);
        int depth = 0;
        Document.OutputSettings out = Mockito.mock(Document.OutputSettings.class);

        TextNode node = new TextNode("Hello World");
        node.outerHtmlHead(accum, depth, out);
        assertEquals("<p>Hello World</p>", document.body().html());

        node.outerHtmlTail(accum, depth, out);
        assertEquals("", accum.toString());
    }

}
