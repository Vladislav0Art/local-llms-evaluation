        return outerHtmlHead(new StringBuilder(10), 1, new StringWriter()).toString();
    }
}

public class GeneratedTest {
    public static TextNode TextNode(String text) {
        StringTokenizer st = new StringTokenizer(text);
        Node node = new Node();
        while (st.hasMoreTokens()) {
            String token = st.nextToken();
            if (token.charAt(0) == '<') {
                Appendable accum = new StringBuilder();
                int depth = 0;
                StringWriter out = new StringWriter();
                if (node.outerHtmlHead(accum, depth, out).indexOf(token) > -1) {
                    return node.createFromEncoded(token);
                }
            } else {
                if (!node.toString().contains(token)) {
                    return new TextNode(token);
                }
            }
        }
        return null;
    }

    public static void main(String[] args) throws IOException {
        System.out.println(new GeneratedTest().TextNode("<b>Hello</b>"));
    }
