public class Node {
    private String outerHtmlHead(Appendable accum, int depth, StringWriter out) throws IOException;
    public String outerHtmlHead() throws IOException {
        return outerHtmlHead(new StringBuilder(), 0, new StringWriter());
    }

    private String outerHtmlTail(Appendable accum, int depth, StringWriter out) throws IOException;
    public String outerHtmlTail() throws IOException {
        return outerHtmlTail(new StringBuilder(), 0, new StringWriter());
    }

