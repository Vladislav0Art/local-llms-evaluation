import org.jsoup.safety.Safelist;
import org.junit.Test;
import static org.junit.Assert.*;
import java.util.Arrays;
import org.mockito.Mockito;

public class SafelistTest {

    @Test
    public void none_SafeList_ReturnsNone() {
        Safelist result = Safelist.none();
        assertNotNull(result);
        assertTrue(Safelist.none().isSafeTag("unknown"));
    }

    @Test
    public void simpleText_SimpleTagsReturnTrue() {
        Safelist result = Safelist.simpleText();
        assertTrue(Safelist.simpleText().isSafeTag("img"));
        assertTrue(Safelist.simpleText().isSafeTag("br"));
    }

    @Test
    public void basic_BasicTagsAndImagesReturnTrue() {
        Safelist result = Safelist.basic();
        assertTrue(Safelist.basic().isSafeTag("p"));
        assertTrue(Safelist.basic().isSafeTag("img"));
    }

    @Test
    public void relaxed_RelaxedTagsReturnTrue() {
        Safelist result = Safelist.relaxed();
        assertTrue(Safelist.relaxed().isSafeTag("div"));
        assertTrue(Safelist.relaxed().isSafeAttribute("a", Mockito.mock(Element.class), Mockito.mock(Attribute.class)));
    }

    @Test
    public void addTags_AddedTagsReturnTrue() {
        Safelist result = new Safelist();
        result = result.addTags("p", "img");
        assertTrue(result.isSafeTag("p"));
        assertTrue(result.isSafeTag("img"));
    }

    @Test
    public void removeTags_RemovedTagsReturnFalse() {
        Safelist result = new Safelist();
        result = result.removeTags("p", "img");
        assertFalse(result.isSafeTag("p"));
        assertFalse(result.isSafeTag("img"));
    }

    @Test
    public void addAttributes_AddedAttributeReturnsTrue() {
        Safelist result = new Safelist();
        result = result.addAttributes("img", "alt", "image");
        assertTrue(result.getEnforcedAttributes("img").containsKey("alt"));
    }

    @Test
    public void removeAttributes_RemovedAttributesReturnFalse() {
        Safelist result = new Safelist();
        result = result.removeAttributes("img", "alt");
        assertFalse(result.getEnforcedAttributes("img").containsKey("alt"));
    }

    @Test
    public void addProtocols_AddedProtocolsReturnTrue() {
        Safelist result = new Safelist();
        result = result.addProtocols("a", "href", "https://example.com", "http://example.org");
        assertTrue(result.getEnforcedAttributes("a").containsKey("href"));
    }

    @Test
    public void removeProtocols_RemovedProtocolsReturnFalse() {
        Safelist result = new Safelist();
        result = result.removeProtocols("a", "href", "https://example.com");
        assertFalse(result.getEnforcedAttributes("a").containsKey("href"));
    }
}
