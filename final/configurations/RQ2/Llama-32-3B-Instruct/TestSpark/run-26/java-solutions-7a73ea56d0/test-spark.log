import org.junit.Test;
import static org.junit.Assert.assertEquals;
import org.junit.runner.RunWith;
import org.mockito.Mockito;

@RunWith(MockitoJUnitRunner.class)
public class OnlineStockSpanTest {

    @Mock
    private Stack<Integer> stack;

    public void initializeStack() {
        Mockito.when(stack.isEmpty()).thenReturn(true);
    }

    @Test
    public void nextPriceIsIncrasedTest() {
        initializeStack();
        int price = 100;
        OnlineStockSpan stockSpan = new OnlineStockSpan();
        stockSpan.next(price);
        assertEquals(1, stack.size());
    }

    @Test
    public void firstDayNoDaysTest() {
        initializeStack();
        OnlineStockSpan stockSpan = new OnlineStockSpan();
        int[] result = stockSpan.calculateSpans(new int[]{});
        assertEquals(new int[]{0}, result);
    }

    @Test
    public void nextPriceZeroTest() {
        initializeStack();
        stack.add(1);
        OnlineStockSpan stockSpan = new OnlineStockSpan();
        int price = 100;
        stockSpan.next(price);
        assertEquals(1, stack.size());
    }

    @Test
    public void nextPriceNegativeTest() {
        initializeStack();
        stack.add(1);
        OnlineStockSpan stockSpan = new OnlineStockSpan();
        int price = -100;
        stockSpan.next(price);
        assertEquals(1, stack.size());
    }

    @Test
    public void calculateSpansZeroPricesTest() {
        initializeStack();
        OnlineStockSpan stockSpan = new OnlineStockSpan();
        int[] result = stockSpan.calculateSpans(new int[]{0});
        assertEquals(new int[]{0}, result);
    }

    @Test
    public void calculateSpansSinglePriceTest() {
        initializeStack();
        stack.add(100);
        OnlineStockSpan stockSpan = new OnlineStockSpan();
        int[] result = stockSpan.calculateSpans(new int[]{100});
        assertEquals(new int[]{1}, result);
    }

    @Test
    public void calculateSpansMultiplePricesTest() {
        initializeStack();
        stack.add(100);
        stack.add(50);
        OnlineStockSpan stockSpan = new OnlineStockSpan();
        int[] result = stockSpan.calculateSpans(new int[]{50, 100});
        assertEquals(new int[]{2}, result);
    }

    @Test
    public void calculateSpansSamePricesTest() {
        initializeStack();
        stack.add(100);
        OnlineStockSpan stockSpan = new OnlineStockSpan();
        int[] result = stockSpan.calculateSpans(new int[]{100, 100});
        assertEquals(new int[]{1}, result);
    }

}
