        List<Token> tokens = tokenizer.parse();
        System.out.println(tokens.size());
    }

    @org.junit.jupiter.api.Test
    public void testParseWithEmptyExpression() { 
        String expression = "";
        Tokenizer tokenizer = new Tokenizer(expression, new ExpressionConfigurationImpl());
        List<Token> tokens = tokenizer.parse();
        assertTrue(tokens.isEmpty());
    }

    @org.junit.jupiter.api.Test
    public void testParseReturnsCorrectToken() { 
        String expression = "sin(x)";
        Tokenizer tokenizer = new Tokenizer(expression, new ExpressionConfigurationImpl());
        List<Token> tokens = tokenizer.parse();
        assertEquals(3, tokens.size());
    }

    @org.junit.jupiter.api.Test
    public void testParseThrowsParseExceptionForEmptyExpression() throws ParseException { 
        String expression = "";
        Tokenizer tokenizer = new Tokenizer(expression, new ExpressionConfigurationImpl());
        assertThrows(ParseException.class, () -> tokenizer.parse());
    }
}

