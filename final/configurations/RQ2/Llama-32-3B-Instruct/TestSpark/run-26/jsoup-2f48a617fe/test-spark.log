    @org.junit.Test
    public void addCommentToOuterHtmlTail() throws IOException {
        Document document = new Document();
        Element tailElement = document.tail().firstChild();
        Comment comment = new Comment("This is a test comment.");
        tailElement.appendChild(comment);
        assertEquals(1, tailElement.children().size());
        assertEquals(true, tailElement.children().get(0).isXmlDeclaration());
    }

