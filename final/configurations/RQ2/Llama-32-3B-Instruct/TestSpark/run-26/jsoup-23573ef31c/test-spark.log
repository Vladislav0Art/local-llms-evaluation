import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.Mockito;
import org.mockito.junit.MockitoJUnitRunner;

@RunWith(MockitoJUnitRunner.class)
public class DocumentTest {

    @Mock
    private Element element;

    @Test
    public void createShell_Matches() {
        Mockito.when(element.toString()).thenReturn("<html></html>");
        var result = Document.createShell("https://example.com");
        Mockito.verify(element).toString();
    }

    @Test
    public void location_ReturnsLocation() {
        var document = new Document("https://example.com");
        var expected = "https://example.com";
        Assert.assertEquals(expected, document.location());
    }

    @Test
    public void connection_ReturnsConnection() {
        var document = new Document("https://example.com");
        var connection = Mockito.mock(Connection.class);
        Mockito.when(document.connection()).thenReturn(connection);
        var result = document.connection();
        Mockito.verify(connection).equals(Mockito.any(Connection.class));
    }

    @Test
    public void title_SetsTitle() {
        var document = new Document("https://example.com");
        var expected = "My Page";
        Assert.assertEquals(expected, document.title());
    }

    @Test
    public void createElement_ReturnsElement() {
        var result = Document.createElement("div");
        Assert.assertNotNull(result);
    }

    @Test
    public void createShell_MatchesWithParser() {
        Mockito.when(element.toString()).thenReturn("<html></html>");
        var parser = new Parser();
        var document = Document.createShell("https://example.com", parser);
        Mockito.verify(parser).setParser(document.parser());
    }

    @Test
    public void charset_SetsCharset() {
        var expected = Charset.forName("UTF-8");
        var result = new Document().charset(expected);
        Assert.assertEquals(expected, result.charset());
    }

    @Test
    public void updateMetaCharsetElement_ReturnsBoolean() {
        var document = new Document();
        var expected = true;
        Assert.assertTrue(document.updateMetaCharsetElement());
    }

    @Test
    public void shallowClone_ReturnsDocument() {
        var document = new Document();
        var result = document.shallowClone();
        Assert.assertNotNull(result);
    }
}
