package org.jsoup.helper;

import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.Mockito;
import org.mockito.junit.MockitoJUnitRunner;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertThrows;
import static org.junit.Assert.assertTrue;
import static org.mockito.Mockito.when;

@RunWith(MockitoJUnitRunner.class)
public class UrlBuilderTest {

    @Mock
    private Connection.KeyVal kv;

    @Test
    public void newUrlBuilder_ReturnsNewInstance() {
        UrlBuilder builder = new UrlBuilder(new URL("http://example.com"));
        assertEquals(new UrlBuilder(new URL("http://example.com")), builder);
    }

    @Test
    public void build_ThrowsMalformedURLException() {
        when(kv.getKey()).thenReturn("key");
        when(kv.getValue()).thenReturn("value");

        assertThrows(MalformedURLException.class, () -> new UrlBuilder(null).build());
    }

    @Test
    public void appendKeyVal_AppendsKeyValueToUrl() throws UnsupportedEncodingException {
        UrlBuilder builder = new UrlBuilder(new URL("http://example.com"));
        builder.appendKeyVal(kv);
        assertEquals("http://example.com?key=value", builder.build().toString());
    }

    @Test
    public void appendKeyVal_NonNullKeyValue_ThrowsUnsupportedEncodingException() {
        when(kv.getKey()).thenReturn(null);
        when(kv.getValue()).thenReturn(null);

        assertThrows(UnsupportedEncodingException.class, () -> new UrlBuilder(new URL("http://example.com")).appendKeyVal(kv));
    }

    @Test
    public void appendKeyVal_NullUrl_ThrowsNullPointerException() {
        UrlBuilder builder = new UrlBuilder(null);
        assertThrows(NullPointerException.class, () -> builder.appendKeyVal(kv));
    }
}
