public class JacksonJsonTransformerTest {

    private JacksonJsonTransformer jsonJsonTransformer;

    @Before
    public void setUp() {
        jsonJsonTransformer = new JacksonJsonTransformer();
    }

    // Test parse(String, Class) method with valid JSON and object type
    [parseValidJsonObject]Test public void testParseValidJsonObject() throws Exception {
        String json = "{\"name\":\"John\",\"age\":30}";
        Class<Project> clazz = Project.class;
        Object obj = jsonJsonTransformer.parse(json, clazz);
        assertNotNull(obj);
        assertTrue(obj instanceof Project);
    }

    // Test parse(String, Class) method with invalid JSON
    [parseInvalidJson]Test public void testParseInvalidJson() {
        String json = "{\"name\":\"John\",\"age\":30}";
        Class<Project> clazz = Project.class;
        assertThrows(CrowdinApiException.class, () -> jsonJsonTransformer.parse(json, clazz));
    }

    // Test parse(String, Class) method with no object type
    [parseNoObjectClass]Test public void testParseNoObjectClass() {
        String json = "{\"name\":\"John\",\"age\":30}";
        assertThrows(CrowdinApiException.class, () -> jsonJsonTransformer.parse(json, null));
    }

    // Test convert(Object) method with valid object
    [convertValidObject]Test public void testConvertValidObject() throws Exception {
        Project project = new Project();
        project.setName("John");
        project.setAge(30);
        String result = jsonJsonTransformer.convert(project);
        assertNotNull(result);
        assertTrue(result.contains("\"name\":\"John\"");
        assertTrue(result.contains("\"age\":30"));
    }

    // Test convert(Object) method with null object
    [convertNullObject]Test public void testConvertNullObject() {
        assertThrows(HttpBadRequestException.class, () -> jsonJsonTransformer.convert(null));
    }

    private static final ObjectMapper OBJECT_MAPPER = new ObjectMapper();
    private static final SimpleModule SIMPLE_MODULE = new SimpleModule();

    // Test configure ObjectMapper with serialization
    [configureSerialization]Test public void testConfigureSerialization() throws Exception {
        OBJECT_MAPPER.configure(SerializationFeature.FAIL_ON_EMPTY_BEANS, false);
        SIMPLE_MODULE.addSerializer(String.class, OBJECT_MAPPER);
    }

    // Test configure ObjectMapper with deserialization
    [configureDeserialization]Test public void testConfigureDeserialization() throws Exception {
        OBJECT_MAPPER.configure(DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES, false);
        SIMPLE_MODULE.addDeserializer(String.class, OBJECT_MAPPER);
    }
}
