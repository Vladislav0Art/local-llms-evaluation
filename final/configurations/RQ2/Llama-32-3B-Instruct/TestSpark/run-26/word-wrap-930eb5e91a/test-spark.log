import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;

import java.io.BufferedReader;
import java.io.File;
import java.io.FileInputStream;
import java.io.FileNotFoundException;
import java.io.FileOutputStream;
import java.io.IOException;
import java.io.InputStream;
import java.io.InputStreamReader;
import java.io.OutputStreamWriter;
import java.io.Reader;
import java.io.StringReader;
import java.io.StringWriter;
import java.nio.charset.Charset;
import java.util.ArrayList;
import java.util.HashSet;
import java.util.List;
import java.util.Set;

import static org.junit.Assert.assertEquals;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;

@RunWith(MockitoJUnitRunner.class)
public class WordWrapTest {

    @Mock
    private Reader reader;

    @Mock
    private Writer writer;

    @Test
    public void fromReaderTest() {
        WordWrap.Builder builder = WordWrap.from(reader);
        Preconditions.checkState(builder != null, "Builder should not be null");
    }

    @Test
    public void fromClasspathUtf8ResourceTest() {
        when(reader.readLine()).thenReturn("test").thenReturn(null);
        String resource = "test";
        WordWrap.Builder builder = WordWrap.fromClasspathUtf8(resource);
        Preconditions.checkState(builder != null, "Builder should not be null");
    }

    @Test
    public void fromClasspathResourceTest() {
        when(reader.readLine()).thenReturn("test").thenReturn(null);
        String resource = "test";
        WordWrap.Builder builder = WordWrap.fromClasspath(resource);
        Preconditions.checkState(builder != null, "Builder should not be null");
    }

    @Test
    public void fromCharSequenceTest() {
        StringBuilder word = new StringBuilder();
        WordWrap.Builder builder = WordWrap.from(word);
        Preconditions.checkState(builder != null, "Builder should not be null");
    }

    @Test
    public void fromUtf8InputStreamTest() throws IOException {
        String text = "test";
        byte[] bytes = text.getBytes(StandardCharsets.UTF_8.name());
        InputStream in = new ByteArrayInputStream(bytes);
        WordWrap.Builder builder = WordWrap.fromUtf8(in);
        Preconditions.checkState(builder != null, "Builder should not be null");
    }

    @Test
    public void fromInputStreamCharsetTest() throws IOException {
        String text = "test";
        byte[] bytes = text.getBytes(StandardCharsets.UTF_8.name());
        InputStream in = new ByteArrayInputStream(bytes);
        WordWrap.Builder builder = WordWrap.from(in, StandardCharsets.UTF_8);
        Preconditions.checkState(builder != null, "Builder should not be null");
    }

    @Test
    public void fromFileCharsetTest() throws IOException {
        File file = new File("test.txt");
        WordWrap.Builder builder = WordWrap.from(file, StandardCharsets.UTF_8);
        Preconditions.checkState(builder != null, "Builder should not be null");
    }

    @Test
    public void rightTrimTest() {
        CharSequence s = "test";
        when(reader.readLine()).thenReturn(s).thenReturn(null);
        String trimmed = WordWrap.rightTrim("test test");
        assertEquals("test", trimmed);
    }

    @Test
    public void isWhitespaceTest() {
        CharSequence s = "test";
        when(reader.readLine()).thenReturn(s).thenReturn(null);
        assertTrue(WordWrap.isWhitespace(""));
        assertFalse(WordWrap.isWhitespace("test"));
    }

    @Test
    public void leftTrimStringBuilder2Test() {
        StringBuilder word = new StringBuilder();
        WordWrap.leftTrim(word);
        assertEquals("", word.toString());
    }
}
