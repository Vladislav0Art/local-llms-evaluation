import org.junit.Test;
import static org.junit.Assert.*;
import java.io.UnsupportedEncodingException;
import java.net.IDN;
import java.net.MalformedURLException;
import java.net.URI;
import java.net.URISyntaxException;
import java.net.URL;
import java.net.URLDecoder;
import java.net.URLEncoder;
import static org.jsoup.helper.DataUtil.UTF_8;

public class UrlBuilderTest {

    @Test
    public void newUrlBuilder_emptyUrl() {
        UrlBuilder urlBuilder = new UrlBuilder(null);
        assertNotNull(urlBuilder.build());
    }

    @Test
    public void build_urlWithQuery_param() {
        String inputUrl = "https://example.com/path?a=1&b=2";
        UrlBuilder urlBuilder = new UrlBuilder(new URL(inputUrl));
        assertEquals("https://example.com/path?a=1&b=2", urlBuilder.build().toString());
    }

    @Test
    public void build_urlWithQuery_paramEncodings() {
        String inputUrl = "https://example.com/path?a=1&b=%C2%BC";
        UrlBuilder urlBuilder = new UrlBuilder(new URL(inputUrl));
        assertEquals("https://example.com/path?a=1&b=%E2%80%A6", urlBuilder.build().toString());
    }

    @Test
    public void appendKeyVal_keyValueNoQuery() {
        Connection.KeyVal kv = Connection.KeyVal.newBuilder().key("a").value("b").build();
        UrlBuilder urlBuilder = new UrlBuilder(null);
        assertEquals("https://example.com/path?a=b", urlBuilder.build().toString());
    }

    @Test
    public void appendKeyVal_keyValueWithQuery() {
        String inputUrl = "https://example.com/path?c=d";
        Connection.KeyVal kv = Connection.KeyVal.newBuilder().key("a").value("b").build();
        UrlBuilder urlBuilder = new UrlBuilder(new URL(inputUrl));
        assertEquals("https://example.com/path?a=b&c=d", urlBuilder.build().toString());
    }

    @Test
    public void appendKeyVal_keyValueWithNonASCIIChars() {
        String inputUrl = "https://example.com/path?e=%E3%BC%8B";
        Connection.KeyVal kv = Connection.KeyVal.newBuilder().key("a").value("b").build();
        UrlBuilder urlBuilder = new UrlBuilder(new URL(inputUrl));
        assertEquals("https://example.com/path?a=b&e=%E3%BC%8F", urlBuilder.build().toString());
    }

}

