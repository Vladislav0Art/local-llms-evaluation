    public static void main(String[] args) {
        System.out.println(parseUrl("https://www.example.com"));
        System.out.println(parseUrl("http://localhost:8080/path/to/resource"));
        System.out.println(parseUrl("file:///path/to/local/file.txt"));

        testBasicParser();

        Document doc = Jsoup.connect("https://www.example.com")
                .get();
        Elements links = doc.select("a[href]");
        for (Element link : links) {
            System.out.println(link.attr("href"));
        }

        testProtocols();
    }

    private static String parseUrl(String url) {
        return Jsoup.parse(url).select("a").attr("href");
    }

    private static void testBasicParser() {
        System.out.println(parseUrl("https://www.example.com"));
        System.out.println(parseUrl("http://localhost:8080/path/to/resource"));
        System.out.println(parseUrl("file:///path/to/local/file.txt"));
    }

    private static void testProtocols() {
        String html = "<img src=\"http://example.com/image.jpg\"/>";
        parseProtocol(html, "src");
        html = "<img src=\"https://www.example.com/image.jpg\"/>";
        parseProtocol(html, "src");
        html = "<script src=\"file:///path/to/script.js\"></script>";
        parseProtocol(html, "src");
    }

    private static void parseProtocol(String url, String attribute) {
        if (url.startsWith("http")) {
            System.out.println("Attribute '" + attribute + "' is safe.");
        } else {
            System.out.println("Attribute '" + attribute + "' is not safe.");
        }
    }
}

