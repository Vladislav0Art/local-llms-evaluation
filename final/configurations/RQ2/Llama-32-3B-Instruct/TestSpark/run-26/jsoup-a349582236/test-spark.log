import org.junit.Test;
import static org.junit.Assert.*;
import java.util.HashMap;
import java.util.Map;

public class TagTest {

    @Test
    public void getName_EmptyName_ReturnsEmptyString() {
        Tag tag = new Tag();
        String name = tag.getName();
        assertTrue(name.isEmpty());
    }

    @Test
    public void normalName_LowCaseTag ReturnsEmptyString() {
        Tag tag = new Tag("test");
        String name = tag.normalName();
        assertEquals("", name);
    }

    @Test
    public void normalName_EmptyName_ReturnsEmptyString() {
        Tag tag = new Tag("");
        String name = tag.normalName();
        assertTrue(name.isEmpty());
    }

    @Test
    public void valueOf_DynamicSettings ReturnsCreatedTag() {
        Tag tag = Tag.valueOf("test", new ParseSettings());
        assertNotNull(tag);
    }

    @Test
    public void valueOf_SimpleString ReturnsCreatedTag() {
        Tag tag = Tag.valueOf("test");
        assertNotNull(tag);
    }

    @Test
    public void isBlock_RetursFalseForInlineTags() {
        Tag tag1 = new Tag("div"); // inline tag
        Tag tag2 = new Tag("p");   // block tag
        assertTrue(tag1.isBlock());
        assertFalse(tag2.isBlock());
    }

    @Test
    public void formatAsBlock_ReturnsTrueForBlockTags() {
        Tag tag = new Tag("h1");
        assertTrue(tag.formatAsBlock());
    }

    @Test
    public void isInline_RetursFalseForBlockTags() {
        Tag tag1 = new Tag("div"); // inline tag
        Tag tag2 = new Tag("p");   // block tag
        assertFalse(tag1.isInline());
        assertTrue(tag2.isInline());
    }

    @Test
    public void isEmpty_EmptyName_ReturnsTrue() {
        Tag tag = new Tag("");
        assertTrue(tag.isEmpty());
    }

    @Test
    public void isEmpty_NonEmptyName_ReturnsFalse() {
        Tag tag = new Tag("test");
        assertFalse(tag.isEmpty());
    }

    @Test
    public void isSelfClosing_SelfClosingTag_ReturnsTrue() {
        Tag tag = new Tag("img");
        assertTrue(tag.isSelfClosing());
    }

    @Test
    public void isKnownTag_KnownTagName_ReturnsTrue() {
        Tag tag = new Tag("test");
        assertTrue(Tag.isKnownTag(tag.getName()));
    }

    @Test
    public void isFormSubmittable FormSubmittableTag_ReturnsTrue() {
        Tag tag = new Tag("input");
        assertTrue(tag.isFormSubmittable());
    }

    @Test
    public void preserveWhitespace_SelfClosingTag_ReturnsFalse() {
        Tag tag = new Tag("img"); // self closing
        assertFalse(tag.preserveWhitespace());
    }
}
