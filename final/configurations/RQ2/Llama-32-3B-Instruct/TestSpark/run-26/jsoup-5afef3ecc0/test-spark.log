import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.select.Elements;

public class Main {

    public static void main(String[] args) {
        // Create a new URL object
        java.net.URL url = new java.net.URL("http://example.com");
        try {
            String scheme = url.getProtocol();
            String host = url.getHost();

            // Build query string
            String queryString = "query=value";
            String baseUri = url.toExternalForm() + "?" + queryString;
            System.out.println(baseUri);
        } catch (Exception e) {
            System.out.println("Error: " + e.getMessage());
        }
    }

    public static java.net.URL toUrl(String baseUrl, java.util.Map<String, String> queryParams) {
        try {
            java.net.URL url = new java.net.URL(baseUrl);

            // Get the existing query parameters
            java.util.List<java.net.URLSearchParams> paramsList = url.getQuery().split("&");
            java.util.HashMap<String, String> paramsMap = new java.util.HashMap<>();
            for (String param : paramsList) {
                String[] parts = param.split("=");
                if (parts.length > 1) {
                    paramsMap.put(parts[0], parts[1]);
                }
            }

            // Add the new query parameters
            for (java.util.Map.Entry<String, String> entry : queryParams.entrySet()) {
                String key = entry.getKey();
                String value = entry.getValue();
                if (!paramsMap.containsKey(key)) {
                    paramsMap.put(key, value);
                } else {
                    System.out.println("Key '" + key + "' already exists.");
                }
            }

            // Set the query parameters back to the URL
            java.net.URLBuilder newUrl = url;
            newUrl.setQueryParams(paramsMap);

            return newUrl.build();
        } catch (Exception e) {
            return null;
        }
    }
}
