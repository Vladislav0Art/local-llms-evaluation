    @org.junit.Test
    public void testEstimateEmptyInput_ReturnsZero() {
        LocalDate forDate = localDateUtil.of(2022, Month.DECEMBER);
        double result = estimate(forDate);
        org.junit.Assert.assertEquals(0, result, 1e-6);
    }

    @org.junit.Test
    public void testEstimateDifferentDates_ReturnsCorrectValue() {
        LocalDate forDate = localDateUtil.of(2023, Month.DECEMBER);
        double result = estimate(forDate);
        org.junit.Assert.assertEquals(1, result, 1e-6);
    }

    @org.junit.Test
    public void testEstimateSameDayDifferentYears_ReturnsCorrectValue() {
        LocalDate forDate = localDateUtil.of(2022, Month.DECEMBER);
        double result = estimate(forDate);
        org.junit.Assert.assertEquals(1, result, 1e-6);
    }

    @org.junit.Test
    public void testEstimateSameMonthDifferentDays_ReturnsCorrectValue() {
        LocalDate forDate = localDateUtil.of(2023, Month.DECEMBER).withDayOfMonth(16);
        double result = estimate(forDate);
        org.junit.Assert.assertEquals(-15d / 30d, result, 1e-6);
    }

