import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;

import java.time.LocalDate;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertThrows;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

@RunWith(MockitoJUnitRunner.class)
public class DeltaTTest {

    @Mock
    private LocalDate forDate;

    @Test
    public void estimateEmptyInput_ReturnsZero() {
        when(forDate.toLocalDate()).thenReturn(LocalDate.MIN);
        double result = DeltaT.estimate(forDate);
        assertEquals(0, result, 1e-6);
    }

    @Test
    public void estimateDifferentDates_ReturnsCorrectValue() {
        LocalDate date1 = LocalDate.of(2022, 12, 15);
        LocalDate date2 = LocalDate.of(2023, 12, 15);
        when(forDate.toLocalDate()).thenReturn(date1);
        double result = DeltaT.estimate(forDate);
        assertEquals(date2.getYear() - date1.getYear(), result, 1e-6);
    }

    @Test
    public void estimateSameDayDifferentYears_ReturnsCorrectValue() {
        LocalDate date1 = LocalDate.of(2022, 12, 15);
        LocalDate date2 = LocalDate.of(2023, 12, 15);
        when(forDate.toLocalDate()).thenReturn(date1);
        double result = DeltaT.estimate(forDate);
        assertEquals(date2.getMonthValue() - date1.getMonthValue(), result, 1e-6);
    }

    @Test
    public void estimateSameMonthDifferentDays_ReturnsCorrectValue() {
        LocalDate date1 = LocalDate.of(2022, 12, 15);
        LocalDate date2 = LocalDate.of(2023, 12, 16);
        when(forDate.toLocalDate()).thenReturn(date1);
        double result = DeltaT.estimate(forDate);
        assertEquals((date2.getDayOfMonth() - date1.getDayOfMonth()) * pow(30, -1), result, 1e-6);
    }

    @Test
    public void estimateSameDayDifferentDays_ReturnsCorrectValue() {
        LocalDate date1 = LocalDate.of(2022, 12, 15);
        LocalDate date2 = LocalDate.of(2023, 12, 15);
        when(forDate.toLocalDate()).thenReturn(date1);
        double result = DeltaT.estimate(forDate);
        assertEquals((date2.getDayOfMonth() - date1.getDayOfMonth()) * pow(30, -1), result, 1e-6);
    }

    @Test
    public void estimateNullInput_ThrowsNullPointerException() {
        assertThrows(NullPointerException.class, () -> DeltaT.estimate(null));
    }
}
