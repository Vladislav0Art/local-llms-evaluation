        when(forDate.atDayOfMonth(30)).thenReturn(LocalDate.of(2023, Month.DECEMBER, 15));
        when(forDate.atDayOfMonth(31)).thenReturn(LocalDate.of(2024, Month.DECEMBER, 16));
