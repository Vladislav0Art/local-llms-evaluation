        when(forDate.toLocalDate()).thenReturn(LocalDate.MIN);
        double result = DeltaT.estimate(forDate);
        assertEquals(0, result, 1e-6);
    }

    @Test
    public void estimateDifferentDates_ReturnsCorrectValue() {
        LocalDate date1 = LocalDate.of(2022, 12, 15);
        LocalDate date2 = LocalDate.of(2023, 12, 15);
        when(forDate.toLocalDate()).thenReturn(date1);
        double result = DeltaT.estimate(forDate);
        assertEquals(date2.getYear() - date1.getYear(), result, 1e-6);
    }

    @Test
    public void estimateSameDayDifferentYears_ReturnsCorrectValue() {
        LocalDate date1 = LocalDate.of(2022, 12, 15);
