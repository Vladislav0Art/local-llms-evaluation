package org.jsoup.nodes;

public class GeneratedTest {

    private TextNode node;

    public GeneratedTest() {
        this.node = new TextNode();
    }

    @Test
    public void testReturnsTheTextContentOfTextNode() {
        node.setText("Hello, World!");
        String actual = node.text();
        assertEquals("Hello, World!", actual);
    }

    @Test
    public void testSetsTheTextContentOfTextNodeCorrectly() {
        node.setText("New Text");
        assertEquals("New Text", node.text());
    }

    @Test
    public void testGetWholeText_ReturnsTheTextContentWithoutWhitespace() {
        node.setText("Hello,World!");
        String expected = "HelloWorld";
        String actual = node.getWholeText();
        assertEquals(expected, actual);
    }

    @Test
    public void testIsBlank_ReturnsTrueForEmptyTextNode() {
        node.setText("");
        assertTrue(node.isBlank());
    }

    @Test
    public void testIsBlank_ReturnsFalseForNonEmptyTextNode() {
        node.setText("Hello");
        assertFalse(node.isBlank());
    }

    @Test
    public void testSplitText_SplitsTheTextNodeCorrectly() throws IOException {
        node.setText("Hello World!");
        int offset = 6;
        String expected = "World!";
        String actual = node.splitText(offset);
        assertEquals(expected, actual);
    }

    @Test
    public void testOuterHtmlHead_SucceedsWhenNoOutputSettings() throws IOException {
        Document.OutputSettings out = null;
        TextNode cloned = new TextNode("Hello, World!");
        Appendable accum = new StringBuilder();
        cloned.outerHtmlHead(accum, 1, out);
        assertEquals("<p>Hello, World!</p>", accum.toString());
    }

    @Test
    public void testOuterHtmlTail_SucceedsWhenNoOutputSettings() {
        Document.OutputSettings out = null;
        TextNode cloned = new TextNode("Hello, World!");
        Appendable accum = new StringBuilder();
        cloned.outerHtmlTail(accum, 1, out);
        assertEquals("<p>Hello, World!</p>", accum.toString());
    }

    @Test
    public void testOuterHtmlHead_SucceedsWhenOutputSettingsAreSet() throws IOException {
        Document.OutputSettings out = new Document.OutputSettings();
        TextNode cloned = new TextNode("Hello, World!");
        Appendable accum = new StringBuilder();
        cloned.outerHtmlHead(accum, 1, out);
        assertEquals("<p>Hello, World!</p>", accum.toString());
    }

    @Test
    public void testOuterHtmlTail_SucceedsWhenOutputSettingsAreSet() throws IOException {
        Document.OutputSettings out = new Document.OutputSettings();
        TextNode cloned = new TextNode("Hello, World!");
        Appendable accum = new StringBuilder();
        cloned.outerHtmlTail(accum, 1, out);
        assertEquals("<p>Hello, World!</p>", accum.toString());
    }

    @Test
    public void testToString() {
        TextNode node = new TextNode("Hello\nWorld");
        String expected = "<p> Hello<br> World </p>";
        String actual = node.toString();
        assertEquals(expected, actual);
    }
