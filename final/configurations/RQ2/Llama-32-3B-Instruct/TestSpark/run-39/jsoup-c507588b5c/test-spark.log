public class TextNodeTest {

    @Test
    public void newNode_TextCreatedCorrectly() {
        TextNode node = new TextNode("Hello, World!");
        assertEquals("Hello, World!", node.text());
    }

    @Test
    public void nodeName_ReturnsCorrectValue() {
        TextNode node = new TextNode("");
        assertEquals("text", node.nodeName());
    }

    @Test
    public void text ReturnsTheTextContentOfTextNode() {
        TextNode node = new TextNode("Hello, World!");
        node.text(StringUtil.trim(node.text()));
        assertEquals("", node.text(), 0.01);
    }

    @Test
    public void text_SetsTheTextContentOfTextNodeCorrectly() {
        TextNode node = new TextNode("");
        node.text("Hello, World!");
        assertEquals("Hello, World!", node.text());
    }

    @Test
    public void getWholeText_ReturnsTheTextContentWithoutWhitespace() {
        TextNode node = new TextNode("\t  Hello,\nWorld!\t");
        String expected = "Hello,World!";
        String actual = node.getWholeText();
        assertEquals(expected, actual, 0.01);
    }

    @Test
    public void isBlank_ReturnsTrueForEmptyTextNode() {
        TextNode node = new TextNode("");
        assertTrue(node.isBlank());
    }

    @Test
    public void isBlank_ReturnsFalseForNonEmptyTextNode() {
        TextNode node = new TextNode("Hello, World!");
        assertFalse(node.isBlank());
    }

    @Test
    public void splitText_SplitsTheTextNodeCorrectly() throws IOException {
        TextNode node = new TextNode("Hello,\nWorld!\t");
        int offset = 6;
        TextNode expected = new TextNode("World!\t");
        String actual = node.splitText(offset).toString();
        assertEquals(expected.text(), actual, 0.01);
    }

    @Test
    public void outerHtmlHead_SucceedsWhenNoOutputSettings() throws IOException {
        Appendable accum = new StringBuilder();
        int depth = 1;
        Document.OutputSettings out = null;
        TextNode node = new TextNode("");
        node.outerHtmlHead(accum, depth, out);
        assertEquals("", accum.toString(), 0.01);
    }

    @Test
    public void outerHtmlTail_SucceedsWhenNoOutputSettings() {
        Appendable accum = new StringBuilder();
        int depth = 1;
        Document.OutputSettings out = null;
        TextNode node = new TextNode("");
        node.outerHtmlTail(accum, depth, out);
        assertEquals("", accum.toString(), 0.01);
    }

    @Test
    public void outerHtmlHead_SucceedsWhenOutputSettingsAreSet() throws IOException {
        Appendable accum = new StringBuilder();
        int depth = 1;
        Document.OutputSettings out = new Document.OutputSettings(10, 20);
        TextNode node = new TextNode("");
        node.outerHtmlHead(accum, depth, out);
        assertEquals("<p>Hello World</p>", accum.toString(), 0.01);
    }

    @Test
    public void outerHtmlTail_SucceedsWhenOutputSettingsAreSet() {
        Appendable accum = new StringBuilder();
        int depth = 1;
        Document.OutputSettings out = new Document.OutputSettings(10, 20);
        TextNode node = new TextNode("");
        node.outerHtmlTail(accum, depth, out);
        assertEquals("<p>Hello World</p>", accum.toString(), 0.01);
    }

    @Test
    public void toString_ReturnsTheTextNodeAsAString() {
        TextNode node = new TextNode("Hello,\nWorld!\t");
        String expected = "<p>   Hello,<br>World!</p>";
        String actual = node.toString();
        assertEquals(expected, actual);
    }

    @Test
    public void clone_SucceedsWhenCloneIsNot-null() {
        TextNode node = new TextNode("Hello, World!");
        TextNode clone = node.clone();
        assertNotNull(clone);
        assertEquals(node.text(), clone.text());
    }

    @Test
    public void createFromEncoded_SucceedsWhenEncodedTextIsProvided() {
        TextNode node = TextNode.createFromEncoded("   Hello,\nWorld!\t  ");
        assertEquals("", node.getWholeText());
    }
