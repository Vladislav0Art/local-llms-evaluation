        Safelist safelist = Safelist.none();
        assertTrue(safelist.isSafeTag("img"));
        assertFalse(safelist.isSafeAttribute("a", null, new Attribute()));
    }

    @Test
    public void simpleText[]

    Test() {
        Safelist safelist = Safelist.simpleText();
        assertTrue(safelist.isSafeTag("span"));
        assertFalse(safelist.isSafeAttribute("p", null, new Attribute()));
    }

    @Test
    public void basic[]

    Test() {
        Safelist safelist = Safelist.basic();
        assertTrue(safelist.isSafeTag("b"));
        assertFalse(safelist.isSafeAttribute("i", null, new Attribute()));
    }

    @Test
    public void basicWithImages[]

    Test() {
        Safelist safelist = Safelist.basicWithImages();
        assertTrue(safelist.isSafeTag("img"));
        assertFalse(safelist.isSafeAttribute("a", null, new Attribute()));
    }

    @Test
    public void relaxed[]

    Test() {
        Safelist safelist = Safelist.relaxed();
        assertTrue(safelist.isSafeTag("script"));
        assertFalse(safelist.isSafeAttribute("style", null, new Attribute()));
    }

    @Test
    public void preserveRelativeLinks[]

    Test() {
        Safelist safelist = Safelist.preserveRelativeLinks(true);
        assertTrue(safelist.isSafeTag("a"));
        assertFalse(safelist.isSafeAttribute("img", null, new Attribute()));
    }

    @Test
    public void addTags[]

    Test() {
        Safelist safelist = Safelist.addTags("b");
        assertTrue(safelist.isSafeTag("b"));
        assertFalse(safelist.isSafeAttribute("i", null, new Attribute()));
    }

    @Test
    public void removeTags[]

    Test() {
        Safelist safelist = Safelist.removeTags("script");
        assertFalse(safelist.isSafeTag("script"));
        assertTrue(safelist.isSafeAttribute("style", null, new Attribute()));
    }

    @Test
    public void addAttributes[]

    Test() {
        Safelist safelist = Safelist.addAttributes("img", "alt", "image.jpg");
        assertTrue(safelist.isSafeAttribute("img", null, new Attribute()));
        assertFalse(safelist.isSafeTag("img"));
    }

    @Test
    public void removeAttributes[]

    Test() {
        Safelist safelist = Safelist.removeAttributes("img", "alt");
        assertFalse(safelist.isSafeAttribute("img", null, new Attribute()));
        assertTrue(safelist.isSafeTag("img"));
    }

    @Test
    public void addEnforcedAttribute[]

    Test() {
        Safelist safelist = Safelist.addEnforcedAttribute("body", "style", "color: red;");
