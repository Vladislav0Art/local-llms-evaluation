        NodeList expectedNodeList = Mockito.mock(NodeList.class);
        W3CDom w3cDom = new W3CDom();
        NodeList result = w3cDom.selectXpath("//body", doc, contextNode);
        assertThat(result, is(expectedNodeList));
    }

