public class Test {
    public static void main(String[] args) {
        System.out.println("Test cases");
    }

    public static boolean isPalindrome(int x) {
        String str = Integer.toString(x);
        int left = 0, right = str.length() - 1;
        while (left < right) {
            if (str.charAt(left++) != str.charAt(right--)) return false;
        }
        return true;
    }

    public static boolean isPalindrome(int x, int y) {
        String str = Integer.toString(x);
        for (int i = 0; i < str.length(); i++) {
            if (x / y != str.charAt(i) - '0') return false;
            x %= y;
        }
        return true;
    }

    public static boolean isPalindrome(int n, int m) {
        String str = Integer.toString(n);
        for (int i = 0; i < str.length(); i++) {
            if (n / m != str.charAt(i) - '0') return false;
            n %= m;
        }
        return true;
    }

    public static void test1() {
        assertEquals(true, isPalindrome(12321));
    }

    public static void test2() {
        assertEquals(false, isPalindrome(123456));
    }

    public static void test3() {
        assertEquals(true, isPalindrome(10, 2));
    }

    public static void test4() {
        assertEquals(false, isPalindrome(10, 5));
    }
}

public class OnlineStockSpanner {
    private int[] prices;
    private int index = -1;

    public int[] calculateSpans(int[] prices) {
        this.prices = prices;
        int[] result = new int[prices.length];
        for (int i = 0; i < prices.length; i++) {
            while (index >= 0 && prices[index] <= prices[i]) index--;
