import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.select.Elements;

public class XmlParser {

    public static void main(String[] args) throws Exception {
        String xmlString = "<root><person><name>John</name><age>30</age></person><person><name>Jane</name><age>25</age></person></root>";

        // Parse the XML string
        Document document = Jsoup.parse(xmlString);

        // Extract data from the XML elements
        Elements persons = document.select("person");
        for (Element person : persons) {
            String name = person.selectFirst("name").text();
            int age = Integer.parseInt(person.selectFirst("age").text());

            System.out.println("Name: " + name);
            System.out.println("Age: " + age);
            System.out.println();
        }
    }
}
```

In this example, we use the Jsoup library to parse the XML string and extract data from the `person` elements. We then print out the name and age of each person.

Please note that this is a simple example and you may need to modify it based on your specific requirements.

