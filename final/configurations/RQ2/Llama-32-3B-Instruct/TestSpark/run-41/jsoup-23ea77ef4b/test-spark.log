    public static Document buildDocument() throws ParserConfigurationException {
        return DocumentBuilderFactory.newInstance().newDocumentBuilder().newDocument();
    }
}

public class ElementUtils {

    public static List<Element> getElementsByTag(Document document, String tag) {
        Elements elements = document.select(tag);
        List<Element> list = new ArrayList<>();
        for (Element element : elements) {
            list.add(element);
        }
        return list;
    }

    public static String asString(Document document) throws TransformerException {
