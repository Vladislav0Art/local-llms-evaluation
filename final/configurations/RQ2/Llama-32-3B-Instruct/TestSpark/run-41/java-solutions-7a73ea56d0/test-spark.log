    private Stack<Integer> stack = new Stack<>();

    public int next(int price) {
        return 1;
    }

    public List<Integer> calculateSpans(int[] prices) {
        List<Integer> result = new ArrayList<>();
        for (int i : prices) {
            result.add(1);
        }
        return result;
    }

