Here's an updated version of the code that includes methods for parsing self-closing and non-self-closing tags:

```java
import java.util.ArrayList;
import java.util.List;

public class Tag {
    private String name;
    private boolean selfClosing;
    private List<String> attributes = new ArrayList<>();

    public Tag(String name) {
        this.name = name;
        this.selfClosing = false;
    }

    public void setSelfClosing(boolean selfClosing) {
        this.selfClosing = selfClosing;
    }

    public void addAttribute(String key, String value) {
        attributes.add(key + "=\"" + value + "\"");
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;
        Tag tag = (Tag) o;
        return name.equals(tag.name);
    }

    @Override
    public int hashCode() {
        return name.hashCode();
    }

    @Override
    public String toString() {
        StringBuilder sb = new StringBuilder("<" + name);

        for (String attribute : attributes) {
            sb.append(" " + attribute);
        }

        if (!selfClosing) {
            sb.append(">");
        } else {
            sb.append("/");
        }

        return sb.toString();
    }
}

public class HtmlParser {

    public static List<Tag> parseHtml(String html) {
        // Implement your HTML parsing logic here
        // For simplicity, this example just splits the HTML into individual tags
        String[] tags = html.split("<");

        List<Tag> parsedTags = new ArrayList<>();

        for (String tag : tags) {
            if (!tag.isEmpty()) {  // Ignore empty strings that result from splitting
                Tag parsedTag = parseSingleTag(tag);
                parsedTags.add(parsedTag);
            }
        }

        return parsedTags;
    }

    private static Tag parseSingleTag(String tag) {
        String tagName = tag.substring(1, tag.length() - 1);  // Remove the '<' and '>' characters
        boolean selfClosing = tag.endsWith("/");  // Check if it's a self-closing tag

        Tag parsedTag = new Tag(tagName);
        if (selfClosing) {
            parsedTag.setSelfClosing(true);
        }

        int attributeStartIndex = tag.indexOf(' ');
        while (attributeStartIndex != -1) {
            String attributeName = parseAttribute(tag, attributeStartIndex);
            String attributeValue = parseAttributeValue(tag, attributeStartIndex + attributeName.length() + 1);

            if (parsedTag.attributes.isEmpty()) {
                parsedTag.addAttribute(attributeName, attributeValue);
            } else {
                String existingKey = null;
                for (int i = 0; i < parsedTag.attributes.size(); i++) {
                    if (parsedTag.attributes.get(i).startsWith(attributeName)) {
                        existingKey = parsedTag.attributes.get(i);
                        break;
                    }
                }

                if (existingKey != null) {
                    existingKey += "=" + attributeValue;
                    parsedTag.addAttribute(existingKey, attributeValue);
                } else {
                    parsedTag.addAttribute(attributeName, attributeValue);
                }
            }

            attributeStartIndex = tag.indexOf(' ', attributeStartIndex + 1);
        }

        return parsedTag;
    }

    private static String parseAttribute(String tag, int startIndex) {
        int endIndex = tag.indexOf(' ', startIndex);
        if (endIndex == -1) {  // If there's no space, the attribute ends at the end of the string
            endIndex = tag.length();
        }
        return tag.substring(startIndex, endIndex);
    }

    private static String parseAttributeValue(String tag, int startIndex) {
        int endIndex = tag.indexOf(' ', startIndex + parseAttribute(tag, startIndex).length() + 1);
        if (endIndex == -1) {  // If there's no space, the value ends at the end of the string
            endIndex = tag.length();
        }
        return tag.substring(startIndex + parseAttribute(tag, startIndex).length() + 1, endIndex);
    }

    public static void main(String[] args) {
        String htmlString = "<div id=\"myDiv\" class=\"container\"><p>This is a paragraph.</p></div>";
        List<Tag> parsedTags = parseHtml(htmlString);

        for (Tag tag : parsedTags) {
            System.out.println(tag.toString());
        }
    }
}
