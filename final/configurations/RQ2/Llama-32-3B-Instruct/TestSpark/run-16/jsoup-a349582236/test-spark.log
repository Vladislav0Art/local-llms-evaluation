import java.util.ArrayList;
import java.util.List;

public class HtmlParser {
    public static List<Tag> parseHtml(String html) {
        // Implement your HTML parsing logic here
        // For simplicity, this example just splits the HTML into individual tags
        String[] tags = html.split("<");

        List<Tag> parsedTags = new ArrayList<>();

        for (String tag : tags) {
            if (!tag.isEmpty()) {  // Ignore empty strings
                String tagName = tag.substring(1);  // Remove the '<' character
                Tag parsedTag = parseTag(tagName);
                parsedTags.add(parsedTag);
            }
        }

        return parsedTags;
    }

    private static Tag parseTag(String tagName) {
        Tag parsedTag = new Tag(tagName);

        int start = 0;  // Start index of the tag's content
        while (start < tagName.length() && tagName.charAt(start) == ' ') {  // Skip any whitespace before the first attribute
            start++;
        }

        if (start >= tagName.length()) {  // No attributes found
            return parsedTag;
        }

        int end = tagName.indexOf('>', start);  // Find the end of the tag's content

        if (end == -1) {  // No closing '>' found, assume it's a self-closing tag
            parsedTag.setSelfClosing(true);
        } else {
            String attributesString = tagName.substring(start + 1, end);  // Extract the tag's attributes
            String[] attributes = attributesString.split("\\s+");

            for (String attribute : attributes) {
                int equalsIndex = attribute.indexOf('=');
                if (equalsIndex != -1) {  // Skip any whitespace before the '=' character
                    parsedTag.addAttribute(attribute.substring(0, equalsIndex), attribute.substring(equalsIndex + 1));
                }
            }

            start = end + 1;  // Move to the next tag
        }

        return parsedTag;
    }

    public static void main(String[] args) {
        String htmlString = "<div id=\"myDiv\" class=\"container\"><p>This is a paragraph.</p></div>";
        List<Tag> parsedTags = parseHtml(htmlString);

        for (Tag tag : parsedTags) {
            System.out.println(tag.toString());
        }
    }
}

