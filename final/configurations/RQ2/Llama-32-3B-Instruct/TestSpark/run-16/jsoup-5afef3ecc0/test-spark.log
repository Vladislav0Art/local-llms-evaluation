    static class KeyValImpl implements KeyVal {
        private String key;
        private String value;

        public KeyValImpl(String key, String value) {
            this.key = key;
            this.value = value;
        }

        @Override
        public String getKey() {
            return key;
        }

        @Override
        public String getValue() {
            return value;
        }
    }

