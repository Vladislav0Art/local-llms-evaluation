    public String rightTrim() {
        int index = input.lastIndexOf(' ');
        if (index == -1) {
            return input;
        }
        return input.substring(index + 1);
    }

    public static StringBuilder leftTrim(StringBuilder builder) {
        int index = builder.indexOf(' ');
        if (index != -1) {
            builder.deleteCharAt(index);
        }
        return builder;
    }

