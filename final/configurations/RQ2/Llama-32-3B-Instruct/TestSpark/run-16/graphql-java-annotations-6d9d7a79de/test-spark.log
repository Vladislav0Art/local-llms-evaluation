    private ProcessingElementsContainer container;

    @Test
    public void whenDirectivesBuilderIsCreatedWithAnnotatedElementAndContainerThenDirectivesBuilderIsCreated() {
        // Given: Object is annotated with GraphQLDirectives
        object = Mockito.mock(AnnotatedElement.class);
        List<GraphQLDirectives> directivesListMock = new ArrayList<>();
        directivesListMock.add(Mockito.mock(GraphQLDirectives.class));
        ((java.lang.reflect.AnnotatedElement) object).getAnnotation(GraphQLDirectives.class).directives().addAll(directivesListMock);

        // When: Object is passed to DirectivesBuilder constructor
        directivesBuilder = new DirectivesBuilder(object, container);
    }

    @Test
    public void whenDirectivesBuilderIsCreatedWithAnnotatedElementAndContainerThenBuildMethodReturnsValidDirectiveArray() {
        // Given: Object is annotated with GraphQLDirectives
        object = Mockito.mock(AnnotatedElement.class);
        List<GraphQLDirectives> directivesListMock = new ArrayList<>();
        directivesListMock.add(Mockito.mock(GraphQLDirectives.class));
        ((java.lang.reflect.AnnotatedElement) object).getAnnotation(GraphQLDirectives.class).directives().addAll(directivesListMock);

        // When: Object is passed to DirectivesBuilder constructor
        directivesBuilder = new DirectivesBuilder(object, container);
        
        // Then: build method returns valid directive array
        List<GraphQLDirective> expectedDirectives = Arrays.asList(
                DirectiveJavaAnnotationUtil.getRequiredField(object, "directives")
        );
        assertArrayEquals(expectedDirectives.toArray(), directivesBuilder.build());
    }

    @Test
    public void whenDirectivesBuilderIsCreatedWithoutAnnotatedElementThenThrowNullPointerException() {
        // Given: Object is not annotated with GraphQLDirectives
        AnnotatedElement object = Mockito.mock(AnnotatedElement.class);

