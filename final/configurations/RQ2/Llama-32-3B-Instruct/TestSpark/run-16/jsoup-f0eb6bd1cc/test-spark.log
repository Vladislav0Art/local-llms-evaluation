    }

    public String appendKeyVal(String key, String value) {
        return sb.append(key).append("=").append(value).append("&").toString();
    }

    public static UrlBuilder getInstance() {
        return new UrlBuilder();
    }

    public URL build() {
        return new URL(sb.toString());
    }

