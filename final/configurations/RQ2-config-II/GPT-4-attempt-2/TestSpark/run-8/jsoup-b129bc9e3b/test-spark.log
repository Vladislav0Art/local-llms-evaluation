        assertNotNull(connection);
        assertEquals(connection.request().url().getHost(), "www.google.com");
    }

    @Test
    public void connectStringUrlTest() {
        Connection connection = HttpConnection.connect("http://www.google.com");
        assertNotNull(connection);
        assertEquals(connection.request().url().getHost(), "www.google.com");
    }

