import org.jsoup.parser.ParseSettings;
import org.jsoup.parser.Tag;
import org.junit.Test;

import static org.junit.Assert.*;

public class TagTest {

    @Test
    public void getNameKnownTagTest() {
        Tag tag = Tag.valueOf("div");
        assertEquals("div", tag.getName());
    }

    @Test
    public void normalNameKnownTagTest() {
        Tag tag = Tag.valueOf("div");
        assertEquals("div", tag.normalName());
    }

    @Test
    public void valueOfExistingTagTest() {
        Tag tag = Tag.valueOf("div");
        assertNotNull(tag);
    }

    @Test(expected = IllegalArgumentException.class)
    public void valueOfNullTagTest() {
        Tag.valueOf(null);
    }

    @Test
    public void valueOfWithSettingExistingTagTest() {
        Tag tag = Tag.valueOf("div", ParseSettings.htmlDefault);
        assertNotNull(tag);
    }

    @Test(expected = IllegalArgumentException.class)
    public void valueOfWithSettingNullTagTest() {
        Tag.valueOf(null, ParseSettings.htmlDefault);
    }

    @Test
    public void isBlockDivTagTest() {
        Tag tag = Tag.valueOf("div");
        assertTrue(tag.isBlock());
    }

    @Test
    public void formatAsBlockDivTagTest() {
        Tag tag = Tag.valueOf("div");
        assertTrue(tag.formatAsBlock());
    }

    @Test
    public void isInlineATagTest() {
        Tag tag = Tag.valueOf("a");
        assertTrue(tag.isInline());
    }

    @Test
    public void isEmptyImageTagTest() {
        Tag tag = Tag.valueOf("img");
        assertTrue(tag.isEmpty());
    }

    @Test
    public void isSelfClosingImageTagTest() {
        Tag imgTag = Tag.valueOf("img").setSelfClosing();
        assertTrue(imgTag.isSelfClosing());
    }

    @Test
    public void isKnownTagDivTest() {
        assertTrue(Tag.isKnownTag("div"));
    }

    @Test
    public void isFormListedOptionTagTest() {
        Tag tag = Tag.valueOf("option");
        assertTrue(tag.isFormListed());
    }

    @Test
    public void isFormSubmittableInputTagTest() {
        Tag tag = Tag.valueOf("input");
        assertTrue(tag.isFormSubmittable());
    }

    @Test
    public void cloneTagTest() {
        Tag divTag = Tag.valueOf("div");
        Tag clonedTag = divTag.clone();
        assertEquals(divTag, clonedTag);
    }

    @Test
    public void tagToStringTest() {
        Tag tag = Tag.valueOf("div");
        assertEquals("<div>", tag.toString());
    }

}
