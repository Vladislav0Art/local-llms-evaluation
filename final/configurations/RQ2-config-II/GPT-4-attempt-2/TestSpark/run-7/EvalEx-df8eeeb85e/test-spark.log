		when(config.getOperator("+")).thenReturn(Mockito.mock(OperatorIfc.class));
		Tokenizer tokenizer = new Tokenizer(expression, config);
		
		// When
		List<Token> tokens = tokenizer.parse();
		
		// Then
		assertEquals(3, tokens.size());
