    public void simpleText()[MethodUnderTest]Test() {
        // Arrange
        when(element.getTagName()).thenReturn("span");

        // Act
        Set<String> result = new HashSet<>();
        Safelist safelist = Safelist.simpleText();
        result.addAll(safelist.addTags("span"));
        assertEquals(1, result.size());
    }

    @Test
    public void basic()[MethodUnderTest]Test() {
        // Arrange
        when(element.getTagName()).thenReturn("img");

        // Act
        Set<String> result = new HashSet<>();
        Safelist safelist = Safelist.basic();
        result.addAll(safelist.addTags("img"));
        assertEquals(1, result.size());
    }

    @Test
    public void basicWithImages()[MethodUnderTest]Test() {
        // Arrange
        when(element.getTagName()).thenReturn("b");

        // Act
        Set<String> result = new HashSet<>();
        Safelist safelist = Safelist.basic();
        result.addAll(safelist.addTags("img"));
        assertEquals(2, result.size());
    }

    @Test
    public void relaxed()[MethodUnderTest]Test() {
        // Arrange
        when(element.getTagName()).thenReturn("div");

        // Act
        Set<String> result = new HashSet<>();
        Safelist safelist = Safelist.relaxed();
        result.addAll(safelist.addTags("div"));
        assertEquals(3, result.size());
    }

    @Test
    public void preserveRelativeLinks()[MethodUnderTest]Test() {
        // Arrange
        when(element.getTagName()).thenReturn("script");

        // Act
        Set<String> result = new HashSet<>();
