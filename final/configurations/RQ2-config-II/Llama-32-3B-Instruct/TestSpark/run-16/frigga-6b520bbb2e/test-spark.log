import org.junit.Test;
import static org.junit.Assert.*;
import org.mockito.Mockito;

public class AppVersionTest {

    @Test
    public void parseName_EmptyString_ReturnsNull() {
        assertNull(AppVersion.parseName(""));
    }

    @Test
    public void parseName_InvalidFormat_ReturnsNull() {
        String invalid = "invalid";
        assertNull(AppVersion.parseName(invalid));
    }

    @Test
    public void parseName_ValidFormat_ReturnsExpectedAppVersion() {
        String valid = NameConstants.FREGGA_AMI_3_0_2;
        AppVersion expected = new AppVersion(valid);
        assertEquals(expected, AppVersion.parseName(valid));
    }

    @Test
    public void compareTo_SameVersions_ReturnsZero() {
        AppVersion first = new AppVersion("1.0");
        AppVersion second = new AppVersion("1.0");
        assertEquals(0, first.compareTo(second));
    }

    @Test
    public void compareTo_LargerVersion_ReturnsNegativeValue() {
        AppVersion first = new AppVersion("1.0");
        AppVersion second = new AppVersion("2.0");
        assertLessThan(-1, first.compareTo(second));
    }

    @Test
    public void getAppVersionPattern_ReturnsCorrectPattern() {
        Pattern pattern = AppVersion.getAppVersionPattern();
        assertTrue(pattern.matcher("1.0").matches());
    }

    @Test
    public void getPackageName_ReturnsExpectedValue() {
        AppVersion appVersion = new AppVersion("1.0");
        assertEquals("com.netflix.frigga", appVersion.getPackageName());
    }

    @Test
    public void getVersion_ReturnsExpectedValue() {
        AppVersion appVersion = new AppVersion("1.0");
        assertEquals("3.0.2", appVersion.getVersion());
    }

    @Test
    public void getBuildJobName_ReturnsExpectedValue() {
        AppVersion appVersion = new AppVersion("1.0");
        assertEquals("fregga-3.0.2", appVersion.getBuildJobName());
    }

    @Test
    public void getBuildNumber_ReturnsExpectedValue() {
        AppVersion appVersion = new AppVersion("1.0");
        assertEquals("4567", appVersion.getBuildNumber());
    }

    @Test
    public void getCommit_ReturnsExpectedValue() {
        AppVersion appVersion = new AppVersion("1.0");
        assertEquals("1234", appVersion.getCommit());
    }

    @Test
    public void getChangelist_DecomplementedReturnsExpectedValue() {
        AppVersion appVersion = new AppVersion("1.0");
        assertNotNull(appVersion.getChangelist());
    }

    @Test
    public void toString_ReturnsExpectedString() {
        AppVersion appVersion = new AppVersion("1.0");
        assertTrue(appVersion.toString().contains(appVersion.getVersion()));
    }

    @Test
    public void hashCode_ReturnsUniqueHashCode() {
        AppVersion first = new AppVersion("1.0");
        AppVersion second = new AppVersion("2.0");
        assertNotEquals(first.hashCode(), second.hashCode());
    }

    @Test
    public void equals_SameAppVersions_ReturnsTrue() {
        AppVersion first = new AppVersion("1.0");
        AppVersion second = new AppVersion("1.0");
        assertTrue(first.equals(second));
    }

    @Test
    public void equals_DifferentAppVersions_ReturnsFalse() {
        AppVersion first = new AppVersion("1.0");
        AppVersion second = new AppVersion("2.0");
        assertFalse(first.equals(second));
    }
}
