import org.jsoup.helper.W3CDom;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.mockito.Mock;
import org.mockito.Mockito;
import org.mockito.junit.MockitoJUnitRunner;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertTrue;
import static org.mockito.ArgumentMatchers.anyMap;
import static org.mockito.Mockito.when;

@RunWith(MockitoJUnitRunner.class)
public class W3CDomTest {

    @Mock
    private Document document;

    @Mock
    private Properties properties;

    @Test
    public void namespaceAwareDefaultReturnTrue() {
        boolean result = W3CDom.namespaceAware();
        assertTrue(result);
    }

    @Test
    public void namespaceAwareSetToFalse() {
        when(W3CDom.namespaceAware()).thenReturn(false);
        boolean result = W3CDom.namespaceAware();
        assertEquals(false, result);
    }

    @Test
    public void convertDocumentFromJsoup() {
        Document outDoc = W3CDom.convert(document);
        assertNotNull(outDoc);
    }

    @Test
    public void asStringDocumentWithProperties() {
        Map<String, String> propertiesMap = new HashMap<>();
        propertiesFromMap(propertiesMap);
        String result = W3CDom.asString(document, propertiesMap);
        assertEquals(document.toString(), result);
    }

    @Test
    public void OutputHtmlDefaultReturnEmptyHashMap() {
        HashMap<String, String> html = W3CDom.OutputHtml();
        assertNotNull(html);
        assertTrue(html.isEmpty());
    }

    @Test
    public void OutputXmlDefaultReturnEmptyHashMap() {
        HashMap<String, String> xml = W3CDom.OutputXml();
        assertNotNull(xml);
        assertTrue(xml.isEmpty());
    }

    @Test
    public void fromJsoupDocumentConvertToW3CDom() {
        Document outDoc = W3CDom.fromJsoup(document);
        assertNotNull(outDoc);
    }

    @Test
    public void fromJsoupElementConvertToW3CDom() {
        Element element = new org.jsoup.internal.StringUtil.Text("test");
        Document outDoc = W3CDom.fromJsoup(element);
        assertNotNull(outDoc);
    }

    @Test
    public void convertDocumentElementConvertToW3CDom() {
        Document inDoc = document;
        Document outDoc = W3CDom.convert(inDoc, document);
        assertEquals(document, outDoc);
    }

    @Test
    public void convertElementDocumentConvertToW3CDom() {
        Element element = new org.jsoup.internal.StringUtil.Text("test");
        Document inDoc = element;
        Document outDoc = W3CDom.convert(element, inDoc);
        assertEquals(element, outDoc);
    }

    @Test
    public void selectXpathDocumentFindNodes() {
        NodeList nodes = Mockito.mock(NodeList.class);
        when(document.getElementsByTagName(Mockito.anyString())).thenReturn(nodes);
        NodeList result = W3CDom.selectXpath(Mockito.anyString(), document);
        assertNotNull(result);
        assertEquals(nodes, result);
    }

    @Test
    public void selectXpathNodeFindNodes() {
        Element element = new org.jsoup.internal.StringUtil.Text("test");
        Node contextNode = Mockito.mock(Node.class);
        when(element.getNodeType()).thenReturn(Mockito.anyInt());
        NodeList nodes = Mockito.mock(NodeList.class);
        when(contextNode.getElementsByTagName(Mockito.anyString())).thenReturn(nodes);
        NodeList result = W3CDom.selectXpath(Mockito.anyString(), contextNode);
        assertNotNull(result);
        assertEquals(nodes, result);
    }

    @Test
    public void sourceNodesDocumentFindAllElements() {
        Document inDoc = document;
        List<Document> nodeList = Mockito.mock(List.class);
        when(inDoc.getElementsByTagName(Mockito.anyString())).thenReturn(nodeList);
        List<Document> result = W3CDom.sourceNodes(Mockito.any(NodeList.class), Mockito.any(Class.class));
        assertNotNull(result);
        assertEquals(nodeList, result);
    }

    @Test
    public void contextNodeDocumentGetRootElement() {
        Document inDoc = document;
        Node root = Mockito.mock(Node.class);
        when(inDoc.getDocumentElement()).thenReturn(root);
        Node result = W3CDom.contextNode(document);
        assertNotNull(result);
        assertEquals(root, result);
    }

    @Test
    public void asStringDocumentConvertToString() {
        String result = W3CDom.asString(document);
        assertEquals(document.toString(), result);
    }
