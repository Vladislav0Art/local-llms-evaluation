package org.stellar.sdk;

import org.junit.Before;
import org.junit.Test;
import static org.junit.Assert.*;
import java.security.GeneralSecurityException;
import java.util.Arrays;
import java.util.HashMap;
import java.util.Map;

import net.i2p.crypto.eddsa.EdDSAPrivateKey;
import net.i2p.crypto.eddsa.EdDSAPublicKey;
import net.i2p.crypto.eddsa.KeyPairGenerator;
import net.i2p.crypto.eddsa.spec.EdDSANamedCurveSpec;
import net.i2p.crypto.eddsa.spec.EdDSANamedCurveTable;

public class KeyPairTest {

    private KeyPair keyPair;

    @Before
    public void setup() {
        EdDSAPublicKey publicKey = EdDSAPrivateKey.generate().getPublic();
        keyPair = new KeyPair(publicKey);
    }

    @Test
    public void canSign_ReturnsTrue_WhenPubliclyAvailable() throws GeneralSecurityException {
        assertTrue(keyPair.canSign());
    }

    @Test
    public void canSign_ReturnsFalse_WhenNotPublicallyAvailable() throws GeneralSecurityException {
        EdDSAPrivateKey privateKey = EdDSAPublicKey.generate().getPrivate();
        KeyPair keyPair = new KeyPair(privateKey);
        assertFalse(keyPair.canSign());
    }

    @Test
    public void fromSecretSeed_CreatesValidKeyPair_WithCorrectPublicKey() throws GeneralSecurityException {
        char[] seed = "secretseed".toCharArray();
        KeyPair keyPair = KeyPair.fromSecretSeed(seed);
        assertNotNull(keyPair.getPublicKey());
    }

    @Test
    public void fromXdrPublicKey_ReturnsValidKeyPair_WithCorrectPublicKey() throws IOException, GeneralSecurityException {
        byte[] publicKey = new byte[]{1, 2, 3};
        KeyPair keyPair = KeyPair.fromXdrPublicKey(new PublicKey(publicKey));
        assertNotNull(keyPair.getPublicKey());
    }

    @Test
    public void fromAccountId_ReturnsValidKeyPair_WithCorrectAccountId() throws IOException, GeneralSecurityException {
        String accountId = "accountid";
        KeyPair keyPair = KeyPair.fromAccountId(accountId);
        assertEquals(accountId, keyPair.getAccountId());
    }

    @Test
    public void getPublicKey_ReturnsNonNullPublicKey() {
        assertNotNull(keyPair.getPublicKey());
    }

    @Test
    public void getSecretSeed_ReturnsNonNullSecretSeed() {
        assertNotNull(keyPair.getSecretSeed());
    }

    @Test
    public void sign_ReturnsDecoratedSignature_WithCorrectDataAndSignature() throws IOException, GeneralSecurityException {
        byte[] data = new byte[]{1, 2, 3};
        DecoratedSignature signature = keyPair.sign(data);
        assertNotNull(signature);
    }

    @Test
    public void verify_ReturnsTrue_WhenDataAndSignatureAreValid() throws IOException, GeneralSecurityException {
        byte[] data = new byte[]{1, 2, 3};
        byte[] signature = new byte[]{4, 5, 6};
        assertTrue(keyPair.verify(data, signature));
    }

    @Test
    public void verify_ReturnsFalse_WhenDataAndSignatureAreInvalid() throws IOException, GeneralSecurityException {
        byte[] data = new byte[]{1, 2, 3};
        byte[] signature = new byte[]{4, 5, 7};
        assertFalse(keyPair.verify(data, signature));
    }

    @Test
    public void hashCode_ReturnsCorrectHashCode() {
        assertEquals(1234567890L, keyPair.hashCode());
    }

    @Test
    public void equalsEquals_ReturnsTrue_WhenBothObjectsAreSameInstance() {
        KeyPair otherKeyPair = new KeyPair(keyPair.getPublic());
        assertTrue(keyPair.equals(otherKeyPair));
    }

    @Test
    public void equalsEquals_ReturnsFalse_WhenObjectsAreDifferentInstances() {
        KeyPair otherKeyPair = new KeyPair(EdDSAPublicKey.generate().getPublic());
        assertFalse(keyPair.equals(otherKeyPair));
    }
}

