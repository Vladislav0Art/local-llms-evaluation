        assert(pair != null);
    }

    @Test
    public void fromSecretSeed_HasUniqueAccountId() {
        char[] seed = new char[]{1, 2, 3};
        String accountId = KeyPair.fromSecretSeed(seed).getAccountId();

        assert(!accountId.isEmpty());
    }
