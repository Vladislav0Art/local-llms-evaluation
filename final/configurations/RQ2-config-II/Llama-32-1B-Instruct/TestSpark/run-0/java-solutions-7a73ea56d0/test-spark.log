import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.util.ArrayList;
import java.util.List;

public class OnlineStockSpanTest {

    private OnlineStockSpan instance = new OnlineStockSpan();

    @Test
    public void next_ExistingPrice_CorrectResult() {
        int[] prices = {70, 75, 80};
        int result = instance.next(70);
        assertEquals(1, result); // max coverage of line: price - first price
    }

    @Test
    public void next_NegativePrice_WillReturnNegativeIndex_0() {
        int[] prices = {-10, 5, 20};
        int result = instance.next(-10);
        assertEquals(-2, result); // max coverage of line: price - first price + current index
    }

    @Test
    public void next_NegativePrice_WillReturnCurrentIndex_0() {
        int[] prices = {-10, -5, 20};
        int result = instance.next(-10);
        assertEquals(1, result); // max coverage of line: price - first price + current index
    }

    @Test
    public void next_PriorityQueueEmpty_PriorityQueueShouldNotBeUpdated() {
        List<Integer> prices = new ArrayList<>();
        Mockito.when(instance.next(Mockito.anyInt())).thenReturn(-1);
        int[] result = instance.calculateSpans(prices.toArray(new Integer[0]));
        assertEquals(2, result.length); // max coverage of line: price - first price + current index
    }

    @Test
    public void next_PriorityQueueNotEmpty_PriorityQueueShouldNotBeUpdated() {
        List<Integer> prices = new ArrayList<>();
        Mockito.when(instance.next(Mockito.anyInt())).thenReturn(-1);
        int[] result = instance.calculateSpans(prices.toArray(new Integer[0]));
        assertEquals(2, result.length); // max coverage of line: price - first price + current index
    }

    @Test
    public void next_PriorityQueueNotEmptyAndDifferentPrices_PriorityQueueShouldNotBeUpdated() {
        List<Integer> prices = new ArrayList<>();
        Mockito.when(instance.next(Mockito.anyInt())).thenReturn(-1);
        int[] result = instance.calculateSpans(prices.toArray(new Integer[0]));
        assertEquals(2, result.length); // max coverage of line: price - first price + current index
    }

    @Test
    public void next_PriorityQueueNotEmptyAndDifferentPricesLastPriceShouldBeMaximized() {
        List<Integer> prices = new ArrayList<>();
        Mockito.when(instance.next(Mockito.anyInt())).thenReturn(-1);
        int[] result = instance.calculateSpans(prices.toArray(new Integer[0]));
        assertEquals(2, result.length); // max coverage of line: price - first price + current index
    }

    @Test
    public void calculateSpans_NoPrices_ReturnsEmptyArray() {
        int[] prices = {};
        int[] result = instance.calculateSpans(prices);
        assertEquals(0, result.length); // max coverage of line: price - first price + current index
    }

    @Test
    public void calculateSpans_EmptyArray_ReturnsZeroArray() {
        int[] prices = new int[0];
        int[] result = instance.calculateSpans(prices);
        assertEquals(0, result.length); // max coverage of line: price - first price + current index
    }

    @Test
    public void calculateSpans_SinglePrice_ReturnsSingleValue() {
        int[] prices = {10};
        int[] result = instance.calculateSpans(prices);
        assertEquals(1, result[0]); // max coverage of line: price - first price + current index
    }

    @Test
    public void calculateSpans_MultiplePrices_ReturnsMultipleValues() {
        int[] prices = {70, 75, 80};
        int[] result = instance.calculateSpans(prices);
        assertEquals(3, result.length); // max coverage of line: price - first price + current index
    }
}
